                        class="px-2 py-0 rounded bg-yellow-100 hover:bg-yellow-200 dark:bg-yellow-900/30 dark:hover:bg-yellow-900/50 text-yellow-800 dark:text-yellow-200 text-xs font-semibold transition-colors cursor-grab active:cursor-grabbing border border-yellow-300 dark:border-yellow-700"
                    >
                        Nom société
                    </button>
                    <button 
                        @click="insertVariableToken('company.vat')"
                        draggable="true"
                        @dragstart="$event.dataTransfer.setData('application/json', JSON.stringify({ type: 'variable', path: 'company.vat' })); $event.dataTransfer.effectAllowed = 'copy';"
