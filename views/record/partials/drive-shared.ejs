<%
/**
 * drive-shared.ejs — Shared Drive partial
 * 
 * Used by:
 *   - account-drive.ejs  → driveMode='global'
 *   - record-module.ejs  → driveMode='record'
 *
 * Required EJS variables:
 *   - driveMode:       'global' | 'record'
 *   - account_number:  string
 *
 * Record mode also requires:
 *   - entity:          { _id, name, icon, color, slug }
 *   - record:          { _id, title, computedTitle }
 *   - workspaceRole:   string (optional)
 */
%>

<style>
    .drive-breadcrumb { display:flex; align-items:center; gap:4px; margin-bottom:14px; flex-wrap:wrap; }
    .drive-breadcrumb-item { display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:600; color:#94a3b8; background:none; border:none; cursor:pointer; padding:4px 8px; border-radius:6px; transition:all 0.15s; }
    .drive-breadcrumb-item:hover { color:#4361ee; background:#4361ee08; }
    .drive-breadcrumb-item--active { color:#1e293b; cursor:default; }
    .drive-breadcrumb-item--active:hover { color:#1e293b; background:transparent; }
    .drive-breadcrumb-sep { display:inline-flex; align-items:center; gap:4px; color:#cbd5e1; }
    .drive-toolbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; gap:8px; }
    .drive-btn-primary { display:inline-flex; align-items:center; gap:6px; padding:7px 16px; border-radius:10px; font-size:12px; font-weight:600; background:linear-gradient(135deg,#4361ee,#3b82f6); color:#fff; border:none; cursor:pointer; transition:all 0.2s; box-shadow:0 2px 8px #4361ee25; }
    .drive-btn-primary:hover { transform:translateY(-1px); box-shadow:0 4px 12px #4361ee35; }
    .drive-btn-secondary { display:inline-flex; align-items:center; gap:6px; padding:7px 14px; border-radius:10px; font-size:12px; font-weight:600; background:#f8fafc; color:#64748b; border:1px solid #e2e8f0; cursor:pointer; transition:all 0.15s; }
    .drive-btn-secondary:hover { background:#f1f5f9; border-color:#cbd5e1; color:#334155; }
    .drive-dropzone-overlay { position:absolute; inset:0; z-index:50; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; background:rgba(255,255,255,0.95); border:3px dashed #4361ee; border-radius:16px; backdrop-filter:blur(4px); animation:drive-drop-in 0.2s ease; }
    .drive-dropzone-overlay p { font-size:14px; font-weight:600; color:#4361ee; margin:0; }
    .drive-dropzone-overlay span { font-size:11px; color:#94a3b8; }
    @keyframes drive-drop-in { from { opacity:0; transform:scale(0.97); } to { opacity:1; transform:scale(1); } }
    .drive-new-folder { display:flex; align-items:center; gap:8px; padding:10px 14px; margin-bottom:12px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; }
    .drive-new-folder-input { flex:1; border:none; background:transparent; font-size:13px; outline:none; color:#1e293b; }
    .drive-new-folder-input::placeholder { color:#cbd5e1; }
    .drive-new-folder-btn { padding:5px 14px; border-radius:8px; font-size:11px; font-weight:600; background:#4361ee; color:#fff; border:none; cursor:pointer; }
    .drive-new-folder-btn:disabled { opacity:0.4; cursor:default; }
    .drive-new-folder-cancel { background:none; border:none; cursor:pointer; color:#94a3b8; display:flex; padding:2px; }
    .drive-new-folder-cancel:hover { color:#ef4444; }
    .drive-upload-progress { display:flex; align-items:center; gap:10px; padding:10px 14px; margin-bottom:12px; background:#4361ee08; border:1px solid #4361ee20; border-radius:10px; font-size:12px; color:#4361ee; font-weight:600; }
    .drive-progress-bar { flex:1; height:4px; background:#e2e8f0; border-radius:4px; overflow:hidden; }
    .drive-progress-fill { width:0; height:100%; background:linear-gradient(90deg,#4361ee,#3b82f6); border-radius:4px; transition:width 0.3s; }
    .drive-upload-queue-clear { margin-left:auto; border:none; background:#fff; color:#64748b; border:1px solid #e2e8f0; border-radius:8px; padding:5px 10px; font-size:11px; font-weight:700; cursor:pointer; transition:all .15s; }
    .drive-upload-queue-clear:hover { color:#4361ee; border-color:#4361ee30; background:#4361ee06; }
    .drive-upload-placeholder { cursor:default !important; background:rgba(255,255,255,.66); border-color:#dbe7ff; opacity:.72; box-shadow:none; }
    .drive-upload-placeholder:hover { transform:none; box-shadow:none; border-color:#dbe7ff; }
    .drive-upload-placeholder--uploading { opacity:.95; background:#fff; border-color:#4361ee35; box-shadow:0 2px 10px rgba(67,97,238,.08); }
    .drive-upload-placeholder--done { opacity:.48; }
    .drive-upload-placeholder--error { opacity:1; background:#fff5f5; border-color:#fecaca; }
    .drive-upload-row-progress { width:190px; flex-shrink:0; display:flex; flex-direction:column; gap:6px; }
    .drive-upload-row-status { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-align:right; font-size:11px; font-weight:700; color:#64748b; }
    .drive-upload-row-bar { width:100%; height:5px; background:#e2e8f0; border-radius:999px; overflow:hidden; }
    .drive-upload-row-fill { width:0; height:100%; border-radius:999px; transition:width .25s ease; }
    .drive-upload-row-path { display:inline-block; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; vertical-align:bottom; }
    .drive-file-actions { display:flex; gap:2px; }
    .drive-folder-item:hover { background:#f8fafc; }
    .drive-folder-item--drop-target { background:#4361ee0a !important; box-shadow:inset 0 0 0 2px #4361ee40; border-radius:12px; }
    .drive-empty { text-align:center; padding:40px 20px; color:#94a3b8; }
    .rm-item[draggable='true'] { cursor:grab; }
    .rm-item[draggable='true']:active { cursor:grabbing; opacity:0.6; }
    .drive-img-thumb { width:40px; height:40px; border-radius:8px; object-fit:cover; flex-shrink:0; }
    .drive-pdf-wrap { position:relative; width:40px; height:40px; flex-shrink:0; border-radius:8px; overflow:hidden; background:#f8fafc; }
    .drive-pdf-wrap canvas { width:100%; height:100%; object-fit:cover; display:block; }
    .drive-pdf-badge { position:absolute; bottom:2px; right:2px; font-size:7px; font-weight:800; text-transform:uppercase; padding:1px 4px; border-radius:3px; background:#ef4444; color:#fff; letter-spacing:.5px; line-height:1.3; }
    .drive-rename-input { border:1.5px solid #4361ee; outline:none; border-radius:6px; padding:2px 8px; font-size:13px; font-weight:600; font-family:inherit; color:#1e293b; background:#fff; width:100%; box-sizing:border-box; }
    .drive-rename-input:focus { box-shadow:0 0 0 3px #4361ee15; }
    @keyframes shake { 0%,100% { transform:translateX(0); } 15%,45%,75% { transform:translateX(-4px); } 30%,60%,90% { transform:translateX(4px); } }
    /* Lock badge for system folders */
    .drive-lock-badge { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:6px; font-size:11px; font-weight:600; background:#94a3b810; color:#94a3b8; white-space:nowrap; }
    .drive-lock-icon { display:inline-flex; align-items:center; }
    /* Subtle dropzone hint */
    .drive-zone-hint {
        margin-top:16px; padding:28px 20px; border:1.5px dashed #e2e8f0; border-radius:14px;
        display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
        color:#cbd5e1; transition:all 0.25s; cursor:default; min-height:80px;
    }
    .drive-zone-hint:hover { border-color:#4361ee30; background:#4361ee03; color:#94a3b8; }
    .drive-zone-hint iconify-icon { opacity:0.4; transition:opacity 0.25s; }
    .drive-zone-hint:hover iconify-icon { opacity:0.6; }
    .drive-zone-hint-text { font-size:12px; font-weight:500; }
    .drive-zone-hint-sub { font-size:10.5px; opacity:0.7; }
    /* Premium action buttons */
    .drive-actions-bar {
        display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; gap:12px;
    }
    .drive-actions-group { display:flex; align-items:center; gap:8px; }
    .drive-action-btn {
        display:inline-flex; align-items:center; gap:7px; padding:8px 18px; border-radius:10px;
        font-size:12.5px; font-weight:600; border:none; cursor:pointer; transition:all 0.2s;
        position:relative; overflow:hidden;
    }
    .drive-action-btn--primary {
        background:linear-gradient(135deg,#4361ee,#3b82f6); color:#fff;
        box-shadow:0 2px 10px #4361ee30;
    }
    .drive-action-btn--primary:hover { transform:translateY(-1px); box-shadow:0 4px 16px #4361ee40; }
    .drive-action-btn--secondary {
        background:#f8fafc; color:#475569; border:1px solid #e2e8f0;
    }
    .drive-action-btn--secondary:hover { background:#f1f5f9; border-color:#cbd5e1; color:#1e293b; }
    .drive-action-btn:disabled { opacity:0.45; cursor:not-allowed; transform:none !important; box-shadow:none !important; }
    .drive-stats-pill {
        display:inline-flex; align-items:center; gap:6px; padding:5px 14px; border-radius:8px;
        font-size:11.5px; font-weight:600; color:#64748b; background:#f1f5f9;
    }

    /* Shared rm-item styles (needed for global mode) */
    .rm-items-list { display:flex; flex-direction:column; gap:2px; }
    .rm-item {
        display:flex; align-items:center; gap:14px; padding:14px 16px;
        background:#fff; border-radius:10px; border:1px solid transparent;
        transition:all .25s; cursor:pointer; animation:rmFadeIn .4s ease both;
        position:relative;
    }
    .rm-item:hover { border-color:#e0e6ed; box-shadow:0 2px 8px rgba(0,0,0,.04); transform:translateX(2px); }
    .rm-item-icon { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; position:relative; }
    .rm-item-body { flex:1; min-width:0; }
    .rm-item-title { font-size:13.5px; font-weight:600; color:#0e1726; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .rm-item-date { font-size:11.5px; color:#888da8; display:flex; align-items:center; gap:4px; margin-top:2px; }
    .rm-item-badge { padding:3px 10px; border-radius:6px; font-size:11px; font-weight:600; white-space:nowrap; }
    .rm-item-action { width:28px; height:28px; border:none; background:none; border-radius:6px; color:#bfc9d4; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all .2s; }
    @keyframes rmFadeIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
    @keyframes ctxFadeIn { from { opacity:0; transform:scale(0.95); } to { opacity:1; transform:scale(1); } }

    /* Global mode hero */
    .drive-hero {
        display:flex; align-items:center; gap:20px; padding:28px 32px;
        background:linear-gradient(135deg, #ec489908, #ec489904);
        border:1px solid #ec489920; border-radius:16px; margin-bottom:28px;
        position:relative; overflow:hidden;
    }
    .drive-hero::before {
        content:''; position:absolute; top:-40px; right:-40px; width:160px; height:160px;
        background:radial-gradient(circle, #ec489912, transparent 70%);
        border-radius:50%; pointer-events:none;
    }
    .drive-hero-icon {
        width:56px; height:56px; border-radius:14px; display:flex; align-items:center; justify-content:center;
        background:linear-gradient(135deg, #ec489920, #ec489910); flex-shrink:0; position:relative; z-index:1;
    }
    .drive-hero-info { flex:1; z-index:1; }
    .drive-hero-info h1 { font-size:20px; font-weight:700; color:#0e1726; margin:0 0 4px; display:flex; align-items:center; gap:8px; }
    .drive-hero-info p { font-size:13px; color:#888da8; margin:0; }
    @media (max-width:640px) {
        .drive-upload-placeholder { flex-wrap:wrap; }
        .drive-upload-row-progress { width:100%; margin-left:48px; }
        .drive-upload-row-status { text-align:left; }
    }
</style>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('driveModule', () => ({
        // Mode
        driveMode: '<%= typeof driveMode !== "undefined" ? driveMode : "record" %>',

        // === Global mode state ===
        globalEntities: [],
        globalLevel: 'root',
        selectedEntity: null,
        selectedRecord: null,
        globalStats: { totalFiles: 0, totalSizeFormatted: '0 o' },

        // === Global root state (account-level folders & files) ===
        globalDriveFolders: [],
        globalDriveFiles: [],
        globalCurrentFolder: '',

        // === Record/File mode state ===
        allFiles: [],
        loading: true,
        uploading: false,
        uploadProgress: 0,
        uploadCount: 0,
        uploadQueue: [],
        uploadConcurrency: 2,
        maxUploadFileSize: 50 * 1024 * 1024,
        _uploadQueueSeq: 0,
        isDragging: false,
        draggedFileId: null,
        dropTargetFolder: null,
        currentFolder: '',
        viewingGenerated: '',
        showNewFolderInput: false,
        newFolderName: '',
        customFolders: [],
        _accountNumber: '<%= account_number %>',
        _recordId: '<%= (typeof record !== "undefined" && record) ? record._id : "" %>',
        selectedIds: [],
        selectMode: false,
        confirmingBulkDelete: false,
        confirmDeleteFileId: null,
        isAdmin: <%= (typeof workspaceRole !== 'undefined' && ['owner', 'admin'].includes(workspaceRole)) ? 'true' : 'true' %>,
        contextMenu: { show: false, x: 0, y: 0, type: null, item: null },
        renamingFolderOldName: null,
        renameFolderValue: '',
        showRenameFolderModal: false,
        deletingFolderName: null,
        showDeleteFolderModal: false,
        uploadWarning: { show: false, title: '', message: '', files: [] },
        renamingFileId: null,
        renameValue: '',
        _restoringUrl: false,

        // === Init ===
        async init() {
            if (this.driveMode === 'global') {
                await this.loadGlobalRoot();
                await this._restoreFromUrl();
                // Listen for browser back/forward
                this._handlePopstate = () => this._restoreFromUrl(true);
                window.addEventListener('popstate', this._handlePopstate);
            } else {
                await this.loadFiles();
            }
        },

        destroy() {
            if (this._handlePopstate) {
                window.removeEventListener('popstate', this._handlePopstate);
            }
        },

        // URL state management — clean slash-based URLs
        _updateUrl() {
            if (this.driveMode !== 'global' || this._restoringUrl) return;
            const base = `/account/${this._accountNumber}/drive`;
            let url = base;
            if (this.globalLevel === 'custom-folder' && this.globalCurrentFolder) {
                url = `${base}/${this.globalCurrentFolder}`;
            } else if (this.globalLevel === 'app-entities') {
                url = `${base}/app`;
            } else if (this.globalLevel === 'app-records' && this.selectedEntity) {
                url = `${base}/app/${this.selectedEntity.entityId}`;
            } else if (this.globalLevel === 'app-files' && this.selectedRecord) {
                url = `${base}/app/${this.selectedEntity ? this.selectedEntity.entityId : '_'}/${this.selectedRecord.recordId}`;
                if (this.currentFolder) url += '/' + encodeURIComponent(this.currentFolder);
            }
            if (decodeURIComponent(window.location.pathname) !== decodeURIComponent(url)) {
                history.pushState({ driveState: true }, '', url);
            }
        },

        async _restoreFromUrl(isPopstate) {
            this._restoringUrl = true;
            try {
                const base = `/account/${this._accountNumber}/drive`;
                const path = decodeURIComponent(window.location.pathname);
                const rest = path.startsWith(base + '/') ? path.substring(base.length + 1) : '';

                if (!rest) {
                    // Root
                    if (isPopstate) {
                        this.selectedEntity = null;
                        this.selectedRecord = null;
                        this._recordId = '';
                        this.globalCurrentFolder = '';
                        this.allFiles = [];
                        this.customFolders = [];
                        this.currentFolder = '';
                        this.viewingGenerated = '';
                        this.globalLevel = 'root';
                    }
                } else if (rest === 'app' || rest.startsWith('app/')) {
                    const parts = rest.split('/').slice(1); // remove 'app'
                    if (parts[0] && this.globalEntities.length > 0) {
                        const entity = this.globalEntities.find(e => e.entityId === parts[0]);
                        if (entity && parts[1]) {
                            const record = entity.records.find(r => r.recordId === parts[1]);
                            if (record) {
                                // Set ALL data BEFORE changing globalLevel
                                this.selectedEntity = entity;
                                this.selectedRecord = record;
                                this._recordId = record.recordId;
                                // Load files first while still at root level
                                await this.loadFiles();
                                if (parts[2]) this.currentFolder = parts[2];
                                // NOW change level (triggers re-render with data ready)
                                this.globalLevel = 'app-files';
                            } else {
                                // Record not found, show entity records
                                this.selectedEntity = entity;
                                this.globalLevel = 'app-records';
                            }
                        } else if (entity) {
                            this.selectedEntity = entity;
                            this.globalLevel = 'app-records';
                        } else {
                            this.globalLevel = 'app-entities';
                        }
                    } else {
                        this.globalLevel = 'app-entities';
                    }
                } else {
                    // Custom folder path
                    const isValidFolder = this.globalDriveFolders.includes(rest) || this.globalDriveFolders.some(f => f.startsWith(rest + '/'));
                    if (!isValidFolder) {
                        alert("Chemin invalide ou dossier introuvable");
                        this.globalLevel = 'root';
                        this.globalCurrentFolder = '';
                        // Rewrite URL back to root
                        this._updateUrl();
                    } else {
                        this.globalCurrentFolder = rest;
                        await this.loadGlobalFolderFiles(rest);
                        this.globalLevel = 'custom-folder';
                    }
                }
            } catch (e) {
                console.error('[Drive] Restore from URL error:', e);
            }
            this._restoringUrl = false;
        },

        // ═══════════════════════════════════════
        // GLOBAL MODE METHODS
        // ═══════════════════════════════════════

        async loadGlobalRoot() {
            this.loading = true;
            try {
                // Load entities + stats
                const res1 = await fetch(`/account/${this._accountNumber}/api/drive`, { credentials: 'include' });
                const data1 = await res1.json();
                if (data1.success) {
                    this.globalEntities = data1.entities;
                    this.globalStats = data1.stats;
                }
                // Load root folders & files
                const res2 = await fetch(`/account/${this._accountNumber}/api/drive/files`, { credentials: 'include' });
                const data2 = await res2.json();
                if (data2.success) {
                    this.globalDriveFolders = data2.folders || [];
                    this.globalDriveFiles = data2.files || [];
                }
            } catch(e) { console.error('[Drive] Global root load error:', e); }
            this.loading = false;
        },

        async loadGlobalFolderFiles(folderName) {
            this.loading = true;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/drive/files?folder=${encodeURIComponent(folderName)}`, { credentials: 'include' });
                const data = await res.json();
                if (data.success) {
                    this.globalDriveFiles = data.files || [];
                }
            } catch(e) { console.error('[Drive] Folder files load error:', e); }
            this.loading = false;
        },

        // Navigate into App (entities)
        enterApp() {
            this.globalLevel = 'app-entities';
            this._updateUrl();
        },

        // Navigate into a custom folder
        async enterGlobalFolder(folderName) {
            this.globalCurrentFolder = folderName;
            this.globalLevel = 'custom-folder';
            await this.loadGlobalFolderFiles(folderName);
            this._updateUrl();
        },

        selectEntity(entity) {
            this.selectedEntity = entity;
            this.globalLevel = 'app-records';
            this._updateUrl();
        },

        selectRecord(record) {
            this.selectedRecord = record;
            this._recordId = record.recordId;
            this.globalLevel = 'app-files';
            this.loadFiles();
            this._updateUrl();
        },

        globalGoBack() {
            if (this.globalLevel === 'app-files') {
                if (this.currentFolder || this.viewingGenerated) {
                    this.currentFolder = '';
                    this.viewingGenerated = '';
                } else {
                    this.globalLevel = 'app-records';
                    this.selectedRecord = null;
                    this._recordId = '';
                    this.allFiles = [];
                    this.customFolders = [];
                    this.currentFolder = '';
                    this.viewingGenerated = '';
                }
            } else if (this.globalLevel === 'app-records') {
                this.globalLevel = 'app-entities';
                this.selectedEntity = null;
            } else if (this.globalLevel === 'app-entities') {
                this.globalLevel = 'root';
            } else if (this.globalLevel === 'custom-folder') {
                // Go up one level in path hierarchy
                if (this.globalCurrentFolder.includes('/')) {
                    const parent = this.globalCurrentFolder.substring(0, this.globalCurrentFolder.lastIndexOf('/'));
                    this.globalCurrentFolder = parent;
                    this.loadGlobalFolderFiles(parent);
                } else {
                    this.globalLevel = 'root';
                    this.globalCurrentFolder = '';
                    this.globalDriveFiles = [];
                }
            }
            this._updateUrl();
        },

        get globalBreadcrumb() {
            const crumbs = [{ label: 'Drive', icon: 'solar:cloud-storage-bold-duotone', color: '#ec4899', level: 'root' }];
            if (this.globalLevel === 'custom-folder' && this.globalCurrentFolder) {
                // Build breadcrumb for each path segment
                const segments = this.globalCurrentFolder.split('/');
                let path = '';
                segments.forEach((seg, i) => {
                    path = path ? path + '/' + seg : seg;
                    crumbs.push({ label: seg, icon: 'solar:folder-bold-duotone', color: '#f59e0b', level: 'custom-folder', path: path });
                });
            }
            if (this.globalLevel.startsWith('app')) {
                crumbs.push({ label: 'App', icon: 'solar:box-bold-duotone', color: '#4361ee', level: 'app-entities' });
            }
            if (this.selectedEntity) {
                crumbs.push({ label: this.selectedEntity.entityName, icon: this.selectedEntity.entityIcon, color: '#4361ee', level: 'app-records' });
            }
            if (this.selectedRecord) {
                crumbs.push({ label: this.selectedRecord.recordTitle, icon: this.selectedEntity ? this.selectedEntity.entityIcon : 'solar:folder-bold-duotone', color: '#4361ee', level: 'app-files' });
            }
            if (this.currentFolder) {
                crumbs.push({ label: this.currentFolder, icon: 'solar:folder-bold-duotone', color: '#f59e0b', level: 'folder' });
            }
            if (this.viewingGenerated) {
                crumbs.push({ label: this.viewingGenerated, icon: 'solar:magic-stick-3-bold', color: '#f59e0b', level: 'generated' });
            }
            return crumbs;
        },

        globalNavigateTo(level) {
            if (level === 'root') {
                this.globalLevel = 'root';
                this.selectedEntity = null;
                this.selectedRecord = null;
                this._recordId = '';
                this.allFiles = [];
                this.customFolders = [];
                this.currentFolder = '';
                this.viewingGenerated = '';
                this.globalCurrentFolder = '';
            } else if (level === 'app-entities') {
                this.globalLevel = 'app-entities';
                this.selectedEntity = null;
                this.selectedRecord = null;
                this._recordId = '';
                this.allFiles = [];
                this.customFolders = [];
                this.currentFolder = '';
                this.viewingGenerated = '';
            } else if (level === 'app-records') {
                this.globalLevel = 'app-records';
                this.selectedRecord = null;
                this._recordId = '';
                this.allFiles = [];
                this.customFolders = [];
                this.currentFolder = '';
                this.viewingGenerated = '';
            } else if (level === 'app-files') {
                this.currentFolder = '';
                this.viewingGenerated = '';
            }
            this._updateUrl();
        },

        get isAtFileLevel() {
            if (this.driveMode === 'record') return true;
            return ['app-files', 'root', 'custom-folder'].includes(this.globalLevel);
        },

        // Whether we are in the global root context (not inside a record)
        get isGlobalRoot() {
            return this.driveMode === 'global' && this.globalLevel === 'root';
        },

        get globalRootDisplayFolders() {
            // Show only root-level folders (no '/' in name)
            return this.globalDriveFolders
                .filter(name => !name.includes('/'))
                .map(name => {
                    const count = this.globalDriveFiles.filter(f => f.folder === name).length;
                    return { name, count, isCustom: true };
                }).sort((a, b) => a.name.localeCompare(b.name));
        },

        get globalCurrentSubfolders() {
            if (!this.globalCurrentFolder) return [];
            const prefix = this.globalCurrentFolder + '/';
            return this.globalDriveFolders
                .filter(f => f.startsWith(prefix) && !f.substring(prefix.length).includes('/'))
                .map(fullPath => {
                    const name = fullPath.substring(prefix.length);
                    const count = this.globalDriveFiles.filter(f => f.folder === fullPath).length;
                    return { name, fullPath, count, isCustom: true };
                }).sort((a, b) => a.name.localeCompare(b.name));
        },

        get globalRootDisplayFiles() {
            if (this.globalLevel === 'custom-folder') {
                return this.globalDriveFiles
                    .filter(f => (f.folder || '') === this.globalCurrentFolder)
                    .sort((a, b) => new Date(b.uploadedAt) - new Date(a.uploadedAt));
            }
            // Root: files without folder
            return this.globalDriveFiles.filter(f => !f.folder).sort((a, b) => new Date(b.uploadedAt) - new Date(a.uploadedAt));
        },

        // ═══════════════════════════════════════
        // SHARED FILE-LEVEL METHODS
        // ═══════════════════════════════════════

        toggleSelectMode() {
            this.selectMode = !this.selectMode;
            if (!this.selectMode) this.selectedIds = [];
        },

        openContextMenu(e, item, type) {
            e.preventDefault();
            e.stopPropagation();
            const menuWidth = 190;
            const menuHeight = 200;
            this.contextMenu.x = Math.min(e.clientX, window.innerWidth - menuWidth - 20);
            this.contextMenu.y = Math.min(e.clientY, window.innerHeight - menuHeight - 20);
            this.contextMenu.item = item;
            this.contextMenu.type = type;
            this.contextMenu.show = true;
            this._attachCloseListeners();
        },

        openBackgroundContextMenu(e) {
            // Don't open if event originated from an item (it handles its own ctx menu)
            if (e.target.closest('.rm-item')) return;
            e.preventDefault();
            e.stopPropagation();
            const menuWidth = 200;
            const menuHeight = 250;
            this.contextMenu.x = Math.min(e.clientX, window.innerWidth - menuWidth - 20);
            this.contextMenu.y = Math.min(e.clientY, window.innerHeight - menuHeight - 20);
            this.contextMenu.item = null;
            this.contextMenu.type = 'background';
            this.contextMenu.show = true;
            this._attachCloseListeners();
        },

        _attachCloseListeners() {
            const closeMenu = () => {
                this.contextMenu.show = false;
                window.removeEventListener('click', closeMenu);
                window.removeEventListener('contextmenu', closeMenu);
            };
            setTimeout(() => {
                window.addEventListener('click', closeMenu);
                window.addEventListener('contextmenu', closeMenu);
            }, 50);
        },

        triggerFileUpload() {
            if (this.isGlobalRoot) {
                this.$refs.fileUploadInput?.click();
                return;
            }
            if (!this.isAtFileLevel) {
                window.showMessage ? window.showMessage('Sélectionnez une fiche pour importer des fichiers', 'info') : null;
                return;
            }
            this.$refs.fileUploadInput?.click();
        },

        triggerNewFolder() {
            if (this.isGlobalRoot || this.isAtFileLevel) {
                this.showNewFolderInput = true;
                this.$nextTick(() => this.$refs.folderInput?.focus());
                return;
            }
            window.showMessage ? window.showMessage('Sélectionnez une fiche pour créer un dossier', 'info') : null;
        },

        startRenameFolder(folderName) {
            this.renamingFolderOldName = folderName;
            this.renameFolderValue = folderName;
        },
        
        cancelRenameFolder() {
            this.renamingFolderOldName = null;
            this.renameFolderValue = '';
        },

        async confirmRenameFolder() {
            const oldName = this.renamingFolderOldName;
            const newName = this.renameFolderValue.trim();
            if (!newName || newName === oldName) {
                this.renamingFolderOldName = null;
                return;
            }
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/drive-folders/${encodeURIComponent(oldName)}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ newName })
                });
                const data = await res.json();
                if (data.success) {
                    const idx = this.customFolders.indexOf(oldName);
                    if (idx !== -1) this.customFolders.splice(idx, 1, newName);
                    this.allFiles.forEach(f => { if (f.folder === oldName) f.folder = newName; });
                    if (window.showMessage) window.showMessage('Dossier renommé', 'success');
                } else {
                    window.showMessage ? window.showMessage(data.error || 'Erreur lors du renommage', 'danger') : alert(data.error || 'Erreur lors du renommage');
                }
            } catch (e) {
                console.error('[Drive] Rename folder error:', e);
                window.showMessage ? window.showMessage('Erreur réseau', 'danger') : alert('Erreur réseau');
            }
            this.renamingFolderOldName = null;
        },

        startDeleteFolder(folderName) {
            this.deletingFolderName = folderName;
            this.showDeleteFolderModal = true;
        },

        async confirmDeleteFolder() {
            const folderName = this.deletingFolderName;
            if (!folderName) return;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/drive-folders/${encodeURIComponent(folderName)}`, {
                    method: 'DELETE', credentials: 'include'
                });
                const data = await res.json();
                if (data.success) {
                    this.customFolders = this.customFolders.filter(f => f !== folderName);
                    this.allFiles.forEach(f => { if (f.folder === folderName) f.folder = ''; });
                    if (window.showMessage) window.showMessage('Dossier supprimé', 'success');
                } else {
                    window.showMessage ? window.showMessage(data.error || 'Erreur lors de la suppression', 'danger') : alert(data.error || 'Erreur lors de la suppression');
                }
            } catch (e) {
                console.error('[Drive] Delete folder error:', e);
                window.showMessage ? window.showMessage('Erreur réseau', 'danger') : alert('Erreur réseau');
            }
            this.showDeleteFolderModal = false;
        },

        // ═══ Global folder CRUD ═══
        async confirmRenameGlobalFolder() {
            const oldName = this.renamingFolderOldName;
            const newName = this.renameFolderValue.trim();
            if (!newName || newName === oldName) { this.renamingFolderOldName = null; return; }
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/drive/folders/${encodeURIComponent(oldName)}`, {
                    method: 'PUT', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
                    body: JSON.stringify({ newName })
                });
                const data = await res.json();
                if (data.success) {
                    this.globalDriveFolders = data.folders;
                    if (this.globalCurrentFolder === oldName) this.globalCurrentFolder = newName;
                    if (window.showMessage) window.showMessage('Dossier renommé', 'success');
                } else {
                    window.showMessage ? window.showMessage(data.error || 'Erreur', 'danger') : alert(data.error);
                }
            } catch (e) { console.error('[Drive] Rename global folder error:', e); }
            this.renamingFolderOldName = null;
        },

        async deleteGlobalFolder(folderName) {
            if (!confirm(`Supprimer le dossier "${folderName}" ? Les fichiers seront déplacés à la racine.`)) return;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/drive/folders/${encodeURIComponent(folderName)}`, {
                    method: 'DELETE', credentials: 'include'
                });
                const data = await res.json();
                if (data.success) {
                    this.globalDriveFolders = data.folders;
                    if (this.globalLevel === 'custom-folder' && this.globalCurrentFolder === folderName) {
                        this.globalLevel = 'root';
                        this.globalCurrentFolder = '';
                    }
                    if (window.showMessage) window.showMessage('Dossier supprimé', 'success');
                } else {
                    window.showMessage ? window.showMessage(data.error || 'Erreur', 'danger') : alert(data.error);
                }
            } catch (e) { console.error('[Drive] Delete global folder error:', e); }
        },

        async deleteGlobalFile(file) {
            if (!confirm(`Supprimer "${file.originalName}" ?`)) return;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/drive/files/${file._id}`, {
                    method: 'DELETE', credentials: 'include'
                });
                const data = await res.json();
                if (data.success) {
                    this.globalDriveFiles = this.globalDriveFiles.filter(f => f._id !== file._id);
                    if (window.showMessage) window.showMessage('Fichier supprimé', 'success');
                }
            } catch (e) { console.error('[Drive] Delete global file error:', e); }
        },

        toggleSelect(id) {
            const idx = this.selectedIds.indexOf(id);
            if (idx >= 0) this.selectedIds.splice(idx, 1);
            else this.selectedIds.push(id);
        },

        isSelected(id) {
            return this.selectedIds.includes(id);
        },

        selectAll() {
            if (this.selectedIds.length === this.displayFiles.length) {
                this.selectedIds = [];
            } else {
                this.selectedIds = this.displayFiles.map(f => f._id);
            }
        },

        async bulkDelete() {
            const count = this.selectedIds.length;
            if (count === 0) return;
            this.confirmingBulkDelete = true;
        },

        async executeBulkDelete() {
            const count = this.selectedIds.length;
            this.confirmingBulkDelete = false;
            if (count === 0) return;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/attachments/bulk-delete`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ ids: [...this.selectedIds] })
                });
                const data = await res.json();
                if (data.success) {
                    const deletedSet = new Set(this.selectedIds);
                    for (let i = this.allFiles.length - 1; i >= 0; i--) {
                        if (deletedSet.has(this.allFiles[i]._id)) this.allFiles.splice(i, 1);
                    }
                    this.selectedIds = [];
                    this.selectMode = false;
                    if (window.showMessage) window.showMessage(data.deletedCount + ' fichier(s) supprimé(s)', 'success');
                } else {
                    window.showMessage ? window.showMessage(data.error || 'Erreur lors de la suppression', 'danger') : alert(data.error || 'Erreur lors de la suppression');
                }
            } catch (e) {
                console.error('[Drive] Bulk delete error:', e);
                window.showMessage ? window.showMessage('Erreur réseau', 'danger') : alert('Erreur réseau');
            }
        },

        get generatedCount() {
            return this.allFiles.filter(f => f.isGenerated).length;
        },

        get generatedTemplateFolders() {
            if (this.currentFolder || this.viewingGenerated) return [];
            const map = {};
            this.allFiles.filter(f => f.isGenerated).forEach(f => {
                const tplName = f.generatedFromName || 'Autres documents';
                if (!map[tplName]) map[tplName] = { name: tplName, count: 0, lastDate: null };
                map[tplName].count++;
                const d = new Date(f.uploadedAt);
                if (!map[tplName].lastDate || d > map[tplName].lastDate) map[tplName].lastDate = d;
            });
            return Object.values(map).sort((a, b) => (b.lastDate || 0) - (a.lastDate || 0));
        },

        get displayFolders() {
            if (this.currentFolder || this.viewingGenerated) return [];
            const folderMap = {};
            this.allFiles.filter(f => !f.isGenerated && f.folder).forEach(f => {
                folderMap[f.folder] = (folderMap[f.folder] || 0) + 1;
            });
            this.customFolders.forEach(name => {
                if (!folderMap[name]) folderMap[name] = 0;
            });
            return Object.entries(folderMap)
                .map(([name, count]) => ({ name, count, isCustom: this.customFolders.includes(name) }))
                .sort((a, b) => a.name.localeCompare(b.name));
        },

        isCustomFolder(folderName) {
            return this.customFolders.includes(folderName);
        },

        get displayFiles() {
            if (this.viewingGenerated) {
                return this.allFiles.filter(f => f.isGenerated && (f.generatedFromName || 'Autres documents') === this.viewingGenerated)
                    .sort((a, b) => new Date(b.uploadedAt) - new Date(a.uploadedAt));
            }
            return this.allFiles
                .filter(f => !f.isGenerated && (f.folder || '') === this.currentFolder)
                .sort((a, b) => new Date(b.uploadedAt) - new Date(a.uploadedAt));
        },

        async loadFiles() {
            this.loading = true;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/attachments`, { credentials: 'include' });
                const data = await res.json();
                if (data.success && data.attachments) {
                    this.allFiles = data.attachments;
                }
                if (data.driveFolders && Array.isArray(data.driveFolders)) {
                    this.customFolders = data.driveFolders;
                }
            } catch (e) {
                console.error('[Drive] Load error:', e);
            }
            this.loading = false;
        },

        navigateTo(folder) {
            this.currentFolder = folder;
            this.viewingGenerated = '';
        },

        async createFolder() {
            const name = this.newFolderName.trim();
            if (!name) return;
            // Global root mode: use account-level API
            if (this.isGlobalRoot) {
                // Build full path: if inside a folder, prefix with parent path
                const fullName = this.globalCurrentFolder ? this.globalCurrentFolder + '/' + name : name;
                if (this.globalDriveFolders.includes(fullName)) {
                    window.showMessage ? window.showMessage('Ce dossier existe déjà', 'danger') : alert('Ce dossier existe déjà');
                    this.newFolderName = ''; this.showNewFolderInput = false; return;
                }
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/drive/folders`, {
                        method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
                        body: JSON.stringify({ name: fullName })
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.globalDriveFolders = data.folders;
                        if (window.showMessage) window.showMessage('Dossier créé', 'success');
                    } else {
                        window.showMessage ? window.showMessage(data.error || 'Erreur', 'danger') : alert(data.error);
                    }
                } catch (e) { console.error('[Drive] Create global folder error:', e); }
                this.newFolderName = ''; this.showNewFolderInput = false;
                return;
            }
            // Record mode
            if (this.customFolders.includes(name) || this.allFiles.some(f => f.folder === name)) {
                window.showMessage ? window.showMessage('Ce dossier existe déjà', 'danger') : alert('Ce dossier existe déjà');
                this.newFolderName = ''; this.showNewFolderInput = false; return;
            }
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/drive-folders`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
                    body: JSON.stringify({ name })
                });
                const data = await res.json();
                if (data.success) {
                    this.customFolders.push(name);
                    if (window.showMessage) window.showMessage('Dossier créé', 'success');
                } else {
                    window.showMessage ? window.showMessage(data.error || 'Erreur', 'danger') : alert(data.error || 'Erreur');
                }
            } catch (e) {
                console.error('[Drive] Create folder error:', e);
                window.showMessage ? window.showMessage('Erreur lors de la création', 'danger') : alert('Erreur lors de la création');
            }
            this.newFolderName = '';
            this.showNewFolderInput = false;
        },

        async handleFileSelect(e) {
            const files = e.target.files;
            if (files.length > 0) await this.uploadFiles(files);
            e.target.value = '';
        },

        async fileFromEntry(entry) {
            return new Promise((resolve, reject) => entry.file(resolve, reject));
        },

        async readAllDirectoryEntries(reader) {
            const entries = [];
            let batch = [];
            do {
                batch = await new Promise((resolve, reject) => reader.readEntries(resolve, reject));
                entries.push(...batch);
            } while (batch.length > 0);
            return entries;
        },

        async collectEntryFiles(entry, parentPath, out) {
            const cleanParent = parentPath ? parentPath.replace(/^\/+|\/+$/g, '') : '';
            if (entry.isFile) {
                const file = await this.fileFromEntry(entry);
                const relativePath = cleanParent ? cleanParent + '/' + file.name : file.name;
                out.push({ file, relativePath });
                return;
            }

            if (entry.isDirectory) {
                const folderPath = cleanParent ? cleanParent + '/' + entry.name : entry.name;
                const entries = await this.readAllDirectoryEntries(entry.createReader());
                for (const child of entries) await this.collectEntryFiles(child, folderPath, out);
            }
        },

        async collectDroppedUploadItems(dataTransfer) {
            const items = Array.from(dataTransfer?.items || []);
            const entries = items
                .map(item => typeof item.webkitGetAsEntry === 'function' ? item.webkitGetAsEntry() : null)
                .filter(Boolean);

            if (entries.length > 0) {
                const files = [];
                for (const entry of entries) await this.collectEntryFiles(entry, '', files);
                return files;
            }

            return Array.from(dataTransfer?.files || []).map(file => ({
                file,
                relativePath: file.webkitRelativePath || file.name
            }));
        },

        shouldSkipUploadItem(item) {
            const file = item.file || item;
            const name = file.name || '';
            const relativePath = item.relativePath || name;
            const baseName = relativePath.split(/[\\/]/).pop();
            return ['.DS_Store', 'Thumbs.db', 'desktop.ini', '.localized'].includes(baseName);
        },

        normalizeUploadItems(fileList) {
            return Array.from(fileList || [])
                .map(item => {
                    if (item && item.file) return item;
                    return {
                        file: item,
                        relativePath: item.webkitRelativePath || item.name
                    };
                })
                .filter(item => item.file && !this.shouldSkipUploadItem(item));
        },

        chunkUploadItems(items, size) {
            const chunks = [];
            for (let i = 0; i < items.length; i += size) chunks.push(items.slice(i, i + size));
            return chunks;
        },

        getUploadTimeout(file) {
            const sizeBasedMs = Math.ceil(((file && file.size) || 0) / (128 * 1024)) * 1000;
            return Math.max(60000, Math.min(300000, sizeBasedMs));
        },

        cleanUploadPath(value) {
            return String(value || '')
                .replace(/\\/g, '/')
                .replace(/^\/+|\/+$/g, '')
                .split('/')
                .filter(Boolean)
                .join('/');
        },

        uploadPathBasename(value, fallback) {
            const clean = this.cleanUploadPath(value);
            if (!clean) return fallback || '';
            return clean.split('/').pop() || fallback || clean;
        },

        uploadPathDirname(value) {
            const clean = this.cleanUploadPath(value);
            const parts = clean.split('/').filter(Boolean);
            parts.pop();
            return parts.join('/');
        },

        joinUploadFolder(baseFolder, relativeFolder) {
            const parts = [baseFolder, relativeFolder]
                .map(part => this.cleanUploadPath(part))
                .filter(Boolean);
            return parts.join('/');
        },

        getUploadFolderBase(options, isAccountDriveUpload) {
            if (options.folderOverride !== undefined) return options.folderOverride || '';
            return isAccountDriveUpload ? (this.globalCurrentFolder || '') : (this.currentFolder || '');
        },

        formatQueueSize(bytes) {
            const value = Number(bytes) || 0;
            if (value < 1024) return value + ' o';
            if (value < 1024 * 1024) return (value / 1024).toFixed(1) + ' Ko';
            if (value < 1024 * 1024 * 1024) return (value / (1024 * 1024)).toFixed(1) + ' Mo';
            return (value / (1024 * 1024 * 1024)).toFixed(2) + ' Go';
        },

        detectUploadCategory(file) {
            const mime = (file && file.type || '').toLowerCase();
            const name = (file && file.name || '').toLowerCase();
            if (mime.startsWith('image/') || /\.(png|jpe?g|gif|webp|bmp|svg)$/.test(name)) return 'image';
            if (mime === 'application/pdf' || /\.pdf$/.test(name)) return 'pdf';
            if (mime.includes('word') || /\.(doc|docx)$/.test(name)) return 'word';
            if (mime.includes('excel') || mime.includes('spreadsheet') || /\.(xls|xlsx|csv)$/.test(name)) return 'excel';
            if (mime.startsWith('video/') || /\.(mp4|webm|ogg|mov|avi)$/.test(name)) return 'video';
            if (mime.startsWith('audio/') || /\.(mp3|wav|ogg|m4a)$/.test(name)) return 'audio';
            return 'other';
        },

        createUploadQueueItems(uploadItems, options, isAccountDriveUpload) {
            const folderBase = this.cleanUploadPath(this.getUploadFolderBase(options, isAccountDriveUpload));
            return uploadItems.map(item => {
                const file = item.file;
                const relativePath = this.cleanUploadPath(item.relativePath || file.name);
                const fileName = this.uploadPathBasename(relativePath, file.name);
                const targetFolder = this.joinUploadFolder(folderBase, this.uploadPathDirname(relativePath));
                const displayPath = targetFolder ? targetFolder + '/' + fileName : (relativePath || fileName);

                return {
                    id: 'upload-' + Date.now() + '-' + (++this._uploadQueueSeq),
                    file,
                    relativePath: relativePath || fileName,
                    fileName,
                    targetFolder,
                    displayPath,
                    folderBase,
                    category: this.detectUploadCategory(file),
                    size: file.size || 0,
                    sizeFormatted: this.formatQueueSize(file.size || 0),
                    progress: 0,
                    status: 'pending',
                    message: ''
                };
            });
        },

        get uploadQueueSummary() {
            const total = this.uploadQueue.length;
            if (!total) return '';
            const uploading = this.uploadQueue.filter(item => item.status === 'uploading').length;
            const pending = this.uploadQueue.filter(item => item.status === 'pending').length;
            const done = this.uploadQueue.filter(item => item.status === 'done').length;
            const failed = this.uploadQueue.filter(item => item.status === 'error').length;
            const processed = done + failed;
            if (uploading || pending) {
                return total + ' fichier(s) - ' + uploading + ' en cours - ' + processed + ' traité(s)' + (failed ? ' - ' + failed + ' bloqué(s)' : '');
            }
            if (failed) return done + ' terminé(s) - ' + failed + ' bloqué(s)';
            return total + ' fichier(s) terminé(s)';
        },

        get canClearUploadQueue() {
            return this.uploadQueue.length > 0 && !this.uploadQueue.some(item => ['pending', 'uploading'].includes(item.status));
        },

        clearUploadQueue() {
            if (this.canClearUploadQueue) this.uploadQueue = [];
        },

        uploadQueueStatusLabel(item) {
            if (item.status === 'pending') return 'En attente';
            if (item.status === 'uploading') return Math.max(1, item.progress || 0) + '%';
            if (item.status === 'done') return 'Terminé';
            const message = item.message || 'Bloqué';
            return message.length > 80 ? message.slice(0, 77) + '...' : message;
        },

        uploadQueueProgressColor(item) {
            if (item.status === 'error') return '#ef4444';
            if (item.status === 'done') return '#10b981';
            return 'linear-gradient(90deg,#4361ee,#3b82f6)';
        },

        markUploadQueueItemFailed(queueItem, message, failedItems) {
            queueItem.status = 'error';
            queueItem.progress = 100;
            queueItem.message = message;
            queueItem.file = null;
            failedItems.push({
                item: { relativePath: queueItem.displayPath || queueItem.relativePath, file: { name: queueItem.fileName } },
                message
            });
        },

        async uploadQueueItem(queueItem, isAccountDriveUpload, onProgress) {
            const formData = new FormData();
            formData.append('files', queueItem.file, queueItem.file.name);
            formData.append('relativePaths', queueItem.relativePath || queueItem.fileName);
            formData.append('folder', queueItem.folderBase || '');

            let uploadUrl;
            if (isAccountDriveUpload) {
                uploadUrl = `/account/${this._accountNumber}/api/drive/upload`;
            } else {
                const targetRecordId = this.driveMode === 'global' && this.globalLevel === 'app-files' && this.selectedRecord
                    ? this.selectedRecord.recordId
                    : this._recordId;
                if (!targetRecordId) throw new Error('Fiche introuvable pour l\'upload');
                uploadUrl = `/account/${this._accountNumber}/api/records/${targetRecordId}/attachments`;
            }

            queueItem.status = 'uploading';
            queueItem.progress = Math.max(1, queueItem.progress || 0);
            if (onProgress) onProgress();

            const xhr = new XMLHttpRequest();
            xhr.timeout = this.getUploadTimeout(queueItem.file);
            xhr.upload.addEventListener('progress', (e) => {
                if (e.lengthComputable) {
                    queueItem.progress = Math.min(99, Math.max(1, Math.round((e.loaded / e.total) * 100)));
                    if (onProgress) onProgress();
                }
            });

            const data = await new Promise((resolve, reject) => {
                xhr.onload = () => {
                    let response = {};
                    try {
                        response = xhr.responseText ? JSON.parse(xhr.responseText) : {};
                    } catch (e) {
                        reject(new Error('Réponse serveur invalide'));
                        return;
                    }

                    if (xhr.status >= 200 && xhr.status < 300) {
                        if (response.error || response.success === false) {
                            reject(new Error(response.error || 'Erreur lors de l\'upload'));
                            return;
                        }
                        resolve(response);
                    } else {
                        reject(new Error(response.error || 'Erreur lors de l\'upload'));
                    }
                };
                xhr.onerror = () => reject(new Error('Erreur réseau'));
                xhr.ontimeout = () => reject(new Error('Délai dépassé pendant l\'upload'));
                xhr.onabort = () => reject(new Error('Upload interrompu'));
                xhr.open('POST', uploadUrl);
                xhr.withCredentials = true;
                xhr.send(formData);
            });

            if (isAccountDriveUpload) {
                if (data.files) {
                    this.globalDriveFiles.push(...data.files);
                    data.files.forEach(file => {
                        if (file.folder && !this.globalDriveFolders.includes(file.folder)) this.globalDriveFolders.push(file.folder);
                    });
                }
                (data.folders || []).forEach(folder => {
                    if (folder && !this.globalDriveFolders.includes(folder)) this.globalDriveFolders.push(folder);
                });
            } else if (data.attachments) {
                data.attachments.forEach(a => { if (a.folder && !this.customFolders.includes(a.folder)) this.customFolders.push(a.folder); });
                this.allFiles.push(...data.attachments);
            }
        },

        async uploadDroppedData(dataTransfer, options = {}) {
            const uploadItems = await this.collectDroppedUploadItems(dataTransfer);
            if (uploadItems.length === 0) {
                this.uploadWarning = {
                    show: true,
                    title: 'Dossier non lisible',
                    message: "Aucun fichier lisible n'a été trouvé dans le dépôt. Essayez avec Chrome ou Edge, ou importez les fichiers directement.",
                    files: []
                };
                return;
            }
            await this.uploadFiles(uploadItems, options);
        },

        _dragCounter: 0,

        startDragFile(e, fileId) {
            this.draggedFileId = fileId;
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', fileId);
        },

        onFolderDragEnter(e, folderName) {
            e.preventDefault();
            if (this.draggedFileId) this.dropTargetFolder = folderName;
        },

        onFolderDragLeave(e, folderName) {
            if (this.dropTargetFolder === folderName) this.dropTargetFolder = null;
        },

        async onFolderDrop(e, folderName) {
            e.preventDefault();
            e.stopPropagation();
            if (this.draggedFileId) {
                this.moveFileToFolder(this.draggedFileId, folderName);
                this.draggedFileId = null;
                this.dropTargetFolder = null;
                return;
            }
            await this.uploadDroppedData(e.dataTransfer, { folderOverride: folderName });
        },

        onDragEnd() {
            this.draggedFileId = null;
            this.dropTargetFolder = null;
        },

        async moveFileToFolder(fileId, folderName) {
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/attachments/${fileId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ folder: folderName })
                });
                const data = await res.json();
                if (data.success) {
                    const file = this.allFiles.find(f => f._id === fileId);
                    if (file) file.folder = folderName;
                    if (window.showMessage) window.showMessage('Fichier déplacé', 'success');
                }
            } catch (e) {
                console.error('[Drive] Move error:', e);
            }
        },

        onDragEnter(e) {
            if (this.viewingGenerated) return;
            if (this.draggedFileId) return;
            this._dragCounter++;
            if (e.dataTransfer?.types?.includes('Files')) this.isDragging = true;
        },

        onDragLeave(e) {
            if (this.draggedFileId) return;
            this._dragCounter--;
            if (this._dragCounter <= 0) { this._dragCounter = 0; this.isDragging = false; }
        },

        async handleDrop(e) {
            this._dragCounter = 0;
            this.isDragging = false;
            if (this.draggedFileId) { this.draggedFileId = null; this.dropTargetFolder = null; return; }
            await this.uploadDroppedData(e.dataTransfer);
        },

        async uploadFiles(fileList, options = {}) {
            if (this.uploading) {
                window.showMessage ? window.showMessage('Un upload est déjà en cours. Attendez la fin de la file.', 'info') : null;
                return;
            }

            const uploadItems = this.normalizeUploadItems(fileList);
            if (uploadItems.length === 0) {
                this.uploadWarning = {
                    show: true,
                    title: 'Aucun fichier importable',
                    message: "Le dossier ne contient aucun fichier accepté par l'import.",
                    files: []
                };
                return;
            }

            this.uploading = true;
            this.uploadProgress = 0;
            this.uploadCount = uploadItems.length;
            const isAccountDriveUpload = this.driveMode === 'global' && ['root', 'custom-folder'].includes(this.globalLevel);
            if (!this.uploadQueue.some(item => ['pending', 'uploading'].includes(item.status))) this.uploadQueue = [];
            const queueItems = this.createUploadQueueItems(uploadItems, options, isAccountDriveUpload);
            this.uploadQueue.push(...queueItems);

            let uploadedCount = 0;
            const failedItems = [];
            const uploadableItems = [];

            queueItems.forEach(queueItem => {
                if (queueItem.size > this.maxUploadFileSize) {
                    this.markUploadQueueItemFailed(
                        queueItem,
                        'Fichier trop volumineux (max ' + this.formatQueueSize(this.maxUploadFileSize) + ')',
                        failedItems
                    );
                } else {
                    uploadableItems.push(queueItem);
                }
            });

            let nextIndex = 0;

            const updateBatchProgress = () => {
                const totalProgress = queueItems.reduce((sum, item) => sum + (Number(item.progress) || 0), 0);
                this.uploadProgress = Math.round(totalProgress / queueItems.length);
            };

            const worker = async () => {
                while (nextIndex < uploadableItems.length) {
                    const queueItem = uploadableItems[nextIndex++];
                    try {
                        await this.uploadQueueItem(queueItem, isAccountDriveUpload, updateBatchProgress);
                        queueItem.status = 'done';
                        queueItem.progress = 100;
                        queueItem.message = '';
                        uploadedCount += 1;
                    } catch (e) {
                        const message = e.message || 'Erreur lors de l\'upload';
                        this.markUploadQueueItemFailed(queueItem, message, failedItems);
                        console.warn('[Drive] Upload item skipped:', message, queueItem.displayPath || queueItem.relativePath);
                    } finally {
                        queueItem.file = null;
                        updateBatchProgress();
                    }
                }
            };

            try {
                updateBatchProgress();
                const workerCount = Math.min(this.uploadConcurrency || 2, uploadableItems.length);
                if (workerCount > 0) await Promise.all(Array.from({ length: workerCount }, () => worker()));

                if (uploadedCount > 0 && window.showMessage) {
                    window.showMessage(uploadedCount + ' fichier(s) ajouté(s)', 'success');
                }

                if (failedItems.length > 0) {
                    const firstMessage = failedItems[0].message || 'Erreur lors de l\'upload';
                    const blockedFiles = failedItems.slice(0, 25).map(({ item, message }) => {
                        return (item.relativePath || item.file.name) + ' — ' + message;
                    });
                    if (failedItems.length > blockedFiles.length) {
                        blockedFiles.push('+ ' + (failedItems.length - blockedFiles.length) + ' autre(s) élément(s)');
                    }
                    const isSecurity = firstMessage.includes('interdit') || firstMessage.includes('falsifié') || firstMessage.includes('corrompu') || firstMessage.includes('sécurité') || firstMessage.includes('autorisé');
                    if (isSecurity) {
                        this.uploadWarning = {
                            show: true,
                            title: uploadedCount > 0 ? 'Certains fichiers bloqués' : 'Fichier bloqué par la sécurité',
                            message: uploadedCount > 0
                                ? uploadedCount + ' fichier(s) importé(s). ' + failedItems.length + ' élément(s) bloqué(s) par la sécurité.'
                                : firstMessage,
                            files: blockedFiles
                        };
                    } else {
                        this.uploadWarning = {
                            show: true,
                            title: uploadedCount > 0 ? 'Upload partiel' : 'Erreur d\'upload',
                            message: uploadedCount > 0
                                ? uploadedCount + ' fichier(s) importé(s). ' + failedItems.length + ' élément(s) non importé(s).'
                                : firstMessage,
                            files: blockedFiles
                        };
                    }
                }
            } finally {
                this.uploading = false;
                this.uploadProgress = 0;
                setTimeout(() => {
                    if (!this.uploading) this.uploadQueue = this.uploadQueue.filter(item => item.status !== 'done');
                }, 2500);
            }
        },

        async deleteFile(file) {
            if (!file._id) {
                window.showMessage ? window.showMessage('Ce fichier ne peut pas être supprimé (ID manquant).', 'danger') : alert('Ce fichier ne peut pas être supprimé (ID manquant). Rechargez la page.');
                return;
            }
            if (this.confirmDeleteFileId !== file._id) {
                this.confirmDeleteFileId = file._id;
                setTimeout(() => { if (this.confirmDeleteFileId === file._id) this.confirmDeleteFileId = null; }, 3000);
                return;
            }
            this.confirmDeleteFileId = null;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/attachments/${file._id}`, {
                    method: 'DELETE', credentials: 'include'
                });
                const data = await res.json();
                if (data.success) {
                    const idx = this.allFiles.findIndex(f => f._id === file._id);
                    if (idx !== -1) this.allFiles.splice(idx, 1);
                    this.selectedIds = this.selectedIds.filter(id => id !== file._id);
                    if (window.showMessage) window.showMessage('Fichier supprimé', 'success');
                } else {
                    window.showMessage ? window.showMessage(data.error || 'Erreur lors de la suppression', 'danger') : alert(data.error || 'Erreur lors de la suppression');
                }
            } catch (e) {
                console.error('[Drive] Delete error:', e);
                window.showMessage ? window.showMessage('Erreur réseau', 'danger') : alert('Erreur réseau');
            }
        },

        startRename(file) {
            this.renamingFileId = file._id;
            this.renameValue = file.originalName;
        },

        cancelRename() {
            this.renamingFileId = null;
            this.renameValue = '';
        },

        async confirmRename(file) {
            const newName = this.renameValue.trim();
            if (!newName || newName === file.originalName) { this.cancelRename(); return; }
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/attachments/${file._id}`, {
                    method: 'PATCH', credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ originalName: newName })
                });
                const data = await res.json();
                if (data.success) {
                    const f = this.allFiles.find(f => f._id === file._id);
                    if (f) f.originalName = newName;
                    if (window.showMessage) window.showMessage('Fichier renommé', 'success');
                }
            } catch (e) {
                console.error('[Drive] Rename error:', e);
            }
            this.cancelRename();
        },

        formatDate(dateStr) {
            if (!dateStr) return '';
            return new Date(dateStr).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
        },

        getCategoryIcon(cat) {
            const map = { image: 'solar:gallery-bold-duotone', pdf: 'solar:file-text-bold-duotone', word: 'solar:document-bold-duotone', excel: 'solar:chart-square-bold-duotone', video: 'solar:videocamera-record-bold-duotone', audio: 'solar:music-note-2-bold-duotone' };
            return map[cat] || 'solar:file-bold-duotone';
        },

        getCategoryColor(cat) {
            const map = { image: '#8b5cf6', pdf: '#ef4444', word: '#3b82f6', excel: '#10b981', video: '#f59e0b', audio: '#ec4899' };
            return map[cat] || '#6b7280';
        },

        async renderPdfThumb(url, canvas, size) {
            try {
                if (!window.pdfjsLib) return;
                const pdf = await window.pdfjsLib.getDocument(url).promise;
                const page = await pdf.getPage(1);
                const vp = page.getViewport({ scale: 1 });
                const scale = (size * 2) / Math.min(vp.width, vp.height);
                const viewport = page.getViewport({ scale });
                canvas.width = viewport.width;
                canvas.height = viewport.height;
                const ctx = canvas.getContext('2d');
                await page.render({ canvasContext: ctx, viewport }).promise;
            } catch (e) { /* silently ignore */ }
        }
    }));
});
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>if(window.pdfjsLib) window.pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';</script>

