<div 
    x-show="activeTab === 'variables'"
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="-translate-x-full opacity-0"
    x-transition:enter-end="translate-x-0 opacity-100"
    x-transition:leave="transition ease-in duration-200 transform"
    x-transition:leave-start="translate-x-0 opacity-100"
    x-transition:leave-end="-translate-x-full opacity-0"
    class="w-72 bg-white dark:bg-gray-800 border-r dark:border-gray-700 flex flex-col shadow-xl z-20 overflow-hidden"
    style="display: none;"
>
    <!-- Header -->
    <div class="p-4 border-b dark:border-gray-700 flex justify-between items-center bg-gray-50/50 dark:bg-gray-900/50">
        <h3 class="font-bold text-sm flex items-center gap-2">
            <iconify-icon icon="solar:hashtag-bold-duotone" class="text-blue-500" width="20"></iconify-icon>
            Variables Globales
        </h3>
        <button @click="activeTab = null" class="w-6 h-6 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 flex items-center justify-center">
            <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
        </button>
    </div>

    <!-- Scrollable Content -->
    <div class="flex-1 overflow-y-auto p-3 custom-scrollbar">
        
        <!-- Date Variables -->
        <div class="mb-4">
            <p class="text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2 flex items-center gap-1">
                <iconify-icon icon="solar:calendar-bold-duotone" width="14"></iconify-icon>
                Date
            </p>
            <div class="space-y-1">
                <button 
                    @click="insertVariableToken('date.today')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Date d'aujourd'hui</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{date.today}}</code>
                </button>
                <button 
                    @click="insertVariableToken('date.yesterday')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Hier</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{date.yesterday}}</code>
                </button>
                <button 
                    @click="insertVariableToken('date.tomorrow')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Demain</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{date.tomorrow}}</code>
                </button>
                <button 
                    @click="insertVariableToken('date.nextMonth')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Mois prochain</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{date.nextMonth}}</code>
                </button>
                <button 
                    @click="insertVariableToken('date.year')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Année</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{date.year}}</code>
                </button>
            </div>
        </div>

        <!-- Document Variables -->
        <div class="mb-4">
            <p class="text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2 flex items-center gap-1">
                <iconify-icon icon="solar:document-bold-duotone" width="14"></iconify-icon>
                Document
            </p>
            <div class="space-y-1">
                <button 
                    @click="insertVariableToken('doc.name')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Nom du document</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{doc.name}}</code>
                </button>
                <button 
                    @click="insertVariableToken('doc.number')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Numéro du document</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{doc.number}}</code>
                </button>
                <button 
                    @click="insertVariableToken('doc.format')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Format</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{doc.format}}</code>
                </button>
                <button 
                    @click="insertVariableToken('doc.createdAt')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Date de création</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{doc.createdAt}}</code>
                </button>
            </div>
        </div>

        <!-- User Variables -->
        <div class="mb-4">
            <p class="text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2 flex items-center gap-1">
                <iconify-icon icon="solar:user-bold-duotone" width="14"></iconify-icon>
                Utilisateur
            </p>
            <div class="space-y-1">
                <button 
                    @click="insertVariableToken('user.name')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Nom</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{user.name}}</code>
                </button>
                <button 
                    @click="insertVariableToken('user.email')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Email</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{user.email}}</code>
                </button>
            </div>
        </div>

        <!-- Company Variables -->
        <div class="mb-4">
            <p class="text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2 flex items-center gap-1">
                <iconify-icon icon="solar:buildings-bold-duotone" width="14"></iconify-icon>
                Société
            </p>
            <div class="space-y-1">
                <button 
                    @click="insertVariableToken('company.name')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Nom société</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{company.name}}</code>
                </button>
                <button 
                    @click="insertVariableToken('company.vat')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">TVA société</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{company.vat}}</code>
                </button>
                <button 
                    @click="insertVariableToken('company.address')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Adresse société</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{company.address}}</code>
                </button>
                <button 
                    @click="insertVariableToken('company.phone')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Téléphone société</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{company.phone}}</code>
                </button>
                <button 
                    @click="insertVariableToken('company.email')"
                    class="w-full text-left px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900/50 hover:bg-blue-50 dark:hover:bg-blue-900/20 border border-transparent hover:border-blue-200 dark:hover:border-blue-800 transition-all flex items-center justify-between group"
                >
                    <span class="text-xs text-gray-700 dark:text-gray-300">Email société</span>
                    <code class="text-[10px] font-mono text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">{{company.email}}</code>
                </button>
            </div>
        </div>

        <!-- Entity Variables (from collections) -->
        <template x-if="doc.collections && doc.collections.length > 0">
            <div class="mb-4">
                <div class="h-px bg-gray-200 dark:bg-gray-700 my-3"></div>
                <p class="text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2 flex items-center gap-1">
                    <iconify-icon icon="solar:folder-with-files-bold-duotone" width="14"></iconify-icon>
                    Collections
                </p>
                <template x-for="col in doc.collections.filter(c => c.type === 'single')" :key="col.alias">
                    <div class="mb-3">
                        <p class="text-[9px] font-semibold text-purple-600 dark:text-purple-400 uppercase mb-1" x-text="col.alias"></p>
                        <div class="space-y-1">
                            <button 
                                @click="insertVariableToken(col.alias + '.title')"
                                class="w-full text-left px-3 py-2 rounded-lg bg-purple-50 dark:bg-purple-900/20 hover:bg-purple-100 dark:hover:bg-purple-900/40 border border-transparent hover:border-purple-200 dark:hover:border-purple-800 transition-all flex items-center justify-between group"
                            >
                                <span class="text-xs text-gray-700 dark:text-gray-300">Titre</span>
                                <code class="text-[10px] font-mono text-purple-500 opacity-0 group-hover:opacity-100 transition-opacity" x-text="'{{' + col.alias + '.title}}'"></code>
                            </button>
                            <button 
                                @click="insertVariableToken(col.alias + '.description')"
                                class="w-full text-left px-3 py-2 rounded-lg bg-purple-50 dark:bg-purple-900/20 hover:bg-purple-100 dark:hover:bg-purple-900/40 border border-transparent hover:border-purple-200 dark:hover:border-purple-800 transition-all flex items-center justify-between group"
                            >
                                <span class="text-xs text-gray-700 dark:text-gray-300">Description</span>
                                <code class="text-[10px] font-mono text-purple-500 opacity-0 group-hover:opacity-100 transition-opacity" x-text="'{{' + col.alias + '.description}}'"></code>
                            </button>
                        </div>
                    </div>
                </template>
            </div>
        </template>
    </div>

    <!-- Footer -->
    <div class="p-3 border-t dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/50">
        <p class="text-[10px] text-gray-400 text-center">
            Cliquez pour insérer à la position du curseur
        </p>
    </div>
</div>
