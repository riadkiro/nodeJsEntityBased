<%# Tenant - Workflow Edit %>
<div class="max-w-5xl mx-auto">
    <div class="panel p-6 mb-6">
        <a href="/account/<%= account_number %>/workflows" class="text-sm text-gray-500 hover:text-primary mb-4 inline-block">
            ← Retour aux workflows
        </a>
        <h1 class="text-2xl font-semibold dark:text-white">
            <%= workflow ? 'Modifier le workflow' : 'Nouveau workflow' %>
        </h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Form -->
        <div class="lg:col-span-2 space-y-6">
            <div class="panel p-6">
                <h5 class="text-lg font-semibold mb-5 dark:text-white-light">Configuration</h5>
                
                <form id="workflow-form">
                    <div class="mb-5">
                        <label for="name" class="block text-sm font-medium mb-2">Nom du workflow *</label>
                        <input type="text" id="name" name="name" class="form-input" required 
                            value="<%= workflow?.name || '' %>" placeholder="Ex: Notification client">
                    </div>
                    
                    <div class="mb-5">
                        <label for="description" class="block text-sm font-medium mb-2">Description</label>
                        <textarea id="description" name="description" class="form-textarea" rows="2"
                            placeholder="Décrivez ce que fait ce workflow"><%= workflow?.description || '' %></textarea>
                    </div>
                    
                    <hr class="border-gray-200 dark:border-gray-700 my-6">
                    
                    <!-- Trigger -->
                    <h6 class="text-md font-semibold mb-4 dark:text-white-light">Déclencheur</h6>
                    
                    <div class="grid grid-cols-2 gap-4 mb-5">
                        <div>
                            <label class="block text-sm font-medium mb-2">Événement *</label>
                            <select id="trigger-type" name="trigger.type" class="form-select" required>
                                <option value="">-- Choisir --</option>
                                <option value="record.created" <%= workflow?.trigger?.type === 'record.created' ? 'selected' : '' %>>Record créé</option>
                                <option value="record.updated" <%= workflow?.trigger?.type === 'record.updated' ? 'selected' : '' %>>Record modifié</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Entité *</label>
                            <select id="trigger-entity" name="trigger.entityId" class="form-select" required>
                                <option value="">-- Choisir --</option>
                                <% entities.forEach(entity => { %>
                                    <option value="<%= entity._id %>" 
                                        <%= workflow?.trigger?.entityId?.toString() === entity._id.toString() ? 'selected' : '' %>>
                                        <%= entity.name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    
                    <hr class="border-gray-200 dark:border-gray-700 my-6">
                    
                    <!-- Steps -->
                    <div class="flex items-center justify-between mb-4">
                        <h6 class="text-md font-semibold dark:text-white-light">Actions</h6>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addStep()">
                            + Ajouter une action
                        </button>
                    </div>
                    
                    <div id="steps-container" class="space-y-4">
                        <% if (workflow?.steps?.length) { %>
                            <% workflow.steps.forEach((step, index) => { %>
                                <div class="step-item panel bg-gray-50 dark:bg-gray-900 p-4" data-step-index="<%= index %>">
                                    <div class="flex items-center justify-between mb-3">
                                        <span class="font-semibold text-sm">Step <%= index + 1 %></span>
                                        <button type="button" class="text-danger hover:text-danger/80" onclick="removeStep(this)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4 mb-3">
                                        <div>
                                            <label class="block text-xs font-medium mb-1">Provider</label>
                                            <select name="step-provider" class="form-select form-select-sm" onchange="updateActions(this)">
                                                <% providers.forEach(p => { %>
                                                    <option value="<%= p.key %>" <%= step.providerKey === p.key ? 'selected' : '' %>>
                                                        <%= p.name %>
                                                    </option>
                                                <% }) %>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-xs font-medium mb-1">Action</label>
                                            <select name="step-action" class="form-select form-select-sm">
                                                <% actions.filter(a => a.providerKey === step.providerKey).forEach(a => { %>
                                                    <option value="<%= a._id %>" <%= step.actionId?.toString() === a._id.toString() ? 'selected' : '' %>>
                                                        <%= a.name %>
                                                    </option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium mb-1">Input Mapping (JSON)</label>
                                        <textarea name="step-mapping" class="form-textarea form-textarea-sm font-mono text-xs" rows="3"
                                            placeholder='{"query": "{{trigger.record.name}}"}'><%= JSON.stringify(step.inputMapping || {}, null, 2) %></textarea>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                    
                    <div id="no-steps-message" class="text-center py-8 text-gray-500 dark:text-gray-400 <%= workflow?.steps?.length ? 'hidden' : '' %>">
                        <p>Aucune action configurée</p>
                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="addStep()">
                            Ajouter votre première action
                        </button>
                    </div>
                    
                    <hr class="border-gray-200 dark:border-gray-700 my-6">
                    
                    <div class="flex items-center justify-between">
                        <a href="/account/<%= account_number %>/workflows" class="btn btn-outline-dark">
                            Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <%= workflow ? 'Enregistrer' : 'Créer le workflow' %>
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- Sidebar -->
        <div class="space-y-6">
            <% if (workflow && typeof jobs !== 'undefined' && jobs.length > 0) { %>
                <div class="panel p-6">
                    <h5 class="text-lg font-semibold mb-5 dark:text-white-light">Exécutions récentes</h5>
                    <div class="space-y-3">
                        <% jobs.slice(0, 10).forEach(job => { %>
                            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-900 rounded">
                                <div>
                                    <% if (job.status === 'completed') { %>
                                        <span class="badge bg-success">Succès</span>
                                    <% } else if (job.status === 'failed') { %>
                                        <span class="badge bg-danger">Échec</span>
                                    <% } else if (job.status === 'running') { %>
                                        <span class="badge bg-warning">En cours</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">En attente</span>
                                    <% } %>
                                </div>
                                <span class="text-xs text-gray-500">
                                    <%= new Date(job.createdAt).toLocaleString('fr-FR') %>
                                </span>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% } %>
            
            <!-- Help -->
            <div class="panel p-6">
                <h5 class="text-lg font-semibold mb-4 dark:text-white-light">Variables disponibles</h5>
                <div class="text-sm text-gray-600 dark:text-gray-400 space-y-2">
                    <p><code class="text-xs bg-gray-100 dark:bg-gray-800 px-1 rounded">{{trigger.record}}</code> - Record complet</p>
                    <p><code class="text-xs bg-gray-100 dark:bg-gray-800 px-1 rounded">{{trigger.record.title}}</code> - Titre</p>
                    <p><code class="text-xs bg-gray-100 dark:bg-gray-800 px-1 rounded">{{trigger.record._id}}</code> - ID</p>
                    <p><code class="text-xs bg-gray-100 dark:bg-gray-800 px-1 rounded">{{steps.step1}}</code> - Output step précédent</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const allProviders = <%- JSON.stringify(providers) %>;
const allActions = <%- JSON.stringify(actions) %>;
let stepCounter = <%= workflow?.steps?.length || 0 %>;

function addStep() {
    stepCounter++;
    const container = document.getElementById('steps-container');
    const noStepsMsg = document.getElementById('no-steps-message');
    noStepsMsg.classList.add('hidden');
    
    const stepHtml = `
        <div class="step-item panel bg-gray-50 dark:bg-gray-900 p-4" data-step-index="${stepCounter}">
            <div class="flex items-center justify-between mb-3">
                <span class="font-semibold text-sm">Step ${container.children.length + 1}</span>
                <button type="button" class="text-danger hover:text-danger/80" onclick="removeStep(this)">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-3">
                <div>
                    <label class="block text-xs font-medium mb-1">Provider</label>
                    <select name="step-provider" class="form-select form-select-sm" onchange="updateActions(this)">
                        <option value="">-- Choisir --</option>
                        ${allProviders.map(p => `<option value="${p.key}">${p.name}</option>`).join('')}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium mb-1">Action</label>
                    <select name="step-action" class="form-select form-select-sm">
                        <option value="">-- Choisir provider --</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium mb-1">Input Mapping (JSON)</label>
                <textarea name="step-mapping" class="form-textarea form-textarea-sm font-mono text-xs" rows="3"
                    placeholder='{"query": "{{trigger.record.title}}"}'>{}</textarea>
            </div>
        </div>
    `;
    
    container.insertAdjacentHTML('beforeend', stepHtml);
}

function removeStep(btn) {
    const stepItem = btn.closest('.step-item');
    stepItem.remove();
    
    document.querySelectorAll('.step-item').forEach((item, i) => {
        item.querySelector('.font-semibold').textContent = `Step ${i + 1}`;
    });
    
    if (document.querySelectorAll('.step-item').length === 0) {
        document.getElementById('no-steps-message').classList.remove('hidden');
    }
}

function updateActions(select) {
    const providerKey = select.value;
    const actionSelect = select.closest('.grid').querySelector('[name="step-action"]');
    
    const filteredActions = allActions.filter(a => a.providerKey === providerKey);
    actionSelect.innerHTML = filteredActions.length
        ? filteredActions.map(a => `<option value="${a._id}">${a.name}</option>`).join('')
        : '<option value="">Aucune action</option>';
}

document.getElementById('workflow-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const name = document.getElementById('name').value;
    const description = document.getElementById('description').value;
    const triggerType = document.getElementById('trigger-type').value;
    const triggerEntity = document.getElementById('trigger-entity').value;
    
    const steps = [];
    document.querySelectorAll('.step-item').forEach((item, index) => {
        const providerKey = item.querySelector('[name="step-provider"]').value;
        const actionId = item.querySelector('[name="step-action"]').value;
        let inputMapping = {};
        
        try {
            inputMapping = JSON.parse(item.querySelector('[name="step-mapping"]').value || '{}');
        } catch (e) {
            console.warn('Invalid JSON in step mapping');
        }
        
        if (providerKey && actionId) {
            steps.push({
                id: `step${index + 1}`,
                type: 'action',
                providerKey,
                actionId,
                inputMapping
            });
        }
    });
    
    const payload = {
        name,
        description,
        trigger: {
            type: triggerType,
            entityId: triggerEntity
        },
        steps
    };
    
    const workflowId = '<%= workflow?._id || "" %>';
    const url = workflowId 
        ? `/account/<%= account_number %>/workflows/${workflowId}`
        : `/account/<%= account_number %>/workflows`;
    const method = workflowId ? 'PUT' : 'POST';
    
    try {
        const response = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(payload)
        });
        
        const result = await response.json();
        
        if (result.success) {
            window.location.href = `/account/<%= account_number %>/workflows`;
        } else {
            alert(result.error);
        }
    } catch (error) {
        alert(error.message);
    }
});
</script>
