                                                    <span class="tdm-option-row-label" x-text="option.label"></span>
                                                    <span class="tdm-option-action" @click.stop="$store.taskModal.openOptionEditor('status', option)">
                                                        <iconify-icon icon="solar:menu-dots-bold" width="14"></iconify-icon>
