<!-- SuperAdmin Space Templates Management -->
<div x-data="spaceTemplatesManager()" x-init="init()">
  <!-- Page Header -->
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px;">
    <div>
      <h1 style="font-size: 24px; font-weight: 800; color: #0f172a; margin: 0;">Bibliothèque de Spaces</h1>
      <p style="font-size: 13px; color: #94a3b8; margin: 4px 0 0;">Créez et gérez les espaces de travail préconfigurés pour vos tenants</p>
    </div>
    <button @click="openCreateModal()" class="sa-btn sa-btn-primary">
      <iconify-icon icon="solar:add-circle-bold" width="18"></iconify-icon>
      Nouveau space
    </button>
  </div>

  <!-- Stats Row -->
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 28px;">
    <div class="sa-stat-card">
      <div class="sa-stat-icon" style="background: rgba(67,97,238,0.1);">
        <iconify-icon icon="solar:widget-bold-duotone" width="24" style="color: #4361ee;"></iconify-icon>
      </div>
      <div>
        <div class="sa-stat-value" x-text="templates.length">0</div>
        <div class="sa-stat-label">Total spaces</div>
      </div>
    </div>
    <div class="sa-stat-card">
      <div class="sa-stat-icon" style="background: rgba(22,163,74,0.1);">
        <iconify-icon icon="solar:check-circle-bold-duotone" width="24" style="color: #16a34a;"></iconify-icon>
      </div>
      <div>
        <div class="sa-stat-value" x-text="templates.filter(t => t.active).length">0</div>
        <div class="sa-stat-label">Actifs</div>
      </div>
    </div>
    <div class="sa-stat-card">
      <div class="sa-stat-icon" style="background: rgba(124,58,237,0.1);">
        <iconify-icon icon="solar:star-bold-duotone" width="24" style="color: #7c3aed;"></iconify-icon>
      </div>
      <div>
        <div class="sa-stat-value" x-text="templates.filter(t => t.featured).length">0</div>
        <div class="sa-stat-label">Mis en avant</div>
      </div>
    </div>
    <div class="sa-stat-card">
      <div class="sa-stat-icon" style="background: rgba(8,145,178,0.1);">
        <iconify-icon icon="solar:graph-up-bold-duotone" width="24" style="color: #0891b2;"></iconify-icon>
      </div>
      <div>
        <div class="sa-stat-value" x-text="templates.reduce((sum, t) => sum + (t.usageCount || 0), 0)">0</div>
        <div class="sa-stat-label">Utilisations totales</div>
      </div>
    </div>
  </div>

  <!-- Category Filter -->
  <div style="margin-bottom: 20px; display: flex; gap: 8px; flex-wrap: wrap;">
    <button @click="filterCategory = ''" 
            class="sa-btn sa-btn-sm"
            :class="filterCategory === '' ? 'sa-btn-primary' : 'sa-btn-outline'"
            style="border-radius: 999px;">
      Tous
    </button>
    <template x-for="cat in categories" :key="cat.key">
      <button @click="filterCategory = cat.key"
              class="sa-btn sa-btn-sm"
              :class="filterCategory === cat.key ? 'sa-btn-primary' : 'sa-btn-outline'"
              style="border-radius: 999px;">
        <iconify-icon :icon="cat.icon" width="14"></iconify-icon>
        <span x-text="cat.label"></span>
      </button>
    </template>
  </div>

  <!-- Templates Grid -->
  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 28px;">
    <template x-for="tpl in filteredTemplates" :key="tpl._id">
      <div class="sa-panel" style="cursor: pointer; transition: all 0.2s; position: relative;"
           @mouseenter="$el.style.boxShadow = '0 4px 14px rgba(0,0,0,0.06)'; $el.style.transform = 'translateY(-2px)'"
           @mouseleave="$el.style.boxShadow = 'none'; $el.style.transform = 'none'"
           @click="openEditModal(tpl)">
        
        <!-- Status badges -->
        <div style="position: absolute; top: 12px; right: 12px; display: flex; gap: 6px;">
          <span x-show="tpl.featured" class="sa-badge sa-badge-purple" style="font-size: 9px;">
            <iconify-icon icon="solar:star-bold" width="10"></iconify-icon> Featured
          </span>
          <span :class="tpl.active ? 'sa-badge sa-badge-green' : 'sa-badge sa-badge-red'" style="font-size: 9px;"
                x-text="tpl.active ? 'Actif' : 'Inactif'"></span>
        </div>

        <div style="padding: 24px;">
          <!-- Icon & Name -->
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 12px;">
            <div style="width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center;"
                 :style="'background: ' + (tpl.color || '#4361ee') + '15; color: ' + (tpl.color || '#4361ee')">
              <iconify-icon :icon="tpl.icon || 'solar:widget-bold-duotone'" width="24"></iconify-icon>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="font-size: 15px; font-weight: 700; color: #0f172a;" x-text="tpl.name"></div>
              <div style="font-size: 11px; color: #94a3b8;" x-text="tpl.slug"></div>
            </div>
          </div>

          <!-- Description -->
          <p style="font-size: 12px; color: #64748b; margin: 0 0 14px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
             x-text="tpl.description || 'Aucune description'"></p>

          <!-- Entities badges -->
          <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 12px;">
            <template x-for="ent in (tpl.entities || []).slice(0, 5)" :key="ent.templateSlug">
              <span style="padding: 2px 8px; border-radius: 999px; font-size: 10px; font-weight: 600; background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0;"
                    x-text="ent.name || ent.templateSlug"></span>
            </template>
            <span x-show="(tpl.entities || []).length > 5" style="padding: 2px 8px; border-radius: 999px; font-size: 10px; font-weight: 600; background: #f1f5f9; color: #94a3b8;"
                  x-text="'+' + ((tpl.entities || []).length - 5)"></span>
          </div>

          <!-- Meta row -->
          <div style="display: flex; align-items: center; gap: 12px; font-size: 11px; color: #94a3b8;">
            <span style="display: flex; align-items: center; gap: 4px;">
              <iconify-icon icon="solar:layers-bold" width="12"></iconify-icon>
              <span x-text="(tpl.entities || []).length + ' entités'"></span>
            </span>
            <span style="display: flex; align-items: center; gap: 4px;">
              <iconify-icon icon="solar:link-bold" width="12"></iconify-icon>
              <span x-text="(tpl.relations || []).length + ' relations'"></span>
            </span>
            <span style="display: flex; align-items: center; gap: 4px;">
              <iconify-icon icon="solar:tag-bold" width="12"></iconify-icon>
              <span x-text="getCategoryLabel(tpl.category)"></span>
            </span>
            <span style="display: flex; align-items: center; gap: 4px; margin-left: auto;">
              <iconify-icon icon="solar:graph-up-bold" width="12"></iconify-icon>
              <span x-text="(tpl.usageCount || 0) + ' uses'"></span>
            </span>
          </div>
        </div>
      </div>
    </template>

    <!-- Empty state -->
    <div x-show="filteredTemplates.length === 0" 
         style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: #94a3b8;">
      <iconify-icon icon="solar:widget-broken" width="48" style="margin-bottom: 12px;"></iconify-icon>
      <p style="font-size: 15px; margin: 0;">Aucun space trouvé</p>
      <p style="font-size: 12px; margin: 4px 0 0;">Cliquez sur "Nouveau space" pour en créer un.</p>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- CREATE / EDIT MODAL -->
  <!-- ============================================ -->
  <dialog x-ref="tplModal" class="sa-modal" style="max-width: 720px;">
    <div class="sa-modal-header" style="background: linear-gradient(135deg, #4361ee, #805dca); padding: 24px;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;">
            <iconify-icon :icon="editingId ? 'solar:pen-bold-duotone' : 'solar:add-circle-bold-duotone'" width="22" style="color: #fff;"></iconify-icon>
          </div>
          <div>
            <h3 style="font-size: 17px; font-weight: 700; color: #fff; margin: 0;" 
                x-text="editingId ? 'Modifier le space' : 'Nouveau space'"></h3>
            <p style="font-size: 12px; color: rgba(255,255,255,0.7); margin: 2px 0 0;">
              <span x-text="editingId ? 'Modifiez les paramètres du space' : 'Configurez un nouveau space template'"></span>
            </p>
          </div>
        </div>
        <button @click="closeModal()" style="width: 32px; height: 32px; border-radius: 8px; background: rgba(255,255,255,0.15); border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;">
          <iconify-icon icon="solar:close-circle-bold" width="20" style="color: #fff;"></iconify-icon>
        </button>
      </div>
    </div>

    <div class="sa-modal-body" style="padding: 24px; max-height: 60vh; overflow-y: auto;">
      <!-- Tabs -->
      <div style="display: flex; border-bottom: 1px solid #e2e8f0; margin-bottom: 20px;">
        <button @click="modalTab = 'general'" 
                style="padding: 10px 20px; font-size: 13px; font-weight: 600; border: none; background: none; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.15s;"
                :style="modalTab === 'general' ? 'border-color: #4361ee; color: #4361ee;' : 'color: #94a3b8;'">
          <iconify-icon icon="solar:info-circle-bold-duotone" width="14" style="margin-right: 4px; vertical-align: -2px;"></iconify-icon>
          Général
        </button>
        <button @click="modalTab = 'entities'" 
                style="padding: 10px 20px; font-size: 13px; font-weight: 600; border: none; background: none; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.15s;"
                :style="modalTab === 'entities' ? 'border-color: #4361ee; color: #4361ee;' : 'color: #94a3b8;'">
          <iconify-icon icon="solar:layers-bold-duotone" width="14" style="margin-right: 4px; vertical-align: -2px;"></iconify-icon>
          Entités
          <span x-show="form.entities.length > 0" 
                style="margin-left: 4px; padding: 1px 6px; border-radius: 999px; font-size: 10px; background: rgba(67,97,238,0.15); color: #4361ee;"
                x-text="form.entities.length"></span>
        </button>
        <button @click="modalTab = 'relations'" 
                style="padding: 10px 20px; font-size: 13px; font-weight: 600; border: none; background: none; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.15s;"
                :style="modalTab === 'relations' ? 'border-color: #4361ee; color: #4361ee;' : 'color: #94a3b8;'">
          <iconify-icon icon="solar:link-bold-duotone" width="14" style="margin-right: 4px; vertical-align: -2px;"></iconify-icon>
          Relations
          <span x-show="form.relations.length > 0" 
                style="margin-left: 4px; padding: 1px 6px; border-radius: 999px; font-size: 10px; background: rgba(8,145,178,0.15); color: #0891b2;"
                x-text="form.relations.length"></span>
        </button>
      </div>

      <!-- TAB: General -->
      <div x-show="modalTab === 'general'" style="display: grid; gap: 16px;">
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px;">
          <div>
            <label class="sa-label">Nom <span style="color: #dc2626;">*</span></label>
            <input x-model="form.name" @input="autoSlug()" type="text" class="sa-input" placeholder="Ex: CRM, Gestion Projet..." />
          </div>
          <div>
            <label class="sa-label">Slug</label>
            <input x-model="form.slug" type="text" class="sa-input" placeholder="auto-generated" style="font-family: monospace; font-size: 12px;" />
          </div>
        </div>

        <div>
          <label class="sa-label">Description</label>
          <textarea x-model="form.description" class="sa-input" rows="2" placeholder="Description du space..." style="resize: vertical;"></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label class="sa-label">Catégorie</label>
            <select x-model="form.category" class="sa-select" style="width: 100%;">
              <template x-for="cat in categories" :key="cat.key">
                <option :value="cat.key" x-text="cat.label"></option>
              </template>
            </select>
          </div>
          <div>
            <label class="sa-label">Couleur</label>
            <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px;">
              <template x-for="c in ['#4361ee','#00ab55','#e7515a','#805dca','#e2a03f','#2196f3','#f97316','#0891b2','#64748b']" :key="c">
                <button type="button" @click="form.color = c"
                        style="width: 28px; height: 28px; border-radius: 8px; border: 2px solid transparent; cursor: pointer; transition: all 0.15s;"
                        :style="'background: ' + c + '; border-color: ' + (form.color === c ? '#0f172a' : 'transparent') + '; transform: ' + (form.color === c ? 'scale(1.15)' : 'scale(1)')">
                </button>
              </template>
            </div>
          </div>
        </div>

        <div>
          <label class="sa-label">Icône</label>
          <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; border: 1px solid #e2e8f0;"
                 :style="'background: ' + (form.color || '#4361ee') + '15; color: ' + (form.color || '#4361ee')">
              <iconify-icon :icon="form.icon || 'solar:widget-bold-duotone'" width="22"></iconify-icon>
            </div>
            <input x-model="form.icon" type="text" class="sa-input" placeholder="solar:widget-bold-duotone" style="flex: 1; font-family: monospace; font-size: 12px;" />
          </div>
        </div>

        <div style="display: flex; gap: 24px; padding-top: 8px; border-top: 1px solid #f1f5f9;">
          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; color: #334155;">
            <input type="checkbox" x-model="form.active" style="accent-color: #4361ee; width: 16px; height: 16px;" />
            <span>Actif</span>
          </label>
          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; color: #334155;">
            <input type="checkbox" x-model="form.featured" style="accent-color: #7c3aed; width: 16px; height: 16px;" />
            <span>Mis en avant</span>
          </label>
        </div>
      </div>

      <!-- TAB: Entities -->
      <div x-show="modalTab === 'entities'">
        <!-- Selected entities -->
        <div x-show="form.entities.length > 0" style="margin-bottom: 16px;">
          <label style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; display: block;">
            Entités incluses (<span x-text="form.entities.length"></span>)
          </label>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            <template x-for="(ent, eIdx) in form.entities" :key="eIdx">
              <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px 4px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; background: rgba(67,97,238,0.1); color: #4361ee; border: 1px solid rgba(67,97,238,0.2);">
                <iconify-icon :icon="ent.icon || getEntityIcon(ent.templateSlug)" width="13"></iconify-icon>
                <span x-text="ent.name || getEntityName(ent.templateSlug)"></span>
                <span x-show="ent.isMain" style="margin-left: 2px; font-size: 9px; background: #4361ee; color: #fff; padding: 0 4px; border-radius: 4px;">Main</span>
                <button @click="form.entities.splice(eIdx, 1)" type="button"
                        style="width: 16px; height: 16px; border-radius: 50%; border: none; background: transparent; color: #4361ee; cursor: pointer; display: flex; align-items: center; justify-content: center; margin-left: 2px; opacity: 0.6;"
                        onmouseenter="this.style.opacity='1'; this.style.color='#dc2626'" 
                        onmouseleave="this.style.opacity='0.6'; this.style.color='#4361ee'">
                  <iconify-icon icon="solar:close-circle-bold" width="13"></iconify-icon>
                </button>
              </span>
            </template>
          </div>
        </div>

        <!-- Entity templates picker -->
        <label style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; display: block;">
          Choisir des entités depuis la bibliothèque
        </label>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px; max-height: 300px; overflow-y: auto; padding-right: 4px;">
          <template x-for="etpl in entityTemplatesList" :key="etpl.slug">
            <button @click="addEntity(etpl)" type="button"
                    :disabled="form.entities.some(e => e.templateSlug === etpl.slug)"
                    style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 8px; border: 1px solid #e2e8f0; background: #fff; cursor: pointer; text-align: left; transition: all 0.15s; font-size: 12px;"
                    :style="form.entities.some(e => e.templateSlug === etpl.slug) ? 'opacity: 0.4; cursor: not-allowed; background: #f1f5f9;' : ''"
                    onmouseenter="if(!this.disabled){this.style.background='rgba(67,97,238,0.06)'; this.style.borderColor='rgba(67,97,238,0.3)';}"
                    onmouseleave="if(!this.disabled){this.style.background='#fff'; this.style.borderColor='#e2e8f0';}">
              <div style="width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"
                   :style="'background: ' + (etpl.color || '#4361ee') + '15; color: ' + (etpl.color || '#4361ee')">
                <iconify-icon :icon="etpl.icon || 'solar:box-bold-duotone'" width="14"></iconify-icon>
              </div>
              <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 600; color: #0f172a; line-height: 1.3;" x-text="etpl.name"></div>
                <div style="font-size: 10px; color: #94a3b8;" x-text="(etpl.fields || []).length + ' champs'"></div>
              </div>
              <iconify-icon x-show="form.entities.some(e => e.templateSlug === etpl.slug)" icon="solar:check-circle-bold" width="16" style="color: #10b981; flex-shrink: 0;"></iconify-icon>
              <iconify-icon x-show="!form.entities.some(e => e.templateSlug === etpl.slug)" icon="solar:add-circle-linear" width="16" style="color: #94a3b8; flex-shrink: 0;"></iconify-icon>
            </button>
          </template>
        </div>

        <div x-show="entityTemplatesList.length === 0" style="text-align: center; padding: 30px; color: #94a3b8;">
          <iconify-icon icon="solar:layers-broken" width="32" style="margin-bottom: 8px;"></iconify-icon>
          <p style="font-size: 13px; margin: 0;">Aucun modèle d'entité disponible</p>
          <p style="font-size: 11px; margin: 4px 0 0;">Créez d'abord des modèles d'entités.</p>
        </div>
      </div>

      <!-- TAB: Relations -->
      <div x-show="modalTab === 'relations'">
        <button @click="addRelation()" type="button"
                :disabled="form.entities.length < 2"
                style="width: 100%; padding: 10px; margin-bottom: 16px; border: 1px dashed #0891b2; border-radius: 10px; background: rgba(8,145,178,0.04); color: #0891b2; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; transition: all 0.15s;"
                :style="form.entities.length < 2 ? 'opacity: 0.5; cursor: not-allowed;' : ''">
          <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
          Ajouter une relation
        </button>

        <div x-show="form.entities.length < 2" style="text-align: center; padding: 20px; color: #f59e0b; font-size: 12px;">
          <iconify-icon icon="solar:info-circle-bold" width="16" style="vertical-align: -2px;"></iconify-icon>
          Ajoutez au moins 2 entités avant de définir des relations.
        </div>

        <div style="display: flex; flex-direction: column; gap: 10px; max-height: 300px; overflow-y: auto;">
          <template x-for="(rel, rIdx) in form.relations" :key="rIdx">
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px; position: relative;">
              <button @click="form.relations.splice(rIdx, 1)" type="button"
                      style="position: absolute; top: 8px; right: 8px; width: 24px; height: 24px; border-radius: 6px; border: none; background: transparent; color: #94a3b8; cursor: pointer; display: flex; align-items: center; justify-content: center;"
                      onmouseenter="this.style.color='#dc2626'; this.style.background='#fee2e2'" 
                      onmouseleave="this.style.color='#94a3b8'; this.style.background='transparent'">
                <iconify-icon icon="solar:trash-bin-trash-bold" width="14"></iconify-icon>
              </button>

              <div style="display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: end;">
                <div>
                  <label style="font-size: 11px; font-weight: 600; color: #64748b; margin-bottom: 4px; display: block;">De</label>
                  <select x-model="rel.from" class="sa-select" style="width: 100%; font-size: 12px; padding: 7px 10px;">
                    <template x-for="ent in form.entities" :key="ent.templateSlug">
                      <option :value="ent.templateSlug" x-text="ent.name || ent.templateSlug"></option>
                    </template>
                  </select>
                </div>
                <div style="padding-bottom: 4px;">
                  <select x-model="rel.type" class="sa-select" style="font-size: 11px; padding: 6px 8px; min-width: 120px;">
                    <option value="one-to-many">1 → N</option>
                    <option value="many-to-one">N → 1</option>
                    <option value="many-to-many">N → N</option>
                    <option value="one-to-one">1 → 1</option>
                  </select>
                </div>
                <div>
                  <label style="font-size: 11px; font-weight: 600; color: #64748b; margin-bottom: 4px; display: block;">Vers</label>
                  <select x-model="rel.to" class="sa-select" style="width: 100%; font-size: 12px; padding: 7px 10px;">
                    <template x-for="ent in form.entities" :key="ent.templateSlug">
                      <option :value="ent.templateSlug" x-text="ent.name || ent.templateSlug"></option>
                    </template>
                  </select>
                </div>
              </div>
              <div style="margin-top: 8px;">
                <input x-model="rel.label" type="text" class="sa-input" placeholder="Label de la relation (ex: Tâches du projet)" style="font-size: 12px; padding: 6px 10px;" />
              </div>
            </div>
          </template>

          <div x-show="form.relations.length === 0 && form.entities.length >= 2" style="text-align: center; padding: 30px; color: #94a3b8;">
            <iconify-icon icon="solar:link-broken" width="32" style="margin-bottom: 8px;"></iconify-icon>
            <p style="font-size: 13px; margin: 0;">Aucune relation configurée</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="sa-modal-footer" style="display: flex; align-items: center; justify-content: space-between;">
      <div>
        <template x-if="editingId">
          <div style="display: flex; gap: 8px;">
            <button @click="duplicateTemplate()" class="sa-btn sa-btn-outline sa-btn-sm">
              <iconify-icon icon="solar:copy-bold" width="14"></iconify-icon>
              Dupliquer
            </button>
            <button @click="deleteTemplate()" class="sa-btn sa-btn-danger sa-btn-sm">
              <iconify-icon icon="solar:trash-bin-2-bold" width="14"></iconify-icon>
              Supprimer
            </button>
          </div>
        </template>
      </div>
      <div style="display: flex; gap: 10px;">
        <button @click="closeModal()" class="sa-btn sa-btn-outline">Annuler</button>
        <button @click="saveTemplate()" class="sa-btn sa-btn-primary" :disabled="saving">
          <iconify-icon :icon="saving ? 'svg-spinners:ring-resize' : 'solar:check-circle-bold'" width="16"></iconify-icon>
          <span x-text="saving ? 'Enregistrement...' : (editingId ? 'Mettre à jour' : 'Créer')"></span>
        </button>
      </div>
    </div>
  </dialog>
</div>

<script>
function spaceTemplatesManager() {
  const categoriesData = <%- JSON.stringify(categories) %>;
  const entityTemplatesData = <%- JSON.stringify(entityTemplates.map(t => ({
    _id: t._id, name: t.name, slug: t.slug, icon: t.icon, color: t.color,
    category: t.category, fields: t.fields, classifications: t.classifications
  }))) %>;
  const initialTemplates = <%- JSON.stringify(templates.map(t => ({
    _id: t._id, name: t.name, slug: t.slug, description: t.description,
    icon: t.icon, color: t.color, category: t.category, tags: t.tags,
    entities: t.entities, relations: t.relations, defaultViews: t.defaultViews,
    active: t.active, featured: t.featured, order: t.order, usageCount: t.usageCount
  }))) %>;

  return {
    templates: initialTemplates,
    categories: categoriesData,
    entityTemplatesList: entityTemplatesData,
    filterCategory: '',
    modalTab: 'general',
    editingId: null,
    saving: false,

    form: {
      name: '', slug: '', description: '',
      icon: 'solar:widget-bold-duotone', color: '#4361ee',
      category: 'general', tags: [],
      entities: [], relations: [], defaultViews: [],
      active: true, featured: false, order: 0
    },

    get filteredTemplates() {
      if (!this.filterCategory) return this.templates;
      return this.templates.filter(t => t.category === this.filterCategory);
    },

    init() {},

    getCategoryLabel(key) {
      const cat = this.categories.find(c => c.key === key);
      return cat ? cat.label : key;
    },

    getEntityName(slug) {
      const etpl = this.entityTemplatesList.find(e => e.slug === slug);
      return etpl ? etpl.name : slug;
    },

    getEntityIcon(slug) {
      const etpl = this.entityTemplatesList.find(e => e.slug === slug);
      return etpl ? (etpl.icon || 'solar:box-bold-duotone') : 'solar:box-bold-duotone';
    },

    autoSlug() {
      this.form.slug = this.form.name.toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
    },

    addEntity(etpl) {
      if (this.form.entities.some(e => e.templateSlug === etpl.slug)) return;
      this.form.entities.push({
        templateSlug: etpl.slug,
        name: etpl.name,
        icon: etpl.icon,
        color: etpl.color,
        isMain: this.form.entities.length === 0,
        order: this.form.entities.length
      });
    },

    addRelation() {
      if (this.form.entities.length < 2) return;
      this.form.relations.push({
        from: this.form.entities[0]?.templateSlug || '',
        to: this.form.entities[1]?.templateSlug || '',
        type: 'one-to-many',
        label: ''
      });
    },

    resetForm() {
      this.form = {
        name: '', slug: '', description: '',
        icon: 'solar:widget-bold-duotone', color: '#4361ee',
        category: 'general', tags: [],
        entities: [], relations: [], defaultViews: [],
        active: true, featured: false, order: 0
      };
      this.editingId = null;
      this.modalTab = 'general';
    },

    openCreateModal() {
      this.resetForm();
      this.$refs.tplModal.showModal();
    },

    openEditModal(tpl) {
      this.editingId = tpl._id;
      this.form = {
        name: tpl.name || '',
        slug: tpl.slug || '',
        description: tpl.description || '',
        icon: tpl.icon || 'solar:widget-bold-duotone',
        color: tpl.color || '#4361ee',
        category: tpl.category || 'general',
        tags: [...(tpl.tags || [])],
        entities: (tpl.entities || []).map(e => ({ ...e })),
        relations: (tpl.relations || []).map(r => ({ ...r })),
        defaultViews: (tpl.defaultViews || []).map(v => ({ ...v })),
        active: tpl.active !== false,
        featured: tpl.featured || false,
        order: tpl.order || 0
      };
      this.modalTab = 'general';
      this.$refs.tplModal.showModal();
    },

    closeModal() {
      this.$refs.tplModal.close();
    },

    async saveTemplate() {
      if (!this.form.name) return alert('Le nom est requis');
      this.saving = true;

      try {
        const url = this.editingId
          ? `/superadmin/api/space-templates/${this.editingId}`
          : '/superadmin/api/space-templates';

        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(this.form)
        });

        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Erreur');

        if (this.editingId) {
          const idx = this.templates.findIndex(t => t._id === this.editingId);
          if (idx >= 0) this.templates[idx] = data.template;
        } else {
          this.templates.push(data.template);
        }

        this.closeModal();
        this.resetForm();
      } catch (err) {
        alert(err.message);
      } finally {
        this.saving = false;
      }
    },

    async duplicateTemplate() {
      if (!this.editingId) return;
      try {
        const res = await fetch(`/superadmin/api/space-templates/${this.editingId}/duplicate`, {
          method: 'POST', credentials: 'include'
        });
        const data = await res.json();
        if (data.success) {
          this.templates.push(data.template);
          this.closeModal();
        }
      } catch (err) {
        alert('Erreur lors de la duplication');
      }
    },

    async deleteTemplate() {
      if (!this.editingId) return;
      if (!confirm('Supprimer ce space définitivement ?')) return;

      try {
        const res = await fetch(`/superadmin/api/space-templates/${this.editingId}`, {
          method: 'DELETE', credentials: 'include'
        });
        const data = await res.json();
        if (data.success) {
          this.templates = this.templates.filter(t => t._id !== this.editingId);
          this.closeModal();
          this.resetForm();
        }
      } catch (err) {
        alert('Erreur lors de la suppression');
      }
    }
  };
}
</script>
