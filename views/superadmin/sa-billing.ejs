<!-- SuperAdmin Billing -->
<div>
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; color: #0f172a; margin: 0;">Facturation</h1>
            <p style="font-size: 13px; color: #94a3b8; margin: 4px 0 0;">Plans, abonnements et providers de paiement des workspaces</p>
        </div>
        <button type="button" class="sa-btn sa-btn-outline" onclick="syncDefaultPlans()">
            <iconify-icon icon="solar:refresh-bold" width="16"></iconify-icon>
            Synchroniser les plans
        </button>
    </div>

    <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div class="sa-stat-card">
            <div class="sa-stat-icon" style="background: rgba(22,163,74,0.1);">
                <iconify-icon icon="solar:wallet-money-bold-duotone" width="24" style="color: #16a34a;"></iconify-icon>
            </div>
            <div>
                <div class="sa-stat-value"><%= stats.mrr.toLocaleString('fr-FR', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) %> €</div>
                <div class="sa-stat-label">MRR estimé</div>
            </div>
        </div>
        <div class="sa-stat-card">
            <div class="sa-stat-icon" style="background: rgba(67,97,238,0.1);">
                <iconify-icon icon="solar:buildings-bold-duotone" width="24" style="color: #4361ee;"></iconify-icon>
            </div>
            <div>
                <div class="sa-stat-value"><%= stats.paid %></div>
                <div class="sa-stat-label">Comptes payants</div>
            </div>
        </div>
        <div class="sa-stat-card">
            <div class="sa-stat-icon" style="background: rgba(100,116,139,0.1);">
                <iconify-icon icon="solar:user-rounded-bold-duotone" width="24" style="color: #64748b;"></iconify-icon>
            </div>
            <div>
                <div class="sa-stat-value"><%= stats.free %></div>
                <div class="sa-stat-label">Perso gratuit</div>
            </div>
        </div>
        <div class="sa-stat-card">
            <div class="sa-stat-icon" style="background: rgba(217,119,6,0.1);">
                <iconify-icon icon="solar:clock-circle-bold-duotone" width="24" style="color: #d97706;"></iconify-icon>
            </div>
            <div>
                <div class="sa-stat-value"><%= stats.trialing %></div>
                <div class="sa-stat-label">En découverte</div>
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1.4fr 2fr; gap: 20px; margin-bottom: 24px;">
        <div class="sa-panel">
            <div class="sa-panel-header">
                <div style="font-size: 15px; font-weight: 700; color: #0f172a;">
                    <iconify-icon icon="solar:layers-bold-duotone" width="18" style="color: #4361ee; margin-right: 6px; vertical-align: -3px;"></iconify-icon>
                    Catalogue
                </div>
            </div>
            <div class="sa-panel-body" style="display: grid; gap: 10px;">
                <% plans.forEach(plan => { %>
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px; border: 1px solid #eef2f7; border-radius: 12px;">
                        <div style="min-width: 0;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="width: 8px; height: 8px; border-radius: 999px; background: <%= plan.color || '#64748b' %>;"></span>
                                <strong style="font-size: 13.5px; color: #0f172a;"><%= plan.name %></strong>
                                <span class="sa-badge <%= plan.billingModel === 'per_seat' ? 'sa-badge-cyan' : plan.billingModel === 'flat' ? 'sa-badge-blue' : 'sa-badge-gray' %>" style="font-size: 10px;">
                                    <%= plan.billingModel === 'per_seat' ? 'par user' : plan.billingModel === 'flat' ? 'forfait' : 'gratuit' %>
                                </span>
                            </div>
                            <div style="font-size: 11.5px; color: #94a3b8; margin-top: 4px;"><%= plan.description || '' %></div>
                        </div>
                        <div style="font-size: 14px; font-weight: 800; color: #0f172a; white-space: nowrap;">
                            <%= plan.price?.monthly || 0 %> €
                            <span style="font-size: 11px; font-weight: 600; color: #94a3b8;">/mois</span>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <div class="sa-panel">
            <div class="sa-panel-header">
                <div style="font-size: 15px; font-weight: 700; color: #0f172a;">
                    <iconify-icon icon="solar:card-bold-duotone" width="18" style="color: #0891b2; margin-right: 6px; vertical-align: -3px;"></iconify-icon>
                    Providers prêts
                </div>
            </div>
            <div class="sa-panel-body" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px;">
                <div style="padding: 14px; border: 1px solid #eef2f7; border-radius: 12px; background: #f8fafc;">
                    <div class="sa-badge sa-badge-gray">Manual</div>
                    <div style="font-size: 12px; color: #64748b; margin-top: 10px;">Gestion interne, utile avant d'activer un provider.</div>
                </div>
                <div style="padding: 14px; border: 1px solid #dbeafe; border-radius: 12px; background: #eff6ff;">
                    <div class="sa-badge sa-badge-blue">Stripe</div>
                    <div style="font-size: 12px; color: #64748b; margin-top: 10px;">Champs customer, subscription et price déjà prévus.</div>
                </div>
                <div style="padding: 14px; border: 1px solid #cffafe; border-radius: 12px; background: #ecfeff;">
                    <div class="sa-badge sa-badge-cyan">Chargebee</div>
                    <div style="font-size: 12px; color: #64748b; margin-top: 10px;">Même structure pour migrer ou choisir Chargebee.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="sa-panel">
        <div class="sa-panel-header" style="gap: 16px;">
            <div>
                <div style="font-size: 15px; font-weight: 700; color: #0f172a;">
                    <iconify-icon icon="solar:bill-list-bold-duotone" width="18" style="color: #7c3aed; margin-right: 6px; vertical-align: -3px;"></iconify-icon>
                    Abonnements workspaces
                </div>
                <div style="font-size: 12px; color: #94a3b8; margin-top: 2px;"><%= stats.accounts %> comptes au total</div>
            </div>
            <div style="width: 280px; position: relative;">
                <iconify-icon icon="solar:magnifer-bold" width="16" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></iconify-icon>
                <input id="billingSearch" type="search" class="sa-input" placeholder="Rechercher un compte..." style="padding-left: 36px;" oninput="filterBillingRows()" />
            </div>
        </div>
        <div style="overflow-x: auto;">
            <table class="sa-table" id="billingTable">
                <thead>
                    <tr>
                        <th>Workspace</th>
                        <th>Propriétaire</th>
                        <th>Plan</th>
                        <th>Statut</th>
                        <th>Provider</th>
                        <th>Seats</th>
                        <th>MRR</th>
                        <th>Prochaine facture</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% rows.forEach(row => { %>
                        <tr data-search="<%= `${row.accountName} ${row.accountNumber} ${row.ownerName} ${row.ownerEmail} ${row.planName}`.toLowerCase() %>">
                            <td>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div class="sa-avatar sa-avatar-sm" style="background: rgba(67,97,238,0.1); color: #4361ee;">
                                        <iconify-icon icon="<%= row.accountIcon || 'solar:home-2-bold-duotone' %>" width="15"></iconify-icon>
                                    </div>
                                    <div>
                                        <div style="font-weight: 700; color: #0f172a;"><%= row.accountName %></div>
                                        <div style="font-size: 11px; color: #94a3b8; font-family: monospace;">#<%= row.accountNumber %></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="font-weight: 600; color: #334155;"><%= row.ownerName %></div>
                                <div style="font-size: 11px; color: #94a3b8;"><%= row.ownerEmail %></div>
                            </td>
                            <td>
                                <span class="sa-badge <%= row.billingModel === 'per_seat' ? 'sa-badge-cyan' : row.planSlug === 'free' ? 'sa-badge-gray' : 'sa-badge-blue' %>">
                                    <span style="width: 6px; height: 6px; border-radius: 999px; background: <%= row.planColor %>;"></span>
                                    <%= row.planName %>
                                </span>
                            </td>
                            <td>
                                <span class="sa-badge <%= row.status === 'active' ? 'sa-badge-green' : row.status === 'trialing' ? 'sa-badge-yellow' : row.status === 'past_due' ? 'sa-badge-red' : 'sa-badge-gray' %>">
                                    <%= row.status %>
                                </span>
                            </td>
                            <td>
                                <span class="sa-badge <%= row.provider === 'stripe' ? 'sa-badge-blue' : row.provider === 'chargebee' ? 'sa-badge-cyan' : 'sa-badge-gray' %>">
                                    <%= row.provider %>
                                </span>
                            </td>
                            <td>
                                <strong style="color: #0f172a;"><%= row.billableSeats %></strong>
                                <span style="font-size: 11px; color: #94a3b8;">fact. / <%= row.activeSeats %> actifs</span>
                            </td>
                            <td style="font-weight: 800; color: #0f172a;"><%= row.monthlyAmount.toLocaleString('fr-FR', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) %> €</td>
                            <td style="font-size: 12px; color: #64748b;">
                                <%= row.nextBillingDate ? new Date(row.nextBillingDate).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %>
                            </td>
                            <td style="text-align: right;">
                                <button type="button" class="sa-btn sa-btn-outline sa-btn-sm" onclick="openBillingModal('<%= row.accountNumber %>')">
                                    <iconify-icon icon="solar:pen-bold" width="14"></iconify-icon>
                                    Modifier
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<dialog id="billingModal" class="sa-modal" style="max-width: 760px;">
    <div class="sa-modal-header" style="border-bottom: 1px solid #f1f5f9;">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px;">
            <div>
                <h3 id="billingModalTitle" style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">Modifier l'abonnement</h3>
                <p id="billingModalSubtitle" style="font-size: 12px; color: #94a3b8; margin: 4px 0 0;"></p>
            </div>
            <button type="button" class="sa-btn-icon" onclick="document.getElementById('billingModal').close()" title="Fermer">
                <iconify-icon icon="solar:close-circle-bold" width="22"></iconify-icon>
            </button>
        </div>
    </div>

    <form id="billingForm" class="sa-modal-body" style="padding-top: 24px;">
        <input type="hidden" name="accountNumber" id="billingAccountNumber" />

        <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px;">
            <div>
                <label class="sa-label">Plan</label>
                <select name="planSlug" id="billingPlanSlug" class="sa-select" style="width: 100%;" onchange="refreshBillingPreview()">
                    <% plans.forEach(plan => { %>
                        <option value="<%= plan.slug %>"><%= plan.name %> — <%= plan.price?.monthly || 0 %> €/mois</option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="sa-label">Statut</label>
                <select name="status" id="billingStatus" class="sa-select" style="width: 100%;">
                    <option value="active">Actif</option>
                    <option value="trialing">Découverte</option>
                    <option value="past_due">Paiement en retard</option>
                    <option value="canceled">Annulé</option>
                    <option value="paused">En pause</option>
                    <option value="incomplete">Incomplet</option>
                </select>
            </div>
            <div>
                <label class="sa-label">Provider</label>
                <select name="provider" id="billingProvider" class="sa-select" style="width: 100%;">
                    <option value="manual">Manual</option>
                    <option value="stripe">Stripe</option>
                    <option value="chargebee">Chargebee</option>
                </select>
            </div>
            <div>
                <label class="sa-label">Cycle</label>
                <select name="cycle" id="billingCycle" class="sa-select" style="width: 100%;" onchange="refreshBillingPreview()">
                    <option value="monthly">Mensuel</option>
                    <option value="annual">Annuel</option>
                </select>
            </div>
            <div>
                <label class="sa-label">Seats facturables</label>
                <input name="billableSeats" id="billingBillableSeats" type="number" min="1" class="sa-input" oninput="refreshBillingPreview()" />
            </div>
            <div>
                <label class="sa-label">Prochaine facture</label>
                <input name="nextBillingDate" id="billingNextBillingDate" type="date" class="sa-input" />
            </div>
            <div>
                <label class="sa-label">Fin de période</label>
                <input name="currentPeriodEnd" id="billingCurrentPeriodEnd" type="date" class="sa-input" />
            </div>
            <div>
                <label class="sa-label">Fin découverte</label>
                <input name="trialEndsAt" id="billingTrialEndsAt" type="date" class="sa-input" />
            </div>
            <div>
                <label class="sa-label">Customer ID provider</label>
                <input name="providerCustomerId" id="billingProviderCustomerId" class="sa-input" placeholder="cus_... ou customer Chargebee" />
            </div>
            <div>
                <label class="sa-label">Subscription ID provider</label>
                <input name="providerSubscriptionId" id="billingProviderSubscriptionId" class="sa-input" placeholder="sub_... ou subscription Chargebee" />
            </div>
            <div>
                <label class="sa-label">Price ID provider</label>
                <input name="providerPriceId" id="billingProviderPriceId" class="sa-input" placeholder="price_... ou item price Chargebee" />
            </div>
            <div>
                <label class="sa-label">Aperçu</label>
                <div id="billingPreview" style="min-height: 42px; display: flex; align-items: center; padding: 10px 14px; border-radius: 10px; background: #f8fafc; color: #334155; font-size: 13px; font-weight: 600;"></div>
            </div>
        </div>

        <div style="margin-top: 16px;">
            <label class="sa-label">Note interne</label>
            <textarea name="adminNote" id="billingAdminNote" class="sa-input" rows="3" placeholder="Infos de migration, contrat, décision commerciale..."></textarea>
        </div>
    </form>

    <div class="sa-modal-footer">
        <button type="button" class="sa-btn sa-btn-outline" onclick="document.getElementById('billingModal').close()">Annuler</button>
        <button type="button" class="sa-btn sa-btn-primary" id="saveBillingBtn" onclick="saveBillingSubscription()">
            <iconify-icon icon="solar:diskette-bold" width="16"></iconify-icon>
            Enregistrer
        </button>
    </div>
</dialog>

<script>
const billingData = <%- billingJson %>;

function planBySlug(slug) {
    return billingData.plans.find(plan => plan.slug === slug) || billingData.plans[0];
}

function formatEuro(amount) {
    return `${Number(amount || 0).toLocaleString('fr-FR', { minimumFractionDigits: 0, maximumFractionDigits: 2 })} €`;
}

function filterBillingRows() {
    const query = (document.getElementById('billingSearch').value || '').trim().toLowerCase();
    document.querySelectorAll('#billingTable tbody tr').forEach(row => {
        row.style.display = !query || row.dataset.search.includes(query) ? '' : 'none';
    });
}

function openBillingModal(accountNumber) {
    const row = billingData.rows.find(item => item.accountNumber === accountNumber);
    if (!row) return;

    document.getElementById('billingModalTitle').textContent = row.accountName;
    document.getElementById('billingModalSubtitle').textContent = `#${row.accountNumber} · ${row.ownerName}`;
    document.getElementById('billingAccountNumber').value = row.accountNumber;
    document.getElementById('billingPlanSlug').value = row.planSlug;
    document.getElementById('billingStatus').value = row.status;
    document.getElementById('billingProvider').value = row.provider;
    document.getElementById('billingCycle').value = row.cycle;
    document.getElementById('billingBillableSeats').value = row.billableSeats || 1;
    document.getElementById('billingNextBillingDate').value = row.nextBillingDateInput || '';
    document.getElementById('billingCurrentPeriodEnd').value = row.currentPeriodEndInput || '';
    document.getElementById('billingTrialEndsAt').value = row.trialEndsAtInput || '';
    document.getElementById('billingProviderCustomerId').value = row.providerCustomerId || '';
    document.getElementById('billingProviderSubscriptionId').value = row.providerSubscriptionId || '';
    document.getElementById('billingProviderPriceId').value = row.providerPriceId || '';
    document.getElementById('billingAdminNote').value = row.adminNote || '';

    refreshBillingPreview();
    document.getElementById('billingModal').showModal();
}

function refreshBillingPreview() {
    const plan = planBySlug(document.getElementById('billingPlanSlug').value);
    const cycle = document.getElementById('billingCycle').value;
    const seatsInput = document.getElementById('billingBillableSeats');
    const seats = Math.max(1, Number(seatsInput.value || 1));
    const unit = cycle === 'annual' ? Number(plan.price?.annual || 0) / 12 : Number(plan.price?.monthly || 0);
    const multiplier = plan.billingModel === 'per_seat' ? seats : plan.billingModel === 'flat' ? 1 : 0;
    const monthlyTotal = unit * multiplier;

    seatsInput.disabled = plan.billingModel !== 'per_seat';
    document.getElementById('billingPreview').textContent = plan.billingModel === 'per_seat'
        ? `${formatEuro(monthlyTotal)} MRR · ${seats} utilisateur${seats > 1 ? 's' : ''} facturable${seats > 1 ? 's' : ''}`
        : `${formatEuro(monthlyTotal)} MRR · ${plan.billingModel === 'flat' ? 'forfait personnel' : 'gratuit'}`;
}

async function saveBillingSubscription() {
    const form = document.getElementById('billingForm');
    const btn = document.getElementById('saveBillingBtn');
    const payload = Object.fromEntries(new FormData(form));

    btn.disabled = true;
    btn.innerHTML = '<iconify-icon icon="svg-spinners:ring-resize" width="16"></iconify-icon> Enregistrement...';

    try {
        const res = await fetch('/superadmin/api/billing/subscription', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Erreur');
        location.reload();
    } catch (error) {
        alert(error.message || 'Erreur');
        btn.disabled = false;
        btn.innerHTML = '<iconify-icon icon="solar:diskette-bold" width="16"></iconify-icon> Enregistrer';
    }
}

async function syncDefaultPlans() {
    try {
        const res = await fetch('/superadmin/api/billing/plans/sync-defaults', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Erreur');
        location.reload();
    } catch (error) {
        alert(error.message || 'Erreur');
    }
}
</script>
