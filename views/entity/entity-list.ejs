                      <iconify-icon :icon="field.icon || 'solar:widget-bold'" width="12"></iconify-icon>
                      <span x-text="field.label || field.name || 'Champ'"></span>
                      <button type="button" @click="selectedFields.splice(idx, 1)" class="hover:text-red-500">
                        <iconify-icon icon="solar:close-circle-bold" width="12"></iconify-icon>
                      </button>
                    </div>
                  </template>
                </div>
              </div>
            </div>

            <!-- Champ de référence -->
            <div class="mb-4">
              <label class="mb-2 block text-sm font-bold">Champ de référence *</label>
              <p class="text-xs text-gray-400 mb-2">Ce champ sera utilisé comme titre lors des listings, relations, mentions, etc.</p>
              
              <div class="flex gap-3">
                <!-- Select field (50%) -->
                <div class="flex-1">
                  <select x-model="newCollection.referenceField" @change="addFieldToken()" class="form-select w-full">
                    <option value="title">Titre</option>
                    <template x-for="(enabled, field) in newCollection.standardFields" :key="field">
                      <template x-if="enabled && field !== 'title'">
                        <option :value="field" x-text="getFieldLabel(field)"></option>
                      </template>
                    </template>
                    <!-- Custom fields -->
                    <template x-for="field in selectedFields" :key="field._id">
                      <option :value="field._id" x-text="field.label || field.name"></option>
                    </template>
                  </select>
                </div>
                
                <!-- Contenteditable Format Field (50%) -->
                <div class="flex-1">
                  <div class="form-input w-full text-sm min-h-[38px] p-2 cursor-text focus-within:ring-2 focus-within:ring-primary/50" 
                       contenteditable="true"
                       @input="syncTokensFromEditor($event)"
                       x-init="$el.innerHTML = renderTokensAsHTML()"
                       x-ref="formatEditor">
                  </div>
                  <label class="text-xs text-gray-500 mt-1 block">Format (cliquez pour éditer)</label>
                </div>
              </div>
            </div>


            <!-- Active Toggle -->
            <div class="flex items-center justify-between pt-3 border-t dark:border-gray-700">
              <span class="text-sm text-gray-500">Collection active</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" x-model="newCollection.active" class="sr-only peer">
                <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-600 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
              </label>
            </div>
          </div>

          <!-- STEP 2: Sélection des champs -->
          <div x-show="step === 2" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0">
            
            <!-- Search -->
            <div class="relative mb-4">
              <input type="text" x-model="fieldSearch" placeholder="Rechercher un champ..." class="form-input w-full pl-9 text-sm">
              <iconify-icon icon="solar:magnifer-linear" class="absolute left-3 top-2.5 text-gray-400" width="16"></iconify-icon>
            </div>

            <!-- Champs sélectionnés -->
            <div x-show="selectedFields.length > 0" class="mb-4 p-3 bg-warning/5 rounded-lg border border-warning/20">
              <div class="text-xs font-semibold text-warning mb-2 flex items-center gap-1">
                <iconify-icon icon="solar:check-circle-bold" width="14"></iconify-icon>
                <span x-text="selectedFields.length + ' champ(s) sélectionné(s)'"></span>
              </div>
              <div class="flex flex-wrap gap-1.5">
                <template x-for="(field, idx) in selectedFields" :key="field._id || idx">
                  <div class="inline-flex items-center gap-1 px-2 py-1 bg-white dark:bg-gray-700 rounded-full text-xs border shadow-sm">
                    <iconify-icon :icon="field.icon || 'solar:widget-bold'" width="14" class="text-warning"></iconify-icon>
                    <span x-text="field.label || field.name || 'Champ'"></span>
                    <button type="button" @click="selectedFields.splice(idx, 1)" class="text-gray-400 hover:text-red-500 ml-0.5">
                      <iconify-icon icon="solar:close-circle-bold" width="14"></iconify-icon>
                    </button>
                  </div>
                </template>
              </div>
            </div>

            <!-- Catégories de champs -->
            <div class="space-y-3 max-h-64 overflow-y-auto pr-1">
              <template x-for="category in filteredCategories" :key="category.key">
                <div class="border dark:border-gray-700 rounded-lg overflow-hidden">
                  <div class="px-3 py-2 bg-gray-50 dark:bg-gray-800 font-medium text-sm flex items-center gap-2">
                    <iconify-icon :icon="getCategoryIcon(category.key)" width="16" class="text-warning"></iconify-icon>
                    <span x-text="category.label"></span>
                    <span class="text-gray-400 text-xs" x-text="'(' + category.fields.length + ')'"></span>
                  </div>
                  <div class="divide-y dark:divide-gray-700">
                    <template x-for="field in category.fields" :key="field._id">
                      <div class="px-3 py-2 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors"
                           :class="isFieldSelected(field._id) && 'bg-warning/5'">
                        <div class="flex items-center gap-2 flex-1 min-w-0">
                          <iconify-icon :icon="field.icon" width="18" class="text-gray-500 shrink-0"></iconify-icon>
                          <div class="min-w-0">
                            <div class="text-sm font-medium truncate" x-text="field.label"></div>
                            <div class="text-xs text-gray-400 truncate" x-text="field.description" x-show="field.description"></div>
                          </div>
                        </div>
                        <button type="button" 
                                @click="toggleField(field)"
                                class="shrink-0 px-2 py-1 rounded text-xs font-medium transition-colors"
                                :class="isFieldSelected(field._id) ? 'bg-red-100 text-red-600 hover:bg-red-200' : 'bg-warning/10 text-warning hover:bg-warning/20'">
                          <span x-text="isFieldSelected(field._id) ? 'Retirer' : 'Ajouter'"></span>
                        </button>
                      </div>
                    </template>
                  </div>
                </div>
              </template>
              
              <!-- Empty state -->
              <div x-show="filteredCategories.length === 0" class="text-center py-8 text-gray-400">
                <iconify-icon icon="solar:box-broken" width="40" class="mb-2"></iconify-icon>
                <p class="text-sm">Aucun champ trouvé</p>
              </div>
            </div>
          </div>
        </form>
      </div>

      <!-- Footer - Navigation -->
      <div class="p-5 border-t dark:border-gray-700 flex gap-3">
        <!-- Step 1 -->
        <template x-if="step === 1">
          <div class="flex gap-3 w-full">
            <button type="button" @click="updateCollection()" class="btn btn-warning flex-1" :disabled="!newCollection.name || isSubmitting">
              <span x-show="isSubmitting" class="animate-spin border-2 border-white border-l-transparent rounded-full w-4 h-4 mr-2 inline-block"></span>
              <iconify-icon icon="solar:diskette-bold" width="18" class="mr-1"></iconify-icon>
              Sauvegarde
            </button>
            <button type="button" @click="if(newCollection.name) step = 2" 
                    class="btn btn-outline-warning flex-1" :disabled="!newCollection.name">
              Champs personnalisés
              <iconify-icon icon="solar:arrow-right-linear" width="18" class="ml-1"></iconify-icon>
            </button>
          </div>
        </template>
        
        <!-- Step 2 -->
        <template x-if="step === 2">
          <div class="flex gap-3 w-full">
            <button type="button" @click="step = 1" class="btn btn-outline-dark flex-1">
              <iconify-icon icon="solar:arrow-left-linear" width="18" class="mr-1"></iconify-icon>
              Retour
            </button>
            <button type="button" @click="updateCollection()" class="btn btn-warning flex-1" :disabled="isSubmitting">
              <span x-show="isSubmitting" class="animate-spin border-2 border-white border-l-transparent rounded-full w-4 h-4 mr-2 inline-block"></span>
              Mettre à jour
            </button>
          </div>
        </template>
      </div>
    </div>
  </div>
</div>

<script src="/themes/default/assets/js/simple-datatables.js"></script>