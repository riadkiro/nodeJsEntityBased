<div class="ov-card-header">
    <iconify-icon :icon="widgetIcon(wid, 'solar:document-text-bold-duotone')" width="18" :style="'color:' + widgetColor(wid, '#f59e0b')"></iconify-icon>
    <span x-text="widgetTitle(wid, 'Documents modèles')">Documents modèles</span>
    <span x-show="templates.length > 0" x-text="templates.length"
          style="font-size:10px;font-weight:700;background:rgba(245,158,11,.12);color:#f59e0b;min-width:18px;height:18px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;padding:0 5px;margin-left:2px;"></span>
    <a href="<%= _recBase %>/docs" class="ov-card-link" x-show="widgetShowLink(wid, true)">Voir tout →</a>
</div>
<!-- Loading -->
<div x-show="loading" style="padding:20px;text-align:center;">
    <iconify-icon icon="line-md:loading-twotone-loop" width="22" style="color:#f59e0b;"></iconify-icon>
</div>
<!-- Empty state -->
<div x-show="!loading && templates.length === 0" style="padding:16px 12px;text-align:center;">
    <iconify-icon icon="solar:document-add-linear" width="28" style="color:#d1d5db;"></iconify-icon>
    <p style="font-size:12px;color:#888da8;margin:6px 0 0;">Aucun document modèle lié</p>
</div>
<!-- Template list -->
<div class="ov-doc-list" x-show="!loading && templates.length > 0">
    <template x-for="tpl in templates.slice(0, widgetLimit(wid, 3))" :key="tpl._id">
        <div class="ov-doc-item">
            <iconify-icon icon="solar:file-text-bold-duotone" width="16" style="color:#f59e0b"></iconify-icon>
            <span x-text="tpl.name"></span>
            <button class="ov-doc-gen" @click.stop="generateDoc(tpl)" :disabled="generatingId === tpl._id">
                <iconify-icon :icon="generatingId === tpl._id ? 'line-md:loading-twotone-loop' : 'solar:play-bold'" width="12"></iconify-icon>
                <span x-text="generatingId === tpl._id ? 'Génération...' : 'Générer'"></span>
            </button>
        </div>
    </template>
</div>

<!-- Full-screen SmartDoc Preview/Editor -->
<template x-teleport="body">
    <div x-show="showPreview" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
        class="fixed inset-0 flex flex-col bg-white" style="display:none; z-index: 99998;">
        <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 bg-white" style="min-height: 52px;">
            <div class="flex items-center gap-3">
                <button type="button" @click="cancelPreview()" class="p-2 rounded-full hover:bg-gray-100 text-gray-500 transition-colors" title="Retour">
                    <iconify-icon icon="tabler:arrow-left" width="20"></iconify-icon>
                </button>
                <div>
                    <h3 class="text-[13px] font-bold text-gray-800" x-text="previewName || 'Document'"></h3>
                    <p class="text-[10px] text-gray-400 flex items-center gap-1" x-show="!finalized">
                        <iconify-icon icon="solar:pen-2-bold" width="10" class="text-info"></iconify-icon>
                        Modifiez le contenu si nécessaire, puis finalisez pour générer le PDF
                    </p>
                    <p class="text-[10px] text-success flex items-center gap-1 font-medium" x-show="finalized">
                        <iconify-icon icon="solar:check-circle-bold" width="10"></iconify-icon>
                        PDF généré avec succès !
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2" x-show="!finalized">
                <button type="button" @click="cancelPreview()" :disabled="finalizing"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-medium text-gray-500 hover:text-danger hover:bg-danger/5 border border-gray-200 transition-all">
                    <iconify-icon icon="solar:close-circle-linear" width="14"></iconify-icon>
                    Annuler
                </button>
                <button type="button" @click="finalizePreview()" :disabled="finalizing"
                    class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-[11px] font-bold bg-success text-white hover:bg-success/90 transition-all shadow-sm disabled:opacity-50">
                    <iconify-icon :icon="finalizing ? 'line-md:loading-twotone-loop' : 'solar:check-circle-bold'" width="14"></iconify-icon>
                    <span x-text="finalizing ? 'Génération en cours...' : 'Finaliser et générer le PDF'"></span>
                </button>
            </div>
            <div class="flex items-center gap-2" x-show="finalized" x-cloak>
                <a :href="downloadUrl" download
                    class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-[11px] font-bold bg-primary text-white hover:bg-primary/90 transition-all shadow-sm">
                    <iconify-icon icon="solar:download-bold" width="14"></iconify-icon>
                    Télécharger
                </a>
                <button type="button" @click="closePreview()"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-100 border border-gray-200 transition-all">
                    <iconify-icon icon="solar:close-circle-linear" width="14"></iconify-icon>
                    Fermer
                </button>
            </div>
        </div>
        <div class="flex-1 overflow-hidden">
            <iframe id="ov-smartdoc-preview-iframe" class="w-full h-full border-0" allow="clipboard-read; clipboard-write"></iframe>
        </div>
    </div>
</template>
