<div 
    x-show="activeTab === 'dynamic-nav'"
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="-translate-x-full opacity-0"
    x-transition:enter-end="translate-x-0 opacity-100"
    x-transition:leave="transition ease-in duration-200 transform"
    x-transition:leave-start="translate-x-0 opacity-100"
    x-transition:leave-end="-translate-x-full opacity-0"
    class="w-72 bg-white dark:bg-[#0e1726] border-0 flex flex-col shadow-xl z-20 overflow-hidden"
    style="display: none; width:250px;"
>
    <!-- Header -->
    <div class="p-4 border-b dark:border-gray-700 flex justify-between items-center bg-gray-50/50 dark:bg-gray-900/50">
        <h3 class="font-bold text-sm flex items-center gap-2">
            <iconify-icon icon="solar:database-bold-duotone" class="text-blue-500" width="20"></iconify-icon>
            Contenu Dynamique
        </h3>
        <button @click="activeTab = null" class="w-6 h-6 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 flex items-center justify-center">
            <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
        </button>
    </div>

    <!-- Navigation Items -->
    <div class="flex-1 overflow-y-auto p-3">
        
        <!-- Variables -->
        <button 
            @click="activeTab = 'variables'"
            class="w-full px-3 py-3 mb-2 text-left rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-3 transition-colors"
        >
            <div class="w-9 h-9 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center shrink-0">
                <iconify-icon icon="solar:hashtag-bold-duotone" class="text-blue-600 dark:text-blue-400" width="20"></iconify-icon>
            </div>
            <div>
                <div class="text-sm font-semibold text-gray-900 dark:text-white">Variables</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">Date, document, société</div>
            </div>
        </button>

        <!-- Collections -->
        <button 
            @click="activeTab = 'collections'"
            class="w-full px-3 py-3 mb-2 text-left rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-3 transition-colors"
        >
            <div class="w-9 h-9 rounded-lg bg-gray-100 dark:bg-gray-700 flex items-center justify-center shrink-0">
                <iconify-icon icon="solar:server-bold-duotone" class="text-gray-600 dark:text-gray-400" width="20"></iconify-icon>
            </div>
            <div>
                <div class="text-sm font-semibold text-gray-900 dark:text-white">Collections</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">Sources de données</div>
            </div>
        </button>

        <!-- Table -->
        <button 
            @click="activeTab = 'query-table'"
            class="w-full px-3 py-3 mb-2 text-left rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-3 transition-colors"
        >
            <div class="w-9 h-9 rounded-lg bg-gray-100 dark:bg-gray-700 flex items-center justify-center shrink-0">
                <iconify-icon icon="solar:list-bold-duotone" class="text-gray-600 dark:text-gray-400" width="20"></iconify-icon>
            </div>
            <div>
                <div class="text-sm font-semibold text-gray-900 dark:text-white">Table</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">Tableau basé sur filtres</div>
            </div>
        </button>

        <!-- Calculated Table -->
        <button 
            @click="activeTab = 'calc-table'"
            class="w-full px-3 py-3 mb-2 text-left rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-3 transition-colors"
        >
            <div class="w-9 h-9 rounded-lg bg-gray-100 dark:bg-gray-700 flex items-center justify-center shrink-0">
                <iconify-icon icon="solar:calculator-bold-duotone" class="text-gray-600 dark:text-gray-400" width="20"></iconify-icon>
            </div>
            <div>
                <div class="text-sm font-semibold text-gray-900 dark:text-white">Tableau Calculé</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">Lignes éditables + formules</div>
            </div>
        </button>

    </div>
</div>
