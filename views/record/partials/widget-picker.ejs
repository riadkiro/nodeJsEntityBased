                { type: 'home-tasks', label: 'Tâches', icon: 'solar:clipboard-list-bold-duotone', color: '#8b5cf6', desc: 'Liste des tâches en cours', targets: ['home-overview'], instant: true },
                { type: 'home-finance', label: 'Finance', icon: 'solar:wallet-money-bold-duotone', color: '#6366f1', desc: 'Synthèse finance statique', targets: ['home-overview'], instant: true },
