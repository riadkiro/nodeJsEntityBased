    [data-panel-id="attributs"] .form-input:hover,
    [data-panel-id="attributs"] .form-textarea:hover,
    [data-panel-id="attributs"] .form-select:hover,
    [data-panel-id="attributs"] input.form-input:hover,
    [data-panel-id="attributs"] textarea.form-textarea:hover,
    [data-panel-id="attributs"] select.form-select:hover {
