	                listLabel: this.task.listLabel || '',
	                listColor: this.task.listColor || '',
	                listIcon: this.task.listIcon || ''
	            };
	            const target = this.listOptionById(listId);
	            this.task.taskListId = listId;
	            if (target) {
	                this.task.listLabel = target.label;
	                this.task.listColor = target.color;
	                this.task.listIcon = target.icon;
	            }
	            const saved = await this.updateField('taskListId', listId);
	            if (saved === false) {
	                Object.assign(this.task, previous);
	            }
	        },

	        normalizeTaskTags(tags = [], options = this.tagOptions) {
	            const optionByLabel = new Map((Array.isArray(options) ? options : [])
	                .map((option, index) => [String(option?.label || option || '').trim().toLowerCase(), {
	                    label: String(option?.label || option || '').trim(),
	                    color: option?.color || this.colorPalette[index % this.colorPalette.length] || '#6366f1',
	                    order: Number.isFinite(Number(option?.order)) ? Number(option.order) : index
	                }]));
	            const seen = new Set();
	            return (Array.isArray(tags) ? tags : [])
	                .map((tag, index) => {
	                    const label = String(tag?.label || tag || '').trim();
	                    const option = optionByLabel.get(label.toLowerCase());
	                    return {
	                        label,
	                        color: tag?.color || option?.color || '#6366f1',
	                        order: Number.isFinite(Number(tag?.order)) ? Number(tag.order) : (option?.order ?? index)
	                    };
	                })
	                .filter(tag => {
	                    const key = tag.label.toLowerCase();
	                    if (!tag.label || seen.has(key)) return false;
	                    seen.add(key);
	                    return true;
	                })
	                .sort((a, b) => a.order - b.order);
	        },

	        selectedTags() {
	            return this.normalizeTaskTags(this.task?.tags || [], this.tagOptions);
	        },

	        taskHasTag(option) {
	            const key = String(option?.label || '').trim().toLowerCase();
