    /* ─── Pro tasks surface refresh ─── */
    .tl-wrap { max-width: none; }
    .tl-pro-header {
        display:flex;align-items:center;justify-content:space-between;gap:14px;
        margin-bottom:14px;padding:14px 16px;border:1px solid #e8ecf1;border-radius:14px;
        background:linear-gradient(135deg,#fff 0%,#fbfcff 70%,#f7f8ff 100%);
        box-shadow:0 10px 30px rgba(15,23,42,.035);
    }
    .tl-pro-title { display:flex;align-items:center;gap:12px;min-width:0; }
    .tl-pro-title-icon {
        width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;
        background:linear-gradient(135deg,#6366f118,#6366f108);color:#6366f1;flex:0 0 auto;
    }
