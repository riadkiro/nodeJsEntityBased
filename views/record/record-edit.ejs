<%- include('../components/tag-picker') %>
<div x-data="recordForm()" class="space-y-4">
    <form action="/account/<%= account_number %>/record/<%= entity.slug %>/update/<%= record._id %>" method="POST"
        enctype="multipart/form-data" id="main-record-form">

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• HERO IDENTITY BAR (Mission 1) â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <%
            const _hc = entity.headerConfig || {};

            // â”€â”€ Resolve classifications for header display â”€â”€
            const _statusCls = entity.statusClassification;
            let _statusLabel = '', _statusColor = '#94a3b8';
            const _clsTags = [];
            const _shownCls = _hc.shownClassifications || [];

            if (record.classificationValues && record.classificationValues.length > 0) {
                record.classificationValues.forEach(cv => {
                    if (_statusCls && _statusCls._id && cv.classificationId &&
                        cv.classificationId.toString() === _statusCls._id.toString()) {
                        const opt = _statusCls.options.find(o => o._id?.toString() === cv.optionId?.toString());
                        if (opt) { _statusLabel = opt.label; _statusColor = opt.color || '#94a3b8'; }
                    }
                    (entity.classifications || []).forEach(cls => {
                        if (cls._id && cv.classificationId &&
                            cv.classificationId.toString() === cls._id.toString() &&
                            (!_statusCls || !_statusCls._id || cls._id.toString() !== _statusCls._id.toString())) {
                            if (_shownCls.length === 0 || _shownCls.includes(cls._id.toString())) {
                                const opt = cls.options.find(o => o._id?.toString() === cv.optionId?.toString());
                                if (opt) _clsTags.push({ label: opt.label, color: opt.color || '#4361ee' });
                            }
                        }
                    });
                });
            }

            // â”€â”€ Duration since creation â”€â”€
            let _durationStr = '';
            if (_hc.showDuration) {
                const _createdAt = record.createdAt ? new Date(record.createdAt) : null;
                const _now = new Date();
                if (_createdAt) {
                    const diffMs = _now - _createdAt;
                    const diffMin = Math.floor(diffMs / 60000);
                    if (diffMin < 60) _durationStr = diffMin + ' min';
                    else if (diffMin < 1440) _durationStr = Math.floor(diffMin / 60) + 'h ' + (diffMin % 60) + 'min';
                    else _durationStr = Math.floor(diffMin / 1440) + 'j';
                }
            }

            // â”€â”€ Avatar resolution â”€â”€
            const _showIcon = _hc.showIcon !== false;
            const _avSrc = _hc.avatarSource || {};
            let _avatarImage = '';
            if (_showIcon) {
                if (_avSrc.type === 'record-image') {
                    _avatarImage = record.image || '';
                } else if (_avSrc.type === 'relation-image' && locals.headerRelatedRecord) {
                    _avatarImage = locals.headerRelatedRecord.image || '';
                } else if (_avSrc.type === 'field') {
                    const avField = (record.customFields || []).find(cf => {
                        const fid = (cf.field_id?._id || cf.field_id || '').toString();
                        return fid === _avSrc.fieldId;
                    });
                    _avatarImage = avField?.value || '';
                }
            }
            // Icon/color for avatar fallback (use related entity if relation-image)
            const _hrm = locals.headerRelatedMeta || {};
            let _avatarIcon = entity.icon || 'solar:user-bold-duotone';
            let _avatarColor = entity.color || '#4361ee';
            if (_avSrc.type === 'relation-image' && _hrm.relatedEntityIcon) {
                _avatarIcon = _hrm.relatedEntityIcon;
                _avatarColor = _hrm.relatedEntityColor || '#4361ee';
            }

            // â”€â”€ Title resolution (new: titleSource) â”€â”€
            const _showTitle = _hc.showTitle !== false;
            const _titleSrc = _hc.titleSource || {};
            let _heroTitle = record.title || 'Sans titre';
            if (_titleSrc.type === 'relation' && _titleSrc.relationKey && locals.headerRelatedRecord) {
                _heroTitle = locals.headerRelatedRecord.title || _heroTitle;
            } else if (_titleSrc.type !== 'entity' && locals.headerRelatedRecord && locals.headerRelatedRecord.title &&
                       _hc.subtitleRelation && _hc.subtitleRelation.relationKey) {
                _heroTitle = locals.headerRelatedRecord.title;
            }

            // â”€â”€ Subtitle from related record (legacy) â”€â”€
            const _sr = _hc.subtitleRelation || {};
            let _subtitleParts = [];
            if (locals.headerRelatedRecord && _sr.displayFields && _sr.displayFields.length > 0) {
                const hRec = locals.headerRelatedRecord;
                _sr.displayFields.forEach(dfId => {
                    if (dfId === 'title') { if (hRec.title) _subtitleParts.push(hRec.title); return; }
                    const cv = (hRec.customFields || []).find(cf => {
                        const fid = (cf.field_id?._id || cf.field_id || '').toString();
                        return fid === dfId;
                    });
                    if (cv && cv.value) _subtitleParts.push(cv.value);
                });
            }

            // â”€â”€ Hero fields (icon + truncated value, supports entitySource) â”€â”€
            const _heroFieldConfigs = _hc.heroFields || [];
            const _heroFieldValues = [];
            _heroFieldConfigs.forEach(hf => {
                const src = hf.entitySource || 'self';
                const sourceRec = src === 'self' ? record : (locals.headerRelatedRecord || null);
                if (!sourceRec) return;
                const cf = (sourceRec.customFields || []).find(c => {
                    const fid = (c.field_id?._id || c.field_id || '').toString();
                    return fid === hf.fieldId;
                });
                if (cf && cf.value) {
                    const fieldDef = cf.field_id || {};
                    let val = typeof cf.value === 'string' ? cf.value : JSON.stringify(cf.value);
                    const maxChars = hf.maxChars || 20;
                    if (val.length > maxChars) val = val.substring(0, maxChars) + '...';
                    _heroFieldValues.push({
                        icon: (fieldDef.ui && fieldDef.ui.icon) || 'solar:document-text-linear',
                        value: val
                    });
                }
            });

            // â”€â”€ Meta fields (legacy) â”€â”€
            const _metaFields = (_hc.metaFields || []);
            const _metaBadges = [];
            _metaFields.forEach(mf => {
                if (mf.type === 'computed') {
                    const cv = (typeof computedFieldValues !== 'undefined' ? computedFieldValues : {})[mf.fieldId];
                    if (cv) _metaBadges.push({ label: cv.formatted || cv.value, display: mf.display || 'text' });
                } else if (mf.type === 'field') {
                    const val = (record.customFields || []).find(cf => {
                        const fid = (cf.field_id?._id || cf.field_id || '').toString();
                        return fid === mf.fieldId;
                    });
                    if (val && val.value) _metaBadges.push({ label: val.value, display: mf.display || 'text' });
                }
            });
        %>
        <div class="flex items-center justify-between px-5 py-3 bg-white dark:bg-[#1b2e4b] rounded-xl border border-gray-100 dark:border-gray-800 shadow-sm mb-4"
            x-data="headerBar()">
            <!-- Left: Avatar + Identity -->
            <div class="flex items-center gap-4 min-w-0">
                <!-- Avatar -->
                <% if (_showIcon) { %>
                <% if (_avatarImage) { %>
                <img src="<%= _avatarImage %>" alt="" class="w-11 h-11 rounded-full object-cover ring-2 ring-white dark:ring-gray-800 shadow-sm">
                <% } else { %>
                <div class="w-11 h-11 rounded-full flex items-center justify-center text-lg font-bold shadow-sm"
                     style="background: <%= _avatarColor %>15; color: <%= _avatarColor %>">
                    <iconify-icon icon="<%= _avatarIcon %>" width="22"></iconify-icon>
                </div>
                <% } %>
                <% } %>

                <!-- Name + Meta line -->
                <div class="min-w-0">
                    <% if (_showTitle) { %>
                    <h1 class="text-base font-bold text-gray-800 dark:text-white truncate max-w-[350px] leading-tight">
                        <%= _heroTitle %>
                    </h1>
                    <% } %>
                    <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                        <% if (_subtitleParts.length > 0) { %>
                        <span class="text-xs text-gray-500 dark:text-gray-400 font-medium flex items-center gap-1">
                            <iconify-icon icon="solar:user-rounded-linear" width="12" class="text-gray-400"></iconify-icon>
                            <%= _subtitleParts.join(' · ') %>
                        </span>
                        <span class="w-px h-3 bg-gray-200 dark:bg-gray-700"></span>
                        <% } %>
                        <% if (_hc.showClassifications !== false) { %>
                        <% if (_statusLabel) { %>
                        <span class="inline-flex items-center gap-1 text-xs font-semibold" style="color: <%= _statusColor %>">
                            <span class="w-2 h-2 rounded-full" style="background: <%= _statusColor %>"></span>
                            <%= _statusLabel %>
                        </span>
                        <% } %>
                        <% _clsTags.forEach(tag => { %>
                        <span class="inline-flex items-center gap-1 text-xs font-semibold" style="color: <%= tag.color %>">
                            <span class="w-1.5 h-1.5 rounded-full" style="background: <%= tag.color %>"></span>
                            <%= tag.label %>
                        </span>
                        <% }); %>
                        <% } %>
                        <% _heroFieldValues.forEach(hfv => { %>
                        <span class="hb-field-chip">
                            <iconify-icon icon="<%= hfv.icon %>" width="12"></iconify-icon>
                            <%= hfv.value %>
                        </span>
                        <% }); %>
                        <% _metaBadges.forEach(mb => { %>
                        <span class="inline-flex items-center gap-1 text-xs font-medium px-1.5 py-0.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
                            <%= mb.label %>
                        </span>
                        <% }); %>
                        <% if (_durationStr) { %>
                        <span class="text-[11px] text-gray-400 dark:text-gray-500 flex items-center gap-1">
                            <iconify-icon icon="solar:clock-circle-linear" width="12"></iconify-icon>
                            <%= _durationStr %>
                        </span>
                        <% } %>
                    </div>
                </div>
            </div>

            <%
                // ── Quick access icons: works with OR without headerRelatedMeta ──
                // _hrm already declared above (line 68)
                const _shownRels = _hc.shownRelations || [];
                const _shownRels2 = _shownRels;

                // Attachments: from related record (if main relation) or from own record
                let _hasAttachments = false;
                let _attachmentCount = 0;
                let _attachmentList = [];
                let _attachmentTitle = '';

                if (locals.headerRelatedMeta && locals.headerRelatedRecord) {
                    _hasAttachments = (_hrm.attachmentCount > 0) && _hc.showAttachments !== false;
                    _attachmentCount = _hrm.attachmentCount || 0;
                    _attachmentList = locals.headerRelatedRecord.attachments || [];
                    _attachmentTitle = locals.headerRelatedRecord.title || '';
                } else if (_hc.showAttachments !== false) {
                    _attachmentList = record.attachments || [];
                    _attachmentCount = _attachmentList.length;
                    _hasAttachments = _attachmentCount > 0;
                    _attachmentTitle = record.title || '';
                }

                // Collect all relations: indirect (via patient) + direct + inverse
                const _allRelIcons = [];
                const _seenSlugs = new Set();

                // 1) Indirect relations via related record (only when headerRelatedMeta exists)
                if (locals.headerRelatedMeta) {
                    (_hrm.indirectRelations || []).filter(ir => _shownRels.includes(ir.key)).forEach(ir => {
                        const slug = ir.slug || ir.key;
                        if (!_seenSlugs.has(slug)) {
                            _seenSlugs.add(slug);
                            _allRelIcons.push({
                                key: ir.key, label: ir.label, icon: ir.icon, color: ir.color,
                                count: ir.count, slug: ir.slug,
                                records: ir.records || [], type: 'indirect'
                            });
                        }
                    });
                }

                // 2) Direct relations
                (entity.relations || []).filter(r => _shownRels.length === 0 || _shownRels.includes(r.key)).forEach(dRel => {
                    const _dTgt = dRel.targetEntity || {};
                    const slug = _dTgt.slug || dRel.key;
                    if (!_seenSlugs.has(slug)) {
                        _seenSlugs.add(slug);
                        const _dTab = (locals.relationTabsMeta || []).find(t => t.key === dRel.key);
                        _allRelIcons.push({
                            key: dRel.key, label: dRel.label || _dTgt.name || 'Relation',
                            icon: _dTgt.icon || 'solar:link-round-bold-duotone',
                            color: _dTgt.color || '#4361ee',
                            count: _dTab ? _dTab.count : 0, slug: _dTgt.slug || '',
                            records: (locals.relatedRecordsData || {})[dRel.key] || [],
                            type: 'direct'
                        });
                    }
                });

                // 3) Inverse relations
                (locals.inverseRelations || []).filter(invR => _shownRels.length === 0 || _shownRels.includes(invR.key)).forEach(invR => {
                    const _iTgt = invR.targetEntity || {};
                    const slug = _iTgt.slug || invR.key;
                    if (!_seenSlugs.has(slug)) {
                        _seenSlugs.add(slug);
                        const _iTab = (locals.relationTabsMeta || []).find(t => t.key === invR.key);
                        _allRelIcons.push({
                            key: invR.key, label: invR.label || _iTgt.name || 'Relation',
                            icon: _iTgt.icon || 'solar:link-round-bold-duotone',
                            color: _iTgt.color || '#4361ee',
                            count: _iTab ? _iTab.count : 0, slug: _iTgt.slug || '',
                            records: (locals.relatedRecordsData || {})[invR.key] || [],
                            type: 'inverse'
                        });
                    }
                });

                const _hasAnyRel = _allRelIcons.length > 0;
            %>

            <% if (_hasAttachments || _hasAnyRel) { %>
            <div class="hb-quick-icons" x-data="{ openDropdown: null }">
                <!-- Attachments icon -->
                <% if (_hasAttachments) { %>
                <div class="hb-icon-item" @click.outside="openDropdown = openDropdown === 'attach' ? null : openDropdown">
                    <div class="hb-icon-btn" @click="openDropdown = openDropdown === 'attach' ? null : 'attach'"
                         title="Pièces jointes (<%= _attachmentCount %>)" style="--hb-c:#f59e0b">
                        <div class="hb-icon-circle" style="background:linear-gradient(135deg, #f59e0b18, #f59e0b08)">
                            <iconify-icon icon="solar:paperclip-bold-duotone" width="15" style="color:#f59e0b;flex-shrink:0"></iconify-icon>
                        </div>
                        <span class="hb-expand-label" style="color:#f59e0b">Documents</span>
                        <span class="hb-badge" style="background:#f59e0b"><%= _attachmentCount %></span>
                    </div>
                    <div class="hb-dropdown" x-show="openDropdown === 'attach'" x-transition x-cloak>
                        <div class="hb-dropdown-header">
                            <iconify-icon icon="solar:paperclip-bold-duotone" width="14" style="color:#f59e0b"></iconify-icon>
                            <span>Pièces jointes · <%= _attachmentTitle %></span>
                        </div>
                        <div class="hb-dropdown-list">
                            <% _attachmentList.forEach(att => { %>
                            <a href="/account/<%= account_number %>/uploads/<%= att.filename %>" target="_blank" class="hb-dropdown-item">
                                <iconify-icon icon="<%= att.category === 'pdf' ? 'solar:file-text-bold-duotone' : att.category === 'image' ? 'solar:gallery-bold-duotone' : att.category === 'word' ? 'solar:document-text-bold-duotone' : 'solar:file-bold-duotone' %>" width="16"
                                    style="color:<%= att.category === 'pdf' ? '#ef4444' : att.category === 'image' ? '#3b82f6' : att.category === 'word' ? '#2563eb' : '#6b7280' %>"></iconify-icon>
                                <span class="hb-dropdown-item-text"><%= att.originalName %></span>
                                <span class="hb-dropdown-item-meta"><%= att.category %></span>
                            </a>
                            <% }); %>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- Separator between attachments and relations -->
                <% if (_hasAttachments && _hasAnyRel) { %>
                <span class="hb-separator"></span>
                <% } %>

                <!-- All relation icons (deduplicated) -->
                <% _allRelIcons.forEach(rel => { %>
                <div class="hb-icon-item" @click.outside="openDropdown = openDropdown === '<%= rel.key %>' ? null : openDropdown">
                    <div class="hb-icon-btn" @click="openDropdown = openDropdown === '<%= rel.key %>' ? null : '<%= rel.key %>'"
                         title="<%= rel.label %> (<%= rel.count %>)" style="--hb-c:<%= rel.color %>">
                        <div class="hb-icon-circle" style="background:linear-gradient(135deg, <%= rel.color %>18, <%= rel.color %>08)">
                            <iconify-icon icon="<%= rel.icon %>" width="15" style="color:<%= rel.color %>;flex-shrink:0"></iconify-icon>
                        </div>
                        <span class="hb-expand-label" style="color:<%= rel.color %>"><%= rel.label %></span>
                        <% if (rel.count > 0) { %>
                        <span class="hb-badge" style="background:<%= rel.color %>"><%= rel.count %></span>
                        <% } %>
                    </div>
                    <div class="hb-dropdown" x-show="openDropdown === '<%= rel.key %>'" x-transition x-cloak>
                        <div class="hb-dropdown-header">
                            <iconify-icon icon="<%= rel.icon %>" width="14" style="color:<%= rel.color %>"></iconify-icon>
                            <span><%= rel.label %></span>
                            <span class="hb-dropdown-count"><%= rel.count %></span>
                        </div>
                        <% if (rel.records.length > 0) { %>
                        <div class="hb-dropdown-list">
                            <% rel.records.slice(0, 5).forEach(rec => { %>
                            <a href="/account/<%= account_number %>/record/<%= rel.slug %>/<%= rec._id %>/edit" class="hb-dropdown-item">
                                <iconify-icon icon="<%= rel.icon %>" width="14" style="color:<%= rel.color %>"></iconify-icon>
                                <span class="hb-dropdown-item-text"><%= rec.title || 'Sans titre' %></span>
                            </a>
                            <% }); %>
                        </div>
                        <% } else { %>
                        <div class="hb-dropdown-empty">
                            <iconify-icon icon="solar:magnifer-linear" width="16" style="color:#9ca3af"></iconify-icon>
                            <span>Aucun enregistrement</span>
                        </div>
                        <% } %>
                        <% if (rel.slug) { %>
                        <a href="/account/<%= account_number %>/record/<%= rel.slug %>" class="hb-dropdown-footer">
                            Voir tout →
                        </a>
                        <% } %>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } %>



            <!-- Right: Quick action buttons + More menu -->
            <div class="flex items-center gap-2">
                <!-- Separator before save group -->
                <span class="hb-separator"></span>

                <!-- Hidden standard fields for form submission -->
                <input type="hidden" name="standard[published]" value="<%= record.published ? 'on' : '' %>">

                <!-- Quick Action Buttons (from document templates if available) -->
                <% if (locals.documentTemplates && documentTemplates.length > 0) { %>
                    <% documentTemplates.slice(0, 3).forEach(tpl => { %>
                    <a href="/account/<%= account_number %>/document/generate/<%= tpl._id %>?recordId=<%= record._id %>"
                       class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-gray-200 dark:border-gray-700 text-xs font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:border-gray-300 transition-all"
                       title="<%= tpl.name %>">
                        <iconify-icon icon="<%= tpl.icon || 'solar:document-bold-duotone' %>" width="14" style="color: <%= tpl.color || '#4361ee' %>"></iconify-icon>
                        <span><%= tpl.name %></span>
                    </a>
                    <% }); %>
                <% } %>

                <!-- Save Button (always visible) -->
                <button type="submit" form="main-record-form"
                    class="flex items-center gap-1.5 px-4 py-2 rounded-lg bg-primary text-white text-xs font-bold hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20 transition-all"
                    x-data="{ submitting: false }" @submit.window="submitting = true"
                    :disabled="submitting"
                    :class="submitting ? 'opacity-60 cursor-wait' : ''">
                    <iconify-icon :icon="submitting ? 'line-md:loading-twotone-loop' : 'solar:diskette-bold'" width="14"></iconify-icon>
                    <span x-text="submitting ? 'Envoi...' : 'Enregistrer'">Enregistrer</span>
                </button>

                <!-- 3-dot More Menu -->
                <div class="relative">
                    <button type="button" @click="showMoreMenu = !showMoreMenu"
                        class="flex items-center justify-center w-9 h-9 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-400 hover:text-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-all">
                        <iconify-icon icon="solar:menu-dots-bold" width="18"></iconify-icon>
                    </button>
                    <!-- More menu dropdown -->
                    <div x-show="showMoreMenu" x-transition @click.outside="showMoreMenu = false"
                        class="absolute right-0 top-full mt-2 bg-white dark:bg-[#1b2e4b] rounded-xl shadow-xl border border-gray-100 dark:border-gray-700 py-1.5 w-[200px] z-50">
                        <!-- Save -->
                        <button type="submit" form="main-record-form"
                            class="w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors"
                            x-data="{ submitting: false }" @submit.window="submitting = true">
                            <iconify-icon icon="solar:diskette-bold" width="15" class="text-primary"></iconify-icon>
                            <span x-text="submitting ? 'Envoi...' : 'Enregistrer'">Enregistrer</span>
                        </button>
                        <!-- Layout mode -->
                        <button type="button" @click="designMode = !designMode; showMoreMenu = false"
                            class="w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                            <iconify-icon icon="tabler:layout-dashboard" width="15" class="text-gray-400"></iconify-icon>
                            <span>Mode mise en page</span>
                        </button>
                        <!-- Header Config -->
                        <button type="button" @click="$dispatch('open-header-config'); showMoreMenu = false"
                            class="w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                            <iconify-icon icon="solar:widget-6-bold-duotone" width="15" class="text-purple-400"></iconify-icon>
                            <span>Configurer l'en-tête</span>
                        </button>
                        <div class="h-px bg-gray-100 dark:bg-gray-700 my-1"></div>
                        <!-- Delete -->
                        <button type="button" @click="showDeleteConfirm = true; showMoreMenu = false"
                            class="w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors">
                            <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="15"></iconify-icon>
                            <span>Supprimer</span>
                        </button>
                </div>
            </div>
            </div>
            <!-- Delete confirmation overlay -->
            <div x-show="showDeleteConfirm" x-transition
                 class="fixed inset-0 bg-black/20 backdrop-blur-sm z-[100] flex items-center justify-center" @click.self="showDeleteConfirm = false">
                <div class="bg-white dark:bg-[#1b2e4b] rounded-2xl shadow-2xl border border-gray-100 dark:border-gray-700 p-6 w-[320px]">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-full bg-red-50 dark:bg-red-500/10 flex items-center justify-center">
                            <iconify-icon icon="solar:trash-bin-minimalistic-bold" width="20" class="text-red-500"></iconify-icon>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-gray-800 dark:text-white">Supprimer cet enregistrement ?</h3>
                            <p class="text-xs text-gray-400 mt-0.5">Cette action est irréversible.</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" @click="showDeleteConfirm = false"
                            class="flex-1 px-4 py-2 text-xs font-semibold text-gray-500 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 transition-all">
                            Annuler
                        </button>
                        <a href="/account/<%= account_number %>/record/<%= entity.slug %>/delete/<%= record._id %>"
                            class="flex-1 px-4 py-2 text-xs font-bold text-white bg-red-500 rounded-lg hover:bg-red-600 text-center transition-all">
                            Supprimer
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Alpine Store for sharing tab state across components -->
        <script>
        document.addEventListener('alpine:init', () => {
            Alpine.store('recordTabs', { activeTab: '__self__', fieldAssignments: {} });
        });
        </script>

        <!-- ═══════════════════ UNIFIED TABS BAR ═══════════════════ -->
        <div x-data="recordTabs()" class="mb-4" id="unified-tabs-bar">
            <!-- Tab Bar -->
            <div class="flex items-center bg-white dark:bg-[#1b2e4b] rounded-xl border border-gray-100 dark:border-gray-800 shadow-sm overflow-hidden">
                <!-- Scrollable Tabs Container -->
                <div class="flex-1 flex items-center gap-0.5 overflow-x-auto hide-scrollbar px-1.5 py-1.5" id="unified-tabs-scroll">
                    <!-- Self Tab (entity itself) — always first -->
                    <button type="button"
                            @click="selectTab('__self__')"
                            class="relation-tab-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all duration-200 shrink-0 select-none"
                            :class="activeTab === '__self__'
                                ? 'bg-primary/10 text-primary shadow-sm ring-1 ring-primary/20'
                                : 'text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:text-gray-700 dark:hover:text-gray-300'">
                        <span class="w-5 h-5 rounded flex items-center justify-center shrink-0"
                              :style="activeTab === '__self__' ? 'background:<%= entity.color || '#4361ee' %>15; color:<%= entity.color || '#4361ee' %>' : ''">
                            <iconify-icon icon="<%= entity.icon || 'solar:widget-bold-duotone' %>" width="13"
                                :style="activeTab === '__self__' ? 'color:<%= entity.color || '#4361ee' %>' : ''"
                                :class="activeTab !== '__self__' ? 'text-gray-400 dark:text-gray-500' : ''"></iconify-icon>
                        </span>
                        <span><%= entity.nameSingular || entity.name %></span>
                    </button>

                    <!-- Separator between self and relations -->
                    <template x-if="visibleTabs.length > 0">
                        <div class="w-px h-5 bg-gray-200 dark:bg-gray-700 mx-1 shrink-0"></div>
                    </template>

                    <!-- Relation Tabs -->
                    <template x-for="tab in visibleTabs" :key="tab.key">
                        <div class="flex items-center shrink-0 relation-tab-draggable cursor-grab active:cursor-grabbing"
                             :data-tab-key="tab.key">
                            <button type="button"
                                    @click="selectTab(tab.key)"
                                    class="relation-tab-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-all duration-200 select-none"
                                    :class="activeTab === tab.key
                                        ? 'bg-primary/10 text-primary shadow-sm ring-1 ring-primary/20'
                                        : 'text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:text-gray-700 dark:hover:text-gray-300'">
                                <span class="w-5 h-5 rounded flex items-center justify-center shrink-0"
                                      :style="activeTab === tab.key ? 'background:' + tab.color + '15; color:' + tab.color : ''">
                                    <iconify-icon :icon="tab.icon" width="13"
                                        :style="activeTab === tab.key ? 'color:' + tab.color : ''"
                                        :class="activeTab !== tab.key ? 'text-gray-400 dark:text-gray-500' : ''"></iconify-icon>
                                </span>
                                <span x-text="tab.label"></span>
                                <span x-show="tab._count > 0"
                                      class="ml-0.5 px-1.5 py-0 text-[10px] font-bold rounded-full min-w-[18px] text-center leading-[18px]"
                                      :class="activeTab === tab.key
                                          ? 'bg-primary/20 text-primary'
                                          : 'bg-gray-100 dark:bg-gray-700 text-gray-400 dark:text-gray-500'"
                                      x-text="tab._count"></span>

                            </button>
                            <!-- Quick Add button per tab (not for custom tabs) -->
                            <template x-if="!tab.isCustom">
                                <button type="button"
                                        @click.stop="canAddOnTab(tab) && openQuickCreate(tab)"
                                        class="w-5 h-5 rounded flex items-center justify-center ml-0.5 transition-all shrink-0 no-drag"
                                        :class="canAddOnTab(tab)
                                            ? 'text-gray-300 dark:text-gray-600 hover:text-primary hover:bg-primary/10 cursor-pointer'
                                            : 'text-gray-200 dark:text-gray-700 cursor-not-allowed opacity-40'"
                                        :title="canAddOnTab(tab) ? 'Créer ' + tab.label : 'Ajout non disponible'"
                                        :disabled="!canAddOnTab(tab)">
                                    <iconify-icon icon="tabler:plus" width="12"></iconify-icon>
                                </button>
                            </template>
                            <!-- Remove button for custom tabs -->
                            <template x-if="tab.isCustom">
                                <button type="button"
                                        @click.stop="removeCustomTab(tab.key)"
                                        class="w-5 h-5 rounded flex items-center justify-center ml-0.5 text-gray-300 dark:text-gray-600 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-all shrink-0 no-drag cursor-pointer"
                                        title="Supprimer cet onglet">
                                    <iconify-icon icon="tabler:x" width="11"></iconify-icon>
                                </button>
                            </template>
                        </div>
                    </template>

                    <!-- Add Custom Tab Button -->
                    <button type="button" @click="openCustomTabModal()"
                            class="flex items-center justify-center w-7 h-7 rounded-lg text-gray-400 hover:text-primary hover:bg-primary/10 transition-all shrink-0 no-drag"
                            title="Ajouter un onglet personnalisé">
                        <iconify-icon icon="solar:add-square-bold-duotone" width="15"></iconify-icon>
                    </button>
                </div>

                <!-- Config Button -->
                <div class="flex items-center gap-1 pr-2 pl-1 border-l dark:border-gray-700/50">
                    <button type="button" @click="showConfig = !showConfig"
                            class="flex items-center justify-center w-7 h-7 rounded-lg transition-all"
                            :class="showConfig ? 'bg-primary/10 text-primary' : 'text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50'"
                            title="Configurer les onglets">
                        <iconify-icon icon="solar:settings-bold-duotone" width="15"></iconify-icon>
                    </button>
                </div>
            </div>

            <!-- Config Panel (dropdown) -->
            <div x-show="showConfig" x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0 -translate-y-2"
                 @click.outside="showConfig = false"
                 class="mt-2 bg-white dark:bg-[#1b2e4b] rounded-xl border border-gray-100 dark:border-gray-800 shadow-lg p-3 relative z-40"
                 x-cloak>
                <div class="flex items-center justify-between mb-3">
                    <h4 class="text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider flex items-center gap-1.5">
                        <iconify-icon icon="solar:tuning-2-bold-duotone" width="14" class="text-primary"></iconify-icon>
                        Configurer les onglets
                    </h4>
                    <button type="button" @click="resetConfig()" class="text-[10px] text-gray-400 hover:text-primary transition-colors">
                        Réinitialiser
                    </button>
                </div>
                <p class="text-[10px] text-gray-400 dark:text-gray-500 mb-3">
                    Glissez pour réordonner. Activez ou désactivez les relations à afficher.
                </p>
                <div id="unified-tabs-sortable" class="space-y-1.5">
                    <template x-for="tab in allTabs" :key="'cfg-' + tab.key">
                        <div class="flex items-center gap-2 px-2.5 py-2 rounded-lg border dark:border-gray-700/50 bg-gray-50/50 dark:bg-gray-800/30 cursor-grab active:cursor-grabbing transition-colors hover:bg-gray-50 dark:hover:bg-gray-800/50"
                             :data-key="tab.key">
                            <iconify-icon icon="tabler:grip-vertical" width="14" class="text-gray-300 dark:text-gray-600 shrink-0 drag-handle"></iconify-icon>
                            <div class="w-5 h-5 rounded flex items-center justify-center shrink-0"
                                 :style="'background:' + tab.color + '15'">
                                <iconify-icon :icon="tab.icon" width="12" :style="'color:' + tab.color"></iconify-icon>
                            </div>
                            <span class="text-xs font-medium text-gray-700 dark:text-gray-300 flex-1 truncate" x-text="tab.label"></span>
                            <span x-show="tab.direction === 'inverse'" class="text-[8px] text-amber-500/60 font-bold uppercase tracking-wider">Inverse</span>
                            <label class="relative inline-flex items-center cursor-pointer shrink-0">
                                <input type="checkbox" class="sr-only peer" :checked="tab.visible !== false"
                                       @change="toggleTabVisibility(tab.key, $event.target.checked)">
                                <div class="w-7 h-4 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-primary"></div>
                            </label>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Relation Tab Content Area (only shown for relation tabs, not for __self__) -->
            <div x-show="activeTab && activeTab !== '__self__'" x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 translate-y-1" x-transition:enter-end="opacity-100 translate-y-0"
                 class="mt-3" x-cloak>
                <div :class="(activeTabMeta && activeTabMeta.isCustom) ? '' : 'bg-white dark:bg-[#1b2e4b] rounded-xl border border-gray-100 dark:border-gray-800 shadow-sm overflow-hidden'">

                    <!-- Loading State -->
                    <template x-if="tabLoading">
                        <div class="flex items-center justify-center py-8">
                            <iconify-icon icon="svg-spinners:ring-resize" width="24" class="text-primary"></iconify-icon>
                            <span class="ml-2 text-xs text-gray-400">Chargement...</span>
                        </div>
                    </template>

                    <!-- Records List -->
                    <template x-if="!tabLoading && tabRecords.length > 0">
                        <div>
                            <!-- Header -->
                            <div class="flex items-center justify-between px-4 py-2 border-b dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/30">
                                <div class="flex items-center gap-2">
                                    <span class="w-5 h-5 rounded flex items-center justify-center"
                                          :style="'background:' + activeTabMeta?.color + '15'">
                                        <iconify-icon :icon="activeTabMeta?.icon || 'solar:widget-bold-duotone'" width="12"
                                                      :style="'color:' + (activeTabMeta?.color || '#4361ee')"></iconify-icon>
                                    </span>
                                    <span class="text-xs font-semibold text-gray-700 dark:text-gray-300" x-text="activeTabMeta?.label"></span>
                                    <span class="text-[10px] bg-primary/10 text-primary px-1.5 py-0.5 rounded-full font-bold" x-text="tabRecords.length"></span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <button type="button" @click="canAddOnTab(activeTabMeta) && openQuickCreate(activeTabMeta)"
                                            class="flex items-center gap-1 px-2 py-1 rounded-lg text-[10px] font-semibold transition-all"
                                            :class="canAddOnTab(activeTabMeta)
                                                ? 'text-primary hover:bg-primary/10 cursor-pointer'
                                                : 'text-gray-300 dark:text-gray-600 cursor-not-allowed'"
                                            :disabled="!canAddOnTab(activeTabMeta)"
                                            title="Ajouter">
                                        <iconify-icon icon="tabler:plus" width="12"></iconify-icon>
                                        Ajouter
                                    </button>
                                    <button type="button" @click="activeTab = '__self__'" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
                                        <iconify-icon icon="solar:close-circle-linear" width="16"></iconify-icon>
                                    </button>
                                </div>
                            </div>
                            <!-- Records -->
                            <div class="divide-y dark:divide-gray-800">
                                <template x-for="rec in tabRecords" :key="rec._id">
                                    <a :href="'/account/<%= account_number %>/record/' + rec.entitySlug + '/' + rec._id + '/edit'"
                                       class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 dark:hover:bg-white/5 transition-colors group">
                                        <div class="w-7 h-7 rounded-lg flex items-center justify-center shrink-0"
                                             :style="'background:' + rec.color + '15'">
                                            <iconify-icon :icon="rec.icon" width="14" :style="'color:' + rec.color"></iconify-icon>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="text-sm font-medium text-gray-700 dark:text-gray-200 truncate group-hover:text-primary transition-colors" x-text="rec.title"></div>
                                            <div class="text-[10px] text-gray-400 dark:text-gray-500" x-text="rec.updatedAt ? 'Modifié le ' + new Date(rec.updatedAt).toLocaleDateString('fr-FR') : ''"></div>
                                        </div>
                                        <iconify-icon icon="solar:arrow-right-linear" width="14" class="text-gray-300 dark:text-gray-600 group-hover:text-primary transition-colors shrink-0"></iconify-icon>
                                    </a>
                                </template>
                            </div>
                        </div>
                    </template>

                    <!-- Empty State -->
                    <!-- Empty State (Relation tabs only — not custom) -->
                    <template x-if="!tabLoading && tabRecords.length === 0 && activeTab && activeTab !== '__self__' && !(activeTabMeta && activeTabMeta.isCustom)">
                        <div class="flex flex-col items-center justify-center py-10 text-gray-400 dark:text-gray-500">
                            <iconify-icon icon="solar:box-minimalistic-bold-duotone" width="36" class="mb-3 opacity-40"></iconify-icon>
                            <span class="text-xs mb-3">Aucun enregistrement lié</span>
                            <template x-if="canAddOnTab(activeTabMeta)">
                                <button type="button" @click="openQuickCreate(activeTabMeta)"
                                        class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold text-white bg-primary hover:bg-primary/90 shadow-md hover:shadow-lg hover:shadow-primary/20 transition-all">
                                    <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                                    <span x-text="'Créer ' + (activeTabMeta?.label || '')"></span>
                                </button>
                            </template>
                            <template x-if="!canAddOnTab(activeTabMeta)">
                                <span class="text-[10px] text-gray-400">L'ajout n'est pas disponible pour cette relation</span>
                            </template>
                        </div>
                    </template>

                    <!-- Custom Tab Content — Layout Builder (rows/panels like cockpit) -->
                    <template x-if="activeTabMeta && activeTabMeta.isCustom">
                        <div :class="ctEditMode ? 'p-4' : 'pt-2'" :style="ctEditMode ? 'background: #f7f8fa; border-radius: 12px;' : 'background: transparent;'">
                            <!-- Header bar with edit toggle -->
                            <div style="display: flex; align-items: center; justify-content: flex-end; margin-bottom: 12px; gap: 8px;">
                                <button type="button" @click="ctEditMode = !ctEditMode"
                                        :style="ctEditMode ? 'background: var(--primary-color, #4361ee); color: white; border: 1px solid var(--primary-color, #4361ee);' : 'background: white; color: #6b7280; border: 1px solid #e5e7eb;'"
                                        style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.15s;">
                                    <iconify-icon :icon="ctEditMode ? 'solar:eye-bold' : 'solar:pen-new-round-bold'" width="14"></iconify-icon>
                                    <span x-text="ctEditMode ? 'Aperçu' : 'Modifier'"></span>
                                </button>
                            </div>

                            <!-- Empty State (no rows yet) -->
                            <template x-if="!getTabRows(activeTab) || getTabRows(activeTab).length === 0">
                                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 200px; border: 2px dashed #d1d5db; border-radius: 12px; background: white;">
                                    <iconify-icon icon="solar:widget-5-bold-duotone" width="48" style="color: #9ca3af; margin-bottom: 12px;"></iconify-icon>
                                    <p style="color: #6b7280; margin-bottom: 12px; font-size: 14px;">Aucun contenu. Commencez à construire !</p>
                                    <button type="button" @click="ctAddRow(activeTab)"
                                            style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 20px; background: var(--primary-color, #4361ee); color: white; border-radius: 8px; font-size: 13px; font-weight: 600; border: none; cursor: pointer;">
                                        <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
                                        Ajouter une ligne
                                    </button>
                                </div>
                            </template>

                            <!-- Rows -->
                            <div style="display: flex; flex-direction: column; gap: 16px;"
                                 :id="'ct-rows-' + activeTab"
                                 x-effect="if (ctEditMode) { $nextTick(() => ctInitSortables()); } else { ctDestroySortables(); }">
                                <template x-for="(row, rowIndex) in getTabRows(activeTab)" :key="row.id">
                                    <div :style="'position: relative; overflow: visible;' + (ctEditMode ? 'padding-top: 20px;' : '')"
                                         class="ct-row-item"
                                         :data-row-id="row.id"
                                         x-data="{ rowHover: false }"
                                         @mouseenter="rowHover = true"
                                         @mouseleave="rowHover = false">

                                        <!-- Row Toolbar (hover, edit mode only) -->
                                        <div x-show="ctEditMode"
                                             :style="'position: absolute; top: 0; left: 0; height: 19px; display: flex; align-items: center; z-index: 50; gap: 0;' + (rowHover ? 'opacity:1; pointer-events:auto;' : 'opacity:0; pointer-events:none;')"
                                             style="transition: opacity 0.12s ease;">
                                            <div style="display: inline-flex; align-items: center; gap: 1px; background: rgba(255,255,255,0.95); backdrop-filter: blur(6px); border-radius: 0 0 6px 0; padding: 0 3px; height: 19px; border-bottom: 1px solid rgba(0,0,0,0.04); border-right: 1px solid rgba(0,0,0,0.04);">
                                                <!-- Drag Handle -->
                                                <div class="ct-row-drag-handle" style="width: 17px; height: 17px; display: inline-flex; align-items: center; justify-content: center; cursor: grab; color: #d1d5db; flex-shrink: 0; border-radius: 3px;" title="Glisser pour réordonner"
                                                     onmouseover="this.style.color='#6b7280';this.style.background='#f3f4f6'" onmouseout="this.style.color='#d1d5db';this.style.background='transparent'">
                                                    <iconify-icon icon="solar:hamburger-menu-linear" width="10"></iconify-icon>
                                                </div>
                                                <div style="width: 1px; height: 11px; background: #e5e7eb; margin: 0 1px; flex-shrink: 0;"></div>
                                                <!-- Layout presets -->
                                                <button type="button" @click.stop="ctSetRowLayout(activeTab, row.id, 1)"
                                                        title="1 col"
                                                        style="width: 17px; height: 17px; display: inline-flex; align-items: center; justify-content: center; border-radius: 3px; border: none; cursor: pointer; background: transparent; color: #9ca3af; flex-shrink: 0; padding: 0;"
                                                        onmouseover="this.style.background='rgba(67,97,238,0.1)';this.style.color='#4361ee'" onmouseout="this.style.background='transparent';this.style.color='#9ca3af'">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
                                                </button>
                                                <button type="button" @click.stop="ctSetRowLayout(activeTab, row.id, 2)"
                                                        title="2 col"
                                                        style="width: 17px; height: 17px; display: inline-flex; align-items: center; justify-content: center; border-radius: 3px; border: none; cursor: pointer; background: transparent; color: #9ca3af; flex-shrink: 0; padding: 0;"
                                                        onmouseover="this.style.background='rgba(67,97,238,0.1)';this.style.color='#4361ee'" onmouseout="this.style.background='transparent';this.style.color='#9ca3af'">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="4" y="4" width="6" height="16" rx="1"/><rect x="14" y="4" width="6" height="16" rx="1"/></svg>
                                                </button>
                                                <button type="button" @click.stop="ctSetRowLayout(activeTab, row.id, 3)"
                                                        title="3 col"
                                                        style="width: 17px; height: 17px; display: inline-flex; align-items: center; justify-content: center; border-radius: 3px; border: none; cursor: pointer; background: transparent; color: #9ca3af; flex-shrink: 0; padding: 0;"
                                                        onmouseover="this.style.background='rgba(67,97,238,0.1)';this.style.color='#4361ee'" onmouseout="this.style.background='transparent';this.style.color='#9ca3af'">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="4" height="16" rx="1"/><rect x="10" y="4" width="4" height="16" rx="1"/><rect x="17" y="4" width="4" height="16" rx="1"/></svg>
                                                </button>
                                                <div style="width: 1px; height: 11px; background: #e5e7eb; margin: 0 1px; flex-shrink: 0;"></div>
                                                <!-- Move Up -->
                                                <button type="button" @click.stop="ctMoveRow(activeTab, row.id, -1)"
                                                        title="↑"
                                                        x-show="rowIndex > 0"
                                                        style="width: 17px; height: 17px; display: inline-flex; align-items: center; justify-content: center; border-radius: 3px; border: none; cursor: pointer; background: transparent; color: #9ca3af; flex-shrink: 0; padding: 0;"
                                                        onmouseover="this.style.background='#f3f4f6';this.style.color='#374151'" onmouseout="this.style.background='transparent';this.style.color='#9ca3af'">
                                                    <iconify-icon icon="solar:alt-arrow-up-linear" width="10"></iconify-icon>
                                                </button>
                                                <!-- Move Down -->
                                                <button type="button" @click.stop="ctMoveRow(activeTab, row.id, 1)"
                                                        title="↓"
                                                        x-show="rowIndex < getTabRows(activeTab).length - 1"
                                                        style="width: 17px; height: 17px; display: inline-flex; align-items: center; justify-content: center; border-radius: 3px; border: none; cursor: pointer; background: transparent; color: #9ca3af; flex-shrink: 0; padding: 0;"
                                                        onmouseover="this.style.background='#f3f4f6';this.style.color='#374151'" onmouseout="this.style.background='transparent';this.style.color='#9ca3af'">
                                                    <iconify-icon icon="solar:alt-arrow-down-linear" width="10"></iconify-icon>
                                                </button>
                                                <div style="width: 1px; height: 11px; background: #e5e7eb; margin: 0 1px; flex-shrink: 0;"></div>
                                                <!-- Delete Row -->
                                                <button type="button" @click.stop="ctDeleteRow(activeTab, row.id)"
                                                        title="Supprimer"
                                                        style="width: 17px; height: 17px; display: inline-flex; align-items: center; justify-content: center; border-radius: 3px; border: none; cursor: pointer; background: transparent; color: #d1d5db; flex-shrink: 0; padding: 0;"
                                                        onmouseover="this.style.background='rgba(231,81,90,0.08)';this.style.color='#e7515a'" onmouseout="this.style.background='transparent';this.style.color='#d1d5db'">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="10"></iconify-icon>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Row Grid (12-unit, cockpit pattern) -->
                                        <div style="display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: stretch;">

                                            <!-- Columns -->
                                            <template x-for="(col, colIndex) in row.columns" :key="col.id">
                                                <div :style="'grid-column: span ' + (col.width || Math.floor(12 / row.columns.length)) + '; position: relative; display: flex; flex-direction: column; gap: 12px; min-height:' + (ctEditMode ? '90px' : (col.blockIds && col.blockIds.length ? 'auto' : '0px')) + '; transition: all 0.2s ease;' + (ctEditMode ? 'border: 2px dashed #d1d5db; border-radius: 12px; background: white;' : '')"
                                                     class="ct-col-sortable"
                                                     :data-col-id="col.id"
                                                     :data-row-id="row.id"
