              <button type="button" class="flex h-10 w-full items-center justify-between rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32]" :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': selectedTab === 'fav' }" @click="tabChanged('fav')">
                <div class="flex items-center">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M9.15316 5.40838C10.4198 3.13613 11.0531 2 12 2C12.9469 2 13.5802 3.13612 14.8468 5.40837L15.1745 5.99623C15.5345 6.64193 15.7144 6.96479 15.9951 7.17781C16.2757 7.39083 16.6251 7.4699 17.3241 7.62805L17.9605 7.77203C20.4201 8.32856 21.65 8.60682 21.9426 9.54773C22.2352 10.4886 21.3968 11.4691 19.7199 13.4299L19.2861 13.9372C18.8096 14.4944 18.5713 14.773 18.4641 15.1177C18.357 15.4624 18.393 15.8341 18.465 16.5776L18.5306 17.2544C18.7841 19.8706 18.9109 21.1787 18.1449 21.7602C17.3788 22.3417 16.2273 21.8115 13.9243 20.7512L13.3285 20.4768C12.6741 20.1755 12.3469 20.0248 12 20.0248C11.6531 20.0248 11.3259 20.1755 10.6715 20.4768L10.0757 20.7512C7.77268 21.8115 6.62118 22.3417 5.85515 21.7602C5.08912 21.1787 5.21588 19.8706 5.4694 17.2544L5.53498 16.5776C5.60703 15.8341 5.64305 15.4624 5.53586 15.1177C5.42868 14.773 5.19043 14.4944 4.71392 13.9372L4.2801 13.4299C2.60325 11.4691 1.76482 10.4886 2.05742 9.54773C2.35002 8.60682 3.57986 8.32856 6.03954 7.77203L6.67589 7.62805C7.37485 7.4699 7.72433 7.39083 8.00494 7.17781C8.28555 6.96479 8.46553 6.64194 8.82547 5.99623L9.15316 5.40838Z" stroke="currentColor" stroke-width="1.5"/></svg>
                  <div class="ltr:ml-3 rtl:mr-3">Favoris</div>
                </div>
              </button>
              
              <div class="h-px w-full border-b border-[#e0e6ed] dark:border-[#1b2e4b]"></div>
              <div class="px-1 py-3 text-white-dark">Statut</div>
              
              <button type="button" class="flex h-10 w-full items-center rounded-md p-1 font-medium text-warning duration-300 hover:bg-white-dark/10 ltr:hover:pl-3 rtl:hover:pr-3 dark:hover:bg-[#181F32]" :class="{ 'ltr:pl-3 rtl:pr-3 bg-gray-100 dark:bg-[#181F32]': selectedTab === 'draft' }" @click="tabChanged('draft')">
                <svg class="h-3 w-3 rotate-45 fill-warning" viewBox="0 0 24 24"><path d="M2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12Z" stroke="currentColor" stroke-width="1.5"/></svg>
                <div class="ltr:ml-3 rtl:mr-3">Brouillons</div>
              </button>
              
              <button type="button" class="flex h-10 w-full items-center rounded-md p-1 font-medium text-success duration-300 hover:bg-white-dark/10 ltr:hover:pl-3 rtl:hover:pr-3 dark:hover:bg-[#181F32]" :class="{ 'ltr:pl-3 rtl:pr-3 bg-gray-100 dark:bg-[#181F32]': selectedTab === 'published' }" @click="tabChanged('published')">
                <svg class="h-3 w-3 rotate-45 fill-success" viewBox="0 0 24 24"><path d="M2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12Z" stroke="currentColor" stroke-width="1.5"/></svg>
                <div class="ltr:ml-3 rtl:mr-3">Publiés</div>
              </button>
              
              <button type="button" class="flex h-10 w-full items-center rounded-md p-1 font-medium text-secondary duration-300 hover:bg-white-dark/10 ltr:hover:pl-3 rtl:hover:pr-3 dark:hover:bg-[#181F32]" :class="{ 'ltr:pl-3 rtl:pr-3 bg-gray-100 dark:bg-[#181F32]': selectedTab === 'archived' }" @click="tabChanged('archived')">
                <svg class="h-3 w-3 rotate-45 fill-secondary" viewBox="0 0 24 24"><path d="M2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12Z" stroke="currentColor" stroke-width="1.5"/></svg>
                <div class="ltr:ml-3 rtl:mr-3">Archivés</div>
              </button>
            </div>
          </div>
        </div>
        
        <div class="absolute bottom-0 w-full p-4 ltr:left-0 rtl:right-0">
          <a href="/account/<%= account_number %>/documents/new" class="btn btn-primary w-full">
            <svg class="h-5 w-5 ltr:mr-2 rtl:ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Nouveau Document
          </a>
        </div>
      </div>

      <!-- Main Content Panel -->
      <div class="panel h-full flex-1 overflow-auto">
        <div class="pb-5">
          <button type="button" class="hover:text-primary xl:hidden" @click="isShowDocMenu = !isShowDocMenu">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="M20 7L4 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><path opacity="0.5" d="M20 12L4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><path d="M20 17L4 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
          </button>
        </div>

        <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
          <div class="relative w-full max-w-xs">
            <input type="text" x-model="searchQuery" placeholder="Rechercher..." class="form-input w-full pl-10 dark:bg-[#1b2e4b] dark:border-[#1b2e4b]"/>
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-[#888ea8]" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5" opacity="0.5"></circle><path d="M20 20L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
        </div>

        <template x-if="!filteredDocuments().length">
          <div class="flex h-full min-h-[400px] items-center justify-center text-lg font-semibold">Aucun document trouvé</div>
        </template>

        <template x-if="filteredDocuments().length > 0">
          <div class="min-h-[400px]">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
              <template x-for="doc in filteredDocuments()" :key="doc._id">
                <div class="panel pb-12 relative cursor-pointer hover:shadow-lg transition-shadow"
                     :class="{'bg-warning-light shadow-warning': doc.status === 'draft', 'bg-success-light shadow-success': doc.status === 'published', 'bg-secondary-light shadow-secondary': doc.status === 'archived', 'dark:shadow-dark': !doc.status}"
                     @click="window.location.href = '/account/<%= account_number %>/documents/' + doc._id + '/edit-react'">
                  <div class="min-h-[142px]">
                    <div class="flex justify-between">
                      <div class="flex w-max items-center">
                        <div class="flex-none">
                          <div class="flex -space-x-2" x-data="{ count: (filteredDocuments().indexOf(doc) % 3) + 1, names: ['Marie L.', 'Jean D.', 'Sophie M.', 'Pierre B.', 'Emma R.'], groupHover: false, activeAvatar: null }" @mouseenter="groupHover = true" @mouseleave="groupHover = false; activeAvatar = null" :class="groupHover ? 'gap-1' : '-space-x-2'">
                            <template x-for="i in count" :key="i">
                              <div class="relative" @mouseenter="activeAvatar = i" @mouseleave="activeAvatar = null">
                                <img :src="'/assets/images/profile-' + (((filteredDocuments().indexOf(doc) * 3 + i) % 35) + 1) + '.jpeg'" class="h-8 w-8 rounded-full object-cover border-2 border-white dark:border-[#1b2e4b] transition-transform" :style="groupHover ? 'transform: scale(1.1)' : ''" alt="Collaborateur"/>
                                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1 px-2 py-0.5 bg-dark text-white text-[9px] rounded whitespace-nowrap pointer-events-none transition-opacity" :class="activeAvatar === i ? 'opacity-100' : 'opacity-0'" style="z-index: 60;" x-text="names[(filteredDocuments().indexOf(doc) + i) % 5]"></div>
                              </div>
                            </template>
                          </div>
                        </div>
                        <div class="ltr:ml-2 rtl:mr-2">
                          <div class="font-semibold" x-text="doc.createdBy || 'Utilisateur'"></div>
                          <div class="text-xs text-white-dark" x-text="formatDate(doc.updatedAt)"></div>
                        </div>
                      </div>
                    </div>
                    <div>
                      <h4 class="mt-4 font-semibold" x-text="doc.name"></h4>
                      <p class="mt-2 text-white-dark text-sm line-clamp-2" x-text="doc.description || 'Aucune description'"></p>
                    </div>
                  </div>
                  <div class="absolute bottom-5 left-0 w-full px-5">
                    <div class="mt-2 flex items-center justify-between">
                      <svg class="h-3 w-3 rotate-45" viewBox="0 0 24 24" :class="{'fill-warning text-warning': doc.status === 'draft', 'fill-success text-success': doc.status === 'published', 'fill-secondary text-secondary': doc.status === 'archived'}"><path d="M2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12Z" stroke="currentColor" stroke-width="1.5"/></svg>
                      <div class="flex items-center">
                        <button type="button" class="group text-warning" @click.stop="toggleFav(doc)">
                          <svg class="h-4.5 w-4.5 group-hover:fill-warning" :class="{ 'fill-warning': doc.isFav }" viewBox="0 0 24 24" fill="none"><path d="M9.15316 5.40838C10.4198 3.13613 11.0531 2 12 2C12.9469 2 13.5802 3.13612 14.8468 5.40837L15.1745 5.99623C15.5345 6.64193 15.7144 6.96479 15.9951 7.17781C16.2757 7.39083 16.6251 7.4699 17.3241 7.62805L17.9605 7.77203C20.4201 8.32856 21.65 8.60682 21.9426 9.54773C22.2352 10.4886 21.3968 11.4691 19.7199 13.4299L19.2861 13.9372C18.8096 14.4944 18.5713 14.773 18.4641 15.1177C18.357 15.4624 18.393 15.8341 18.465 16.5776L18.5306 17.2544C18.7841 19.8706 18.9109 21.1787 18.1449 21.7602C17.3788 22.3417 16.2273 21.8115 13.9243 20.7512L13.3285 20.4768C12.6741 20.1755 12.3469 20.0248 12 20.0248C11.6531 20.0248 11.3259 20.1755 10.6715 20.4768L10.0757 20.7512C7.77268 21.8115 6.62118 22.3417 5.85515 21.7602C5.08912 21.1787 5.21588 19.8706 5.4694 17.2544L5.53498 16.5776C5.60703 15.8341 5.64305 15.4624 5.53586 15.1177C5.42868 14.773 5.19043 14.4944 4.71392 13.9372L4.2801 13.4299C2.60325 11.4691 1.76482 10.4886 2.05742 9.54773C2.35002 8.60682 3.57986 8.32856 6.03954 7.77203L6.67589 7.62805C7.37485 7.4699 7.72433 7.39083 8.00494 7.17781C8.28555 6.96479 8.46553 6.64194 8.82547 5.99623L9.15316 5.40838Z" stroke="currentColor" stroke-width="1.5"/></svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>
    </div>
  </template>
  <!-- ============================================ -->
  <!-- TEMPLATE CHOOSER MODAL -->
  <!-- ============================================ -->
  <template x-teleport="body">
    <div x-show="showTemplateModal" 
         x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-[999] flex items-center justify-center bg-black/50 backdrop-blur-sm" 
         @click.self="showTemplateModal = false" style="display:none;">
      <div x-show="showTemplateModal" 
           x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100"
           x-transition:leave="transition ease-in duration-100" x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95"
           class="panel w-full max-w-4xl max-h-[85vh] overflow-hidden flex flex-col" @click.stop>
        
        <!-- Modal Header -->
        <div class="flex items-center justify-between p-5 border-b border-[#e0e6ed] dark:border-[#1b2e4b]">
          <div>
            <h3 class="text-lg font-bold dark:text-white-light">Créer un document</h3>
            <p class="text-sm text-[#888ea8] mt-1">Commencez avec un document vierge ou choisissez un modèle professionnel</p>
          </div>
          <button @click="showTemplateModal = false" class="p-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            <svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
        </div>

        <!-- Category Tabs -->
        <div class="px-5 pt-4 pb-2 flex items-center gap-2 flex-wrap border-b border-[#e0e6ed] dark:border-[#1b2e4b]">
          <button @click="templateCategory = 'all'" class="px-3 py-1.5 rounded-full text-xs font-medium transition-colors"
                  :class="templateCategory === 'all' ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-800 text-[#888ea8] hover:bg-gray-200 dark:hover:bg-gray-700'">
            Tous
          </button>
          <template x-for="cat in templateCategories" :key="cat.id">
            <button @click="templateCategory = cat.id" class="px-3 py-1.5 rounded-full text-xs font-medium transition-colors flex items-center gap-1.5"
                    :class="templateCategory === cat.id ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-800 text-[#888ea8] hover:bg-gray-200 dark:hover:bg-gray-700'">
              <span class="w-2 h-2 rounded-full" :style="'background:' + cat.color"></span>
              <span x-text="cat.label"></span>
            </button>
          </template>
        </div>

        <!-- Modal Body -->
        <div class="flex-1 overflow-y-auto p-5" style="scrollbar-width: thin;">
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            
            <!-- Blank Document Card -->
            <a href="/account/<%= account_number %>/documents/new" 
               class="group border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-xl p-6 flex flex-col items-center justify-center gap-3 hover:border-primary hover:bg-primary/5 transition-all min-h-[200px]">
              <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center group-hover:bg-primary group-hover:scale-110 transition-all">
                <svg class="w-7 h-7 text-primary group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none"><path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </div>
              <div class="text-center">
                <p class="font-semibold text-sm dark:text-white-light">Document vierge</p>
                <p class="text-xs text-[#888ea8] mt-1">Page blanche A4</p>
              </div>
            </a>

            <!-- Template Cards -->
            <template x-for="tpl in filteredTemplates()" :key="tpl._id">
              <a :href="'/account/<%= account_number %>/documents/new?template=' + tpl._id" 
                 class="group relative bg-white dark:bg-[#1b2e4b] rounded-xl border border-[#e0e6ed] dark:border-[#1b2e4b] overflow-hidden hover:shadow-lg hover:border-primary/50 transition-all min-h-[200px] flex flex-col">
                
                <!-- Color Bar -->
                <div class="h-1.5 w-full" :style="'background:' + (tpl.metadata?.color || '#6366f1')"></div>
                
                <!-- Template Preview (scaled down content) -->
                <div class="flex-1 p-4 overflow-hidden relative">
                  <div class="absolute inset-0 p-3 overflow-hidden opacity-25 pointer-events-none" style="transform: scale(0.35); transform-origin: top left; width: 286%; height: 286%;">
                    <div x-html="tpl.pages?.[0]?.content?.substring(0, 600) || ''"></div>
                  </div>
                  
                  <!-- Center Icon -->
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform" :style="'background:' + (tpl.metadata?.color || '#6366f1') + '20'">
                      <iconify-icon :icon="tpl.metadata?.icon || 'tabler:file-text'" width="24" :style="'color:' + (tpl.metadata?.color || '#6366f1')"></iconify-icon>
                    </div>
                  </div>
                </div>
                
                <!-- Template Info -->
                <div class="p-3 border-t border-[#e0e6ed] dark:border-gray-700/50 bg-[#f8f9fa] dark:bg-[#0e1726]/50">
                  <p class="font-semibold text-sm dark:text-white-light truncate" x-text="tpl.name"></p>
                  <p class="text-[11px] text-[#888ea8] mt-0.5 line-clamp-1" x-text="tpl.metadata?.description || 'Modèle de document'"></p>
                </div>

                <!-- Hover Overlay -->
                <div class="absolute inset-0 bg-primary/0 group-hover:bg-primary/5 transition-colors pointer-events-none"></div>
              </a>
            </template>
          </div>

          <!-- Loading State -->
          <template x-if="templatesLoading">
            <div class="flex items-center justify-center py-12">
              <svg class="animate-spin h-8 w-8 text-primary" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
            </div>
          </template>

          <!-- Empty state for filtered -->
          <template x-if="!templatesLoading && filteredTemplates().length === 0 && templateCategory !== 'all'">
            <div class="text-center py-12">
              <iconify-icon icon="tabler:template-off" width="48" class="text-[#888ea8] mx-auto mb-3"></iconify-icon>
              <p class="text-sm text-[#888ea8]">Aucun modèle dans cette catégorie</p>
            </div>
          </template>
        </div>
      </div>
    </div>
  </template>
</div>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('documentList', () => ({
    documents: <%- JSON.stringify(documents || []) %>,
    searchQuery: '',
    viewMode: 'grid',
    layoutMode: 'dashboard',
    selectedTab: 'all',
    folderTab: 'all',
    activeFolder: null,
    isShowDocMenu: false,
    showAllDocs: false,
    showTemplateModal: false,
    templates: [],
    templatesLoading: false,
    templatesLoaded: false,
    templateCategory: 'all',
    templateCategories: [
      { id: 'finance', label: 'Finance', color: '#1e40af' },
      { id: 'commercial', label: 'Commercial', color: '#059669' },
      { id: 'notes', label: 'Notes', color: '#7c3aed' },
      { id: 'courrier', label: 'Courrier', color: '#dc2626' },
      { id: 'rapport', label: 'Rapport', color: '#0891b2' }
    ],
    // New: custom folders, uploads, context menu
    customFolders: <%- JSON.stringify(folders || []) %>,
    uploadedDocs: <%- JSON.stringify(uploadedDocs || []) %>,
    contextMenu: { show: false, x: 0, y: 0, folderId: null, folderName: null },
    isDraggingFile: false,
    isUploading: false,

    async openTemplateModal() {
      this.showTemplateModal = true;
      if (!this.templatesLoaded) {
        this.templatesLoading = true;
        try {
          const res = await fetch('/account/<%= account_number %>/documents/api/templates', { credentials: 'include' });
          const data = await res.json();
          if (data.success) {
            this.templates = data.templates;
          }
        } catch (e) {
          console.error('Error loading templates:', e);
        } finally {
          this.templatesLoading = false;
          this.templatesLoaded = true;
        }
      }
    },

    filteredTemplates() {
      if (this.templateCategory === 'all') return this.templates;
      return this.templates.filter(t => t.metadata?.category === this.templateCategory);
    },

    // ==========================================
    // Folder CRUD
    // ==========================================
    async createFolder() {
      const name = prompt('Nom du nouveau dossier :');
      if (!name || !name.trim()) return;
      try {
        const res = await fetch('/account/<%= account_number %>/documents/api/folders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ name: name.trim() })
        });
        const data = await res.json();
        if (data.success) {
          this.customFolders.push(data.folder);
        }
      } catch (e) {
        console.error('Error creating folder:', e);
      }
    },

    async renameFolder(folderId, currentName) {
      const name = prompt('Nouveau nom du dossier :', currentName);
      if (!name || !name.trim() || name.trim() === currentName) return;
      try {
        const res = await fetch(`/account/<%= account_number %>/documents/api/folders/${folderId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ name: name.trim() })
        });
        const data = await res.json();
        if (data.success) {
          const idx = this.customFolders.findIndex(f => f._id === folderId);
          if (idx !== -1) this.customFolders[idx].name = name.trim();
        }
      } catch (e) {
        console.error('Error renaming folder:', e);
      }
    },

    async deleteFolder(folderId) {
      if (!confirm('Supprimer ce dossier ? Les documents seront déplacés à la racine.')) return;
      try {
        const res = await fetch(`/account/<%= account_number %>/documents/api/folders/${folderId}`, {
          method: 'DELETE',
          credentials: 'include'
        });
        const data = await res.json();
        if (data.success) {
          this.customFolders = this.customFolders.filter(f => f._id !== folderId);
          // Move docs back to root in local state
          this.documents.forEach(d => {
            if (d.folderId === folderId) d.folderId = null;
          });
        }
      } catch (e) {
        console.error('Error deleting folder:', e);
      }
    },

    // ==========================================
    // File Upload
    // ==========================================
    handleFileDrop(event) {
      const files = event.dataTransfer?.files;
      if (files && files.length > 0) {
        this.uploadFiles(files);
      }
    },

    handleFileSelect(event) {
      const files = event.target?.files;
      if (files && files.length > 0) {
        this.uploadFiles(files);
        event.target.value = ''; // reset input
      }
    },

    async uploadFiles(fileList) {
      this.isUploading = true;
      try {
        const formData = new FormData();
        for (const file of fileList) {
          formData.append('files', file);
        }
        const res = await fetch('/account/<%= account_number %>/documents/api/upload-files', {
          method: 'POST',
          credentials: 'include',
          body: formData
        });
        const data = await res.json();
        if (data.success && data.documents) {
          this.uploadedDocs = [...data.documents, ...this.uploadedDocs];
        }
      } catch (e) {
        console.error('Error uploading files:', e);
      } finally {
        this.isUploading = false;
      }
    },

    getFileIconClass(mimeType) {
      if (!mimeType) return 'bg-gray-100 dark:bg-gray-800 text-gray-500';
      if (mimeType.includes('pdf')) return 'bg-red-50 dark:bg-red-900/20 text-red-500';
      if (mimeType.includes('word') || mimeType.includes('document')) return 'bg-blue-50 dark:bg-blue-900/20 text-blue-500';
      if (mimeType.includes('sheet') || mimeType.includes('excel')) return 'bg-green-50 dark:bg-green-900/20 text-green-600';
      if (mimeType.includes('image')) return 'bg-purple-50 dark:bg-purple-900/20 text-purple-500';
      if (mimeType.includes('presentation') || mimeType.includes('powerpoint')) return 'bg-orange-50 dark:bg-orange-900/20 text-orange-500';
      return 'bg-gray-100 dark:bg-gray-800 text-gray-500';
    },

    getFileExt(filename) {
      if (!filename) return '?';
      const parts = filename.split('.');
      return parts.length > 1 ? parts.pop() : '?';
    },
    
    formatDate(dateString) {
      if (!dateString) return '';
      const date = new Date(dateString);
      return date.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
    },
    
    tabChanged(tab) {
      this.selectedTab = tab;
    },
    
    filteredDocuments() {
      let docs = this.documents;
      
      // Apply folder tab filter (used in dashboard layout)
      if (this.layoutMode === 'dashboard') {
        // Custom folder filter
        if (this.activeFolder && this.activeFolder.startsWith('custom-')) {
          const folderId = this.activeFolder.replace('custom-', '');
          docs = docs.filter(d => d.folderId === folderId);
        } else if (this.activeFolder === 'recent') {
          const sevenDaysAgo = new Date();
          sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
          docs = docs.filter(d => new Date(d.updatedAt) >= sevenDaysAgo);
        } else if (this.folderTab === 'draft') {
          docs = docs.filter(d => d.status === 'draft');
        } else if (this.folderTab === 'published') {
          docs = docs.filter(d => d.status === 'published');
        } else if (this.folderTab === 'created') {
          docs = docs.filter(d => !d.isTemplate);
        } else if (this.folderTab === 'fav') {
          docs = docs.filter(d => d.isFav);
        }
      }
      
      // Apply sidebar tab filter (used in notes layout)
      if (this.layoutMode === 'notes') {
        if (this.selectedTab === 'fav') {
          docs = docs.filter(d => d.isFav);
        } else if (this.selectedTab === 'draft') {
          docs = docs.filter(d => d.status === 'draft');
        } else if (this.selectedTab === 'published') {
          docs = docs.filter(d => d.status === 'published');
        } else if (this.selectedTab === 'archived') {
          docs = docs.filter(d => d.status === 'archived');
        }
      }
      
      if (this.searchQuery) {
        const query = this.searchQuery.toLowerCase();
        docs = docs.filter(d => d.name.toLowerCase().includes(query));
      }
      
      return docs;
    },
    
    getRecentDocs() {
      const now = new Date();
      const sevenDaysAgo = new Date(now);
      sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
      return this.documents.filter(d => new Date(d.updatedAt) >= sevenDaysAgo)
        .sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt));
    },

    getFolderLabel(folder) {
      const labels = { recent: 'Récents', draft: 'Brouillons', published: 'Publiés', fav: 'Favoris', all: 'Tous les documents' };
      if (folder && folder.startsWith('custom-')) {
        const folderId = folder.replace('custom-', '');
        const found = this.customFolders.find(f => f._id === folderId);
        return found ? found.name : 'Dossier';
      }
      return labels[folder] || 'Documents';
    },

    toggleFav(doc) {
      doc.isFav = !doc.isFav;
    },
    
    getDocumentsByPeriod(period) {
      const docs = this.filteredDocuments();
      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const yesterday = new Date(today);
      yesterday.setDate(yesterday.getDate() - 1);
      const weekStart = new Date(today);
      weekStart.setDate(weekStart.getDate() - weekStart.getDay() + 1); // Monday
      
      return docs.filter(doc => {
        const docDate = new Date(doc.updatedAt);
        const docDay = new Date(docDate.getFullYear(), docDate.getMonth(), docDate.getDate());
        
        if (period === 'today') {
          return docDay.getTime() === today.getTime();
        } else if (period === 'yesterday') {
          return docDay.getTime() === yesterday.getTime();
        } else if (period === 'week') {
          return docDay >= weekStart && docDay < yesterday;
        }
        return false;
      }).sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt));
    },
    
    getOlderDocsCount() {
      return this.getDocumentsByPeriod('week').length + this.getMonthGroups().reduce((sum, m) => sum + m.docs.length, 0);
    },
    
    getMonthGroups() {
      const docs = this.filteredDocuments();
      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const weekStart = new Date(today);
      weekStart.setDate(weekStart.getDate() - weekStart.getDay() + 1);
      
      // Filter docs older than this week
      const olderDocs = docs.filter(doc => {
        const docDate = new Date(doc.updatedAt);
        const docDay = new Date(docDate.getFullYear(), docDate.getMonth(), docDate.getDate());
        return docDay < weekStart;
      });
      
      // Group by month
      const months = {};
      const monthNames = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
      
      olderDocs.forEach(doc => {
        const date = new Date(doc.updatedAt);
        const key = `${date.getFullYear()}-${date.getMonth()}`;
        const label = `${monthNames[date.getMonth()]} ${date.getFullYear()}`;
        
        if (!months[key]) {
          months[key] = { key, label, docs: [], sortKey: date.getFullYear() * 12 + date.getMonth() };
        }
        months[key].docs.push(doc);
      });
      
      // Sort months descending and docs within each month
      return Object.values(months)
        .sort((a, b) => b.sortKey - a.sortKey)
        .map(m => ({
          ...m,
          docs: m.docs.sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt))
        }));
    }
  }));
});
</script>
