<%
/**
 * 🎨 Computed Field Display Renderer
 * Renders computed/dynamic field values with appropriate visual styles.
 * 
 * Expects:
 *   - computedValue: { value, formatted, max, percentage, currency, ... }
 *   - displayType: 'text' | 'number' | 'currency' | 'stars' | 'progress' | 'badge' | 'duration' | 'percentage'
 *   - field: the FieldTemplate object
 */
const renderType = displayType || field?.render?.display?.table || 'text';
const color = field?.ui?.couleur || field?.color || '#4361ee';
const icon = field?.ui?.icon || '';
%>

<% if (!computedValue || computedValue.value === null || computedValue.value === undefined) { %>
  <span class="computed-field-empty text-gray-300 dark:text-gray-600 text-xs italic">—</span>
<% } else if (renderType === 'stars') { %>
  <%
    const starVal = Number(computedValue.value) || 0;
    const starMax = Number(computedValue.max) || 5;
    const fullStars = Math.floor(starVal);
    const hasHalf = (starVal - fullStars) >= 0.5;
    const emptyStars = starMax - fullStars - (hasHalf ? 1 : 0);
  %>
  <div class="computed-stars" title="<%= computedValue.formatted %>">
    <% for (let i = 0; i < fullStars; i++) { %>
    <iconify-icon icon="solar:star-bold" width="16" style="color: #f59e0b;"></iconify-icon>
    <% } %>
    <% if (hasHalf) { %>
    <iconify-icon icon="solar:star-bold-duotone" width="16" style="color: #f59e0b;"></iconify-icon>
    <% } %>
    <% for (let i = 0; i < emptyStars; i++) { %>
    <iconify-icon icon="solar:star-line-duotone" width="16" style="color: #e2e8f0;"></iconify-icon>
    <% } %>
    <span class="text-xs text-gray-400 ml-1"><%= computedValue.formatted %></span>
  </div>

<% } else if (renderType === 'progress') { %>
  <%
    const pctVal = Math.min(Math.max(Number(computedValue.percentage || computedValue.value) || 0, 0), 100);
    const barColor = pctVal >= 80 ? '#10b981' : pctVal >= 50 ? '#f59e0b' : '#ef4444';
  %>
  <div class="computed-progress" style="display:flex; align-items:center; gap:8px;">
    <div style="flex:1; height:6px; background:#e2e8f0; border-radius:3px; overflow:hidden; min-width:60px;">
      <div style="width:<%= pctVal %>%; height:100%; background:<%= barColor %>; border-radius:3px; transition:width 0.3s;"></div>
    </div>
    <span class="text-xs font-medium" style="color:<%= barColor %>"><%= pctVal %>%</span>
  </div>

<% } else if (renderType === 'badge') { %>
  <span class="computed-badge"
        style="display:inline-flex; align-items:center; gap:4px; padding:2px 10px; border-radius:20px; font-size:12px; font-weight:600;
               background: linear-gradient(135deg, <%= color %>15, <%= color %>08); color: <%= color %>;">
    <% if (icon) { %><iconify-icon icon="<%= icon %>" width="13"></iconify-icon><% } %>
    <%= computedValue.formatted %>
  </span>

<% } else if (renderType === 'currency') { %>
  <span class="computed-currency" style="font-weight:600; font-size:14px; color:#334155;">
    <%= computedValue.formatted || (Number(computedValue.value).toLocaleString('fr-FR', {minimumFractionDigits:2}) + ' €') %>
  </span>

<% } else if (renderType === 'duration') { %>
  <span class="computed-duration" style="display:inline-flex; align-items:center; gap:4px; font-size:13px; color:#64748b;">
    <iconify-icon icon="solar:clock-circle-bold-duotone" width="14" style="color:<%= color %>;"></iconify-icon>
    <%= computedValue.formatted %>
  </span>

<% } else if (renderType === 'percentage') { %>
  <%
    const pctValue = Number(computedValue.value) || 0;
    const pctColor = pctValue >= 80 ? '#10b981' : pctValue >= 50 ? '#f59e0b' : '#ef4444';
  %>
  <span class="computed-percentage" style="font-weight:600; font-size:13px; color:<%= pctColor %>">
    <%= computedValue.formatted || pctValue + '%' %>
  </span>

<% } else if (renderType === 'number') { %>
  <span class="computed-number" style="font-weight:600; font-size:14px; font-variant-numeric:tabular-nums; color:#334155;">
    <%= computedValue.formatted || computedValue.value %>
  </span>

<% } else { %>
  <%# Default: text rendering %>
  <span class="computed-text" style="font-size:13px; color:#334155;">
    <% if (icon) { %><iconify-icon icon="<%= icon %>" width="13" style="color:<%= color %>; margin-right:4px;"></iconify-icon><% } %>
    <%= computedValue.formatted || computedValue.value %>
  </span>
<% } %>
