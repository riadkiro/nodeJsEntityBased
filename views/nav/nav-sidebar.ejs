                    <button class="p-3 rounded-lg border-2 flex flex-col items-center gap-2 transition-all"
                      :class="tempViewType === type ? 'border-primary bg-primary/5 text-primary' : 'border-gray-100 dark:border-gray-800 text-gray-500 grayscale hover:grayscale-0 hover:border-primary/50'"
                      @click="tempViewType = type">
                      <iconify-icon :icon="getIcon(type === 'list' || type === 'table' ? 'entity' : type)"
                        width="24"></iconify-icon>
                      <span class="text-[10px] font-bold uppercase" x-text="type"></span>
                    </button>
                  </template>
                </div>
              </div>

              <!-- Filters Section -->
