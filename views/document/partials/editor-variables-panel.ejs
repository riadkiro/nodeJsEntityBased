<div 
    x-show="activeTab === 'variables'"
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="-translate-x-full opacity-0"
    x-transition:enter-end="translate-x-0 opacity-100"
    x-transition:leave="transition ease-in duration-200 transform"
    x-transition:leave-start="translate-x-0 opacity-100"
    x-transition:leave-end="-translate-x-full opacity-0"
    class="w-72 bg-white dark:bg-[#0e1726] border-0 flex flex-col shadow-xl z-20 overflow-hidden"
    style="display: none; width:250px ; border : 1px solid #f1f1f1"
    x-data="{ 
        openSections: { relations: true, date: true, document: true, user: true, company: true, collections: true },
        showRelationModal: false,
        selectedEntities: [],
        selectedRelations: [],
        availableEntities: [],
        relationSections: [],
        async saveRelations() {
            // Find newly selected entities
            const entitiesToAdd = this.selectedEntities.filter(
                id => !this.selectedRelations.find(r => r.id === id)
            );
            
            // Add each new entity to selectedRelations and fetch its fields
            for (const entityId of entitiesToAdd) {
                const entity = this.availableEntities.find(e => e.id === entityId);
                if (entity) {
                    this.selectedRelations.push(entity);
                    await this.addRelationSection(entity.id);
                }
            }
            
            this.selectedEntities = [];
            this.showRelationModal = false;
        },
        async addRelationSection(entityId) {
            try {
                const accountNumber = window.location.pathname.split('/')[2];
                const response = await fetch(`/account/${accountNumber}/api/hierarchy/entity/${entityId}/fields`);
                const data = await response.json();
                
                if (data.success) {
                    this.relationSections.push({
                        id: data.entity.id,
                        name: data.entity.name,
                        icon: data.entity.icon,
                        fields: data.entity.fields,
                        isOpen: true
                    });
                }
            } catch (error) {
                console.error('Error loading entity fields:', error);
            }
        },
        removeRelation(relationId) {
            this.selectedRelations = this.selectedRelations.filter(r => r.id !== relationId);
            this.relationSections = this.relationSections.filter(s => s.id !== relationId);
        },
        async loadEntities() {
            try {
                const accountNumber = window.location.pathname.split('/')[2];
                const response = await fetch(`/account/${accountNumber}/api/hierarchy/all-entities`);
                const data = await response.json();
                this.availableEntities = (data.entities || []).map(entity => ({
                    id: entity.id || entity._id,
                    name: entity.name,
                    icon: entity.icon || 'solar:database-broken',
                    fieldsCount: entity.fieldsCount || 0
                }));
            } catch (error) {
                console.error('Erreur lors du chargement des entités:', error);
                this.availableEntities = [];
            }
        }
    }"
    x-init="loadEntities()"
>
    <!-- Header -->
    <div class="p-4 border-b dark:border-gray-800 flex justify-between items-center bg-gray-50/50 dark:bg-gray-900/50">
        <h3 class="font-bold text-sm flex items-center gap-2">
            <iconify-icon icon="solar:database-bold-duotone" class="text-blue-500" width="20"></iconify-icon>
            Source de données
        </h3>
        <button @click="activeTab = null" class="w-6 h-6 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 flex items-center justify-center">
            <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
        </button>
    </div>

    <!-- Scrollable Content -->
    <div class="flex-1 overflow-y-auto p-3 custom-scrollbar">
        
        <!-- Relations Section (NEW) -->
        <div class="mb-4">
            <button 
                @click="openSections.relations = !openSections.relations"
                class="w-full text-left text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2 flex items-center justify-between gap-1 cursor-pointer hover:text-gray-500 dark:hover:text-gray-300 transition-colors"
            >
                <div class="flex items-center gap-1">
                    <iconify-icon icon="solar:link-bold-duotone" width="14"></iconify-icon>
                    Relations
                </div>
                <iconify-icon :icon="openSections.relations ? 'solar:alt-arrow-down-bold' : 'solar:alt-arrow-right-bold'" width="12"></iconify-icon>
            </button>
            <div x-show="openSections.relations" x-collapse>
                <!-- Ajouter button at top -->
                <button 
                    @click="showRelationModal = true; loadEntities()" 
                    class="w-full flex items-center gap-2 px-3 py-2 mb-3 text-xs font-medium text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-700/50 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg border border-dashed border-gray-300 dark:border-gray-600 transition-all"
                >
                    <iconify-icon icon="tabler:plus" width="16"></iconify-icon>
                    Ajouter
                </button>
                
                <!-- Selected Relations Tags -->
                <div class="flex flex-wrap gap-2 mb-3" x-show="selectedRelations.length > 0">
                    <template x-for="relation in selectedRelations" :key="relation.id">
                        <div class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 text-xs">
                            <iconify-icon :icon="relation.icon || 'solar:database-broken'" class="text-blue-600 dark:text-blue-400" width="14"></iconify-icon>
                            <span class="text-blue-700 dark:text-blue-300 font-medium" x-text="relation.name"></span>
                            <button 
                                @click="removeRelation(relation.id)"
                                class="ml-0.5 text-blue-400 hover:text-blue-600 dark:text-blue-500 dark:hover:text-blue-300 transition-colors"
                            >
                                <iconify-icon icon="tabler:x" width="12"></iconify-icon>
                            </button>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <!-- Dynamic Relation Sections -->
        <template x-for="section in relationSections" :key="section.id">
            <div class="mb-4">
                <button 
                    @click="section.isOpen = !section.isOpen"
                    class="w-full text-left text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2 flex items-center justify-between gap-1 cursor-pointer hover:text-gray-500 dark:hover:text-gray-300 transition-colors"
                >
                    <div class="flex items-center gap-1.5">
                        <iconify-icon :icon="section.icon" width="14"></iconify-icon>
                        <span x-text="section.name"></span>
                    </div>
                    <iconify-icon :icon="section.isOpen ? 'solar:alt-arrow-down-bold' : 'solar:alt-arrow-right-bold'" width="12"></iconify-icon>
                </button>
                <div x-show="section.isOpen" x-collapse>
                    <!-- Fields as Tags -->
                    <div class="flex flex-wrap gap-2">
                        <template x-for="field in section.fields" :key="field.id">
                            <button 
                                @click="$dispatch('insert-token', { path: `${section.name}.cf.${field.name}`, metadata: { isCustomField: true, fieldId: field.id } })"
                                draggable="true"
                                @dragstart="$event.dataTransfer.setData('application/json', JSON.stringify({ type: 'variable', path: `${section.name}.cf.${field.name}`, metadata: { isCustomField: true, fieldId: field.id } })); $event.dataTransfer.effectAllowed = 'copy';"
                                class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 text-xs hover:bg-blue-100 dark:hover:bg-blue-900/30 hover:border-blue-300 dark:hover:border-blue-700 transition-all cursor-grab active:cursor-grabbing"
                            >
                                <iconify-icon :icon="field.icon" class="text-blue-600 dark:text-blue-400" width="14"></iconify-icon>
                                <span class="text-blue-700 dark:text-blue-300 font-medium" x-text="field.name"></span>
                            </button>
                        </template>
                    </div>
                    <!-- Empty state -->
                    <div x-show="section.fields.length === 0" class="text-center py-4 text-xs text-gray-400">
                        Aucun champ disponible
                    </div>
                </div>
            </div>
        </template>

        <!-- Visual Separator -->
        <div class="mt-6 mb-3 text-[9px] uppercase tracking-wider text-gray-400 font-bold px-1">
            Variables Globales
        </div>
        
        <!-- Date Variables (NOW COLLAPSIBLE) -->
