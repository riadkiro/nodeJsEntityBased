        <!-- ═══ Edit Line Modal ═══ -->
        <template x-if="editModal.open">
            <div class="lp-modal-overlay" @click.self="closeEditModal()" @keydown.escape.window="closeEditModal()">
                <div class="lp-modal" style="max-width: 520px;" :style="editRelOpen ? 'overflow: visible' : ''">
                    <!-- Header -->
                    <div class="lp-modal-header">
                        <h3>
                            <iconify-icon icon="solar:pen-bold-duotone" width="18" class="text-primary"></iconify-icon>
