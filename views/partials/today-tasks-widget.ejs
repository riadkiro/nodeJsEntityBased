<%
    const _todayTasksHref = (typeof todayTasksHref !== 'undefined' && todayTasksHref)
        ? todayTasksHref
        : ('/account/' + account_number + '/tasks');
%>
<template x-if="wid === 'priority-day' || wid === 'today-tasks'">
    <div class="ov-card dx-card dx-priority-card" :style="'--ov-color:' + widgetColor(wid, '#805dca')">
        <div class="ov-card-header dx-card-header">
            <div class="ov-card-title dx-card-title">
                <iconify-icon :icon="widgetIcon(wid, 'solar:bolt-bold-duotone')"></iconify-icon>
                <span x-text="widgetTitle(wid, 'Tâches du jour')"></span>
                <span class="dx-count-pill" x-text="todayWidgetOpenTasks(wid).length + ' à faire'"></span>
                <button type="button"
                        class="dx-day-nav-btn dx-overdue-nav-btn"
                        x-cloak
                        x-show="todayWidgetOverdueCount(wid) > 0"
                        :class="{ 'is-active': todayWidgetIsOverdue(wid) }"
                        :title="todayWidgetOverdueCount(wid) + ' tâche' + (todayWidgetOverdueCount(wid) > 1 ? 's' : '') + ' en retard'"
                        @click.stop="selectOverdueTodayWidget(wid)">
                    <iconify-icon icon="solar:danger-triangle-linear" width="11"></iconify-icon>
                    <span x-text="todayWidgetOverdueCount(wid) + ' en retard'"></span>
                </button>
                <button type="button"
                        class="dx-day-nav-btn"
                        x-show="!todayWidgetIsToday(wid) || todayWidgetIsOverdue(wid)"
                        @click.stop="resetTodayWidgetDate(wid)">
                    Aujourd'hui
                </button>
                <button type="button"
                        class="dx-day-nav-btn"
                        :class="{ 'is-active': todayWidgetIsTomorrow(wid) }"
                        @click.stop="selectTomorrowTodayWidget(wid)">
                    Demain
                </button>
                <button type="button"
                        class="dx-day-date-button"
                        :class="{ 'is-active': todayWidgetHasCustomDate(wid) }"
                        title="Choisir une date"
                        @click.stop="openTodayWidgetDatePicker($event, wid)">
                    <iconify-icon icon="solar:calendar-linear" width="13"></iconify-icon>
                    <span x-show="todayWidgetHasCustomDate(wid)" x-text="todayWidgetSelectedLabel(wid)"></span>
                </button>
            </div>
            <a class="ov-card-link dx-link" href="<%= _todayTasksHref %>" x-show="widgetShowLink(wid, true)">Voir tout</a>
        </div>
        <div class="ov-card-body dx-priority-body"
             :class="{ 'is-completed-panel-hidden': !todayWidgetCompletedPanelEnabled(wid) }">
            <div class="dx-shopping-list dx-priority-task-list"
                 :data-task-widget-id="wid"
                 x-init="$nextTick(() => initHomeTaskSortable($el, wid))">
                <template x-for="item in todayWidgetVisibleTasks(wid).slice(0, 40)" :key="(item._id || item.id) + ':' + homeTaskRenderKey(wid)">
                    <div class="dx-shopping-row dx-task-row dx-single-line"
                         :class="{ 'is-done': item.status === 'Terminé', 'is-accented': homeTaskAccentStyleEnabled(wid) }"
                         :style="'--task-accent-color:' + homeTaskRowAccentColor(item)"
                         :data-task-id="item._id || item.id"
                         @contextmenu.prevent.stop="openHomeTaskMenu($event, wid, item)">
                        <span class="dx-task-drag" title="Réordonner" @click.stop>
                            <iconify-icon icon="tabler:grip-vertical" width="13"></iconify-icon>
                        </span>
                        <button type="button"
                                class="dx-check"
                                :class="item.status === 'Terminé' ? 'is-checked' : ''"
                                :title="item.status === 'Terminé' ? 'Marquer à faire' : 'Marquer terminé'"
                                @click.stop="toggleTodayTaskItem(wid, item)"></button>
                        <template x-if="editingHomeTaskId !== (item._id || item.id)">
                            <span class="dx-task-title-stack">
                                <span class="dx-task-title" x-text="item.title" @click.stop="openHomeTaskModal(wid, item)" @dblclick.stop="startEditTodayTask(wid, item)" style="cursor:pointer;"></span>
                                <span class="dx-task-subtitle-row"
                                      x-show="homeTaskSubtitleRowVisible(wid, item)"
                                      :style="'--task-record-color:' + homeTaskSubtitleColor(wid, item)">
                                    <span class="dx-task-subtitle"
                                          x-show="homeTaskSubtitleVisible(wid, item)"
                                          :title="homeTaskSubtitleLabel(wid, item)">
                                        <span class="dx-task-record-mini">
                                            <iconify-icon :icon="homeTaskSubtitleIcon(wid, item)" width="10"></iconify-icon>
                                        </span>
                                        <span class="dx-task-subtitle-label" x-text="homeTaskSubtitleLabel(wid, item)"></span>
                                    </span>
                                    <span class="dx-task-subtitle-reminder"
                                          x-show="taskHasReminder(item)"
                                          :title="taskReminderLabel(item)">
                                        <iconify-icon icon="solar:bell-linear" width="11"></iconify-icon>
                                    </span>
                                    <span class="dx-task-subtitle-attachment"
                                          x-show="homeTaskAttachmentsEnabled(wid) && taskHasAttachments(item)"
                                          title="Pièce jointe">
                                        <iconify-icon icon="solar:paperclip-rounded-linear" width="11"></iconify-icon>
                                    </span>
                                </span>
                            </span>
                        </template>
                        <template x-if="editingHomeTaskId === (item._id || item.id)">
                            <input class="dx-task-edit"
                                   type="text"
                                   :data-task-id="item._id || item.id"
                                   x-model="editingHomeTaskTitle"
                                   @click.stop
                                   @keydown.enter.prevent="saveEditTodayTask(wid, item)"
                                   @keydown.escape.prevent="cancelEditHomeTask()"
                                   @blur="saveEditTodayTask(wid, item)">
                        </template>
                        <span class="dx-row-meta dx-day-row-meta">
                            <span class="dx-task-due-badge"
                                  x-show="taskDueLabel(item)"
                                  :class="{ 'is-overdue': taskDueState(item) === 'overdue' }"
                                  :title="taskDueTitle(item)">
                                <iconify-icon icon="solar:clock-circle-linear" width="12"></iconify-icon>
                                <span x-text="taskDueLabel(item)"></span>
                            </span>
                            <button type="button"
                                    class="dx-task-priority dx-day-row-priority"
                                    x-show="homeTaskPriorityEnabled(wid)"
                                    :class="{ 'is-empty': !homeTaskPriorityVisible(wid, item) }"
                                    :style="'--priority-color:' + homeTaskPriorityColor(item.priority, item)"
                                    :title="homeTaskPriorityVisible(wid, item) ? 'Priorité ' + homeTaskPriorityLabel(item.priority) : 'Ajouter une priorité'"
                                    @pointerdown.stop
                                    @click.stop="openHomeTaskPriorityMenu($event, wid, item)">
                                <iconify-icon icon="solar:flag-linear" width="12"></iconify-icon>
                                <span x-show="homeTaskPriorityVisible(wid, item)" x-text="homeTaskPriorityVisible(wid, item) ? homeTaskPriorityLabel(item.priority) : ''"></span>
                            </button>
                        </span>
                    </div>
                </template>
                <template x-if="todayWidgetVisibleTasks(wid).length === 0">
                    <div class="ov-custom-empty" x-text="todayWidgetEmptyLabel(wid)"></div>
                </template>
                <div class="dx-completed-today dx-completed-today-inline" x-show="todayWidgetCompletedPanelEnabled(wid)">
                    <details class="dx-completed-details">
                        <summary class="dx-completed-header">
                            <iconify-icon icon="solar:check-circle-bold" style="color:#22c55e;font-size:15px;"></iconify-icon>
                            <strong x-text="completedDayTitle(wid)"></strong>
                            <iconify-icon class="dx-completed-toggle-icon" icon="solar:alt-arrow-down-linear" width="14"></iconify-icon>
                        </summary>
                        <div class="dx-completed-list">
                            <template x-for="item in completedTodayDayTasks(wid)" :key="item._id || item.id">
                                <div class="dx-completed-row">
                                    <button type="button"
                                            class="dx-done-action"
                                            title="Remettre à faire"
                                            aria-label="Remettre à faire"
                                            @click.stop="toggleTodayTaskItem(wid, item)">
                                        <iconify-icon icon="solar:check-circle-bold" class="dx-done-icon"></iconify-icon>
                                        <iconify-icon icon="solar:close-circle-bold" class="dx-done-remove-icon"></iconify-icon>
                                    </button>
                                    <span class="dx-done-title" x-text="item.title" @click.stop="openHomeTaskModal(wid, item)" style="cursor:pointer;"></span>
                                    <span class="dx-done-record" x-show="item.recordTitle && item.recordTitle !== 'Espace perso'" x-text="item.recordTitle"></span>
                                </div>
                            </template>
                            <template x-if="completedTodayDayTasks(wid).length === 0">
                                <div class="dx-completed-empty" x-text="completedDayEmptyLabel(wid)"></div>
                            </template>
                        </div>
                    </details>
                </div>
                <form class="dx-inline-add" x-show="!todayWidgetIsOverdue(wid)" @submit.prevent="addTodayTask(wid)">
                    <input type="text" :value="newTaskTitleFor(wid)" @input="setNewTaskTitle(wid, $event.target.value)" :placeholder="todayWidgetAddPlaceholder(wid)">
                    <button type="submit" title="Ajouter"><iconify-icon icon="tabler:plus" width="15"></iconify-icon></button>
                </form>
            </div>
            <div class="dx-completed-today dx-completed-today-side" x-show="todayWidgetCompletedPanelEnabled(wid)">
                <div class="dx-completed-header">
                    <iconify-icon icon="solar:check-circle-bold" style="color:#22c55e;font-size:15px;"></iconify-icon>
                    <strong x-text="completedDayTitle(wid)"></strong>
                </div>
                <div class="dx-completed-list">
                    <template x-for="item in completedTodayDayTasks(wid)" :key="item._id || item.id">
                        <div class="dx-completed-row">
                            <button type="button"
                                    class="dx-done-action"
                                    title="Remettre à faire"
                                    aria-label="Remettre à faire"
                                    @click.stop="toggleTodayTaskItem(wid, item)">
                                <iconify-icon icon="solar:check-circle-bold" class="dx-done-icon"></iconify-icon>
                                <iconify-icon icon="solar:close-circle-bold" class="dx-done-remove-icon"></iconify-icon>
                            </button>
                            <span class="dx-done-title" x-text="item.title" @click.stop="openHomeTaskModal(wid, item)" style="cursor:pointer;"></span>
                            <span class="dx-done-record" x-show="item.recordTitle && item.recordTitle !== 'Espace perso'" x-text="item.recordTitle"></span>
                        </div>
                    </template>
                    <template x-if="completedTodayDayTasks(wid).length === 0">
                        <div class="dx-completed-empty" x-text="completedDayEmptyLabel(wid)"></div>
                    </template>
                </div>
            </div>
        </div>
    </div>
</template>
