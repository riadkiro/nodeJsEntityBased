<div x-data="documentList()">
  <!-- Header with Breadcrumb and Layout Toggle -->
  <div class="flex items-center justify-between">
    <div class="flex-1">
      <%- include("../nav/nav-breadcrumb") %>
    </div>
    <!-- Layout Toggle - minimal like kanban/table -->
    <div class="flex items-center gap-1">
      <button 
        @click="layoutMode = 'dashboard'" 
        class="p-1.5 rounded transition-colors"
        :class="layoutMode === 'dashboard' ? 'text-primary' : 'text-[#888ea8] hover:text-primary'"
        title="Vue Dashboard"
      >
        <!-- Grid icon -->
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
          <path d="M2 6.5C2 4.37868 2 3.31802 2.65901 2.65901C3.31802 2 4.37868 2 6.5 2C8.62132 2 9.68198 2 10.341 2.65901C11 3.31802 11 4.37868 11 6.5C11 8.62132 11 9.68198 10.341 10.341C9.68198 11 8.62132 11 6.5 11C4.37868 11 3.31802 11 2.65901 10.341C2 9.68198 2 8.62132 2 6.5Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M13 6.5C13 4.37868 13 3.31802 13.659 2.65901C14.318 2 15.3787 2 17.5 2C19.6213 2 20.682 2 21.341 2.65901C22 3.31802 22 4.37868 22 6.5C22 8.62132 22 9.68198 21.341 10.341C20.682 11 19.6213 11 17.5 11C15.3787 11 14.318 11 13.659 10.341C13 9.68198 13 8.62132 13 6.5Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M2 17.5C2 15.3787 2 14.318 2.65901 13.659C3.31802 13 4.37868 13 6.5 13C8.62132 13 9.68198 13 10.341 13.659C11 14.318 11 15.3787 11 17.5C11 19.6213 11 20.682 10.341 21.341C9.68198 22 8.62132 22 6.5 22C4.37868 22 3.31802 22 2.65901 21.341C2 20.682 2 19.6213 2 17.5Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M13 17.5C13 15.3787 13 14.318 13.659 13.659C14.318 13 15.3787 13 17.5 13C19.6213 13 20.682 13 21.341 13.659C22 14.318 22 15.3787 22 17.5C22 19.6213 22 20.682 21.341 21.341C20.682 22 19.6213 22 17.5 22C15.3787 22 14.318 22 13.659 21.341C13 20.682 13 19.6213 13 17.5Z" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>
      <button 
        @click="layoutMode = 'notes'" 
        class="p-1.5 rounded transition-colors"
        :class="layoutMode === 'notes' ? 'text-primary' : 'text-[#888ea8] hover:text-primary'"
        title="Vue Sidebar"
      >
        <!-- Sidebar layout icon -->
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
          <path d="M2 6C2 4.11438 2 3.17157 2.58579 2.58579C3.17157 2 4.11438 2 6 2H18C19.8856 2 20.8284 2 21.4142 2.58579C22 3.17157 22 4.11438 22 6V18C22 19.8856 22 20.8284 21.4142 21.4142C20.8284 22 19.8856 22 18 22H6C4.11438 22 3.17157 22 2.58579 21.4142C2 20.8284 2 19.8856 2 18V6Z" stroke="currentColor" stroke-width="1.5"/>
          <path opacity="0.5" d="M8 2V22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- LAYOUT 1: DASHBOARD (Default) -->
  <!-- ============================================ -->
  <template x-if="layoutMode === 'dashboard'">
    <div class="pt-5">
      <!-- Single Row: Hero + Stats + Toolbar -->
      <div class="mb-6 flex flex-col lg:flex-row gap-4">
        <!-- Hero Card -->
        <div class="panel bg-gradient-to-br from-primary via-primary to-secondary p-0 overflow-hidden lg:w-80 flex-shrink-0">
          <div class="relative p-5 text-white">
            <div class="absolute -right-4 -top-4 opacity-20">
              <svg width="80" height="80" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z"/>
              </svg>
            </div>
            <div class="relative z-10">
              <h1 class="text-lg font-bold mb-1">Mes Documents</h1>
              <p class="text-white/80 text-xs mb-3">Créez et partagez</p>
              <div class="flex flex-wrap gap-2">
                <a href="/account/<%= account_number %>/documents/new" class="btn btn-xs btn-outline-primary border-white/50 text-white hover:bg-white/10">
                  <svg class="w-3 h-3 mr-1" viewBox="0 0 24 24" fill="none"><path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  Nouveau
                </a>
                <a href="/account/<%= account_number %>/documents/templates" class="btn btn-xs btn-outline-light border-white/30 text-white hover:bg-white/10">
                  Templates
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Stats Panels -->
        <div class="flex gap-3 flex-shrink-0">
          <div class="panel p-4">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M8 12H16M8 8H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </div>
              <div>
                <p class="text-xl font-bold dark:text-white-light" x-text="documents.length">0</p>
                <p class="text-xs text-[#888ea8]">Documents</p>
              </div>
            </div>
          </div>
          <div class="panel p-4">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-warning/10 text-warning">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M8 12H16M8 8H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </div>
              <div>
                <p class="text-xl font-bold dark:text-white-light" x-text="documents.filter(d => d.status === 'draft').length">0</p>
                <p class="text-xs text-[#888ea8]">Brouillons</p>
              </div>
            </div>
          </div>
          <div class="panel p-4">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-success/10 text-success">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/><path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div>
                <p class="text-xl font-bold dark:text-white-light" x-text="documents.filter(d => d.status === 'published').length">0</p>
                <p class="text-xs text-[#888ea8]">Publiés</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Toolbar -->
        <div class="flex-1 flex items-center justify-end gap-3">
          <div class="relative w-full max-w-xs">
            <input type="text" x-model="searchQuery" placeholder="Rechercher..." class="form-input w-full pl-10 dark:bg-[#1b2e4b] dark:border-[#1b2e4b]"/>
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-[#888ea8]" viewBox="0 0 24 24" fill="none">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5" opacity="0.5"></circle>
              <path d="M20 20L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="flex gap-1">
            <button @click="viewMode = 'grid'" class="p-2 rounded-md" :class="viewMode === 'grid' ? 'bg-primary text-white' : 'bg-white-light/40 dark:bg-dark/40'">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M2 6.5C2 4.37868 2 3.31802 2.65901 2.65901C3.31802 2 4.37868 2 6.5 2C8.62132 2 9.68198 2 10.341 2.65901C11 3.31802 11 4.37868 11 6.5C11 8.62132 11 9.68198 10.341 10.341C9.68198 11 8.62132 11 6.5 11C4.37868 11 3.31802 11 2.65901 10.341C2 9.68198 2 8.62132 2 6.5Z" stroke="currentColor" stroke-width="1.5"/><path d="M13 6.5C13 4.37868 13 3.31802 13.659 2.65901C14.318 2 15.3787 2 17.5 2C19.6213 2 20.682 2 21.341 2.65901C22 3.31802 22 4.37868 22 6.5C22 8.62132 22 9.68198 21.341 10.341C20.682 11 19.6213 11 17.5 11C15.3787 11 14.318 11 13.659 10.341C13 9.68198 13 8.62132 13 6.5Z" stroke="currentColor" stroke-width="1.5"/><path d="M2 17.5C2 15.3787 2 14.318 2.65901 13.659C3.31802 13 4.37868 13 6.5 13C8.62132 13 9.68198 13 10.341 13.659C11 14.318 11 15.3787 11 17.5C11 19.6213 11 20.682 10.341 21.341C9.68198 22 8.62132 22 6.5 22C4.37868 22 3.31802 22 2.65901 21.341C2 20.682 2 19.6213 2 17.5Z" stroke="currentColor" stroke-width="1.5"/><path d="M13 17.5C13 15.3787 13 14.318 13.659 13.659C14.318 13 15.3787 13 17.5 13C19.6213 13 20.682 13 21.341 13.659C22 14.318 22 15.3787 22 17.5C22 19.6213 22 20.682 21.341 21.341C20.682 22 19.6213 22 17.5 22C15.3787 22 14.318 22 13.659 21.341C13 20.682 13 19.6213 13 17.5Z" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
            <button @click="viewMode = 'list'" class="p-2 rounded-md" :class="viewMode === 'list' ? 'bg-primary text-white' : 'bg-white-light/40 dark:bg-dark/40'">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M21 6H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M21 12H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M21 18H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="5" cy="6" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="5" cy="18" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Grid View -->
      <template x-if="viewMode === 'grid'">
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-3">
          <template x-for="doc in filteredDocuments()" :key="doc._id">
            <a :href="'/account/<%= account_number %>/documents/' + doc._id + '/edit-react'" class="panel p-4 hover:shadow-lg transition-all group relative">
              <div class="flex items-start justify-between mb-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M8 12H16M8 8H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </div>
                <span class="badge text-xs" :class="{'badge-outline-warning': doc.status === 'draft', 'badge-outline-success': doc.status === 'published', 'badge-outline-secondary': doc.status === 'archived'}" x-text="doc.status === 'draft' ? 'Brouillon' : doc.status === 'published' ? 'Publié' : 'Archivé'"></span>
              </div>
              <h4 class="font-semibold dark:text-white-light mb-1 truncate" x-text="doc.name"></h4>
              <p class="text-xs text-[#888ea8]" x-text="formatDate(doc.updatedAt)"></p>
              <!-- Collaborators with hover -->
              <div class="absolute bottom-3 right-3 flex"
                   x-data="{ 
                     count: (filteredDocuments().indexOf(doc) % 3) + 1,
                     names: ['Marie L.', 'Jean D.', 'Sophie M.', 'Pierre B.', 'Emma R.'],
                     groupHover: false,
                     activeAvatar: null
                   }"
                   @mouseenter="groupHover = true"
                   @mouseleave="groupHover = false; activeAvatar = null"
                   :class="groupHover ? 'gap-1' : '-space-x-2'">
                <template x-for="i in count" :key="i">
                  <div class="relative" @mouseenter="activeAvatar = i" @mouseleave="activeAvatar = null">
                    <img :src="'/assets/images/profile-' + (((filteredDocuments().indexOf(doc) * 3 + i) % 35) + 1) + '.jpeg'" 
                         class="w-6 h-6 rounded-full object-cover border-2 border-white dark:border-[#1b2e4b] transition-transform duration-200 cursor-pointer"
                         :style="groupHover ? 'transform: scale(1.2); z-index: ' + (50 + i) : ''"
                         alt="Collaborateur"/>
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1 px-2 py-0.5 bg-dark text-white text-[9px] rounded whitespace-nowrap pointer-events-none transition-opacity duration-150"
                         :class="activeAvatar === i ? 'opacity-100' : 'opacity-0'"
                         style="z-index: 60;"
                         x-text="names[(filteredDocuments().indexOf(doc) + i) % 5]">
                    </div>
                  </div>
                </template>
              </div>
            </a>
          </template>
        </div>
      </template>

      <!-- List View -->
      <template x-if="viewMode === 'list'">
        <div class="panel">
          <table class="w-full">
            <thead>
              <tr class="border-b border-[#e0e6ed] dark:border-[#1b2e4b]">
                <th class="p-4 text-left font-semibold dark:text-white-light">Nom</th>
                <th class="p-4 text-left font-semibold dark:text-white-light hidden md:table-cell">Statut</th>
                <th class="p-4 text-left font-semibold dark:text-white-light hidden lg:table-cell">Format</th>
                <th class="p-4 text-left font-semibold dark:text-white-light hidden sm:table-cell">Modifié</th>
                <th class="p-4 text-right font-semibold dark:text-white-light">Actions</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="doc in filteredDocuments()" :key="doc._id">
                <tr class="border-b border-[#e0e6ed] dark:border-[#1b2e4b] hover:bg-[#f8f9fa] dark:hover:bg-[#1b2e4b]/50">
                  <td class="p-4">
                    <a :href="'/account/<%= account_number %>/documents/' + doc._id + '/edit-react'" class="flex items-center gap-3 hover:text-primary">
                      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary flex-shrink-0">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M8 12H16M8 8H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      </div>
                      <span class="font-semibold dark:text-white-light truncate" x-text="doc.name"></span>
                    </a>
                  </td>
                  <td class="p-4 hidden md:table-cell">
                    <span class="badge text-xs" :class="{'badge-outline-warning': doc.status === 'draft', 'badge-outline-success': doc.status === 'published', 'badge-outline-secondary': doc.status === 'archived'}" x-text="doc.status === 'draft' ? 'Brouillon' : doc.status === 'published' ? 'Publié' : 'Archivé'"></span>
                  </td>
                  <td class="p-4 text-[#888ea8] text-sm hidden lg:table-cell" x-text="doc.format || 'A4'"></td>
                  <td class="p-4 text-[#888ea8] text-sm hidden sm:table-cell" x-text="formatDate(doc.updatedAt)"></td>
                  <td class="p-4 text-right">
                    <a :href="'/account/<%= account_number %>/documents/' + doc._id + '/edit-react'" class="btn btn-sm btn-outline-primary">Modifier</a>
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </template>
    </div>
  </template>

  <!-- ============================================ -->
  <!-- LAYOUT 2: NOTES STYLE -->
  <!-- ============================================ -->
  <template x-if="layoutMode === 'notes'">
    <div class="relative flex h-full gap-5 sm:h-[calc(100vh_-_150px)]">
      <!-- Overlay for mobile -->
      <div
        class="absolute z-10 hidden h-full w-full rounded-md bg-black/60"
        :class="{ '!block xl:!hidden': isShowDocMenu }"
        @click="isShowDocMenu = !isShowDocMenu"
      ></div>
      
      <!-- Left Sidebar -->
      <div
        class="panel absolute z-10 hidden h-full w-[240px] flex-none space-y-4 overflow-hidden p-4 ltr:rounded-r-none rtl:rounded-l-none ltr:lg:rounded-r-md rtl:lg:rounded-l-md xl:relative xl:block xl:h-auto"
        :class="{ 'hidden shadow': !isShowDocMenu, 'h-full ltr:left-0 rtl:right-0': isShowDocMenu }"
      >
        <div class="flex h-full flex-col pb-16">
          <div class="flex items-center text-center">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
              <path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/>
              <path opacity="0.5" d="M8 12H16M8 8H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <h3 class="text-lg font-semibold ltr:ml-3 rtl:mr-3">Documents</h3>
          </div>
          
          <div class="my-4 h-px w-full border-b border-[#e0e6ed] dark:border-[#1b2e4b]"></div>
          
          <div class="perfect-scrollbar relative -mr-3.5 h-full grow pr-3.5">
            <div class="space-y-1">
              <button type="button" class="flex h-10 w-full items-center justify-between rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32]" :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': selectedTab === 'all' }" @click="tabChanged('all')">
                <div class="flex items-center">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M8 12H16M8 8H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  <div class="ltr:ml-3 rtl:mr-3">Tous</div>
                </div>
                <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary" x-text="documents.length"></span>
              </button>
              
              <button type="button" class="flex h-10 w-full items-center justify-between rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32]" :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': selectedTab === 'fav' }" @click="tabChanged('fav')">
                <div class="flex items-center">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M9.15316 5.40838C10.4198 3.13613 11.0531 2 12 2C12.9469 2 13.5802 3.13612 14.8468 5.40837L15.1745 5.99623C15.5345 6.64193 15.7144 6.96479 15.9951 7.17781C16.2757 7.39083 16.6251 7.4699 17.3241 7.62805L17.9605 7.77203C20.4201 8.32856 21.65 8.60682 21.9426 9.54773C22.2352 10.4886 21.3968 11.4691 19.7199 13.4299L19.2861 13.9372C18.8096 14.4944 18.5713 14.773 18.4641 15.1177C18.357 15.4624 18.393 15.8341 18.465 16.5776L18.5306 17.2544C18.7841 19.8706 18.9109 21.1787 18.1449 21.7602C17.3788 22.3417 16.2273 21.8115 13.9243 20.7512L13.3285 20.4768C12.6741 20.1755 12.3469 20.0248 12 20.0248C11.6531 20.0248 11.3259 20.1755 10.6715 20.4768L10.0757 20.7512C7.77268 21.8115 6.62118 22.3417 5.85515 21.7602C5.08912 21.1787 5.21588 19.8706 5.4694 17.2544L5.53498 16.5776C5.60703 15.8341 5.64305 15.4624 5.53586 15.1177C5.42868 14.773 5.19043 14.4944 4.71392 13.9372L4.2801 13.4299C2.60325 11.4691 1.76482 10.4886 2.05742 9.54773C2.35002 8.60682 3.57986 8.32856 6.03954 7.77203L6.67589 7.62805C7.37485 7.4699 7.72433 7.39083 8.00494 7.17781C8.28555 6.96479 8.46553 6.64194 8.82547 5.99623L9.15316 5.40838Z" stroke="currentColor" stroke-width="1.5"/></svg>
                  <div class="ltr:ml-3 rtl:mr-3">Favoris</div>
                </div>
              </button>
              
              <div class="h-px w-full border-b border-[#e0e6ed] dark:border-[#1b2e4b]"></div>
              <div class="px-1 py-3 text-white-dark">Statut</div>
              
              <button type="button" class="flex h-10 w-full items-center rounded-md p-1 font-medium text-warning duration-300 hover:bg-white-dark/10 ltr:hover:pl-3 rtl:hover:pr-3 dark:hover:bg-[#181F32]" :class="{ 'ltr:pl-3 rtl:pr-3 bg-gray-100 dark:bg-[#181F32]': selectedTab === 'draft' }" @click="tabChanged('draft')">
                <svg class="h-3 w-3 rotate-45 fill-warning" viewBox="0 0 24 24"><path d="M2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12Z" stroke="currentColor" stroke-width="1.5"/></svg>
                <div class="ltr:ml-3 rtl:mr-3">Brouillons</div>
              </button>
              
              <button type="button" class="flex h-10 w-full items-center rounded-md p-1 font-medium text-success duration-300 hover:bg-white-dark/10 ltr:hover:pl-3 rtl:hover:pr-3 dark:hover:bg-[#181F32]" :class="{ 'ltr:pl-3 rtl:pr-3 bg-gray-100 dark:bg-[#181F32]': selectedTab === 'published' }" @click="tabChanged('published')">
                <svg class="h-3 w-3 rotate-45 fill-success" viewBox="0 0 24 24"><path d="M2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12Z" stroke="currentColor" stroke-width="1.5"/></svg>
                <div class="ltr:ml-3 rtl:mr-3">Publiés</div>
              </button>
              
              <button type="button" class="flex h-10 w-full items-center rounded-md p-1 font-medium text-secondary duration-300 hover:bg-white-dark/10 ltr:hover:pl-3 rtl:hover:pr-3 dark:hover:bg-[#181F32]" :class="{ 'ltr:pl-3 rtl:pr-3 bg-gray-100 dark:bg-[#181F32]': selectedTab === 'archived' }" @click="tabChanged('archived')">
                <svg class="h-3 w-3 rotate-45 fill-secondary" viewBox="0 0 24 24"><path d="M2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12Z" stroke="currentColor" stroke-width="1.5"/></svg>
                <div class="ltr:ml-3 rtl:mr-3">Archivés</div>
              </button>
            </div>
          </div>
        </div>
        
        <div class="absolute bottom-0 w-full p-4 ltr:left-0 rtl:right-0">
          <a href="/account/<%= account_number %>/documents/new" class="btn btn-primary w-full">
            <svg class="h-5 w-5 ltr:mr-2 rtl:ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Nouveau Document
          </a>
        </div>
      </div>

      <!-- Main Content Panel -->
      <div class="panel h-full flex-1 overflow-auto">
        <div class="pb-5">
          <button type="button" class="hover:text-primary xl:hidden" @click="isShowDocMenu = !isShowDocMenu">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="M20 7L4 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><path opacity="0.5" d="M20 12L4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><path d="M20 17L4 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
          </button>
        </div>

        <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
          <div class="relative w-full max-w-xs">
            <input type="text" x-model="searchQuery" placeholder="Rechercher..." class="form-input w-full pl-10 dark:bg-[#1b2e4b] dark:border-[#1b2e4b]"/>
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-[#888ea8]" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5" opacity="0.5"></circle><path d="M20 20L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
        </div>

        <template x-if="!filteredDocuments().length">
          <div class="flex h-full min-h-[400px] items-center justify-center text-lg font-semibold">Aucun document trouvé</div>
        </template>

        <template x-if="filteredDocuments().length > 0">
          <div class="min-h-[400px]">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
              <template x-for="doc in filteredDocuments()" :key="doc._id">
                <div class="panel pb-12 relative cursor-pointer hover:shadow-lg transition-shadow"
                     :class="{'bg-warning-light shadow-warning': doc.status === 'draft', 'bg-success-light shadow-success': doc.status === 'published', 'bg-secondary-light shadow-secondary': doc.status === 'archived', 'dark:shadow-dark': !doc.status}"
                     @click="window.location.href = '/account/<%= account_number %>/documents/' + doc._id + '/edit-react'">
                  <div class="min-h-[142px]">
                    <div class="flex justify-between">
                      <div class="flex w-max items-center">
                        <div class="flex-none">
                          <div class="flex -space-x-2" x-data="{ count: (filteredDocuments().indexOf(doc) % 3) + 1, names: ['Marie L.', 'Jean D.', 'Sophie M.', 'Pierre B.', 'Emma R.'], groupHover: false, activeAvatar: null }" @mouseenter="groupHover = true" @mouseleave="groupHover = false; activeAvatar = null" :class="groupHover ? 'gap-1' : '-space-x-2'">
                            <template x-for="i in count" :key="i">
                              <div class="relative" @mouseenter="activeAvatar = i" @mouseleave="activeAvatar = null">
                                <img :src="'/assets/images/profile-' + (((filteredDocuments().indexOf(doc) * 3 + i) % 35) + 1) + '.jpeg'" class="h-8 w-8 rounded-full object-cover border-2 border-white dark:border-[#1b2e4b] transition-transform" :style="groupHover ? 'transform: scale(1.1)' : ''" alt="Collaborateur"/>
                                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1 px-2 py-0.5 bg-dark text-white text-[9px] rounded whitespace-nowrap pointer-events-none transition-opacity" :class="activeAvatar === i ? 'opacity-100' : 'opacity-0'" style="z-index: 60;" x-text="names[(filteredDocuments().indexOf(doc) + i) % 5]"></div>
                              </div>
                            </template>
                          </div>
                        </div>
                        <div class="ltr:ml-2 rtl:mr-2">
                          <div class="font-semibold" x-text="doc.createdBy || 'Utilisateur'"></div>
                          <div class="text-xs text-white-dark" x-text="formatDate(doc.updatedAt)"></div>
                        </div>
                      </div>
                    </div>
                    <div>
                      <h4 class="mt-4 font-semibold" x-text="doc.name"></h4>
                      <p class="mt-2 text-white-dark text-sm line-clamp-2" x-text="doc.description || 'Aucune description'"></p>
                    </div>
                  </div>
                  <div class="absolute bottom-5 left-0 w-full px-5">
                    <div class="mt-2 flex items-center justify-between">
                      <svg class="h-3 w-3 rotate-45" viewBox="0 0 24 24" :class="{'fill-warning text-warning': doc.status === 'draft', 'fill-success text-success': doc.status === 'published', 'fill-secondary text-secondary': doc.status === 'archived'}"><path d="M2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12Z" stroke="currentColor" stroke-width="1.5"/></svg>
                      <div class="flex items-center">
                        <button type="button" class="group text-warning" @click.stop="toggleFav(doc)">
                          <svg class="h-4.5 w-4.5 group-hover:fill-warning" :class="{ 'fill-warning': doc.isFav }" viewBox="0 0 24 24" fill="none"><path d="M9.15316 5.40838C10.4198 3.13613 11.0531 2 12 2C12.9469 2 13.5802 3.13612 14.8468 5.40837L15.1745 5.99623C15.5345 6.64193 15.7144 6.96479 15.9951 7.17781C16.2757 7.39083 16.6251 7.4699 17.3241 7.62805L17.9605 7.77203C20.4201 8.32856 21.65 8.60682 21.9426 9.54773C22.2352 10.4886 21.3968 11.4691 19.7199 13.4299L19.2861 13.9372C18.8096 14.4944 18.5713 14.773 18.4641 15.1177C18.357 15.4624 18.393 15.8341 18.465 16.5776L18.5306 17.2544C18.7841 19.8706 18.9109 21.1787 18.1449 21.7602C17.3788 22.3417 16.2273 21.8115 13.9243 20.7512L13.3285 20.4768C12.6741 20.1755 12.3469 20.0248 12 20.0248C11.6531 20.0248 11.3259 20.1755 10.6715 20.4768L10.0757 20.7512C7.77268 21.8115 6.62118 22.3417 5.85515 21.7602C5.08912 21.1787 5.21588 19.8706 5.4694 17.2544L5.53498 16.5776C5.60703 15.8341 5.64305 15.4624 5.53586 15.1177C5.42868 14.773 5.19043 14.4944 4.71392 13.9372L4.2801 13.4299C2.60325 11.4691 1.76482 10.4886 2.05742 9.54773C2.35002 8.60682 3.57986 8.32856 6.03954 7.77203L6.67589 7.62805C7.37485 7.4699 7.72433 7.39083 8.00494 7.17781C8.28555 6.96479 8.46553 6.64194 8.82547 5.99623L9.15316 5.40838Z" stroke="currentColor" stroke-width="1.5"/></svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>
    </div>
  </template>
</div>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('documentList', () => ({
    documents: <%- JSON.stringify(documents || []) %>,
    searchQuery: '',
    viewMode: 'grid',
    layoutMode: 'dashboard',
    selectedTab: 'all',
    isShowDocMenu: false,
    
    formatDate(dateString) {
      if (!dateString) return '';
      const date = new Date(dateString);
      return date.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
    },
    
    tabChanged(tab) {
      this.selectedTab = tab;
    },
    
    filteredDocuments() {
      let docs = this.documents;
      
      if (this.selectedTab === 'fav') {
        docs = docs.filter(d => d.isFav);
      } else if (this.selectedTab === 'draft') {
        docs = docs.filter(d => d.status === 'draft');
      } else if (this.selectedTab === 'published') {
        docs = docs.filter(d => d.status === 'published');
      } else if (this.selectedTab === 'archived') {
        docs = docs.filter(d => d.status === 'archived');
      }
      
      if (this.searchQuery) {
        const query = this.searchQuery.toLowerCase();
        docs = docs.filter(d => d.name.toLowerCase().includes(query));
      }
      
      return docs;
    },
    
    toggleFav(doc) {
      doc.isFav = !doc.isFav;
    }
  }));
});
</script>
