        box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.25) !important;
    }
    /* Labels: smaller uppercase style */
    [data-panel-id="attributs"] label {
        text-transform: uppercase;
        font-size: 11px !important;
        letter-spacing: 0.5px;
        color: #6b7280;
        font-weight: 600 !important;
    }
    .dark [data-panel-id="attributs"] label {
        color: #64748b;
    }
</style>

<style>
    /* â•â•â• Record Layout Grid (12-unit, page-builder style) â•â•â• */
    .record-layout-container {
        display: grid;
        gap: 24px;
        align-items: start;
    }
    @media (max-width: 1023px) {
        .record-layout-container { grid-template-columns: 1fr !important; }
        .record-layout-resize-handle { display: none !important; }
        .record-layout-col { grid-column: span 12 !important; }
    }
    .record-layout-col {
        min-width: 0;
        position: relative;
    }
    .record-layout-col--empty {
        min-height: 120px;
        border: 2px dashed #e2e8f0;
        border-radius: 8px;
    }
    .dark .record-layout-col--empty {
        border-color: #334155;
    }
    .extra-col-sortable:empty + * .record-layout-empty-placeholder,
    .record-layout-empty-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px 12px;
        min-height: 120px;
    }

    /* â•â•â• Resize Handle (positioned on right edge of each column) â•â•â• */
    .record-layout-resize-handle {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translate(50%, -50%);
        cursor: col-resize;
        z-index: 50;
        display: flex;
        align-items: center;
        color: #94a3b8;
        opacity: 0;
        transition: opacity 0.15s ease, color 0.15s ease;
        padding: 6px 2px;
        border-radius: 4px;
    }
    .record-layout-col:hover .record-layout-resize-handle,
    .record-layout-resize-handle--active {
        opacity: 1;
    }
    .record-layout-resize-handle:hover,
    .record-layout-resize-handle--active {
        color: #4361ee;
        background: rgba(67, 97, 238, 0.08);
    }
    .dark .record-layout-resize-handle {
        color: #64748b;
    }
    .dark .record-layout-resize-handle:hover,
    .dark .record-layout-resize-handle--active {
        color: #4361ee;
        background: rgba(67, 97, 238, 0.15);
    }


    /* â•â•â• Panel Drag Handle â•â•â• */
    .panel-drag-handle {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        margin-bottom: 4px;
        background: rgba(67, 97, 238, 0.06);
        border: 1px dashed rgba(67, 97, 238, 0.25);
        border-radius: 6px;
        color: #4361ee;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        cursor: grab;
        user-select: none;
        transition: background 0.15s ease, border-color 0.15s ease;
    }
    .panel-drag-handle:hover {
        background: rgba(67, 97, 238, 0.12);
        border-color: rgba(67, 97, 238, 0.4);
    }
    .panel-drag-handle:active { cursor: grabbing; }

    .panel-drop-zone {
        border: 2px dashed rgba(67, 97, 238, 0.15);
        border-radius: 8px;
        padding: 4px;
        transition: border-color 0.2s ease;
    }
    .panel-drop-zone:hover { border-color: rgba(67, 97, 238, 0.3); }

    .panel-sortable-ghost {
        opacity: 0.25;
        border: 2px dashed #4361ee;
        border-radius: 8px;
    }
    .panel-sortable-chosen {
        box-shadow: 0 4px 20px rgba(67, 97, 238, 0.15);
        border-radius: 8px;
    }
    .panel-sortable-drag {
        opacity: 0.9;
        transform: rotate(1deg);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
        border-radius: 8px;
    }

    .dark .panel-drag-handle {
        background: rgba(67, 97, 238, 0.1);
        border-color: rgba(67, 97, 238, 0.3);
    }
    .dark .panel-drop-zone { border-color: rgba(67, 97, 238, 0.2); }
</style>

<!-- DATA PIPELINE -->
<script type="application/json" id="all-templates">
    <%- JSON.stringify(locals.allFieldTemplates || []).replace(/</g, '\\u003C') %>
</script>
<script type="application/json" id="initial-fields">
    <%- JSON.stringify(locals.fields || []).replace(/</g, '\\u003C') %>
</script>
<script type="application/json" id="record-values">
    <%- JSON.stringify([...(record.customFields || []), ...((record.relations || []).map(r => ({ field_id: r.relationKey, value: r.value })))]).replace(/</g, '\\u003C') %>
</script>
<script type="application/json" id="entity-relations">
    <%- JSON.stringify((entity.relations || []).map(r => ({
        _id: r.key,
        type: 'relation',
        label: r.label || 'Relation',
        name: r.label || 'Relation',
        type_config: {
            refEntity: (r.targetEntity && r.targetEntity._id ? r.targetEntity._id.toString() : (r.targetEntity || '')),
            multiple: (r.cardinality === 'one-to-many' || r.cardinality === 'many-to-many')
        },
        ui: {
            placeholder: 'Rechercher ' + ((r.targetEntity && r.targetEntity.name) || '') + '...'
        }
    }))).replace(/</g, '\\u003C') %>
</script>

<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• HEADER CONFIG PANEL (teleported to body) â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div x-data="headerConfigPanel()" @open-header-config.window="showHeaderConfig = true"
     x-effect="document.body.style.overflow = showHeaderConfig ? 'hidden' : ''">
    <template x-teleport="body">
    <div x-show="showHeaderConfig" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
         style="position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)" class="flex items-center justify-center" @click.self="showHeaderConfig = false" x-cloak>
        <div style="max-height:80vh" class="bg-white dark:bg-[#1b2e4b] rounded-2xl shadow-2xl border border-gray-100 dark:border-gray-700 w-[380px] flex flex-col"
             x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95 translate-y-2" x-transition:enter-end="opacity-100 scale-100 translate-y-0"
             x-data="{ hcAcc: { icon: false, title: false, cls: false, attach: false, rels: false, fields: true, dur: false } }">
            <!-- Panel Header (fixed) -->
            <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100 dark:border-gray-800 bg-white dark:bg-[#1b2e4b] rounded-t-2xl flex-shrink-0">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-purple-50 dark:bg-purple-500/10 flex items-center justify-center">
                        <iconify-icon icon="solar:widget-6-bold-duotone" width="18" class="text-purple-500"></iconify-icon>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-gray-800 dark:text-white">Configurer l'en-tÃªte</h3>
                        <p class="text-[10px] text-gray-400">Personnalisez l'affichage du header de fiche</p>
                    </div>
                </div>
                <button type="button" @click="showHeaderConfig = false" class="w-7 h-7 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center justify-center text-gray-400 hover:text-gray-600 transition-colors">
                    <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
                </button>
            </div>

            <!-- Panel Body (scrollable) -->
            <div class="hc-body" style="overflow-y:auto;flex:1;min-height:0;overscroll-behavior:contain">

                <!-- â‘  ICÃ”NE / AVATAR -->
                <div class="hc-section">
                    <div class="hc-section-header" @click="hcAcc.icon = !hcAcc.icon" style="cursor:pointer">
                        <div class="hc-section-left">
                            <div class="hc-section-icon" style="background:#ede9fe"><iconify-icon icon="solar:user-circle-bold-duotone" width="14" style="color:#8b5cf6"></iconify-icon></div>
                            <span class="hc-section-title">IcÃ´ne</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="hc-toggle-track" @click.stop="hcLocal.showIcon = !(hcLocal.showIcon !== false)"
                                 :style="(hcLocal.showIcon !== false) ? 'background:#8b5cf6' : 'background:#d1d5db'">
                                <span class="hc-toggle-handle" :style="(hcLocal.showIcon !== false) ? 'left:18px' : 'left:2px'"></span>
                            </div>
                            <iconify-icon icon="solar:alt-arrow-down-linear" width="14" class="text-gray-400 transition-transform duration-200" :style="hcAcc.icon ? 'transform:rotate(180deg)' : ''"></iconify-icon>
                        </div>
                    </div>
                    <div x-show="hcAcc.icon && hcLocal.showIcon !== false" x-collapse>
                        <div class="hc-section-content">
                            <select class="hc-select" @change="
                                const val = $event.target.value;
                                if (val === 'entity-icon') hcLocal.avatarSource = { type: 'entity-icon' };
                                else if (val === 'record-image') hcLocal.avatarSource = { type: 'record-image' };
                                else hcLocal.avatarSource = { type: 'relation-image', relationKey: val };
                            " :value="hcLocal.avatarSource?.type === 'relation-image' ? (hcLocal.avatarSource.relationKey || '') : (hcLocal.avatarSource?.type || 'entity-icon')">
                                <option value="entity-icon">IcÃ´ne de l'entitÃ© (<%= entity.name %>)</option>
                                <option value="record-image">Image de la fiche</option>
                                <% (entity.relations || []).forEach(r => { %>
                                <option value="<%= r.key %>"><%= r.label || (r.targetEntity && r.targetEntity.name) || 'Relation' %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- â‘¡ TITRE PRINCIPAL -->
                <div class="hc-section">
                    <div class="hc-section-header" @click="hcAcc.title = !hcAcc.title" style="cursor:pointer">
                        <div class="hc-section-left">
                            <div class="hc-section-icon" style="background:#dbeafe"><iconify-icon icon="solar:text-bold-duotone" width="14" style="color:#3b82f6"></iconify-icon></div>
                            <span class="hc-section-title">Titre</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="hc-toggle-track" @click.stop="hcLocal.showTitle = !(hcLocal.showTitle !== false)"
                                 :style="(hcLocal.showTitle !== false) ? 'background:#8b5cf6' : 'background:#d1d5db'">
                                <span class="hc-toggle-handle" :style="(hcLocal.showTitle !== false) ? 'left:18px' : 'left:2px'"></span>
                            </div>
                            <iconify-icon icon="solar:alt-arrow-down-linear" width="14" class="text-gray-400 transition-transform duration-200" :style="hcAcc.title ? 'transform:rotate(180deg)' : ''"></iconify-icon>
                        </div>
                    </div>
                    <div x-show="hcAcc.title && hcLocal.showTitle !== false" x-collapse>
                        <div class="hc-section-content">
                            <select class="hc-select" @change="
                                const val = $event.target.value;
                                if (val === 'entity') { hcLocal.titleSource = { type: 'entity' }; hcLocal.subtitleRelation = null; }
                                else { hcLocal.titleSource = { type: 'relation', relationKey: val }; hcLocal.subtitleRelation = { relationKey: val, displayFields: ['title'] }; }
                            " :value="hcLocal.titleSource?.type === 'relation' ? (hcLocal.titleSource.relationKey || '') : 'entity'">
                                <option value="entity">Titre de la fiche (<%= entity.name %>)</option>
                                <% (entity.relations || []).forEach(r => { %>
                                <option value="<%= r.key %>"><%= r.label || (r.targetEntity && r.targetEntity.name) || 'Relation' %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- â‘¢ CLASSIFICATIONS -->
                <% if (entity.classifications && entity.classifications.length > 0) { %>
                <div class="hc-section">
                    <div class="hc-section-header" @click="hcAcc.cls = !hcAcc.cls" style="cursor:pointer">
                        <div class="hc-section-left">
                            <div class="hc-section-icon" style="background:#fef3c7"><iconify-icon icon="solar:tag-bold-duotone" width="14" style="color:#f59e0b"></iconify-icon></div>
                            <span class="hc-section-title">Classifications</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="hc-toggle-track" @click.stop="hcLocal.showClassifications = !(hcLocal.showClassifications !== false)"
                                 :style="(hcLocal.showClassifications !== false) ? 'background:#8b5cf6' : 'background:#d1d5db'">
                                <span class="hc-toggle-handle" :style="(hcLocal.showClassifications !== false) ? 'left:18px' : 'left:2px'"></span>
                            </div>
                            <iconify-icon icon="solar:alt-arrow-down-linear" width="14" class="text-gray-400 transition-transform duration-200" :style="hcAcc.cls ? 'transform:rotate(180deg)' : ''"></iconify-icon>
                        </div>
                    </div>
                    <div x-show="hcAcc.cls && hcLocal.showClassifications !== false" x-collapse>
                        <div class="hc-section-content">
                            <% (entity.classifications || []).forEach(cls => { %>
                            <div class="hc-switch-row" @click="
                                if (!hcLocal.shownClassifications) hcLocal.shownClassifications = [];
                                const idx = hcLocal.shownClassifications.indexOf('<%= cls._id %>');
                                if (idx > -1) hcLocal.shownClassifications.splice(idx, 1);
                                else hcLocal.shownClassifications.push('<%= cls._id %>');
                            ">
                                <span class="hc-cls-dot" style="background:<%= (cls.options && cls.options[0] && cls.options[0].color) || '#4361ee' %>"></span>
                                <span class="hc-switch-label"><%= cls.name || cls.label || 'Classification' %></span>
                                <div class="hc-toggle-mini" :style="(!hcLocal.shownClassifications || hcLocal.shownClassifications.length === 0 || hcLocal.shownClassifications.includes('<%= cls._id %>')) ? 'background:#8b5cf6' : 'background:#d1d5db'">
                                    <span class="hc-toggle-mini-handle" :style="(!hcLocal.shownClassifications || hcLocal.shownClassifications.length === 0 || hcLocal.shownClassifications.includes('<%= cls._id %>')) ? 'left:14px' : 'left:2px'"></span>
                                </div>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- â‘¢b PIÃˆCES JOINTES -->
                <div class="hc-section">
                    <div class="hc-section-header">
                        <div class="hc-section-left">
                            <div class="hc-section-icon" style="background:#fef3c7"><iconify-icon icon="solar:paperclip-bold-duotone" width="14" style="color:#f59e0b"></iconify-icon></div>
                            <span class="hc-section-title">Pièces jointes</span>
                        </div>
                        <div class="hc-toggle-track" @click="hcLocal.showAttachments = !(hcLocal.showAttachments !== false)"
                             :style="(hcLocal.showAttachments !== false) ? 'background:#8b5cf6' : 'background:#d1d5db'">
                            <span class="hc-toggle-handle" :style="(hcLocal.showAttachments !== false) ? 'left:18px' : 'left:2px'"></span>
                        </div>
                    </div>
                </div>

                <!-- â‘¢c RELATIONS (indirectes + inversÃ©es) -->
                <% 
                    const _hasIndirectRels = locals.headerRelatedMeta && locals.headerRelatedMeta.indirectRelations && locals.headerRelatedMeta.indirectRelations.length > 0;
                    const _invRelsForModal = (locals.relationTabsMeta || []).filter(r => r.direction === 'inverse');
                    const _hasInverseRels = _invRelsForModal.length > 0;
                    const _directRelsForModal = (entity.relations || []).map(r => {
                        const tgt = r.targetEntity || {};
                        const tab = (locals.relationTabsMeta || []).find(t => t.key === r.key);
                        return { key: r.key, label: r.label || tgt.name || 'Relation', icon: tgt.icon || 'solar:link-round-bold-duotone', color: tgt.color || '#4361ee', count: tab ? tab.count : 0 };
                    });
                    const _hasDirectRels = _directRelsForModal.length > 0;
                %>
                <% if (_hasIndirectRels || _hasInverseRels || _hasDirectRels) { %>
                <div class="hc-section" x-data="{ relAccDirect: false, relAccIndirect: false, relAccInverse: false }">
                    <div class="hc-section-header" @click="hcAcc.rels = !hcAcc.rels" style="cursor:pointer">
                        <div class="hc-section-left">
                            <div class="hc-section-icon" style="background:#e0e7ff"><iconify-icon icon="solar:link-round-bold-duotone" width="14" style="color:#6366f1"></iconify-icon></div>
                            <span class="hc-section-title">Relations</span>
                        </div>
                        <iconify-icon icon="solar:alt-arrow-down-linear" width="14" class="text-gray-400 transition-transform duration-200" :style="hcAcc.rels ? 'transform:rotate(180deg)' : ''"></iconify-icon>
                    </div>
                    <div x-show="hcAcc.rels" x-collapse>
                        <div class="hc-section-content">

                            <% if (_hasDirectRels) { %>
                            <!-- Direct relations (current entity) -->
                            <div class="hc-field-group-label" @click="relAccDirect = !relAccDirect" style="cursor:pointer">
                                <iconify-icon icon="<%= entity.icon || 'solar:star-bold-duotone' %>" width="12" style="color:<%= entity.color || '#4361ee' %>"></iconify-icon>
                                <span style="flex:1"><%= entity.name %></span>
                                <iconify-icon icon="solar:alt-arrow-down-linear" width="11" class="text-gray-400 transition-transform duration-200" :style="relAccDirect ? 'transform:rotate(180deg)' : ''"></iconify-icon>
                            </div>
                            <div x-show="relAccDirect" x-collapse>
                                <% _directRelsForModal.forEach(dRel => { %>
                                <div class="hc-switch-row" @click="
                                    if (!hcLocal.shownRelations) hcLocal.shownRelations = [];
                                    const idx = hcLocal.shownRelations.indexOf('<%= dRel.key %>');
                                    if (idx > -1) hcLocal.shownRelations.splice(idx, 1);
                                    else hcLocal.shownRelations.push('<%= dRel.key %>');
                                ">
                                    <iconify-icon icon="<%= dRel.icon %>" width="14" style="color:<%= dRel.color %>"></iconify-icon>
                                    <span class="hc-switch-label"><%= dRel.label %></span>
                                    <span class="hc-switch-count"><%= dRel.count %></span>
                                    <div class="hc-toggle-mini" :style="(hcLocal.shownRelations || []).includes('<%= dRel.key %>') ? 'background:#8b5cf6' : 'background:#d1d5db'">
                                        <span class="hc-toggle-mini-handle" :style="(hcLocal.shownRelations || []).includes('<%= dRel.key %>') ? 'left:14px' : 'left:2px'"></span>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                            <% } %>

                            <% if (_hasInverseRels) { %>
                            <!-- Inverse relations (entities pointing to current entity) -->
                            <div class="hc-field-group-label" @click="relAccInverse = !relAccInverse" style="cursor:pointer;margin-top:8px">
                                <iconify-icon icon="solar:rewind-back-bold-duotone" width="12" style="color:#f59e0b"></iconify-icon>
                                <span style="flex:1">Relations inversÃ©es</span>
                                <iconify-icon icon="solar:alt-arrow-down-linear" width="11" class="text-gray-400 transition-transform duration-200" :style="relAccInverse ? 'transform:rotate(180deg)' : ''"></iconify-icon>
                            </div>
                            <div x-show="relAccInverse" x-collapse>
                                <% _invRelsForModal.forEach(invR => { %>
                                <div class="hc-switch-row" @click="
                                    if (!hcLocal.shownRelations) hcLocal.shownRelations = [];
                                    const idx = hcLocal.shownRelations.indexOf('<%= invR.key %>');
                                    if (idx > -1) hcLocal.shownRelations.splice(idx, 1);
                                    else hcLocal.shownRelations.push('<%= invR.key %>');
                                ">
                                    <iconify-icon icon="<%= invR.icon %>" width="14" style="color:<%= invR.color %>"></iconify-icon>
                                    <span class="hc-switch-label"><%= invR.label %></span>
                                    <span class="hc-switch-count"><%= invR.count %></span>
                                    <div class="hc-toggle-mini" :style="(hcLocal.shownRelations || []).includes('<%= invR.key %>') ? 'background:#8b5cf6' : 'background:#d1d5db'">
                                        <span class="hc-toggle-mini-handle" :style="(hcLocal.shownRelations || []).includes('<%= invR.key %>') ? 'left:14px' : 'left:2px'"></span>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                            <% } %>

                            <% if (_hasIndirectRels) { %>
                            <!-- Indirect relations (via related entity e.g. Patient) -->
                            <div class="hc-field-group-label" @click="relAccIndirect = !relAccIndirect" style="cursor:pointer;margin-top:8px">
                                <iconify-icon icon="<%= (locals.headerRelatedMeta && locals.headerRelatedMeta.relatedEntityIcon) || 'solar:user-bold-duotone' %>" width="12" style="color:<%= (locals.headerRelatedMeta && locals.headerRelatedMeta.relatedEntityColor) || '#4361ee' %>"></iconify-icon>
                                <span style="flex:1">Via <%= (locals.headerRelatedMeta && locals.headerRelatedMeta.relatedEntityName) || 'Relation' %></span>
                                <iconify-icon icon="solar:alt-arrow-down-linear" width="11" class="text-gray-400 transition-transform duration-200" :style="relAccIndirect ? 'transform:rotate(180deg)' : ''"></iconify-icon>
                            </div>
                            <div x-show="relAccIndirect" x-collapse>
                                <% (locals.headerRelatedMeta.indirectRelations || []).forEach(iRel => { %>
                                <div class="hc-switch-row" @click="
                                    if (!hcLocal.shownRelations) hcLocal.shownRelations = [];
                                    const idx = hcLocal.shownRelations.indexOf('<%= iRel.key %>');
                                    if (idx > -1) hcLocal.shownRelations.splice(idx, 1);
                                    else hcLocal.shownRelations.push('<%= iRel.key %>');
                                ">
                                    <iconify-icon icon="<%= iRel.icon %>" width="14" style="color:<%= iRel.color %>"></iconify-icon>
                                    <span class="hc-switch-label"><%= iRel.label %></span>
                                    <span class="hc-switch-count"><%= iRel.count %></span>
                                    <div class="hc-toggle-mini" :style="(hcLocal.shownRelations || []).includes('<%= iRel.key %>') ? 'background:#8b5cf6' : 'background:#d1d5db'">
                                        <span class="hc-toggle-mini-handle" :style="(hcLocal.shownRelations || []).includes('<%= iRel.key %>') ? 'left:14px' : 'left:2px'"></span>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                            <% } %>

                        </div>
                    </div>
                </div>
                <% } %>

                <!-- â‘£ CHAMPS (groupÃ©s par entitÃ©, accordÃ©on par groupe) -->
                <div class="hc-section" x-data="{ fieldAccSelf: false, fieldAccRel: false }">
                    <div class="hc-section-header" @click="hcAcc.fields = !hcAcc.fields" style="cursor:pointer">
                        <div class="hc-section-left">
                            <div class="hc-section-icon" style="background:#e0e7ff"><iconify-icon icon="solar:documents-bold-duotone" width="14" style="color:#6366f1"></iconify-icon></div>
                            <span class="hc-section-title">Champs</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="hc-section-hint" x-text="(hcLocal.heroFields || []).length + '/4'"></span>
                            <iconify-icon icon="solar:alt-arrow-down-linear" width="14" class="text-gray-400 transition-transform duration-200" :style="hcAcc.fields ? 'transform:rotate(180deg)' : ''"></iconify-icon>
                        </div>
                    </div>
                    <div x-show="hcAcc.fields" x-collapse>
                        <div class="hc-section-content">
                            <!-- Current entity fields (accordion) -->
                            <div class="hc-field-group-label" @click="fieldAccSelf = !fieldAccSelf" style="cursor:pointer">
                                <iconify-icon icon="<%= entity.icon || 'solar:star-bold-duotone' %>" width="12" style="color:<%= entity.color || '#4361ee' %>"></iconify-icon>
                                <span style="flex:1"><%= entity.name %></span>
                                <iconify-icon icon="solar:alt-arrow-down-linear" width="11" class="text-gray-400 transition-transform duration-200" :style="fieldAccSelf ? 'transform:rotate(180deg)' : ''"></iconify-icon>
                            </div>
                            <div x-show="fieldAccSelf" x-collapse>
                                <% (entity.customFields || []).filter(f => f != null).slice(0, 10).forEach(f => { %>
                                <div class="hc-switch-row" @click="
                                    if (!hcLocal.heroFields) hcLocal.heroFields = [];
                                    const idx = hcLocal.heroFields.findIndex(h => h.fieldId === '<%= f._id %>' && (h.entitySource || 'self') === 'self');
                                    if (idx > -1) { hcLocal.heroFields.splice(idx, 1); }
                                    else if (hcLocal.heroFields.length < 4) { hcLocal.heroFields.push({ fieldId: '<%= f._id %>', entitySource: 'self', maxChars: 20 }); }
                                ">
                                    <iconify-icon icon="<%= (f.ui && f.ui.icon) || 'solar:document-text-linear' %>" width="13" style="color:#9ca3af"></iconify-icon>
                                    <span class="hc-switch-label"><%= f.label || f.name %></span>
                                    <div class="hc-toggle-mini" :style="(hcLocal.heroFields || []).some(h => h.fieldId === '<%= f._id %>' && (h.entitySource || 'self') === 'self') ? 'background:#8b5cf6' : 'background:#d1d5db'">
                                        <span class="hc-toggle-mini-handle" :style="(hcLocal.heroFields || []).some(h => h.fieldId === '<%= f._id %>' && (h.entitySource || 'self') === 'self') ? 'left:14px' : 'left:2px'"></span>
                                    </div>
                                </div>
                                <% }); %>
                            </div>

                            <!-- Related entity fields (accordion) -->
                            <% if (locals.headerRelatedMeta && locals.headerRelatedMeta.relatedFields && locals.headerRelatedMeta.relatedFields.length > 0) { %>
                            <% const _relKey = (_hc.titleSource && _hc.titleSource.relationKey) || (_hc.subtitleRelation && _hc.subtitleRelation.relationKey) || ''; %>
                            <div class="hc-field-group-label" @click="fieldAccRel = !fieldAccRel" style="cursor:pointer;margin-top:8px">
                                <iconify-icon icon="<%= locals.headerRelatedMeta.relatedEntityIcon || 'solar:user-bold-duotone' %>" width="12" style="color:<%= locals.headerRelatedMeta.relatedEntityColor || '#4361ee' %>"></iconify-icon>
                                <span style="flex:1"><%= locals.headerRelatedMeta.relatedEntityName || 'Relation' %></span>
                                <iconify-icon icon="solar:alt-arrow-down-linear" width="11" class="text-gray-400 transition-transform duration-200" :style="fieldAccRel ? 'transform:rotate(180deg)' : ''"></iconify-icon>
                            </div>
                            <div x-show="fieldAccRel" x-collapse>
                                <% locals.headerRelatedMeta.relatedFields.forEach(rf => { %>
                                <div class="hc-switch-row" @click="
                                    if (!hcLocal.heroFields) hcLocal.heroFields = [];
                                    const idx = hcLocal.heroFields.findIndex(h => h.fieldId === '<%= rf._id %>' && h.entitySource === '<%= _relKey %>');
                                    if (idx > -1) { hcLocal.heroFields.splice(idx, 1); }
                                    else if (hcLocal.heroFields.length < 4) { hcLocal.heroFields.push({ fieldId: '<%= rf._id %>', entitySource: '<%= _relKey %>', maxChars: 20 }); }
                                ">
                                    <iconify-icon icon="<%= rf.icon %>" width="13" style="color:#9ca3af"></iconify-icon>
                                    <span class="hc-switch-label"><%= rf.label %></span>
                                    <div class="hc-toggle-mini" :style="(hcLocal.heroFields || []).some(h => h.fieldId === '<%= rf._id %>' && h.entitySource === '<%= _relKey %>') ? 'background:#8b5cf6' : 'background:#d1d5db'">
                                        <span class="hc-toggle-mini-handle" :style="(hcLocal.heroFields || []).some(h => h.fieldId === '<%= rf._id %>' && h.entitySource === '<%= _relKey %>') ? 'left:14px' : 'left:2px'"></span>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                            <% } %>
