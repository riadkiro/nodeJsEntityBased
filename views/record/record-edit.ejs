<%- include('../components/tag-picker') %>
<div x-data="recordForm()" class="space-y-4">
    <form action="/account/<%= account_number %>/record/<%= entity.slug %>/update/<%= record._id %>" method="POST"
        enctype="multipart/form-data" id="main-record-form">

        <!-- ═══════════════ HORIZONTAL TOOLBAR (Mission 1) ═══════════════ -->
        <div class="flex items-center justify-between px-5 py-2.5 bg-white dark:bg-[#1b2e4b] rounded-xl border border-gray-100 dark:border-gray-800 shadow-sm mb-4"
            x-data="{ showDeleteConfirm: false }">
            <!-- Left: Back + Entity/Title breadcrumb -->
            <div class="flex items-center gap-3 min-w-0">
                <a href="/account/<%= account_number %>/record/<%= entity.slug %>/list"
                    class="flex items-center justify-center w-8 h-8 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-all"
                    title="Retour à la liste">
                    <iconify-icon icon="solar:arrow-left-linear" width="18"></iconify-icon>
                </a>
                <div class="h-5 w-px bg-gray-200 dark:bg-gray-700"></div>
                <div class="flex items-center gap-2 min-w-0">
                    <span class="text-sm text-gray-400 dark:text-gray-500 font-medium whitespace-nowrap"><%= entity.name %></span>
                    <iconify-icon icon="solar:alt-arrow-right-linear" width="14" class="text-gray-300 dark:text-gray-600 flex-none"></iconify-icon>
                    <span class="text-sm font-semibold text-gray-700 dark:text-gray-200 truncate max-w-[300px]"><%= record.title || 'Sans titre' %></span>
                </div>
            </div>

            <!-- Center: Last modified -->
            <div class="hidden md:flex items-center gap-1.5 text-[10px] text-gray-400 dark:text-gray-500">
                <iconify-icon icon="solar:clock-circle-linear" width="12"></iconify-icon>
                <span>Modifié le <strong class="text-gray-500 dark:text-gray-400"><%= record.updatedAt ? new Date(record.updatedAt).toLocaleDateString('fr-FR') : '-' %></strong></span>
            </div>

            <!-- Right: Actions cluster -->
            <div class="flex items-center gap-2">
                <!-- Public toggle -->
                <label class="flex items-center gap-1.5 cursor-pointer px-2.5 py-1.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-all" title="Publier">
                    <input type="hidden" name="standard[published]" value="">
                    <input type="checkbox" name="standard[published]"
                        class="form-checkbox rounded text-success border-gray-300 dark:border-gray-600 focus:ring-0 !w-3.5 !h-3.5"
                        <%= record.published ? 'checked' : '' %>>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Public</span>
                </label>

                <div class="h-5 w-px bg-gray-200 dark:bg-gray-700"></div>

                <!-- Layout mode -->
                <button type="button" @click="designMode = !designMode"
                    :class="designMode ? 'text-primary bg-primary/10' : 'text-gray-400 hover:text-primary hover:bg-gray-50 dark:hover:bg-gray-700/50'"
                    class="flex items-center justify-center w-8 h-8 rounded-lg transition-all" title="Mode Layout">
                    <iconify-icon icon="tabler:layout-dashboard" width="16"></iconify-icon>
                </button>

                <div class="h-5 w-px bg-gray-200 dark:bg-gray-700"></div>

                <!-- Cancel -->
                <a href="/account/<%= account_number %>/record/<%= entity.slug %>/list"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-semibold text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all"
                    title="Annuler">
                    <iconify-icon icon="solar:close-circle-linear" width="14"></iconify-icon>
                    <span class="hidden sm:inline">Annuler</span>
                </a>

                <!-- Save -->
                <button type="submit" form="main-record-form"
                    class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-primary text-white text-[11px] font-bold hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20 transition-all"
                    x-data="{ submitting: false }" @submit.window="submitting = true"
                    :disabled="submitting"
                    :class="submitting ? 'opacity-60 cursor-wait' : ''">
                    <iconify-icon :icon="submitting ? 'line-md:loading-twotone-loop' : 'solar:diskette-bold'" width="14"></iconify-icon>
                    <span x-text="submitting ? 'Envoi...' : 'Enregistrer'">Enregistrer</span>
                </button>

                <!-- Delete -->
                <div class="relative">
                    <button type="button" @click="showDeleteConfirm = !showDeleteConfirm"
                        class="flex items-center justify-center w-8 h-8 rounded-lg text-gray-400 hover:text-danger hover:bg-danger/5 transition-all"
                        title="Supprimer">
                        <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="15"></iconify-icon>
                    </button>
                    <!-- Delete confirm dropdown -->
                    <div x-show="showDeleteConfirm" x-transition @click.outside="showDeleteConfirm = false"
                        class="absolute right-0 top-full mt-2 bg-white dark:bg-[#1b2e4b] rounded-xl shadow-xl border border-gray-100 dark:border-gray-700 p-4 w-[220px] z-50">
                        <p class="text-xs text-gray-600 dark:text-gray-400 mb-3">Supprimer définitivement cet enregistrement ?</p>
                        <div class="flex items-center gap-2">
                            <button type="button" @click="showDeleteConfirm = false"
                                class="flex-1 px-3 py-1.5 text-[10px] font-semibold text-gray-500 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 transition-all">
                                Non
                            </button>
                            <a href="/account/<%= account_number %>/record/<%= entity.slug %>/delete/<%= record._id %>"
                                class="flex-1 px-3 py-1.5 text-[10px] font-bold text-white bg-danger rounded-lg hover:bg-danger/90 text-center transition-all">
                                Supprimer
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="record-layout-container" x-data="panelLayout()" id="panels-container"
            :style="'grid-template-columns: repeat(12, 1fr)'">
            
            <!-- ═══ Main Form Content (Column 0) ═══ -->
            <div class="record-layout-col relative" 
                :style="'grid-column: span ' + columns[0].width"
                id="panels-main-zone">

                <!-- Resize Handle on right edge -->
                <div class="record-layout-resize-handle"
                    @mousedown.prevent="startResize(0, $event)">
                    <iconify-icon icon="solar:alt-arrow-left-bold" width="10"></iconify-icon>
                    <iconify-icon icon="solar:alt-arrow-right-bold" width="10" style="margin-left: -3px;"></iconify-icon>
                </div>

                <div class="space-y-4">
                <div class="panel-sortable-item" data-panel-id="attributs">
                    <template x-if="designMode">
                        <div class="panel-drag-handle">
                            <iconify-icon icon="tabler:grip-horizontal" width="16"></iconify-icon>
                            <span>Attributs</span>
                        </div>
                    </template>
                <div class="panel">
                    <div class="space-y-8">

                    <% if (locals.entityFormLayout && locals.entityFormLayout.rows) { %>
                        <!-- ========== ENTITY FORM LAYOUT (Row/Column Grid) ========== -->
                        <div>
                            <div class="space-y-4">
                                <% entityFormLayout.rows.forEach(function(row, rowIndex) { %>
                                    <div class="flex flex-wrap -mx-2">
                                        <% row.columns.forEach(function(col, colIndex) { %>
                                            <div class="px-2 mb-3" style="width: <%= (col.width / 12 * 100).toFixed(4) %>%">
                                                <% (col.fields || []).forEach(function(field) { %>
                                                    <% if (field.type === 'standard') { %>
                                                        <% var def = locals.entityFormFieldDefs && locals.entityFormFieldDefs.standard[field.fieldId]; %>
                                                        <% if (def) { %>
                                                            <% if (field.fieldId === 'title') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <input name="<%= def.inputName %>" type="text" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= record.title || '' %>"
                                                                        placeholder="<%= field.placeholder || def.label %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                </div>
                                                            <% } else if (def.inputType === 'textarea') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <textarea name="<%= def.inputName %>" class="form-textarea dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" rows="4"
                                                                        placeholder="<%= field.placeholder || def.label %>"
                                                                        <%= field.required ? 'required' : '' %>><%= record[field.fieldId] || '' %></textarea>
                                                                </div>
                                                            <% } else if (def.inputType === 'file') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                    </label>
                                                                    <% if (record[field.fieldId]) { %>
                                                                        <div class="text-xs text-gray-500 mb-1">Fichier actuel : <span class="text-primary"><%= record[field.fieldId] %></span></div>
                                                                    <% } %>
                                                                    <input name="<%= def.inputName %>" type="file" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" />
                                                                </div>
                                                            <% } else if (def.inputType === 'date') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <input name="<%= def.inputName %>" type="date" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= record[field.fieldId] ? new Date(record[field.fieldId]).toISOString().split('T')[0] : '' %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                </div>
                                                            <% } else { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <input name="<%= def.inputName %>" type="<%= def.inputType || 'text' %>" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= record[field.fieldId] || '' %>"
                                                                        placeholder="<%= field.placeholder || def.label %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                </div>
                                                            <% } %>
                                                        <% } %>

                                                    <% } else if (field.type === 'custom') { %>
                                                        <% var cf = locals.entityFormFieldDefs && locals.entityFormFieldDefs.custom[field.fieldId]; %>
                                                        <% var cfVal = locals.recordValues && locals.recordValues[field.fieldId]; %>
                                                        <% if (cf && cf.htmlTemplate) { %>
                                                            <div class="mb-3">
                                                                <%- cf.htmlTemplate
                                                                    .replace(/\{\{\s*label\s*\}\}/g, field.label || cf.label || cf.name)
                                                                    .replace(/\{\{\s*name\s*\}\}/g, cf.name || '')
                                                                    .replace(/\{\{\s*placeholder\s*\}\}/g, field.placeholder || cf.label || cf.name)
                                                                    .replace(/\{\{\s*required\s*\}\}/g, field.required ? 'required' : '') %>
                                                            </div>
                                                        <% } else if (cf) { %>
                                                            <div class="mb-3">
                                                                <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                    <iconify-icon icon="<%= (cf.ui && cf.ui.icon) || 'solar:widget-bold-duotone' %>" width="14" class="text-info"></iconify-icon>
                                                                    <%= field.label || cf.label || cf.name %>
                                                                    <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                </label>
                                                                <% if (cf.inputType === 'textarea' || cf.inputType === 'richtext') { %>
                                                                    <textarea name="custom[<%= cf._id %>]" class="form-textarea" rows="3"
                                                                        placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                        <%= field.required ? 'required' : '' %>><%= cfVal || '' %></textarea>
                                                                <% } else if (cf.inputType === 'select' && cf.options && cf.options.length) { %>
                                                                    <% if (cf.multiple) { %>
                                                                        <% var selectedArr = Array.isArray(cfVal) ? cfVal : (cfVal ? [cfVal] : []); %>
                                                                        <div class="flex flex-wrap gap-2" x-data='{
                                                                            selected: <%- JSON.stringify(selectedArr) %>,
                                                                            toggle(val) {
                                                                                const idx = this.selected.indexOf(val);
                                                                                if (idx === -1) this.selected.push(val);
                                                                                else this.selected.splice(idx, 1);
                                                                            },
                                                                            isSelected(val) { return this.selected.includes(val); }
                                                                        }'>
                                                                            <% cf.options.forEach(function(opt) { %>
                                                                                <label class="group inline-flex items-center gap-1.5 px-2 py-0 rounded text-xs font-medium cursor-pointer border transition-all duration-200 select-none"
                                                                                       :class="isSelected('<%= opt.value %>') ? 'bg-primary/10 border-primary text-primary' : 'bg-white dark:bg-[#1b2e4b] border-gray-200 dark:border-gray-800 text-gray-500 dark:text-gray-400 hover:border-primary/30 hover:bg-primary/5 hover:text-primary/70'">
                                                                                    <input type="checkbox" name="custom[<%= cf._id %>][]" value="<%= opt.value %>" class="hidden"
                                                                                           :checked="isSelected('<%= opt.value %>')"
                                                                                           @change="toggle('<%= opt.value %>')">
                                                                                    <svg x-show="isSelected('<%= opt.value %>')" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                                                                    <span><%= opt.label || opt.value %></span>
                                                                                </label>
                                                                            <% }); %>
                                                                        </div>
                                                                    <% } else { %>
                                                                        <select name="custom[<%= cf._id %>]" class="form-select" <%= field.required ? 'required' : '' %>>
                                                                            <option value="">-- Choisir --</option>
                                                                            <% cf.options.forEach(function(o) { %>
                                                                                <option value="<%= o.value || o %>" <%= (cfVal == (o.value || o)) ? 'selected' : '' %>><%= o.label || o %></option>
                                                                            <% }); %>
                                                                        </select>
                                                                    <% } %>
                                                                <% } else if (cf.inputType === 'checkbox') { %>
                                                                    <div class="flex items-center gap-2 py-2">
                                                                        <input name="custom[<%= cf._id %>]" type="checkbox" class="form-checkbox"
                                                                            <%= (cfVal === true || cfVal === 'on' || cfVal === 'true') ? 'checked' : '' %> />
                                                                    </div>
                                                                <% } else if (cf.type === 'recurrence') { %>
                                                                    <% var recVal = (cfVal && typeof cfVal === 'object') ? cfVal : {}; %>
                                                                    <script type="application/json" id="rec-config-<%= cf._id %>"><%- JSON.stringify({ options: cf.type_config.options || [], slots: cf.type_config.slots || {}, allowCustomText: cf.type_config.allowCustomText || false }) %></script>
                                                                    <div x-data="recurrenceField({
                                                                        fieldId: '<%= cf._id %>',
                                                                        configElementId: 'rec-config-<%= cf._id %>',
                                                                        initialValue: <%- JSON.stringify(recVal) %>
                                                                    })" class="space-y-3">
                                                                         <template x-for="slotName in slotNames" :key="slotName">
                                                                             <div>
                                                                                 <label class="block text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1.5" x-text="slotName"></label>
                                                                                 <template x-if="getSlotUI(slotName) === 'select'">
                                                                                     <select class="form-select text-sm" @change="setSlotValue(slotName, $event.target.value)">
                                                                                         <option value="">-- Choisir --</option>
                                                                                         <template x-for="opt in getSlotOptions(slotName)" :key="opt.value">
                                                                                             <option :value="opt.value" x-text="opt.label" :selected="currentValue[slotName] === opt.value"></option>
                                                                                         </template>
                                                                                     </select>
                                                                                 </template>
                                                                                 <template x-if="getSlotUI(slotName) === 'checkbox'">
                                                                                     <div class="flex flex-wrap gap-2">
                                                                                         <template x-for="opt in getSlotOptions(slotName)" :key="opt.value">
                                                                                             <label class="group inline-flex items-center gap-1.5 px-2 py-0 rounded text-xs font-medium cursor-pointer border transition-all duration-200 select-none"
                                                                                                    :class="isSlotSelected(slotName, opt.value) ? 'bg-primary/10 border-primary text-primary' : 'bg-white dark:bg-[#1b2e4b] border-gray-200 dark:border-gray-800 text-gray-500 dark:text-gray-400 hover:border-primary/30 hover:bg-primary/5 hover:text-primary/70'">
                                                                                                 <input type="checkbox" class="hidden" :value="opt.value" :checked="isSlotSelected(slotName, opt.value)" @change="toggleSlotValue(slotName, opt.value)">
                                                                                                 <svg x-show="isSlotSelected(slotName, opt.value)" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                                                                                 <span x-text="opt.label"></span>
                                                                                             </label>
                                                                                         </template>
                                                                                     </div>
                                                                                 </template>
                                                                             </div>
                                                                         </template>
                                                                         <template x-if="allowCustomText">
                                                                             <div>
                                                                                 <label class="block text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1.5">Autre</label>
                                                                                 <input type="text" class="form-input text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" x-model="currentValue.customText" @input="serialize()" placeholder="Texte libre...">
                                                                            </div>
                                                                        </template>
                                                                        <input type="hidden" name="custom[<%= cf._id %>]" :value="serialized">
                                                                    </div>
                                                                <% } else { %>
                                                                    <input name="custom[<%= cf._id %>]" type="<%= cf.inputType || 'text' %>" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= cfVal || '' %>"
                                                                        placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                <% } %>
                                                            </div>
                                                        <% } %>

                                                    <% } else if (field.type === 'relation') { %>
                                                        <% var rel = locals.entityFormFieldDefs && locals.entityFormFieldDefs.relation[field.fieldId]; %>
                                                        <% var relVal = locals.recordValues && locals.recordValues[field.fieldId]; %>
                                                        <% if (rel) { %>
                                                            <% if (rel.inputMode === 'modal-picker') { %>
                                                            <!-- ========== MODAL PICKER MODE ========== -->
                                                            <div class="mb-3">
                                                                <% var mpIcon = (rel.targetEntity && rel.targetEntity.icon) || 'solar:link-round-bold-duotone'; %>
                                                                <% var mpColor = (rel.targetEntity && rel.targetEntity.color) || '#4361ee'; %>
                                                                <% var mpName = (rel.targetEntity && rel.targetEntity.name) || ''; %>
                                                                <% var mpEntityId = (rel.targetEntity && rel.targetEntity._id) || ''; %>
                                                                <div x-data="modalPickerField({
                                                                    fieldId: '<%= rel.key %>',
                                                                    refEntity: '<%= mpEntityId %>',
                                                                    refEntityName: '<%= mpName %>',
                                                                    refEntityIcon: '<%= mpIcon %>',
                                                                    refEntityColor: '<%= mpColor %>',
                                                                    multiple: <%= (rel.cardinality === 'one-to-many' || rel.cardinality === 'many-to-many') ? 'true' : 'false' %>,
                                                                    initialValue: <%- JSON.stringify(relVal || null).replace(/"/g, '&quot;') %>
                                                                })" data-display-fields='<%- JSON.stringify(rel.displayFields || []) %>' class="relative">
                                                                    <label class="flex items-center gap-1.5 mb-1 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= mpIcon %>" width="14"
                                                                            style="color: <%= mpColor %>"></iconify-icon>
                                                                        <%= field.label || rel.label || 'Relation' %>
                                                                    </label>

                                                                    <!-- Trigger Button -->
                                                                    <button type="button" @click="openModal()"
                                                                        class="w-full flex items-center justify-between px-3 py-2 border border-gray-300 dark:border-gray-800 rounded-md hover:border-primary/50 transition-colors text-sm bg-white dark:bg-[#1b2e4b]">
                                                                        <span class="flex items-center gap-2 min-w-0" :class="!multiple && selectedItems.length > 0 ? 'text-gray-800 dark:text-gray-200' : 'text-gray-500 dark:text-gray-400'">
                                                                            <iconify-icon icon="solar:magnifer-bold-duotone" width="16" class="shrink-0" x-show="multiple || selectedItems.length === 0"></iconify-icon>
                                                                            <iconify-icon :icon="refEntityIcon" width="16" :style="'color:' + refEntityColor" class="shrink-0" x-show="!multiple && selectedItems.length > 0" x-cloak></iconify-icon>
                                                                            <span class="truncate" x-text="!multiple && selectedItems.length > 0 ? selectedItems[0].label : (multiple && selectedItems.length > 0 ? selectedItems.length + ' sélectionné(s)' : 'Rechercher <%= mpName %>...')"></span>
                                                                        </span>
                                                                        <span class="flex items-center gap-1 shrink-0">
                                                                            <span role="button" x-show="!multiple && selectedItems.length > 0" x-cloak @click.stop="removeItem(selectedItems[0]?.id)" class="w-5 h-5 rounded-full flex items-center justify-center text-gray-400 hover:text-danger hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors cursor-pointer">
                                                                                <iconify-icon icon="tabler:x" width="12"></iconify-icon>
                                                                            </span>
                                                                            <iconify-icon icon="tabler:external-link" width="14" class="text-gray-400"></iconify-icon>
                                                                        </span>
                                                                    </button>

                                                                    <!-- Selected Items Tags (multi only) -->
                                                                    <div class="flex flex-wrap gap-1 mt-2" x-show="multiple && selectedItems.length > 0">
                                                                        <template x-for="item in selectedItems" :key="item.id">
                                                                            <span class="inline-flex items-center gap-1 px-1.5 h-6 bg-primary/10 text-primary rounded text-xs border border-primary/20">
                                                                                <span x-text="item.label"></span>
                                                                                <button type="button" @click="removeItem(item.id)" class="hover:text-danger flex items-center transition-colors">
                                                                                    <iconify-icon icon="tabler:x" width="11"></iconify-icon>
                                                                                </button>
                                                                            </span>
                                                                        </template>
                                                                    </div>

                                                                    <!-- Hidden inputs -->
                                                                    <template x-if="multiple">
                                                                        <div>
                                                                            <template x-for="item in selectedItems" :key="item.id">
                                                                                <input type="hidden" :name="'custom[' + fieldId + '][]'" :value="item.id">
                                                                            </template>
                                                                        </div>
                                                                    </template>
                                                                    <template x-if="!multiple">
                                                                        <input type="hidden" :name="'custom[' + fieldId + ']'" :value="selectedItems[0]?.id || ''">
                                                                    </template>

                                                                    <!-- Modal Overlay -->
                                                                    <div x-ref="modalOverlay"
                                                                         style="display: none; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"
                                                                         class="fixed inset-0 z-[999] flex items-center justify-center bg-black/30"
                                                                         @click.self="closeModal()">
                                                                            <div class="bg-white dark:bg-[#0e1726] rounded-xl shadow-2xl w-full max-w-3xl mx-4 flex flex-col"
                                                                                 style="max-height: 80vh;" @click.stop>
                                                                                <div class="flex items-center justify-between px-5 py-3 border-b dark:border-gray-800">
                                                                                    <div class="flex items-center gap-2">
                                                                                        <iconify-icon :icon="refEntityIcon" width="18" :style="'color:' + refEntityColor"></iconify-icon>
                                                                                        <h3 class="font-semibold text-sm dark:text-gray-200" x-text="'Sélectionner ' + refEntityName"></h3>
                                                                                        <span class="text-xs text-gray-400 bg-gray-100 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 rounded-full" x-text="modalTotal + ' résultats'"></span>
                                                                                    </div>
                                                                                    <button type="button" @click="closeModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
                                                                                        <iconify-icon icon="tabler:x" width="20"></iconify-icon>
                                                                                    </button>
                                                                                </div>
                                                                                <div class="px-5 py-3 border-b dark:border-gray-800">
                                                                                    <div class="relative">
                                                                                        <iconify-icon icon="solar:magnifer-bold-duotone" width="16" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></iconify-icon>
                                                                                        <input type="text" class="form-input pl-9 text-sm dark:bg-[#1b2e4b] dark:border-gray-800 dark:text-gray-200 dark:placeholder-gray-500" placeholder="Rechercher..."
                                                                                               x-model="modalSearch" @input.debounce.300ms="fetchModalResults(true)" x-ref="modalSearchInput" />
                                                                                    </div>
                                                                                </div>
                                                                                <div class="flex-1 overflow-y-auto">
                                                                                    <template x-if="modalLoading && modalPage === 1">
                                                                                        <div class="flex items-center justify-center py-12">
                                                                                            <iconify-icon icon="svg-spinners:ring-resize" width="28" class="text-primary"></iconify-icon>
                                                                                        </div>
                                                                                    </template>
                                                                                    <template x-if="!(modalLoading && modalPage === 1)">
                                                                                        <div>
                                                                                            <template x-if="modalResults.length === 0 && !modalLoading">
                                                                                                <div class="flex flex-col items-center justify-center py-12 text-gray-400 dark:text-gray-500">
                                                                                                    <iconify-icon icon="solar:box-minimalistic-bold-duotone" width="40" class="mb-2"></iconify-icon>
                                                                                                    <span class="text-sm">Aucun résultat trouvé</span>
                                                                                                </div>
                                                                                            </template>
                                                                                            <div class="divide-y dark:divide-gray-800">
                                                                                                <template x-for="result in modalResults" :key="result.id">
                                                                                                    <div @click="toggleModalSelect(result)"
                                                                                                         class="flex items-center gap-3 px-5 py-2.5 cursor-pointer transition-colors"
                                                                                                         :class="isSelected(result.id) ? 'bg-primary/5' : 'hover:bg-gray-50 dark:hover:bg-white/5'">
                                                                                                        <div class="flex-shrink-0">
                                                                                                            <template x-if="multiple">
                                                                                                                <div class="w-4 h-4 rounded border-2 flex items-center justify-center transition-colors"
                                                                                                                     :class="isSelected(result.id) ? 'bg-primary border-primary' : 'border-gray-300 dark:border-gray-600'">
                                                                                                                    <iconify-icon x-show="isSelected(result.id)" icon="tabler:check" width="11" class="text-white"></iconify-icon>
                                                                                                                </div>
                                                                                                            </template>
                                                                                                            <template x-if="!multiple">
                                                                                                                <div class="w-4 h-4 rounded-full border-2 flex items-center justify-center transition-colors"
                                                                                                                     :class="isSelected(result.id) ? 'border-primary' : 'border-gray-300 dark:border-gray-600'">
                                                                                                                    <div x-show="isSelected(result.id)" class="w-2 h-2 rounded-full bg-primary"></div>
                                                                                                                </div>
                                                                                                            </template>
                                                                                                        </div>
                                                                                                        <div class="flex-1 min-w-0">
                                                                                                            <span class="text-sm font-medium truncate block dark:text-gray-200" x-text="result.label"></span>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </template>
                                                                                            </div>
                                                                                            <template x-if="modalHasMore">
                                                                                                <div class="px-5 py-2 border-t dark:border-gray-800">
                                                                                                    <button type="button" @click="loadMoreModal()" class="w-full text-sm text-primary hover:bg-primary/5 py-1.5 rounded" :disabled="modalLoading">
                                                                                                        <span x-show="!modalLoading">Charger plus...</span>
                                                                                                        <span x-show="modalLoading">Chargement...</span>
                                                                                                    </button>
                                                                                                </div>
                                                                                            </template>
                                                                                        </div>
                                                                                    </template>
                                                                                </div>
                                                                                <div x-show="multiple" class="flex items-center justify-between px-5 py-3 border-t bg-gray-50 dark:bg-[#1b2e4b] dark:border-gray-800 rounded-b-xl">
                                                                                    <span class="text-xs text-gray-500 dark:text-gray-400" x-text="tempSelected.length + ' sélectionné(s)'"></span>
                                                                                    <div class="flex gap-2">
                                                                                        <button type="button" @click="closeModal()" class="btn btn-outline-secondary btn-sm text-xs">Annuler</button>
                                                                                        <button type="button" @click="confirmSelection()" class="btn btn-primary btn-sm text-xs">
                                                                                            <iconify-icon icon="tabler:check" width="14" class="mr-1"></iconify-icon>
                                                                                            Valider
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <% } else { %>
                                                            <!-- ========== AUTOCOMPLETE MODE (default) ========== -->
                                                            <div class="mb-3">
                                                                <div x-data="relationField({
                                                                    fieldId: '<%= rel.key %>',
                                                                    refEntity: '<%= (rel.targetEntity && rel.targetEntity._id) || '' %>',
                                                                    multiple: <%= (rel.cardinality === 'one-to-many' || rel.cardinality === 'many-to-many') ? 'true' : 'false' %>,
                                                                    initialValue: <%- JSON.stringify(relVal || null).replace(/"/g, '&quot;') %>
                                                                })" class="relative">
                                                                    <label class="flex items-center gap-1.5 mb-1 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= (rel.targetEntity && rel.targetEntity.icon) || 'solar:link-round-bold-duotone' %>" width="14"
                                                                            style="color: <%= (rel.targetEntity && rel.targetEntity.color) || '#4361ee' %>"></iconify-icon>
                                                                        <%= field.label || rel.label || 'Relation' %>
                                                                    </label>
                                                                    <div class="relative group" @click.away="showResults = false">
                                                                        <input x-ref="searchInput" type="text" class="form-input pr-10"
                                                                            placeholder="Rechercher <%= (rel.targetEntity && rel.targetEntity.name) || '' %>..."
                                                                            x-model="searchQuery" @input.debounce.300ms="search" @focus="openDropdown" />
                                                                        <div @click="$refs.searchInput.focus(); openDropdown()" class="text-gray-400 cursor-pointer flex items-center" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); z-index: 10;">
                                                                            <iconify-icon icon="tabler:chevron-down" width="16"></iconify-icon>
                                                                        </div>
                                                                        <div x-show="showResults" style="display: none;"
                                                                             class="absolute z-50 w-full mt-1 bg-white dark:bg-[#0e1726] border border-border dark:border-gray-800 rounded-md shadow-xl max-h-60 overflow-y-auto overflow-x-hidden">
                                                                            <template x-if="loading && page === 1">
                                                                                <div class="px-4 py-2 text-sm text-secondary">Loading...</div>
                                                                            </template>
                                                                            <template x-for="result in results" :key="result.id">
                                                                                <div @click="selectItem(result)"
                                                                                     class="px-4 py-2 hover:bg-primary/5 cursor-pointer flex justify-between items-center border-b border-border last:border-0">
                                                                                    <span x-text="result.label" class="truncate"></span>
                                                                                    <iconify-icon icon="tabler:plus" class="text-primary/50" width="16"></iconify-icon>
                                                                                </div>
                                                                            </template>
                                                                            <template x-if="!loading && results.length === 0">
                                                                                <div class="px-4 py-2 text-sm text-secondary">Aucun résultat</div>
                                                                            </template>
                                                                            <template x-if="hasMore">
                                                                                <button type="button" @click.stop="loadMore" class="w-full px-4 py-2 text-sm text-primary hover:bg-primary/5 text-center disabled:opacity-50" :disabled="loading">
                                                                                    <span x-show="!loading">Charger plus...</span>
                                                                                    <span x-show="loading">Chargement...</span>
                                                                                </button>
                                                                            </template>
                                                                        </div>
                                                                    </div>
                                                                    <div class="flex flex-wrap gap-1 mt-2">
                                                                        <template x-for="item in selectedItems" :key="item.id">
                                                                            <span class="inline-flex items-center gap-1 px-1.5 h-6 bg-primary/10 text-primary rounded text-xs border border-primary/20">
                                                                                <span x-text="item.label"></span>
                                                                                <button type="button" @click="removeItem(item.id)" class="hover:text-danger flex items-center transition-colors">
                                                                                    <iconify-icon icon="tabler:x" width="11"></iconify-icon>
                                                                                </button>
                                                                            </span>
                                                                        </template>
                                                                    </div>
                                                                    <template x-if="multiple">
                                                                        <div>
                                                                            <template x-for="item in selectedItems" :key="item.id">
                                                                                <input type="hidden" :name="'custom[' + fieldId + '][]'" :value="item.id">
                                                                            </template>
                                                                        </div>
                                                                    </template>
                                                                    <template x-if="!multiple">
                                                                        <input type="hidden" :name="'custom[' + fieldId + ']'" :value="selectedItems[0]?.id || ''">
                                                                    </template>
                                                                </div>
                                                            </div>
                                                            <% } %>
                                                        <% } %>

                                                    <% } else if (field.type === 'classification') { %>
                                                        <% var cls = locals.entityFormFieldDefs && locals.entityFormFieldDefs.classification[field.fieldId]; %>
                                                        <% if (cls) { %>
                                                            <%
                                                                // Collect all selected option IDs for this classification
                                                                var selectedClassIds = [];
                                                                if (record.classificationValues) {
                                                                    record.classificationValues.forEach(function(c) {
                                                                        if (c.classificationId && c.classificationId.toString() === cls._id) {
                                                                            selectedClassIds.push((c.optionId || '').toString());
                                                                        }
                                                                    });
                                                                }
                                                            %>
                                                            <div class="mb-3">
                                                                <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                    <iconify-icon icon="solar:tag-bold-duotone" width="14" class="text-success"></iconify-icon>
                                                                    <%= field.label || cls.name %>
                                                                </label>
                                                                <div class="tp-wrapper"
                                                                     x-data="tagPicker({
                                                                         classificationId: '<%= cls._id %>',
                                                                         recordId: '<%= record._id %>',
                                                                         accountNumber: '<%= account_number %>',
                                                                         allowMultiple: <%= cls.allowMultiple ? 'true' : 'false' %>,
                                                                         fieldName: 'classification[<%= cls._id %>]',
                                                                         options: <%= JSON.stringify(cls.options || []) %>,
                                                                         selectedIds: <%= JSON.stringify(selectedClassIds) %>
                                                                     })"
                                                                     @click.away="closeDropdown()">

                                                                    <!-- Trigger: inline tag pills -->
                                                                    <div class="tp-trigger"
                                                                         :class="isOpen ? 'tp-trigger--active' : ''"
                                                                         @click="toggleOpen()">
                                                                        <template x-if="selectedOptions.length === 0">
                                                                            <span class="tp-placeholder">Sélectionner...</span>
                                                                        </template>
                                                                        <template x-for="opt in selectedOptions" :key="opt._id">
                                                                            <span class="tp-tag"
                                                                                  :style="'background:' + opt.bg + '; color:' + opt.text">
                                                                                <span x-text="opt.label"></span>
                                                                                <button type="button" class="tp-tag-remove"
                                                                                        @click.stop="removeTag(opt._id)">
                                                                                    <iconify-icon icon="tabler:x" width="10"></iconify-icon>
                                                                                </button>
                                                                            </span>
                                                                        </template>
                                                                    </div>

                                                                    <!-- Dropdown -->
                                                                    <div class="tp-dropdown" x-show="isOpen" x-cloak
                                                                         x-transition:enter="transition ease-out duration-150"
                                                                         x-transition:enter-start="opacity-0 translate-y-1"
                                                                         x-transition:enter-end="opacity-100 translate-y-0"
                                                                         x-transition:leave="transition ease-in duration-100"
                                                                         x-transition:leave-start="opacity-100"
                                                                         x-transition:leave-end="opacity-0"
                                                                         @click.stop>
                                                                        <!-- Search -->
                                                                        <div class="tp-search-wrap">
                                                                            <input type="text" class="tp-search-input"
                                                                                   placeholder="Rechercher ou créer..."
                                                                                   x-model="searchQuery"
                                                                                   x-ref="searchInput"
                                                                                   @keydown.enter.prevent="canCreate ? createOption() : null" />
                                                                        </div>

                                                                        <div class="tp-divider"></div>

                                                                        <!-- Options list -->
                                                                        <div class="tp-options" style="position: relative;">
                                                                            <template x-for="opt in filteredOptions" :key="opt._id">
                                                                                <div class="tp-option" @click="toggleOption(opt._id)">
                                                                                    <div class="tp-option-icon"
                                                                                         :style="'background:' + opt.bg">
                                                                                        <iconify-icon x-show="isSelected(opt._id)"
                                                                                                      icon="tabler:check" width="12"
                                                                                                      :style="'color:' + opt.text"></iconify-icon>
                                                                                    </div>
                                                                                    <span class="tp-option-label" x-text="opt.label"></span>
                                                                                    <div class="tp-option-actions">
                                                                                        <button type="button" class="tp-option-action-btn"
                                                                                                @click.stop="startEdit(opt, $event)">
                                                                                            <iconify-icon icon="solar:pen-2-linear" width="13"></iconify-icon>
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                            </template>

                                                                            <template x-if="filteredOptions.length === 0 && !canCreate">
                                                                                <div style="padding: 12px; text-align: center; color: #9ca3af; font-size: 12px;">
                                                                                    Aucune option trouvée
                                                                                </div>
                                                                            </template>

                                                                        </div>

                                                                        <!-- Edit popover (fixed position, escapes overflow) -->
                                                                        <template x-if="editingOption">
                                                                            <div class="tp-edit-popover" @click.stop
                                                                                 :style="'top:' + (_editPopoverPos?.top || 0) + 'px; left:' + (_editPopoverPos?.left || 0) + 'px'">
                                                                                <input type="text" class="tp-edit-input"
                                                                                       x-model="editLabel"
                                                                                       @keydown.enter.prevent="saveEdit()"
                                                                                       placeholder="Nom de l'option" />
                                                                                <div class="tp-colors">
                                                                                    <template x-for="(color, idx) in tagColors" :key="idx">
                                                                                        <div class="tp-color-dot"
                                                                                             :class="editColorIdx === idx ? 'tp-color-dot--active' : ''"
                                                                                             :style="'background:' + color.bg"
                                                                                             @click="selectColor(idx)"></div>
                                                                                    </template>
                                                                                </div>
                                                                                <button type="button" class="tp-delete-btn"
                                                                                        @click="deleteOption()">
                                                                                    <iconify-icon icon="solar:trash-bin-trash-bold" width="13"></iconify-icon>
                                                                                    Supprimer
                                                                                </button>
                                                                            </div>
                                                                        </template>

                                                                        <!-- Create new -->
                                                                        <template x-if="canCreate">
                                                                            <div class="tp-create-option" @click="createOption()">
                                                                                <iconify-icon icon="tabler:plus" width="14" style="color: #6b7280;"></iconify-icon>
                                                                                <span class="tp-create-label">Créer</span>
                                                                                <span class="tp-create-tag" x-text="searchQuery"></span>
                                                                            </div>
                                                                        </template>
                                                                    </div>

                                                                    <!-- Hidden inputs for form submission -->
                                                                    <template x-for="id in selectedIds" :key="id">
                                                                        <input type="hidden" name="classification[<%= cls._id %>][]" :value="id" />
                                                                    </template>
                                                                </div>
                                                            </div>
                                                        <% } %>
                                                    <% } %>
                                                <% }); %>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% }); %>
                            </div>
                        </div>

                    <% } else { %>
                        <!-- ========== LEGACY LAYOUT (Tabs + Canvas) ========== -->
                        <!-- Tabbed Attributes Section -->
                        <!-- Tabbed Attributes Section -->
                        <div>
                            <div class="flex justify-between items-end pb-4 border-b border-gray-100">
                                <div class="flex items-center gap-4">
                                    <template x-for="tab in tabs" :key="tab.id">
                                        <div class="relative group/tab flex items-center gap-1.5">
                                            <div @click="setActiveTab(tab.id)"
                                                class="cursor-pointer pb-2.5 px-2 flex items-center gap-2 relative transition-all duration-300 before:transition-all before:duration-500 before:absolute hover:text-primary before:bottom-0 before:w-0 before:left-0 before:right-0 before:m-auto before:h-[2px] before:bg-primary"
                                                :class="activeTab === tab.id ? 'before:w-full text-primary font-semibold' : 'text-gray-500 font-medium'">

                                                <iconify-icon :icon="tab.icon || 'tabler:apps'" width="16"
                                                    :class="activeTab === tab.id ? 'text-primary' : 'text-gray-400'"></iconify-icon>

                                                <template x-if="editingTabId !== tab.id">
                                                    <span class="text-sm tracking-tight" x-text="tab.title"
                                                        @dblclick="startEditingTab(tab)"></span>
                                                </template>
                                                <template x-if="editingTabId === tab.id">
                                                    <div
                                                        class="flex items-center gap-2 bg-white px-2 py-0.5 rounded shadow-sm ring-1 ring-gray-200">
                                                        <%- include('../components/icon-picker', {
                                                            onSelect: '(icon) => { tempTabIcon = icon }' ,
                                                            initialIcon: 'tempTabIcon' }) %>
                                                            <input type="text" x-model="tempTabTitle"
                                                                @keyup.enter="saveTabTitle()" @blur="saveTabTitle()"
                                                                x-init="$nextTick(() => $el.focus())"
                                                                class="!p-0 !h-auto !bg-transparent !border-none !text-sm !font-semibold !text-primary focus:ring-0 min-w-[70px]">
                                                    </div>
                                                </template>
                                            </div>

                                            <!-- Tab Actions (Design Mode) -->
                                            <div x-show="designMode && activeTab === tab.id"
                                                class="flex items-center gap-1 pb-2.5">
                                                <button type="button" @click="startEditingTab(tab)"
                                                    class="text-gray-400 hover:text-primary transition-colors">
                                                    <iconify-icon icon="solar:pen-2-linear" width="14"></iconify-icon>
                                                </button>
                                                <button type="button" x-show="tabs.length > 1"
                                                    @click="removeTab(tab.id)"
                                                    class="text-gray-400 hover:text-red-500 transition-colors">
                                                    <iconify-icon icon="solar:trash-bin-trash-linear"
                                                        width="14"></iconify-icon>
                                                </button>
                                            </div>
                                        </div>
                                    </template>

                                    <!-- Add Tab Button -->
                                    <button x-show="designMode" @click="addTab()" type="button"
                                        class="pb-2.5 text-gray-400 hover:text-primary transition-colors"
                                        title="Ajouter un onglet">
                                        <iconify-icon icon="tabler:plus" width="18"></iconify-icon>
                                    </button>
                                </div>

                                <div class="flex items-center gap-3 pb-2.5">
                                    <button x-show="designMode" @click="openModal = true" type="button"
                                        class="text-[11px] font-bold text-primary hover:bg-primary/5 px-4 py-1.5 rounded-lg transition-all flex items-center gap-2 border border-primary/20">
                                        <iconify-icon icon="tabler:circle-plus" width="16"></iconify-icon>
                                        <span>AJOUTER UN ATTRIBUT</span>
                                    </button>

                                    <button type="button" @click="designMode = !designMode"
                                        class="p-2 rounded-lg transition-all"
                                        :class="designMode ? 'bg-primary text-white shadow-md' : 'bg-gray-100 text-gray-500 hover:bg-gray-200'"
                                        title="Mode Layout">
                                        <iconify-icon icon="tabler:layout-dashboard" width="20"></iconify-icon>
                                    </button>
                                </div>
                            </div>

                            <!-- Standard Fields (Only on first tab for now) -->
                            <div class="flex flex-wrap -mx-2" x-show="activeTab === tabs[0]?.id">
                                <% if (entity.enabledStandardFields &&
                                    entity.enabledStandardFields.includes('description')) { %>
                                    <div class="w-full px-2 mb-4">
                                        <label for="description">Description</label>
                                        <textarea name="standard[description]" class="form-textarea" rows="4"
                                            placeholder="Entrez la description"><%= record.description %></textarea>
                                    </div>
                                    <% } %>
                            </div>
                        </div>

                        <!-- Custom Fields Section -->
                        <div class="mt-4">

                            <div id="fields-builder-canvas"
                                class="flex flex-wrap -mx-2 min-h-[80px] p-2 rounded-xl transition-all"
                                :class="designMode ? 'bg-gray-50/20 border-2 border-dashed border-gray-200' : ''"
                                x-html="renderAllFields()">
                            </div>
                        </div>
                    <% } %>
                    </div>
                </div>

                </div><!-- end panel-sortable-item attributs -->


            </div><!-- end space-y-4 -->
            </div><!-- end record-layout-col main -->

            <% const _showRightSidebar = !(locals.entityFormLayout && locals.entityFormLayout.settings && locals.entityFormLayout.settings.showRightSidebar === false); %>
            <% if (_showRightSidebar) { %>
            <!-- ═══ Sidebar Content (Column 1) ═══ -->
            <div class="record-layout-col relative"
                :style="'grid-column: span ' + columns[1].width"
                id="panels-sidebar-zone">

                <!-- Resize Handle on right edge (creates new column when resized) -->
                <div class="record-layout-resize-handle"
                    @mousedown.prevent="startResize(1, $event)">
                    <iconify-icon icon="solar:alt-arrow-left-bold" width="10"></iconify-icon>
                    <iconify-icon icon="solar:alt-arrow-right-bold" width="10" style="margin-left: -3px;"></iconify-icon>
                </div>

                <div class="space-y-3" id="sidebar-main-sortable">
                <div class="panel-sortable-item" data-panel-id="sidebar-content">
                    <template x-if="designMode">
                        <div class="panel-drag-handle">
                            <iconify-icon icon="tabler:grip-horizontal" width="16"></iconify-icon>
                            <span>Sidebar</span>
                        </div>
                    </template>
                    <%- include('partials/record-sidebar') %>
                </div>
                </div>
            </div>
            <% } %>

            <!-- ═══ Dynamic Extra Columns (created by resizing last column) ═══ -->
            <template x-for="(col, idx) in extraColumns" :key="col.id">
                <div class="record-layout-col relative"
                    :class="{ 'record-layout-col--empty': !col.panels || col.panels.length === 0 }"
                    :style="'grid-column: span ' + col.width"
                    :id="'panels-extra-zone-' + idx"
                    x-init="$nextTick(() => initExtraColSortable(idx))">

                    <!-- Resize Handle -->
                    <div class="record-layout-resize-handle"
                        @mousedown.prevent="startResize(2 + idx, $event)">
                        <iconify-icon icon="solar:alt-arrow-left-bold" width="10"></iconify-icon>
                        <iconify-icon icon="solar:alt-arrow-right-bold" width="10" style="margin-left: -3px;"></iconify-icon>
                    </div>

                    <!-- Sortable drop zone for panels -->
                    <div class="space-y-3 extra-col-sortable" :id="'extra-col-sortable-' + idx"
                        style="min-height: 80px;">
                        <!-- Panels dropped here will appear -->
                    </div>

                    <!-- Empty state placeholder (shown when no panels) -->
                    <template x-if="!col.panels || col.panels.length === 0">
                        <div class="record-layout-empty-placeholder">
                            <iconify-icon icon="solar:widget-add-bold-duotone" width="24" class="text-gray-400"></iconify-icon>
                            <span class="text-xs text-gray-400 mt-1">Colonne vide</span>
                            <span class="text-[10px] text-gray-300 mt-0.5">Glissez un panel ici</span>
                            <button @click.stop="removeExtraColumn(idx)" 
                                class="mt-2 w-7 h-7 rounded-full bg-danger/10 hover:bg-danger/20 flex items-center justify-center transition-all"
                                title="Supprimer cette colonne">
                                <iconify-icon icon="solar:trash-bin-trash-bold" width="14" class="text-danger"></iconify-icon>
                            </button>
                        </div>
                    </template>
                </div>
            </template>
        </div>
    </form>

    <!-- Modal for adding fields -->
    <template x-if="designMode">
        <%- include('../entity/components/entity-modal') %>
    </template>
</div>

<!-- ═══ PANEL LAYOUT STYLES ═══ -->
<style>
    /* ═══ Record Layout Grid (12-unit, page-builder style) ═══ */
    .record-layout-container {
        display: grid;
        gap: 24px;
        align-items: start;
    }
    @media (max-width: 1023px) {
        .record-layout-container { grid-template-columns: 1fr !important; }
        .record-layout-resize-handle { display: none !important; }
        .record-layout-col { grid-column: span 12 !important; }
    }
    .record-layout-col {
        min-width: 0;
        position: relative;
    }
    .record-layout-col--empty {
        min-height: 120px;
        border: 2px dashed #e2e8f0;
        border-radius: 8px;
    }
    .dark .record-layout-col--empty {
        border-color: #334155;
    }
    .extra-col-sortable:empty + * .record-layout-empty-placeholder,
    .record-layout-empty-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px 12px;
        min-height: 120px;
    }

    /* ═══ Resize Handle (positioned on right edge of each column) ═══ */
    .record-layout-resize-handle {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translate(50%, -50%);
        cursor: col-resize;
        z-index: 50;
        display: flex;
        align-items: center;
        color: #94a3b8;
        opacity: 0;
        transition: opacity 0.15s ease, color 0.15s ease;
        padding: 6px 2px;
        border-radius: 4px;
    }
    .record-layout-col:hover .record-layout-resize-handle,
    .record-layout-resize-handle--active {
        opacity: 1;
    }
    .record-layout-resize-handle:hover,
    .record-layout-resize-handle--active {
        color: #4361ee;
        background: rgba(67, 97, 238, 0.08);
    }
    .dark .record-layout-resize-handle {
        color: #64748b;
    }
    .dark .record-layout-resize-handle:hover,
    .dark .record-layout-resize-handle--active {
        color: #4361ee;
        background: rgba(67, 97, 238, 0.15);
    }


    /* ═══ Panel Drag Handle ═══ */
    .panel-drag-handle {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        margin-bottom: 4px;
        background: rgba(67, 97, 238, 0.06);
        border: 1px dashed rgba(67, 97, 238, 0.25);
        border-radius: 6px;
        color: #4361ee;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        cursor: grab;
        user-select: none;
        transition: background 0.15s ease, border-color 0.15s ease;
    }
    .panel-drag-handle:hover {
        background: rgba(67, 97, 238, 0.12);
        border-color: rgba(67, 97, 238, 0.4);
    }
    .panel-drag-handle:active { cursor: grabbing; }

    .panel-drop-zone {
        border: 2px dashed rgba(67, 97, 238, 0.15);
        border-radius: 8px;
        padding: 4px;
        transition: border-color 0.2s ease;
    }
    .panel-drop-zone:hover { border-color: rgba(67, 97, 238, 0.3); }

    .panel-sortable-ghost {
        opacity: 0.25;
        border: 2px dashed #4361ee;
        border-radius: 8px;
    }
    .panel-sortable-chosen {
        box-shadow: 0 4px 20px rgba(67, 97, 238, 0.15);
        border-radius: 8px;
    }
    .panel-sortable-drag {
        opacity: 0.9;
        transform: rotate(1deg);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
        border-radius: 8px;
    }

    .dark .panel-drag-handle {
        background: rgba(67, 97, 238, 0.1);
        border-color: rgba(67, 97, 238, 0.3);
    }
    .dark .panel-drop-zone { border-color: rgba(67, 97, 238, 0.2); }
</style>

<!-- DATA PIPELINE -->
<script type="application/json" id="all-templates">
    <%- JSON.stringify(locals.allFieldTemplates || []).replace(/</g, '\\u003C') %>
</script>
<script type="application/json" id="initial-fields">
    <%- JSON.stringify(locals.fields || []).replace(/</g, '\\u003C') %>
</script>
<script type="application/json" id="record-values">
    <%- JSON.stringify([...(record.customFields || []), ...((record.relations || []).map(r => ({ field_id: r.relationKey, value: r.value })))]).replace(/</g, '\\u003C') %>
</script>
<script type="application/json" id="entity-relations">
    <%- JSON.stringify((entity.relations || []).map(r => ({
        _id: r.key,
        type: 'relation',
        label: r.label || 'Relation',
        name: r.label || 'Relation',
        type_config: {
            refEntity: (r.targetEntity && r.targetEntity._id ? r.targetEntity._id.toString() : (r.targetEntity || '')),
            multiple: (r.cardinality === 'one-to-many' || r.cardinality === 'many-to-many')
        },
        ui: {
            placeholder: 'Rechercher ' + ((r.targetEntity && r.targetEntity.name) || '') + '...'
        }
    }))).replace(/</g, '\\u003C') %>
</script>


<script>
    document.addEventListener("alpine:init", () => {

        // ═══ PANEL LAYOUT (12-Unit Grid Resize + Drag & Drop Panels) ═══
        Alpine.data("panelLayout", () => {
            const entityId = '<%= locals.entity ? locals.entity._id : "" %>';
            const accountNumber = '<%= account_number %>';
            let mainSortable = null;
            let sidebarSortable = null;
            let sidebarInnerSortable = null;
            let resizeState = null;

            return {
                // 12-unit grid: main=8, sidebar=4 by default
                columns: [
                    { id: 'main', width: 8 },
                    { id: 'sidebar', width: 4 }
                ],
                extraColumns: [],  // dynamically created empty columns
                resizeActive: false,
                resizeColIndex: -1,
                layoutHover: false,

                init() {
                    this.loadColumnLayout();
                    this.$watch('designMode', (val) => {
                        if (val) {
                            this.$nextTick(() => this.initPanelSortables());
                        } else {
                            this.destroyPanelSortables();
                        }
                    });
                    window.addEventListener('mousemove', (e) => this.doResize(e));
                    window.addEventListener('mouseup', () => this.endResize());
                },

                // ═══ RESIZE LOGIC (rewritten from page-builder — exact same pattern) ═══
                startResize(colIndex, event) {
                    const container = document.getElementById('panels-container');
                    if (!container) return;

                    const allCols = this.getAllColumns();
                    resizeState = {
                        colIndex,
                        startX: event.clientX,
                        startWidths: allCols.map(c => c.width),
                        startColCount: allCols.length
                    };
                    this.resizeActive = true;
                    this.resizeColIndex = colIndex;
                    document.body.style.cursor = 'col-resize';
                    document.body.style.userSelect = 'none';

                    console.log('[RESIZE] startResize colIndex=', colIndex,
                        'startWidths=', JSON.stringify(resizeState.startWidths),
                        'startColCount=', resizeState.startColCount,
                        'isLastColumn=', colIndex === allCols.length - 1);
                },

                doResize(event) {
                    if (!resizeState) return;
                    const { colIndex, startX, startWidths, startColCount } = resizeState;

                    // Get the grid container width
                    const gridContainer = document.getElementById('panels-container');
                    if (!gridContainer) return;
                    const gridWidth = gridContainer.offsetWidth;
                    const colUnitWidth = gridWidth / 12;

                    // Calculate delta in grid units
                    const deltaX = event.clientX - startX;
                    const deltaUnits = Math.round(deltaX / colUnitWidth);
                    if (deltaUnits === 0) return;

                    const allCols = this.getAllColumns();
                    const isLastColumn = colIndex === allCols.length - 1;
                    const leftWidth = startWidths[colIndex];

                    console.log('[RESIZE] doResize deltaUnits=', deltaUnits,
                        'colIndex=', colIndex,
                        'isLastColumn=', isLastColumn,
                        'leftWidth=', leftWidth,
                        'allCols.length=', allCols.length,
                        'startColCount=', startColCount);

                    if (isLastColumn) {
                        // ═══ LAST COLUMN: shrinking creates new column ═══
                        // (exact page-builder logic)
                        let newLeftWidth = leftWidth + deltaUnits;
                        if (newLeftWidth < 1) newLeftWidth = 1;

                        // Calculate remaining space (total must always = 12)
                        const totalUsed = allCols.reduce((sum, col, idx) =>
                            sum + (idx === colIndex ? newLeftWidth : col.width), 0);
                        const remaining = 12 - totalUsed;

                        console.log('[RESIZE] LAST COL: newLeftWidth=', newLeftWidth,
                            'totalUsed=', totalUsed, 'remaining=', remaining);

                        if (remaining > 0) {
                            // Create or update extra column to fill remaining space
                            if (allCols.length === startColCount) {
                                // Add new empty column
                                console.log('[RESIZE] Creating new extra column, width=', remaining);
                                const newCol = {
                                    id: 'extra_' + Date.now(),
                                    width: remaining,
                                    panels: []
                                };
                                this.extraColumns.push(newCol);
                                resizeState.startWidths.push(0); // Track the new column (like page builder)
                                resizeState.startColCount = allCols.length + 1;
                                this.$nextTick(() => this.initExtraColSortable(this.extraColumns.length - 1));
                            } else {
                                // Update existing trailing extra column
                                const lastExtra = this.extraColumns[this.extraColumns.length - 1];
                                if (lastExtra) {
                                    console.log('[RESIZE] Updating existing extra column, width=', remaining);
                                    lastExtra.width = remaining;
                                }
                            }
                            this.setColWidth(colIndex, newLeftWidth);
                        } else if (remaining <= 0) {
                            // Remove extra column if no space (dragging back right)
                            if (allCols.length > startColCount && this.extraColumns.length > 0) {
                                console.log('[RESIZE] Removing extra column');
                                this.extraColumns.pop();
                                resizeState.startWidths.pop(); // Keep in sync
                                resizeState.startColCount = allCols.length - 1;
                            }
                            this.setColWidth(colIndex, leftWidth); // Reset to original
                        }
                    } else {
                        // ═══ NORMAL RESIZE between two adjacent columns ═══
                        const rightWidth = startWidths[colIndex + 1];

                        let newLeftWidth = leftWidth + deltaUnits;
                        let newRightWidth = rightWidth - deltaUnits;

                        // Check if the right column is an extra column
                        const isRightColumnExtra = (colIndex + 1 >= this.columns.length);

                        // If right column is an extra and would shrink to 0 → remove it
                        if (newRightWidth <= 0 && isRightColumnExtra) {
                            console.log('[RESIZE] NORMAL: Removing extra column (right col squeezed to 0)');
                            const extraIdx = colIndex + 1 - this.columns.length;
                            const removedWidth = this.extraColumns[extraIdx]?.width || 0;
                            this.extraColumns.splice(extraIdx, 1);
                            resizeState.startWidths.splice(colIndex + 1, 1);
                            resizeState.startColCount = this.getAllColumns().length;
                            // Give the freed space to the left column
                            this.setColWidth(colIndex, leftWidth + removedWidth);
                            return;
                        }

                        // Enforce min width of 1 for each column
                        if (newLeftWidth < 1) {
                            newLeftWidth = 1;
                            newRightWidth = leftWidth + rightWidth - 1;
                        }
                        if (newRightWidth < 1) {
                            newRightWidth = 1;
                            newLeftWidth = leftWidth + rightWidth - 1;
                        }

                        console.log('[RESIZE] NORMAL: newLeftWidth=', newLeftWidth,
                            'newRightWidth=', newRightWidth);

                        // Apply new widths
                        this.setColWidth(colIndex, newLeftWidth);
                        this.setColWidth(colIndex + 1, newRightWidth);
                    }
                },

                endResize() {
                    if (!resizeState) return;
                    const allCols = this.getAllColumns();
                    console.log('[RESIZE] endResize — final widths:',
                        JSON.stringify(allCols.map(c => ({ id: c.id, w: c.width }))),
                        'total=', allCols.reduce((s, c) => s + c.width, 0));
                    resizeState = null;
                    this.resizeActive = false;
                    this.resizeColIndex = -1;
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                    this.saveColumnLayout();
                },

                // Helper: get all columns (main + sidebar + extras)
                getAllColumns() {
                    return [...this.columns, ...this.extraColumns];
                },

                // Helper: set width on the right column array (columns or extraColumns)
                setColWidth(index, width) {
                    if (index < this.columns.length) {
                        this.columns[index].width = width;
                    } else {
                        const extraIdx = index - this.columns.length;
                        if (this.extraColumns[extraIdx]) {
                            this.extraColumns[extraIdx].width = width;
                        }
                    }
                },

                // Remove an extra (empty) column
                removeExtraColumn(idx) {
                    const removed = this.extraColumns.splice(idx, 1);
                    if (removed.length > 0) {
                        // Give the freed space back to the previous column
                        const allCols = this.getAllColumns();
                        if (allCols.length > 0) {
                            const lastCol = allCols[allCols.length - 1];
                            lastCol.width += removed[0].width;
                        }
                    }
                    this.saveColumnLayout();
                },

                // ═══ DRAG & DROP (Sortable) ═══
                extraSortables: [],

                getSortableOpts() {
                    return {
                        group: 'panels',
                        animation: 250,
                        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                        handle: '.panel-drag-handle',
                        draggable: '.panel-sortable-item',
                        ghostClass: 'panel-sortable-ghost',
                        chosenClass: 'panel-sortable-chosen',
                        dragClass: 'panel-sortable-drag',
                        fallbackOnBody: true,
                        swapThreshold: 0.65,
                        onEnd: () => this.savePanelLayout()
                    };
                },

                initPanelSortables() {
                    const mainZone = document.getElementById('panels-main-zone');
                    const mainInner = mainZone?.querySelector('.space-y-4') || mainZone;
                    const sidebarOuter = document.getElementById('sidebar-main-sortable');
                    const sidebarInner = document.getElementById('sidebar-inner-sortable');
                    if (!mainInner) return;
                    const opts = this.getSortableOpts();
                    mainSortable = new Sortable(mainInner, opts);
                    if (sidebarOuter) {
                        sidebarSortable = new Sortable(sidebarOuter, opts);
                    }
                    // Inner sidebar: allows reordering individual panels within the sidebar
                    if (sidebarInner) {
                        sidebarInnerSortable = new Sortable(sidebarInner, opts);
                    }
                    // Init sortables for any existing extra columns
                    this.initAllExtraColSortables();
                },

                destroyPanelSortables() {
                    if (mainSortable) { mainSortable.destroy(); mainSortable = null; }
                    if (sidebarSortable) { sidebarSortable.destroy(); sidebarSortable = null; }
                    if (sidebarInnerSortable) { sidebarInnerSortable.destroy(); sidebarInnerSortable = null; }
                    this.destroyExtraSortables();
                },

                initExtraColSortable(idx) {
                    if (!this.designMode) return;
                    const el = document.getElementById('extra-col-sortable-' + idx);
                    if (!el || el._sortableInit) return;
                    const sortable = new Sortable(el, this.getSortableOpts());
                    el._sortableInit = true;
                    this.extraSortables.push({ idx, sortable, el });
                },

                initAllExtraColSortables() {
                    this.destroyExtraSortables();
                    this.extraColumns.forEach((col, idx) => {
                        this.$nextTick(() => this.initExtraColSortable(idx));
                    });
                },

                destroyExtraSortables() {
                    this.extraSortables.forEach(s => {
                        if (s.sortable) s.sortable.destroy();
                        if (s.el) s.el._sortableInit = false;
                    });
                    this.extraSortables = [];
                },

                initSortableCol(el, colIndex) {
                    // Future: initialize sortable for individual columns
                },

                getPanelLabel(panelId) {
                    const labels = { attributs: 'Attributs', sidebar: 'Sidebar' };
                    return labels[panelId] || panelId;
                },

                // ═══ PERSISTENCE ═══
                async loadColumnLayout() {
                    try {
                        const resp = await fetch(`/account/${accountNumber}/api/user/view-preferences/record_panels_${entityId}`, { credentials: 'include' });
                        if (resp.ok) {
                            const data = await resp.json();
                            if (data?.preferences?.columnWidths) {
                                const saved = data.preferences.columnWidths;
                                // Migrate from old percentage format (75/25) to 12-unit grid (8/4)
                                const isOldFormat = saved.some(c => c.width > 12);
                                if (isOldFormat) {
                                    const total = saved.reduce((sum, c) => sum + c.width, 0);
                                    saved.forEach(c => {
                                        c.width = Math.round((c.width / total) * 12);
                                    });
                                    // Ensure total is exactly 12
                                    const newTotal = saved.reduce((sum, c) => sum + c.width, 0);
                                    if (newTotal !== 12) saved[0].width += (12 - newTotal);
                                }
                                this.columns = saved;
                            }
                            if (data?.preferences?.extraColumns) {
                                this.extraColumns = data.preferences.extraColumns;
                            }
                            // Validate total = 12 (fix corrupted saved data)
                            const allTotal = this.columns.reduce((s, c) => s + c.width, 0) + this.extraColumns.reduce((s, c) => s + c.width, 0);
                            if (allTotal !== 12 && allTotal > 0) {
                                const deficit = 12 - allTotal;
                                if (deficit > 0) {
                                    this.columns[this.columns.length - 1].width += deficit;
                                } else {
                                    let excess = -deficit;
                                    while (excess > 0 && this.extraColumns.length > 0) {
                                        const last = this.extraColumns[this.extraColumns.length - 1];
                                        if (last.width <= excess) { excess -= last.width; this.extraColumns.pop(); }
                                        else { last.width -= excess; excess = 0; }
                                    }
                                    if (excess > 0) this.columns[this.columns.length - 1].width = Math.max(2, this.columns[this.columns.length - 1].width - excess);
                                }
                            }
                            // Load panel layout (panel order + column assignments)
                            if (data?.preferences?.panelLayout) {
                                this.$nextTick(() => this.applyPanelLayout(data.preferences.panelLayout));
                            }
                        }
                    } catch(e) { console.warn('Could not load column layout:', e); }
                },

                applyPanelLayout(layout) {
                    // Collect all panel-sortable-item elements from all zones
                    const allPanels = new Map();
                    document.querySelectorAll('.panel-sortable-item[data-panel-id]').forEach(el => {
                        allPanels.set(el.dataset.panelId, el);
                    });
                    if (allPanels.size === 0) return;

                    const mainZone = document.getElementById('panels-main-zone');
                    const sidebarZone = document.getElementById('sidebar-main-sortable');

                    // Helper: move panels into a zone in specified order
                    const movePanelsToZone = (zone, panelIds) => {
                        if (!zone || !panelIds) return;
                        panelIds.forEach(id => {
                            const el = allPanels.get(id);
                            if (el) {
                                zone.appendChild(el);
                                allPanels.delete(id);
                            }
                        });
                    };

                    // Apply main column order
                    if (layout.main && mainZone) {
                        // Get the inner sortable container (first child div)
                        const mainInner = mainZone.querySelector('.space-y-4') || mainZone;
                        movePanelsToZone(mainInner, layout.main);
                    }

                    // Apply sidebar order
                    if (layout.sidebar && sidebarZone) {
                        movePanelsToZone(sidebarZone, layout.sidebar);
                    }

                    // Apply inner sidebar panel ordering
                    if (layout.sidebarInner) {
                        const sidebarInnerZone = document.getElementById('sidebar-inner-sortable');
                        if (sidebarInnerZone) {
                            movePanelsToZone(sidebarInnerZone, layout.sidebarInner);
                        }
                    }

                    // Apply extra column panels
                    if (layout.extra && this.extraColumns.length > 0) {
                        this.$nextTick(() => {
                            this.extraColumns.forEach((col, idx) => {
                                const extraZone = document.getElementById('extra-col-sortable-' + idx);
                                const panelIds = layout.extra[col.id];
                                if (extraZone && panelIds) {
                                    movePanelsToZone(extraZone, panelIds);
                                    col.panels = panelIds;
                                }
                            });
                        });
                    }
                },

                async saveColumnLayout() {
                    try {
                        await fetch(`/account/${accountNumber}/api/user/view-preferences`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                viewId: `record_panels_${entityId}`,
                                preferences: {
                                    columnWidths: JSON.parse(JSON.stringify(this.columns)),
                                    extraColumns: JSON.parse(JSON.stringify(this.extraColumns))
                                }
                            })
                        });
                    } catch(e) { console.error('Failed to save column layout:', e); }
                },

                async savePanelLayout() {
                    const mainZone = document.getElementById('panels-main-zone');
                    const mainInner = mainZone?.querySelector('.space-y-4') || mainZone;
                    const sidebarOuter = document.getElementById('sidebar-main-sortable');
                    const sidebarInner = document.getElementById('sidebar-inner-sortable');
                    const mainPanels = mainInner ? Array.from(mainInner.querySelectorAll(':scope > .panel-sortable-item')).map(el => el.dataset.panelId) : [];
                    const sidebarPanels = sidebarOuter ? Array.from(sidebarOuter.querySelectorAll(':scope > .panel-sortable-item')).map(el => el.dataset.panelId) : [];
                    // Also save the inner sidebar panel ordering
                    const sidebarInnerPanels = sidebarInner ? Array.from(sidebarInner.querySelectorAll(':scope > .panel-sortable-item')).map(el => el.dataset.panelId) : [];
                    
                    // Collect panels from extra columns
                    const extraPanels = {};
                    this.extraColumns.forEach((col, idx) => {
                        const zone = document.getElementById('extra-col-sortable-' + idx);
                        if (zone) {
                            const panels = Array.from(zone.querySelectorAll(':scope > .panel-sortable-item')).map(el => el.dataset.panelId);
                            extraPanels[col.id] = panels;
                            // Update the panels array on the column
                            col.panels = panels;
                        }
                    });

                    try {
                        await fetch(`/account/${accountNumber}/api/user/view-preferences`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                viewId: `record_panels_${entityId}`,
                                preferences: { panelLayout: { main: mainPanels, sidebar: sidebarPanels, sidebarInner: sidebarInnerPanels, extra: extraPanels } }
                            })
                        });
                    } catch(e) { console.error('Failed to save panel layout:', e); }
                }
            };
        });

        Alpine.data("recordForm", () => {
            const initialLayout = JSON.parse('<%- JSON.stringify(locals.formLayout || []) %>');
            const allTemplates = JSON.parse(document.getElementById("all-templates").textContent);
            const rawFields = JSON.parse(document.getElementById("initial-fields").textContent);
            const recordValues = JSON.parse(document.getElementById("record-values").textContent);

            const fieldsMap = {};
            rawFields.forEach(f => { fieldsMap[f._id] = f; });
            allTemplates.forEach(t => { if (!fieldsMap[t._id]) fieldsMap[t._id] = t; });

            // Inject entity relations as pseudo-fields in fieldsMap
            const entityRelations = JSON.parse(document.getElementById("entity-relations").textContent);
            entityRelations.forEach(r => { if (!fieldsMap[r._id]) fieldsMap[r._id] = r; });

            const valuesMap = {};
            recordValues.forEach(cv => { valuesMap[cv.field_id] = cv.value; });

            return {
                designMode: false,
                tabs: (initialLayout.tabs || [{ id: 'default', title: 'Attributs' }]).map(t => ({
                    ...t,
                    icon: t.icon || 'tabler:apps'
                })),
                activeTab: (initialLayout.tabs && initialLayout.tabs.length > 0) ? initialLayout.tabs[0].id : 'default',
                layout: (Array.isArray(initialLayout) ? initialLayout : (initialLayout.fields || [])).map(i => ({
                    ...i,
                    id: String(i.id || `f_${Math.random()}`),
                    tabId: i.tabId || 'default'
                })),
                fieldsById: fieldsMap,
                valuesMap: valuesMap,
                allTemplates: allTemplates,
                openModal: false,
                isResizing: false,
                resizeData: null,
                editingTabId: null,
                tempTabTitle: '',
                tempTabIcon: 'tabler:apps',

                init() {
                    this.rebuildCanvas();
                    window.addEventListener('mousemove', (e) => this.handleResizing(e));
                    window.addEventListener('mouseup', () => this.stopResizing());

                    this.$watch('designMode', () => {
                        this.rebuildCanvas();
                    });
                    this.$watch('activeTab', () => {
                        this.rebuildCanvas();
                    });
                },

                renderAllFields() {
                    const currentTabFields = this.layout.filter(item => item.tabId === this.activeTab);
                    if (currentTabFields.length === 0 && this.designMode) {
                        return `
                            <div class="w-full flex flex-col items-center justify-center py-12 gap-3 cursor-pointer group/add-box" 
                                 onclick="window.recordFormApp.openModal = true">
                                <div class="w-12 h-12 rounded-full border-2 border-dashed border-gray-200 flex items-center justify-center text-gray-300 group-hover/add-box:border-primary group-hover/add-box:text-primary transition-all">
                                    <iconify-icon icon="tabler:plus" width="28"></iconify-icon>
                                </div>
                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest group-hover/add-box:text-primary transition-colors">Ajouter un attribut</span>
                            </div>
                        `;
                    }
                    return currentTabFields.map((item, index) => this.renderFieldItemHTML(item, index)).join('');
                },

                rebuildCanvas() {
                    const canvas = document.getElementById('fields-builder-canvas');
                    if (!canvas) return;

                    if (canvas._sortable) {
                        canvas._sortable.destroy();
                        canvas._sortable = null;
                    }

                    canvas.innerHTML = this.renderAllFields();

                    if (this.designMode) {
                        this.$nextTick(() => {
                            this.initSortables();
                        });
                    }

                    this.executeScripts();
                },

                initSortables() {
                    const builder = document.getElementById('fields-builder-canvas');
                    if (!builder || !this.designMode) return;

                    builder._sortable = new Sortable(builder, {
                        animation: 150,
                        ghostClass: 'sortable-ghost',
                        handle: '.group-handle-drag',
                        draggable: '.field-item',
                        onEnd: (evt) => {
                            const containerIds = Array.from(builder.querySelectorAll('.field-item')).map(el => el.dataset.id);

                            // Reconstruct the full layout by keeping items from other tabs and updating items in current tab
                            const otherTabItems = this.layout.filter(i => i.tabId !== this.activeTab);
                            const currentTabItemsOrdered = containerIds.map(id => this.layout.find(i => String(i.id) === String(id))).filter(Boolean);

                            this.layout = [...otherTabItems, ...currentTabItemsOrdered];
                            this.saveLayout();
                        }
                    });
                },

                renderFieldItemHTML(item, index) {
                    const field = this.fieldsById[item.fieldId];
                    if (!field) return '';

                    const isDesign = this.designMode;
                    const widthPct = item.width * 8.333;

                    let inputHtml = this.renderField(field, item.id);

                    return `
                    <div class="field-item group relative px-2 py-0.5 h-fit" 
                         style="width: ${widthPct}%" 
                         data-id="${item.id}">
                        
                        <div class="relative ${isDesign ? 'bg-white border border-transparent hover:border-gray-200 hover:shadow-sm rounded-lg p-1.5' : ''} transition-all duration-200 h-fit">
                            
                            ${isDesign ? `
                                <div class="absolute top-1 right-1 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity z-[110] bg-white/80 backdrop-blur-sm rounded px-1">
                                    <div class="group-handle-drag p-1 text-gray-400 hover:text-primary cursor-grab active:cursor-grabbing">
                                        <iconify-icon icon="tabler:grip-vertical" width="14"></iconify-icon>
                                    </div>
                                    <button type="button" onclick="window.recordFormApp.removeField('${item.id}')"
                                            class="p-1 text-gray-400 hover:text-red-500 cursor-pointer">
                                        <iconify-icon icon="tabler:trash" width="14"></iconify-icon>
                                    </button>
                                </div>
                                <div onmousedown="window.recordFormApp.startResizingManual(event, '${item.id}')"
                                     class="absolute bottom-0 right-0 w-5 h-5 opacity-0 group-hover:opacity-100 transition-opacity z-[110] text-gray-300 hover:text-primary flex items-center justify-center"
                                     style="cursor: nwse-resize !important;"
                                     title="Redimensionner">
                                    <iconify-icon icon="tabler:resize" width="12" class="pointer-events-none" rotate="45"></iconify-icon>
                                </div>
                            ` : ''}

                            <div class="${isDesign ? 'pointer-events-none select-none' : ''} builder-preview">
                                ${inputHtml}
                            </div>
                        </div>
                    </div>
                `;
                },

                renderField(field, itemId) {
                    let template = field.htmlTemplate || '';
                    
                    // Auto-generate input HTML when no htmlTemplate exists
                    if (!template && field.type !== 'relation' && field.type !== 'recurrence') {
                        const type = field.type || 'string';
                        const subtype = field.subtype || '';
                        const placeholder = field.ui?.placeholder || field.label || '';
                        const fieldName = `custom[${field._id}]`;
                        const labelHtml = `<label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">${field.label || field.name}</label>`;
                        
                        if (type === 'textarea' || type === 'richtext' || subtype === 'textarea' || subtype === 'richtext') {
                            template = `${labelHtml}<textarea name="${fieldName}" class="form-textarea text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" rows="3" placeholder="${placeholder}">{{value}}</textarea>`;
                        } else if (type === 'boolean' || subtype === 'boolean' || subtype === 'checkbox') {
                            template = `<label class="flex items-center gap-3 cursor-pointer"><span class="text-sm font-semibold text-gray-700 dark:text-gray-300">${field.label || field.name}</span><label class="w-12 h-6 relative mb-0"><input type="checkbox" name="${fieldName}" class="custom_switch absolute w-full h-full opacity-0 z-10 cursor-pointer peer" value="on" {{checked}} /><span class="bg-[#ebedf2] dark:bg-dark block h-full rounded-full before:absolute before:left-1 before:bg-white dark:before:bg-white-dark dark:peer-checked:before:bg-white before:bottom-1 before:w-4 before:h-4 before:rounded-full peer-checked:before:left-7 peer-checked:bg-primary before:transition-all before:duration-300"></span></label></label>`;
                        } else if (type === 'number' || subtype === 'number' || subtype === 'currency') {
                            template = `${labelHtml}<input type="number" name="${fieldName}" class="form-input text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" placeholder="${placeholder}" value="{{value}}" step="any" />`;
                        } else if (type === 'date' || subtype === 'date') {
                            template = `${labelHtml}<input type="date" name="${fieldName}" class="form-input text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" value="{{value}}" />`;
                        } else if (subtype === 'datetime') {
                            template = `${labelHtml}<input type="datetime-local" name="${fieldName}" class="form-input text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" value="{{value}}" />`;
                        } else if (subtype === 'email') {
                            template = `${labelHtml}<input type="email" name="${fieldName}" class="form-input text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" placeholder="${placeholder}" value="{{value}}" />`;
                        } else if (subtype === 'url' || subtype === 'website') {
                            template = `${labelHtml}<input type="url" name="${fieldName}" class="form-input text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" placeholder="${placeholder}" value="{{value}}" />`;
                        } else if (subtype === 'phone' || subtype === 'tel') {
                            template = `${labelHtml}<input type="tel" name="${fieldName}" class="form-input text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" placeholder="${placeholder}" value="{{value}}" />`;
                        } else if (subtype === 'select' && field.type_config?.options) {
                            const opts = (field.type_config.options || []).map(o => `<option value="${o.value || o}">${o.label || o}</option>`).join('');
                            template = `${labelHtml}<select name="${fieldName}" class="form-select text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"><option value="">-- Choisir --</option>${opts}</select>`;
                        } else {
                            // Default: standard text input
                            template = `${labelHtml}<input type="text" name="${fieldName}" class="form-input text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" placeholder="${placeholder}" value="{{value}}" />`;
                        }
                    }
                    if (!template && field.type === 'relation') {
                        template = `
<div x-data="relationField({ 
    fieldId: '{{_id}}', 
    refEntity: '{{type_config.refEntity}}', 
    multiple: {{type_config.multiple}}, 
    initialValue: {{value_json}} 
})" class="relative">
    {{label}}
    
    <!-- Search Input -->
    <div class="relative group" @click.away="showResults = false">
        <input 
            x-ref="searchInput"
            type="text" 
            class="form-input pr-10" 
            placeholder="{{ui.placeholder}}" 
            x-model="searchQuery"
            @input.debounce.300ms="search"
            @focus="openDropdown"
        />
        <div @click="$refs.searchInput.focus(); openDropdown()" class="text-gray-400 cursor-pointer flex items-center" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); z-index: 10;">
             <iconify-icon icon="tabler:chevron-down" width="16"></iconify-icon>
        </div>
        
        <!-- Results Dropdown -->
        <div x-show="showResults" 
             style="display: none;"
             class="absolute z-50 w-full mt-1 bg-white border border-border rounded-md shadow-xl max-h-60 overflow-y-auto overflow-x-hidden">
             
            <template x-if="loading && page === 1">
                <div class="px-4 py-2 text-sm text-secondary">Loading...</div>
            </template>

            <template x-for="result in results" :key="result.id">
                <div @click="selectItem(result)" 
                     class="px-4 py-2 hover:bg-primary/5 cursor-pointer flex justify-between items-center border-b border-border last:border-0">
                    <span x-text="result.label" class="truncate"></span>
                    <iconify-icon icon="tabler:plus" class="text-primary/50" width="16"></iconify-icon>
                </div>
            </template>
            
            <template x-if="!loading && results.length === 0">
                 <div class="px-4 py-2 text-sm text-secondary">No results found</div>
            </template>

            <template x-if="hasMore">
                <button type="button" @click.stop="loadMore" :disabled="loading" style="width: 100%; padding: 8px 16px; font-size: 13px; color: #4361ee; background: #f8f9ff; border: none; border-top: 1px solid #e0e6ed; cursor: pointer; text-align: center; white-space: nowrap; position: sticky; bottom: 0;">
                    <span x-show="!loading">Charger plus...</span>
                    <span x-show="loading" style="display: none;">Chargement...</span>
                </button>
            </template>
        </div>
    </div>

    <!-- Selected Items (Below Input) -->
    <div class="flex flex-wrap gap-1 mt-2">
        <template x-for="item in selectedItems" :key="item.id">
            <span class="inline-flex items-center gap-1 px-1.5 h-6 bg-primary/10 text-primary rounded text-xs border border-primary/20">
                <span x-text="item.label"></span>
                <button type="button" @click="removeItem(item.id)" class="hover:text-danger flex items-center transition-colors">
                    <iconify-icon icon="tabler:x" width="11"></iconify-icon>
                </button>
            </span>
        </template>
    </div>

    <!-- Hidden inputs for persistence -->
    <template x-if="multiple">
        <div>
          <template x-for="item in selectedItems" :key="item.id">
              <input type="hidden" :name="'custom[' + fieldId + '][]'" :value="item.id">
          </template>
        </div>
    </template>
    <template x-if="!multiple">
        <input type="hidden" :name="'custom[' + fieldId + ']'" :value="selectedItems[0]?.id || ''">
    </template>
</div>`;
                    }
                    if (!template && field.type === 'recurrence') {
                        const typeConfig = field.type_config || {};
                        const options = JSON.stringify(typeConfig.options || []).replace(/"/g, '&quot;');
                        const slots = JSON.stringify(typeConfig.slots || {}).replace(/"/g, '&quot;');
                        const allowCustomText = typeConfig.allowCustomText || false;
                        template = `
<div x-data="recurrenceField({
    fieldId: '${field._id}',
    options: ${options},
    slots: ${slots},
    allowCustomText: ${allowCustomText},
    initialValue: {{value_json}}
})" class="space-y-3">
    <label class="block text-sm font-semibold">${field.label}</label>
    
    <template x-for="slotName in slotNames" :key="slotName">
        <div>
            <label class="block text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1.5" x-text="slotName"></label>
            <template x-if="getSlotUI(slotName) === 'select'">
                <select class="form-select text-sm" @change="setSlotValue(slotName, $event.target.value)">
                    <option value="">-- Choisir --</option>
                    <template x-for="opt in getSlotOptions(slotName)" :key="opt.value">
                        <option :value="opt.value" x-text="opt.label" :selected="currentValue[slotName] === opt.value"></option>
                    </template>
                </select>
            </template>
            <template x-if="getSlotUI(slotName) === 'checkbox'">
                <div class="flex flex-wrap gap-2">
                    <template x-for="opt in getSlotOptions(slotName)" :key="opt.value">
                        <label class="group inline-flex items-center gap-1.5 px-2 py-0 rounded text-xs font-medium cursor-pointer border transition-all duration-200 select-none"
                               :class="isSlotSelected(slotName, opt.value) ? 'bg-primary/10 border-primary text-primary' : 'bg-white dark:bg-[#1b2e4b] border-gray-200 dark:border-gray-800 text-gray-500 dark:text-gray-400 hover:border-primary/30 hover:bg-primary/5 hover:text-primary/70'">
                            <input type="checkbox" class="hidden" :value="opt.value" :checked="isSlotSelected(slotName, opt.value)" @change="toggleSlotValue(slotName, opt.value)">
                            <svg x-show="isSlotSelected(slotName, opt.value)" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span x-text="opt.label"></span>
                        </label>
                    </template>
                </div>
            </template>
        </div>
    </template>

    <template x-if="allowCustomText">
        <div>
            <label class="block text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1.5">Autre</label>
            <input type="text" class="form-input text-sm" x-model="currentValue.customText" @input="serialize()" placeholder="Texte libre...">
        </div>
    </template>

    <input type="hidden" name="custom[${field._id}]" :value="serialized">
</div>`;
                    }
                    const val = this.valuesMap[field._id] || '';
                    const valJson = JSON.stringify(val).replace(/"/g, '&quot;');
                    const isTruthy = val === true || val === 'on' || val === 'true' || val === 1 || val === '1';

                    let html = template.replace(/{{\s*([\w\.]+)\s*}}/g, (_, key) => {
                        if (key === 'label') return `<label>${field.label}</label>`;
                        if (key === 'name') return `custom[${field._id}]`;
                        if (key === 'value') return val;
                        if (key === 'value_json') return valJson;
                        if (key === 'checked') return isTruthy ? 'checked' : '';
                        if (key === '_id') return field._id;

                        // Support for nested keys like ui.placeholder
                        const parts = key.split('.');
                        let current = field;
                        for (const part of parts) {
                            current = current ? current[part] : undefined;
                        }
                        return current !== undefined ? current : '';
                    });

                    // Auto-inject name if missing to ensure data is sent to server
                    if (!this.designMode && !html.includes(`name="custom[${field._id}]"`)) {
                        html = html.replace(/<(input|textarea|select)(?![^>]*\bname\b)/g, `<$1 name="custom[${field._id}]"`);
                    }

                    // Auto-inject value/checked for common patterns if not handled by placeholders
                    // Auto-inject value/checked for common patterns if not handled by placeholders
                    if (!this.designMode) {
                        // For checkboxes/radios: inject checked if truthy
                        if (isTruthy) {
                            html = html.replace(/<(input[^>]*type="(checkbox|radio)"[^>]*)(?![^>]*\bchecked\b)/g, `<$1 checked`);
                        }

                        // For standard inputs (text, number, range, etc.): inject value
                        html = html.replace(/<(input(?![^>]*type="(checkbox|radio|file)"))(?![^>]*\bvalue\b)/g, `<$1 value="${val}"`)
                            .replace(/<textarea([^>]*)><\/textarea>/g, `<textarea$1>${val}</textarea>`);
                    }

                    return html;
                },

                removeField(id) {
                    this.layout = this.layout.filter(i => String(i.id) !== String(id));
                    this.rebuildCanvas();
                    this.saveLayout();
                },

                addTemplateToSlot(template) {
                    const uniqueId = `f_${Date.now()}`;
                    this.layout.push({ fieldId: template._id, width: 12, id: uniqueId, tabId: this.activeTab });
                    this.openModal = false;
                    this.rebuildCanvas();
                    this.saveLayout();
                },

                // Tab Management Methods
                addTab() {
                    const id = `t_${Date.now()}`;
                    this.tabs.push({ id, title: 'Nouvel Onglet', icon: 'tabler:apps' });
                    this.activeTab = id;
                    this.saveLayout();
                },

                removeTab(id) {
                    if (this.tabs.length <= 1) return;
                    if (confirm('Supprimer cet onglet et tous ses attributs ?')) {
                        this.tabs = this.tabs.filter(t => t.id !== id);
                        this.layout = this.layout.filter(i => i.tabId !== id);
                        if (this.activeTab === id) {
                            this.activeTab = this.tabs[0].id;
                        }
                        this.saveLayout();
                        this.rebuildCanvas();
                    }
                },

                startEditingTab(tab) {
                    if (!this.designMode) return;
                    this.editingTabId = tab.id;
                    this.tempTabTitle = tab.title;
                    this.tempTabIcon = tab.icon || 'tabler:apps';
                },

                setActiveTab(id) {
                    this.activeTab = id;
                },

                saveTabTitle() {
                    if (this.editingTabId) {
                        const tab = this.tabs.find(t => t.id === this.editingTabId);
                        if (tab) {
                            if (this.tempTabTitle.trim()) tab.title = this.tempTabTitle.trim();
                            tab.icon = this.tempTabIcon;
                        }
                        this.editingTabId = null;
                        this.saveLayout();
                    }
                },

                startResizingManual(e, id) {
                    e.preventDefault();
                    e.stopPropagation();
                    this.isResizing = true;
                    document.body.style.userSelect = 'none';
                    document.body.style.cursor = 'col-resize';

                    const el = e.target.closest('.field-item');
                    this.resizeData = {
                        id,
                        initialWidth: this.layout.find(i => String(i.id) === String(id)).width,
                        startX: e.clientX,
                        containerWidth: el.parentElement.offsetWidth
                    };
                },

                handleResizing(e) {
                    if (!this.isResizing || !this.resizeData) return;
                    const d = this.resizeData;
                    const deltaX = e.clientX - d.startX;
                    const colW = d.containerWidth / 12;
                    const deltaCols = Math.round(deltaX / colW);
                    let newW = Math.max(2, Math.min(12, d.initialWidth + deltaCols));

                    const item = this.layout.find(i => String(i.id) === String(d.id));
                    if (item && item.width !== newW) {
                        item.width = newW;
                        const el = document.querySelector(`[data-id="${d.id}"]`);
                        if (el) el.style.width = (newW * 8.333) + '%';
                    }
                },

                stopResizing() {
                    if (this.isResizing) {
                        this.isResizing = false;
                        document.body.style.userSelect = '';
                        document.body.style.cursor = '';
                        this.saveLayout();
                        this.rebuildCanvas();
                    }
                },

                saveLayout() {
                    const payload = {
                        fields: [...new Set(this.layout.map(i => i.fieldId))].map(id => ({ _id: id })),
                        layout: {
                            tabs: this.tabs,
                            fields: this.layout
                        }
                    };
                    fetch(`/account/<%= account_number %>/entity/updatecf/<%= entity._id %>`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(payload),
                    });
                },

                executeScripts() {
                    this.layout.forEach(item => {
                        const field = this.fieldsById[item.fieldId];
                        if (field && field.jsTemplate) {
                            try {
                                const scriptFunc = new Function('context', field.jsTemplate);
                                scriptFunc({ field: field, elementId: `field-${item.id}` });
                            } catch (e) { console.error(e); }
                        }
                    });
                }
            };
        });

        // ========== RECURRENCE FIELD ==========
        Alpine.data('recurrenceField', (config) => ({
            fieldId: config.fieldId,
            options: config.options || [],
            slotsConfig: config.slots || {},
            allowCustomText: config.allowCustomText || false,
            currentValue: {},
            serialized: '{}',
            slotNames: [],

            init() {
                // Load config from script tag if configElementId is provided
                if (config.configElementId) {
                    try {
                        const el = document.getElementById(config.configElementId);
                        if (el) {
                            const parsed = JSON.parse(el.textContent);
                            this.options = parsed.options || [];
                            this.slotsConfig = parsed.slots || {};
                            this.allowCustomText = parsed.allowCustomText || false;
                        }
                    } catch(e) { console.error('Failed to parse recurrence config', e); }
                }
                this.slotNames = [...new Set(this.options.map(o => o.slot).filter(Boolean))];
                const initial = config.initialValue;
                if (initial && typeof initial === 'object') {
                    this.currentValue = JSON.parse(JSON.stringify(initial));
                } else if (initial && typeof initial === 'string') {
                    try { this.currentValue = JSON.parse(initial); } catch(e) { this.currentValue = {}; }
                } else {
                    this.currentValue = {};
                }
                this.currentValue._v = this.currentValue._v || 1;
                this.serialize();
            },

            getSlotOptions(slotName) {
                return this.options.filter(o => o.slot === slotName);
            },

            getSlotConfig(slotName) {
                return this.slotsConfig[slotName] || {};
            },

            getSlotUI(slotName) {
                const conf = this.slotsConfig[slotName] || {};
                return conf.ui || (conf.multiple ? 'checkbox' : 'select');
            },

            isSlotSelected(slotName, value) {
                const v = this.currentValue[slotName];
                if (Array.isArray(v)) return v.includes(value);
                return v === value;
            },

            setSlotValue(slotName, value) {
                this.currentValue[slotName] = value;
                this.serialize();
            },

            toggleSlotValue(slotName, value) {
                const conf = this.slotsConfig[slotName] || {};
                if (!conf.multiple) {
                    // Single-select: toggle the clicked value, deselect others
                    this.currentValue[slotName] = this.currentValue[slotName] === value ? '' : value;
                } else {
                    // Multi-select: add/remove from array
                    if (!Array.isArray(this.currentValue[slotName])) {
                        this.currentValue[slotName] = [];
                    }
                    const idx = this.currentValue[slotName].indexOf(value);
                    if (idx === -1) {
                        this.currentValue[slotName].push(value);
                    } else {
                        this.currentValue[slotName].splice(idx, 1);
                    }
                }
                this.serialize();
            },

            serialize() {
                this.serialized = JSON.stringify(this.currentValue);
            }
        }));

        Alpine.data('relationField', (config) => ({
            fieldId: config.fieldId,
            refEntity: config.refEntity,
            multiple: config.multiple,
            searchQuery: '',
            results: [],
            selectedItems: [],
            showResults: false,
            page: 1,
            hasMore: false,
            loading: false,

            async init() {
                if (config.initialValue) {
                    const idsRaw = config.initialValue;
                    let ids = [];
                    if (Array.isArray(idsRaw)) {
                        ids = idsRaw.filter(i => i && i !== '');
                    } else if (idsRaw) {
                        ids = [idsRaw];
                    }

                    if (ids.length > 0) {
                        try {
                            const acc = '<%= account_number %>';
                            const response = await fetch(`/account/${acc}/record/api/search?entityId=${this.refEntity}&ids=${ids.join(',')}`);
                            const res = await response.json();
                            if (res.data) {
                                this.selectedItems = res.data;
                            }
                        } catch (e) {
                            console.error("Error loading relation values:", e);
                        }
                    }
                }
            },

            async fetchSuggestions(reset = true) {
                if (reset) {
                    this.page = 1;
                    this.results = [];
                }

                this.loading = true;
                try {
                    const acc = '<%= account_number %>';
                    let url = `/account/${acc}/record/api/search?entityId=${this.refEntity}&page=${this.page}&limit=5`;
                    if (this.searchQuery) {
                        url += `&q=${this.searchQuery}`;
                    }

                    const response = await fetch(url);
                    const res = await response.json();

                    if (res.data) {
                        if (reset) {
                            this.results = res.data;
                        } else {
                            this.results = [...this.results, ...res.data];
                        }
                        this.hasMore = res.meta?.hasMore || false;
                    }
                } catch (e) {
                    console.error("Search failed:", e);
                } finally {
                    this.loading = false;
                }
            },

            async search() {
                await this.fetchSuggestions(true);
            },

            async loadMore() {
                if (!this.hasMore || this.loading) return;
                this.page++;
                await this.fetchSuggestions(false);
            },

            openDropdown() {
                this.showResults = true;
                if (this.results.length === 0) {
                    this.fetchSuggestions(true);
                }
            },

            selectItem(result) {
                if (this.multiple) {
                    if (!this.selectedItems.find(i => i.id === result.id)) {
                        this.selectedItems.push(result);
                    }
                } else {
                    this.selectedItems = [result];
                }

                this.searchQuery = '';
                this.showResults = false;
            },

            removeItem(id) {
                this.selectedItems = this.selectedItems.filter(i => i.id !== id);
            }
        }));

        // ========== MODAL PICKER FIELD ==========
        Alpine.data('modalPickerField', (config) => ({
            fieldId: config.fieldId,
            refEntity: config.refEntity,
            refEntityName: config.refEntityName || '',
            refEntityIcon: config.refEntityIcon || 'solar:link-round-bold-duotone',
            refEntityColor: config.refEntityColor || '#4361ee',
            multiple: config.multiple || false,
            displayFields: [],
            selectedItems: [],
            tempSelected: [],
            showModal: false,
            modalSearch: '',
            modalResults: [],
            modalLoading: false,
            modalPage: 1,
            modalTotal: 0,
            modalHasMore: false,

            init() {
                // Read displayFields from data attribute to avoid JSON quote conflicts in x-data
                try {
                    const dfAttr = this.$el.dataset.displayFields;
                    if (dfAttr) this.displayFields = JSON.parse(dfAttr);
                } catch(e) { console.warn('Failed to parse displayFields:', e); }

                if (config.initialValue) {
                    this.loadInitialValues(config.initialValue);
                }
            },

            async loadInitialValues(val) {
                const ids = Array.isArray(val) ? val : [val];
                if (ids.length === 0 || !ids[0]) return;
                try {
                    const acc = '<%= account_number %>';
                    const res = await fetch(`/account/${acc}/record/api/search?entityId=${this.refEntity}&ids=${ids.join(',')}&displayFields=${this.displayFields.join(',')}`, { credentials: 'include' });
                    const json = await res.json();
                    this.selectedItems = (json.data || []).map(r => ({ id: r.id, label: r.label }));
                } catch(e) { console.error('Modal picker init error:', e); }
            },

            openModal() {
                this.tempSelected = [...this.selectedItems];
                this.modalSearch = '';
                this.modalPage = 1;
                this.modalResults = [];
                this.showModal = true;
                this.fetchModalResults(true);

                // Direct DOM manipulation - bypass Alpine reactivity
                const overlay = this.$refs.modalOverlay;
                if (overlay) {
                    overlay.style.display = 'flex';
                }

                setTimeout(() => {
                    const input = this.$refs.modalSearchInput;
                    if (input) input.focus();
                }, 50);
            },

            closeModal() {
                this.showModal = false;
                const overlay = this.$refs.modalOverlay;
                if (overlay) overlay.style.display = 'none';
            },

            async fetchModalResults(reset = false) {
                if (reset) {
                    this.modalPage = 1;
                    this.modalResults = [];
                }
                this.modalLoading = true;
                try {
                    const acc = '<%= account_number %>';
                    const q = this.modalSearch ? `&q=${encodeURIComponent(this.modalSearch)}` : '';
                    const df = this.displayFields.length > 0 ? `&displayFields=${this.displayFields.join(',')}` : '';
                    const url = `/account/${acc}/record/api/search?entityId=${this.refEntity}&page=${this.modalPage}&limit=20${q}${df}`;
                    const res = await fetch(url, { credentials: 'include' });
                    const json = await res.json();
                    if (reset) {
                        this.modalResults = json.data || [];
                    } else {
                        this.modalResults = [...this.modalResults, ...(json.data || [])];
                    }
                    this.modalTotal = json.meta?.total || 0;
                    this.modalHasMore = json.meta?.hasMore || false;
                } catch(e) {
                    console.error('Modal fetch error:', e);
                } finally {
                    this.modalLoading = false;
                }
            },

            loadMoreModal() {
                this.modalPage++;
                this.fetchModalResults(false);
            },

            isSelected(id) {
                return this.tempSelected.some(i => i.id === id);
            },

            toggleModalSelect(result) {
                const idx = this.tempSelected.findIndex(i => i.id === result.id);
                if (idx >= 0) {
                    this.tempSelected.splice(idx, 1);
                } else {
                    if (this.multiple) {
                        this.tempSelected.push({ id: result.id, label: result.label });
                    } else {
                        this.tempSelected = [{ id: result.id, label: result.label }];
                        // Single select: auto-confirm immediately
                        this.confirmSelection();
                    }
                }
            },

            confirmSelection() {
                this.selectedItems = [...this.tempSelected];
                this.showModal = false;
                const overlay = this.$refs.modalOverlay;
                if (overlay) overlay.style.display = 'none';
            },

            removeItem(id) {
                this.selectedItems = this.selectedItems.filter(i => i.id !== id);
            }
        }));

        window.addEventListener('load', () => {
            const el = document.querySelector('[x-data^="recordForm()"]');
            if (el) window.recordFormApp = Alpine.$data(el);
        });
    });
</script>

