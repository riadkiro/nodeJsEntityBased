  <!-- Bouton Sauvegarder Fixe/Flottant bas -->
  <div class="flex justify-center pt-2">
    <button @click="submitCustomFields()" class="btn btn-primary">
      <iconify-icon icon="tabler:device-floppy" width="18"></iconify-icon>
      <span>Enregistrer le Design</span>
    </button>
  </div>
</div>

