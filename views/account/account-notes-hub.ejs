<%# Notes Hub — Aggregated notes across all records %>
<% const _apiBase = '/account/' + account_number; %>
<% const _userId = typeof user !== 'undefined' && user ? user._id : ''; %>

<style>
/* ═══ Notes Hub ═══ */
.nh-page { width:100%; height:calc(100vh - 86px); min-height:540px; margin:0; }
.nh-loading { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; }
/* WhatsApp-style master/detail workspace */
.nh-workspace { height:100%; min-height:0; display:grid; grid-template-columns:minmax(310px,370px) minmax(0,1fr); overflow:hidden; border:1px solid #dbe2ea; border-radius:14px; background:#fff; box-shadow:0 14px 38px rgba(15,23,42,.08); }
.nh-sidebar { min-width:0; display:grid; grid-template-rows:auto 1fr; overflow:hidden; border-right:1px solid #dbe2ea; background:#f7f8fa; }
.nh-sidebar-header { padding:17px 16px 14px; border-bottom:1px solid #e3e8ef; background:#fff; }
.nh-sidebar-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:11px; }
.nh-sidebar-title-wrap { display:flex; align-items:center; gap:9px; min-width:0; }
.nh-sidebar-icon { width:30px; height:30px; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; border-radius:9px; color:#8b5cf6; background:#8b5cf612; }
.nh-sidebar-title { font-size:15px; font-weight:800; color:#0e1726; }
.nh-sidebar-total { min-width:25px; height:22px; padding:0 7px; display:inline-flex; align-items:center; justify-content:center; border-radius:999px; background:#8b5cf612; color:#8b5cf6; font-size:11px; font-weight:800; }
.nh-search { height:38px; display:flex; align-items:center; gap:8px; padding:0 10px; border:1px solid #e0e6ed; border-radius:10px; background:#f8fafc; transition:all .15s; }
.nh-search:focus-within { border-color:#8b5cf670; background:#fff; box-shadow:0 0 0 3px #8b5cf610; }
.nh-search input { min-width:0; flex:1; border:0; outline:0; background:transparent; color:#1e293b; font:inherit; font-size:12px; }
.nh-search input::placeholder { color:#94a3b8; }
.nh-search-clear { width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center; border:0; border-radius:7px; background:transparent; color:#94a3b8; cursor:pointer; }
.nh-search-clear:hover { color:#8b5cf6; background:#8b5cf610; }
.nh-sidebar-list { min-height:0; overflow-y:auto; overscroll-behavior:contain; }
.nh-note-list-item { width:100%; display:grid; grid-template-columns:42px minmax(0,1fr); align-items:start; gap:11px; padding:13px 15px; border:0; border-bottom:1px solid #e8edf2; background:transparent; color:inherit; text-align:left; cursor:pointer; font-family:inherit; transition:background .15s, box-shadow .15s; }
.nh-note-list-item:hover { background:#f0edf9; }
.nh-note-list-item--active { background:#eae5f8; box-shadow:inset 4px 0 0 #8b5cf6; }
.nh-note-avatar { width:42px; height:42px; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#8b5cf6; background:#ece8f8; }
.nh-note-list-content { min-width:0; }
.nh-note-list-top { display:flex; align-items:center; gap:7px; min-width:0; }
.nh-note-list-title { min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:13px; font-weight:800; color:#172033; }
.nh-note-list-icons { flex-shrink:0; display:inline-flex; align-items:center; gap:5px; color:#8b5cf6; }
.nh-note-list-preview { min-height:18px; margin-top:5px; overflow:hidden; display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; color:#7c879c; font-size:11px; line-height:1.55; }
.nh-note-list-meta { display:flex; align-items:center; gap:6px; min-width:0; margin-top:8px; color:#a0aabc; font-size:10px; }
.nh-note-list-context { min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.nh-note-list-activity { flex-shrink:0; font-weight:700; color:#7c879c; }
.nh-sidebar-empty { padding:42px 20px; text-align:center; color:#94a3b8; font-size:12px; }
.nh-sidebar-empty iconify-icon { opacity:.35; margin-bottom:8px; }

/* Note viewer */
.nh-detail { min-width:0; min-height:0; overflow:hidden; background:#fff; }
.nh-viewer { height:100%; min-height:0; display:grid; grid-template-rows:auto 1fr; overflow:hidden; background:#fff; }
.nh-viewer-header { min-width:0; padding:14px 20px; border-bottom:1px solid #e0e6ed; display:flex; align-items:center; gap:11px; background:#f8fafc; }
.nh-viewer-heading { min-width:0; flex:1; }
.nh-viewer-title { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:15px; font-weight:800; color:#0e1726; }
.nh-viewer-subtitle { display:flex; align-items:center; gap:5px; min-width:0; margin-top:3px; color:#94a3b8; font-size:10px; }
.nh-viewer-subtitle span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.nh-record-link { flex-shrink:0; display:inline-flex; align-items:center; gap:5px; padding:7px 12px; border-radius:9px; color:#8b5cf6; background:#8b5cf608; border:1px solid #8b5cf620; text-decoration:none; font-size:11px; font-weight:700; transition:all .15s; }
.nh-record-link:hover { background:#8b5cf615; }
.nh-viewer-body { min-height:0; padding:28px 32px; overflow-y:auto; font-size:14px; line-height:1.75; color:#334155; }
.nh-viewer-body:empty::after { content:'Cette note est vide'; color:#bfc9d4; font-style:italic; }
.nh-viewer-body img { max-width:100%; height:auto; }
.nh-detail-empty { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:32px; text-align:center; color:#94a3b8; }
.nh-detail-empty-icon { width:72px; height:72px; display:flex; align-items:center; justify-content:center; border-radius:22px; margin-bottom:16px; color:#8b5cf6; background:linear-gradient(135deg,#8b5cf618,#8b5cf608); }
.nh-detail-empty h3 { margin:0 0 5px; color:#334155; font-size:16px; font-weight:800; }
.nh-detail-empty p { max-width:300px; margin:0; font-size:12px; line-height:1.5; }

/* PIN modal */
.nh-pin-overlay { position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,.35); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; animation:nhFadeIn .2s ease; }
.nh-pin-modal { background:#fff; border-radius:16px; box-shadow:0 20px 60px rgba(0,0,0,.15); width:360px; max-width:calc(100vw - 40px); padding:32px; text-align:center; animation:nhSlideUp .3s ease; }
@keyframes nhFadeIn { from { opacity:0; } to { opacity:1; } }
@keyframes nhSlideUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
.nh-pin-icon { width:56px; height:56px; border-radius:16px; background:linear-gradient(135deg,#8b5cf618,#8b5cf608); display:flex; align-items:center; justify-content:center; margin:0 auto 16px; }
.nh-pin-title { font-size:16px; font-weight:700; color:#0e1726; margin-bottom:4px; }
.nh-pin-desc { font-size:12px; color:#888da8; margin-bottom:20px; }
.nh-pin-input { width:160px; padding:12px; border:1.5px solid #e0e6ed; border-radius:12px; font-size:20px; font-weight:700; text-align:center; letter-spacing:8px; outline:none; font-family:'Nunito',sans-serif; color:#0e1726; }
.nh-pin-input:focus { border-color:#8b5cf6; box-shadow:0 0 0 3px #8b5cf610; }
.nh-pin-error { color:#ef4444; font-size:12px; font-weight:600; margin-top:8px; min-height:18px; }
.nh-pin-actions { display:flex; gap:10px; justify-content:center; margin-top:16px; }
.nh-pin-btn { padding:9px 20px; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer; border:none; font-family:inherit; transition:all .15s; }
.nh-pin-btn-cancel { background:#f1f5f9; color:#64748b; }
.nh-pin-btn-cancel:hover { background:#e2e8f0; }
.nh-pin-btn-ok { background:linear-gradient(135deg,#8b5cf6,#7c3aed); color:#fff; }
.nh-pin-btn-ok:hover { transform:translateY(-1px); box-shadow:0 4px 12px #8b5cf640; }

/* Empty */
.nh-empty { text-align:center; padding:48px 20px; color:#94a3b8; }
.nh-empty iconify-icon { opacity:.3; }
.nh-empty h3 { font-size:16px; font-weight:700; color:#0e1726; margin:10px 0 4px; }
.nh-empty p { font-size:13px; margin:0; }

/* Dark mode */
[data-theme="dark"] .nh-workspace, .dark .nh-workspace,
[data-theme="dark"] .nh-sidebar, .dark .nh-sidebar,
[data-theme="dark"] .nh-sidebar-header, .dark .nh-sidebar-header,
[data-theme="dark"] .nh-detail, .dark .nh-detail,
[data-theme="dark"] .nh-viewer, .dark .nh-viewer { background:#0e1726; border-color:#253b5c; }
[data-theme="dark"] .nh-sidebar, .dark .nh-sidebar { background:#0b1424; }
[data-theme="dark"] .nh-sidebar-title, .dark .nh-sidebar-title,
[data-theme="dark"] .nh-note-list-title, .dark .nh-note-list-title { color:#e0e6ed; }
[data-theme="dark"] .nh-search, .dark .nh-search { background:#111d30; border-color:#253b5c; }
[data-theme="dark"] .nh-search input, .dark .nh-search input { color:#e0e6ed; }
[data-theme="dark"] .nh-note-list-item, .dark .nh-note-list-item { border-color:#1b2e4b; }
[data-theme="dark"] .nh-note-list-item:hover, .dark .nh-note-list-item:hover { background:#171b35; }
[data-theme="dark"] .nh-note-list-item--active, .dark .nh-note-list-item--active { background:#201a3b; }
[data-theme="dark"] .nh-note-avatar, .dark .nh-note-avatar { background:#241d40; }
[data-theme="dark"] .nh-viewer-header, .dark .nh-viewer-header { border-color:#253b5c; background:#111d30; }
[data-theme="dark"] .nh-viewer-title, .dark .nh-viewer-title { color:#e0e6ed; }
[data-theme="dark"] .nh-viewer-body, .dark .nh-viewer-body { color:#cbd5e1; }
[data-theme="dark"] .nh-detail-empty h3, .dark .nh-detail-empty h3 { color:#e0e6ed; }
[data-theme="dark"] .nh-pin-modal, .dark .nh-pin-modal { background:#0e1726; border:1px solid #253b5c; }
[data-theme="dark"] .nh-pin-title, .dark .nh-pin-title { color:#e0e6ed; }
[data-theme="dark"] .nh-pin-input, .dark .nh-pin-input { background:#1b2e4b; border-color:#253b5c; color:#e0e6ed; }
[data-theme="dark"] .nh-empty h3, .dark .nh-empty h3 { color:#e0e6ed; }

@media (max-width: 900px) {
    .nh-page { height:auto; min-height:calc(100vh - 78px); }
    .nh-workspace { height:auto; min-height:0; grid-template-columns:1fr; }
    .nh-sidebar { max-height:360px; border-right:0; border-bottom:1px solid #e0e6ed; }
    [data-theme="dark"] .nh-sidebar, .dark .nh-sidebar { border-bottom-color:#253b5c; }
    .nh-sidebar-list { max-height:270px; }
    .nh-detail { min-height:480px; }
}

@media (max-width: 560px) {
    .nh-workspace { border-radius:10px; }
    .nh-detail { min-height:420px; }
    .nh-viewer-header { align-items:flex-start; padding:14px; }
    .nh-record-link span { display:none; }
    .nh-viewer-body { padding:20px 18px; }
}
</style>

<div class="nh-page" x-data="notesHub" x-cloak>
    <!-- Loading -->
    <div x-show="loading" class="nh-loading">
        <iconify-icon icon="line-md:loading-twotone-loop" width="28" style="color:#8b5cf6"></iconify-icon>
        <p style="font-size:12px;color:#888da8;margin-top:8px;">Chargement...</p>
    </div>

    <!-- Focused list and viewer -->
    <template x-if="!loading">
        <div class="nh-workspace">
            <aside class="nh-sidebar">
                <div class="nh-sidebar-header">
                    <div class="nh-sidebar-heading">
                        <span class="nh-sidebar-title-wrap">
                            <span class="nh-sidebar-icon"><iconify-icon icon="solar:notebook-bold-duotone" width="17"></iconify-icon></span>
                            <span class="nh-sidebar-title">Notes</span>
                        </span>
                        <span class="nh-sidebar-total" x-text="filteredNotes.length"></span>
                    </div>
                    <div class="nh-search">
                        <iconify-icon icon="solar:magnifer-linear" width="16" style="color:#94a3b8"></iconify-icon>
                        <input type="search" x-model.debounce.150ms="searchQuery" placeholder="Rechercher une note..." aria-label="Rechercher une note">
                        <button x-show="searchQuery" type="button" class="nh-search-clear" @click="searchQuery = ''" aria-label="Effacer la recherche">
                            <iconify-icon icon="solar:close-circle-linear" width="15"></iconify-icon>
                        </button>
                    </div>
                </div>

                <div class="nh-sidebar-list">
                    <template x-if="filteredNotes.length === 0">
                        <div class="nh-sidebar-empty">
                            <iconify-icon icon="solar:notebook-bold-duotone" width="38"></iconify-icon>
                            <div x-text="notes.length ? 'Aucune note ne correspond à votre recherche' : 'Aucune note disponible'"></div>
                        </div>
                    </template>
                    <template x-for="note in filteredNotes" :key="noteId(note)">
                        <button type="button" class="nh-note-list-item" :class="isActiveNote(note) ? 'nh-note-list-item--active' : ''" @click="openNote(note)">
                            <span class="nh-note-avatar" :style="'color:' + (note.color || '#8b5cf6') + ';background:' + (note.color || '#8b5cf6') + '15'">
                                <iconify-icon :icon="note.isProtected ? 'solar:lock-keyhole-bold-duotone' : (note.icon || 'solar:notebook-bold-duotone')" width="20"></iconify-icon>
                            </span>
                            <span class="nh-note-list-content">
                                <span class="nh-note-list-top">
                                    <span class="nh-note-list-title" x-text="note.title || 'Sans titre'"></span>
                                    <span class="nh-note-list-icons">
                                        <iconify-icon x-show="note.pinned" icon="solar:pin-bold" width="13" style="color:#f59e0b"></iconify-icon>
                                        <iconify-icon x-show="note.isProtected" icon="solar:lock-keyhole-bold-duotone" width="13"></iconify-icon>
                                    </span>
                                </span>
                                <span class="nh-note-list-preview" x-text="notePreview(note)"></span>
                                <span class="nh-note-list-meta">
                                    <iconify-icon :icon="note.entityIcon || 'solar:folder-bold-duotone'" width="12" :style="'color:' + (note.entityColor || '#8b5cf6')"></iconify-icon>
                                    <span class="nh-note-list-context" x-text="(note.entityName || 'Inconnu') + ' · ' + (note.recordTitle || 'Sans titre')"></span>
                                    <span class="nh-note-list-activity" x-text="activityLabel(note)"></span>
                                </span>
                            </span>
                        </button>
                    </template>
                </div>
            </aside>

            <section class="nh-detail">
                <template x-if="activeNote">
                    <div class="nh-viewer">
                        <div class="nh-viewer-header">
                            <div style="width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;" :style="'background:' + (activeNote.color || '#8b5cf6') + '15'">
                                <iconify-icon :icon="activeNote.isProtected ? 'solar:lock-keyhole-bold-duotone' : (activeNote.icon || 'solar:notebook-bold-duotone')" width="18" :style="'color:' + (activeNote.color || '#8b5cf6')"></iconify-icon>
                            </div>
                            <div class="nh-viewer-heading">
                                <div class="nh-viewer-title" x-text="activeNote.title || 'Sans titre'"></div>
                                <div class="nh-viewer-subtitle">
                                    <span x-text="(activeNote.entityName || 'Inconnu') + ' · ' + (activeNote.recordTitle || 'Sans titre')"></span>
                                    <span>•</span>
                                    <span x-text="activityLabel(activeNote)"></span>
                                </div>
                            </div>
                            <a class="nh-record-link" :href="getNoteRecordLink()" x-show="getNoteRecordLink() !== '#'">
                                <iconify-icon icon="solar:arrow-right-linear" width="13"></iconify-icon>
                                <span>Ouvrir la fiche</span>
                            </a>
                        </div>
                        <div class="nh-viewer-body" x-html="activeNoteContent"></div>
                    </div>
                </template>
                <template x-if="!activeNote">
                    <div class="nh-detail-empty">
                        <div class="nh-detail-empty-icon">
                            <iconify-icon icon="solar:notebook-bold-duotone" width="34"></iconify-icon>
                        </div>
                        <h3>Sélectionnez une note</h3>
                        <p>Choisissez une note dans la liste à gauche pour afficher son contenu.</p>
                    </div>
                </template>
            </section>
        </div>
    </template>

    <!-- PIN Modal -->
    <template x-if="showPinModal">
        <div class="nh-pin-overlay" @click.self="closePinModal()">
            <div class="nh-pin-modal" @click.stop>
                <div class="nh-pin-icon">
                    <iconify-icon icon="solar:lock-keyhole-bold-duotone" width="24" style="color:#8b5cf6"></iconify-icon>
                </div>
                <div class="nh-pin-title">Note protégée</div>
                <div class="nh-pin-desc" x-text="'Entrez le PIN pour accéder à : ' + (pinTarget?.title || 'cette note')"></div>
                <input type="password" class="nh-pin-input" maxlength="6" placeholder="····" x-model="pinValue" @keydown.enter="verifyPin()" x-ref="pinInput" inputmode="numeric" pattern="[0-9]*">
                <div class="nh-pin-error" x-text="pinError"></div>
                <div class="nh-pin-actions">
                    <button class="nh-pin-btn nh-pin-btn-cancel" @click="closePinModal()">Annuler</button>
                    <button class="nh-pin-btn nh-pin-btn-ok" @click="verifyPin()" :disabled="pinLoading">
                        <span x-text="pinLoading ? 'Vérification...' : 'Déverrouiller'"></span>
                    </button>
                </div>
            </div>
        </div>
    </template>
</div>

<script>
document.body.classList.add('focus-workspace-mode', 'notes-focus-mode');
window.addEventListener('pagehide', () => {
    document.body.classList.remove('focus-workspace-mode', 'notes-focus-mode');
}, { once: true });

document.addEventListener('alpine:init', () => {
    const _accountNumber = '<%= account_number %>';
    const _apiBase = '/account/' + _accountNumber;

    Alpine.data('notesHub', () => ({
        notes: [],
        entities: [],
        loading: true,
        totalNotes: 0,
        searchQuery: '',
        activeNote: null,
        activeNoteContent: '',
        unlockedNoteContent: {},

        // PIN
        showPinModal: false,
        pinTarget: null,
        pinValue: '',
        pinError: '',
        pinLoading: false,

        get filteredNotes() {
            const query = this.searchQuery.trim().toLowerCase();
            if (!query) return this.notes;
            return this.notes.filter(note => {
                const preview = note.isProtected ? '' : this.stripHtml(note.content || '');
                return [note.title, note.entityName, note.recordTitle, preview]
                    .filter(Boolean)
                    .join(' ')
                    .toLowerCase()
                    .includes(query);
            });
        },

        async init() {
            await this.loadHub();
        },

        async loadHub() {
            this.loading = true;
            try {
                const res = await fetch(_apiBase + '/api/notes-hub', { credentials: 'include' });
                const data = await res.json();
                if (data.success) {
                    this.entities = data.entities || [];
                    const apiNotes = Array.isArray(data.notes) ? data.notes : this.flattenNotes(this.entities);
                    this.notes = this.sortNotesByActivity(apiNotes);
                    this.totalNotes = data.totalNotes || 0;
                    this.selectInitialNote();
                }
            } catch (e) {
                console.error('[NotesHub] Load error:', e);
            }
            this.loading = false;
        },

        selectInitialNote() {
            if (this.activeNote || this.notes.length === 0) return;
            const requestedId = new URLSearchParams(window.location.search).get('noteId') || '';
            const requestedNote = requestedId
                ? this.notes.find(note => this.noteId(note) === requestedId)
                : null;
            if (requestedNote) {
                this.openNote(requestedNote);
                return;
            }
            const firstReadableNote = this.notes.find(note =>
                !note.isProtected && this.stripHtml(note.content || '').trim()
            ) || this.notes.find(note => !note.isProtected);
            if (firstReadableNote) this.openNote(firstReadableNote);
        },

        noteId(note) {
            return String(note?._id || note?.id || '');
        },

        isActiveNote(note) {
            return !!this.activeNote && this.noteId(this.activeNote) === this.noteId(note);
        },

        notePreview(note) {
            if (note?.isProtected) return 'Note protégée · cliquez pour déverrouiller';
            return this.stripHtml(note?.content || '') || 'Note vide';
        },

        openNote(note) {
            const id = this.noteId(note);
            if (note.isProtected) {
                if (Object.prototype.hasOwnProperty.call(this.unlockedNoteContent, id)) {
                    this.activeNote = note;
                    this.activeNoteContent = this.unlockedNoteContent[id];
                    return;
                }
                this.pinTarget = note;
                this.pinValue = '';
                this.pinError = '';
                this.showPinModal = true;
                this.$nextTick(() => { if (this.$refs.pinInput) this.$refs.pinInput.focus(); });
                return;
            }
            this.activeNote = note;
            this.activeNoteContent = note.content || '';
        },

        closePinModal() {
            this.showPinModal = false;
            this.pinTarget = null;
            this.pinValue = '';
            this.pinError = '';
        },

        async verifyPin() {
            if (!this.pinValue || this.pinValue.length < 4) {
                this.pinError = 'Le PIN doit contenir au moins 4 chiffres';
                return;
            }
            this.pinLoading = true;
            this.pinError = '';
            try {
                const note = this.pinTarget;
                const id = this.noteId(note);
                const res = await fetch(_apiBase + '/api/record/' + note.recordId + '/notes/' + id + '/verify-pin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ pin: this.pinValue })
                });
                const data = await res.json();
                if (data.success) {
                    this.activeNote = { ...note, ...(data.note || {}) };
                    this.activeNoteContent = data.content || data.note?.content || '';
                    this.unlockedNoteContent = {
                        ...this.unlockedNoteContent,
                        [id]: this.activeNoteContent
                    };
                    this.closePinModal();
                } else {
                    this.pinError = data.error || 'PIN incorrect';
                    this.pinValue = '';
                    if (this.$refs.pinInput) this.$refs.pinInput.focus();
                }
            } catch (e) {
                this.pinError = 'Erreur réseau';
            }
            this.pinLoading = false;
        },

        getNoteRecordLink() {
            if (!this.activeNote) return '#';
            const entitySlug = this.activeNote.entitySlug || '';
            if (!entitySlug || !this.activeNote.recordId) return '#';
            return _apiBase + '/record/' + entitySlug + '/' + this.activeNote.recordId + '/notes';
        },

        flattenNotes(entities) {
            return (entities || []).flatMap(entity =>
                (entity.records || []).flatMap(record =>
                    (record.notes || []).map(note => ({
                        ...note,
                        recordId: note.recordId || record.recordId,
                        recordTitle: note.recordTitle || record.recordTitle,
                        entityId: note.entityId || entity.entityId,
                        entityName: note.entityName || entity.entityName,
                        entitySlug: note.entitySlug || entity.entitySlug,
                        entityIcon: note.entityIcon || entity.entityIcon,
                        entityColor: note.entityColor || entity.entityColor
                    }))
                )
            );
        },

        noteActivityTime(note) {
            const updated = Date.parse(note?.updatedAt || '') || 0;
            const created = Date.parse(note?.createdAt || '') || 0;
            return Math.max(updated, created);
        },

        sortNotesByActivity(notes) {
            return [...(notes || [])].sort((left, right) => {
                if (!!left.pinned !== !!right.pinned) return left.pinned ? -1 : 1;
                const activityOrder = this.noteActivityTime(right) - this.noteActivityTime(left);
                if (activityOrder !== 0) return activityOrder;
                return String(right._id || right.id || '').localeCompare(String(left._id || left.id || ''));
            });
        },

        activityLabel(note) {
            const updatedTime = Date.parse(note?.updatedAt || '') || 0;
            const createdTime = Date.parse(note?.createdAt || '') || 0;
            const wasUpdated = updatedTime > 0 && (!createdTime || updatedTime > createdTime + 1000);
            const date = wasUpdated ? note.updatedAt : (note?.createdAt || note?.updatedAt);
            if (!date) return '';
            return (wasUpdated ? 'Modifiée ' : 'Créée ') + this.formatTime(date);
        },

        stripHtml(html) {
            if (!html) return '';
            const tmp = document.createElement('div');
            tmp.innerHTML = html;
            return tmp.textContent || tmp.innerText || '';
        },

        formatTime(dateStr) {
            if (!dateStr) return '';
            const d = new Date(dateStr);
            const now = new Date();
            const diffMs = now - d;
            const diffMins = Math.floor(diffMs / 60000);
            if (diffMins < 1) return "à l'instant";
            if (diffMins < 60) return diffMins + ' min';
            const diffHrs = Math.floor(diffMins / 60);
            if (diffHrs < 24) return diffHrs + 'h';
            return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
        }
    }));
});
</script>
