<!-- Sidebar Icons (64px) -->
<div class="w-16 bg-white dark:bg-gray-800 border-r dark:border-gray-800 flex flex-col items-center py-4 gap-3 shrink-0">
  <!-- Add Blocks -->
  <button 
    @click="builderState.selectedBlockId = null; builderState.sidebarOpen = true; builderState.drawerMode = 'blocks'"
    :class="builderState.drawerMode === 'blocks' && builderState.sidebarOpen && !builderState.selectedBlockId && 'bg-primary/20 text-primary'"
    class="w-10 h-10 rounded transition-colors flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-700"
    title="Add Blocks">
    <iconify-icon icon="solar:widget-add-bold-duotone" width="24"></iconify-icon>
  </button>

  <!-- Rows -->
  <button 
    @click="builderState.selectedBlockId = null; builderState.sidebarOpen = true; builderState.drawerMode = 'rows'"
    :class="builderState.drawerMode === 'rows' && builderState.sidebarOpen && 'bg-primary/20 text-primary'"
    class="w-10 h-10 rounded transition-colors flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-700"
    title="Rows">
    <iconify-icon icon="solar:layers-bold-duotone" width="24"></iconify-icon>
  </button>

  <div class="h-px w-8 bg-gray-200 dark:bg-gray-700"></div>

  <!-- Data Sources -->
  <button 
    @click="builderState.selectedBlockId = null; builderState.sidebarOpen = true; builderState.drawerMode = 'data'"
    :class="builderState.drawerMode === 'data' && builderState.sidebarOpen && 'bg-primary/20 text-primary'"
    class="w-10 h-10 rounded transition-colors flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-700"
    title="Data Sources">
    <iconify-icon icon="solar:database-bold-duotone" width="24"></iconify-icon>
  </button>

  <!-- Global Style -->
  <button 
    @click="builderState.selectedBlockId = null; builderState.sidebarOpen = true; builderState.drawerMode = 'style'"
    :class="builderState.drawerMode === 'style' && builderState.sidebarOpen && 'bg-primary/20 text-primary'"
    class="w-10 h-10 rounded transition-colors flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-700"
    title="Global Style">
    <iconify-icon icon="solar:pen-2-line-duotone" width="24"></iconify-icon>
  </button>

  <div class="h-px w-8 bg-gray-200 dark:bg-gray-700"></div>

  <!-- Layers -->
  <button 
    @click="builderState.selectedBlockId = null; builderState.sidebarOpen = true; builderState.drawerMode = 'layers'"
    :class="builderState.drawerMode === 'layers' && builderState.sidebarOpen && 'bg-primary/20 text-primary'"
    class="w-10 h-10 rounded transition-colors flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-700"
    title="Layers">
    <iconify-icon icon="solar:layers-bold-duotone" width="24"></iconify-icon>
  </button>
</div>

<!-- Expanded Sidebar Panel (350px) -->
<div 
  x-show="builderState.sidebarOpen"
  x-transition:enter="transform transition ease-out duration-200"
  x-transition:enter-start="-translate-x-full opacity-0"
  x-transition:enter-end="translate-x-0 opacity-100"
  x-transition:leave="transform transition ease-in duration-150"
  x-transition:leave-start="translate-x-0 opacity-100"
  x-transition:leave-end="-translate-x-full opacity-0"
  class="w-[350px] bg-white dark:bg-gray-800 border-r dark:border-gray-800 flex flex-col shrink-0 overflow-hidden">
  
  <!-- ====================================== -->
  <!-- WIDGET SETTINGS MODE (config clicked) -->
  <!-- ====================================== -->
  <template x-if="builderState.drawerMode === 'block-settings' && builderState.selectedBlockId && pageConfig.blocks[builderState.selectedBlockId]">
    <div class="flex flex-col h-full" x-data="{ settingsTab: 'appearance' }">
      
      <!-- Header with block name + back button -->
      <div class="h-14 border-b dark:border-gray-800 px-4 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2 min-w-0">
          <button 
            @click="builderState.selectedBlockId = null; builderState.sidebarOpen = true; builderState.drawerMode = 'blocks'"
            class="w-7 h-7 rounded-md flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors shrink-0"
            title="Back to widgets">
            <iconify-icon icon="solar:arrow-left-line-duotone" width="18"></iconify-icon>
          </button>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold text-sm truncate" 
                x-text="pageConfig.blocks[builderState.selectedBlockId].title || pageConfig.blocks[builderState.selectedBlockId].type"></h3>
            <span class="text-[10px] text-gray-400 uppercase tracking-wider" 
                  x-text="pageConfig.blocks[builderState.selectedBlockId].type"></span>
          </div>
        </div>
        <button @click="builderState.selectedBlockId = null" class="w-7 h-7 rounded-md flex items-center justify-center text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
          <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
        </button>
      </div>

      <!-- Tabs -->
      <div class="flex border-b dark:border-gray-800 shrink-0 px-1">
        <button 
          @click="settingsTab = 'appearance'"
          :class="settingsTab === 'appearance' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700'"
          class="flex-1 py-2.5 text-xs font-semibold border-b-2 transition-colors">
          Appearance
        </button>
        <button 
          @click="settingsTab = 'data'"
          :class="settingsTab === 'data' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700'"
          class="flex-1 py-2.5 text-xs font-semibold border-b-2 transition-colors"
          x-show="builderMode === 'cockpit'">
          Data
        </button>
        <button 
          @click="settingsTab = 'actions'"
          :class="settingsTab === 'actions' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700'"
          class="flex-1 py-2.5 text-xs font-semibold border-b-2 transition-colors"
          x-show="builderMode === 'cockpit'">
          Actions
        </button>
      </div>

      <!-- Settings Content -->
      <div class="flex-1 overflow-y-auto">
        <div x-data="{ block: pageConfig.blocks[builderState.selectedBlockId], get blockData() { if (!this.block.data) this.block.data = { source: '', query: '', sort: '', limit: null }; return this.block.data; } }">
          
          <!-- ============ APPEARANCE TAB ============ -->
          <div x-show="settingsTab === 'appearance'" class="p-4 space-y-5">
            
            <!-- Title -->
            <div>
              <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Title</label>
              <input 
                type="text" 
                class="form-input w-full text-sm py-2.5 rounded-lg"
                x-model="block.title"
                placeholder="Widget title">
            </div>

            <!-- Height -->
            <div>
              <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Height (px)</label>
              <input 
                type="number" 
                class="form-input w-full text-sm py-2.5 rounded-lg"
                x-model.number="block.props.height"
                placeholder="Auto">
            </div>

            <!-- Divider -->
            <div class="border-t dark:border-gray-800"></div>

            <!-- Options (not for action-button) -->
            <div x-show="block.type !== 'action-button'">
              <label class="block text-xs font-semibold mb-3 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Display Options</label>
              <div class="space-y-2.5">
                <label class="flex items-center gap-3 cursor-pointer group p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                  <input type="checkbox" class="form-checkbox rounded" x-model="block.props.compact">
                  <div>
                    <span class="text-sm font-medium">Compact mode</span>
                    <p class="text-[10px] text-gray-400">Reduce spacing between elements</p>
                  </div>
                </label>
                <label class="flex items-center gap-3 cursor-pointer group p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                  <input type="checkbox" class="form-checkbox rounded" x-model="block.props.showIcons">
                  <div>
                    <span class="text-sm font-medium">Show icons</span>
                    <p class="text-[10px] text-gray-400">Display icons next to labels</p>
                  </div>
                </label>
                <label class="flex items-center gap-3 cursor-pointer group p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                  <input type="checkbox" class="form-checkbox rounded" x-model="block.props.showBadges">
                  <div>
                    <span class="text-sm font-medium">Show badges</span>
                    <p class="text-[10px] text-gray-400">Display count badges</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- Action Button Specific Properties -->
            <template x-if="block.type === 'action-button'">
              <div class="space-y-5">
                <!-- Label -->
                <div>
                  <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Button Label</label>
                  <input 
                    type="text" 
                    class="form-input w-full text-sm py-2.5 rounded-lg"
                    x-model="block.label"
                    placeholder="Cliquer ici">
                </div>

                <!-- Icon -->
                <div>
                  <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Icon (Iconify)</label>
                  <input 
                    type="text" 
                    class="form-input w-full text-sm py-2.5 rounded-lg"
                    x-model="block.icon"
                    placeholder="solar:play-bold">
                  <div class="mt-1.5 text-[10px] text-gray-400">Ex: solar:phone-bold, solar:document-bold</div>
                </div>

                <div class="border-t dark:border-gray-800"></div>

                <!-- Color -->
                <div>
                  <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Color</label>
                  <div class="grid grid-cols-4 gap-1.5">
                    <template x-for="c in ['primary', 'success', 'info', 'warning', 'danger', 'secondary', 'dark']" :key="c">
                      <button 
                        @click="block.color = c"
                        :class="[
                          block.color === c ? 'ring-2 ring-offset-1 ring-primary scale-110' : '',
                          `bg-${c}`
                        ]"
                        class="h-8 rounded-lg transition-all"
                        :title="c">
                      </button>
                    </template>
                  </div>
                </div>

                <!-- Variant -->
                <div>
                  <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Variant</label>
                  <div class="flex gap-2">
                    <button 
                      @click="block.variant = 'filled'"
                      :class="block.variant === 'filled' ? 'bg-primary text-white shadow-sm' : 'bg-gray-100 dark:bg-gray-700 hover:bg-gray-200'"
                      class="flex-1 px-3 py-2 text-xs rounded-lg font-medium transition-all">
                      Filled
                    </button>
                    <button 
                      @click="block.variant = 'outline'"
                      :class="block.variant === 'outline' ? 'bg-primary text-white shadow-sm' : 'bg-gray-100 dark:bg-gray-700 hover:bg-gray-200'"
                      class="flex-1 px-3 py-2 text-xs rounded-lg font-medium transition-all">
                      Outline
                    </button>
                  </div>
                </div>

                <!-- Size -->
                <div>
                  <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Size</label>
                  <div class="flex gap-2">
                    <button 
                      @click="block.size = 'sm'"
                      :class="block.size === 'sm' ? 'bg-primary text-white shadow-sm' : 'bg-gray-100 dark:bg-gray-700 hover:bg-gray-200'"
                      class="flex-1 px-3 py-2 text-xs rounded-lg font-medium transition-all">
                      Small
                    </button>
                    <button 
                      @click="block.size = 'md'"
                      :class="block.size === 'md' ? 'bg-primary text-white shadow-sm' : 'bg-gray-100 dark:bg-gray-700 hover:bg-gray-200'"
                      class="flex-1 px-3 py-2 text-xs rounded-lg font-medium transition-all">
                      Medium
                    </button>
                    <button 
                      @click="block.size = 'lg'"
                      :class="block.size === 'lg' ? 'bg-primary text-white shadow-sm' : 'bg-gray-100 dark:bg-gray-700 hover:bg-gray-200'"
                      class="flex-1 px-3 py-2 text-xs rounded-lg font-medium transition-all">
                      Large
                    </button>
                  </div>
                </div>

                <!-- URL -->
                <div>
                  <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">URL / Action</label>
                  <input 
                    type="text" 
                    class="form-input w-full text-sm py-2.5 rounded-lg"
                    x-model="block.url"
                    placeholder="https://... or action:name">
                </div>
              </div>
            </template>
          </div>

          <!-- ============ DATA TAB ============ -->
          <template x-if="settingsTab === 'data'">
            <div class="p-4 space-y-5">
              <!-- Source -->
              <div>
                <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Data Source</label>
                <select class="form-select w-full text-sm py-2.5 rounded-lg" x-model="blockData.source">
                  <option value="">Select source...</option>
                  <option value="consultations">Consultations</option>
                  <option value="patients">Patients</option>
                  <option value="activities">Activities</option>
                  <option value="messages">Messages</option>
                </select>
              </div>

              <!-- Filter -->
              <div>
                <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Filter</label>
                <select class="form-select w-full text-sm py-2.5 rounded-lg" x-model="blockData.query">
                  <option value="">All records</option>
                  <option value="status:waiting">Status = Waiting</option>
                  <option value="status:in_progress">Status = In Progress</option>
                  <option value="status:done">Status = Done</option>
                  <option value="priority:urgent">Priority = Urgent</option>
                </select>
              </div>

              <!-- Sort -->
              <div>
                <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Sort by</label>
                <select class="form-select w-full text-sm py-2.5 rounded-lg" x-model="blockData.sort">
                  <option value="scheduled_at:asc">Scheduled (earliest first)</option>
                  <option value="scheduled_at:desc">Scheduled (latest first)</option>
                  <option value="createdAt:desc">Created (newest first)</option>
                  <option value="priority:desc">Priority (urgent first)</option>
                </select>
              </div>

              <!-- Limit -->
              <div>
                <label class="block text-xs font-semibold mb-1.5 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Limit</label>
                <input 
                  type="number" 
                  class="form-input w-full text-sm py-2.5 rounded-lg"
                  x-model.number="blockData.limit"
                  placeholder="No limit">
              </div>
            </div>
          </template>

          <!-- ============ ACTIONS TAB ============ -->
          <div x-show="settingsTab === 'actions'" class="p-4 space-y-5">
            <!-- Header Actions -->
            <div>
              <label class="block text-xs font-semibold mb-2 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Header Actions</label>
              <div class="flex flex-wrap gap-1.5">
                <template x-for="action in ['refresh', 'add_record', 'export']" :key="action">
                  <button 
                    @click="toggleAction('header', action)"
                    :class="block.actions?.header?.includes(action) ? 'bg-primary text-white shadow-sm' : 'bg-gray-100 dark:bg-gray-700 hover:bg-gray-200'"
                    class="px-3 py-1.5 text-xs rounded-lg transition-all font-medium">
                    <span x-text="action.replace('_', ' ')"></span>
                  </button>
                </template>
              </div>
            </div>

            <!-- Row Actions -->
            <div>
              <label class="block text-xs font-semibold mb-2 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Row Actions</label>
              <div class="flex flex-wrap gap-1.5">
                <template x-for="action in ['call', 'done', 'urgent', 'assign', 'message', 'view']" :key="action">
                  <button 
                    @click="toggleAction('row', action)"
                    :class="block.actions?.row?.includes(action) ? 'bg-primary text-white shadow-sm' : 'bg-gray-100 dark:bg-gray-700 hover:bg-gray-200'"
                    class="px-3 py-1.5 text-xs rounded-lg transition-all font-medium">
                    <span x-text="action"></span>
                  </button>
                </template>
              </div>
            </div>

            <!-- Quick Actions (for comms-dock) -->
            <div x-show="block.type === 'comms-dock'">
              <label class="block text-xs font-semibold mb-2 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Quick Actions</label>
              <div class="grid grid-cols-2 gap-1.5">
                <template x-for="action in ['next_patient', 'come_here', 'prescription', 'lab_request', 'followup', 'flag_urgent']" :key="action">
                  <button 
                    @click="toggleAction('quick', action)"
                    :class="block.actions?.quick?.includes(action) ? 'bg-success text-white shadow-sm' : 'bg-gray-100 dark:bg-gray-700 hover:bg-gray-200'"
                    class="px-2 py-1.5 text-xs rounded-lg transition-all text-center font-medium">
                    <span x-text="action.replace(/_/g, ' ')"></span>
                  </button>
                </template>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Footer: Delete -->
      <div class="border-t dark:border-gray-800 p-3 shrink-0">
        <button @click="deleteBlock(builderState.selectedBlockId)" class="btn btn-outline-danger btn-sm w-full rounded-lg">
          <iconify-icon icon="solar:trash-bin-minimalistic-bold" class="mr-1"></iconify-icon>
          Delete Widget
        </button>
      </div>
    </div>
  </template>

  <!-- ====================================== -->
  <!-- WIDGET LIBRARY MODE (no block selected) -->
  <!-- ====================================== -->
  <template x-if="builderState.drawerMode !== 'block-settings'">
    <div class="flex flex-col h-full">
      
      <!-- Header -->
      <div class="h-14 border-b dark:border-gray-800 px-4 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <iconify-icon icon="solar:widget-add-bold-duotone" width="18" class="text-primary"></iconify-icon>
          <h3 class="font-semibold text-sm">Widget Library</h3>
        </div>
        <button @click="builderState.sidebarOpen = false" class="w-7 h-7 rounded-md flex items-center justify-center text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
          <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
        </button>
      </div>

      <!-- Blocks Panel -->
      <div x-show="builderState.drawerMode === 'blocks'" class="flex-1 overflow-y-auto p-4">
        
        <!-- Search -->
        <div class="mb-4">
          <input type="text" placeholder="Search widgets..." class="form-input w-full text-sm py-2">
        </div>
        
        <!-- Cockpit Widgets (shown in cockpit mode) -->
        <template x-if="builderMode === 'cockpit'">
          <div class="mb-6">
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-semibold mb-3">Cockpit Widgets</p>
            <div 
              class="grid grid-cols-2 gap-2"
              x-init="
                Sortable.create($el, {
                  group: { name: 'blocks', pull: 'clone', put: false },
                  animation: 150,
                  sort: false
                })
              ">
              
              <!-- Work Queue -->
              <div 
                data-block-type="work-queue"
                class="p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
                <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="28" class="text-info"></iconify-icon>
                <span class="text-xs font-medium text-center">Work Queue</span>
              </div>

              <!-- Comms Dock -->
              <div 
                data-block-type="comms-dock"
                class="p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
                <iconify-icon icon="solar:chat-round-dots-bold-duotone" width="28" class="text-success"></iconify-icon>
                <span class="text-xs font-medium text-center">Comms Dock</span>
              </div>

              <!-- Activity Feed -->
              <div 
                data-block-type="activity-feed"
                class="p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
                <iconify-icon icon="solar:history-bold-duotone" width="28" class="text-warning"></iconify-icon>
                <span class="text-xs font-medium text-center">Activity Feed</span>
              </div>

              <!-- Focus Card -->
              <div 
                data-block-type="focus-card"
                class="p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
                <iconify-icon icon="solar:star-bold-duotone" width="28" class="text-primary"></iconify-icon>
                <span class="text-xs font-medium text-center">Focus Card</span>
              </div>

              <!-- Urgency Radar -->
              <div 
                data-block-type="urgency-radar"
                class="p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
                <iconify-icon icon="solar:danger-triangle-bold-duotone" width="28" class="text-danger"></iconify-icon>
                <span class="text-xs font-medium text-center">Urgency Radar</span>
              </div>

              <!-- KPI Cards -->
              <div 
                data-block-type="kpi-cards"
                class="p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
                <iconify-icon icon="solar:chart-square-bold-duotone" width="28" class="text-secondary"></iconify-icon>
                <span class="text-xs font-medium text-center">KPI Cards</span>
              </div>

              <!-- Action Button -->
              <div 
                data-block-type="action-button"
                class="p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
                <iconify-icon icon="solar:play-bold-duotone" width="28" class="text-primary"></iconify-icon>
                <span class="text-xs font-medium text-center">Action Button</span>
              </div>
            </div>
          </div>
        </template>

        <!-- Generic Blocks -->
        <div>
          <p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-semibold mb-3">
            <span x-text="builderMode === 'cockpit' ? 'Generic Blocks' : 'Blocks'"></span>
          </p>
          <div 
            class="grid grid-cols-2 gap-2"
            x-init="
              Sortable.create($el, {
                group: { name: 'blocks', pull: 'clone', put: false },
                animation: 150,
                sort: false
              })
            ">
            <!-- Panel Block -->
            <div 
              data-block-type="panel"
              class="p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
              <iconify-icon icon="solar:widget-5-bold-duotone" width="28" class="text-primary"></iconify-icon>
              <span class="text-xs font-medium">Panel</span>
            </div>

            <!-- Text Block -->
            <div 
              data-block-type="text"
              class="p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
              <iconify-icon icon="solar:text-bold-duotone" width="28" class="text-success"></iconify-icon>
              <span class="text-xs font-medium">Text</span>
            </div>

            <!-- KPI Card Block -->
            <div 
              data-block-type="kpi-card"
              class="p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
