<!-- Admin Users List -->
<div class="min-h-screen" x-data="adminUsers()">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
            <a href="/account/<%= account_number %>/admin" class="w-8 h-8 rounded-lg bg-gray-100 dark:bg-[#1b2e4b] flex items-center justify-center hover:bg-primary/10 transition-colors">
                <iconify-icon icon="solar:arrow-left-bold" width="16" class="text-gray-500"></iconify-icon>
            </a>
            <div>
                <h1 class="text-2xl font-bold dark:text-white">Utilisateurs</h1>
                <p class="text-sm text-gray-500"><%= pagination.total %> utilisateurs au total</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="document.getElementById('createUserModal2').showModal()" class="btn btn-primary btn-sm">
                <iconify-icon icon="solar:user-plus-bold" width="16" class="mr-1.5"></iconify-icon>
                Ajouter
            </button>
        </div>
    </div>

    <!-- Filters Bar -->
    <div class="panel mb-5">
        <form method="GET" class="flex flex-wrap items-center gap-3">
            <div class="flex-1 min-w-[200px]">
                <div class="relative">
                    <iconify-icon icon="solar:magnifer-bold" width="16" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></iconify-icon>
                    <input type="text" name="search" value="<%= filters.search %>" placeholder="Rechercher par nom ou email..." class="form-input pl-9 !h-9 text-sm" />
                </div>
            </div>
            <select name="status" class="form-select !h-9 text-sm !w-auto">
                <option value="">Tous les statuts</option>
                <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Actif</option>
                <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactif</option>
                <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspendu</option>
                <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>En attente</option>
            </select>
            <select name="plan" class="form-select !h-9 text-sm !w-auto">
                <option value="">Tous les plans</option>
                <option value="free" <%= filters.plan === 'free' ? 'selected' : '' %>>Free</option>
                <option value="basic" <%= filters.plan === 'basic' ? 'selected' : '' %>>Basic</option>
                <option value="premium" <%= filters.plan === 'premium' ? 'selected' : '' %>>Premium</option>
                <option value="enterprise" <%= filters.plan === 'enterprise' ? 'selected' : '' %>>Enterprise</option>
            </select>
            <button type="submit" class="btn btn-outline-primary btn-sm">
                <iconify-icon icon="solar:filter-bold" width="14" class="mr-1"></iconify-icon>
                Filtrer
            </button>
        </form>
    </div>

    <!-- Users Table -->
    <div class="panel">
        <div class="overflow-x-auto">
            <table class="table-hover">
                <thead>
                    <tr>
                        <th class="!py-3">Utilisateur</th>
                        <th>Auth</th>
                        <th>Plan</th>
                        <th>Statut</th>
                        <th>Workspaces</th>
                        <th>Dernière connexion</th>
                        <th>Inscrit le</th>
                        <th class="!text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(function(u) { %>
                    <tr class="group">
                        <td>
                            <a href="/account/<%= account_number %>/admin/users/<%= u._id %>" class="flex items-center gap-3 hover:text-primary">
                                <% if (u.avatar) { %>
                                    <img src="<%= u.avatar %>" class="w-9 h-9 rounded-full object-cover ring-2 ring-gray-100 dark:ring-[#1b2e4b]" alt="" />
                                <% } else { %>
                                    <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-xs">
                                        <%= u.name ? u.name.charAt(0).toUpperCase() : '?' %>
                                    </div>
                                <% } %>
                                <div>
                                    <div class="font-semibold text-sm dark:text-white"><%= u.name || '—' %></div>
                                    <div class="text-xs text-gray-500"><%= u.email %></div>
                                </div>
                            </a>
                        </td>
                        <td>
                            <% if (u.authProvider === 'google') { %>
                                <span class="inline-flex items-center gap-1 text-xs">
                                    <svg viewBox="0 0 24 24" width="14" height="14"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                                    Google
                                </span>
                            <% } else { %>
                                <span class="text-xs text-gray-500">
                                    <iconify-icon icon="solar:lock-password-bold" width="14" class="mr-0.5"></iconify-icon>
                                    Email
                                </span>
                            <% } %>
                        </td>
                        <td>
                            <% const planColors = { free: 'bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300', basic: 'bg-blue-100 text-blue-600', premium: 'bg-amber-100 text-amber-700', enterprise: 'bg-purple-100 text-purple-600' }; %>
                            <span class="px-2.5 py-1 rounded-md text-[10px] font-bold uppercase <%= planColors[u.membership?.plan] || planColors.free %>">
                                <%= u.membership?.plan || 'free' %>
                            </span>
                        </td>
                        <td>
                            <span class="inline-flex items-center gap-1.5 text-xs font-semibold 
                                <%= u.status === 'active' ? 'text-success' : u.status === 'suspended' ? 'text-danger' : u.status === 'inactive' ? 'text-gray-400' : 'text-warning' %>">
                                <span class="w-2 h-2 rounded-full 
                                    <%= u.status === 'active' ? 'bg-success' : u.status === 'suspended' ? 'bg-danger' : u.status === 'inactive' ? 'bg-gray-300' : 'bg-warning' %>"></span>
                                <%= u.status || 'active' %>
                            </span>
                        </td>
                        <td>
                            <span class="text-sm font-semibold"><%= u.accounts?.length || 0 %></span>
                        </td>
                        <td class="text-xs text-gray-500">
                            <% if (u.lastLogin) { %>
                                <%= new Date(u.lastLogin).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                            <% } else { %>
                                <span class="text-gray-300">—</span>
                            <% } %>
                        </td>
                        <td class="text-xs text-gray-500">
                            <%= new Date(u.created_on).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                        </td>
                        <td>
                            <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                <a href="/account/<%= account_number %>/admin/users/<%= u._id %>" 
                                   class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-primary/10 text-gray-400 hover:text-primary transition-all" title="Voir">
                                    <iconify-icon icon="solar:eye-bold" width="15"></iconify-icon>
                                </a>
                                <!-- Quick Status Toggle -->
                                <% if (u.status === 'active') { %>
                                    <button onclick="updateStatus('<%= u._id %>', 'suspended')" 
                                            class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-danger/10 text-gray-400 hover:text-danger transition-all" title="Suspendre">
                                        <iconify-icon icon="solar:shield-cross-bold" width="15"></iconify-icon>
                                    </button>
                                <% } else { %>
                                    <button onclick="updateStatus('<%= u._id %>', 'active')" 
                                            class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-success/10 text-gray-400 hover:text-success transition-all" title="Activer">
                                        <iconify-icon icon="solar:shield-check-bold" width="15"></iconify-icon>
                                    </button>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <% if (pagination.pages > 1) { %>
        <div class="flex items-center justify-between mt-5 pt-4 border-t border-gray-100 dark:border-[#1b2e4b]">
            <div class="text-xs text-gray-500">
                Page <%= pagination.page %> sur <%= pagination.pages %> · <%= pagination.total %> résultats
            </div>
            <div class="flex items-center gap-1">
                <% for (let p = 1; p <= pagination.pages; p++) { %>
                    <a href="?page=<%= p %>&search=<%= filters.search %>&status=<%= filters.status %>&plan=<%= filters.plan %>" 
                       class="w-8 h-8 rounded-lg flex items-center justify-center text-xs font-semibold transition-colors
                              <%= p === pagination.page ? 'bg-primary text-white' : 'hover:bg-gray-100 dark:hover:bg-[#1b2e4b] text-gray-600 dark:text-gray-400' %>">
                        <%= p %>
                    </a>
                <% } %>
            </div>
        </div>
        <% } %>
    </div>
</div>

<!-- Create User Modal -->
<dialog id="createUserModal2" class="rounded-2xl bg-white dark:bg-[#0e1726] p-0 backdrop:bg-black/60 w-full shadow-2xl border border-gray-200 dark:border-[#1b2e4b] overflow-hidden" style="max-width: 520px;">
    <div x-data="{ loading: false }">
        <!-- Modal Header with gradient bar -->
        <div class="px-6 py-5" style="background: linear-gradient(135deg, #4361ee, #06b6d4);">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(8px);">
                        <iconify-icon icon="solar:user-plus-bold-duotone" width="22" class="text-white"></iconify-icon>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-white">Nouvel utilisateur</h3>
                        <p class="text-xs" style="color: rgba(255,255,255,0.7);">Créer un compte sur la plateforme</p>
                    </div>
                </div>
                <button onclick="this.closest('dialog').close()" class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors" style="background: rgba(255,255,255,0.15);" onmouseover="this.style.background='rgba(255,255,255,0.3)'" onmouseout="this.style.background='rgba(255,255,255,0.15)'">
                    <iconify-icon icon="solar:close-circle-bold" width="20" class="text-white"></iconify-icon>
                </button>
            </div>
        </div>

        <!-- Modal Body -->
        <div class="p-6">
            <form @submit.prevent="
                loading = true;
                const fd = new FormData($el);
                fetch('/account/<%= account_number %>/admin/api/users/create', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    credentials: 'include',
                    body: JSON.stringify(Object.fromEntries(fd))
                })
                .then(r => r.json())
                .then(data => { loading = false; if (data.success) location.reload(); else alert(data.error || 'Error'); })
                .catch(e => { loading = false; alert('Error'); });
            " class="space-y-5">
                <!-- Nom -->
                <div>
                    <label class="block text-sm font-semibold mb-2 text-gray-700 dark:text-white-light">
                        Nom complet <span class="text-danger">*</span>
                    </label>
                    <div class="relative">
                        <iconify-icon icon="solar:user-bold-duotone" width="18" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></iconify-icon>
                        <input name="name" type="text" required class="form-input pl-10 !h-11 text-sm" placeholder="John Doe" />
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-sm font-semibold mb-2 text-gray-700 dark:text-white-light">
                        Adresse email <span class="text-danger">*</span>
                    </label>
                    <div class="relative">
                        <iconify-icon icon="solar:letter-bold-duotone" width="18" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></iconify-icon>
                        <input name="email" type="email" required class="form-input pl-10 !h-11 text-sm" placeholder="john@example.com" />
                    </div>
                </div>

                <!-- Mot de passe -->
                <div>
                    <label class="block text-sm font-semibold mb-2 text-gray-700 dark:text-white-light">
                        Mot de passe <span class="text-danger">*</span>
                    </label>
                    <div class="relative">
                        <iconify-icon icon="solar:lock-password-bold-duotone" width="18" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></iconify-icon>
                        <input name="password" type="password" required class="form-input pl-10 !h-11 text-sm" minlength="6" placeholder="Minimum 6 caractères" />
                    </div>
                </div>

                <!-- Rôle & Plan side by side -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold mb-2 text-gray-700 dark:text-white-light">Rôle</label>
                        <div class="relative">
                            <iconify-icon icon="solar:shield-user-bold-duotone" width="18" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 z-10"></iconify-icon>
                            <select name="role" class="form-select pl-10 !h-11 text-sm">
                                <option value="user">Utilisateur</option>
                                <option value="admin">Admin</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2 text-gray-700 dark:text-white-light">Plan</label>
                        <div class="relative">
                            <iconify-icon icon="solar:crown-bold-duotone" width="18" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 z-10"></iconify-icon>
                            <select name="plan" class="form-select pl-10 !h-11 text-sm">
                                <option value="free">Free</option>
                                <option value="basic">Basic</option>
                                <option value="premium">Premium</option>
                                <option value="enterprise">Enterprise</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex gap-3 pt-3 border-t border-gray-100 dark:border-[#1b2e4b]">
                    <button type="button" onclick="this.closest('dialog').close()" 
                            class="btn btn-outline-dark flex-1 !h-11 font-semibold">
                        Annuler
                    </button>
                    <button type="submit" class="btn btn-primary flex-1 !h-11 font-semibold" :disabled="loading">
                        <template x-if="!loading">
                            <span class="flex items-center justify-center gap-2">
                                <iconify-icon icon="solar:user-plus-bold" width="18"></iconify-icon>
                                Créer l'utilisateur
                            </span>
                        </template>
                        <template x-if="loading">
                            <span class="flex items-center justify-center gap-2">
                                <iconify-icon icon="svg-spinners:ring-resize" width="18"></iconify-icon>
                                Création...
                            </span>
                        </template>
                    </button>
                </div>
            </form>
        </div>
    </div>
</dialog>

<script>
function adminUsers() { return {}; }

async function updateStatus(userId, status) {
    if (!confirm('Confirmer le changement de statut ?')) return;
    const res = await fetch('/account/<%= account_number %>/admin/api/users/status', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        credentials: 'include',
        body: JSON.stringify({ userId, status })
    });
    const data = await res.json();
    if (data.success) location.reload();
    else alert(data.error || 'Error');
}
</script>
