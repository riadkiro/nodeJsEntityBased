<!--
  Chat Page — Full-page real-time chat with WebSocket
  Uses Socket.IO for real-time messaging + REST API for initial data.
  
  Features:
  - Contact sidebar with search, online indicators
  - Chat area with message bubbles, timestamps, typing indicators
  - File/image sharing
  - Read receipts
  - Responsive (mobile sidebar toggle)
  - Dark/light mode compatible
-->

<!-- Chat container (full height) -->
<div x-data="chatApp" class="relative flex h-[calc(100vh_-_150px)] gap-5 sm:min-h-0">
    
    <!-- ===== SIDEBAR: Contact List ===== -->
    <div class="panel absolute z-10 hidden w-full max-w-xs flex-none space-y-4 overflow-hidden p-4 xl:relative xl:block xl:h-full"
         :class="showSidebar && '!block'">
        
        <!-- Current user header -->
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <div class="flex-none">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full text-white font-bold text-lg"
                         :style="'background:' + getAvatarGradient(currentUser.name)">
                        <span x-text="getInitials(currentUser.name)"></span>
                    </div>
                </div>
                <div class="mx-3">
                    <p class="mb-1 font-semibold" x-text="currentUser.name"></p>
                    <p class="text-xs text-white-dark">En ligne</p>
                </div>
            </div>
            <!-- New conversation button -->
            <button type="button" 
                    class="flex h-8 w-8 items-center justify-center rounded-full bg-[#f4f4f4] hover:bg-primary-light hover:text-primary dark:bg-[#1b2e4b] dark:hover:bg-primary/20 transition-colors"
                    @click="showNewConversation = !showNewConversation"
                    title="Nouvelle conversation">
                <iconify-icon icon="solar:pen-new-square-bold-duotone" width="18" height="18"></iconify-icon>
            </button>
        </div>

        <!-- Search -->
        <div class="relative">
            <input type="text" class="peer form-input ltr:pr-9 rtl:pl-9" placeholder="Rechercher..."
                   x-model="searchQuery" @input="filterConversations()">
            <div class="absolute top-1/2 -translate-y-1/2 peer-focus:text-primary ltr:right-2 rtl:left-2">
                <iconify-icon icon="solar:magnifer-bold-duotone" width="16" height="16" class="opacity-50"></iconify-icon>
            </div>
        </div>

        <!-- New conversation user list (overlay) -->
        <template x-if="showNewConversation">
            <div class="absolute inset-0 z-20 bg-white dark:bg-[#0e1726] p-4 space-y-3 overflow-auto">
                <div class="flex items-center justify-between mb-2">
                    <h6 class="font-semibold dark:text-white-light">Nouvelle conversation</h6>
                    <button @click="showNewConversation = false" class="hover:text-danger">
                        <iconify-icon icon="solar:close-circle-bold-duotone" width="20" height="20"></iconify-icon>
                    </button>
                </div>
                <template x-for="user in availableUsers" :key="user._id">
                    <button type="button"
                            class="flex w-full items-center gap-3 rounded-lg p-2.5 hover:bg-gray-100 dark:hover:bg-[#1b2e4b] transition-colors"
                            @click="startConversation(user._id)">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-white text-sm font-bold"
                             :style="'background:' + getAvatarGradient(user.name)">
                            <span x-text="getInitials(user.name)"></span>
                        </div>
                        <div class="ltr:text-left rtl:text-right">
                            <p class="font-semibold text-sm" x-text="user.name"></p>
                            <p class="text-xs text-white-dark" x-text="user.email"></p>
                        </div>
                        <template x-if="isUserOnline(user._id)">
                            <span class="ml-auto h-2.5 w-2.5 rounded-full bg-success"></span>
                        </template>
                    </button>
                </template>
                <template x-if="availableUsers.length === 0">
                    <p class="text-sm text-white-dark text-center py-4">Aucun utilisateur disponible</p>
                </template>
            </div>
        </template>

        <!-- Separator -->
        <div class="h-px w-full border-b border-[#e0e6ed] dark:border-[#1b2e4b]"></div>

        <!-- Conversation list -->
        <div class="!mt-0">
            <div class="chat-users relative -mr-3.5 h-full min-h-[100px] space-y-0.5 overflow-auto pr-3.5 sm:h-[calc(100vh_-_357px)]">
                <template x-for="conv in filteredConversations" :key="conv._id">
                    <button type="button"
                            class="flex w-full items-center justify-between rounded-lg p-2.5 hover:bg-gray-100 hover:text-primary dark:hover:bg-[#050b14] dark:hover:text-primary transition-colors"
                            :class="{'bg-gray-100 dark:bg-[#050b14] dark:text-primary text-primary': selectedConversation && selectedConversation._id === conv._id}"
                            @click="selectConversation(conv)">
                        <div class="flex-1">
                            <div class="flex items-center">
                                <!-- Avatar -->
                                <div class="relative flex-shrink-0">
                                    <div class="flex h-12 w-12 items-center justify-center rounded-full text-white text-sm font-bold"
                                         :style="'background:' + getAvatarGradient(getConversationName(conv))">
                                        <span x-text="getInitials(getConversationName(conv))"></span>
                                    </div>
                                    <template x-if="isConversationOnline(conv)">
                                        <div class="absolute bottom-0 ltr:right-0 rtl:left-0">
                                            <div class="h-3.5 w-3.5 rounded-full bg-success border-2 border-white dark:border-[#0e1726]"></div>
                                        </div>
                                    </template>
                                </div>
                                <!-- Info -->
                                <div class="mx-3 ltr:text-left rtl:text-right flex-1 min-w-0">
                                    <p class="mb-1 font-semibold truncate" x-text="getConversationName(conv)"></p>
                                    <div class="flex items-center gap-1 max-w-[185px]">
                                        <template x-if="conv.lastMessage && conv.lastMessage.senderId === currentUser.id">
                                            <span class="text-white-dark text-xs">Vous: </span>
                                        </template>
                                        <p class="truncate text-xs text-white-dark"
                                           x-text="conv.lastMessage?.text || 'Démarrer la conversation'"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Time & unread badge -->
                        <div class="flex flex-col items-end gap-1">
                            <span class="whitespace-nowrap text-[11px] text-white-dark"
                                  x-text="formatTime(conv.lastMessage?.sentAt)"></span>
                            <template x-if="conv.unreadCount > 0">
                                <span class="flex h-5 min-w-[20px] items-center justify-center rounded-full bg-primary px-1 text-[10px] font-bold text-white"
                                      x-text="conv.unreadCount"></span>
                            </template>
                        </div>
                    </button>
                </template>

                <!-- Empty state -->
                <template x-if="filteredConversations.length === 0 && !loading">
                    <div class="flex flex-col items-center justify-center py-8 text-white-dark">
                        <iconify-icon icon="solar:chat-round-dots-bold-duotone" width="48" height="48" class="opacity-30 mb-3"></iconify-icon>
                        <p class="text-sm">Pas encore de conversations</p>
                        <button @click="showNewConversation = true" class="text-primary text-sm mt-2 hover:underline">
                            Démarrer une conversation
                        </button>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <!-- Mobile sidebar overlay -->
    <div class="absolute z-[5] hidden h-full w-full rounded-md bg-black/60"
         :class="showSidebar && '!block xl:!hidden'"
         @click="showSidebar = false"></div>

    <!-- ===== CHAT PANEL ===== -->
    <div class="panel flex-1 p-0">
        
        <!-- No conversation selected -->
        <template x-if="!selectedConversation">
            <div class="relative flex h-full items-center justify-center p-4">
                <!-- Mobile menu toggle -->
                <button type="button" class="absolute top-4 hover:text-primary ltr:left-4 rtl:right-4 xl:hidden"
                        @click="showSidebar = !showSidebar">
                    <iconify-icon icon="solar:hamburger-menu-bold-duotone" width="24" height="24"></iconify-icon>
                </button>
                <div class="flex flex-col items-center justify-center py-8">
                    <div class="mb-6 rounded-full bg-primary/10 p-8">
                        <iconify-icon icon="solar:chat-round-dots-bold-duotone" width="64" height="64" class="text-primary opacity-60"></iconify-icon>
                    </div>
                    <h3 class="text-xl font-semibold mb-2 dark:text-white-light">Messagerie</h3>
                    <p class="mx-auto max-w-[250px] text-center text-white-dark">
                        Sélectionnez une conversation ou démarrez-en une nouvelle
                    </p>
                    <button @click="showSidebar = true; showNewConversation = true"
                            class="btn btn-primary mt-4 gap-2">
                        <iconify-icon icon="solar:pen-new-square-bold-duotone" width="18" height="18"></iconify-icon>
                        Nouvelle conversation
                    </button>
                </div>
            </div>
        </template>

        <!-- Conversation active -->
        <template x-if="selectedConversation">
            <div class="relative h-full flex flex-col">
                
                <!-- Chat header -->
                <div class="flex items-center justify-between p-4 border-b border-[#e0e6ed] dark:border-[#1b2e4b]">
                    <div class="flex items-center space-x-2 rtl:space-x-reverse">
                        <!-- Mobile back button -->
                        <button type="button" class="hover:text-primary xl:hidden" @click="showSidebar = !showSidebar">
                            <iconify-icon icon="solar:hamburger-menu-bold-duotone" width="24" height="24"></iconify-icon>
                        </button>
                        <!-- Contact info -->
                        <div class="relative flex-none">
                            <div class="flex h-11 w-11 items-center justify-center rounded-full text-white text-sm font-bold"
                                 :style="'background:' + getAvatarGradient(getConversationName(selectedConversation))">
                                <span x-text="getInitials(getConversationName(selectedConversation))"></span>
                            </div>
                            <template x-if="isConversationOnline(selectedConversation)">
                                <div class="absolute bottom-0 ltr:right-0 rtl:left-0">
                                    <div class="h-3 w-3 rounded-full bg-success border-2 border-white dark:border-[#0e1726]"></div>
                                </div>
                            </template>
                        </div>
                        <div class="mx-3">
                            <p class="font-semibold" x-text="getConversationName(selectedConversation)"></p>
                            <p class="text-xs text-white-dark">
                                <template x-if="isConversationOnline(selectedConversation)">
                                    <span class="text-success">En ligne</span>
                                </template>
                                <template x-if="!isConversationOnline(selectedConversation)">
                                    <span>Hors ligne</span>
                                </template>
                                <!-- Typing indicator -->
                                <template x-if="typingUsers[selectedConversation._id]">
                                    <span class="text-primary ml-2 animate-pulse">est en train d'écrire...</span>
                                </template>
                            </p>
                        </div>
                    </div>
                    <!-- Actions -->
                    <div class="flex gap-3">
                        <button type="button" class="flex h-9 w-9 items-center justify-center rounded-full hover:bg-primary/10 hover:text-primary transition-colors" title="Appel">
                            <iconify-icon icon="solar:phone-bold-duotone" width="20" height="20"></iconify-icon>
                        </button>
                        <button type="button" class="flex h-9 w-9 items-center justify-center rounded-full hover:bg-primary/10 hover:text-primary transition-colors" title="Vidéo">
                            <iconify-icon icon="solar:videocamera-bold-duotone" width="20" height="20"></iconify-icon>
                        </button>
                    </div>
                </div>

                <!-- Messages area -->
                <div x-ref="messagesContainer" class="flex-1 overflow-auto relative" @scroll="handleScroll()">
                    <div class="chat-conversation-box min-h-full space-y-4 p-4 flex flex-col justify-end">
                        
                        <!-- Loading older messages -->
                        <template x-if="loadingMoreMessages">
                            <div class="flex justify-center py-2">
                                <div class="h-5 w-5 animate-spin rounded-full border-2 border-primary border-t-transparent"></div>
                            </div>
                        </template>

                        <!-- Date separator -->
                        <div class="m-6 mt-0 block" x-show="messages.length > 0">
                            <h4 class="relative border-b border-[#f4f4f4] text-center text-xs dark:border-gray-800">
                                <span class="relative top-2 bg-white px-3 dark:bg-[#0e1726]">Aujourd'hui</span>
                            </h4>
                        </div>

                        <!-- Messages -->
                        <template x-for="(msg, idx) in messages" :key="msg._id || idx">
                            <div class="flex items-start gap-3"
                                 :class="{'justify-end': msg.senderId === currentUser.id}">
                                <!-- Avatar (left for others) -->
                                <template x-if="msg.senderId !== currentUser.id">
                                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-white text-xs font-bold"
                                         :style="'background:' + getAvatarGradient(msg.senderName)">
                                        <span x-text="getInitials(msg.senderName)"></span>
                                    </div>
                                </template>
                                
                                <div class="space-y-1 max-w-[70%]"
                                     :class="{'order-1': msg.senderId !== currentUser.id}">
                                    <!-- Sender name (only for others) -->
                                    <template x-if="msg.senderId !== currentUser.id">
                                        <div class="text-xs text-white-dark px-1" x-text="msg.senderName"></div>
                                    </template>
                                    
                                    <!-- Message bubble -->
                                    <div class="rounded-xl px-4 py-2.5 shadow-sm"
                                         :class="msg.senderId === currentUser.id
                                             ? 'bg-primary text-white ltr:rounded-br-none rtl:rounded-bl-none'
                                             : 'bg-black/10 dark:bg-gray-800 ltr:rounded-bl-none rtl:rounded-br-none'">
                                        
                                        <!-- Text message -->
                                        <template x-if="msg.type === 'text' || !msg.type">
                                            <div class="text-sm whitespace-pre-wrap break-words" x-text="msg.text"></div>
                                        </template>
                                        
                                        <!-- Image attachment -->
                                        <template x-if="msg.type === 'image' && msg.attachment">
                                            <div>
                                                <img :src="msg.attachment.url" class="rounded-lg max-w-full max-h-[300px] object-contain cursor-pointer"
                                                     @click="window.open(msg.attachment.url, '_blank')">
                                                <template x-if="msg.text">
                                                    <div class="text-sm mt-2" x-text="msg.text"></div>
                                                </template>
                                            </div>
                                        </template>
                                        
                                        <!-- File attachment -->
                                        <template x-if="msg.type === 'file' && msg.attachment">
                                            <a :href="msg.attachment.url" target="_blank" 
                                               class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                                                <iconify-icon icon="solar:file-bold-duotone" width="24" height="24"></iconify-icon>
                                                <div class="min-w-0 flex-1">
                                                    <p class="text-sm font-medium truncate" x-text="msg.attachment.filename"></p>
                                                    <p class="text-[10px] opacity-70" x-text="formatFileSize(msg.attachment.size)"></p>
                                                </div>
                                            </a>
                                        </template>
                                        
                                        <!-- System message -->
                                        <template x-if="msg.type === 'system'">
                                            <div class="text-xs text-center italic opacity-70" x-text="msg.text"></div>
                                        </template>
                                    </div>
                                    
                                    <!-- Time & read receipt -->
                                    <div class="flex items-center gap-1 px-1"
                                         :class="{'justify-end': msg.senderId === currentUser.id}">
                                        <span class="text-[10px] text-white-dark" x-text="formatMessageTime(msg.createdAt)"></span>
                                        <!-- Read receipt (for own messages) -->
                                        <template x-if="msg.senderId === currentUser.id">
                                            <iconify-icon :icon="msg.readBy && msg.readBy.length > 1 ? 'solar:check-read-bold' : 'solar:check-circle-bold'"
                                                          :class="msg.readBy && msg.readBy.length > 1 ? 'text-primary' : 'text-white-dark'"
                                                          width="14" height="14"></iconify-icon>
                                        </template>
                                    </div>
                                </div>

                                <!-- Avatar (right for self) -->
                                <template x-if="msg.senderId === currentUser.id">
                                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-white text-xs font-bold"
                                         :style="'background:' + getAvatarGradient(currentUser.name)">
                                        <span x-text="getInitials(currentUser.name)"></span>
                                    </div>
                                </template>
                            </div>
                        </template>

                        <!-- Empty messages -->
                        <template x-if="messages.length === 0 && !loadingMessages">
                            <div class="flex flex-col items-center justify-center py-12 text-white-dark">
                                <iconify-icon icon="solar:chat-dots-bold-duotone" width="40" height="40" class="opacity-30 mb-2"></iconify-icon>
                                <p class="text-sm">Pas encore de messages</p>
                                <p class="text-xs">Envoyez le premier message !</p>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Input area -->
                <div class="border-t border-[#e0e6ed] dark:border-[#1b2e4b] p-4">
                    <div class="flex items-center gap-2">
                        <!-- File attach button -->
                        <button type="button"
                                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#f4f4f4] hover:bg-primary/10 hover:text-primary dark:bg-[#1b2e4b] dark:hover:bg-primary/20 transition-colors"
                                @click="$refs.fileInput.click()"
                                title="Joindre un fichier">
                            <iconify-icon icon="solar:paperclip-bold-duotone" width="20" height="20"></iconify-icon>
                        </button>
                        <input type="file" x-ref="fileInput" class="hidden" @change="handleFileUpload($event)" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip">

                        <!-- Text input -->
                        <div class="relative flex-1">
                            <input type="text"
                                   class="form-input rounded-full border-0 bg-[#f4f4f4] dark:bg-[#1b2e4b] px-5 py-2.5 focus:outline-none"
                                   placeholder="Tapez un message..."
                                   x-model="newMessage"
                                   @keyup.enter="sendMessage()"
                                   @input="handleTyping()">
                        </div>

                        <!-- Send button -->
                        <button type="button"
                                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-white hover:bg-primary/80 transition-colors shadow-sm"
                                @click="sendMessage()"
                                :disabled="!newMessage.trim()">
                            <iconify-icon icon="solar:plain-bold-duotone" width="20" height="20"></iconify-icon>
                        </button>
                    </div>
                    
                    <!-- File preview (when file selected) -->
                    <template x-if="pendingFile">
                        <div class="mt-3 flex items-center gap-2 p-2 rounded-lg bg-[#f4f4f4] dark:bg-[#1b2e4b]">
                            <iconify-icon icon="solar:file-bold-duotone" width="20" height="20" class="text-primary"></iconify-icon>
                            <span class="text-sm flex-1 truncate" x-text="pendingFile.name"></span>
                            <span class="text-[10px] text-white-dark" x-text="formatFileSize(pendingFile.size)"></span>
                            <button @click="pendingFile = null; $refs.fileInput.value = ''" class="hover:text-danger">
                                <iconify-icon icon="solar:close-circle-bold" width="18" height="18"></iconify-icon>
                            </button>
                        </div>
                    </template>
                </div>
            </div>
        </template>
    </div>
</div>

<!-- Socket.IO client -->
<script src="/socket.io/socket.io.js"></script>

<script>
/**
 * Chat Application — Alpine.js component
 * 
 * Handles WebSocket connection, conversation management, and message display.
 * Uses Socket.IO for real-time communication.
 * 
 * Registered via Alpine.data() so it's available before Alpine processes x-data.
 */
document.addEventListener('alpine:init', () => {
    Alpine.data('chatApp', () => ({
        // State
        socket: null,
        currentUser: <%- JSON.stringify(currentUser) %>,
        accountNumber: '<%= account_number %>',
        conversations: [],
        filteredConversations: [],
        selectedConversation: null,
        messages: [],
        newMessage: '',
        searchQuery: '',
        showSidebar: false,
        showNewConversation: false,
        availableUsers: [],
        onlineUsers: [],
        typingUsers: {},
        typingTimeout: null,
        loading: true,
        loadingMessages: false,
        loadingMoreMessages: false,
        pendingFile: null,

        /**
         * Initialize the chat app
         */
        async init() {
            console.log('[Chat] Initializing chat app for user:', this.currentUser.id);
            
            // Connect to Socket.IO
            this.connectSocket();
            
            // Load conversations via REST API
            await this.loadConversations();
            
            // Load available users for new conversations
            await this.loadAvailableUsers();
            
            this.loading = false;
        },

        /**
         * Connect to Socket.IO server
         */
        connectSocket() {
            this.socket = io('/', {
                transports: ['websocket', 'polling'],
            });

            this.socket.on('connect', () => {
                console.log('[Chat] Socket connected:', this.socket.id);
                // Join conversation rooms
                this.socket.emit('chat:join', { accountNumber: this.accountNumber });
            });

            this.socket.on('connect_error', (err) => {
                console.error('[Chat] Socket connection error:', err.message);
            });

            // Handle incoming messages
            this.socket.on('chat:newMessage', (msg) => {
                console.log('[Chat] New message received:', msg);
                
                // If message is in the currently selected conversation, add it
                if (this.selectedConversation && msg.conversationId === this.selectedConversation._id) {
                    this.messages.push(msg);
                    this.$nextTick(() => this.scrollToBottom());
                    // Mark as read
                    this.socket.emit('chat:markRead', { conversationId: msg.conversationId });
                }

                // Update conversation list
                this.updateConversationPreview(msg);
            });

            // Handle online users list
            this.socket.on('chat:onlineUsers', (users) => {
                console.log('[Chat] Online users:', users);
                this.onlineUsers = users;
            });

            // Handle user status changes
            this.socket.on('chat:userStatus', ({ userId, online }) => {
                console.log(`[Chat] User ${userId} is now ${online ? 'online' : 'offline'}`);
                if (online && !this.onlineUsers.includes(userId)) {
                    this.onlineUsers.push(userId);
                } else if (!online) {
                    this.onlineUsers = this.onlineUsers.filter(id => id !== userId);
                }
            });

            // Handle typing indicator
            this.socket.on('chat:userTyping', ({ conversationId, userId, isTyping }) => {
                if (userId === this.currentUser.id) return;
                if (isTyping) {
                    this.typingUsers[conversationId] = true;
                } else {
                    delete this.typingUsers[conversationId];
                }
            });

            // Handle messages loaded
            this.socket.on('chat:messages', ({ conversationId, messages, hasMore }) => {
                if (this.selectedConversation && this.selectedConversation._id === conversationId) {
                    if (this.loadingMoreMessages) {
                        // Prepend older messages
                        this.messages = [...messages, ...this.messages];
                        this.loadingMoreMessages = false;
                    } else {
                        this.messages = messages;
                        this.$nextTick(() => this.scrollToBottom());
                    }
                    this.loadingMessages = false;
                }
            });

            // Handle message seen
            this.socket.on('chat:messageSeen', ({ conversationId, userId }) => {
                if (this.selectedConversation && this.selectedConversation._id === conversationId) {
                    this.messages.forEach(msg => {
                        if (!msg.readBy) msg.readBy = [];
                        if (!msg.readBy.find(r => r.userId === userId)) {
                            msg.readBy.push({ userId, readAt: new Date() });
                        }
                    });
                }
            });

            // Handle errors
            this.socket.on('chat:error', ({ message }) => {
                console.error('[Chat] Socket error:', message);
            });
        },

        /**
         * Load conversations from REST API
         */
        async loadConversations() {
            try {
                const res = await fetch(`/account/${this.accountNumber}/chat/api/conversations`, {
                    credentials: 'include'
                });
                this.conversations = await res.json();
                this.filterConversations();
                console.log(`[Chat] Loaded ${this.conversations.length} conversations`);
            } catch (err) {
                console.error('[Chat] Error loading conversations:', err);
            }
        },

        /**
         * Load available users for starting new conversations
         */
        async loadAvailableUsers() {
            try {
                const res = await fetch(`/account/${this.accountNumber}/chat/api/users`, {
                    credentials: 'include'
                });
                this.availableUsers = await res.json();
                console.log(`[Chat] Loaded ${this.availableUsers.length} available users`);
            } catch (err) {
                console.error('[Chat] Error loading users:', err);
            }
        },

        /**
         * Filter conversations based on search query
         */
        filterConversations() {
            if (!this.searchQuery) {
                this.filteredConversations = this.conversations;
            } else {
                const q = this.searchQuery.toLowerCase();
                this.filteredConversations = this.conversations.filter(conv => {
                    const name = this.getConversationName(conv).toLowerCase();
                    const preview = (conv.lastMessage?.text || '').toLowerCase();
                    return name.includes(q) || preview.includes(q);
                });
            }
        },

        /**
         * Select a conversation
         */
        async selectConversation(conv) {
            this.selectedConversation = conv;
            this.showSidebar = false;
            this.loadingMessages = true;
            this.messages = [];

            // Load messages via REST API (fallback) + socket
            try {
                const res = await fetch(`/account/${this.accountNumber}/chat/api/conversations/${conv._id}`, {
                    credentials: 'include'
                });
                const data = await res.json();
                this.messages = data.messages || [];
                this.$nextTick(() => this.scrollToBottom());
            } catch (err) {
                console.error('[Chat] Error loading conversation:', err);
            }
            this.loadingMessages = false;

            // Mark as read
            if (this.socket) {
                this.socket.emit('chat:markRead', { conversationId: conv._id });
            }
            // Reset unread count locally
            conv.unreadCount = 0;
        },

        /**
         * Start a new conversation with a user
         */
        async startConversation(targetUserId) {
            try {
                const res = await fetch(`/account/${this.accountNumber}/chat/api/conversations`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        type: 'direct',
                        participantIds: [targetUserId]
                    })
                });
                const conv = await res.json();
                
                // Add to list if not already there
                const existing = this.conversations.find(c => c._id === conv._id);
                if (!existing) {
                    this.conversations.unshift(conv);
                    this.filterConversations();
                }

                // Select it
                const target = this.conversations.find(c => c._id === conv._id);
                if (target) {
                    await this.selectConversation(target);
                }

                // Join the room
                if (this.socket) {
                    this.socket.emit('chat:join', { accountNumber: this.accountNumber });
                }

                this.showNewConversation = false;
                console.log('[Chat] Started conversation:', conv._id);
            } catch (err) {
                console.error('[Chat] Error creating conversation:', err);
            }
        },

        /**
         * Send a message
         */
        sendMessage() {
            if (!this.newMessage.trim() && !this.pendingFile) return;
            if (!this.selectedConversation) return;

            // If there's a pending file, upload it
            if (this.pendingFile) {
                this.uploadAndSendFile();
                return;
            }

            const text = this.newMessage.trim();
            this.newMessage = '';

            // Send via Socket.IO
            this.socket.emit('chat:sendMessage', {
                conversationId: this.selectedConversation._id,
                text,
                type: 'text'
            });

            // Stop typing indicator
            this.socket.emit('chat:typing', {
                conversationId: this.selectedConversation._id,
                isTyping: false
            });
        },

        /**
         * Handle file upload
         */
        handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            this.pendingFile = file;
        },

        /**
         * Upload file and send as message
         */
        async uploadAndSendFile() {
            if (!this.pendingFile || !this.selectedConversation) return;

            const formData = new FormData();
            formData.append('file', this.pendingFile);

            try {
                // Upload file to server
                const res = await fetch(`/account/${this.accountNumber}/chat/api/upload`, {
                    method: 'POST',
                    credentials: 'include',
                    body: formData
                });

                if (res.ok) {
                    const { url, filename, mimetype, size } = await res.json();
                    const isImage = mimetype && mimetype.startsWith('image/');

                    // Send as file/image message via socket
                    this.socket.emit('chat:sendMessage', {
                        conversationId: this.selectedConversation._id,
                        text: this.newMessage.trim() || filename,
                        type: isImage ? 'image' : 'file',
                        attachment: { url, filename, mimetype, size }
                    });
                    this.newMessage = '';
                }
            } catch (err) {
                console.error('[Chat] Error uploading file:', err);
            }

            this.pendingFile = null;
            this.$refs.fileInput.value = '';
        },

        /**
         * Handle typing indicator
         */
        handleTyping() {
            if (!this.selectedConversation) return;

            this.socket.emit('chat:typing', {
                conversationId: this.selectedConversation._id,
                isTyping: true
            });

            // Clear previous timeout
            clearTimeout(this.typingTimeout);
            this.typingTimeout = setTimeout(() => {
                this.socket.emit('chat:typing', {
                    conversationId: this.selectedConversation._id,
                    isTyping: false
                });
            }, 2000);
        },

        /**
         * Handle scroll (load older messages on scroll to top)
         */
        handleScroll() {
            const container = this.$refs.messagesContainer;
            if (!container) return;
            if (container.scrollTop < 50 && !this.loadingMoreMessages && this.messages.length > 0) {
                this.loadMoreMessages();
            }
        },

        /**
         * Load more (older) messages
         */
        loadMoreMessages() {
            if (this.loadingMoreMessages || !this.selectedConversation) return;
            this.loadingMoreMessages = true;
            const oldestMessage = this.messages[0];
            if (oldestMessage) {
                this.socket.emit('chat:loadMessages', {
                    conversationId: this.selectedConversation._id,
                    before: oldestMessage.createdAt,
                    limit: 50
                });
            }
        },

        /**
         * Update conversation preview when new message arrives
         */
        updateConversationPreview(msg) {
            const conv = this.conversations.find(c => c._id === msg.conversationId);
            if (conv) {
                conv.lastMessage = {
                    text: msg.text,
                    senderId: msg.senderId,
                    senderName: msg.senderName,
                    sentAt: msg.createdAt,
                    type: msg.type
                };
                // If not the selected conversation, increment unread
                if (!this.selectedConversation || this.selectedConversation._id !== msg.conversationId) {
                    if (msg.senderId !== this.currentUser.id) {
                        conv.unreadCount = (conv.unreadCount || 0) + 1;
                    }
                }
                // Move to top
                this.conversations = [conv, ...this.conversations.filter(c => c._id !== conv._id)];
                this.filterConversations();
            } else {
                // New conversation not in list yet, reload
                this.loadConversations();
            }
        },

        /**
         * Scroll to bottom of messages
         */
        scrollToBottom() {
            const container = this.$refs.messagesContainer;
            if (container) {
                container.scrollTop = container.scrollHeight;
            }
        },

        // ===== UTILITY METHODS =====

        /**
         * Get display name for a conversation
         */
        getConversationName(conv) {
            if (!conv) return '';
            if (conv.type === 'group') return conv.name || 'Groupe';
            // Direct: show other participant's name
            const other = conv.participants?.find(p => p.userId !== this.currentUser.id);
            return other?.name || other?.email || 'Inconnu';
        },

        /**
         * Check if a conversation's other participant is online
         */
        isConversationOnline(conv) {
            if (!conv || !conv.participants) return false;
            const other = conv.participants.find(p => p.userId !== this.currentUser.id);
            return other ? this.onlineUsers.includes(other.userId) : false;
        },

        /**
         * Check if a user is online
         */
        isUserOnline(userId) {
            return this.onlineUsers.includes(userId);
        },

        /**
         * Get user initials from name
         */
        getInitials(name) {
            if (!name) return '?';
            return name.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();
        },

        /**
         * Generate consistent gradient color from name (for avatars)
         */
        getAvatarGradient(name) {
            if (!name) return 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
            const gradients = [
                'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
                'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
                'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
                'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
                'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
                'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)',
                'linear-gradient(135deg, #fccb90 0%, #d57eeb 100%)',
                'linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%)',
                'linear-gradient(135deg, #f5576c 0%, #ff8a5c 100%)',
                'linear-gradient(135deg, #00c6fb 0%, #005bea 100%)',
            ];
            let hash = 0;
            for (let i = 0; i < name.length; i++) {
                hash = name.charCodeAt(i) + ((hash << 5) - hash);
            }
            return gradients[Math.abs(hash) % gradients.length];
        },

        /**
         * Format timestamp for conversation list
         */
        formatTime(date) {
            if (!date) return '';
            const d = new Date(date);
            const now = new Date();
            const diff = now - d;
            
            // Today: show time
            if (diff < 86400000 && d.getDate() === now.getDate()) {
                return d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
            }
            // Yesterday
            if (diff < 172800000) return 'Hier';
            // This week
            if (diff < 604800000) {
                return d.toLocaleDateString('fr-FR', { weekday: 'short' });
            }
            // Older
            return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
        },

        /**
         * Format message timestamp
         */
        formatMessageTime(date) {
            if (!date) return '';
            const d = new Date(date);
            return d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
        },

        /**
         * Format file size (bytes → human readable)
         */
        formatFileSize(bytes) {
            if (!bytes) return '';
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / 1048576).toFixed(1) + ' MB';
        }
    }));
});
</script>
