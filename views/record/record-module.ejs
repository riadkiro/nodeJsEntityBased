        Alpine.data('ovSmartDocs', () => ({
            templates: [],
            loading: true,
            generatingId: null,
            showPreview: false,
            previewName: '',
            draftDocId: null,
            finalizing: false,
            finalized: false,
            downloadUrl: '',
            _accountNumber: '<%= account_number %>',
            _entityId: '<%= entity._id %>',
            _recordId: '<%= record._id %>',

            init() {
                this.loadTemplates();
                // Listen for cancel from iframe
                window.addEventListener('message', (e) => {
                    if (e.data && e.data.type === 'smartdoc-cancel') {
                        this.cancelPreview();
                    }
                });
            },

            async loadTemplates() {
                this.loading = true;
                try {
                    const url = `/account/${this._accountNumber}/api/smartdoc/templates/${this._entityId}?recordId=${this._recordId}`;
                    const res = await fetch(url, { credentials: 'include' });
                    const data = await res.json();
                    if (data.success && data.templates) {
                        this.templates = data.templates;
                    }
                } catch (e) {
                    console.error('[OvSmartDocs] Load error:', e);
                }
                this.loading = false;
            },

            async generateDoc(tpl) {
                this.generatingId = tpl._id;
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/smartdoc/generate-draft/${tpl._id}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ recordId: this._recordId, inputs: {} })
                    });
                    const data = await res.json();
                    if (data.success && data.draftDocumentId) {
                        this.draftDocId = data.draftDocumentId;
                        this.previewName = data.outputName || tpl.name || 'Document';
                        this.showPreview = true;
                        this.$nextTick(() => {
                            const iframe = document.getElementById('ov-smartdoc-preview-iframe');
                            if (iframe) {
                                iframe.src = `/account/${this._accountNumber}/documents/${data.draftDocumentId}/edit-react?minimal=true`;
                            }
                        });
                    } else {
                        window.showMessage ? window.showMessage(data.error || 'Erreur lors de la génération', 'danger') : alert(data.error || 'Erreur lors de la génération');
                    }
                } catch (e) {
                    console.error('[OvSmartDocs] Generate error:', e);
                    window.showMessage ? window.showMessage('Erreur de connexion', 'danger') : alert('Erreur de connexion');
                }
                this.generatingId = null;
            },

            async finalizePreview() {
                if (!this.draftDocId || this.finalizing) return;
                this.finalizing = true;
                try {
                    // ── PERMANENT FIX: get live DOM content from iframe ──────────────────
                    // The iframe runs the React editor with uncontrolled contenteditable.
                    // The DB (draftDoc.pages) contains only the initial generated content.
                    // User edits live ONLY in the iframe DOM until autosave runs.
                    // We MUST send pagesContent from the iframe to get the correct PDF output.
                    let pagesContent = null;
                    try {
                        const iframe = document.getElementById('ov-smartdoc-preview-iframe');
                        if (iframe && iframe.contentWindow) {
                            pagesContent = await new Promise((resolve) => {
                                const timeout = setTimeout(() => resolve(null), 5000); // 5s timeout
                                const handler = (event) => {
                                    if (event.data && event.data.type === 'PAGES_CONTENT_RESPONSE') {
                                        clearTimeout(timeout);
                                        window.removeEventListener('message', handler);
                                        resolve(event.data.pagesContent || null);
                                    }
                                };
                                window.addEventListener('message', handler);
                                iframe.contentWindow.postMessage({ type: 'REQUEST_PAGES_CONTENT' }, '*');
                            });
                        }
                    } catch (e) {
                        console.warn('[OvSmartDocs] Could not get pages from iframe:', e);
                    }

                    const res = await fetch(`/account/${this._accountNumber}/api/smartdoc/finalize-draft/${this.draftDocId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ recordId: this._recordId, pagesContent, outputName: this.previewName || null })
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.downloadUrl = data.attachment?.url ? (data.attachment.url + '?dl=' + encodeURIComponent(data.attachment.originalName || 'document.pdf')) : '';
                        this.finalized = true;
                        this.draftDocId = null;
                        if (window.showMessage) {
                            window.showMessage('Document généré avec succès !', 'success');
                        }
                    } else {
                        window.showMessage ? window.showMessage(data.error || 'Erreur de finalisation', 'danger') : alert(data.error || 'Erreur de finalisation');
                    }
                } catch (e) {
                    console.error('[OvSmartDocs] Finalize error:', e);
                    window.showMessage ? window.showMessage('Erreur de connexion', 'danger') : alert('Erreur de connexion');
                }
                this.finalizing = false;
            },

            closePreview() {
                this.showPreview = false;
                this.finalized = false;
                this.downloadUrl = '';
                this.draftDocId = null;
                this.previewName = '';
                const iframe = document.getElementById('ov-smartdoc-preview-iframe');
                if (iframe) iframe.src = '';
                // Reload to show the newly attached file
                window.location.reload();
            },

            async cancelPreview() {
                // Delete the draft
                if (this.draftDocId) {
                    try {
                        await fetch(`/account/${this._accountNumber}/api/smartdoc/draft/${this.draftDocId}`, {
                            method: 'DELETE',
                            credentials: 'include'
                        });
                    } catch (e) { /* ignore */ }
                }
                this.showPreview = false;
                this.draftDocId = null;
                this.previewName = '';
                this.finalized = false;
                this.downloadUrl = '';
                // Clear iframe
                const iframe = document.getElementById('ov-smartdoc-preview-iframe');
                if (iframe) iframe.src = 'about:blank';
            }
        }));

        Alpine.data('ovAgendaWidget', (mode = 'upcoming') => ({
            mode,
            events: [],
            entityData: null,
            loading: true,
            saving: false,
            showForm: false,
            canEdit: _overviewRecordModuleCanEdit,
            form: { title: '', date: '' },
            eventBaseUrl: <%- JSON.stringify(_recBase + '/agenda') %>,

            init() {
                this.resetForm();
                this.load();
            },

            get isImportantMode() {
                return this.mode === 'important';
            },

            resetForm() {
                const d = new Date();
                d.setMinutes(Math.ceil(d.getMinutes() / 5) * 5, 0, 0);
                this.form = { title: '', date: this.toLocalDateTime(d) };
            },

            openForm() {
                if (!this.canEdit) return;
                this.resetForm();
                this.showForm = true;
                this.$nextTick(() => this.$refs.eventTitle?.focus());
            },

            closeForm() {
                this.showForm = false;
                this.resetForm();
            },

            async load() {
                this.loading = true;
                try {
                    const res = await fetch('/account/<%= account_number %>/api/records/<%= record._id %>/events', { credentials: 'include' });
                    const data = await res.json();
                    if (data.success && data.events) {
                        this.entityData = data.entityData || null;
                        const now = new Date();
                        this.events = data.events
                            .filter(e => e.date && new Date(e.date) >= now)
                            .filter(e => this.isImportantMode ? this.isImportantDateEvent(e) : this.isUpcomingEvent(e))
                            .sort((a, b) => new Date(a.date) - new Date(b.date))
                            .slice(0, 40)
                            .map(e => this.formatEvent(e));
                    } else {
                        this.events = [];
                    }
                } catch(e) {
                    console.warn('[OV-Agenda]', e);
                    this.events = [];
                }
                this.loading = false;
            },

            async createEvent() {
                if (!this.canEdit || this.saving) return;
                const title = String(this.form.title || '').trim();
                const dateValue = this.form.date ? new Date(this.form.date) : null;
                if (!title || !dateValue || Number.isNaN(dateValue.getTime())) {
                    window.showMessage ? window.showMessage('Titre et date requis', 'warning') : alert('Titre et date requis');
                    return;
                }

                this.saving = true;
                try {
                    const important = this.isImportantMode;
                    const res = await fetch('/account/<%= account_number %>/api/records/<%= record._id %>/events', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({
                            title,
                            date: dateValue.toISOString(),
                            duration: 30,
                            type: important ? 'rappel' : 'consultation',
                            tags: important ? ['Date importante'] : [],
                            showInUpcomingWidget: true,
                            isImportantDate: important,
                        })
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok || !data.success) throw new Error(data.error || data.message || 'Création impossible');
                    this.closeForm();
                    await this.load();
                    window.dispatchEvent(new CustomEvent('record-events-updated'));
                    if (window.showMessage) window.showMessage(important ? 'Date importante ajoutée' : 'Événement ajouté', 'success');
                } catch (e) {
                    console.error('[OV-Agenda] Create error:', e);
                    window.showMessage ? window.showMessage(e.message || 'Création impossible', 'danger') : alert(e.message || 'Création impossible');
                }
                this.saving = false;
            },

            isUpcomingEvent(event) {
                return this.booleanValue(this.customValue(event, 'widget_prochains_evenements'), true);
            },

            isImportantDateEvent(event) {
                const explicit = this.customValue(event, 'widget_date_importante');
                if (explicit !== undefined && explicit !== null && explicit !== '') {
                    return this.booleanValue(explicit, false);
                }
                return this.tagsValue(event).some(tag => tag.toLowerCase() === 'date importante');
            },

            customValue(event, fieldName) {
                const field = (this.entityData?.customFields || []).find(f => f.name === fieldName);
                if (!field) return undefined;
                const cf = (event.customFields || []).find(item => {
                    const fid = item.field_id?._id || item.field_id;
                    return String(fid || '') === String(field._id || '');
                });
                return cf ? cf.value : undefined;
            },

            tagsValue(event) {
                const value = this.customValue(event, 'tags_evenement');
                const normalize = item => {
                    if (item && typeof item === 'object') {
                        return String(item.label || item.value || item.name || '').trim();
                    }
                    return String(item || '').trim();
                };
                if (Array.isArray(value)) return value.map(normalize).filter(Boolean);
                if (typeof value === 'string') return value.split(',').map(item => item.trim()).filter(Boolean);
                return [];
            },

            eventLocation(event) {
                return String(this.customValue(event, 'lieu_evenement') || '').trim();
            },

            eventLabelInfo(event) {
                const tag = this.tagsValue(event)[0] || '';
                if (!tag) return null;
                const tagField = (this.entityData?.customFields || []).find(f => f.name === 'tags_evenement');
                const option = (tagField?.type_config?.options || []).find(opt => {
                    const raw = opt && typeof opt === 'object' ? (opt.value || opt.label) : opt;
                    return String(raw || '').trim().toLowerCase() === tag.toLowerCase();
                });
                return {
                    label: String((option && typeof option === 'object' ? option.label : '') || tag).trim(),
                    color: String((option && typeof option === 'object' ? option.color : '') || '#64748b').trim()
                };
            },

            eventUrl(event) {
                const id = String(event._id || '').trim();
                return id ? `${this.eventBaseUrl}?event=${encodeURIComponent(id)}` : this.eventBaseUrl;
            },

            relativeDateLabel(date) {
                const target = new Date(date);
                if (Number.isNaN(target.getTime())) return '';
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                target.setHours(0, 0, 0, 0);
                const diffDays = Math.round((target - today) / 86400000);
                if (diffDays === 0) return "aujourd'hui";
                if (diffDays === 1) return 'demain';
                if (diffDays > 1) return `dans ${diffDays} jours`;
                if (diffDays === -1) return 'hier';
                return `il y a ${Math.abs(diffDays)} jours`;
            },

            booleanValue(value, fallback = false) {
                if (value === undefined || value === null || value === '') return fallback;
                if (typeof value === 'boolean') return value;
                if (typeof value === 'number') return value !== 0;
                const token = String(value).trim().toLowerCase();
                if (['true', '1', 'yes', 'oui', 'on'].includes(token)) return true;
                if (['false', '0', 'no', 'non', 'off'].includes(token)) return false;
                return fallback;
            },

            formatEvent(event) {
                const d = new Date(event.date);
                const statusCls = this.entityData?.statusClassification;
                const cv = (event.classificationValues || []).find(c => {
                    const cid = c.classificationId?._id || c.classificationId;
                    return String(cid || '') === String(statusCls?._id || '');
                });
                const opt = cv ? (statusCls?.options || []).find(o => String(o._id || '') === String(cv.optionId || '')) : null;
                const title = event.title || 'Sans titre';
                const status = opt?.label || cv?.label || 'Planifié';
                const color = opt?.color || cv?.color || (this.isImportantMode ? '#f59e0b' : '#14b8a6');
                const location = this.eventLocation(event);
                const labelInfo = this.eventLabelInfo(event);
                const time = d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', hour12: false });
                const relative = this.relativeDateLabel(d);
                return {
                    id: String(event._id || ''),
                    url: this.eventUrl(event),
                    title,
                    day: d.getDate().toString().padStart(2, '0'),
                    month: d.toLocaleDateString('fr-FR', { month: 'short' }).replace('.', '').toUpperCase(),
                    time,
                    status,
                    color,
                    relative,
                    location,
                    label: labelInfo?.label || '',
                    labelColor: labelInfo?.color || '#64748b',
                    tooltip: [title, `${time} · ${status}${relative ? ' · ' + relative : ''}`, location, labelInfo?.label].filter(Boolean).join('\n')
                };
            },

            toLocalDateTime(date) {
                const y = date.getFullYear();
                const m = String(date.getMonth() + 1).padStart(2, '0');
                const d = String(date.getDate()).padStart(2, '0');
                const h = String(date.getHours()).padStart(2, '0');
                const min = String(date.getMinutes()).padStart(2, '0');
                return `${y}-${m}-${d}T${h}:${min}`;
            }
        }));

        // ═══ Overview Layout Builder ═══
        Alpine.data('ovLayoutBuilder', () => ({
            layoutMode: false,
            rows: [],
            _defaultRows: [
                { id: 'r0', columns: [{ id: 'c0', width: 12, widgetIds: ['today-tasks'] }] },
                { id: 'r1', columns: [{ id: 'c1', width: 8, widgetIds: ['fields'] }, { id: 'c2', width: 4, widgetIds: ['tasks','docs'] }] },
