    <script>
    document.addEventListener('alpine:init', () => {
        const _baseUrl = window.location.pathname.replace(/\/overview$/, '');
        const _recUrl = '/account/<%= account_number %>/record/<%= entity.slug %>/<%= record._id %>';

        Alpine.data('ovInlineEdit', () => ({
            editingKey: '',
            saving: false,
            startEdit(key, e) {
                if (this.editingKey === key) return;
                // If another field was being edited, auto-save it first
                if (this.editingKey) this._doSave(this.editingKey);
                this.editingKey = key;
                this.$nextTick(() => {
                    const ref = this.$refs['input_' + key];
                    if (ref) ref.focus();
                });
            },
            cancelEdit() { this.editingKey = ''; },
            // Called by @click.outside on each ov-ef
            autoSave(key) {
                if (this.editingKey !== key) return;
                this._doSave(key);
            },
            saveCurrentField() {
                if (!this.editingKey) return;
                this._doSave(this.editingKey);
            },
            _doSave(key) {
                const ref = this.$refs['input_' + key];
                if (!ref) { this.editingKey = ''; return; }
                // For multiselect pills, get the selected array from the inner x-data
                if (ref.hasAttribute && ref.hasAttribute('x-data') && ref._x_dataStack) {
                    const inner = ref._x_dataStack[0];
                    if (inner && inner.selected) {
                        this.saveField(key, inner.selected);
                        return;
                    }
                }
                this.saveField(key, ref.value);
            },
            async saveField(key, value) {
                if (this.saving) return;
                this.saving = true;
                const editingK = key;
                try {
                    const res = await fetch(_recUrl + '/update-field', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ fieldKey: key, value })
                    });
                    if (res.ok) {
                        // Update DOM in place
                        const fieldEl = document.querySelector('.ov-ef[data-key="' + editingK + '"]');
                        if (fieldEl) {
                            const viewEl = fieldEl.querySelector('.ov-ef-view');
                            if (viewEl) {
                                const displayVal = Array.isArray(value) ? value.join(', ') : (value || '');
                                if (displayVal) {
                                    viewEl.innerHTML = '<span class="ov-ef-val">' + displayVal.replace(/</g,'&lt;') + '</span>';
                                } else {
                                    viewEl.innerHTML = '<span class="ov-placeholder">' + (fieldEl.querySelector('.ov-ef-label')?.textContent || 'Valeur') + '</span>';
                                }
                            }
                        }
                        this.editingKey = '';
                    }
                } catch (e) { console.error('[OV save]', e); }
                this.saving = false;
            }
        }));

        // Relation editor sub-component
        Alpine.data('ovRelEditor', (cfg) => ({
            key: cfg.key,
            targetEntityId: cfg.targetEntityId,
            targetEntitySlug: cfg.targetEntitySlug || '',
            isMulti: cfg.isMulti,
            color: cfg.color || '#4361ee',
            tags: [...(cfg.initial || [])],
            searchQ: '',
            results: [],
            showDropdown: false,
            dirty: false,
            init() {
                this.$nextTick(() => {
                    const inp = this.$refs.relSearchInput;
                    if (inp) inp.focus();
                });
            },
            async search() {
                if (!this.targetEntityId) return;
                const q = this.searchQ.trim();
                try {
                    const url = '/account/<%= account_number %>/record/api/search?entityId=' + this.targetEntityId + '&q=' + encodeURIComponent(q) + '&limit=8';
                    const res = await fetch(url, { credentials: 'include' });
                    const data = await res.json();
                    // Exclude already-selected tags
                    const tagIds = this.tags.map(t => t._id);
                    this.results = (data.data || []).filter(r => !tagIds.includes(r.id)).map(r => ({
                        _id: r.id,
                        title: r.label || 'Sans titre'
                    }));
                    this.showDropdown = true;
                } catch (e) { console.error('[RelSearch]', e); }
            },
            async addTag(record) {
                if (!this.isMulti) this.tags = [];
                this.tags.push({ _id: record._id, title: record.title });
                this.searchQ = '';
                this.results = [];
                this.showDropdown = false;
                this.dirty = true;
                // Persist immediately - use 'set' for single-value, 'add' for multi
                if (this.isMulti) {
                    await this._persist('add', record._id);
                } else {
                    await this._persistSet([record._id]);
                    this.closeAndSave();
                }
            },
            async removeTag(id) {
                this.tags = this.tags.filter(t => t._id !== id);
                this.dirty = true;
                await this._persist('remove', id);
            },
            async _persist(action, targetId) {
                try {
                    await fetch(_recUrl + '/update-relation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ relationKey: this.key, action, targetId })
                    });
                } catch (e) { console.error('[RelPersist]', e); }
            },
            async _persistSet(ids) {
                try {
                    await fetch(_recUrl + '/update-relation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ relationKey: this.key, action: 'set', targetIds: ids })
                    });
                } catch (e) { console.error('[RelPersist]', e); }
            },
            async createNew() {
                const title = this.searchQ.trim();
                if (!title || !this.targetEntityId) return;
                try {
                    const res = await fetch('/account/<%= account_number %>/record/api/quick-create', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ entityId: this.targetEntityId, title })
                    });
                    const data = await res.json();
                    if (data.success && data.record) {
                        // Add the newly created record as a tag
                        await this.addTag({ _id: data.record._id, title: data.record.title });
                    }
                } catch (e) { console.error('[QuickCreate]', e); }
            },
            closeAndSave() {
                this.results = [];
                this.searchQ = '';
                this.showDropdown = false;
                // Update the view-state DOM
                const parent = this.$el.closest('.ov-ef');
                if (parent) {
                    const viewEl = parent.querySelector('.ov-ef-view');
                    if (viewEl) {
                        if (this.tags.length > 0) {
                            viewEl.innerHTML = '<div class="ov-tags">' + this.tags.map(t =>
                                '<span class="ov-tag" style="background:' + this.color + '10;border-color:' + this.color + '30;color:' + this.color + '">' + t.title.replace(/</g,'&lt;') + '</span>'
                            ).join('') + '</div>';
                        } else {
                            viewEl.innerHTML = '<span class="ov-placeholder">Sélectionner...</span>';
                        }
                    }
                }
                // Close by setting parent editingKey
                const grid = this.$el.closest('[x-data]');
                if (grid && grid._x_dataStack) {
                    const root = grid._x_dataStack.find(d => d.editingKey !== undefined);
                    if (root) root.editingKey = '';
                }
            }
        }));

        // ═══ Overview SmartDocs Component ═══
        Alpine.data('ovSmartDocs', () => ({
            templates: [],
            loading: true,
            generatingId: null,
            showPreview: false,
            previewName: '',
            draftDocId: null,
            finalizing: false,
            finalized: false,
            downloadUrl: '',
            _accountNumber: '<%= account_number %>',
            _entityId: '<%= entity._id %>',
            _recordId: '<%= record._id %>',

            init() {
                this.loadTemplates();
                // Listen for cancel from iframe
                window.addEventListener('message', (e) => {
                    if (e.data && e.data.type === 'smartdoc-cancel') {
                        this.cancelPreview();
                    }
                });
            },

            async loadTemplates() {
                this.loading = true;
                try {
                    const url = `/account/${this._accountNumber}/api/smartdoc/templates/${this._entityId}?recordId=${this._recordId}`;
                    const res = await fetch(url, { credentials: 'include' });
                    const data = await res.json();
                    if (data.success && data.templates) {
                        this.templates = data.templates;
                    }
                } catch (e) {
                    console.error('[OvSmartDocs] Load error:', e);
                }
                this.loading = false;
            },

            async generateDoc(tpl) {
                this.generatingId = tpl._id;
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/smartdoc/generate-draft/${tpl._id}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ recordId: this._recordId, inputs: {} })
                    });
                    const data = await res.json();
                    if (data.success && data.draftDocumentId) {
                        this.draftDocId = data.draftDocumentId;
                        this.previewName = data.outputName || tpl.name || 'Document';
                        this.showPreview = true;
                        this.$nextTick(() => {
                            const iframe = document.getElementById('ov-smartdoc-preview-iframe');
                            if (iframe) {
                                iframe.src = `/account/${this._accountNumber}/documents/${data.draftDocumentId}/edit-react?minimal=true`;
                            }
                        });
                    } else {
                        alert(data.error || 'Erreur lors de la génération');
                    }
                } catch (e) {
                    console.error('[OvSmartDocs] Generate error:', e);
                    alert('Erreur de connexion');
                }
                this.generatingId = null;
            },

            async finalizePreview() {
                if (!this.draftDocId || this.finalizing) return;
                this.finalizing = true;
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/smartdoc/finalize-draft/${this.draftDocId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ recordId: this._recordId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        // Switch to finalized state — show Télécharger + Fermer
                        this.downloadUrl = data.attachment?.url || '';
                        this.finalized = true;
                        this.draftDocId = null;
                        if (window.showMessage) {
                            window.showMessage('Document généré avec succès !', 'success');
                        }
                    } else {
                        alert(data.error || 'Erreur de finalisation');
                    }
                } catch (e) {
                    console.error('[OvSmartDocs] Finalize error:', e);
                    alert('Erreur de connexion');
                }
                this.finalizing = false;
            },

            closePreview() {
                this.showPreview = false;
                this.finalized = false;
                this.downloadUrl = '';
                this.draftDocId = null;
                this.previewName = '';
                const iframe = document.getElementById('ov-smartdoc-preview-iframe');
                if (iframe) iframe.src = '';
                // Reload to show the newly attached file
                window.location.reload();
            },

            async cancelPreview() {
                // Delete the draft
                if (this.draftDocId) {
                    try {
                        await fetch(`/account/${this._accountNumber}/api/smartdoc/draft/${this.draftDocId}`, {
                            method: 'DELETE',
                            credentials: 'include'
                        });
                    } catch (e) { /* ignore */ }
                }
                this.showPreview = false;
                this.draftDocId = null;
                this.previewName = '';
                this.finalized = false;
                this.downloadUrl = '';
                // Clear iframe
                const iframe = document.getElementById('ov-smartdoc-preview-iframe');
                if (iframe) iframe.src = 'about:blank';
            }
        }));
    });
    </script>
    <% } %>

