<!-- HTML TEMPLATE                                               -->
<!-- ═══════════════════════════════════════════════════════════ -->

<% if (driveMode === 'global') { %>
<!-- Global Drive Hero -->
<div class="drive-hero">
    <div class="drive-hero-icon">
        <iconify-icon icon="solar:cloud-storage-bold-duotone" width="28" style="color:#ec4899"></iconify-icon>
    </div>
    <div class="drive-hero-info">
        <h1>
            <iconify-icon icon="solar:cloud-storage-bold-duotone" width="24" style="color:#ec4899"></iconify-icon>
            Drive
        </h1>
        <p>Tous vos fichiers et documents organisés par entité</p>
    </div>
</div>
<% } %>

<div x-data="driveModule" x-cloak style="position:relative;min-height:calc(100vh - 200px);"
     @dragenter.prevent="isAtFileLevel ? onDragEnter($event) : null"
     @dragover.prevent
     @dragleave.prevent="isAtFileLevel ? onDragLeave($event) : null"
     @drop.prevent="isAtFileLevel ? handleDrop($event) : null"
     @contextmenu.prevent="openBackgroundContextMenu($event)">

    <!-- Drag overlay -->
    <div x-show="isDragging && isAtFileLevel" class="drive-dropzone-overlay" style="display:none;" x-transition.opacity>
        <iconify-icon icon="solar:cloud-upload-bold-duotone" width="48" style="color:#4361ee;"></iconify-icon>
        <p>Déposez vos fichiers ici</p>
        <span x-text="currentFolder ? 'dans ' + currentFolder : 'dans le Drive'"></span>
    </div>

    <!-- ═══ BREADCRUMB ═══ -->
    <% if (driveMode === 'global') { %>
    <!-- Global breadcrumb (fully dynamic) -->
    <div class="drive-breadcrumb">
        <template x-for="(crumb, ci) in globalBreadcrumb" :key="ci">
            <span style="display:inline-flex;align-items:center;">
                <template x-if="ci > 0">
                    <span class="drive-breadcrumb-sep"><iconify-icon icon="solar:alt-arrow-right-linear" width="12"></iconify-icon></span>
                </template>
                <button @click="ci < globalBreadcrumb.length - 1 ? (crumb.path ? enterGlobalFolder(crumb.path) : globalNavigateTo(crumb.level)) : null"
                        class="drive-breadcrumb-item" :class="ci === globalBreadcrumb.length - 1 ? 'drive-breadcrumb-item--active' : ''">
                    <iconify-icon :icon="crumb.icon" width="14" :style="'color:' + crumb.color"></iconify-icon>
                    <span x-text="crumb.label"></span>
                </button>
            </span>
        </template>
    </div>
    <% } else { %>
    <!-- Record breadcrumb (static EJS + dynamic folder) -->
    <div class="drive-breadcrumb">
        <a href="/account/<%= account_number %>/drive" class="drive-breadcrumb-item" style="text-decoration:none;">
            <iconify-icon icon="solar:cloud-storage-bold-duotone" width="14" style="color:#ec4899"></iconify-icon>
            Drive
        </a>
        <span class="drive-breadcrumb-sep"><iconify-icon icon="solar:alt-arrow-right-linear" width="12"></iconify-icon></span>
        <a href="/account/<%= account_number %>/drive" class="drive-breadcrumb-item" style="text-decoration:none;">
            <iconify-icon icon="<%= entity.icon || 'solar:folder-bold-duotone' %>" width="14" style="color:#4361ee"></iconify-icon>
            <%= entity.name %>
        </a>
        <span class="drive-breadcrumb-sep"><iconify-icon icon="solar:alt-arrow-right-linear" width="12"></iconify-icon></span>
        <button @click="navigateTo('')" class="drive-breadcrumb-item" :class="!currentFolder && !viewingGenerated ? 'drive-breadcrumb-item--active' : ''">
            <iconify-icon icon="<%= entity.icon || 'solar:folder-bold-duotone' %>" width="14" style="color:#4361ee"></iconify-icon>
            <%= record.computedTitle || record.title || 'Sans titre' %>
        </button>
        <template x-if="viewingGenerated">
            <span class="drive-breadcrumb-sep">
                <iconify-icon icon="solar:alt-arrow-right-linear" width="12"></iconify-icon>
                <span class="drive-breadcrumb-item drive-breadcrumb-item--active">
                    <iconify-icon icon="solar:magic-stick-3-bold" width="13" style="color:#f59e0b"></iconify-icon>
                    <span x-text="viewingGenerated"></span>
                </span>
            </span>
        </template>
        <template x-if="currentFolder && !viewingGenerated">
            <span class="drive-breadcrumb-sep">
                <iconify-icon icon="solar:alt-arrow-right-linear" width="12"></iconify-icon>
                <span class="drive-breadcrumb-item drive-breadcrumb-item--active" x-text="currentFolder"></span>
            </span>
        </template>
    </div>
    <% } %>

    <!-- ═══ GLOBAL MODE: Entity / Record navigation ═══ -->
    <% if (driveMode === 'global') { %>

    <!-- Unified actions bar (all levels) -->
    <div class="drive-actions-bar" x-show="!loading">
        <div class="drive-actions-group">
            <button @click="globalGoBack()" class="drive-action-btn drive-action-btn--secondary" x-show="globalLevel !== 'root'">
                <iconify-icon icon="solar:alt-arrow-left-linear" width="16"></iconify-icon>
                Retour
            </button>
            <span class="drive-stats-pill" x-show="globalLevel === 'root'">
                <iconify-icon icon="solar:chart-2-bold-duotone" width="14" style="color:#4361ee"></iconify-icon>
                <span x-text="globalStats.totalFiles + ' fichiers · ' + globalStats.totalSizeFormatted"></span>
            </span>
        </div>
        <div class="drive-actions-group">
            <!-- Select mode toggle -->
            <button @click="toggleSelectMode()" class="drive-action-btn drive-action-btn--secondary" 
                x-show="(globalLevel === 'root' || globalLevel === 'custom-folder' || globalLevel === 'app-files') && !selectMode"
                :style="selectMode ? 'background:#4361ee10;color:#4361ee;border-color:#4361ee30;' : ''">
                <iconify-icon :icon="selectMode ? 'solar:check-square-bold' : 'solar:checkbox-minimalistic-bold-duotone'" width="16"></iconify-icon>
                <span x-text="selectMode ? 'Annuler' : 'Sélectionner'"></span>
            </button>
            <button @click="triggerNewFolder()" class="drive-action-btn drive-action-btn--secondary" 
                x-show="!selectMode && !viewingGenerated && (globalLevel === 'root' || globalLevel === 'custom-folder' || globalLevel === 'app-files')">
                <iconify-icon icon="solar:folder-add-bold-duotone" width="17"></iconify-icon>
                Nouveau dossier
            </button>
            <label class="drive-action-btn drive-action-btn--primary" 
                x-show="!selectMode && !viewingGenerated && (globalLevel === 'root' || globalLevel === 'custom-folder' || globalLevel === 'app-files')">
                <iconify-icon icon="solar:cloud-upload-bold-duotone" width="17"></iconify-icon>
                Importer
                <input type="file" multiple @change="handleFileSelect($event)" style="display:none;" x-ref="fileUploadInput">
            </label>
        </div>
    </div>
    <!-- Loading -->
    <template x-if="loading">
        <div style="text-align:center; padding:40px 0; color:#94a3b8;">
            <iconify-icon icon="line-md:loading-twotone-loop" width="28"></iconify-icon>
        </div>
    </template>

    <!-- New folder input (global root mode) -->
    <div x-show="showNewFolderInput && (globalLevel === 'root' || globalLevel === 'custom-folder')" x-transition class="drive-new-folder">
        <iconify-icon icon="solar:folder-bold-duotone" width="18" style="color:#4361ee"></iconify-icon>
        <input type="text" x-model="newFolderName" @keydown.enter="createFolder()" @keydown.escape="showNewFolderInput = false; newFolderName = ''"
            placeholder="Nom du dossier..." class="drive-new-folder-input" x-ref="folderInput">
        <button @click="createFolder()" class="drive-new-folder-btn" :disabled="!newFolderName.trim()">Créer</button>
        <button @click="showNewFolderInput = false; newFolderName = ''" class="drive-new-folder-cancel">
            <iconify-icon icon="solar:close-circle-linear" width="16"></iconify-icon>
        </button>
    </div>

    <!-- Upload summary (global root/custom folder) -->
    <div x-show="uploadQueue.length > 0 && (globalLevel === 'root' || globalLevel === 'custom-folder')" class="drive-upload-progress" style="display:none;" x-transition>
        <iconify-icon icon="line-md:uploading-loop" width="20" style="color:#4361ee"></iconify-icon>
        <span x-text="uploadQueueSummary"></span>
        <button type="button" class="drive-upload-queue-clear" x-show="canClearUploadQueue" @click="clearUploadQueue()">Effacer</button>
    </div>

    <!-- ═══ ROOT LEVEL: App folder + Custom folders + Root files ═══ -->
    <template x-if="globalLevel === 'root'">
        <div class="rm-items-list">
            <!-- Upload placeholders -->
            <template x-for="(item, idx) in uploadQueue" :key="item.id">
                <div class="rm-item drive-upload-placeholder" :class="'drive-upload-placeholder--' + item.status" :style="'animation-delay:' + (idx * 20) + 'ms'" @click.stop @contextmenu.prevent.stop>
                    <div class="rm-item-icon" :style="'background:' + getCategoryColor(item.category) + '12'">
                        <iconify-icon :icon="getCategoryIcon(item.category)" width="20" :style="'color:' + getCategoryColor(item.category)"></iconify-icon>
                    </div>
                    <div class="rm-item-body">
                        <div class="rm-item-title" x-text="item.fileName"></div>
                        <div class="rm-item-date">
                            <span x-text="item.sizeFormatted"></span>
                            <span>·</span>
                            <span class="drive-upload-row-path" x-text="item.displayPath"></span>
                        </div>
                    </div>
                    <div class="drive-upload-row-progress">
                        <div class="drive-upload-row-status" x-text="uploadQueueStatusLabel(item)"></div>
                        <div class="drive-upload-row-bar">
                            <div class="drive-upload-row-fill" :style="'width:' + item.progress + '%;background:' + uploadQueueProgressColor(item)"></div>
                        </div>
                    </div>
                </div>
            </template>

            <!-- App folder (locked system) -->
            <div class="rm-item drive-folder-item" @click="enterApp()" style="cursor:pointer;">
                <div class="rm-item-icon" style="background:linear-gradient(135deg,#4361ee15,#4361ee08); position:relative;">
                    <iconify-icon icon="solar:folder-bold-duotone" width="20" style="color:#4361ee"></iconify-icon>
                    <iconify-icon icon="solar:lock-keyhole-bold" width="10" style="color:#94a3b8; position:absolute; bottom:0; right:0;"></iconify-icon>
                </div>
                <div class="rm-item-body">
                    <div class="rm-item-title" style="display:flex; align-items:center; gap:6px;">
                        <iconify-icon icon="solar:box-bold-duotone" width="16" style="color:#4361ee"></iconify-icon>
                        <span>App</span>
                    </div>
                    <div class="rm-item-date">
                        <iconify-icon icon="solar:database-bold-duotone" width="12" style="color:#4361ee"></iconify-icon>
                        <span x-text="globalEntities.length + ' entité(s) · ' + globalStats.totalFiles + ' fichier(s)'"></span>
                    </div>
                </div>
                <span class="drive-lock-badge"><iconify-icon icon="solar:lock-keyhole-bold" width="11"></iconify-icon> Système</span>
                <span class="rm-item-action" style="color:#94a3b8;"><iconify-icon icon="solar:alt-arrow-right-linear" width="18"></iconify-icon></span>
            </div>

            <!-- Custom folders -->
            <template x-for="(folder, idx) in globalRootDisplayFolders" :key="'root-folder-' + folder.name">
                <div class="rm-item drive-folder-item" @click="renamingFolderOldName === folder.name ? null : enterGlobalFolder(folder.name)" style="cursor:pointer;" :style="'animation-delay:' + ((idx + 1) * 40) + 'ms'"
                     @contextmenu.prevent="openContextMenu($event, folder, 'folder')">
                    <div class="rm-item-icon" style="background:linear-gradient(135deg,#f59e0b15,#f59e0b08)">
                        <iconify-icon icon="solar:folder-bold-duotone" width="20" style="color:#f59e0b"></iconify-icon>
                    </div>
                    <div class="rm-item-body" style="min-width:0;">
                        <template x-if="renamingFolderOldName !== folder.name">
                            <div class="rm-item-title" x-text="folder.name" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></div>
                        </template>
                        <template x-if="renamingFolderOldName === folder.name">
                            <input type="text" class="drive-rename-input" x-model="renameFolderValue" @keydown.enter.prevent="confirmRenameGlobalFolder()" @keydown.escape.prevent="cancelRenameFolder()" x-init="$nextTick(() => { $el.focus(); $el.select(); })" @blur="confirmRenameGlobalFolder()" @click.stop />
                        </template>
                        <div class="rm-item-date"><iconify-icon icon="solar:documents-linear" width="12"></iconify-icon> <span x-text="folder.count + ' fichier(s)'"></span></div>
                    </div>
                    <template x-if="renamingFolderOldName !== folder.name">
                        <span class="rm-item-badge" style="background:#f59e0b10;color:#f59e0b">Dossier</span>
                    </template>
                    <template x-if="renamingFolderOldName !== folder.name">
                        <span class="rm-item-action" style="color:#94a3b8;"><iconify-icon icon="solar:alt-arrow-right-linear" width="18"></iconify-icon></span>
                    </template>
                </div>
            </template>

            <!-- Root files -->
            <template x-for="(file, idx) in globalRootDisplayFiles" :key="'root-file-' + file._id">
                <div class="rm-item" :style="'animation-delay:' + ((globalRootDisplayFolders.length + idx + 1) * 40) + 'ms'" style="cursor:pointer;"
                     @click="window.openFileViewer(file.url, file.originalName, file.category, globalRootDisplayFiles.map(f=>({url:f.url,name:f.originalName,category:f.category})), idx)"
                     @contextmenu.prevent="openContextMenu($event, file, 'global-file')">
                    <div class="rm-item-icon" :style="'background:linear-gradient(135deg,' + (file.category === 'image' ? '#10b981' : file.category === 'pdf' ? '#ef4444' : '#4361ee') + '15,' + (file.category === 'image' ? '#10b981' : file.category === 'pdf' ? '#ef4444' : '#4361ee') + '08)'">
                        <iconify-icon :icon="file.category === 'image' ? 'solar:gallery-bold-duotone' : file.category === 'pdf' ? 'solar:document-text-bold-duotone' : file.category === 'word' ? 'solar:document-bold-duotone' : file.category === 'excel' ? 'solar:chart-square-bold-duotone' : 'solar:file-bold-duotone'" width="20"
                            :style="'color:' + (file.category === 'image' ? '#10b981' : file.category === 'pdf' ? '#ef4444' : '#4361ee')"></iconify-icon>
                    </div>
                    <div class="rm-item-body">
                        <div class="rm-item-title" x-text="file.originalName"></div>
                        <div class="rm-item-date">
                            <iconify-icon icon="solar:calendar-linear" width="12"></iconify-icon>
                            <span x-text="formatDate(file.uploadedAt)"></span>
                        </div>
                    </div>
                    <span class="rm-item-badge" style="background:#6b728015;color:#6b7280" x-text="file.sizeFormatted"></span>
                </div>
            </template>
        </div>
    </template>

    <!-- ═══ CUSTOM FOLDER CONTENT ═══ -->
    <template x-if="globalLevel === 'custom-folder'">
        <div class="rm-items-list">
            <!-- Upload placeholders -->
            <template x-for="(item, idx) in uploadQueue" :key="item.id">
                <div class="rm-item drive-upload-placeholder" :class="'drive-upload-placeholder--' + item.status" :style="'animation-delay:' + (idx * 20) + 'ms'" @click.stop @contextmenu.prevent.stop>
                    <div class="rm-item-icon" :style="'background:' + getCategoryColor(item.category) + '12'">
                        <iconify-icon :icon="getCategoryIcon(item.category)" width="20" :style="'color:' + getCategoryColor(item.category)"></iconify-icon>
                    </div>
                    <div class="rm-item-body">
                        <div class="rm-item-title" x-text="item.fileName"></div>
                        <div class="rm-item-date">
                            <span x-text="item.sizeFormatted"></span>
                            <span>·</span>
                            <span class="drive-upload-row-path" x-text="item.displayPath"></span>
                        </div>
                    </div>
                    <div class="drive-upload-row-progress">
                        <div class="drive-upload-row-status" x-text="uploadQueueStatusLabel(item)"></div>
                        <div class="drive-upload-row-bar">
                            <div class="drive-upload-row-fill" :style="'width:' + item.progress + '%;background:' + uploadQueueProgressColor(item)"></div>
                        </div>
                    </div>
                </div>
            </template>

            <!-- Subfolders -->
            <template x-for="(subfolder, idx) in globalCurrentSubfolders" :key="'subfolder-' + subfolder.fullPath">
                <div class="rm-item drive-folder-item" @click="renamingFolderOldName === subfolder.fullPath ? null : enterGlobalFolder(subfolder.fullPath)" style="cursor:pointer;" :style="'animation-delay:' + (idx * 40) + 'ms'"
                     @contextmenu.prevent="openContextMenu($event, {name: subfolder.fullPath}, 'folder')">
                    <div class="rm-item-icon" style="background:linear-gradient(135deg,#f59e0b15,#f59e0b08)">
                        <iconify-icon icon="solar:folder-bold-duotone" width="20" style="color:#f59e0b"></iconify-icon>
                    </div>
                    <div class="rm-item-body" style="min-width:0;">
                        <template x-if="renamingFolderOldName !== subfolder.fullPath">
                            <div class="rm-item-title" x-text="subfolder.name" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></div>
                        </template>
                        <template x-if="renamingFolderOldName === subfolder.fullPath">
                            <input type="text" class="drive-rename-input" x-model="renameFolderValue" @keydown.enter.prevent="confirmRenameGlobalFolder()" @keydown.escape.prevent="cancelRenameFolder()" x-init="$nextTick(() => { $el.focus(); $el.select(); })" @blur="confirmRenameGlobalFolder()" @click.stop />
                        </template>
                        <div class="rm-item-date"><iconify-icon icon="solar:documents-linear" width="12"></iconify-icon> <span x-text="subfolder.count + ' fichier(s)'"></span></div>
                    </div>
                    <template x-if="renamingFolderOldName !== subfolder.fullPath">
                        <span class="rm-item-badge" style="background:#f59e0b10;color:#f59e0b">Dossier</span>
                    </template>
                    <template x-if="renamingFolderOldName !== subfolder.fullPath">
                        <span class="rm-item-action" style="color:#94a3b8;"><iconify-icon icon="solar:alt-arrow-right-linear" width="18"></iconify-icon></span>
                    </template>
                </div>
            </template>

        <!-- Files -->
        <template x-for="(file, idx) in globalRootDisplayFiles" :key="file._id">
            <div class="rm-item" :style="'animation-delay:' + ((globalCurrentSubfolders.length + idx) * 40) + 'ms'" style="cursor:pointer;"
                 @click="window.openFileViewer(file.url, file.originalName, file.category, globalRootDisplayFiles.map(f=>({url:f.url,name:f.originalName,category:f.category})), idx)"
                 @contextmenu.prevent="openContextMenu($event, file, 'global-file')">
                <div class="rm-item-icon" :style="'background:linear-gradient(135deg,' + (file.category === 'image' ? '#10b981' : file.category === 'pdf' ? '#ef4444' : '#4361ee') + '15,' + (file.category === 'image' ? '#10b981' : file.category === 'pdf' ? '#ef4444' : '#4361ee') + '08)'">
                    <iconify-icon :icon="file.category === 'image' ? 'solar:gallery-bold-duotone' : file.category === 'pdf' ? 'solar:document-text-bold-duotone' : file.category === 'word' ? 'solar:document-bold-duotone' : file.category === 'excel' ? 'solar:chart-square-bold-duotone' : 'solar:file-bold-duotone'" width="20"
                        :style="'color:' + (file.category === 'image' ? '#10b981' : file.category === 'pdf' ? '#ef4444' : '#4361ee')"></iconify-icon>
                </div>
                <div class="rm-item-body">
                    <div class="rm-item-title" x-text="file.originalName"></div>
                    <div class="rm-item-date">
                        <iconify-icon icon="solar:calendar-linear" width="12"></iconify-icon>
                        <span x-text="formatDate(file.uploadedAt)"></span>
                    </div>
                </div>
                <span class="rm-item-badge" style="background:#6b728015;color:#6b7280" x-text="file.sizeFormatted"></span>
            </div>
        </template>
        <div x-show="globalCurrentSubfolders.length === 0 && globalRootDisplayFiles.length === 0 && uploadQueue.length === 0" class="drive-empty">
            <iconify-icon icon="solar:folder-open-bold-duotone" width="48" style="opacity:0.2"></iconify-icon>
            <p style="font-size:13px; font-weight:600; margin-top:12px;">Dossier vide</p>
            <p style="font-size:11px; margin-top:4px; color:#94a3b8;">Créez un sous-dossier ou importez des fichiers</p>
        </div>
    </div>
    </template>

    <!-- ═══ APP: Entity list ═══ -->
    <div x-show="globalLevel === 'app-entities' && !loading" class="rm-items-list">
        <template x-for="(ent, eIdx) in globalEntities" :key="ent.entityId">
            <div class="rm-item" @click="selectEntity(ent)" :style="'animation-delay:' + (eIdx * 40) + 'ms'">
                <div class="rm-item-icon" style="background:linear-gradient(135deg,#4361ee15,#4361ee08); position:relative;">
                    <iconify-icon icon="solar:folder-bold-duotone" width="20" style="color:#4361ee"></iconify-icon>
                </div>
                <div class="rm-item-body">
                    <div class="rm-item-title" style="display:flex; align-items:center; gap:6px;">
                        <iconify-icon :icon="ent.entityIcon || 'solar:database-bold-duotone'" width="16" style="color:#4361ee"></iconify-icon>
                        <span x-text="ent.entityName"></span>
                    </div>
                    <div class="rm-item-date">
                        <iconify-icon icon="solar:documents-linear" width="12"></iconify-icon>
                        <span x-text="ent.fileCount + ' fichier(s) • ' + ent.records.length + ' fiche(s)'"></span>
                    </div>
                </div>
                <span class="rm-item-badge" style="background:#4361ee10;color:#4361ee">Entité</span>
                <span class="rm-item-action" style="color:#94a3b8;"><iconify-icon icon="solar:alt-arrow-right-linear" width="18"></iconify-icon></span>
            </div>
        </template>
        <div x-show="globalEntities.length === 0" class="drive-empty">
            <iconify-icon icon="solar:folder-open-bold-duotone" width="48" style="opacity:0.15"></iconify-icon>
            <p style="font-size:13px; font-weight:600; margin-top:12px;">Aucune entité avec des fichiers</p>
        </div>
    </div>

    <!-- ═══ APP: Record list ═══ -->
    <div x-show="globalLevel === 'app-records' && !loading" class="rm-items-list">
        <template x-for="(rec, rIdx) in (selectedEntity ? selectedEntity.records : [])" :key="rec.recordId">
            <div class="rm-item" @click="selectRecord(rec)" :style="'animation-delay:' + (rIdx * 40) + 'ms'">
                <div class="rm-item-icon" style="background:linear-gradient(135deg,#4361ee15,#4361ee08); position:relative;">
                    <iconify-icon icon="solar:folder-bold-duotone" width="20" style="color:#4361ee"></iconify-icon>
                    <iconify-icon icon="solar:lock-keyhole-bold" width="10" style="color:#94a3b8; position:absolute; bottom:0; right:0;"></iconify-icon>
                </div>
                <div class="rm-item-body">
                    <div class="rm-item-title" style="display:flex; align-items:center; gap:6px;">
                        <iconify-icon :icon="selectedEntity ? selectedEntity.entityIcon : 'solar:document-bold-duotone'" width="16" style="color:#4361ee"></iconify-icon>
                        <span x-text="rec.recordTitle"></span>
                    </div>
                    <div class="rm-item-date">
                        <iconify-icon icon="solar:documents-linear" width="12"></iconify-icon>
                        <span x-text="rec.fileCount + ' fichier(s)'"></span>
                    </div>
                </div>
                <span class="drive-lock-badge"><iconify-icon icon="solar:lock-keyhole-bold" width="11"></iconify-icon> Fiche</span>
                <span class="rm-item-action" style="color:#94a3b8;"><iconify-icon icon="solar:alt-arrow-right-linear" width="18"></iconify-icon></span>
            </div>
        </template>
    </div>

    <% } %>

    <!-- ═══ FILE LEVEL (shared between both modes) ═══ -->
    <div x-show="driveMode === 'record' || globalLevel === 'app-files'">

        <% if (driveMode !== 'global') { %>
        <!-- Record mode toolbar -->
        <div class="drive-actions-bar">
            <div class="drive-actions-group">
                <!-- Select mode toggle -->
                <button @click="toggleSelectMode()" class="drive-action-btn drive-action-btn--secondary" x-show="displayFiles.length > 0"
                    :style="selectMode ? 'background:#4361ee10;color:#4361ee;border-color:#4361ee30;' : ''">
                    <iconify-icon :icon="selectMode ? 'solar:check-square-bold' : 'solar:checkbox-minimalistic-bold-duotone'" width="16"></iconify-icon>
                    <span x-text="selectMode ? 'Annuler' : 'Sélectionner'"></span>
                </button>
            </div>
            <div class="drive-actions-group">
                <button @click="triggerNewFolder()" class="drive-action-btn drive-action-btn--secondary" x-show="!viewingGenerated && !currentFolder && !selectMode">
                    <iconify-icon icon="solar:folder-add-bold-duotone" width="17"></iconify-icon>
                    Nouveau dossier
                </button>
                <label class="drive-action-btn drive-action-btn--primary" x-show="!viewingGenerated && !selectMode">
                    <iconify-icon icon="solar:cloud-upload-bold-duotone" width="17"></iconify-icon>
                    Importer
                    <input type="file" multiple @change="handleFileSelect($event)" style="display:none;" x-ref="fileUploadInput">
                </label>
            </div>
        </div>
        <% } %>

        <!-- Bulk action bar (visible in select mode) -->
        <div x-show="selectMode" x-transition style="display:flex;flex-direction:column;gap:8px;padding:10px 14px;margin-bottom:12px;background:#4361ee08;border:1px solid #4361ee20;border-radius:10px;">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:12px;font-weight:600;color:#4361ee;">
                        <input type="checkbox" @click="selectAll()"
                            :checked="selectedIds.length > 0 && selectedIds.length === displayFiles.length"
                            :indeterminate="selectedIds.length > 0 && selectedIds.length < displayFiles.length"
                            style="width:14px;height:14px;accent-color:#4361ee;cursor:pointer;">
                        Tout sélectionner
                    </label>
                    <span x-show="selectedIds.length > 0" style="font-size:12px;color:#64748b;" x-text="selectedIds.length + ' sélectionné(s)'"></span>
                </div>
                <!-- Normal delete button -->
                <button @click="bulkDelete()" x-show="selectedIds.length > 0 && !confirmingBulkDelete"
                    style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:8px;background:#ef444415;color:#ef4444;border:1px solid #ef444430;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;">
                    <iconify-icon icon="solar:trash-bin-2-bold" width="14"></iconify-icon>
                    <span x-text="'Supprimer (' + selectedIds.length + ')'"></span>
                </button>
            </div>
            <!-- Confirmation row -->
            <div x-show="confirmingBulkDelete" x-transition style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#ef44440d;border:1px solid #ef444430;border-radius:8px;">
                <span style="font-size:12px;font-weight:600;color:#ef4444;display:flex;align-items:center;gap:6px;">
                    <iconify-icon icon="solar:danger-triangle-bold" width="14"></iconify-icon>
                    <span x-text="'Supprimer définitivement ' + selectedIds.length + ' fichier(s) ?'"></span>
                </span>
                <div style="display:flex;gap:6px;">
                    <button @click="confirmingBulkDelete = false" style="padding:4px 12px;border-radius:6px;border:1px solid #e2e8f0;background:#fff;color:#64748b;font-size:11px;font-weight:600;cursor:pointer;">Annuler</button>
                    <button @click="executeBulkDelete()" style="padding:4px 12px;border-radius:6px;border:none;background:#ef4444;color:#fff;font-size:11px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:4px;">
                        <iconify-icon icon="solar:trash-bin-2-bold" width="12"></iconify-icon>
                        Oui, supprimer
                    </button>
                </div>
            </div>
        </div>

        <!-- New folder input -->
        <div x-show="showNewFolderInput" x-transition class="drive-new-folder">
            <iconify-icon icon="solar:folder-bold-duotone" width="18" style="color:#f59e0b"></iconify-icon>
            <input type="text" x-model="newFolderName" @keydown.enter="createFolder()" @keydown.escape="showNewFolderInput = false; newFolderName = ''"
                placeholder="Nom du dossier..." class="drive-new-folder-input" x-ref="folderInput">
            <button @click="createFolder()" class="drive-new-folder-btn" :disabled="!newFolderName.trim()">Créer</button>
            <button @click="showNewFolderInput = false; newFolderName = ''" class="drive-new-folder-cancel">
                <iconify-icon icon="solar:close-circle-linear" width="16"></iconify-icon>
            </button>
        </div>

        <!-- Upload summary -->
        <div x-show="uploadQueue.length > 0" class="drive-upload-progress" style="display:none;" x-transition>
            <iconify-icon icon="line-md:uploading-loop" width="20" style="color:#4361ee"></iconify-icon>
            <span x-text="uploadQueueSummary"></span>
            <button type="button" class="drive-upload-queue-clear" x-show="canClearUploadQueue" @click="clearUploadQueue()">Effacer</button>
        </div>

        <!-- Loading -->
        <template x-if="loading">
            <div style="text-align:center; padding:40px 0; color:#94a3b8;">
                <iconify-icon icon="line-md:loading-twotone-loop" width="28"></iconify-icon>
            </div>
        </template>

        <!-- Content -->
        <template x-if="!loading">
            <div class="rm-items-list">
                <!-- Upload placeholders -->
                <template x-for="(item, idx) in uploadQueue" :key="item.id">
                    <div class="rm-item drive-upload-placeholder" :class="'drive-upload-placeholder--' + item.status" :style="'animation-delay:' + (idx * 20) + 'ms'" @click.stop @contextmenu.prevent.stop>
                        <div class="rm-item-icon" :style="'background:' + getCategoryColor(item.category) + '12'">
                            <iconify-icon :icon="getCategoryIcon(item.category)" width="20" :style="'color:' + getCategoryColor(item.category)"></iconify-icon>
                        </div>
                        <div class="rm-item-body">
                            <div class="rm-item-title" x-text="item.fileName"></div>
                            <div class="rm-item-date">
                                <span x-text="item.sizeFormatted"></span>
                                <span>·</span>
                                <span class="drive-upload-row-path" x-text="item.displayPath"></span>
                            </div>
                        </div>
                        <div class="drive-upload-row-progress">
                            <div class="drive-upload-row-status" x-text="uploadQueueStatusLabel(item)"></div>
                            <div class="drive-upload-row-bar">
                                <div class="drive-upload-row-fill" :style="'width:' + item.progress + '%;background:' + uploadQueueProgressColor(item)"></div>
                            </div>
                        </div>
                    </div>
                </template>

                <!-- Generated template folders (root only) — System locked -->
            <template x-for="(tplFolder, tIdx) in generatedTemplateFolders" :key="tplFolder.name">
                <div class="rm-item drive-folder-item" @click="viewingGenerated = tplFolder.name" style="cursor:pointer;" :style="'animation-delay:' + (tIdx * 40) + 'ms'">
                    <div class="rm-item-icon" style="background:linear-gradient(135deg,#4361ee15,#4361ee08); position:relative;">
                        <iconify-icon icon="solar:folder-bold-duotone" width="20" style="color:#4361ee"></iconify-icon>
                        <iconify-icon icon="solar:lock-keyhole-bold" width="10" style="color:#94a3b8; position:absolute; bottom:0; right:0;"></iconify-icon>
                    </div>
                    <div class="rm-item-body">
                        <div class="rm-item-title" x-text="tplFolder.name"></div>
                        <div class="rm-item-date"><iconify-icon icon="solar:magic-stick-3-bold" width="12" style="color:#4361ee"></iconify-icon> <span x-text="tplFolder.count + ' fichier(s)'"></span></div>
                    </div>
                    <span class="drive-lock-badge"><iconify-icon icon="solar:lock-keyhole-bold" width="11"></iconify-icon> Système</span>
                    <span class="rm-item-action" style="color:#94a3b8;"><iconify-icon icon="solar:alt-arrow-right-linear" width="18"></iconify-icon></span>
                </div>
            </template>

            <!-- Folders (root only) — Custom = editable, System = locked -->
            <template x-for="(folder, idx) in displayFolders" :key="folder.name">
                <div class="rm-item drive-folder-item" @click="renamingFolderOldName === folder.name ? null : navigateTo(folder.name)" style="cursor:pointer;" :style="'animation-delay:' + (idx * 40) + 'ms'"
                     :class="dropTargetFolder === folder.name ? 'drive-folder-item--drop-target' : ''"
                     @dragover.prevent @dragenter.prevent="onFolderDragEnter($event, folder.name)"
                     @dragleave="onFolderDragLeave($event, folder.name)" @drop="onFolderDrop($event, folder.name)"
                     @contextmenu.prevent="folder.isCustom ? openContextMenu($event, folder, 'folder') : null">
                    <div class="rm-item-icon" :style="folder.isCustom ? 'background:linear-gradient(135deg,#f59e0b15,#f59e0b08)' : 'background:linear-gradient(135deg,#4361ee15,#4361ee08)'" style="position:relative;">
                        <iconify-icon icon="solar:folder-bold-duotone" width="20" :style="folder.isCustom ? 'color:#f59e0b' : 'color:#4361ee'"></iconify-icon>
                        <template x-if="!folder.isCustom">
                            <iconify-icon icon="solar:lock-keyhole-bold" width="10" style="color:#94a3b8; position:absolute; bottom:0; right:0;"></iconify-icon>
                        </template>
                    </div>
                    <div class="rm-item-body" style="min-width:0;">
                        <template x-if="renamingFolderOldName !== folder.name">
                            <div class="rm-item-title" x-text="folder.name" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></div>
                        </template>
                        <template x-if="renamingFolderOldName === folder.name">
                            <input type="text" class="drive-rename-input" x-model="renameFolderValue" @keydown.enter.prevent="confirmRenameFolder()" @keydown.escape.prevent="cancelRenameFolder()" x-init="$nextTick(() => { $el.focus(); $el.select(); })" @blur="confirmRenameFolder()" @click.stop />
                        </template>
                        <div class="rm-item-date"><iconify-icon icon="solar:documents-linear" width="12"></iconify-icon> <span x-text="folder.count + ' fichier(s)'"></span></div>
                    </div>
                    <template x-if="renamingFolderOldName !== folder.name && folder.isCustom">
                        <span class="rm-item-badge" style="background:#f59e0b10;color:#f59e0b">Dossier</span>
                    </template>
                    <template x-if="renamingFolderOldName !== folder.name && !folder.isCustom">
                        <span class="drive-lock-badge"><iconify-icon icon="solar:lock-keyhole-bold" width="11"></iconify-icon> Système</span>
                    </template>
                    <template x-if="renamingFolderOldName !== folder.name">
                        <span class="rm-item-action" style="color:#94a3b8;"><iconify-icon icon="solar:alt-arrow-right-linear" width="18"></iconify-icon></span>
                    </template>
                </div>
            </template>

            <!-- Files -->
            <template x-for="(file, idx) in displayFiles" :key="file._id">
                <div class="rm-item" :style="'animation-delay:' + ((displayFolders.length + idx) * 40) + 'ms;' + (isSelected(file._id) ? 'background:#4361ee06;border-left:3px solid #4361ee40;' : '')"
                     style="cursor:pointer;"
                     :draggable="!file.isGenerated && !selectMode && renamingFileId !== file._id"
                     @dragstart="startDragFile($event, file._id)" @dragend="onDragEnd()"
                     @click="selectMode ? toggleSelect(file._id) : (renamingFileId !== file._id && !selectMode ? window.openFileViewer(file.url, file.originalName, file.category, displayFiles.map(f=>({url:f.url,name:f.originalName,category:f.category})), idx) : null)"
                     @contextmenu.prevent="openContextMenu($event, file, 'file')">
                    <!-- Checkbox in select mode -->
                    <template x-if="selectMode">
                        <div style="width:32px;height:32px;display:flex;align-items:center;justify-content:center;flex-shrink:0;" @click.stop="toggleSelect(file._id)">
                            <input type="checkbox" :checked="isSelected(file._id)"
                                style="width:16px;height:16px;accent-color:#4361ee;cursor:pointer;"
                                @click.stop="toggleSelect(file._id)">
                        </div>
                    </template>
                    <template x-if="file.category === 'image' && !selectMode">
                        <img :src="file.url" :alt="file.originalName" class="drive-img-thumb" />
                    </template>
                    <template x-if="file.category === 'image' && selectMode">
                        <img :src="file.url" :alt="file.originalName" class="drive-img-thumb" style="opacity:0.8;" />
                    </template>
                    <template x-if="file.category === 'pdf'">
                        <div class="drive-pdf-wrap">
                            <canvas x-init="(() => { renderPdfThumb(file.url, $el, 40) })()" width="40" height="40"></canvas>
                            <span class="drive-pdf-badge">PDF</span>
                        </div>
                    </template>
                    <template x-if="file.category !== 'image' && file.category !== 'pdf'">
                        <div class="rm-item-icon" :style="'background:linear-gradient(135deg,' + getCategoryColor(file.category) + '15,' + getCategoryColor(file.category) + '08)'">
                            <iconify-icon :icon="getCategoryIcon(file.category)" width="20" :style="'color:' + getCategoryColor(file.category)"></iconify-icon>
                        </div>
                    </template>
                    <div class="rm-item-body" style="min-width:0;">
                        <template x-if="renamingFileId !== file._id">
                            <div class="rm-item-title" x-text="file.originalName" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></div>
                        </template>
                        <template x-if="renamingFileId === file._id">
                            <input type="text" class="drive-rename-input" x-model="renameValue" @keydown.enter="confirmRename(file)" @keydown.escape="cancelRename()" x-init="$nextTick(() => $el.focus())" @blur="confirmRename(file)" />
                        </template>
                        <div class="rm-item-date">
                            <iconify-icon icon="solar:calendar-linear" width="12"></iconify-icon>
                            <span x-text="formatDate(file.uploadedAt)"></span>
                            <template x-if="file.isGenerated && file.generatedFromName">
                                <span style="margin-left:4px;color:#f59e0b;">· <span x-text="file.generatedFromName"></span></span>
                            </template>
                        </div>
                    </div>
                    <span class="rm-item-badge" style="background:#6b728015;color:#6b7280" x-text="file.sizeFormatted"></span>
                    <div class="drive-file-actions" x-show="!selectMode">
                        <template x-if="confirmDeleteFileId !== file._id">
                            <div style="display:flex;gap:2px;">
                                <button @click.stop="window.openFileViewer(file.url, file.originalName, file.category, displayFiles.map(f=>({url:f.url,name:f.originalName,category:f.category})), idx)" class="rm-item-action" title="Aperçu" style="color:#10b981;"><iconify-icon icon="solar:eye-bold" width="15"></iconify-icon></button>
                                <button @click.stop="startRename(file)" class="rm-item-action" title="Renommer" style="color:#f59e0b;" x-show="renamingFileId !== file._id"><iconify-icon icon="solar:pen-bold" width="15"></iconify-icon></button>
                                <a :href="file.url + '?dl=' + encodeURIComponent(file.originalName)" :download="file.originalName" class="rm-item-action" title="Télécharger" style="color:#4361ee;" @click.stop><iconify-icon icon="solar:download-bold" width="15"></iconify-icon></a>
                                <button @click.stop="deleteFile(file)" class="rm-item-action" title="Supprimer" style="color:#ef4444;"><iconify-icon icon="solar:trash-bin-2-bold" width="15"></iconify-icon></button>
                            </div>
                        </template>
                        <template x-if="confirmDeleteFileId === file._id">
                            <div style="display:flex;align-items:center;gap:4px;">
                                <button @click.stop="deleteFile(file)" style="display:inline-flex;align-items:center;gap:3px;padding:3px 10px;border-radius:6px;background:#ef4444;color:#fff;border:none;font-size:10px;font-weight:700;cursor:pointer;white-space:nowrap;line-height:1.3;">
                                    <iconify-icon icon="solar:trash-bin-2-bold" width="11"></iconify-icon> Oui
                                </button>
                                <button @click.stop="confirmDeleteFileId = null" style="display:inline-flex;align-items:center;padding:3px 8px;border-radius:6px;background:#f1f5f9;color:#64748b;border:1px solid #e2e8f0;font-size:10px;font-weight:600;cursor:pointer;white-space:nowrap;line-height:1.3;">Non</button>
                            </div>
                        </template>
                    </div>
                </div>
            </template>

            <!-- Empty states -->
            <div x-show="displayFiles.length === 0 && displayFolders.length === 0 && generatedCount === 0 && !currentFolder && !viewingGenerated && uploadQueue.length === 0" class="drive-empty">
                <iconify-icon icon="solar:folder-open-bold-duotone" width="48" style="opacity:0.15"></iconify-icon>
                <p style="font-size:13px; font-weight:600; margin-top:12px;">Aucun fichier</p>
                <p style="font-size:11px; margin-top:4px; color:#94a3b8;">Utilisez le bouton "Ajouter" pour importer des fichiers</p>
            </div>
            <div x-show="displayFiles.length === 0 && (currentFolder || viewingGenerated) && uploadQueue.length === 0" class="drive-empty">
                <iconify-icon icon="solar:folder-open-bold-duotone" width="48" style="opacity:0.2"></iconify-icon>
                <p style="font-size:13px; font-weight:600; margin-top:12px;">Dossier vide</p>
            </div>
        </div>
        </template>

        <!-- Subtle zone hint -->
        <div class="drive-zone-hint" x-show="!loading && isAtFileLevel && !viewingGenerated">
            <iconify-icon icon="solar:add-folder-bold-duotone" width="28"></iconify-icon>
            <span class="drive-zone-hint-text">Glissez des fichiers ici ou clic droit pour plus d'options</span>
            <span class="drive-zone-hint-sub">Nouveau dossier · Importer · Sélectionner</span>
        </div>
    </div>

    <!-- Context Menu -->
    <template x-teleport="body">
        <div x-show="contextMenu.show"
             x-cloak
             :style="'position:fixed;background:#fff;border:1px solid #e2e8f0;border-radius:12px;box-shadow:0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);z-index:999999;width:190px;padding:6px 0;animation:ctxFadeIn 0.12s ease-out;left:' + contextMenu.x + 'px;top:' + contextMenu.y + 'px;'"
             @click.outside="contextMenu.show = false">
            
            <!-- Background Options (right-click on empty area) -->
            <template x-if="contextMenu.type === 'background'">
                <div>
                    <template x-if="isAtFileLevel && !viewingGenerated">
                        <div>
                            <button @click="showNewFolderInput = true; contextMenu.show = false; $nextTick(() => $refs.folderInput?.focus())"
                                    style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;"
                                    onmouseover="this.style.background='#f8fafc';this.style.color='#4361ee';"
                                    onmouseout="this.style.background='none';this.style.color='#1e293b';">
                                <iconify-icon icon="solar:folder-add-bold-duotone" style="color:#4361ee" width="18"></iconify-icon>
                                Nouveau dossier
                            </button>
                            <button @click="triggerFileUpload(); contextMenu.show = false;"
                                    style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;"
                                    onmouseover="this.style.background='#f8fafc';this.style.color='#10b981';"
                                    onmouseout="this.style.background='none';this.style.color='#1e293b';">
                                <iconify-icon icon="solar:upload-bold-duotone" style="color:#10b981" width="18"></iconify-icon>
                                Importer des fichiers
                            </button>
                            <div style="height:1px;background:#f1f5f9;margin:4px 0;"></div>
                        </div>
                    </template>
                    <template x-if="isAtFileLevel && displayFiles.length > 0">
                        <button @click="selectMode = true; selectAll(); contextMenu.show = false;"
                                style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;"
                                onmouseover="this.style.background='#f8fafc';this.style.color='#8b5cf6';"
                                onmouseout="this.style.background='none';this.style.color='#1e293b';">
                            <iconify-icon icon="solar:checklist-bold-duotone" style="color:#8b5cf6" width="18"></iconify-icon>
                            Tout sélectionner
                        </button>
                    </template>
                    <button @click="isGlobalRoot ? loadGlobalRoot() : (isAtFileLevel ? loadFiles() : loadGlobalRoot()); contextMenu.show = false;"
                            style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;"
                            onmouseover="this.style.background='#f8fafc';this.style.color='#3b82f6';"
                            onmouseout="this.style.background='none';this.style.color='#1e293b';">
                        <iconify-icon icon="solar:refresh-bold-duotone" style="color:#3b82f6" width="18"></iconify-icon>
                        Actualiser
                    </button>
                </div>
            </template>

            <!-- Folder Options -->
            <template x-if="contextMenu.type === 'folder' && contextMenu.item">
                <div>
                    <button @click="isGlobalRoot ? enterGlobalFolder(contextMenu.item.name) : navigateTo(contextMenu.item.name); contextMenu.show = false;"
                            style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;"
                            onmouseover="this.style.background='#f8fafc';this.style.color='#4361ee';"
                            onmouseout="this.style.background='none';this.style.color='#1e293b';">
                        <iconify-icon icon="solar:folder-open-bold-duotone" style="color:#4361ee" width="18"></iconify-icon>
                        Ouvrir
                    </button>
                    <div style="height:1px;background:#f1f5f9;margin:4px 0;"></div>
                    <button @click="isGlobalRoot ? (renamingFolderOldName = contextMenu.item.name, renameFolderValue = contextMenu.item.name) : startRenameFolder(contextMenu.item.name); contextMenu.show = false;"
                            style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;"
                            onmouseover="this.style.background='#f8fafc';this.style.color='#f59e0b';"
                            onmouseout="this.style.background='none';this.style.color='#1e293b';">
                        <iconify-icon icon="solar:pen-bold-duotone" style="color:#f59e0b" width="18"></iconify-icon>
                        Renommer
                    </button>
                    <button @click="isGlobalRoot ? deleteGlobalFolder(contextMenu.item.name) : startDeleteFolder(contextMenu.item.name); contextMenu.show = false;"
                            style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#ef4444;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;"
                            onmouseover="this.style.background='#fef2f2';this.style.color='#dc2626';"
                            onmouseout="this.style.background='none';this.style.color='#ef4444';">
                        <iconify-icon icon="solar:trash-bin-trash-bold-duotone" style="color:#ef4444" width="18"></iconify-icon>
                        Supprimer
                    </button>
                </div>
            </template>

            <!-- Global File Options -->
            <template x-if="contextMenu.type === 'global-file' && contextMenu.item">
                <div>
                    <a :href="contextMenu.item ? contextMenu.item.url + '?dl=' + encodeURIComponent(contextMenu.item.originalName) : '#'" :download="contextMenu.item ? contextMenu.item.originalName : ''"
                       @click="contextMenu.show = false"
                       style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;text-decoration:none;box-sizing:border-box;"
                       onmouseover="this.style.background='#f8fafc';this.style.color='#4361ee';"
                       onmouseout="this.style.background='none';this.style.color='#1e293b';">
                        <iconify-icon icon="solar:download-bold-duotone" style="color:#4361ee" width="18"></iconify-icon>
                        Télécharger
                    </a>
                    <div style="height:1px;background:#f1f5f9;margin:4px 0;"></div>
                    <button @click="deleteGlobalFile(contextMenu.item); contextMenu.show = false;"
                            style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#ef4444;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;"
                            onmouseover="this.style.background='#fef2f2';this.style.color='#dc2626';"
                            onmouseout="this.style.background='none';this.style.color='#ef4444';">
                        <iconify-icon icon="solar:trash-bin-trash-bold-duotone" style="color:#ef4444" width="18"></iconify-icon>
                        Supprimer
                    </button>
                </div>
            </template>

            <!-- File Options -->
            <template x-if="contextMenu.type === 'file' && contextMenu.item">
                <div>
                    <button @click="window.openFileViewer(contextMenu.item.url, contextMenu.item.originalName, contextMenu.item.category, displayFiles.map(f=>({url:f.url,name:f.originalName,category:f.category})), displayFiles.findIndex(f=>f._id===contextMenu.item._id)); contextMenu.show = false;"
                            style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;"
                            onmouseover="this.style.background='#f8fafc';this.style.color='#10b981';"
                            onmouseout="this.style.background='none';this.style.color='#1e293b';">
                        <iconify-icon icon="solar:eye-bold-duotone" style="color:#10b981" width="18"></iconify-icon>
                        Aperçu
                    </button>
                    <a :href="contextMenu.item ? contextMenu.item.url + '?dl=' + encodeURIComponent(contextMenu.item.originalName) : '#'" :download="contextMenu.item ? contextMenu.item.originalName : ''"
                       @click="contextMenu.show = false"
                       style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;text-decoration:none;box-sizing:border-box;"
                       onmouseover="this.style.background='#f8fafc';this.style.color='#4361ee';"
                       onmouseout="this.style.background='none';this.style.color='#1e293b';">
                        <iconify-icon icon="solar:download-bold-duotone" style="color:#4361ee" width="18"></iconify-icon>
                        Télécharger
                    </a>
                    
                    <template x-if="contextMenu.item">
                        <div>
                            <div style="height:1px;background:#f1f5f9;margin:4px 0;"></div>
                            <button @click="startRename(contextMenu.item); contextMenu.show = false;"
                                    style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;"
                                    onmouseover="this.style.background='#f8fafc';this.style.color='#f59e0b';"
                                    onmouseout="this.style.background='none';this.style.color='#1e293b';">
                                <iconify-icon icon="solar:pen-bold-duotone" style="color:#f59e0b" width="18"></iconify-icon>
                                Renommer
                            </button>
                            <button @click="deleteFile(contextMenu.item); contextMenu.show = false;"
                                    style="width:100%;padding:10px 14px;border:none;background:none;text-align:left;font-size:13px;font-weight:600;color:#ef4444;cursor:pointer;display:flex;align-items:center;gap:10px;transition:all 0.15s;"
                                    onmouseover="this.style.background='#fef2f2';this.style.color='#dc2626';"
                                    onmouseout="this.style.background='none';this.style.color='#ef4444';">
                                <iconify-icon icon="solar:trash-bin-trash-bold-duotone" style="color:#ef4444" width="18"></iconify-icon>
                                Supprimer
                            </button>
                        </div>
                    </template>
                </div>
            </template>
        </div>
    </template>

    <!-- Delete Folder Modal -->
    <template x-teleport="body">
        <div x-show="showDeleteFolderModal" 
             style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,0.45);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:99999;" 
             x-cloak 
             @click.self="showDeleteFolderModal = false">
            <div style="background:#fff;border-radius:16px;border:1px solid #e2e8f0;width:100%;max-width:400px;box-shadow:0 25px 50px -12px rgba(0,0,0,0.15);display:flex;flex-direction:column;overflow:hidden;">
                <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
                    <span style="font-weight:700;color:#ef4444;font-size:15px;display:flex;align-items:center;gap:8px;">
                        <iconify-icon icon="solar:trash-bin-trash-bold-duotone" style="color:#ef4444" width="20"></iconify-icon>
                        Supprimer le dossier
                    </span>
                    <button @click="showDeleteFolderModal = false" style="background:none;border:none;cursor:pointer;color:#94a3b8;display:flex;padding:2px;">
                        <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
                    </button>
                </div>
                <div style="padding:20px;">
                    <p style="font-size:13px;color:#1e293b;margin:0;line-height:1.5;">Êtes-vous sûr de vouloir supprimer le dossier <strong style="color:#0f172a;" x-text="'&ldquo;' + deletingFolderName + '&rdquo;'"></strong> ?</p>
                    <p style="font-size:11px;color:#ef4444;margin-top:8px;background:#fef2f2;padding:8px 10px;border-radius:6px;border:1px solid #fee2e2;">⚠️ Les fichiers contenus à l'intérieur ne seront pas supprimés, ils seront simplement déplacés à la racine du Drive.</p>
                </div>
                <div style="padding:12px 20px;background:#f8fafc;border-top:1px solid #f1f5f9;display:flex;justify-content:end;gap:10px;">
                    <button @click="showDeleteFolderModal = false" style="padding:8px 16px;border-radius:8px;font-size:12px;font-weight:600;background:#fff;border:1px solid #e2e8f0;color:#64748b;cursor:pointer;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='#fff'">Annuler</button>
                    <button @click="confirmDeleteFolder()" style="padding:8px 16px;border-radius:8px;font-size:12px;font-weight:600;background:#ef4444;border:none;color:#fff;cursor:pointer;" onmouseover="this.style.background='#dc2626'" onmouseout="this.style.background='#ef4444'">Supprimer</button>
                </div>
            </div>
        </div>
    </template>

    <!-- Security Warning Modal -->
    <template x-teleport="body">
        <div x-show="uploadWarning.show" 
             style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,0.5);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:99999;" 
             x-cloak 
             x-transition.opacity
             @click.self="uploadWarning.show = false">
            <div style="background:#fff;border-radius:20px;border:1px solid #fecaca;width:100%;max-width:480px;box-shadow:0 25px 50px -12px rgba(239,68,68,0.2);display:flex;flex-direction:column;overflow:hidden;animation:shake 0.4s ease-in-out;" x-transition>
                <!-- Header -->
                <div style="padding:20px 24px;background:linear-gradient(135deg,#fef2f2,#fff1f2);border-bottom:1px solid #fecaca;display:flex;align-items:center;gap:14px;">
                    <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#ef4444,#dc2626);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 12px rgba(239,68,68,0.3);">
                        <iconify-icon icon="solar:shield-warning-bold" width="24" style="color:#fff;"></iconify-icon>
                    </div>
                    <div style="flex:1;min-width:0;">
                        <h3 style="margin:0;font-size:16px;font-weight:700;color:#991b1b;" x-text="uploadWarning.title"></h3>
                        <p style="margin:2px 0 0;font-size:12px;color:#b91c1c;font-weight:500;">Protection de sécurité</p>
                    </div>
                    <button @click="uploadWarning.show = false" style="background:none;border:none;cursor:pointer;color:#dc2626;display:flex;padding:4px;border-radius:8px;transition:all 0.15s;" onmouseover="this.style.background='#fee2e2'" onmouseout="this.style.background='none'">
                        <iconify-icon icon="solar:close-circle-bold" width="22"></iconify-icon>
                    </button>
                </div>
                <!-- Body -->
                <div style="padding:20px 24px;">
                    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:12px;padding:14px 16px;margin-bottom:16px;">
                        <p style="margin:0;font-size:13px;color:#991b1b;line-height:1.6;font-weight:500;" x-text="uploadWarning.message"></p>
                    </div>
                    <template x-if="uploadWarning.files && uploadWarning.files.length > 0">
                        <div>
                            <p style="font-size:11px;color:#64748b;margin:0 0 8px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Fichier(s) concerné(s)</p>
                            <div style="display:flex;flex-direction:column;gap:4px;">
                                <template x-for="fname in uploadWarning.files" :key="fname">
                                    <div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;">
                                        <iconify-icon icon="solar:file-corrupted-bold-duotone" width="18" style="color:#ef4444;flex-shrink:0;"></iconify-icon>
                                        <span style="font-size:13px;color:#1e293b;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" x-text="fname"></span>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>
