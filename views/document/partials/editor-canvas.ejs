    <!-- Canvas Area -->
    <div class="flex-1 bg-gray-100 dark:bg-gray-800 overflow-auto p-8" id="canvas-container">
      <div id="pages-container" class="flex flex-col gap-8 items-center" style="padding-top: 43px;">
        <template x-for="(page, index) in doc.pages" :key="'page-' + index">
          <div class="relative group">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-10">
              <span class="bg-primary text-white text-xs px-2 py-1 rounded-full shadow-md">
                Page <span x-text="index + 1"></span>
              </span>
            </div>

            <!-- Page Mode Switcher (Always Visible) -->
            <div class="absolute -mt-10 left-0 flex bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 shadow-sm rounded-t-lg overflow-hidden z-30">
               <button 
                  @click.stop="page.mode = 'edition'; saveDocument()"
                  :class="page.mode === 'edition' ? 'bg-primary text-white' : 'bg-gray-50 dark:bg-gray-800 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700'"
                  class="flex items-center gap-2 px-3 py-2 text-xs font-bold uppercase tracking-wider transition-colors"
                  title="Mode Édition"
                >
                  <iconify-icon icon="solar:pen-bold-duotone" width="14"></iconify-icon>
                  <span>Édition</span>
                </button>
                <div class="w-px bg-gray-200 dark:bg-gray-700"></div>
                 <button 
                  @click.stop="page.mode = 'layout'; saveDocument()"
                  :class="page.mode === 'layout' ? 'bg-primary text-white' : 'bg-gray-50 dark:bg-gray-800 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700'"
                  class="flex items-center gap-2 px-3 py-2 text-xs font-bold uppercase tracking-wider transition-colors"
                  title="Mode Layout"
                >
                  <iconify-icon icon="solar:layers-minimalistic-bold-duotone" width="14"></iconify-icon>
                  <span>Layout</span>
                </button>
                <div class="w-px bg-gray-200 dark:bg-gray-700"></div>
                 <button 
                  @click.stop="page.mode = 'designer'; saveDocument()"
                  :class="page.mode === 'designer' ? 'bg-primary text-white' : 'bg-gray-50 dark:bg-gray-800 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700'"
                  class="flex items-center gap-2 px-3 py-2 text-xs font-bold uppercase tracking-wider transition-colors"
                  title="Mode Designer"
                >
                  <iconify-icon icon="solar:palette-2-broken" width="14"></iconify-icon>
                  <span>Designer</span>
                </button>
            </div>

            <div 
              class="bg-white shadow-2xl relative overflow-hidden" 
              :style="'width: ' + doc.dimensions.width + 'px; height: ' + doc.dimensions.height + 'px;'" 
              @click="selectPage(index)" 
              :class="{ 'ring-2 ring-primary': selectedPageIndex === index }"
            >

              <!-- EDITION MODE: Editable content area with dynamic margins -->
              <div 
                x-show="page.mode === 'edition'"
                class="w-full h-full outline-none text-gray-800 leading-relaxed page-content overflow-hidden"
                :class="{ 'global-selection': isGlobalSelection }"
                contenteditable="true"
                :data-page-index="index"
                @input="handlePageInput($event, index)"
                @paste="handlePaste($event, index)"
                @focus="selectPage(index)"
                @blur="syncPageContent($event, index)"
                x-init="$el.innerHTML = page.content || ''"
                x-ref="pageContent"
                :style="'font-family: Times New Roman, serif; font-size: 12pt; white-space: pre-wrap; word-wrap: break-word; line-height: 1.15; padding-top: ' + doc.margins.top + 'px; padding-bottom: ' + doc.margins.bottom + 'px; padding-left: ' + doc.margins.left + 'px; padding-right: ' + doc.margins.right + 'px; overflow: hidden;'"
              ></div>
              
              <!-- DESIGN MODE: Layout with rows -->
              <div 
                x-show="page.mode === 'layout' || page.mode === 'designer'"
                class="w-full h-full"
                :style="'padding-top: ' + doc.margins.top + 'px; padding-bottom: ' + doc.margins.bottom + 'px; padding-left: ' + doc.margins.left + 'px; padding-right: ' + doc.margins.right + 'px;'"
              >
                <!-- Add row button (Top) - Only generic if empty -->
                <button 
                  x-show="!page.rows || page.rows.length === 0"
                  @click="addRow(index)"
                  class="w-full border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg p-4 hover:border-primary hover:bg-gray-50 dark:hover:bg-gray-800 transition-all flex items-center justify-center gap-2 text-gray-400 hover:text-primary mb-4"
                >
                  <iconify-icon icon="solar:add-circle-bold" width="20"></iconify-icon>
                  <span class="text-sm">Ajouter une section</span>
                </button>
                
                <!-- Render existing rows -->
                <template x-for="(row, rowIndex) in page.rows" :key="'row-' + index + '-' + rowIndex">
                  <div class="relative mb-8 section-row group">
                    <!-- Style for robust hover scoping -->
                    <style>
                      .section-row:hover .section-controls {
                        opacity: 1;
                        pointer-events: auto;
                      }
                    </style>

                    <!-- Row container - Standard Dashed Border -->
                    <div 
                      class="border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg p-4 hover:border-primary transition-colors min-h-[100px] relative"
                      @click="selectedRow = { pageIndex: index, rowIndex: rowIndex }"
                    >
                      <!-- 1. Layout Selector (Top-Right) - CLASSIC POSITION -->
                      <div class="section-controls absolute -top-3 right-2 mr-2 rounded shadow-sm opacity-0 transition-opacity flex gap-0.5 z-30 pointer-events-none">
                        <!-- Layouts -->
                        <button 
                          @click.stop="setRowLayout(index, rowIndex, 1)"
                          :class="row.columns === 1 ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400'"
                          class="w-6 h-6 rounded hover:scale-110 transition-transform flex items-center justify-center text-xs"
                          title="1 colonne"
                        >
                          <iconify-icon icon="tabler:rectangle" width="14"></iconify-icon>
                        </button>
                        <button 
                          @click.stop="setRowLayout(index, rowIndex, 2)"
                          :class="row.columns === 2 ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400'"
                          class="w-6 h-6 rounded hover:scale-110 transition-transform flex items-center justify-center text-xs"
                          title="2 colonnes"
                        >
                          <iconify-icon icon="tabler:columns-2" width="14"></iconify-icon>
                        </button>
                        <button 
                          @click.stop="setRowLayout(index, rowIndex, 3)"
                          :class="row.columns === 3 ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400'"
                          class="w-6 h-6 rounded hover:scale-110 transition-transform flex items-center justify-center text-xs"
                          title="3 colonnes"
                        >
                          <iconify-icon icon="tabler:columns-3" width="14"></iconify-icon>
                        </button>
                        
                        <div class="w-px h-3 bg-gray-300 dark:bg-gray-600 mx-0.5 self-center"></div>
                        
                        <!-- Add Column -->
                        <button 
                          @click.stop="addColumnToRow(index, rowIndex)"
                          class="w-6 h-6 rounded bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 hover:bg-primary hover:text-white hover:scale-110 transition-all flex items-center justify-center text-xs"
                          title="Ajouter une colonne (+1)"
                          x-show="(row.columns || 1) < 12"
                        >
                          <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                        </button>
                      </div>

                      <!-- 2. Row Content (Columns) -->
                      <div class="grid gap-4" :style="'grid-template-columns: repeat(' + (row.columns || 1) + ', minmax(0, 1fr))'">
                        <template x-for="col in (row.columns || 1)" :key="'col-' + col">
                          <div 
                            class="rounded min-h-[100px] group/col relative transition-all border border-dashed border-transparent sortable-column"
                            :data-page-index="index"
                            :data-row-index="rowIndex"
                            :data-column-index="col - 1"
                            x-init="initSortableColumn($el)"
                            x-data="{ isHover: false }"
                            @mouseenter="isHover = true"
                            @mouseleave="isHover = false"
                            :style="isHover ? 'border-color: #e5e7eb !important;' : ''"
                            :class="{ 
                              'bg-gray-100 dark:bg-gray-800': !(row.elements || []).filter(e => e.column === col - 1).length === 0,
                            }"
                          >
                            <!-- Render Elements -->
                            <div class="flex flex-col gap-2 relative z-10 p-1 min-h-[100px] h-full">
                              <template x-for="element in (row.elements || []).filter(e => e.column === col - 1)" :key="element.id">
                                <div 
                                  class="group/el relative element-wrapper transition-all sortable-item" 
                                  style="border: 1px dashed #dee8ff; margin: 2px;"
                                  :data-id="element.id"
                                >
                                  <!-- Drop Indicator (Blue Line) -->
                                  <div 
                                    x-show="dragTargetElementId === element.id" 
                                    class="absolute -top-1 left-0 right-0 h-1 bg-blue-500 rounded z-[60] pointer-events-none transition-all shadow-sm"
                                    x-transition.opacity
                                  ></div>

                                  <!-- Element Controls -->
                                  <div class="element-controls absolute top-0 right-0 flex gap-0.5 opacity-0 group-hover/el:opacity-100 transition-opacity bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-bl shadow-sm z-50 pointer-events-none pr-1 pl-1 py-0.5 pointer-events-auto">
                                    <button 
                                      class="text-gray-400 hover:text-primary cursor-move" 
                                      title="Déplacer"
                                    >
                                      <iconify-icon icon="solar:hamburger-menu-linear" width="10"></iconify-icon>
                                    </button>
                                    <button class="text-gray-400 hover:text-primary" title="Éditer" @click="$el.closest('.element-wrapper').querySelector('[contenteditable]').focus()">
                                      <iconify-icon icon="solar:pen-linear" width="10"></iconify-icon>
                                    </button>
                                    <button class="text-gray-400 hover:text-primary" title="Dupliquer" @click.stop="duplicateElement(index, rowIndex, element.id)">
                                      <iconify-icon icon="solar:copy-linear" width="10"></iconify-icon>
                                    </button>
                                    <button class="text-gray-400 hover:text-red-500" title="Supprimer" @click.stop="deleteElement(index, rowIndex, element.id)">
                                      <iconify-icon icon="solar:trash-bin-trash-linear" width="10"></iconify-icon>
                                    </button>
                                  </div>

                                  <!-- Standard Text Element -->
                                  <template x-if="element.type !== 'html'">
                                    <div 
                                      contenteditable="true" 
                                      class="outline-none text-sm min-h-[1.5em] p-1 border border-transparent hover:border-gray-100 focus:!border-blue-400/30 focus:!ring-2 focus:!ring-blue-400/10 rounded transition-all"
                                      style="outline: none !important;"
                                      x-text="element.content"
                                      @blur="updateElementContent($event, index, rowIndex, element.id)"
                                    ></div>
                                  </template>

                                  <!-- HTML Element (WYSIWYG with Word Clean) -->
                                  <template x-if="element.type === 'html'">
                                     <div class="relative group/html">
                                       <div 
                                         contenteditable="true"
                                         class="outline-none text-sm min-h-[1.5em] p-1 border border-transparent hover:border-gray-100 focus:!border-blue-400/30 focus:!ring-2 focus:!ring-blue-400/10 rounded transition-all"
                                         style="outline: none !important;"
                                         x-html="element.content"
                                         @blur="updateElementContent($event, index, rowIndex, element.id)"
                                         @paste="handleLayoutPaste($event, index, rowIndex, element.id)"
                                       ></div>
                                     </div>
                                  </template>
                                </div>
                              </template>
                            </div>

                            <!-- Empty State / Add Button -->
                            <div 
                              x-show="!(row.elements || []).some(e => e.column === col - 1)" 
                              class="absolute inset-0 flex items-center justify-center pointer-events-none"
                            >
                              <button class="w-8 h-8 rounded-full bg-white dark:bg-gray-600 shadow-sm flex items-center justify-center text-gray-400 pointer-events-auto">
                                <iconify-icon icon="solar:add-circle-bold" width="20"></iconify-icon>
                              </button>
                            </div>
                          </div>
                        </template>
                      </div>

                      <!-- 3. Action Controls (Bottom Center) - Floating Pill (Screenshot Style) -->
                      <div class="section-controls absolute -bottom-4 left-1/2 -translate-x-1/2 translate-y-full opacity-0 transition-opacity z-30 flex items-center justify-center gap-3 bg-white dark:bg-gray-900 rounded-full shadow-sm border border-gray-100 dark:border-gray-700 px-4 py-1.5 pointer-events-none">
                        <!-- Add Section -->
                        <button 
                           @click.stop="insertRowAfter(index, rowIndex)"
                           class="text-gray-400 hover:text-primary transition-colors flex items-center justify-center"
                           title="Ajouter une section dessous"
                        >
                           <iconify-icon icon="solar:add-circle-linear" width="20"></iconify-icon>
                        </button>
                        
                        <!-- Duplicate -->
                        <button 
                           @click.stop="duplicateRow(index, rowIndex)"
                           class="text-gray-400 hover:text-primary transition-colors flex items-center justify-center"
                           title="Dupliquer la section"
                        >
                           <iconify-icon icon="solar:copy-linear" width="18"></iconify-icon>
                        </button>
                        
                        <!-- Delete -->
                        <button 
                           @click.stop="deleteRow(index, rowIndex)"
                           class="text-gray-400 hover:text-red-500 transition-colors flex items-center justify-center"
                           title="Supprimer la section"
                        >
                           <iconify-icon icon="solar:trash-bin-trash-linear" width="18"></iconify-icon>
                        </button>
                      </div>

                    </div>
                  </div>
                </template>

              </div>
            </div>

            <!-- Page Actions Bar (bottom) -->
            <div class="flex items-center justify-center gap-1 mt-2 opacity-0 group-hover:opacity-100 transition-opacity">
              <button @click="addPageAfter(index)" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-primary transition-colors" title="Ajouter une page après">
                <iconify-icon icon="solar:add-circle-bold" width="18"></iconify-icon>
              </button>
              <button @click="duplicatePage(index)" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-primary transition-colors" title="Dupliquer">
                <iconify-icon icon="solar:copy-bold" width="18"></iconify-icon>
              </button>
              <button @click="deletePage(index)" x-show="doc.pages.length > 1" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-danger transition-colors" title="Supprimer">
                <iconify-icon icon="solar:trash-bin-trash-bold" width="18"></iconify-icon>
              </button>
            </div>
          </div>
        </template>
      </div>
    </div>
