<script>
    document.addEventListener("alpine:init", () => {

        // â•â•â• HEADER BAR (Hero identity bar menu) â•â•â•
        Alpine.data("headerBar", () => ({
            showMoreMenu: false,
            showDeleteConfirm: false
        }));

        // â•â•â• HEADER CONFIG PANEL (standalone modal) â•â•â•
        Alpine.data("headerConfigPanel", () => ({
            showHeaderConfig: false,
            hcSaving: false,
            hcLocal: <%- JSON.stringify((entity.headerConfig && typeof entity.headerConfig.toObject === 'function') ? entity.headerConfig.toObject() : (entity.headerConfig || {})).replace(/</g, '\\u003C') %>,
            entityRelations: <%- JSON.stringify((entity.relations || []).map(r => ({ key: r.key, label: r.label || 'Relation', targetEntity: r.targetEntity ? (r.targetEntity._id || r.targetEntity).toString() : '' }))).replace(/</g, '\\u003C') %>,
            entityId: '<%= entity._id %>',
            accountNumber: '<%= account_number %>',
            async saveHeaderConfig() {
                this.hcSaving = true;
                try {
                    const res = await fetch(`/account/${this.accountNumber}/entity/api/update/${this.entityId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ headerConfig: this.hcLocal })
                    });
                    if (res.ok) {
                        this.showHeaderConfig = false;
                        window.location.reload();
                    } else {
                        const err = await res.json().catch(() => null);
                        alert('Erreur: ' + (err?.error || 'Impossible de sauvegarder'));
                    }
                } catch (e) {
                    alert('Erreur: ' + e.message);
                } finally {
                    this.hcSaving = false;
                }
            }
        }));

        // â•â•â• PANEL LAYOUT (12-Unit Grid Resize + Drag & Drop Panels) â•â•â•
        Alpine.data("panelLayout", () => {
            const entityId = '<%= locals.entity ? locals.entity._id : "" %>';
            const accountNumber = '<%= account_number %>';
            let mainSortable = null;
            let sidebarSortable = null;
            let sidebarInnerSortable = null;
            let resizeState = null;

            return {
                // 12-unit grid: main=8, sidebar=4 by default
                columns: [
                    { id: 'main', width: 8 },
                    { id: 'sidebar', width: 4 }
                ],
                extraColumns: [],  // dynamically created empty columns
                resizeActive: false,
                resizeColIndex: -1,
                layoutHover: false,

                init() {
                    this.loadColumnLayout();
                    this.$watch('designMode', (val) => {
                        if (val) {
                            this.$nextTick(() => {
                                this.initPanelSortables();
                                this._updateEmptyZoneIndicators();
                            });
                        } else {
                            this.destroyPanelSortables();
                        }
                    });
                    window.addEventListener('mousemove', (e) => this.doResize(e));
                    window.addEventListener('mouseup', () => this.endResize());
                },

                // â•â•â• RESIZE LOGIC (12-unit grid) â•â•â•
                startResize(colIndex, event) {
                    const container = document.getElementById('panels-container');
                    if (!container) return;

                    const allCols = this.getAllColumns();
                    resizeState = {
                        colIndex,
                        startX: event.clientX,
                        startWidths: allCols.map(c => c.width),
                        startColCount: allCols.length
                    };
                    this.resizeActive = true;
                    this.resizeColIndex = colIndex;
                    document.body.style.cursor = 'col-resize';
                    document.body.style.userSelect = 'none';
                },

                doResize(event) {
                    if (!resizeState) return;
                    const { colIndex, startX, startWidths, startColCount } = resizeState;

                    const gridContainer = document.getElementById('panels-container');
                    if (!gridContainer) return;
                    const gridWidth = gridContainer.offsetWidth;
                    const colUnitWidth = gridWidth / 12;

                    const deltaX = event.clientX - startX;
                    const deltaUnits = Math.round(deltaX / colUnitWidth);
                    if (deltaUnits === 0) return;

                    const allCols = this.getAllColumns();
                    const isLastColumn = colIndex === allCols.length - 1;
                    const leftWidth = startWidths[colIndex];

                    // Min width: main=2, sidebar=2, extras=1
                    const getMinWidth = (idx) => {
                        if (idx < this.columns.length) return 2; // main & sidebar
                        return 1; // extras
                    };

                    if (isLastColumn) {
                        // â•â•â• LAST COLUMN: shrinking creates new empty column â•â•â•
                        let newLeftWidth = leftWidth + deltaUnits;
                        const minW = getMinWidth(colIndex);
                        if (newLeftWidth < minW) newLeftWidth = minW;

                        // Sum of all OTHER columns (not the one being resized)
                        const othersSum = allCols.reduce((sum, col, idx) =>
                            idx === colIndex ? sum : sum + col.width, 0);
                        const remaining = 12 - othersSum - newLeftWidth;

                        if (remaining > 0) {
                            // Space freed → create or update trailing extra column
                            if (allCols.length === startColCount) {
                                const newCol = {
                                    id: 'extra_' + Date.now(),
                                    width: remaining,
                                    panels: []
                                };
                                this.extraColumns.push(newCol);
                                resizeState.startWidths.push(0);
                                resizeState.startColCount = allCols.length + 1;
                                this.$nextTick(() => this.initExtraColSortable(this.extraColumns.length - 1));
                            } else {
                                const lastExtra = this.extraColumns[this.extraColumns.length - 1];
                                if (lastExtra) lastExtra.width = remaining;
                            }
                            this.setColWidth(colIndex, newLeftWidth);
                        } else if (remaining === 0) {
                            // Perfect fit → remove trailing extra if it was just created
                            if (allCols.length > startColCount && this.extraColumns.length > 0) {
                                this.extraColumns.pop();
                                resizeState.startWidths.pop();
                                resizeState.startColCount = allCols.length - 1;
                            }
                            this.setColWidth(colIndex, newLeftWidth);
                        } else {
                            // remaining < 0 → dragging beyond original, cap to fill all space
                            if (allCols.length > startColCount && this.extraColumns.length > 0) {
                                this.extraColumns.pop();
                                resizeState.startWidths.pop();
                                resizeState.startColCount = allCols.length - 1;
                            }
                            // Fill: this column gets ALL remaining space
                            this.setColWidth(colIndex, 12 - othersSum);
                        }
                    } else {
                        // â•â•â• NORMAL RESIZE between two adjacent columns â•â•â•
                        const rightWidth = startWidths[colIndex + 1];
                        const totalPair = leftWidth + rightWidth;

                        let newLeftWidth = leftWidth + deltaUnits;
                        let newRightWidth = rightWidth - deltaUnits;

                        const isRightExtra = (colIndex + 1 >= this.columns.length);
                        const minLeft = getMinWidth(colIndex);
                        const minRight = isRightExtra ? 0 : getMinWidth(colIndex + 1);

                        // If right is extra and squeezed to 0 → remove it
                        if (newRightWidth <= 0 && isRightExtra) {
                            const extraIdx = colIndex + 1 - this.columns.length;
                            const removedWidth = this.extraColumns[extraIdx]?.width || 0;
                            this.extraColumns.splice(extraIdx, 1);
                            resizeState.startWidths.splice(colIndex + 1, 1);
                            resizeState.startColCount = this.getAllColumns().length;
                            this.setColWidth(colIndex, leftWidth + removedWidth);
                            return;
                        }

                        // Clamp to min widths
                        if (newLeftWidth < minLeft) {
                            newLeftWidth = minLeft;
                            newRightWidth = totalPair - minLeft;
                        }
                        if (newRightWidth < minRight) {
                            newRightWidth = minRight;
                            newLeftWidth = totalPair - minRight;
                        }

                        this.setColWidth(colIndex, newLeftWidth);
                        this.setColWidth(colIndex + 1, newRightWidth);
                    }
                },

                endResize() {
                    if (!resizeState) return;
                    resizeState = null;
                    this.resizeActive = false;
                    this.resizeColIndex = -1;
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';

                    // Safety: force total = 12
                    this._enforceTotal12();
                    this.saveColumnLayout();
                },

                // Helper: get all columns (main + sidebar + extras)
                getAllColumns() {
                    return [...this.columns, ...this.extraColumns];
                },

                // Helper: set width on the right column array (columns or extraColumns)
                setColWidth(index, width) {
                    if (index < this.columns.length) {
                        this.columns[index].width = width;
                    } else {
                        const extraIdx = index - this.columns.length;
                        if (this.extraColumns[extraIdx]) {
                            this.extraColumns[extraIdx].width = width;
                        }
                    }
                },

                // Remove an extra (empty) column
                removeExtraColumn(idx) {
                    const freedWidth = this.extraColumns[idx]?.width || 0;
                    this.extraColumns.splice(idx, 1);
                    if (freedWidth > 0) {
                        // Give the freed space back to the last remaining column
                        const allCols = this.getAllColumns();
                        if (allCols.length > 0) {
                            allCols[allCols.length - 1].width += freedWidth;
                        }
                    }
                    this._enforceTotal12();
                    this.saveColumnLayout();
                },

                // Remove the sidebar column (column 1) â€” give its space to the main column
                removeSidebarColumn() {
                    if (this.columns.length < 2) return;
                    const freedWidth = this.columns[1].width;
                    this.columns.splice(1, 1);
                    // Give all freed space to the main (left) column
                    this.columns[0].width += freedWidth;
                    this._enforceTotal12();
                    this.saveColumnLayout();
                },

                // Safety net: force all column widths to sum to exactly 12
                _enforceTotal12() {
                    const allCols = this.getAllColumns();
                    const total = allCols.reduce((s, c) => s + c.width, 0);
                    if (total === 12 || allCols.length === 0) return;
                    const diff = 12 - total;
                    // Adjust the last column
                    const lastCol = allCols[allCols.length - 1];
                    lastCol.width += diff;
                    // If the adjustment makes it too small, redistribute
                    if (lastCol.width < 1) {
                        const deficit = 1 - lastCol.width;
                        lastCol.width = 1;
                        // Take from the first column that can afford it
                        for (let i = allCols.length - 2; i >= 0; i--) {
                            if (allCols[i].width > 2) {
                                allCols[i].width -= deficit;
                                break;
                            }
                        }
                    }
                },

                // Update empty zone placeholders visibility
                _updateEmptyZoneIndicators() {
                    // Main column
                    const mainZone = document.getElementById('panels-main-zone');
                    const mainInner = mainZone?.querySelector('.space-y-4') || mainZone;
                    const mainIndicator = document.getElementById('main-empty-indicator');
                    if (mainInner && mainIndicator) {
                        const hasPanels = mainInner.querySelectorAll(':scope > .panel-sortable-item').length > 0;
                        mainIndicator.style.display = hasPanels ? 'none' : 'block';
                    }

                    // Sidebar column
                    const sidebarZone = document.getElementById('sidebar-main-sortable');
                    const sidebarIndicator = document.getElementById('sidebar-empty-indicator');
                    if (sidebarZone && sidebarIndicator) {
                        const hasPanels = sidebarZone.querySelectorAll(':scope > .panel-sortable-item').length > 0;
                        sidebarIndicator.style.display = hasPanels ? 'none' : 'block';
                    }
                },

                // â•â•â• DRAG & DROP (Sortable) â•â•â•
                extraSortables: [],

                getSortableOpts() {
                    return {
                        group: 'panels',
                        animation: 250,
                        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                        handle: '.panel-drag-handle',
                        draggable: '.panel-sortable-item',
                        ghostClass: 'panel-sortable-ghost',
                        chosenClass: 'panel-sortable-chosen',
                        dragClass: 'panel-sortable-drag',
                        fallbackOnBody: true,
                        swapThreshold: 0.65,
                        onEnd: () => {
                            this.savePanelLayout();
                            this._updateEmptyZoneIndicators();
                        }
                    };
                },

                initPanelSortables() {
                    const mainZone = document.getElementById('panels-main-zone');
                    const mainInner = mainZone?.querySelector('.space-y-4') || mainZone;
                    const sidebarOuter = document.getElementById('sidebar-main-sortable');
                    const sidebarInner = document.getElementById('sidebar-inner-sortable');
                    if (!mainInner) return;
                    const opts = this.getSortableOpts();
                    mainSortable = new Sortable(mainInner, opts);
                    if (sidebarOuter) {
                        sidebarSortable = new Sortable(sidebarOuter, opts);
                    }
                    // Inner sidebar: allows reordering individual panels within the sidebar
                    if (sidebarInner) {
                        sidebarInnerSortable = new Sortable(sidebarInner, opts);
                    }
                    // Init sortables for any existing extra columns
                    this.initAllExtraColSortables();
                },

                destroyPanelSortables() {
                    if (mainSortable) { mainSortable.destroy(); mainSortable = null; }
                    if (sidebarSortable) { sidebarSortable.destroy(); sidebarSortable = null; }
                    if (sidebarInnerSortable) { sidebarInnerSortable.destroy(); sidebarInnerSortable = null; }
                    this.destroyExtraSortables();
                },

                initExtraColSortable(idx) {
                    if (!this.designMode) return;
                    const el = document.getElementById('extra-col-sortable-' + idx);
                    if (!el || el._sortableInit) return;
                    const sortable = new Sortable(el, this.getSortableOpts());
                    el._sortableInit = true;
                    this.extraSortables.push({ idx, sortable, el });
                },

                initAllExtraColSortables() {
                    this.destroyExtraSortables();
                    this.extraColumns.forEach((col, idx) => {
                        this.$nextTick(() => this.initExtraColSortable(idx));
                    });
                },

                destroyExtraSortables() {
                    this.extraSortables.forEach(s => {
                        if (s.sortable) s.sortable.destroy();
                        if (s.el) s.el._sortableInit = false;
                    });
                    this.extraSortables = [];
                },

                initSortableCol(el, colIndex) {
                    // Future: initialize sortable for individual columns
                },

                getPanelLabel(panelId) {
                    const labels = { attributs: 'Attributs', sidebar: 'Sidebar' };
                    return labels[panelId] || panelId;
                },

                // â•â•â• PERSISTENCE â•â•â•
                async loadColumnLayout() {
                    try {
                        const resp = await fetch(`/account/${accountNumber}/api/user/view-preferences/record_panels_${entityId}`, { credentials: 'include' });
                        if (resp.ok) {
                            const data = await resp.json();
                            if (data?.preferences?.columnWidths) {
                                const saved = data.preferences.columnWidths;
                                // Migrate from old percentage format (75/25) to 12-unit grid (8/4)
                                const isOldFormat = saved.some(c => c.width > 12);
                                if (isOldFormat) {
                                    const total = saved.reduce((sum, c) => sum + c.width, 0);
                                    saved.forEach(c => {
                                        c.width = Math.round((c.width / total) * 12);
                                    });
                                    // Ensure total is exactly 12
                                    const newTotal = saved.reduce((sum, c) => sum + c.width, 0);
                                    if (newTotal !== 12) saved[0].width += (12 - newTotal);
                                }
                                this.columns = saved;
                            }
                            if (data?.preferences?.extraColumns) {
                                this.extraColumns = data.preferences.extraColumns;
                            }
                            // Validate total = 12 (fix corrupted saved data)
                            this._enforceTotal12();
                            // Load panel layout (panel order + column assignments)
                            if (data?.preferences?.panelLayout) {
                                this.$nextTick(() => this.applyPanelLayout(data.preferences.panelLayout));
                            }
                        }
                    } catch(e) { console.warn('Could not load column layout:', e); }
                },

                applyPanelLayout(layout) {
                    // Collect all panel-sortable-item elements from all zones
                    const allPanels = new Map();
                    document.querySelectorAll('.panel-sortable-item[data-panel-id]').forEach(el => {
                        allPanels.set(el.dataset.panelId, el);
                    });
                    if (allPanels.size === 0) return;

                    const mainZone = document.getElementById('panels-main-zone');
                    const sidebarZone = document.getElementById('sidebar-main-sortable');

                    // Helper: move panels into a zone in specified order
                    const movePanelsToZone = (zone, panelIds) => {
                        if (!zone || !panelIds) return;
                        panelIds.forEach(id => {
                            const el = allPanels.get(id);
                            if (el) {
                                zone.appendChild(el);
                                allPanels.delete(id);
                            }
                        });
                    };

                    // Apply main column order
                    if (layout.main && mainZone) {
                        // Get the inner sortable container (first child div)
                        const mainInner = mainZone.querySelector('.space-y-4') || mainZone;
                        movePanelsToZone(mainInner, layout.main);
                    }

                    // Apply sidebar order
                    if (layout.sidebar && sidebarZone) {
                        movePanelsToZone(sidebarZone, layout.sidebar);
                    }

                    // Apply inner sidebar panel ordering
                    if (layout.sidebarInner) {
                        const sidebarInnerZone = document.getElementById('sidebar-inner-sortable');
                        if (sidebarInnerZone) {
                            movePanelsToZone(sidebarInnerZone, layout.sidebarInner);
                        }
                    }

                    // Apply extra column panels
                    if (layout.extra && this.extraColumns.length > 0) {
                        this.$nextTick(() => {
                            this.extraColumns.forEach((col, idx) => {
                                const extraZone = document.getElementById('extra-col-sortable-' + idx);
                                const panelIds = layout.extra[col.id];
                                if (extraZone && panelIds) {
                                    movePanelsToZone(extraZone, panelIds);
                                    col.panels = panelIds;
                                }
                            });
                        });
                    }
                },

                async saveColumnLayout() {
                    try {
                        await fetch(`/account/${accountNumber}/api/user/view-preferences`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                viewId: `record_panels_${entityId}`,
                                preferences: {
                                    columnWidths: JSON.parse(JSON.stringify(this.columns)),
                                    extraColumns: JSON.parse(JSON.stringify(this.extraColumns))
                                }
                            })
                        });
                    } catch(e) { console.error('Failed to save column layout:', e); }
                },

                async savePanelLayout() {
                    const mainZone = document.getElementById('panels-main-zone');
                    const mainInner = mainZone?.querySelector('.space-y-4') || mainZone;
                    const sidebarOuter = document.getElementById('sidebar-main-sortable');
                    const sidebarInner = document.getElementById('sidebar-inner-sortable');
                    const mainPanels = mainInner ? Array.from(mainInner.querySelectorAll(':scope > .panel-sortable-item')).map(el => el.dataset.panelId) : [];
                    const sidebarPanels = sidebarOuter ? Array.from(sidebarOuter.querySelectorAll(':scope > .panel-sortable-item')).map(el => el.dataset.panelId) : [];
                    // Also save the inner sidebar panel ordering
                    const sidebarInnerPanels = sidebarInner ? Array.from(sidebarInner.querySelectorAll(':scope > .panel-sortable-item')).map(el => el.dataset.panelId) : [];
                    
                    // Collect panels from extra columns
                    const extraPanels = {};
                    this.extraColumns.forEach((col, idx) => {
                        const zone = document.getElementById('extra-col-sortable-' + idx);
                        if (zone) {
                            const panels = Array.from(zone.querySelectorAll(':scope > .panel-sortable-item')).map(el => el.dataset.panelId);
                            extraPanels[col.id] = panels;
                            // Update the panels array on the column
                            col.panels = panels;
                        }
                    });

                    try {
                        await fetch(`/account/${accountNumber}/api/user/view-preferences`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                viewId: `record_panels_${entityId}`,
                                preferences: { panelLayout: { main: mainPanels, sidebar: sidebarPanels, sidebarInner: sidebarInnerPanels, extra: extraPanels } }
                            })
                        });
                    } catch(e) { console.error('Failed to save panel layout:', e); }
                }
            };
        });

        // Inject computedFieldValues for legacy layout rendering
        window.__computedFieldValues__ = JSON.parse('<%- JSON.stringify(typeof computedFieldValues !== "undefined" ? computedFieldValues : {}).replace(/</g, "\\u003C") %>');

        Alpine.data("recordForm", () => {
            const initialLayout = JSON.parse('<%- JSON.stringify(locals.formLayout || []) %>');
            const allTemplates = JSON.parse(document.getElementById("all-templates").textContent);
            const rawFields = JSON.parse(document.getElementById("initial-fields").textContent);
            const recordValues = JSON.parse(document.getElementById("record-values").textContent);

            const fieldsMap = {};
            rawFields.forEach(f => { fieldsMap[f._id] = f; });
            allTemplates.forEach(t => { if (!fieldsMap[t._id]) fieldsMap[t._id] = t; });

            // Inject entity relations as pseudo-fields in fieldsMap
            const entityRelations = JSON.parse(document.getElementById("entity-relations").textContent);
            entityRelations.forEach(r => { if (!fieldsMap[r._id]) fieldsMap[r._id] = r; });

            const valuesMap = {};
            recordValues.forEach(cv => { valuesMap[cv.field_id] = cv.value; });

            return {
                designMode: false,
                tabs: (initialLayout.tabs || [{ id: 'default', title: 'Attributs' }]).map(t => ({
                    ...t,
                    icon: t.icon || 'tabler:apps'
                })),
                activeTab: (initialLayout.tabs && initialLayout.tabs.length > 0) ? initialLayout.tabs[0].id : 'default',
                layout: (Array.isArray(initialLayout) ? initialLayout : (initialLayout.fields || [])).map(i => ({
                    ...i,
                    id: String(i.id || `f_${Math.random()}`),
                    tabId: i.tabId || 'default'
                })),
                fieldsById: fieldsMap,
                valuesMap: valuesMap,
                allTemplates: allTemplates,
                entityFieldIds: rawFields.map(f => f._id),
                openModal: false,
                fieldSearchQuery: '',
                relationsFieldsOpen: true,
                isResizing: false,
                resizeData: null,
                editingTabId: null,
                tempTabTitle: '',
                tempTabIcon: 'tabler:apps',

                init() {
                    this.rebuildCanvas();
                    window.addEventListener('mousemove', (e) => this.handleResizing(e));
                    window.addEventListener('mouseup', () => this.stopResizing());

                    this.$watch('designMode', () => {
                        this.rebuildCanvas();
                    });
                    this.$watch('activeTab', () => {
                        this.rebuildCanvas();
                    });
                },

                renderAllFields() {
                    const currentTabFields = this.layout.filter(item => {
                        if (item.tabId !== this.activeTab) return false;
                        // Exclude relation fields - they have their own panel
                        const field = this.fieldsById[item.fieldId];
                        if (field && field.type === 'relation') return false;
                        return true;
                    });
                    if (currentTabFields.length === 0 && this.designMode) {
                        return `
                            <div class="w-full flex flex-col items-center justify-center py-12 gap-3 cursor-pointer group/add-box" 
                                 onclick="window.recordFormApp.openModal = true">
