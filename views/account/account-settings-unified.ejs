<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('settingsPage', () => ({
        activeTab: new URLSearchParams(window.location.search).get('tab') || 'general',
        accountName: '<%= typeof account !== "undefined" && account ? (account.name || "").replace(/'/g, "\\'") : "" %>',
        accountIcon: '<%= typeof account !== "undefined" && account ? account.icon || "solar:settings-bold-duotone" : "solar:settings-bold-duotone" %>',
        isSaving: false,
        saveSuccess: false,
        popularIcons: [
            'solar:settings-bold-duotone', 'solar:home-bold-duotone', 'solar:buildings-bold-duotone',
            'solar:case-bold-duotone', 'solar:shop-bold-duotone', 'solar:cart-large-bold-duotone',
            'solar:code-bold-duotone', 'solar:heart-bold-duotone', 'solar:star-bold-duotone', 'solar:rocket-bold-duotone'
        ],

        async saveAccountInfo() {
            this.isSaving = true;
            this.saveSuccess = false;
            try {
                const res = await fetch('/account/<%= account_number %>/admin/api/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ name: this.accountName, icon: this.accountIcon })
                });
                const data = await res.json();
                if (data.success) {
                    this.saveSuccess = true;
                    setTimeout(() => this.saveSuccess = false, 3000);
                } else {
                    alert('Erreur: ' + (data.message || 'Impossible de sauvegarder'));
                }
            } catch (e) { alert('Erreur'); }
            finally { this.isSaving = false; }
        },

        copyAccountNumber() {
            navigator.clipboard.writeText('<%= account_number %>');
            if (window.showMessage) window.showMessage('Numéro copié !');
        },

        confirmDelete() {
            if (window.Swal) {
                Swal.fire({
                    title: 'Êtes-vous sûr?',
                    text: "Cette action est irréversible. Toutes les données du compte seront supprimées.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e7515a',
                    cancelButtonColor: '#888ea8',
                    confirmButtonText: 'Oui, supprimer',
                    cancelButtonText: 'Annuler'
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            const res = await fetch('/account/<%= account_number %>/admin/api/account', {
                                method: 'DELETE',
                                headers: { 'Content-Type': 'application/json' },
                                credentials: 'include'
                            });
                            const data = await res.json();
                            if (data.success) {
                                Swal.fire('Supprimé!', 'Le compte a été supprimé.', 'success').then(() => {
                                    window.location.href = data.redirect || '/user/accounts';
                                });
                            } else {
                                Swal.fire('Erreur', data.error || 'Impossible de supprimer le compte', 'error');
                            }
                        } catch (e) {
                            console.error('Delete account error:', e);
                            Swal.fire('Erreur', 'Une erreur est survenue', 'error');
                        }
                    }
                });
            } else {
                if (confirm('Êtes-vous sûr de vouloir supprimer ce compte? Cette action est irréversible.')) {
                    fetch('/account/<%= account_number %>/admin/api/account', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include'
                    }).then(r => r.json()).then(data => {
                        if (data.success) window.location.href = data.redirect || '/user/accounts';
                        else alert(data.error || 'Erreur');
                    }).catch(() => alert('Erreur'));
                }
            }
        },

        // Security / PIN methods
        pinEnabled: false,
        newPin: '',
        confirmPin: '',
        currentPin: '',
        pinError: '',
        isPinSaving: false,

        async initSecurity() {
            try {
                const res = await fetch('/account/<%= account_number %>/api/user/security-status');
                const data = await res.json();
                if (data.success) {
                    this.pinEnabled = data.pinEnabled;
                }
            } catch (e) { console.error('Erreur chargement sécurité'); }
        },

        async savePin() {
            this.pinError = '';
            if (this.newPin !== this.confirmPin) {
                this.pinError = 'Les PINs ne correspondent pas.';
                return;
            }
            if (this.newPin.length !== 4) {
                this.pinError = 'Le PIN doit contenir 4 chiffres.';
                return;
            }
            if (this.pinEnabled && !this.currentPin) {
                this.pinError = 'Le PIN actuel est requis pour le modifier.';
                return;
            }

            this.isPinSaving = true;
            try {
                const res = await fetch('/account/<%= account_number %>/api/user/set-pin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        pin: this.newPin,
                        currentPin: this.currentPin
                    })
                });
                const data = await res.json();
                
                if (data.success) {
                    this.pinEnabled = true;
                    this.newPin = '';
                    this.confirmPin = '';
                    this.currentPin = '';
                    if (window.showMessage) window.showMessage('PIN défini avec succès !');
                    else alert('PIN défini avec succès !');
                } else {
                    this.pinError = data.error || 'Erreur lors de la sauvegarde du PIN.';
                }
            } catch (e) {
                this.pinError = 'Erreur réseau.';
            } finally {
                this.isPinSaving = false;
            }
        },

        async deletePin() {
            if (!this.currentPin) {
                this.pinError = 'Le PIN actuel est requis pour le désactiver.';
                return;
            }
            if (!confirm('Êtes-vous sûr de vouloir désactiver votre code PIN ? Les éléments sécurisés ne seront plus accessibles sans définir un nouveau PIN.')) return;

            this.isPinSaving = true;
            try {
                const res = await fetch('/account/<%= account_number %>/api/user/pin', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pin: this.currentPin })
                });
                const data = await res.json();
                
                if (data.success) {
                    this.pinEnabled = false;
                    this.newPin = '';
                    this.confirmPin = '';
                    this.currentPin = '';
                    this.pinError = '';
                    if (window.showMessage) window.showMessage('PIN désactivé !');
                    else alert('PIN désactivé !');
                } else {
                    this.pinError = data.error || 'PIN incorrect.';
                }
            } catch (e) {
                this.pinError = 'Erreur réseau.';
            } finally {
                this.isPinSaving = false;
            }
        }
    }));
});

// ── Member management API calls (using Team API) ──
const accountNumber = '<%= account_number %>';
const teamApiBase = `/account/${accountNumber}/api/team`;

async function teamApiCall(path, body, method = 'POST') {
    const res = await fetch(`${teamApiBase}${path}`, {
        method, headers: { 'Content-Type': 'application/json' },
        credentials: 'include', body: body ? JSON.stringify(body) : undefined
    });
    return res.json();
}

async function changeMemberRole(userId, newRole) {
    const data = await teamApiCall('/update-role', { userId, newRole });
    if (data.success) location.reload();
    else alert(data.error || 'Erreur');
}

async function removeMember(userId, name) {
    if (!confirm(`Retirer ${name} du workspace ?`)) return;
    const data = await teamApiCall('/remove-member', { userId });
    if (data.success) location.reload();
    else alert(data.error || 'Erreur');
}

async function cancelInvite(email) {
    if (!confirm('Annuler cette invitation ?')) return;
    const data = await teamApiCall('/cancel-invite', { email });
    if (data.success) location.reload();
    else alert(data.error || 'Erreur');
}

async function inviteMember() {
    const form = document.getElementById('inviteForm');
    const fd = new FormData(form);
    const btn = document.getElementById('inviteBtn');
    btn.disabled = true;
    try {
        const data = await teamApiCall('/invite', Object.fromEntries(fd));
        if (data.success) {
            alert(data.message || 'Invitation envoyée !');
            location.reload();
        } else {
            alert(data.error || 'Erreur');
            btn.disabled = false;
        }
    } catch (e) { alert('Erreur'); btn.disabled = false; }
}

// ── Billing Tab Alpine Component ──
document.addEventListener('alpine:init', () => {
    Alpine.data('billingTab', () => ({
        loading: true,
        planSlug: 'free',
        planName: 'Free',
        planDescription: '',
        planColor: '#6b7280',
        subStatus: 'active',
        changingPlan: false,
        availablePlans: [],
        activeAddons: [],
        usageBars: [],

        async init() {
            await Promise.all([this.fetchSubscription(), this.fetchPlans()]);
            this.loading = false;
        },

        async fetchSubscription() {
            try {
                const res = await fetch(`/account/${accountNumber}/api/billing/subscription`, { credentials: 'include' });
                const data = await res.json();
                if (data.success) {
                    const sub = data.subscription;
                    this.planSlug = sub.planSlug || 'free';
                    this.planName = sub.plan?.name || 'Free';
                    this.planDescription = sub.plan?.description || '';
                    this.planColor = sub.plan?.color || '#6b7280';
                    this.subStatus = sub.status || 'active';
                    this.activeAddons = (sub.addons || []).map(a => ({
                        addonSlug: a.addonSlug,
                        name: a.addonSlug,
                        icon: 'solar:widget-bold-duotone',
                        activatedAt: a.activatedAt
                    }));

                    // Build usage bars
                    const limits = sub.effectiveLimits || sub.plan?.limits || {};
                    const usage = data.usage || {};
                    const bars = [
                        { key: 'users', label: 'Utilisateurs', icon: 'solar:users-group-rounded-bold-duotone', current: usage.activeUsers || 0, limit: limits.users ?? 0 },
                        { key: 'entities', label: 'Entités', icon: 'solar:folder-bold-duotone', current: usage.entities || 0, limit: limits.entities ?? 0 },
                        { key: 'records', label: 'Records', icon: 'solar:document-text-bold-duotone', current: usage.records || 0, limit: limits.records ?? 0 },
                        { key: 'storage', label: 'Stockage', icon: 'solar:cloud-storage-bold-duotone', current: usage.storageMB || 0, limit: limits.storageMB ?? 0 },
                        { key: 'ai', label: 'Crédits IA', icon: 'solar:magic-stick-3-bold-duotone', current: usage.aiCreditsUsed || 0, limit: limits.aiCreditsPerMonth ?? 0 },
                        { key: 'automations', label: 'Automations', icon: 'solar:bolt-circle-bold-duotone', current: usage.automationsRun || 0, limit: limits.automationsPerMonth ?? 0 },
                    ];
                    this.usageBars = bars.map(b => ({
                        ...b,
                        pct: b.limit === -1 ? 0 : (b.limit > 0 ? Math.round((b.current / b.limit) * 100) : 0)
                    }));
                }
            } catch (e) { console.error('[Billing] fetch error:', e); }
        },

        async fetchPlans() {
            try {
                const res = await fetch(`/account/${accountNumber}/api/billing/plans`, { credentials: 'include' });
                const data = await res.json();
                if (data.success) this.availablePlans = data.plans;
            } catch (e) { console.error('[Billing] plans error:', e); }
        },

        async changePlan(slug) {
            if (slug === this.planSlug || this.changingPlan) return;
            if (!confirm(`Changer vers le plan ${slug} ?`)) return;
            this.changingPlan = true;
            try {
                const res = await fetch(`/account/${accountNumber}/api/billing/change-plan`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    credentials: 'include', body: JSON.stringify({ planSlug: slug })
                });
                const data = await res.json();
                if (data.success) {
                    await this.fetchSubscription();
                    if (window.showMessage) window.showMessage(data.message || 'Plan changé');
                } else {
                    alert(data.error || 'Erreur');
                }
            } catch (e) { alert('Erreur'); }
            this.changingPlan = false;
        },

        async removeAddon(slug) {
            if (!confirm('Retirer cet addon ?')) return;
            try {
                const res = await fetch(`/account/${accountNumber}/api/billing/remove-addon`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    credentials: 'include', body: JSON.stringify({ addonSlug: slug })
                });
                const data = await res.json();
                if (data.success) await this.fetchSubscription();
                else alert(data.error || 'Erreur');
            } catch (e) { alert('Erreur'); }
        }
    }));
});
</script>
