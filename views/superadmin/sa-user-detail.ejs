<!-- SuperAdmin User Detail -->
<div>
    <!-- Back + Header -->
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
        <a href="/superadmin/users" class="sa-back-link">
            <iconify-icon icon="solar:arrow-left-bold" width="14"></iconify-icon>
            Retour
        </a>
    </div>

    <!-- Profile Card -->
    <div class="sa-panel" style="margin-bottom: 20px;">
        <div style="padding: 30px; display: flex; align-items: center; gap: 20px;">
            <div class="sa-avatar" style="width: 64px; height: 64px; font-size: 24px; border-radius: 16px; background: linear-gradient(135deg, #4361ee, #06b6d4); color: #fff;">
                <%= targetUser.name ? targetUser.name.charAt(0).toUpperCase() : '?' %>
            </div>
            <div style="flex: 1;">
                <h1 style="font-size: 22px; font-weight: 800; color: #0f172a; margin: 0;"><%= targetUser.name || '—' %></h1>
                <p style="font-size: 13px; color: #94a3b8; margin: 4px 0 0;"><%= targetUser.email %></p>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
                <% if (targetUser.role === 'superadmin') { %>
                    <span class="sa-badge sa-badge-red" style="font-size: 12px; padding: 5px 14px;">
                        <iconify-icon icon="solar:shield-star-bold" width="14"></iconify-icon>
                        SuperAdmin
                    </span>
                <% } else if (targetUser.role === 'admin') { %>
                    <span class="sa-badge sa-badge-cyan" style="font-size: 12px; padding: 5px 14px;">Admin</span>
                <% } else { %>
                    <span class="sa-badge sa-badge-gray" style="font-size: 12px; padding: 5px 14px;">Utilisateur</span>
                <% } %>

                <% if (targetUser.status === 'active') { %>
                    <span class="sa-badge sa-badge-green" style="font-size: 12px; padding: 5px 14px;">Actif</span>
                <% } else if (targetUser.status === 'suspended') { %>
                    <span class="sa-badge sa-badge-red" style="font-size: 12px; padding: 5px 14px;">Suspendu</span>
                <% } else { %>
                    <span class="sa-badge sa-badge-gray" style="font-size: 12px; padding: 5px 14px;"><%= targetUser.status %></span>
                <% } %>
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
        <!-- Info -->
        <div class="sa-panel">
            <div class="sa-panel-header">
                <div style="font-size: 15px; font-weight: 700; color: #0f172a;">
                    <iconify-icon icon="solar:info-circle-bold-duotone" width="18" style="color: #4361ee; margin-right: 6px; vertical-align: -3px;"></iconify-icon>
                    Informations
                </div>
            </div>
            <div class="sa-panel-body">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 4px;">Authentification</div>
                        <div style="font-size: 13px; font-weight: 600; color: #334155;">
                            <iconify-icon icon="<%= targetUser.authProvider === 'google' ? 'mdi:google' : 'solar:lock-bold' %>" width="14" style="margin-right: 4px; vertical-align: -2px;"></iconify-icon>
                            <%= targetUser.authProvider === 'google' ? 'Google OAuth' : 'Email / Password' %>
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 4px;">Connexions</div>
                        <div style="font-size: 13px; font-weight: 600; color: #334155;"><%= targetUser.loginCount || 0 %> connexion(s)</div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 4px;">Dernière connexion</div>
                        <div style="font-size: 13px; font-weight: 600; color: #334155;">
                            <%= targetUser.lastLogin ? new Date(targetUser.lastLogin).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—' %>
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 4px;">Inscrit le</div>
                        <div style="font-size: 13px; font-weight: 600; color: #334155;">
                            <%= new Date(targetUser.created_on).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Membership -->
        <div class="sa-panel">
            <div class="sa-panel-header">
                <div style="font-size: 15px; font-weight: 700; color: #0f172a;">
                    <iconify-icon icon="solar:crown-bold-duotone" width="18" style="color: #d97706; margin-right: 6px; vertical-align: -3px;"></iconify-icon>
                    Abonnement
                </div>
            </div>
            <div class="sa-panel-body">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 4px;">Plan</div>
                        <% const planBadge = { free: 'sa-badge-gray', basic: 'sa-badge-blue', premium: 'sa-badge-yellow', enterprise: 'sa-badge-purple' }; %>
                        <span class="sa-badge <%= planBadge[targetUser.membership?.plan] || 'sa-badge-gray' %>" style="font-size: 12px; padding: 5px 14px;">
                            <%= (targetUser.membership?.plan || 'free').toUpperCase() %>
                        </span>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 4px;">Expire le</div>
                        <div style="font-size: 13px; font-weight: 600; color: #334155;">
                            <%= targetUser.membership?.expiresAt ? new Date(targetUser.membership.expiresAt).toLocaleDateString('fr-FR') : '—' %>
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 4px;">Max. comptes</div>
                        <div style="font-size: 13px; font-weight: 600; color: #334155;"><%= targetUser.membership?.maxAccounts || 1 %></div>
                    </div>
                    <div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 4px;">Max. users/compte</div>
                        <div style="font-size: 13px; font-weight: 600; color: #334155;"><%= targetUser.membership?.maxUsersPerAccount || 3 %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="sa-panel" style="margin-bottom: 20px;">
        <div class="sa-panel-header">
            <div style="font-size: 15px; font-weight: 700; color: #0f172a;">
                <iconify-icon icon="solar:settings-bold-duotone" width="18" style="color: #4361ee; margin-right: 6px; vertical-align: -3px;"></iconify-icon>
                Actions rapides
            </div>
        </div>
        <div class="sa-panel-body" style="display: flex; gap: 12px; flex-wrap: wrap;">
            <!-- Change Role -->
            <div style="display: flex; align-items: center; gap: 8px;">
                <label style="font-size: 13px; font-weight: 600; color: #334155;">Rôle :</label>
                <select id="userRole" class="sa-select" style="min-width: 140px;">
                    <option value="user" <%= targetUser.role === 'user' ? 'selected' : '' %>>Utilisateur</option>
                    <option value="admin" <%= targetUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
                    <option value="superadmin" <%= targetUser.role === 'superadmin' ? 'selected' : '' %>>SuperAdmin</option>
                </select>
                <button onclick="updateRole()" class="sa-btn sa-btn-outline sa-btn-sm">Appliquer</button>
            </div>
            <div style="width: 1px; background: #e2e8f0; margin: 0 8px;"></div>
            <!-- Change Plan -->
            <div style="display: flex; align-items: center; gap: 8px;">
                <label style="font-size: 13px; font-weight: 600; color: #334155;">Plan :</label>
                <select id="userPlan" class="sa-select" style="min-width: 140px;">
                    <option value="free" <%= (targetUser.membership?.plan || 'free') === 'free' ? 'selected' : '' %>>Free</option>
                    <option value="basic" <%= targetUser.membership?.plan === 'basic' ? 'selected' : '' %>>Basic</option>
                    <option value="premium" <%= targetUser.membership?.plan === 'premium' ? 'selected' : '' %>>Premium</option>
                    <option value="enterprise" <%= targetUser.membership?.plan === 'enterprise' ? 'selected' : '' %>>Enterprise</option>
                </select>
                <button onclick="updatePlan()" class="sa-btn sa-btn-outline sa-btn-sm">Appliquer</button>
            </div>
            <div style="width: 1px; background: #e2e8f0; margin: 0 8px;"></div>
            <!-- Status Toggle -->
            <% if (targetUser.status === 'active') { %>
                <button onclick="updateStatus('suspended')" class="sa-btn sa-btn-danger sa-btn-sm">
                    <iconify-icon icon="solar:shield-cross-bold" width="14"></iconify-icon>
                    Suspendre
                </button>
            <% } else { %>
                <button onclick="updateStatus('active')" class="sa-btn sa-btn-sm" style="background: #dcfce7; color: #16a34a;">
                    <iconify-icon icon="solar:shield-check-bold" width="14"></iconify-icon>
                    Activer
                </button>
            <% } %>
            <!-- Delete -->
            <button onclick="deleteUser()" class="sa-btn sa-btn-danger sa-btn-sm" style="margin-left: auto;">
                <iconify-icon icon="solar:trash-bin-trash-bold" width="14"></iconify-icon>
                Supprimer
            </button>
        </div>
    </div>

    <!-- Workspaces -->
    <div class="sa-panel">
        <div class="sa-panel-header">
            <div style="font-size: 15px; font-weight: 700; color: #0f172a;">
                <iconify-icon icon="solar:buildings-bold-duotone" width="18" style="color: #0891b2; margin-right: 6px; vertical-align: -3px;"></iconify-icon>
                Workspaces (<%= userAccounts.length %>)
            </div>
        </div>
        <% if (userAccounts.length === 0) { %>
        <div class="sa-panel-body" style="text-align: center; padding: 40px;">
            <iconify-icon icon="solar:buildings-3-bold-duotone" width="48" style="color: #cbd5e1;"></iconify-icon>
            <p style="color: #94a3b8; margin-top: 8px;">Aucun workspace</p>
        </div>
        <% } else { %>
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Workspace</th>
                    <th>N° compte</th>
                    <th>Rôle</th>
                    <th>Membres</th>
                    <th>Statut</th>
                    <th>Créé le</th>
                </tr>
            </thead>
            <tbody>
                <% userAccounts.forEach(acc => {
                    const userEntry = targetUser.accounts.find(a => a.account_number === acc.account_number);
                %>
                <tr>
                    <td>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <div class="sa-avatar" style="background: rgba(8,145,178,0.1); color: #0891b2;">
                                <iconify-icon icon="<%= acc.icon || 'solar:home-2-bold-duotone' %>" width="18"></iconify-icon>
                            </div>
                            <span style="font-weight: 600; color: #0f172a;"><%= acc.name %></span>
                        </div>
                    </td>
                    <td style="font-family: monospace; color: #64748b;"><%= acc.account_number %></td>
                    <td>
                        <% const roleBadge = { owner: 'sa-badge-purple', admin: 'sa-badge-cyan', member: 'sa-badge-gray', viewer: 'sa-badge-gray' }; %>
                        <span class="sa-badge <%= roleBadge[userEntry?.role] || 'sa-badge-gray' %>"><%= userEntry?.role || 'member' %></span>
                    </td>
                    <td style="text-align: center; font-weight: 600;"><%= acc.users?.filter(u => u.status === 'active').length || 0 %></td>
                    <td>
                        <span class="sa-badge <%= acc.status === 'active' ? 'sa-badge-green' : 'sa-badge-gray' %>"><%= acc.status %></span>
                    </td>
                    <td style="font-size: 12px; color: #94a3b8;">
                        <%= new Date(acc.created_on).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <% } %>
    </div>
</div>

<script>
const userId = '<%= targetUser._id %>';

async function apiCall(endpoint, body) {
    const res = await fetch('/superadmin/api/' + endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(body)
    });
    return res.json();
}

async function updateRole() {
    const data = await apiCall('users/role', { userId, role: document.getElementById('userRole').value });
    if (data.success) location.reload();
    else alert(data.error || 'Error');
}

async function updatePlan() {
    const data = await apiCall('users/membership', { userId, plan: document.getElementById('userPlan').value });
    if (data.success) location.reload();
    else alert(data.error || 'Error');
}

async function updateStatus(status) {
    if (!confirm('Confirmer ?')) return;
    const data = await apiCall('users/status', { userId, status });
    if (data.success) location.reload();
    else alert(data.error || 'Error');
}

async function deleteUser() {
    if (!confirm('Supprimer cet utilisateur ? Cette action est irréversible.')) return;
    const data = await apiCall('users/delete', { userId });
    if (data.success) window.location.href = '/superadmin/users';
    else alert(data.error || 'Error');
}
</script>
