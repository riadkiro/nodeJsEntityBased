<%# ═══ Notion-style Multi-Select Tag Picker ═══ %>
<%# Usage: x-data="tagPicker({ classificationId, recordId, accountNumber, allowMultiple, options, selectedIds })" %>

<style>
/* ═══ Tag Picker Component ═══ */
.tp-wrapper {
    position: relative;
}

/* ── Trigger (inline tag display) ── */
.tp-trigger {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
    min-height: 32px;
    padding: 3px 8px;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    cursor: pointer;
    background: #fff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.tp-trigger:hover {
    border-color: #c7d2fe;
}
.tp-trigger--active {
    border-color: #4361ee;
    box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.1);
}
.dark .tp-trigger {
    background: #1b2e4b;
    border-color: #334155;
}
.dark .tp-trigger:hover {
    border-color: #4361ee;
}

/* ── Tag pill (inside trigger) ── */
.tp-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    line-height: 20px;
    white-space: nowrap;
    user-select: none;
    transition: filter 0.15s ease;
}
.tp-tag:hover {
    filter: brightness(0.92);
}
.tp-tag-remove {
    display: flex;
    align-items: center;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.15s ease;
    color: inherit;
}
.tp-tag-remove:hover {
    opacity: 1;
}

/* ── Placeholder ── */
.tp-placeholder {
    font-size: 12px;
    color: #9ca3af;
    line-height: 20px;
}

/* ── Dropdown ── */
.tp-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    min-width: 240px;
    max-width: 320px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.06);
    z-index: 999;
    overflow: hidden;
}
.dark .tp-dropdown {
    background: #0e1726;
    border-color: #334155;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
}

/* ── Selected tags strip (inside dropdown) ── */
.tp-selected-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 8px 10px 4px;
    border-bottom: 1px solid #f3f4f6;
}
.dark .tp-selected-strip {
    border-bottom-color: #1e293b;
}

/* ── Search input ── */
.tp-search-wrap {
    padding: 6px 10px;
}
.tp-search-input {
    width: 100%;
    padding: 6px 10px;
    border: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    font-size: 13px;
    color: #1f2937;
    background: transparent;
}
.tp-search-input:focus,
.tp-search-input:focus-visible {
    border-color: transparent !important;
    outline: none !important;
    box-shadow: none !important;
}
.tp-search-input::placeholder {
    color: #9ca3af;
}
.dark .tp-search-input {
    color: #e2e8f0;
}
.dark .tp-search-input::placeholder {
    color: #64748b;
}

/* ── Options list ── */
.tp-options {
    max-height: 220px;
    overflow-y: auto;
    padding: 4px;
}
.tp-option {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.1s ease;
}
.tp-option:hover {
    background: #f3f4f6;
}
.dark .tp-option:hover {
    background: #1e293b;
}
.tp-option-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
}
.tp-option-label {
    flex: 1;
    font-size: 13px;
    font-weight: 500;
    color: #374151;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.dark .tp-option-label {
    color: #cbd5e1;
}
/* Delete button on options (hover-only) */
.tp-option-delete {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: #d1d5db;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, background 0.1s ease, color 0.1s ease;
    flex-shrink: 0;
}
.tp-option:hover .tp-option-delete {
    opacity: 1;
}
.tp-option-delete:hover {
    background: #fee2e2;
    color: #ef4444;
}
.dark .tp-option-delete:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
}
.tp-option-delete iconify-icon,
.tp-option-delete svg,
.tp-option-delete * {
    pointer-events: none;
}
/* Confirm state (first click → turns red, always visible) */
.tp-option-delete--confirm {
    opacity: 1 !important;
    background: #fee2e2 !important;
    color: #ef4444 !important;
    animation: tp-delete-pulse 0.8s ease-in-out infinite alternate;
}
.dark .tp-option-delete--confirm {
    background: rgba(239, 68, 68, 0.2) !important;
    color: #f87171 !important;
}
@keyframes tp-delete-pulse {
    from { transform: scale(1); }
    to { transform: scale(1.15); }
}
.tp-option-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    opacity: 1;
    transition: opacity 0.15s ease;
}
.tp-option:hover .tp-option-actions {
    opacity: 1;
}
.tp-option-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: #9ca3af;
    cursor: pointer;
    transition: background 0.1s ease, color 0.1s ease;
}
.tp-option-action-btn:hover {
    background: #e5e7eb;
    color: #4b5563;
}
.dark .tp-option-action-btn:hover {
    background: #334155;
    color: #cbd5e1;
}

/* ── Create option ── */
/* Context menu (same interaction model as the sidebar rail menu) */
.tp-context-menu {
    position: fixed;
    z-index: 99999;
    min-width: 208px;
    padding: 6px 0;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}
.dark .tp-context-menu {
    background: #1b2e4b;
    border-color: #374151;
}
.tp-context-menu button {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border: 0;
    background: transparent;
    color: #374151;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    transition: background .2s ease;
}
.dark .tp-context-menu button {
    color: #d1d5db;
}
.tp-context-menu button:hover {
    background: #f3f4f6;
}
.dark .tp-context-menu button:hover {
    background: #1f2937;
}
.tp-context-menu button.is-danger {
    color: #ef4444;
}
.tp-context-menu button.is-danger:hover,
.tp-context-menu button.is-confirming {
    background: #fef2f2;
}
.dark .tp-context-menu button.is-danger:hover,
.dark .tp-context-menu button.is-confirming {
    background: rgba(239, 68, 68, .15);
}

.tp-create-option {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-top: 1px solid #f3f4f6;
    cursor: pointer;
    transition: background 0.1s ease;
}
.tp-create-panel {
    border-top: 1px solid #f3f4f6;
    padding: 6px 10px 8px;
}
.dark .tp-create-panel {
    border-top-color: #1e293b;
}
.tp-create-panel .tp-create-option {
    border-top: 0;
    padding: 0 0 6px;
}
.tp-create-colors {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
}
.tp-create-color-dot {
    width: 19px;
    height: 19px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.15s ease, transform 0.1s ease;
}
.tp-create-color-dot:hover {
    transform: scale(1.12);
}
.tp-create-color-dot--active {
    border-color: #1f2937 !important;
    box-shadow: 0 0 0 1px #fff inset;
}
.dark .tp-create-color-dot--active {
    border-color: #fff !important;
    box-shadow: 0 0 0 1px #0e1726 inset;
}
.tp-create-option:hover {
    background: #f3f4f6;
}
.dark .tp-create-option {
    border-top-color: #1e293b;
}
.dark .tp-create-option:hover {
    background: #1e293b;
}
.tp-create-label {
    font-size: 12px;
    color: #6b7280;
}
.dark .tp-create-label {
    color: #94a3b8;
}
.tp-create-tag {
    display: inline-flex;
    align-items: center;
    padding: 1px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    line-height: 20px;
    background: #e0e7ff;
    color: #4338ca;
}

/* ── Edit popover ── */
.tp-edit-popover {
    position: fixed;
    width: 220px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    padding: 10px;
    z-index: 10000;
}
.dark .tp-edit-popover {
    background: #0e1726;
    border-color: #334155;
}

/* ── Color palette ── */
.tp-colors {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    margin-top: 8px;
}
.tp-color-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.15s ease, transform 0.1s ease;
}
.tp-color-dot:hover {
    transform: scale(1.15);
}
.tp-color-dot--active {
    border-color: #1f2937 !important;
    box-shadow: 0 0 0 1px #fff inset;
}
.dark .tp-color-dot--active {
    border-color: #fff !important;
    box-shadow: 0 0 0 1px #0e1726 inset;
}

/* ── Edit name input ── */
.tp-edit-input {
    width: 100%;
    padding: 5px 8px;
    font-size: 13px;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    outline: none;
    background: #fff;
    color: #1f2937;
    transition: border-color 0.15s ease;
}
.tp-edit-input:focus {
    border-color: #4361ee;
}
.dark .tp-edit-input {
    background: #1b2e4b;
    border-color: #334155;
    color: #e2e8f0;
}

/* ── Delete button ── */
.tp-delete-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: 6px 8px;
    margin-top: 8px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #ef4444;
    font-size: 12px;
    cursor: pointer;
    transition: background 0.1s ease;
}
.tp-delete-btn:hover {
    background: #fef2f2;
}
.dark .tp-delete-btn:hover {
    background: rgba(239, 68, 68, 0.1);
}

/* ── Divider ── */
.tp-divider {
    display: none;
}
.dark .tp-divider {
    background: transparent;
}
</style>

<script>
(function() {
    function registerTagPicker() {
        if (window.__tagPickerRegistered) return;
        window.__tagPickerRegistered = true;

    if (!window.__destroyAppContextMenu) {
        window.__destroyAppContextMenu = function() {
            if (window.__appContextMenuCloseHandler) {
                document.removeEventListener('click', window.__appContextMenuCloseHandler, true);
                document.removeEventListener('contextmenu', window.__appContextMenuCloseHandler, true);
                window.__appContextMenuCloseHandler = null;
            }
            if (window.__appContextMenuEl) {
                window.__appContextMenuEl.remove();
                window.__appContextMenuEl = null;
            }
        };
    }

    if (!window.__showAppContextMenu) {
        window.__showAppContextMenu = function(x, y, items) {
            window.__destroyAppContextMenu();

            const menu = document.createElement('div');
            menu.className = 'tp-context-menu';
            document.body.appendChild(menu);

            items.forEach(item => {
                const btn = document.createElement('button');
                btn.type = 'button';
                if (item.danger) btn.classList.add('is-danger');
                btn.innerHTML = `<iconify-icon icon="${item.icon}" width="18" style="color:${item.iconColor || 'inherit'}"></iconify-icon><span>${item.label}</span>`;
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (item.danger && item.confirm !== false) {
                        if (!btn._confirming) {
                            btn._confirming = true;
                            btn.classList.add('is-confirming');
                            btn.innerHTML = '<iconify-icon icon="solar:danger-triangle-bold-duotone" width="18" style="color:#ef4444"></iconify-icon><span>Confirmer ?</span>';
                            btn._resetTimer = setTimeout(() => {
                                btn._confirming = false;
                                btn.classList.remove('is-confirming');
                                btn.innerHTML = `<iconify-icon icon="${item.icon}" width="18" style="color:${item.iconColor || 'inherit'}"></iconify-icon><span>${item.label}</span>`;
                            }, 3000);
                            return;
                        }
                        clearTimeout(btn._resetTimer);
                    }
                    window.__destroyAppContextMenu();
                    item.action();
                });
                menu.appendChild(btn);
            });

            const width = menu.offsetWidth || 208;
            const height = menu.offsetHeight || 48;
            menu.style.left = Math.max(8, Math.min(x || 8, window.innerWidth - width - 8)) + 'px';
            menu.style.top = Math.max(8, Math.min(y || 8, window.innerHeight - height - 8)) + 'px';
            window.__appContextMenuEl = menu;

            const closeHandler = (evt) => {
                if (!menu.contains(evt.target)) window.__destroyAppContextMenu();
            };
            window.__appContextMenuCloseHandler = closeHandler;
            setTimeout(() => {
                document.addEventListener('click', closeHandler, true);
                document.addEventListener('contextmenu', closeHandler, true);
            }, 0);
        };
    }

    const TAG_COLORS = [
        // Row 1 — pastel
        { bg: '#f3e8ff', text: '#7c3aed' },    // violet
        { bg: '#fce7f3', text: '#db2777' },    // pink
        { bg: '#ffe4e6', text: '#e11d48' },    // rose
        { bg: '#ffedd5', text: '#ea580c' },    // orange
        { bg: '#fef9c3', text: '#ca8a04' },    // yellow
        { bg: '#dcfce7', text: '#16a34a' },    // green
        { bg: '#dbeafe', text: '#2563eb' },    // blue
        // Row 2 — medium
        { bg: '#c4b5fd', text: '#5b21b6' },    // deep violet
        { bg: '#f9a8d4', text: '#be185d' },    // deep pink
        { bg: '#fca5a5', text: '#b91c1c' },    // deep rose
        { bg: '#fdba74', text: '#c2410c' },    // deep orange
        { bg: '#fde047', text: '#a16207' },    // deep yellow
        { bg: '#86efac', text: '#15803d' },    // deep green
        { bg: '#93c5fd', text: '#1d4ed8' },    // deep blue
        // Row 3 — bold
        { bg: '#7c3aed', text: '#ffffff' },    // bold violet
        { bg: '#db2777', text: '#ffffff' },    // bold pink
        { bg: '#e11d48', text: '#ffffff' },    // bold rose
        { bg: '#ea580c', text: '#ffffff' },    // bold orange
        { bg: '#f3f4f6', text: '#374151' },    // neutral gray
        { bg: '#e5e7eb', text: '#1f2937' },    // dark gray
    ];

    Alpine.data('tagPicker', (config) => ({
        // Config
        classificationId: config.classificationId || '',
        recordId: config.recordId || '',
        accountNumber: config.accountNumber || '',
        allowMultiple: config.allowMultiple !== false,
        saveOnSelection: !!config.saveOnSelection,
        fieldName: config.fieldName || '',

        // State
        options: [],         // [{_id, label, color, bg, text}]
        selectedIds: [],     // [optionId, ...]
        isOpen: false,
        searchQuery: '',
        editingOption: null, // {_id, label, color} — currently editing
        editLabel: '',
        editColorIdx: -1,
        newColorIdx: 0,
        _editPopoverPos: null, // { top, left } for fixed positioning
        deleteConfirmId: null,

        // Computed (plain props — getters are not reliably reactive in Alpine)
        selectedOptions: [],
        filteredOptions: [],
        canCreate: false,

        // Colors
        tagColors: TAG_COLORS,

        init() {
            // Parse initial options
            this.options = (config.options || []).map(o => ({
                _id: String(o._id || o.id || ''),
                label: String(o.label || o.name || o.title || o.value || '').trim(),
                color: o.color, // Preserve original vibrant color for header display
                ...this.resolveColor(o.color)
            })).filter(o => o._id && o.label);
            this.selectedIds = [...(config.selectedIds || [])].map(String);

            // Initial computation
            this._recompute();

                        this._instanceId = Math.random();
            this._syncing = false; // Guard flag to prevent infinite sync loops

            // Re-compute whenever selectedIds or options change
            this.$watch('selectedIds', (val) => {
                this._recompute();
                // Only dispatch sync/save if this change was NOT from a sync event
                if (!this._syncing) {
                    if (config.saveOnSelection && typeof config.onSave === 'function') {
                        config.onSave(val);
                    }
                    // Global sync with other components managing the same classification
                    window.dispatchEvent(new CustomEvent('cls-sync-' + config.classificationId, {
                        detail: { senderId: this._instanceId, ids: val }
                    }));
                }
            });
            this.$watch('options', () => this._recompute());
            this.$watch('searchQuery', () => this._recompute());

            // Global listener for cross-instance synchronization
            window.addEventListener('cls-sync-' + config.classificationId, (e) => {
                if (e.detail.senderId !== this._instanceId) {
                    this._syncing = true;
                    this.selectedIds = [...e.detail.ids];
                    this.$nextTick(() => { this._syncing = false; });
                }
            });

            // Close on outside click
            this.$watch('isOpen', (val) => {
                if (val) {
                    this.$nextTick(() => {
                        const input = this.$refs.searchInput;
                        if (input) input.focus();
                    });
                } else {
                    this.searchQuery = '';
                    this.editingOption = null;
                    this.deleteConfirmId = null;
                }
            });
        },

        // ── Recompute all derived values ──
        normalizeLabel(value) {
            return String(value || '')
                .normalize('NFKD')
                .replace(/[\u0300-\u036f\u0610-\u061a\u0640\u064b-\u065f\u0670\u06d6-\u06ed\u200c-\u200f\u202a-\u202e]/g, '')
                .replace(/\s+/g, ' ')
                .trim()
                .toLowerCase();
        },

        _recompute() {
            this.selectedOptions = this.selectedIds
                .map(id => this.options.find(o => String(o._id) === String(id)))
                .filter(Boolean);

            const q = this.normalizeLabel(this.searchQuery);
            this.filteredOptions = q
                ? this.options.filter(o => this.normalizeLabel(o.label).includes(q))
                : this.options.slice();

            const sq = this.searchQuery.trim();
            this.canCreate = sq.length > 0 &&
                !this.options.some(o => this.normalizeLabel(o.label) === this.normalizeLabel(sq));
        },

        // ── Color resolution ──
        resolveColor(colorStr) {
            if (!colorStr) return { bg: '#f3f4f6', text: '#374151' };
            // Check if it's an index into TAG_COLORS
            const idx = TAG_COLORS.findIndex(c => c.bg === colorStr);
            if (idx >= 0) return TAG_COLORS[idx];
            // Default: use as bg, determine text
            return { bg: colorStr, text: this.isLight(colorStr) ? '#374151' : '#ffffff' };
        },

        isLight(hex) {
            if (!hex || hex.length < 7) return true;
            const r = parseInt(hex.slice(1, 3), 16);
            const g = parseInt(hex.slice(3, 5), 16);
            const b = parseInt(hex.slice(5, 7), 16);
            return (r * 299 + g * 587 + b * 114) / 1000 > 155;
        },

        // ── Toggle ──
        toggleOpen() {
            window.__destroyAppContextMenu?.();
            this.isOpen = !this.isOpen;
        },

        toggleDropdown() {
            window.__destroyAppContextMenu?.();
            this.isOpen = !this.isOpen;
        },

        toggleOption(optId) {
            window.__destroyAppContextMenu?.();
            const id = String(optId || '');
            const idx = this.selectedIds.indexOf(id);
            if (idx >= 0) {
                this.selectedIds.splice(idx, 1);
            } else {
                if (!this.allowMultiple) {
                    this.selectedIds = [id];
                    this.isOpen = false; // Auto-close on single select
                } else {
                    this.selectedIds.push(id);
                }
            }
            if (this.saveOnSelection) this.saveToRecord();
        },

        removeTag(optId) {
            const idx = this.selectedIds.indexOf(String(optId || ''));
            if (idx >= 0) {
                this.selectedIds.splice(idx, 1);
                if (this.saveOnSelection) this.saveToRecord();
            }
        },

        isSelected(optId) {
            return this.selectedIds.includes(String(optId || ''));
        },

        // ── Create new option ──
        async createOption() {
            const label = this.searchQuery.trim();
            if (!label) return;

            try {
                const res = await fetch(`/account/${this.accountNumber}/classification/api/fast-add`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        classificationId: this.classificationId,
                        label,
                        color: TAG_COLORS[this.newColorIdx]?.bg || '#4361ee'
                    })
                });
                const data = await res.json();
                if (data.success && data.option) {
                    const newOpt = {
                        _id: String(data.option._id || data.option.id || ''),
                        label: String(data.option.label || label).trim(),
                        color: data.option.color,
                        ...this.resolveColor(data.option.color)
                    };
                    if (!this.options.some(o => String(o._id) === newOpt._id || this.normalizeLabel(o.label) === this.normalizeLabel(newOpt.label))) {
                        this.options.push(newOpt);
                    }
                    
                    if (!this.allowMultiple) {
                        this.selectedIds = [newOpt._id];
                        this.isOpen = false;
                    } else {
                        if (!this.selectedIds.includes(newOpt._id)) this.selectedIds.push(newOpt._id);
                    }
                    
                    this.searchQuery = '';
                    this.newColorIdx = 0;
                    if (this.saveOnSelection) this.saveToRecord();
                }
            } catch (err) {
                console.error('[TagPicker] Create error:', err);
            }
        },

        selectCreateColor(idx) {
            this.newColorIdx = idx;
        },

        // ── Edit option ──
        startEdit(opt, event) {
            if (event) event.stopPropagation();
            this.editingOption = { ...opt, _id: String(opt._id || '') };
            this.editLabel = opt.label;
            const idx = TAG_COLORS.findIndex(c => c.bg === opt.bg);
            this.editColorIdx = idx >= 0 ? idx : -1;

            // Calculate fixed position from the edit button
            if (event) {
                const btn = event.currentTarget || event.target;
                const dropdown = btn.closest('.tp-dropdown');
                if (dropdown) {
                    const dropdownRect = dropdown.getBoundingClientRect();
                    const btnRect = btn.getBoundingClientRect();
                    this._editPopoverPos = {
                        top: btnRect.top,
                        left: dropdownRect.right + 6
                    };
                }
            }
        },

        async saveEdit() {
            if (!this.editingOption) return;
            const optId = this.editingOption._id;
            const newLabel = this.editLabel.trim();
            const newColor = this.editColorIdx >= 0 ? TAG_COLORS[this.editColorIdx].bg : this.editingOption.bg;

            if (!newLabel) return;

            try {
                await fetch(`/account/${this.accountNumber}/classification/api/update-option`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        classificationId: this.classificationId,
                        optionId: optId,
                        label: newLabel,
                        color: newColor
                    })
                });

                // Update local
                const opt = this.options.find(o => String(o._id) === String(optId));
                if (opt) {
                    opt.label = newLabel;
                    opt.color = newColor;
                    const resolved = this.resolveColor(newColor);
                    opt.bg = resolved.bg;
                    opt.text = resolved.text;
                }
                this._recompute();
                this.editingOption = null;
            } catch (err) {
                console.error('[TagPicker] Update error:', err);
            }
        },

        confirmDelete(optId) {
            const id = String(optId || '');
            if (this.deleteConfirmId === id) {
                this.deleteOption(id);
                this.deleteConfirmId = null;
            } else {
                this.deleteConfirmId = id;
                // Reset after 3 seconds if not confirmed
                setTimeout(() => {
                    if (this.deleteConfirmId === id) this.deleteConfirmId = null;
                }, 3000);
            }
        },

        openOptionContextMenu(event, optId) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            const id = String(optId || '');
            const opt = this.options.find(o => String(o._id) === id);
            if (!opt) return;

            const items = [];
            if (this.isSelected(id)) {
                items.push({
                    icon: 'solar:close-circle-linear',
                    label: 'Retirer de cette fiche',
                    action: () => this.removeTag(id)
                });
            }
            items.push({
                icon: 'solar:pen-2-linear',
                label: 'Modifier',
                action: () => this.startEdit(opt, event)
            });
            items.push({
                icon: 'solar:trash-bin-trash-bold-duotone',
                iconColor: '#ef4444',
                label: 'Supprimer le choix',
                danger: true,
                action: () => this.deleteOption(id)
            });

            window.__showAppContextMenu?.(event?.clientX || 0, event?.clientY || 0, items);
        },

        async deleteOption(optId) {
            const idToDelete = String(optId || (this.editingOption ? this.editingOption._id : '') || '');
            if (!idToDelete) return;

            try {
                await fetch(`/account/${this.accountNumber}/classification/api/delete-option`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        classificationId: this.classificationId,
                        optionId: idToDelete
                    })
                });

                // Remove from local
                this.options = this.options.filter(o => String(o._id) !== idToDelete);
                this.selectedIds = this.selectedIds.filter(id => String(id) !== idToDelete);
                if (this.editingOption && String(this.editingOption._id) === idToDelete) {
                    this.editingOption = null;
                }
                window.__destroyAppContextMenu?.();
                if (this.saveOnSelection) this.saveToRecord();
            } catch (err) {
                console.error('[TagPicker] Delete error:', err);
            }
        },

        selectColor(idx) {
            this.editColorIdx = idx;
            // Auto-save color change
            if (this.editingOption) {
                const newColor = TAG_COLORS[idx].bg;
                const optId = this.editingOption._id;
                this.editingOption.bg = TAG_COLORS[idx].bg;
                this.editingOption.text = TAG_COLORS[idx].text;

                // Update local immediately
                const opt = this.options.find(o => String(o._id) === String(optId));
                if (opt) {
                    opt.bg = TAG_COLORS[idx].bg;
                    opt.text = TAG_COLORS[idx].text;
                    opt.color = newColor;
                }

                // Save to server
                fetch(`/account/${this.accountNumber}/classification/api/update-option`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        classificationId: this.classificationId,
                        optionId: optId,
                        color: newColor
                    })
                }).catch(err => console.error('[TagPicker] Color save error:', err));
            }
        },

        // ── Save selected tags to record ──
        async saveToRecord() {
            if (!this.recordId) return;
            try {
                // For multi-select, send all selected option IDs
                await fetch(`/account/${this.accountNumber}/api/record/update-classification`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        recordId: this.recordId,
                        classificationId: this.classificationId,
                        optionIds: this.selectedIds,
                        allowMultiple: this.allowMultiple
                    })
                });
            } catch (err) {
                console.error('[TagPicker] Save error:', err);
            }
        },

        // ── Close handlers ──
        closeDropdown() {
            this.isOpen = false;
            window.__destroyAppContextMenu?.();
        }
    }));
    }

    // Resilient registration: works whether Alpine has initialized or not
    if (window.Alpine) {
        registerTagPicker();
    } else {
        document.addEventListener('alpine:init', registerTagPicker);
    }
})();
</script>
