document.addEventListener('alpine:init', () => {
    Alpine.data('mailbox', () => ({
        // ===== STATE =====
        defaultParams: {
            id: null,
            from: 'vristo@mail.com',
            to: '',
            cc: '',
            title: '',
            file: null,
            description: '',
            attachments: [],
        },
        quillEditor: null,
        isShowMailMenu: false,
        isEdit: false,
        selectedTab: 'inbox',
        filteredMailList: [],
        ids: [],
        searchText: '',
        selectedMail: null,
        params: null,
        mailList: [],
        activeGroupFilter: '', // For label filter chips at top
        // Base URL for API calls
        apiBase: '',
        accountBase: '', // e.g. /account/5001
        // Pagination
        pager: {
            currentPage: 1,
            totalPages: 0,
            pageSize: 10,
            startIndex: 0,
            endIndex: 0,
        },
        // Templates
        showTemplates: false,
        templates: [
            { name: 'Welcome Email', subject: 'Welcome to our platform!', body: '<p>Dear User,</p><p>Welcome to our platform! We are excited to have you on board.</p><p>Best regards,<br>The Team</p>' },
            { name: 'Follow Up', subject: 'Following up on our conversation', body: '<p>Hi,</p><p>I wanted to follow up on our recent conversation. Please let me know if you have any questions.</p><p>Best regards</p>' },
            { name: 'Meeting Request', subject: 'Meeting Request', body: '<p>Hi,</p><p>I would like to schedule a meeting to discuss our upcoming project. Please let me know your availability.</p><p>Thank you</p>' },
        ],
        editingTemplate: null,
        // Signatures
        showSignature: false,
        signatures: [
            { name: 'Professional', content: '<p style="margin:0"><strong>Best regards,</strong></p><p style="margin:0;color:#666">Your Name | Company Inc.</p><p style="margin:0;color:#999;font-size:12px">Phone: +1 234 567 890 | Web: example.com</p>', isDefault: true },
        ],
        editingSignature: null,
        selectedSignatureIdx: -1,
        // Mail Accounts
        mailAccounts: [],
        showAccountModal: false,
        editingAccount: { name: '', email: '', color: '#4361ee', imap: { host: '', port: 993, user: '', password: '', tls: true }, smtp: { host: '', port: 587, user: '', password: '' } },
        accountTesting: false,
        selectedAccountId: null, // Currently viewed account
        syncing: false, // Is currently syncing
        syncInterval: null, // Auto-sync interval ref
        // View settings
        mailDensity: 'compact', // 'compact' or 'normal'

        // ===== INIT =====
        init() {
            this.params = { ...this.defaultParams };

            // Determine API base from current URL
            const pathParts = window.location.pathname.split('/');
            const accountIdx = pathParts.indexOf('account');
            if (accountIdx >= 0 && pathParts[accountIdx + 1]) {
                this.accountBase = '/account/' + pathParts[accountIdx + 1];
                this.apiBase = this.accountBase + '/mailbox/api';
            }

            // Load mail accounts from server data
            this.mailAccounts = <%- JSON.stringify(mailAccounts || []).replace(/<\//g, '<\\/') %>;
            this.selectedAccountId = '<%= selectedAccountId || "" %>' || null;

            // Load mails from server
            const initialMails = <%- JSON.stringify(initialMails || []).replace(/<\//g, '<\\/') %>;
            this.mailList = initialMails.map((m, i) => ({
                ...m,
                id: m.id || i + 1,
                isStar: m.isStar || false,
                isImportant: m.isImportant || false,
                isUnread: m.isUnread !== undefined ? m.isUnread : false,
                group: m.group || '',
                type: m.type || 'inbox',
                attachments: m.attachments || [],
                displayDescription: m.displayDescription || m.description?.replace(/<[^>]*>/g, '').substring(0, 100) || '',
            }));

            // Load user preferences from server
            this.loadMailPreferences();

            this.searchMails();

            // Init Quill (delay to ensure DOM ready)
            this.$nextTick(() => {
                const editorEl = document.getElementById('editor');
                if (editorEl && typeof Quill !== 'undefined') {
                    this.quillEditor = new Quill('#editor', {
                        theme: 'snow',
                        modules: {
                            toolbar: [
                                [{ header: [1, 2, 3, false] }],
                                ['bold', 'italic', 'underline', 'strike'],
                                [{ list: 'ordered' }, { list: 'bullet' }],
                                ['link', 'blockquote', 'code-block'],
                                [{ color: [] }, { background: [] }],
                                ['clean'],
                            ],
                        },
                    });
                    this.quillEditor.on('text-change', () => {
                        this.params.description = this.quillEditor.root.innerHTML;
                    });
                }
            });

            // Auto-sync on page load if there's an active account
            if (this.activeAccount) {
                this.syncMails();
            }

            // Auto-sync every 60 seconds
            this.syncInterval = setInterval(() => {
                if (this.activeAccount && !this.syncing) {
                    this.syncMails(true); // silent = true (no spinner for background sync)
                }
            }, 60000);
        },

        destroy() {
            if (this.syncInterval) clearInterval(this.syncInterval);
        },

        // ===== COMPUTED =====
        get pagedMails() {
            const start = this.pager.startIndex;
            const end = this.pager.endIndex + 1;
            return this.filteredMailList.slice(start, end);
        },

        get activeAccount() {
            if (this.selectedAccountId) {
                return this.mailAccounts.find(a => a._id === this.selectedAccountId) || this.mailAccounts.find(a => a.isDefault) || this.mailAccounts[0] || null;
            }
            return this.mailAccounts.find(a => a.isDefault) || this.mailAccounts[0] || null;
        },

        get otherAccounts() {
            const activeId = this.activeAccount?._id;
            return this.mailAccounts.filter(a => a._id !== activeId);
        },

        // ===== LABEL FILTER CHIPS =====
        toggleGroupFilter(group) {
            if (this.activeGroupFilter === group) {
                this.activeGroupFilter = '';
            } else {
                this.activeGroupFilter = group;
            }
            this.searchMails();
        },

        // ===== MAIL ACTIONS =====
        refreshMails() {
            this.searchMails();
            this.showMessage('Mail refreshed');
        },

        searchMails(resetPage = true) {
            if (resetPage) {
                this.pager.currentPage = 1;
            }

            let res = this.mailList.filter((d) => {
                // Tab filter
                if (this.selectedTab === 'star') return d.isStar;
                if (this.selectedTab === 'important') return d.isImportant;
                return d.type === this.selectedTab;
            });

            // Group filter (label chips at top)
            if (this.activeGroupFilter) {
                res = res.filter((d) => d.group === this.activeGroupFilter);
            }

            // Search filter
            if (this.searchText) {
                const txt = this.searchText.toLowerCase();
                res = res.filter((d) =>
                    (d.firstName && d.firstName.toLowerCase().includes(txt)) ||
                    (d.lastName && d.lastName.toLowerCase().includes(txt)) ||
                    (d.email && d.email.toLowerCase().includes(txt)) ||
                    (d.title && d.title.toLowerCase().includes(txt)) ||
                    (d.displayDescription && d.displayDescription.toLowerCase().includes(txt))
                );
            }

            this.filteredMailList = res;

            // Pagination
            if (this.filteredMailList.length) {
                this.pager.totalPages = Math.ceil(this.filteredMailList.length / this.pager.pageSize) || 1;
                if (this.pager.currentPage > this.pager.totalPages) this.pager.currentPage = 1;
                this.pager.startIndex = (this.pager.currentPage - 1) * this.pager.pageSize;
                this.pager.endIndex = Math.min(this.pager.startIndex + this.pager.pageSize - 1, this.filteredMailList.length - 1);
            } else {
                this.pager.startIndex = -1;
                this.pager.endIndex = -1;
                this.pager.totalPages = 0;
            }
            this.ids = [];
        },

        tabChanged(tab) {
            this.selectedTab = tab;
            this.selectedMail = null;
            this.isEdit = false;
            this.showTemplates = false;
            this.showSignature = false;
            this.searchText = '';
            this.activeGroupFilter = '';
            this.searchMails();
            this.isShowMailMenu = false;
            this._clearEmailContext();
        },

        selectMail(mail) {
            if (mail) {
                mail.isUnread = false;
                this.selectedMail = mail;
                this.isEdit = false;
                this.showTemplates = false;
                this.showSignature = false;
                this.isShowMailMenu = false;
                // Persist read status
                this._apiCall('/read-status', { ids: [mail.id], isUnread: false });

                // ── Auto-notify AI assistant of email context ──
                this._dispatchEmailContext(mail);
            }
        },

        // ── Dispatch email context to AI assistant (smart detection) ──
        _dispatchEmailContext(mail) {
            if (!mail) {
                window.dispatchEvent(new CustomEvent('ai-assistant:email-context-changed', {
                    detail: { emailContext: null }
                }));
                return;
            }
            const emailData = {
                id: mail.id || mail._id,
                from: ((mail.firstName || '') + ' ' + (mail.lastName || '')).trim(),
                fromEmail: mail.email,
                subject: mail.title,
                body: mail.description ? mail.description.replace(/<[^>]*>/g, '').substring(0, 3000) : '',
                date: mail.date,
                hasAttachments: (mail.attachments || []).length > 0
            };
            window.dispatchEvent(new CustomEvent('ai-assistant:email-context-changed', {
                detail: { emailContext: emailData }
            }));
        },

        // ── Clear email context when leaving mail detail ──
        _clearEmailContext() {
            window.dispatchEvent(new CustomEvent('ai-assistant:email-context-changed', {
                detail: { emailContext: null }
            }));
        },

        // ===== STAR (persisted) =====
        async setStar(id) {
            const mail = this.mailList.find((d) => d.id === id);
            if (mail) {
                mail.isStar = !mail.isStar;
                // Persist to DB
                this._apiCall('/star/' + id, null, 'POST');
            }
        },

        // ===== IMPORTANT (persisted) =====
        async setImportant(id) {
            const mail = this.mailList.find((d) => d.id === id);
            if (mail) {
                mail.isImportant = !mail.isImportant;
                // Persist to DB
                this._apiCall('/important/' + id, null, 'POST');
            }
        },

        // ===== ARCHIVE (persisted) =====
        setArchive() {
            if (!this.ids.length) { this.showMessage('Select at least one mail', 'error'); return; }
            this.ids.forEach((id) => {
                const mail = this.mailList.find((d) => d.id === id);
                if (mail) mail.type = 'archive';
            });
            this._apiCall('/type', { ids: this.ids, type: 'archive' });
            this.showMessage(this.ids.length + ' mail(s) archived');
            this.ids = [];
            this.searchMails();
        },

        // ===== SPAM (persisted) =====
        setSpam() {
            if (!this.ids.length) { this.showMessage('Select at least one mail', 'error'); return; }
            this.ids.forEach((id) => {
                const mail = this.mailList.find((d) => d.id === id);
                if (mail) mail.type = 'spam';
            });
            this._apiCall('/type', { ids: this.ids, type: 'spam' });
            this.showMessage(this.ids.length + ' mail(s) marked as spam');
            this.ids = [];
            this.searchMails();
        },

        // ===== GROUP / LABELS (persisted) =====
        setGroup(group) {
            if (!this.ids.length) { this.showMessage('Select at least one mail', 'error'); return; }
            this.ids.forEach((id) => {
                const mail = this.mailList.find((d) => d.id === id);
                if (mail) mail.group = group;
            });
            this._apiCall('/group', { ids: this.ids, group });
            this.showMessage(this.ids.length + ' mail(s) grouped as ' + group);
            this.ids = [];
            this.searchMails();
        },

        // ===== ACTIONS (persisted) =====
        setAction(action) {
            if (!this.ids.length) { this.showMessage('Select at least one mail', 'error'); return; }
            if (action === 'trash') {
                this.ids.forEach((id) => {
                    const mail = this.mailList.find((d) => d.id === id);
                    if (mail) mail.type = 'trash';
                });
                this._apiCall('/type', { ids: this.ids, type: 'trash' });
                this.showMessage(this.ids.length + ' mail(s) moved to trash');
            } else if (action === 'read') {
                this.ids.forEach((id) => {
                    const mail = this.mailList.find((d) => d.id === id);
                    if (mail) mail.isUnread = false;
                });
                this._apiCall('/read-status', { ids: this.ids, isUnread: false });
                this.showMessage(this.ids.length + ' mail(s) marked as read');
            } else if (action === 'unread') {
                this.ids.forEach((id) => {
                    const mail = this.mailList.find((d) => d.id === id);
                    if (mail) mail.isUnread = true;
                });
                this._apiCall('/read-status', { ids: this.ids, isUnread: true });
                this.showMessage(this.ids.length + ' mail(s) marked as unread');
            } else if (action === 'delete') {
                this._apiCall('/delete', { ids: this.ids });
                this.mailList = this.mailList.filter((d) => !this.ids.includes(d.id));
                this.showMessage(this.ids.length + ' mail(s) permanently deleted');
            } else if (action === 'restore') {
                this.ids.forEach((id) => {
                    const mail = this.mailList.find((d) => d.id === id);
                    if (mail) mail.type = 'inbox';
                });
                this._apiCall('/type', { ids: this.ids, type: 'inbox' });
                this.showMessage(this.ids.length + ' mail(s) restored');
            }
            this.ids = [];
            this.searchMails();
        },

        // ===== API HELPER =====
        async _apiCall(endpoint, body, method = 'POST') {
            try {
                await fetch(this.apiBase + endpoint, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: body ? JSON.stringify(body) : undefined,
                });
            } catch (e) {
                console.error('API call failed:', endpoint, e);
            }
        },

        // ===== CHECK ALL =====
        isAllChecked() {
            if (this.pagedMails.length && this.ids.length) {
                return this.pagedMails.every((d) => this.ids.includes(d.id));
            }
            return false;
        },

        checkAll(isChecked) {
            if (isChecked) {
                this.ids = this.pagedMails.map((d) => d.id);
            } else {
                this.ids = [];
            }
        },

        // ===== COMPOSE / REPLY / FORWARD =====
        openMail(type, mail) {
            this.isShowMailMenu = false;
            this.selectedMail = null;
            this.showTemplates = false;
            this.showSignature = false;
            this._clearEmailContext();

            if (type === 'add') {
                this.params = { ...this.defaultParams, attachments: [] };
            } else if (type === 'reply') {
                this.params = {
                    ...this.defaultParams,
                    to: mail.email,
                    title: 'Re: ' + mail.title,
                    description: '<br><br><blockquote style="border-left: 3px solid #ccc; padding-left: 10px; color: #666;">' + (mail.description || '') + '</blockquote>',
                    attachments: [],
                };
            } else if (type === 'forward') {
                this.params = {
                    ...this.defaultParams,
                    title: 'Fwd: ' + mail.title,
                    description: '<br><br>---------- Forwarded message ----------<br>' + (mail.description || ''),
                    attachments: mail.attachments ? [...mail.attachments] : [],
                };
            }

            this.isEdit = true;
            this.selectedSignatureIdx = -1;

            // Set Quill content
            this.$nextTick(() => {
                if (this.quillEditor) {
                    if (this.params.description) {
                        this.quillEditor.root.innerHTML = this.params.description;
                    } else {
                        this.quillEditor.setContents([]);
                    }
                }
            });
        },

        saveMail(type, id) {
            if (!this.params.to && type === 'send') {
                this.showMessage('Recipient is required', 'error');
                return;
            }
            if (!this.params.title) {
                this.showMessage('Subject is required', 'error');
                return;
            }

            const mail = {
                ...this.params,
                id: id || (this.mailList.length ? Math.max(...this.mailList.map(m => m.id)) + 1 : 1),
                firstName: 'Me',
                lastName: '',
                email: this.params.from,
                date: new Date().toLocaleDateString(),
                time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                type: type === 'draft' ? 'draft' : 'sent_mail',
                isUnread: false,
                isStar: false,
                isImportant: false,
                group: '',
                displayDescription: this.params.description?.replace(/<[^>]*>/g, '').substring(0, 100) || '',
            };

            if (id) {
                const idx = this.mailList.findIndex((d) => d.id === id);
                if (idx >= 0) this.mailList[idx] = mail;
            } else {
                this.mailList.unshift(mail);
            }

            this.showMessage(type === 'draft' ? 'Draft saved' : 'Mail sent successfully');
            this.closeMsgPopUp();
            this.searchMails();
        },

        closeMsgPopUp() {
            this.isEdit = false;
            this.params = { ...this.defaultParams, attachments: [] };
            if (this.quillEditor) this.quillEditor.setContents([]);
        },

        // ===== FILE HANDLING =====
        handleFiles(event) {
            const files = event.target.files;
            if (!this.params.attachments) this.params.attachments = [];
            for (const file of files) {
                this.params.attachments.push({
                    name: file.name,
                    size: (file.size / 1024).toFixed(1) + 'KB',
                    type: file.type.includes('image') ? 'image' : 'file',
                });
            }
        },

        // ===== TEMPLATES =====
        addTemplate() {
            this.editingTemplate = { name: '', subject: '', body: '' };
        },

        editTemplate(idx) {
            this.editingTemplate = { ...this.templates[idx], _idx: idx };
        },

        saveTemplate() {
            if (!this.editingTemplate.name) { this.showMessage('Template name is required', 'error'); return; }
            if (this.editingTemplate._idx !== undefined) {
                this.templates[this.editingTemplate._idx] = {
                    name: this.editingTemplate.name,
                    subject: this.editingTemplate.subject,
                    body: this.editingTemplate.body,
                };
            } else {
                this.templates.push({
                    name: this.editingTemplate.name,
                    subject: this.editingTemplate.subject,
                    body: this.editingTemplate.body,
                });
            }
            this.editingTemplate = null;
            this.showMessage('Template saved');
        },

        deleteTemplate(idx) {
            this.templates.splice(idx, 1);
            this.showMessage('Template deleted');
        },

        useTemplate(idx) {
            const tpl = this.templates[idx];
            this.params = {
                ...this.defaultParams,
                title: tpl.subject,
                description: tpl.body,
                attachments: [],
            };
            this.isEdit = true;
            this.showTemplates = false;
            this.selectedMail = null;
            this.$nextTick(() => {
                if (this.quillEditor) {
                    this.quillEditor.root.innerHTML = tpl.body;
                }
            });
        },

        applyTemplate(idx) {
            if (idx === '' || idx === undefined) return;
            const tpl = this.templates[parseInt(idx)];
            if (tpl) {
                this.params.title = tpl.subject;
                this.params.description = tpl.body;
                if (this.quillEditor) {
                    this.quillEditor.root.innerHTML = tpl.body;
                }
            }
        },

        // ===== SIGNATURES =====
        addSignature() {
            this.editingSignature = { name: '', content: '', isDefault: false };
        },

        editSignature(idx) {
            this.editingSignature = { ...this.signatures[idx], _idx: idx };
        },

        saveSignature() {
            if (!this.editingSignature.name) { this.showMessage('Signature name is required', 'error'); return; }
            if (this.editingSignature._idx !== undefined) {
                this.signatures[this.editingSignature._idx] = {
                    name: this.editingSignature.name,
                    content: this.editingSignature.content,
                    isDefault: this.editingSignature.isDefault || false,
                };
            } else {
                this.signatures.push({
                    name: this.editingSignature.name,
                    content: this.editingSignature.content,
                    isDefault: this.signatures.length === 0,
                });
            }
            this.editingSignature = null;
            this.showMessage('Signature saved');
        },

        deleteSignature(idx) {
            this.signatures.splice(idx, 1);
            this.showMessage('Signature deleted');
        },

        setDefaultSignature(idx) {
            this.signatures.forEach((s, i) => s.isDefault = (i === idx));
            this.showMessage('Default signature updated');
        },

        applySignature() {
            const idx = parseInt(this.selectedSignatureIdx);
            if (idx >= 0 && this.signatures[idx] && this.quillEditor) {
                const currentContent = this.quillEditor.root.innerHTML;
                // Remove old signatures (marked by sentinel)
                const cleaned = currentContent.replace(/<div class="email-signature">[\s\S]*<\/div>$/i, '');
                const sigHtml = '<br><div class="email-signature" style="border-top: 1px solid #ddd; margin-top: 20px; padding-top: 10px;">' + this.signatures[idx].content + '</div>';
                this.quillEditor.root.innerHTML = cleaned + sigHtml;
                this.params.description = this.quillEditor.root.innerHTML;
            }
        },

        // ===== UTILITIES =====
        showTime(mail) {
            if (!mail || !mail.date) return '';
            const d = mail.date instanceof Date ? mail.date : new Date(mail.date);
            const now = new Date();
            const isToday = d.toDateString() === now.toDateString();
            if (isToday) {
                return mail.time || d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            }
            return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) + (mail.time ? ', ' + mail.time : '');
        },

        showMessage(msg, type = 'success') {
            if (typeof Swal !== 'undefined') {
                const toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                });
                toast.fire({
                    icon: type,
                    title: msg,
                    padding: '10px 20px',
                });
            }
        },

        // ===== MAIL ACCOUNTS =====
        openAccountModal() {
            this.editingAccount = {
                name: '', email: '', color: '#4361ee',
                imap: { host: '', port: 993, user: '', password: '', tls: true },
                smtp: { host: '', port: 587, user: '', password: '' },
            };
            this.showAccountModal = true;
        },

        editAccount(acc) {
            this.editingAccount = {
                ...acc,
                imap: { host: '', port: 993, user: '', password: '', tls: true, ...(acc.imap || {}) },
                smtp: { host: '', port: 587, user: '', password: '', ...(acc.smtp || {}) },
            };
            this.showAccountModal = true;
        },

        async saveAccount() {
            const acc = this.editingAccount;
            if (!acc.name || !acc.email) {
                this.showMessage('Name and email are required', 'error');
                return;
            }
            if (!acc.imap.host || !acc.imap.user || !acc.imap.password) {
                this.showMessage('IMAP credentials are required', 'error');
                return;
            }

            try {
                let url = this.apiBase + '/accounts';
                let method = 'POST';
                if (acc._id) {
                    url += '/' + acc._id;
                    method = 'PUT';
                }

                const resp = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(acc),
                });
                const data = await resp.json();

                if (data.success) {
                    const isNew = !acc._id;
                    this.showMessage(isNew ? 'Account added' : 'Account updated');
                    this.showAccountModal = false;
                    // Refresh accounts list
                    await this.loadAccounts();
                    // Auto-sync after first config of a new account
                    if (isNew && data.account) {
                        this.selectedAccountId = data.account._id;
                        this.syncMails();
                    }
                } else {
                    this.showMessage(data.error || 'Failed to save account', 'error');
                }
            } catch (e) {
                console.error('saveAccount Error:', e);
                this.showMessage('Failed to save account', 'error');
            }
        },

        async deleteAccount() {
            if (!this.editingAccount._id) return;
            if (!confirm('Are you sure you want to delete this account?')) return;

            try {
                const resp = await fetch(this.apiBase + '/accounts/' + this.editingAccount._id, {
                    method: 'DELETE',
                    credentials: 'include',
                });
                const data = await resp.json();
                if (data.success) {
                    this.showMessage('Account deleted');
                    this.showAccountModal = false;
                    await this.loadAccounts();
                }
            } catch (e) {
                console.error('deleteAccount Error:', e);
                this.showMessage('Failed to delete account', 'error');
            }
        },

        async testAccountConnection() {
            const imap = this.editingAccount.imap;
            if (!imap.host || !imap.user || !imap.password) {
                this.showMessage('Fill in IMAP credentials first', 'error');
                return;
            }
            this.accountTesting = true;
            try {
                const resp = await fetch(this.apiBase + '/accounts/test-connection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(imap),
                });
                const data = await resp.json();
                if (data.success) {
                    this.showMessage('Connection successful!');
                } else {
                    this.showMessage(data.error || 'Connection failed', 'error');
                }
            } catch (e) {
                this.showMessage('Connection failed: ' + e.message, 'error');
            } finally {
                this.accountTesting = false;
            }
        },

        async loadAccounts() {
            try {
                const resp = await fetch(this.apiBase + '/accounts', { credentials: 'include' });
                const data = await resp.json();
                if (data.success) {
                    this.mailAccounts = data.accounts.map(a => ({
                        _id: a._id,
                        name: a.name,
                        email: a.email,
                        color: a.color,
                        isDefault: a.isDefault,
                        isActive: a.isActive,
                        lastSync: a.lastSync,
                    }));
                }
            } catch (e) {
                console.error('loadAccounts Error:', e);
            }
        },

        async disconnectAccount(acc) {
            if (!acc || !acc._id) return;
            if (!confirm('Disconnect account "' + acc.name + '"? This will remove the account from your mailbox.')) return;
            try {
                const resp = await fetch(this.apiBase + '/accounts/' + acc._id, {
                    method: 'DELETE',
                    credentials: 'include',
                });
                const data = await resp.json();
                if (data.success) {
                    this.showMessage('Account disconnected');
                    await this.loadAccounts();
                }
            } catch (e) {
                console.error('disconnectAccount Error:', e);
                this.showMessage('Failed to disconnect account', 'error');
            }
        },

        // ===== SYNC =====
        async syncMails(silent = false) {
            if (this.syncing) return; // prevent concurrent syncs
            const account = this.activeAccount;
            if (!account) return;

            if (!silent) this.syncing = true;

            try {
                const resp = await fetch(this.apiBase + '/sync', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ accountId: account._id }),
                });
                const data = await resp.json();

                if (data.success && data.mails) {
                    // Update mail list in-place
                    this.mailList = data.mails.map((m, i) => ({
                        ...m,
                        id: m.id || i + 1,
                        isStar: m.isStar || false,
                        isImportant: m.isImportant || false,
                        isUnread: m.isUnread !== undefined ? m.isUnread : false,
                        group: m.group || '',
                        type: m.type || 'inbox',
                        attachments: m.attachments || [],
                        displayDescription: m.displayDescription || m.description?.replace(/<[^>]*>/g, '').substring(0, 100) || '',
                    }));
                    this.searchMails();

                    if (!silent && data.addedCount > 0) {
                        this.showMessage(`${data.addedCount} new email(s) synced`);
                    }
                } else if (data.error && !silent) {
                    this.showMessage(data.error, 'error');
                }
            } catch (e) {
                console.error('syncMails Error:', e);
                if (!silent) this.showMessage('Sync failed', 'error');
            } finally {
                this.syncing = false;
            }
        },

        // ===== ACCOUNT SWITCHING =====
        switchAccount(accountId) {
            const pathParts = window.location.pathname.split('/');
            const accountIdx = pathParts.indexOf('account');
            const accNo = pathParts[accountIdx + 1];
            window.location.href = '/account/' + accNo + '/mailbox/inbox?accountId=' + accountId;
        },

        // ===== VIEW SETTINGS =====
        setDensity(density) {
            this.mailDensity = density;
            this.saveMailPreferences();
        },

        setPageSize(size) {
            this.pager.pageSize = size;
            this.pager.currentPage = 1;
            this.searchMails(false);
            this.saveMailPreferences();
        },

        // Load mail preferences from server
        async loadMailPreferences() {
            if (!this.accountBase) return;
            try {
                const resp = await fetch(this.accountBase + '/api/user/view-preferences/mailbox', {
                    credentials: 'include'
                });
                if (resp.ok) {
                    const data = await resp.json();
                    if (data.preferences) {
                        if (data.preferences.density) {
                            this.mailDensity = data.preferences.density;
                        }
                        if (data.preferences.pageSize) {
                            this.pager.pageSize = data.preferences.pageSize;
                            this.searchMails(false);
                        }
                    }
                }
            } catch (e) {
                console.warn('[Mailbox] Could not load preferences:', e);
            }
        },

        // Save mail preferences to server
        async saveMailPreferences() {
            if (!this.accountBase) return;
            try {
                await fetch(this.accountBase + '/api/user/view-preferences', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        viewId: 'mailbox',
                        preferences: {
                            density: this.mailDensity,
                            pageSize: this.pager.pageSize
                        }
                    })
                });
            } catch (e) {
                console.warn('[Mailbox] Could not save preferences:', e);
            }
        },
    }));
});
