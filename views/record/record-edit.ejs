                                                <iconify-icon :icon="tab.icon || 'tabler:apps'" width="13"></iconify-icon>
                                                <span x-text="tab.title"></span>
                                            </button>
                                            <button type="button" x-show="activeTab === tab.id" @click="startEditingTab(tab)"
