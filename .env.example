# Environment Variables

# MongoDB
NODE_ENV=development
PORT=3000
MONGODB_BASE_URI=mongodb://127.0.0.1:27017/
DEFAULT_TENANT=5001
APP_URL=http://localhost:3000
SESSION_SECRET=replace-me
MOBILE_TOKEN_SECRET=replace-me-with-a-long-random-secret
MOBILE_TOKEN_TTL_SECONDS=2592000

# Integration Engine - Secrets Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be exactly 32 bytes (256 bits) base64-encoded
INTEGRATION_SECRETS_KEY=<your-32-bytes-base64-key>

# Mail
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.one.com
IMAP_PORT=993
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Dexapp
MAIL_FROM_EMAIL=noreply@example.com

# Unsplash API
# Get your access key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=<your-unsplash-access-key>
## Microsoft Outlook / Hotmail OAuth2 (mailbox)
# Register a Web app in Microsoft Entra and add the callback URL:
# https://your-domain/account/{account_number}/mailbox/oauth/microsoft/callback
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_TENANT=common
# Optional only when a fixed callback URL is configured in Entra:
MICROSOFT_MAIL_REDIRECT_URI=

## Gmail OAuth2 (mailbox)
# Uses the encrypted Google OAuth client configured in Integration Providers.
# Authorized callback URI:
# https://your-domain/account/{account_number}/integrations/google/oauth/callback
