<%- include("../nav/nav-breadcrumb") %>
<link rel="stylesheet" href="/css/line-schema-builder.css" />

<div class="pt-5" x-data="lineSchemaBuilder()" x-init="init()">

    <!-- ═══ Top Bar: Name + Slug + Save ═══ -->
    <div class="lsb-topbar">
        <div class="lsb-topbar-left">
            <a href="/account/<%= account_number %>/line-schemas" class="btn btn-outline-secondary btn-sm" style="flex-shrink:0;">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </a>
            <input type="text" x-model="schema.name" class="lsb-name-input" placeholder="Nom du tableau…" />
            <input type="text" x-model="schema.slug" class="lsb-name-input" style="max-width:180px; font-size:13px; font-weight:500; color:#9ca3af;" placeholder="slug_id" />
        </div>
        <div class="lsb-topbar-right">
            <button @click="saveSchema()" class="btn btn-primary btn-sm" :disabled="saving" style="display:flex; align-items:center; gap:6px;">
                <iconify-icon x-show="!saving" icon="solar:diskette-bold-duotone" width="15"></iconify-icon>
                <iconify-icon x-show="saving" icon="svg-spinners:ring-resize" width="15"></iconify-icon>
                Enregistrer
            </button>
        </div>
    </div>

    <!-- ═══ Mode Bar: inputMode + dataMode + Validation ═══ -->
    <div class="lsb-mode-bar">
        <div class="lsb-mode-group">
            <span class="lsb-mode-label">Saisie</span>
            <div class="lsb-mode-pills">
                <template x-for="m in [{v:'form',l:'Formulaire',i:'solar:clipboard-list-bold-duotone'},{v:'table',l:'Tableur',i:'solar:notebook-bold-duotone'}]" :key="m.v">
                    <button class="lsb-mode-pill" :class="{'active': schema.inputMode === m.v}" @click="schema.inputMode = m.v">
                        <iconify-icon :icon="m.i" width="13"></iconify-icon>
                        <span x-text="m.l"></span>
                    </button>
                </template>
            </div>
        </div>
        <div class="lsb-mode-group">
            <span class="lsb-mode-label">Données</span>
            <div class="lsb-mode-pills">
                <button class="lsb-mode-pill" :class="{'active': schema.dataMode === 'items'}" @click="schema.dataMode = 'items'">
                    <iconify-icon icon="solar:list-bold" width="13"></iconify-icon> Éléments
                </button>
                <button class="lsb-mode-pill" :class="{'active': schema.dataMode === 'timeseries'}" @click="schema.dataMode = 'timeseries'">
                    <iconify-icon icon="solar:chart-bold" width="13"></iconify-icon> Chronologique
                </button>
            </div>
        </div>
        <div style="width:1px; height:24px; background:#e5e7eb; margin:0 4px;"></div>
        <div class="lsb-mode-group">
            <span class="lsb-mode-label">Multiples</span>
            <div style="display:flex; align-items:center; gap:8px;">
                <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-size:12px; font-weight:600; color:#374151; user-select:none;">
                    <input type="checkbox" x-model="schema.snapshotConfig.enabled" class="form-checkbox" style="width:16px; height:16px;" />
                    <iconify-icon icon="solar:check-circle-bold-duotone" width="14" :style="schema.snapshotConfig.enabled ? 'color:#00ab55' : 'color:#d1d5db'"></iconify-icon>
                    <span x-text="schema.snapshotConfig.enabled ? 'Actif' : 'Inactif'" :style="schema.snapshotConfig.enabled ? 'color:#00ab55' : 'color:#9ca3af'"></span>
                </label>
                <template x-if="schema.snapshotConfig.enabled">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <div style="width:1px; height:18px; background:#e5e7eb;"></div>
                        <select x-model="schema.snapshotConfig.targetType" style="padding:3px 8px; border:1px solid #e5e7eb; border-radius:6px; font-size:11px; font-weight:500; color:#374151; outline:none; cursor:pointer; background:white;">
                            <option value="self">Record en cours</option>
                            <option value="relation">Record lié</option>
                        </select>
                        <template x-if="schema.snapshotConfig.targetType === 'relation'">
                            <select x-model="schema.snapshotConfig.targetEntityId" style="padding:3px 8px; border:1px solid #e5e7eb; border-radius:6px; font-size:11px; font-weight:500; color:#374151; outline:none; cursor:pointer; background:white;">
                                <option value="">Entité…</option>
                                <% (entities || []).forEach(function(ent) { %>
                                    <option value="<%= ent._id %>"><%= ent.name %></option>
                                <% }) %>
                            </select>
                        </template>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <div class="grid gap-5 xl:grid-cols-5">
        <!-- ═══ LEFT: Columns + Paramètres (3/5) ═══ -->
        <div class="xl:col-span-3 space-y-5">
            <!-- Columns panel -->
            <div class="panel !p-0 overflow-hidden">
                <div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid #e5e7eb;">
                    <h5 class="text-sm font-bold dark:text-white-light flex items-center gap-2">
                        <iconify-icon icon="solar:tuning-2-bold-duotone" width="16" class="text-primary"></iconify-icon>
                        Colonnes
                        <span class="text-[10px] font-bold text-gray-400" x-text="schema.columns.length + ' col.'"></span>
                    </h5>
                    <button @click="addColumn()" class="btn btn-sm btn-primary" style="display:flex; align-items:center; gap:4px; padding:4px 10px; font-size:11px;">
                        <iconify-icon icon="solar:add-circle-bold" width="14"></iconify-icon> Colonne
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="lsb-col-table">
                        <thead>
                            <tr>
                                <th style="width:30px;"></th>
                                <th>Clé</th>
                                <th>Label</th>
                                <th>Type</th>
                                <th style="width:60px;">Largeur</th>
                                <th style="width:50px;">Requis</th>
                                <th style="width:50px;">Visible</th>
                                <th style="width:80px;"></th>
                            </tr>
                        </thead>
                        <tbody x-ref="columnsSortable">
                            <template x-for="(col, idx) in schema.columns" :key="col._tempId || col._id || idx">
                                <tr>
                                    <td><span class="lsb-drag-handle"><iconify-icon icon="tabler:grip-vertical" width="14"></iconify-icon></span></td>
                                    <td><input type="text" x-model="col.key" class="lsb-input" placeholder="key" style="font-family: monospace; font-size:11px;" /></td>
                                    <td><input type="text" x-model="col.label" class="lsb-input" placeholder="Label" /></td>
                                    <td>
                                        <select x-model="col.type" class="lsb-input" style="cursor:pointer;">
                                            <option value="text">Texte</option>
                                            <option value="number">Nombre</option>
                                            <option value="money">Montant</option>
                                            <option value="select">Select</option>
                                            <option value="multiselect">Multi-Select</option>
                                            <option value="relation">Relation</option>
                                            <option value="duration">Durée</option>
                                            <option value="dosage">Dosage</option>
                                            <option value="formula">Formule</option>
                                            <option value="date">Date</option>
                                            <option value="textarea">Zone texte</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select x-model="col.width" class="lsb-input" style="width:58px; cursor:pointer;">
                                            <option value="XS">XS</option><option value="S">S</option><option value="M">M</option><option value="L">L</option><option value="XL">XL</option>
                                        </select>
                                    </td>
                                    <td class="text-center"><input type="checkbox" x-model="col.required" class="form-checkbox" /></td>
                                    <td class="text-center"><input type="checkbox" x-model="col.visible" class="form-checkbox" /></td>
                                    <td>
                                        <div class="lsb-row-actions" style="opacity:1;">
                                            <button class="lsb-row-btn" @click="toggleColConfig(idx)" :style="expandedCol === idx ? 'color:#4361ee' : ''" title="Config">
                                                <iconify-icon icon="solar:settings-bold-duotone" width="14"></iconify-icon>
                                            </button>
                                            <button class="lsb-row-btn delete" @click="removeColumn(idx)" title="Supprimer">
                                                <iconify-icon icon="tabler:trash" width="14"></iconify-icon>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
                <div x-show="schema.columns.length === 0" class="py-8 text-center text-sm text-gray-400">
                    <iconify-icon icon="solar:tuning-2-broken" width="28" style="display:block; margin:0 auto 6px; opacity:0.4;"></iconify-icon>
                    Aucune colonne. Cliquez sur « + Colonne » pour commencer.
                </div>
            </div>

            <!-- ═══ Paramètres panel (below columns) ═══ -->
            <div class="panel !p-0 overflow-hidden">
                <div class="flex items-center justify-between px-4 py-3 cursor-pointer" style="border-bottom: 1px solid #e5e7eb;" @click="parametersOpen = !parametersOpen">
                    <h5 class="text-sm font-bold dark:text-white-light flex items-center gap-2">
                        <iconify-icon icon="solar:settings-bold-duotone" width="16" class="text-primary"></iconify-icon>
                        Paramètres
                    </h5>
                    <iconify-icon icon="solar:alt-arrow-down-bold" width="14" :class="parametersOpen ? '' : '-rotate-90'" class="transition-transform text-gray-400"></iconify-icon>
                </div>
                <div x-show="parametersOpen" x-collapse>
                    <div class="px-4 py-4 space-y-5">

                        <!-- Description -->
                        <div>
                            <label class="mb-1.5 block text-xs font-semibold text-gray-500 dark:text-gray-400">Description</label>
                            <input type="text" x-model="schema.description" class="form-input form-input-sm" placeholder="Description optionnelle" />
                        </div>

                        <!-- Afficher sur (entités) -->
                        <div>
                            <label class="mb-1.5 block text-xs font-semibold text-gray-500 dark:text-gray-400">Afficher sur (entités)</label>
                            <div class="flex flex-wrap gap-1 mb-1">
                                <template x-for="entId in schema.appliesTo.entityIds" :key="entId">
                                    <span class="lsb-entity-chip">
                                        <span x-text="getEntityName(entId)"></span>
                                        <button @click="toggleEntityId(entId)">×</button>
                                    </span>
                                </template>
                                <span x-show="(schema.appliesTo.entityIds || []).length === 0" style="font-size:10px; color:#9ca3af;">Global (toutes les entités)</span>
                            </div>
                            <div class="relative" x-data="{ open: false }">
                                <input type="text" x-model="entitySearch" @focus="open = true" @click="open = true" class="form-input form-input-sm" placeholder="Rechercher…" />
                                <div x-show="open" x-cloak @click.outside="open = false" class="absolute z-50 mt-1 w-full bg-white dark:bg-[#0e1726] border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg max-h-40 overflow-y-auto">
                                    <template x-for="ent in filteredEntities" :key="ent._id">
                                        <button type="button" @click="toggleEntityId(ent._id); entitySearch = ''" class="w-full flex items-center gap-2 px-3 py-1.5 text-xs text-left hover:bg-gray-50 dark:hover:bg-white/5" :class="(schema.appliesTo.entityIds || []).includes(ent._id) ? 'text-primary font-semibold' : 'text-gray-600 dark:text-gray-300'">
                                            <iconify-icon :icon="ent.icon || 'solar:box-bold-duotone'" width="12" :style="ent.color ? 'color:'+ent.color : ''"></iconify-icon>
                                            <span x-text="ent.name"></span>
                                        </button>
                                    </template>
                                </div>
                            </div>
                        </div>

                        <!-- Type document -->
                        <div>
                            <label class="mb-1.5 block text-xs font-semibold text-gray-500 dark:text-gray-400">Type document</label>
                            <select x-model="schema.appliesTo.documentType" class="form-select form-select-sm">
                                <option value="">— Aucun —</option>
                                <option value="invoice">Facture</option><option value="quote">Devis</option>
                                <option value="prescription">Ordonnance</option><option value="purchase_order">Bon de commande</option>
                            </select>
                        </div>



                        <!-- Timeseries config (shown when dataMode=timeseries) -->
                        <template x-if="schema.dataMode === 'timeseries'">
                            <div>
                                <div style="border-top: 1px dashed #e5e7eb; margin: 0 -16px 16px; padding: 0;"></div>
                                <div class="flex items-center gap-2 mb-3">
                                    <iconify-icon icon="solar:chart-bold-duotone" width="14" class="text-primary"></iconify-icon>
                                    <span class="text-xs font-bold text-gray-700 dark:text-gray-200">Config Chronologique</span>
                                </div>
                                <div class="space-y-2">
                                    <div>
                                        <label class="mb-1 block text-xs font-semibold text-gray-500">Colonne date</label>
                                        <select x-model="schema.timeseriesConfig.dateColumn" class="form-select form-select-sm">
                                            <template x-for="col in schema.columns.filter(c => c.type === 'date')" :key="col.key">
                                                <option :value="col.key" x-text="col.label || col.key"></option>
                                            </template>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-xs font-semibold text-gray-500">Tri</label>
                                        <select x-model="schema.timeseriesConfig.sortDirection" class="form-select form-select-sm">
                                            <option value="desc">Plus récent en premier</option><option value="asc">Plus ancien en premier</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </template>

                    </div>
                </div>
            </div>

        </div>

        <!-- ═══ RIGHT: Preview (2/5) ═══ -->
        <div class="xl:col-span-2 space-y-5">

            <!-- Live Preview -->
            <div class="lsb-preview-panel">
                <div class="lsb-preview-header">
                    <span><iconify-icon icon="solar:eye-bold-duotone" width="13" style="margin-right:4px;"></iconify-icon> Aperçu</span>
                    <span style="font-size:10px; font-weight:500; color:#9ca3af;" x-text="schema.inputMode === 'form' ? 'Mode Formulaire' : 'Mode Tableur'"></span>
                </div>

                <!-- Form/Timeseries preview -->
                <template x-if="schema.inputMode === 'form'">
                    <div>
                        <div class="lsb-pv-card">
                            <div class="lsb-pv-date">
                                <iconify-icon icon="solar:calendar-bold" width="12"></iconify-icon>
                                <span x-text="new Date().toLocaleDateString('fr-FR', {day:'numeric', month:'long', year:'numeric'})"></span>
                            </div>
                            <div class="lsb-pv-grid" :style="'grid-template-columns: repeat(' + Math.min(4, visibleColumns.filter(c=>c.type!=='date').length) + ', 1fr)'">
                                <template x-for="col in visibleColumns.filter(c => c.type !== 'date')" :key="col.key || col._tempId">
                                    <div class="lsb-pv-field">
                                        <label x-text="col.label || col.key || '…'"></label>
                                        <div class="lsb-pv-val">
                                            <span x-text="previewValue(col)"></span>
                                            <template x-if="col.type === 'number' && col.config && col.config.unit">
                                                <span style="font-size:11px; color:#9ca3af;" x-text="col.config.unit"></span>
                                            </template>
                                            <template x-if="col.type === 'number' && col.config && col.config.normalRange && col.config.normalRange.max">
                                                <span class="lsb-pv-indicator normal">✅</span>
                                            </template>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </div>
                        <div class="lsb-pv-add-row">
                            <iconify-icon icon="tabler:plus" width="14"></iconify-icon> Nouvelle mesure
                        </div>
                    </div>
                </template>

                <!-- Table preview -->
                <template x-if="schema.inputMode !== 'form'">
                    <div>
                        <div style="overflow-x:auto;">
                            <table class="lsb-pv-table">
                                <thead>
                                    <tr>
                                        <template x-for="col in visibleColumns" :key="col.key || col._tempId">
                                            <th x-text="col.label || col.key || '…'"></th>
                                        </template>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <template x-for="col in visibleColumns" :key="col.key || col._tempId">
                                            <td x-text="previewPlaceholder(col)"></td>
                                        </template>
                                    </tr>
                                    <tr>
                                        <template x-for="col in visibleColumns" :key="col.key || col._tempId">
                                            <td x-text="previewPlaceholder(col)"></td>
                                        </template>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="lsb-pv-add-row">
                            <iconify-icon icon="tabler:plus" width="14"></iconify-icon> Ajouter une ligne
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <!-- ═══ Config Modal (floats above everything) ═══ -->
    <template x-if="expandedCol !== null && schema.columns[expandedCol]">
        <div style="position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:9999; display:flex; align-items:center; justify-content:center;" @click.self="expandedCol = null" @keydown.escape.window="expandedCol = null">
            <div style="background:#fff; border-radius:16px; width:560px; max-width:92vw; max-height:80vh; overflow-y:auto; box-shadow:0 25px 50px -12px rgba(0,0,0,0.25); padding:20px 24px;" class="dark:!bg-[#0e1726]" @click.stop>
                <div class="flex items-center justify-between mb-4">
                    <h6 class="text-base font-bold dark:text-white-light flex items-center gap-2">
                        <iconify-icon icon="solar:settings-bold-duotone" width="16" class="text-primary"></iconify-icon>
                        Config: <span x-text="schema.columns[expandedCol].label || schema.columns[expandedCol].key" class="text-primary"></span>
                        <span class="lsb-type-badge" style="background:rgba(0,171,85,0.1); color:#00ab55;" x-text="schema.columns[expandedCol].type"></span>
                    </h6>
                    <button @click="expandedCol = null" class="lsb-row-btn" style="padding:6px;"><iconify-icon icon="tabler:x" width="18"></iconify-icon></button>
                </div>

                <!-- Number config -->
                <template x-if="schema.columns[expandedCol].type === 'number'">
                    <div class="lsb-config-grid">
                        <div class="lsb-config-field">
                            <label>Unité</label>
                            <input type="text" x-model="schema.columns[expandedCol].config.unit" placeholder="mUI/L, g/L, %" />
                        </div>
                        <div class="lsb-config-field">
                            <label>Norme Min</label>
                            <input type="number" step="any" x-model.number="schema.columns[expandedCol].config.normalRange.min" placeholder="0" />
                        </div>
                        <div class="lsb-config-field">
                            <label>Norme Max</label>
                            <input type="number" step="any" x-model.number="schema.columns[expandedCol].config.normalRange.max" placeholder="10" />
                        </div>
                        <div class="lsb-config-field">
                            <label>Décimales</label>
                            <input type="number" x-model.number="schema.columns[expandedCol].config.decimals" min="0" max="4" placeholder="2" />
                        </div>
                    </div>
                </template>

                <!-- Select / Multiselect -->
                <template x-if="schema.columns[expandedCol].type === 'select' || schema.columns[expandedCol].type === 'multiselect'">
                    <div>
                        <label style="font-size:10px; font-weight:600; color:#6b7280; text-transform:uppercase; margin-bottom:6px; display:block;">Options</label>
                        <template x-for="(opt, oi) in (schema.columns[expandedCol].config.options || [])" :key="oi">
                            <div class="lsb-opt-row">
                                <input type="text" x-model="opt.value" placeholder="valeur" />
                                <input type="text" x-model="opt.label" placeholder="label" />
                                <button class="lsb-row-btn delete" @click="schema.columns[expandedCol].config.options.splice(oi, 1)"><iconify-icon icon="tabler:x" width="12"></iconify-icon></button>
                            </div>
                        </template>
                        <button @click="addSelectOption()" class="btn btn-sm btn-outline-primary" style="font-size:10px; padding:3px 8px; margin-top:4px;">+ Option</button>
                    </div>
                </template>

                <!-- Relation -->
                <template x-if="schema.columns[expandedCol].type === 'relation'">
                    <div class="lsb-config-grid">
                        <div class="lsb-config-field">
                            <label>Entité source</label>
                            <select x-model="schema.columns[expandedCol].config.targetEntity">
                                <option value="">Choisir…</option>
                                <% (entities || []).forEach(function(ent) { %>
                                    <option value="<%= ent._id %>"><%= ent.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="lsb-config-field">
                            <label>Champs recherche</label>
                            <input type="text" x-model="schema.columns[expandedCol].config._searchFieldsStr" @change="schema.columns[expandedCol].config.searchFields = JSON.parse(schema.columns[expandedCol].config._searchFieldsStr || '[]')" placeholder='["title"]' />
                        </div>
                        <div class="lsb-config-field">
                            <label>Champs affichage</label>
                            <input type="text" x-model="schema.columns[expandedCol].config._displayFieldsStr" @change="schema.columns[expandedCol].config.displayFields = JSON.parse(schema.columns[expandedCol].config._displayFieldsStr || '[]')" placeholder='["title"]' />
                        </div>
                    </div>
                </template>

                <!-- Formula -->
                <template x-if="schema.columns[expandedCol].type === 'formula'">
                    <div class="lsb-config-grid">
                        <div class="lsb-config-field" style="grid-column: span 2;">
                            <label>Expression</label>
                            <input type="text" x-model="schema.columns[expandedCol].config.expression" placeholder="qty * unitPrice * (1 - discount/100)" style="font-family:monospace;" />
                        </div>
                        <div class="lsb-config-field">
                            <label>Dépendances (csv)</label>
                            <input type="text" x-model="schema.columns[expandedCol].config._depsStr" @change="schema.columns[expandedCol].config.dependencies = (schema.columns[expandedCol].config._depsStr || '').split(',').map(s=>s.trim()).filter(Boolean)" placeholder="qty, unitPrice" />
                        </div>
                    </div>
                </template>

                <!-- Money -->
                <template x-if="schema.columns[expandedCol].type === 'money'">
                    <div class="lsb-config-grid">
                        <div class="lsb-config-field">
                            <label>Devise</label>
                            <select x-model="schema.columns[expandedCol].config.currency">
                                <option value="EUR">EUR (€)</option><option value="USD">USD ($)</option><option value="MAD">MAD (DH)</option><option value="GBP">GBP (£)</option>
                            </select>
                        </div>
                        <div class="lsb-config-field">
                            <label>Décimales</label>
                            <input type="number" x-model.number="schema.columns[expandedCol].config.decimals" min="0" max="4" />
                        </div>
                    </div>
                </template>

                <!-- Duration / Dosage -->
                <template x-if="schema.columns[expandedCol].type === 'duration' || schema.columns[expandedCol].type === 'dosage'">
                    <div>
                        <label style="font-size:10px; font-weight:600; color:#6b7280; text-transform:uppercase; margin-bottom:6px; display:block;">Unités disponibles</label>
                        <div style="display:flex; flex-wrap:wrap; gap:8px;">
                            <template x-for="unit in schema.columns[expandedCol].type === 'duration' ? ['day','week','month','year'] : ['mg','ml','g','cp','gouttes','UI']" :key="unit">
                                <label style="display:flex; align-items:center; gap:4px; font-size:12px; cursor:pointer;">
                                    <input type="checkbox" class="form-checkbox" :checked="(schema.columns[expandedCol].config.units || []).includes(unit)" @change="toggleUnit(unit)" />
                                    <span x-text="unit"></span>
                                </label>
                            </template>
                        </div>
                    </div>
                </template>

                <!-- Apply -->
                <div style="margin-top:16px; display:flex; justify-content:flex-end;">
                    <button @click="expandedCol = null" class="btn btn-primary btn-sm" style="display:flex; align-items:center; gap:4px;">
                        <iconify-icon icon="tabler:check" width="14"></iconify-icon> Appliquer
                    </button>
                </div>
            </div>
        </div>
    </template>
</div>

<!-- Entity Data -->
<script id="all-entities-data" type="application/json"><%- JSON.stringify((entities || []).map(e => ({ _id: e._id.toString(), name: e.name, icon: e.icon || '', color: e.color || '' }))) %></script>

<script>
function lineSchemaBuilder() {
    const existingSchema = <%- schema ? JSON.stringify(schema) : 'null' %>;
    const accountNumber = '<%= account_number %>';
    const allEntitiesData = JSON.parse(document.getElementById('all-entities-data').textContent);

    const normalize = (id) => (typeof id === 'object' && id !== null && id.$oid) ? id.$oid : String(id);

    return {
        schema: existingSchema ? {
            ...existingSchema,
            inputMode: existingSchema.inputMode || 'table',
            dataMode: existingSchema.dataMode || 'timeseries',
            timeseriesConfig: existingSchema.timeseriesConfig || { dateColumn: 'date', sortDirection: 'desc' },
            analyticsConfig: existingSchema.analyticsConfig || { enabled: false, views: [] },
            appliesTo: {
                ...existingSchema.appliesTo || {},
                entityIds: (() => {
                    if (existingSchema.appliesTo?.entityIds?.length > 0) return existingSchema.appliesTo.entityIds.map(normalize);
                    if (existingSchema.appliesTo?.entityId) return [normalize(existingSchema.appliesTo.entityId)];
                    return [];
                })(),
                documentType: existingSchema.appliesTo?.documentType || ''
            },
            lineTypes: existingSchema.lineTypes || ['default'],
            columns: (existingSchema.columns || []).map((col, i) => ({
                ...col,
                config: {
                    ...col.config || {},
                    normalRange: col.config?.normalRange || { min: null, max: null },
                    ...(col.type === 'relation' ? {
                        _searchFieldsStr: JSON.stringify(col.config?.searchFields || ['title']),
                        _displayFieldsStr: JSON.stringify(col.config?.displayFields || ['title'])
                    } : {}),
                    ...(col.type === 'formula' ? { _depsStr: (col.config?.dependencies || []).join(', ') } : {})
                },
                _tempId: 'col_' + i + '_' + Date.now(),
                _showWhenStr: (col.showWhen?.lineType?.[0]) || ''
            })),
            totals: existingSchema.totals || {},
            snapshotConfig: existingSchema.snapshotConfig || { enabled: true, targetType: 'self', targetRelationKey: '', targetEntityId: '' }
        } : {
            name: '', slug: '', description: '',
            inputMode: 'table', dataMode: 'timeseries',
            timeseriesConfig: { dateColumn: 'date', sortDirection: 'desc' },
            analyticsConfig: { enabled: false, views: [] },
            appliesTo: { entityIds: [], documentType: '' },
            lineTypes: ['default'], columns: [],
            totals: {},
            snapshotConfig: { enabled: true, targetType: 'self', targetRelationKey: '', targetEntityId: '' },
            defaultLineType: 'default'
        },

        saving: false, expandedCol: null,
        parametersOpen: true,
        entitySearch: '',
        allEntities: allEntitiesData,

        get visibleColumns() { return this.schema.columns.filter(c => c.visible !== false); },
        get filteredEntities() {
            const q = (this.entitySearch || '').toLowerCase().trim();
            if (!q) return this.allEntities;
            return this.allEntities.filter(e => e.name.toLowerCase().includes(q));
        },

        getEntityName(id) {
            const ent = this.allEntities.find(e => String(e._id) === String(id));
            return ent ? ent.name : String(id);
        },

        init() {
            this.$nextTick(() => {
                if (this.$refs.columnsSortable && typeof Sortable !== 'undefined') {
                    Sortable.create(this.$refs.columnsSortable, {
                        handle: '.lsb-drag-handle', animation: 150,
                        ghostClass: 'sortable-ghost', chosenClass: 'sortable-chosen',
                        onEnd: (evt) => {
                            const cols = [...this.schema.columns];
                            const [moved] = cols.splice(evt.oldIndex, 1);
                            cols.splice(evt.newIndex, 0, moved);
                            this.schema.columns = cols;
                            if (this.expandedCol === evt.oldIndex) this.expandedCol = evt.newIndex;
                            else if (this.expandedCol !== null) {
                                if (evt.oldIndex < this.expandedCol && evt.newIndex >= this.expandedCol) this.expandedCol--;
                                else if (evt.oldIndex > this.expandedCol && evt.newIndex <= this.expandedCol) this.expandedCol++;
                            }
                        }
                    });
                }
            });
        },

        toggleEntityId(entityId) {
            if (!this.schema.appliesTo.entityIds) this.schema.appliesTo.entityIds = [];
            const idx = this.schema.appliesTo.entityIds.indexOf(entityId);
            if (idx >= 0) this.schema.appliesTo.entityIds.splice(idx, 1);
            else this.schema.appliesTo.entityIds.push(entityId);
        },

        addColumn() {
            const col = {
                key: '', label: '', type: 'text', required: false, visible: true, width: 'M',
                order: this.schema.columns.length, showWhen: {},
                config: { normalRange: { min: null, max: null } },
                _tempId: 'col_' + Date.now() + '_' + Math.random(), _showWhenStr: ''
            };
            this.schema.columns.push(col);
            this.expandedCol = this.schema.columns.length - 1;
        },

        removeColumn(idx) {
            if (this.expandedCol === idx) this.expandedCol = null;
            else if (this.expandedCol !== null && this.expandedCol > idx) this.expandedCol--;
            this.schema.columns.splice(idx, 1);
        },

        toggleColConfig(idx) {
            if (this.expandedCol === idx) { this.expandedCol = null; return; }
            const col = this.schema.columns[idx];
            if (!col.config) col.config = {};
            if (col.type === 'number' && !col.config.normalRange) col.config.normalRange = { min: null, max: null };
            if ((col.type === 'select' || col.type === 'multiselect') && !col.config.options) { col.config.options = []; col.config.source = 'manual'; }
            if (col.type === 'relation') {
                if (!col.config.targetEntity) col.config.targetEntity = '';
                col.config._searchFieldsStr = col.config._searchFieldsStr || JSON.stringify(col.config.searchFields || ['title']);
                col.config._displayFieldsStr = col.config._displayFieldsStr || JSON.stringify(col.config.displayFields || ['title']);
            }
            if (col.type === 'formula') {
                if (!col.config.expression) col.config.expression = '';
                col.config._depsStr = col.config._depsStr || (col.config.dependencies || []).join(', ');
            }
            if (col.type === 'money') { if (!col.config.currency) col.config.currency = 'EUR'; if (col.config.decimals === undefined) col.config.decimals = 2; }
            if ((col.type === 'duration' || col.type === 'dosage') && !col.config.units) col.config.units = [];
            this.expandedCol = idx;
        },

        addSelectOption() {
            if (!this.schema.columns[this.expandedCol].config.options) this.schema.columns[this.expandedCol].config.options = [];
            this.schema.columns[this.expandedCol].config.options.push({ value: '', label: '' });
        },

        toggleUnit(unit) {
            const col = this.schema.columns[this.expandedCol];
            if (!col.config.units) col.config.units = [];
            const idx = col.config.units.indexOf(unit);
            if (idx >= 0) col.config.units.splice(idx, 1);
            else col.config.units.push(unit);
        },

        previewValue(col) {
            const map = { text: 'valeur', number: '1.21', money: '12.50', select: 'thyroide', textarea: 'texte…', date: '16/03/2026', relation: '🔍 Article', formula: '= auto', duration: '7 j', dosage: '500 mg', multiselect: 'Matin, Soir' };
            return map[col.type] || '…';
        },

        previewPlaceholder(col) {
            const map = { text: 'abc...', number: '123', money: '0.00 €', select: 'Option ▼', multiselect: 'Tags...', relation: '🔍 Rechercher', duration: '7 jours', dosage: '500 mg', formula: '= auto', date: 'jj/mm/aaaa', textarea: 'Texte...' };
            return map[col.type] || '...';
        },

        async saveSchema() {
            if (!this.schema.name || !this.schema.slug) { alert('Nom et Slug sont requis'); return; }
            this.saving = true;
            const cleanColumns = this.schema.columns.map((col, i) => {
                const clean = { ...col, order: i };
                delete clean._tempId; delete clean._showWhenStr;
                if (clean.config) {
                    const cfg = { ...clean.config };
                    delete cfg._searchFieldsStr; delete cfg._displayFieldsStr; delete cfg._depsStr;
                    if (cfg.normalRange && cfg.normalRange.min === null && cfg.normalRange.max === null) delete cfg.normalRange;
                    clean.config = cfg;
                }
                return clean;
            });
            const payload = {
                name: this.schema.name, slug: this.schema.slug, description: this.schema.description,
                inputMode: this.schema.inputMode, dataMode: this.schema.dataMode,
                timeseriesConfig: this.schema.dataMode === 'timeseries' ? this.schema.timeseriesConfig : undefined,
                analyticsConfig: this.schema.analyticsConfig,
                appliesTo: { entityIds: this.schema.appliesTo.entityIds || [], documentType: this.schema.appliesTo.documentType || undefined },
                lineTypes: this.schema.lineTypes, columns: cleanColumns,
                totals: this.schema.totals, defaultLineType: this.schema.defaultLineType,
                snapshotConfig: this.schema.snapshotConfig
            };
            try {
                const isNew = !this.schema._id;
                const url = isNew ? `/account/${accountNumber}/api/line-schemas` : `/account/${accountNumber}/api/line-schemas/${this.schema._id}`;
                const res = await fetch(url, { method: isNew ? 'POST' : 'PUT', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify(payload) });
                const result = await res.json();
                if (res.ok) {
                    if (isNew && result.data?._id) window.location.href = `/account/${accountNumber}/line-schemas/${result.data._id}/edit`;
                    else { this.schema._id = result.data._id; window.showMessage?.('Tableau enregistré avec succès') || alert('Enregistré !'); }
                } else { alert('Erreur: ' + (result.error || 'Unknown')); }
            } catch (e) { console.error(e); alert('Erreur réseau'); }
            finally { this.saving = false; }
        }
    };
}
</script>
