                                <iconify-icon icon="solar:database-line-duotone" width="40" class="text-gray-400 group-hover:text-primary mb-3 mx-auto"></iconify-icon>
                                <h4 class="font-bold text-xs dark:text-white">Collection Existante</h4>
                                <p class="text-[10px] text-gray-500 dark:text-gray-400 mt-1">Lier/segmenter une collection active</p>
                             </div>
                          </div>
                           <div @click="recordsWizardStep = 'library'"
                               class="rw-choice-card group">
                             <div>
                                <iconify-icon icon="solar:star-ring-bold-duotone" width="40" style="color: #e2a03f" class="group-hover:scale-110 mb-3 mx-auto transition-transform"></iconify-icon>
                                <h4 class="font-bold text-xs dark:text-white">Modèles Prêts</h4>
                                <p class="text-[10px] text-gray-500 dark:text-gray-400 mt-1">Projets, Voitures, Personnes préconfigurés</p>
                             </div>
                          </div>
                           <div @click="prepareNewRecordsWizard()"
                               class="rw-choice-card group">
                             <div>
                                <iconify-icon icon="solar:magic-stick-3-line-duotone" width="40" class="text-gray-400 group-hover:text-success mb-3 mx-auto"></iconify-icon>
                                <h4 class="font-bold text-xs dark:text-white">Nouvelle de Zéro</h4>
                                <p class="text-[10px] text-gray-500 dark:text-gray-400 mt-1">Créer une nouvelle entité personnalisée</p>
                             </div>
                          </div>
                       </div>
                    </template>

                    <!-- Step 1.5: Bibliothèque de Modèles -->
                    <template x-if="recordsWizardStep === 'library'">
                       <div class="space-y-4">
                          <div class="flex justify-between items-center mb-2">
                             <p class="text-xs text-gray-500 dark:text-gray-400">Sélectionnez un modèle d'entité prêt à l'emploi :</p>
                             <button @click="recordsWizardStep = 1" class="text-xs text-primary hover:underline flex items-center gap-1 font-semibold">
                                <iconify-icon icon="solar:alt-arrow-left-line-duotone"></iconify-icon> Retour
                             </button>
                          </div>
                          
                          <div class="grid grid-cols-2 gap-3 max-h-[360px] overflow-y-auto pr-1 custom-scrollbar">
                             <template x-for="tpl in templatesList" :key="tpl.nameSingular">
                                 <div @click="selectTemplate(tpl)"
                                      class="rw-library-card cursor-pointer p-4 group relative flex flex-col justify-between">
                                   <div>
                                      <div class="flex items-center gap-3 mb-2">
                                         <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" :style="'background-color:' + tpl.color + '20; color:' + tpl.color">
                                            <iconify-icon :icon="tpl.icon" width="20" height="20"></iconify-icon>
                                         </div>
                                         <h4 class="font-bold text-sm text-gray-800 dark:text-gray-100" x-text="tpl.namePlural"></h4>
                                      </div>
                                      <p class="text-[11px] text-gray-500 dark:text-gray-400 leading-normal" x-text="tpl.description"></p>
                                   </div>
                                   <div class="mt-3 flex flex-wrap gap-1">
                                      <template x-for="f in tpl.fields" :key="f.name">
                                         <span class="text-[9px] bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded text-gray-600 dark:text-gray-300" x-text="f.name"></span>
                                      </template>
                                   </div>
                                </div>
                              </template>
                          </div>
                       </div>
                    </template>

                    <!-- Step 2A: Existante -->
                    <template x-if="recordsWizardStep === 2 && recordsWizardMode === 'existing'">
                       <div class="space-y-5">
                           <div class="rw-panel rw-panel-soft p-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                              <div>
                                 <label class="rw-label">Nom du listing</label>
                                 <input type="text" x-model="wizardListingName" class="rw-input form-input w-full" placeholder="ex: Hôtels, Prospects chauds, Clients VIP" />
                              </div>
                              <div>
                                 <label class="rw-label">Collection source</label>
                                 <select x-model="wizardExistingCollection" class="rw-select form-select w-full">
                                    <option value="">Sélectionner une collection...</option>
                                    <template x-for="ent in allEntities" :key="ent.id">
                                        <option :value="ent.id" x-text="ent.namePlural || ent.name"></option>
                                    </template>
                                 </select>
                              </div>
                           </div>

                           <div x-show="wizardExistingCollection" class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-4">
                              <div class="rw-panel p-4 space-y-4">
                                 <div>
                                    <label class="rw-label">Affichage</label>
                                    <div class="grid grid-cols-4 gap-2">
                                       <template x-for="type in wizardViewTypes()" :key="type.value">
                                          <button type="button"
                                             @click="wizardViewType = type.value"
                                             class="rw-view-card"
                                             :class="wizardViewType === type.value ? 'is-active' : ''">
                                             <iconify-icon :icon="type.icon" width="19"></iconify-icon>
                                             <span x-text="type.label"></span>
                                          </button>
                                       </template>
                                    </div>
                                 </div>

                                 <div>
                                    <label class="rw-label">Portée du listing</label>
                                    <div class="rw-scope-switch">
                                       <button type="button" @click="wizardViewMode = 'all'"
                                          class="rw-scope-btn"
                                          :class="wizardViewMode === 'all' ? 'is-active' : ''">
                                          Tous les records
                                       </button>
                                       <button type="button" @click="wizardViewMode = 'segmentation'"
                                          class="rw-scope-btn"
                                          :class="wizardViewMode === 'segmentation' ? 'is-active is-accent' : ''">
                                          Filtres avancés
                                       </button>
                                    </div>
                                 </div>
                              </div>

                              <div class="rw-preview">
                                 <div class="text-[10px] uppercase tracking-wider font-bold text-gray-400 mb-3">Résumé</div>
                                 <div class="flex items-center gap-2 min-w-0">
                                    <div class="rw-preview-icon"
                                         :style="selectedWizardEntity()?.color ? 'color:' + selectedWizardEntity().color : ''">
                                       <iconify-icon :icon="selectedWizardEntity()?.icon || 'solar:database-bold-duotone'" width="18"></iconify-icon>
                                    </div>
                                    <div class="min-w-0">
                                       <div class="text-sm font-bold text-gray-900 dark:text-white truncate" x-text="wizardListingName || selectedWizardEntity()?.namePlural || selectedWizardEntity()?.name || 'Nouveau listing'"></div>
                                       <div class="text-[11px] text-gray-500 truncate" x-text="selectedWizardEntity() ? 'Source : ' + (selectedWizardEntity().namePlural || selectedWizardEntity().name) : 'Choisissez une source'"></div>
                                    </div>
                                 </div>
                                 <div class="mt-4 flex flex-wrap gap-2">
                                    <span class="rw-chip" x-text="wizardViewType"></span>
                                    <span class="rw-chip" x-text="wizardViewMode === 'segmentation' ? normalizedWizardFilters().length + ' filtre(s)' : 'sans filtre'"></span>
                                 </div>
                              </div>
                           </div>

                           <div x-show="wizardExistingCollection && wizardViewMode === 'segmentation'" class="rw-filter-panel">
                              <div class="rw-filter-head">
                                 <div>
                                    <div class="text-sm font-bold text-gray-900 dark:text-white">Filtres du listing</div>
                                    <div class="text-[11px] text-gray-500">Combinez plusieurs règles sur les champs standards, personnalisés, statuts ou relations.</div>
                                 </div>
                                 <button type="button" class="btn btn-outline-primary btn-sm shrink-0" @click="addWizardFilter()" :disabled="wizardFieldsLoading">
                                    <iconify-icon icon="solar:add-circle-bold" class="mr-1"></iconify-icon>
                                    Ajouter
                                 </button>
                              </div>

                              <div class="p-4 space-y-3">
                                 <div x-show="wizardFieldsLoading" class="py-5 text-center text-xs text-gray-400">
                                    Chargement des champs...
                                 </div>

                                 <template x-for="(filter, index) in wizardFilters" :key="index">
                                    <div class="rw-filter-row">
                                       <div>
                                          <select x-show="index > 0" x-model="filter.logic" class="rw-select form-select text-xs h-9">
                                             <option value="AND">ET</option>
                                             <option value="OR">OU</option>
                                          </select>
                                          <span x-show="index === 0" class="rw-filter-token">SI</span>
                                       </div>

                                       <div>
                                          <select x-model="filter.field" @change="syncWizardFilterField(filter)" class="rw-select form-select text-xs h-9">
                                             <option value="">Champ...</option>
                                             <template x-for="field in wizardEntityFields" :key="field.id">
                                                <option :value="field.id" x-text="field.label || field.name"></option>
                                             </template>
                                          </select>
                                       </div>

                                       <div>
                                          <select x-model="filter.operator" class="rw-select form-select text-xs h-9">
                                             <template x-for="op in wizardOperatorsForFilter(filter)" :key="op.value">
                                                <option :value="op.value" x-text="op.label"></option>
                                             </template>
                                          </select>
                                       </div>

                                       <div>
                                          <template x-if="wizardFilterUsesOptions(filter)">
                                             <select x-model="filter.value" class="rw-select form-select text-xs h-9">
                                                <option value="">Valeur...</option>
                                                <template x-for="opt in wizardFilterOptions(filter)" :key="opt.id || opt.value">
                                                   <option :value="opt.id || opt.value" x-text="opt.label"></option>
                                                </template>
                                             </select>
                                          </template>
                                          <template x-if="!wizardFilterUsesOptions(filter) && wizardFilterNeedsValue(filter)">
                                             <div class="flex gap-2">
                                                <input :type="wizardFilterInputType(filter)" x-model="filter.value" class="rw-input form-input text-xs h-9 w-full" placeholder="Valeur..." />
                                                <input x-show="wizardFilterNeedsSecondValue(filter)" :type="wizardFilterInputType(filter)" x-model="filter.value2" class="rw-input form-input text-xs h-9 w-full" placeholder="Fin..." />
                                             </div>
                                          </template>
                                          <template x-if="!wizardFilterNeedsValue(filter)">
                                             <div class="h-9 flex items-center px-3 rounded border border-dashed border-gray-200 dark:border-gray-700 text-xs text-gray-400">Aucune valeur</div>
                                          </template>
                                       </div>

                                       <div class="flex justify-end">
                                          <button type="button" class="rw-filter-remove" @click="removeWizardFilter(index)">
                                             <iconify-icon icon="solar:trash-bin-minimalistic-bold" width="17"></iconify-icon>
                                          </button>
                                       </div>
                                    </div>
                                 </template>

                                 <div x-show="!wizardFieldsLoading && wizardFilters.length === 0" class="py-8 text-center text-sm text-gray-400">
                                    Aucun filtre. Ajoutez une règle pour transformer cette collection en listing ciblé.
                                 </div>
                              </div>
                           </div>
                       </div>
                    </template>

                    <!-- Step 2B: Nouvelle -->
                    <template x-if="recordsWizardStep === 2 && recordsWizardMode === 'new'">
                       <div class="space-y-4">
                          <div class="rw-panel rw-panel-soft p-4 space-y-4">
                             <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                   <label class="rw-label">Nom singulier</label>
                                   <input type="text" x-model="wizardNewName" class="rw-input form-input w-full" placeholder="ex: Marche public" />
                                </div>
                                <div>
                                   <label class="rw-label">Nom pluriel</label>
                                   <input type="text" x-model="wizardNewPlural" class="rw-input form-input w-full" placeholder="ex: Marches publics" />
                                </div>
                             </div>

                             <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-4">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                   <div class="rw-control-card">
                                      <label class="rw-label">Icone</label>
                                      <div class="rw-icon-picker-wrap" @click.outside="wizardIconPickerOpen = false">
                                         <button type="button" class="rw-icon-trigger" @click="openWizardIconPicker()" :style="'--rw-accent:' + (wizardNewColor || '#4361ee')">
                                            <span class="rw-icon-tile">
                                               <iconify-icon :icon="wizardNewIcon || 'solar:database-bold-duotone'" width="19"></iconify-icon>
                                            </span>
                                            <span class="min-w-0 flex-1 truncate text-xs font-bold" x-text="wizardNewIcon || 'Choisir une icone'"></span>
                                            <iconify-icon icon="solar:alt-arrow-down-line-duotone" width="15" class="text-gray-400"></iconify-icon>
                                         </button>

                                         <div x-show="wizardIconPickerOpen" x-transition x-cloak class="rw-icon-popover">
                                            <div class="flex gap-2 mb-2">
                                               <select x-model="selectedLibrary" class="rw-select form-select text-xs h-9 w-32">
                                                  <template x-for="lib in libraries" :key="lib.id">
                                                     <option :value="lib.id" x-text="lib.name"></option>
                                                  </template>
                                               </select>
                                               <div class="relative flex-1">
                                                  <input type="text" x-model="iconSearch" class="rw-input form-input text-xs h-9 w-full pl-8" placeholder="Rechercher..." />
                                                  <iconify-icon icon="solar:magnifer-linear" class="absolute left-2.5 top-2.5 text-gray-400" width="14"></iconify-icon>
                                               </div>
                                            </div>

                                            <div class="rw-icon-grid custom-scrollbar" @scroll.debounce="if($el.scrollTop + $el.clientHeight >= $el.scrollHeight - 20) loadMoreIcons()">
                                               <template x-for="icon in icons" :key="icon">
                                                  <button type="button" class="rw-icon-option" :class="wizardNewIcon === icon ? 'is-active' : ''" @click="selectWizardIcon(icon)" :title="icon">
                                                     <iconify-icon :icon="icon" width="20"></iconify-icon>
                                                  </button>
                                               </template>
                                               <div x-show="icons.length === 0 && !isLoadingIcons" class="col-span-full py-5 text-center text-xs text-gray-400">Aucune icone trouvee</div>
                                               <div x-show="isLoadingIcons" class="col-span-full py-3 text-center">
                                                  <span class="animate-spin border-2 border-primary border-l-transparent rounded-full w-4 h-4 inline-block"></span>
                                               </div>
                                            </div>

                                            <input type="text" x-model="wizardNewIcon" class="rw-input form-input text-xs h-9 w-full mt-2" placeholder="solar:database-bold-duotone" />
                                         </div>
                                      </div>
                                   </div>

                                   <div class="rw-control-card">
                                      <label class="rw-label">Couleur</label>
                                      <div class="rw-color-palette">
                                         <template x-for="color in availableColors" :key="color">
                                            <button type="button" class="rw-color-swatch" :class="wizardNewColor === color ? 'is-active' : ''" :style="'background-color:' + color" @click="wizardNewColor = color">
                                               <iconify-icon x-show="wizardNewColor === color" icon="solar:check-circle-bold" class="text-white" width="15"></iconify-icon>
                                            </button>
                                         </template>
                                         <label class="rw-color-swatch relative overflow-hidden bg-white dark:bg-[#132238] border border-gray-200 dark:border-gray-800">
                                            <iconify-icon icon="solar:pen-new-square-linear" width="14" class="text-gray-500"></iconify-icon>
                                            <input type="color" x-model="wizardNewColor" class="absolute inset-0 opacity-0 cursor-pointer" title="Couleur personnalisee" />
                                         </label>
                                      </div>
                                   </div>
                                </div>

                                <div class="rw-collection-preview">
                                   <div class="flex items-center gap-3 min-w-0">
                                      <div class="rw-preview-icon" :style="'color:' + (wizardNewColor || '#4361ee')">
                                         <iconify-icon :icon="wizardNewIcon || 'solar:database-bold-duotone'" width="19"></iconify-icon>
                                      </div>
                                      <div class="min-w-0">
                                         <div class="text-sm font-bold text-gray-900 dark:text-white truncate" x-text="wizardNewPlural || wizardNewName || 'Nouvelle collection'"></div>
                                         <div class="text-[11px] text-gray-500 truncate" x-text="wizardNewName ? 'Entite : ' + wizardNewName : 'Entite personnalisee'"></div>
                                      </div>
                                   </div>
                                   <div class="mt-4 flex flex-wrap gap-2">
                                      <span class="rw-chip">Titre</span>
                                      <span class="rw-chip">Description</span>
                                      <span class="rw-chip" x-text="wizardSuggestedFields.length + ' champ(s)'"></span>
                                   </div>
                                </div>
                             </div>
                          </div>

                          <div class="rw-default-row">
                             <div>
                                <div class="text-sm font-bold text-gray-900 dark:text-white">Champs par defaut</div>
                                <div class="text-[11px] text-gray-500">Titre et description restent disponibles sur chaque record.</div>
                             </div>
                             <div class="flex flex-wrap gap-2 justify-end">
                                <span class="rw-default-pill"><iconify-icon icon="solar:text-bold" width="14"></iconify-icon> Titre</span>
                                <span class="rw-default-pill"><iconify-icon icon="solar:document-text-bold-duotone" width="14"></iconify-icon> Description</span>
                             </div>
                          </div>

                          <div class="rw-ai-panel">
                             <div class="rw-ai-head">
                                <div>
                                   <div class="text-sm font-bold text-gray-900 dark:text-white">Champs suggeres</div>
                                   <div class="text-[11px] text-gray-500">Generes depuis le nom de la collection, puis modifiables avant creation.</div>
                                </div>
                                <button type="button" @click="generateAIFields()" class="rw-ai-button" :disabled="!wizardNewName || isGeneratingAI">
                                   <iconify-icon :icon="isGeneratingAI ? 'solar:spinner-bold' : 'solar:magic-stick-3-bold'" :class="isGeneratingAI ? 'animate-spin' : ''" width="17"></iconify-icon>
                                   <span x-text="isGeneratingAI ? 'Analyse...' : 'Proposer avec IA'"></span>
                                </button>
                             </div>

                             <div class="p-4">
                                <div x-show="wizardSuggestedFields.length === 0" class="rw-empty-suggestions">
                                   Donnez un nom a la collection, puis genere les champs suggeres.
                                </div>

                                <div x-show="wizardSuggestedFields.length > 0" x-transition>
                                   <template x-for="(field, index) in wizardSuggestedFields" :key="field.name + '-' + index">
                                      <div class="rw-suggest-row">
                                         <input type="text" x-model="field.name" class="rw-input form-input text-xs h-9 w-full" />
                                         <select x-model="field.type" class="rw-select form-select text-xs h-9">
                                            <template x-for="type in wizardFieldTypeOptions" :key="type.value">
                                               <option :value="type.value" x-text="type.label"></option>
                                            </template>
                                         </select>
                                         <button type="button" class="rw-suggest-remove" @click="removeSuggestedField(index)">
                                            <iconify-icon icon="solar:trash-bin-minimalistic-bold" width="16"></iconify-icon>
                                         </button>
                                      </div>
                                   </template>
                                </div>

                                <div class="rw-suggest-row rw-suggest-row-add mt-3">
                                   <input type="text" x-model="wizardCustomFieldName" @keydown.enter.prevent="addSuggestedField()" class="rw-input form-input text-xs h-9 w-full" placeholder="Ajouter un champ..." />
                                   <select x-model="wizardCustomFieldType" class="rw-select form-select text-xs h-9">
                                      <template x-for="type in wizardFieldTypeOptions" :key="type.value">
                                         <option :value="type.value" x-text="type.label"></option>
                                      </template>
                                   </select>
                                   <button type="button" class="btn btn-outline-primary btn-sm h-9" @click="addSuggestedField()" :disabled="!wizardCustomFieldName">
                                      Ajouter
                                   </button>
                                </div>
                             </div>
                          </div>
                       </div>
                    </template>

                 </div>
                 
                 <!-- Footer Actions -->
                 <div x-show="recordsWizardStep === 2" class="rw-footer">
                     <button @click="recordsWizardStep = 1" class="btn btn-outline-danger btn-sm">Retour</button>
                     <button @click="validateRecordsWizard()" class="btn btn-primary btn-sm flex items-center gap-2" :disabled="recordsWizardSubmitting">
                        <iconify-icon :icon="recordsWizardSubmitting ? 'solar:spinner-bold' : 'solar:check-circle-bold'" :class="recordsWizardSubmitting ? 'animate-spin' : ''"></iconify-icon>
                        <span x-text="recordsWizardSubmitting ? 'Creation...' : (recordsWizardMode === 'existing' ? 'Valider' : 'Créer la collection')"></span>
                     </button>
                 </div>
             </div>
        </div>
        </template>

        <!-- CONFIG MODAL (Fixed at center) -->
        <template x-teleport="body">
        <div x-show="showViewConfigModal"
          class="fixed inset-0 z-[1000] flex items-center justify-center bg-black/50 p-4" x-cloak>
          <div class="bg-white dark:bg-[#1b2e4b] w-full max-w-xl rounded-xl shadow-2xl overflow-hidden"
            @click.outside="showViewConfigModal = false">
            <div class="p-6 border-b dark:border-gray-800 flex justify-between items-center">
              <h3 class="text-xl font-bold dark:text-white"
                x-text="'Configurer la vue : ' + (configView ? configView.name : '')"></h3>
              <button @click="showViewConfigModal = false" class="text-gray-400 hover:text-white transition-colors">
                <iconify-icon icon="solar:close-circle-bold" width="24"></iconify-icon>
              </button>
            </div>

            <div class="p-6 space-y-6 max-h-[70vh] overflow-y-auto custom-scrollbar">
              <!-- View Type Selector -->
              <div class="space-y-2">
                <label class="block text-sm font-semibold dark:text-gray-300">Type d'affichage</label>
                <div class="grid grid-cols-4 gap-3">
                  <template x-for="type in ['list', 'kanban', 'checklist', 'table']">
                    <button class="p-3 rounded-lg border-2 flex flex-col items-center gap-2 transition-all"
                      :class="tempViewType === type ? 'border-primary bg-primary/5 text-primary' : 'border-gray-100 dark:border-gray-800 text-gray-500 grayscale hover:grayscale-0 hover:border-primary/50'"
                      @click="tempViewType = type">
                      <iconify-icon :icon="getIcon(type === 'list' || type === 'table' ? 'entity' : type)"
                        width="24"></iconify-icon>
                      <span class="text-[10px] font-bold uppercase" x-text="type"></span>
                    </button>
                  </template>
                </div>
              </div>

              <!-- Filters Section -->
              <div class="space-y-4 pt-4 border-t dark:border-gray-800">
                <div class="flex items-center justify-between">
                  <label class="text-sm font-semibold dark:text-gray-300">Filtres dynamiques</label>
                  <button class="btn btn-sm btn-outline-primary" @click="addFilter()">
                    <iconify-icon icon="solar:add-circle-bold" class="mr-1"></iconify-icon> Ajouter un filtre
                  </button>
                </div>

                <div class="space-y-3">
                  <template x-for="(filter, index) in tempFilters" :key="index">
                    <div
                      class="flex items-center gap-2 bg-gray-50 dark:bg-black/20 p-3 rounded-lg border dark:border-gray-800">
                      <select x-model="filter.field" class="form-select flex-1 text-xs">
                        <option value="">Choisir un champ...</option>
                        <optgroup label="Standard">
                          <option value="title">Titre</option>
                          <option value="status">Statut</option>
                          <option value="createdAt">Date de création</option>
                        </optgroup>
                        <optgroup label="Personnalisé" x-show="configEntity">
                          <template x-for="f in (configEntity ? configEntity.customFields : [])" :key="f._id">
                            <option :value="f._id" x-text="f.label"></option>
                          </template>
                        </optgroup>
                      </select>
                      <select x-model="filter.operator" class="form-select w-28 text-xs">
                        <option value="equals">=</option>
                        <option value="not_equals">!=</option>
                        <option value="contains">contient</option>
                        <option value="greater_than">&gt;</option>
                        <option value="less_than">&lt;</option>
                      </select>
                      <input type="text" x-model="filter.value" class="form-input flex-1 text-xs"
                        placeholder="Valeur...">
                      <button class="text-red-500 p-1 hover:bg-red-50/10 rounded" @click="removeFilter(index)">
                        <iconify-icon icon="solar:trash-bin-minimalistic-bold" width="18"></iconify-icon>
                      </button>
                    </div>
                  </template>
                  <div x-show="tempFilters.length === 0" class="text-center py-4 text-gray-400 italic text-xs">
                    Aucun filtre actif (affiche tout)
                  </div>
                </div>
              </div>
            </div>

            <div class="p-6 border-t dark:border-gray-800 bg-gray-50 dark:bg-black/10 flex justify-end gap-3">
              <button class="btn btn-outline-danger" @click="showViewConfigModal = false">Annuler</button>
              <button class="btn btn-primary" @click="saveViewConfig()">Enregistrer les modifications</button>
            </div>
          </div>
        </div>
        </template>
    </div>
</div>
</nav>
</div>

<!-- ═══ Standalone Environment Modal (outside nav to avoid transform issues) ═══ -->
<div x-data="envModalComponent()">
  <div :style="modalOpen ? 'position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;display:flex;align-items:center;justify-content:center;' : 'display:none;'"
       @keydown.escape.window="modalOpen && (modalOpen = false)">
    <!-- Backdrop -->
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);backdrop-filter:blur(4px);" @click="modalOpen = false"></div>
    <!-- Dialog -->
    <div :style="'position:relative;width:' + (step === 'templates' ? '640px' : '380px') + ';max-height:90vh;overflow-y:auto;overflow-x:hidden;border-radius:16px;box-shadow:0 25px 50px -12px rgba(0,0,0,.25);background:#fff;transition:width 0.3s ease;'"
         class="dark:bg-[#1b2e4b]">

      <!-- ══════════════════════════════════════════ -->
      <!-- STEP 1: Template Selection (create only)  -->
      <!-- ══════════════════════════════════════════ -->
      <template x-if="step === 'templates'">
        <div>
          <!-- Header -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-gray-700">
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Nouvel environnement</h3>
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">Choisissez un modèle ou commencez à zéro</p>
            </div>
            <button @click="modalOpen = false" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
              <iconify-icon icon="solar:close-circle-bold" width="22"></iconify-icon>
            </button>
          </div>

          <!-- Template Cards -->
          <div class="px-6 py-5">
            <!-- Start From Scratch -->
            <button @click="selectScratch()"
                    class="w-full flex items-center gap-4 p-4 rounded-xl border-2 border-dashed border-gray-200 dark:border-gray-600 hover:border-primary hover:bg-primary/5 transition-all group mb-4">
              <div class="w-12 h-12 rounded-xl bg-gray-100 dark:bg-gray-700 flex items-center justify-center group-hover:bg-primary/10 transition-colors">
                <iconify-icon icon="solar:add-circle-bold-duotone" width="26" class="text-gray-400 group-hover:text-primary transition-colors"></iconify-icon>
              </div>
              <div class="text-left">
                <div class="text-sm font-semibold text-gray-700 dark:text-gray-300 group-hover:text-primary">Environnement vide</div>
                <div class="text-xs text-gray-400 dark:text-gray-500">Créez de zéro et ajoutez vos propres collections</div>
              </div>
              <iconify-icon icon="solar:alt-arrow-right-linear" width="18" class="ml-auto text-gray-300 group-hover:text-primary transition-colors"></iconify-icon>
            </button>

            <!-- Separator -->
            <div class="flex items-center gap-3 mb-4">
              <div class="h-px bg-gray-200 dark:bg-gray-700 flex-1"></div>
              <span class="text-xs font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wider">Démo</span>
              <div class="h-px bg-gray-200 dark:bg-gray-700 flex-1"></div>
            </div>

            <!-- Loading -->
            <div x-show="loadingTemplates" class="flex items-center justify-center py-8">
              <div class="animate-spin w-6 h-6 border-2 border-primary border-t-transparent rounded-full"></div>
            </div>

            <!-- Template Grid -->
            <div x-show="!loadingTemplates" class="grid grid-cols-2 gap-3 max-h-[50vh] overflow-y-auto custom-scrollbar pr-1">
              <template x-for="tpl in templates" :key="tpl._id">
                <button @click="selectTemplate(tpl)"
                        class="flex flex-col items-start p-4 rounded-xl border border-gray-200 dark:border-gray-600 hover:shadow-lg transition-all group text-left relative overflow-hidden"
                        :class="selectedTemplateId === tpl._id ? 'ring-2 ring-primary border-primary bg-primary/5' : 'hover:border-gray-300 dark:hover:border-gray-500'">
                  <!-- Decorative gradient top -->
                  <div class="absolute top-0 left-0 right-0 h-1 rounded-t-xl" :style="'background:' + (tpl.color || '#4361ee')"></div>
                  <!-- Icon -->
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3 transition-all"
                       :style="'background:' + (tpl.color || '#4361ee') + '15'">
                    <iconify-icon :icon="tpl.icon || 'solar:widget-bold-duotone'" width="22" :style="'color:' + (tpl.color || '#4361ee')"></iconify-icon>
                  </div>
                  <!-- Text -->
                  <div class="text-sm font-semibold text-gray-800 dark:text-gray-200 mb-1" x-text="tpl.name"></div>
                  <div class="text-[11px] text-gray-400 dark:text-gray-500 leading-snug line-clamp-2" x-text="tpl.description"></div>
                  <!-- Entity count badge -->
                  <div class="mt-2 flex items-center gap-1.5">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400">
                      <iconify-icon icon="solar:database-linear" width="10"></iconify-icon>
                      <span x-text="(tpl.entities || []).length + ' collections'"></span>
                    </span>
                    <template x-if="tpl.featured">
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400">
                        <iconify-icon icon="solar:star-bold" width="10"></iconify-icon>
                        Populaire
                      </span>
                    </template>
                  </div>
                  <!-- Check overlay when selected -->
                  <div x-show="selectedTemplateId === tpl._id" 
                       class="absolute top-2 right-2 w-5 h-5 rounded-full bg-primary flex items-center justify-center">
                    <iconify-icon icon="solar:check-read-linear" width="12" class="text-white"></iconify-icon>
                  </div>
                </button>
              </template>
            </div>

            <!-- No templates fallback -->
            <div x-show="!loadingTemplates && templates.length === 0" class="text-center py-8">
              <iconify-icon icon="solar:box-bold-duotone" width="36" class="text-gray-300 dark:text-gray-600"></iconify-icon>
              <p class="text-sm text-gray-400 mt-2">Aucun modèle disponible</p>
            </div>
          </div>

          <!-- Footer -->
          <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center">
            <button @click="modalOpen = false"
                    class="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-colors">
              Annuler
            </button>
            <button @click="goToCustomize()"
                    x-show="selectedTemplateId"
                    class="px-5 py-2 text-sm font-semibold text-white rounded-xl transition-all hover:shadow-lg bg-primary">
              Suivant
              <iconify-icon icon="solar:alt-arrow-right-linear" width="16" class="ml-1"></iconify-icon>
            </button>
          </div>
        </div>
      </template>

      <!-- ══════════════════════════════════════════ -->
      <!-- STEP 2: Customize Environment              -->
      <!-- ══════════════════════════════════════════ -->
      <template x-if="step === 'customize'">
        <div>
          <!-- Modal Header -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-gray-700">
            <div class="flex items-center gap-3">
              <template x-if="!editingEnv">
                <button @click="step = 'templates'; selectedTemplateId = null" class="text-gray-400 hover:text-primary transition-colors">
                  <iconify-icon icon="solar:alt-arrow-left-linear" width="20"></iconify-icon>
                </button>
              </template>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white" x-text="editingEnv ? 'Modifier' : (selectedTemplateId ? 'Personnaliser' : 'Nouvel environnement')"></h3>
                <template x-if="selectedTemplateObj">
                  <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5 flex items-center gap-1">
                    <iconify-icon :icon="selectedTemplateObj.icon" width="12" :style="'color:' + selectedTemplateObj.color"></iconify-icon>
                    <span>Modèle : </span><span x-text="selectedTemplateObj.name" class="font-medium"></span>
                  </p>
                </template>
              </div>
            </div>
            <button @click="modalOpen = false" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
              <iconify-icon icon="solar:close-circle-bold" width="22"></iconify-icon>
            </button>
          </div>

          <!-- Modal Body -->
          <div class="px-6 py-5 space-y-5">
            <!-- Preview (clickable to upload image) -->
            <div class="flex flex-col items-center justify-center gap-2">
              <div class="relative group cursor-pointer" @click="$refs.envImageInput.click()">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center shadow-lg transition-all duration-300 overflow-hidden"
                     :style="'background:' + formColor + '20; border: 2px solid ' + formColor + '40'">
                  <template x-if="formImage">
                    <img :src="formImage" class="w-full h-full object-cover" :alt="formName">
                  </template>
                  <template x-if="!formImage">
                    <iconify-icon :icon="formIcon" width="32" height="32" :style="'color:' + formColor"></iconify-icon>
                  </template>
                </div>
                <!-- Upload overlay on hover -->
                <div class="absolute inset-0 rounded-2xl flex items-center justify-center bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity">
                  <iconify-icon icon="solar:camera-bold" width="20" class="text-white"></iconify-icon>
                </div>
              </div>
              <input type="file" x-ref="envImageInput" accept="image/*" class="hidden" @change="uploadImage($event)">
              <!-- Remove image button (only visible when image is set) -->
              <template x-if="formImage">
                <button @click.stop="removeImage()" class="text-xs text-red-500 hover:text-red-600 flex items-center gap-1 transition-colors">
                  <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="12"></iconify-icon>
                  Supprimer l'image
                </button>
              </template>
              <template x-if="!formImage">
                <span class="text-xs text-gray-400 dark:text-gray-500">Cliquer pour ajouter un logo</span>
              </template>
            </div>

            <!-- Name -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Nom</label>
              <input type="text" x-model="formName" x-ref="envNameInput"
                     placeholder="Ex: Production, CRM, RH..."
                     class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none transition-all text-sm">
            </div>

            <!-- Template Info (shown when template selected) -->
            <template x-if="selectedTemplateObj && !editingEnv">
              <div class="rounded-xl border border-gray-200 dark:border-gray-600 p-3 bg-gray-50/50 dark:bg-gray-800/50">
                <div class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-2 flex items-center gap-1.5">
                  <iconify-icon icon="solar:widget-4-bold-duotone" width="14"></iconify-icon>
                  Collections qui seront créées
                </div>
                <div class="flex flex-wrap gap-1.5">
                  <template x-for="ent in (selectedTemplateObj.entities || [])" :key="ent.templateSlug">
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-300">
                      <iconify-icon icon="solar:database-linear" width="12" class="text-gray-400"></iconify-icon>
                      <span x-text="ent.name || ent.templateSlug"></span>
                    </span>
                  </template>
                </div>
              </div>
            </template>

            <!-- Icon -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Icône</label>
              <!-- Library + Search -->
              <div class="flex gap-2 mb-2">
                <select x-model="selectedLibrary" @change="searchIcons()"
                        class="w-1/3 px-2 py-2 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white text-xs outline-none">
                  <template x-for="lib in libraries" :key="lib.id">
                    <option :value="lib.id" x-text="lib.name"></option>
                  </template>
                </select>
                <div class="relative flex-1">
                  <input type="text" x-model="iconSearch" placeholder="Rechercher une icône..."
                         @input.debounce.300ms="searchIcons()"
                         class="w-full px-4 py-2 pl-9 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white text-xs focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none transition-all">
                  <iconify-icon icon="solar:magnifer-linear" width="14" class="absolute left-3 top-2.5 text-gray-400"></iconify-icon>
                </div>
              </div>
              <div style="display:grid;grid-template-columns:repeat(8,1fr);gap:4px;margin-top:8px;max-height:128px;overflow-y:auto;padding:4px;border-radius:12px;border:1px solid #f3f4f6;" class="custom-scrollbar dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
                <template x-for="ic in iconResults" :key="ic">
                  <button @click="formIcon = ic"
                          class="w-8 h-8 rounded-lg flex items-center justify-center cursor-pointer transition-all hover:bg-white dark:hover:bg-gray-700"
                          :class="formIcon === ic ? 'ring-2 ring-primary bg-primary/10' : ''">
                    <iconify-icon :icon="ic" width="18" :style="formIcon === ic ? 'color:' + formColor : ''"></iconify-icon>
                  </button>
                </template>
              </div>
            </div>

            <!-- Color -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Couleur</label>
              <div class="flex items-center gap-2 flex-wrap">
                <template x-for="c in presetColors" :key="c">
                  <button @click="formColor = c"
                          class="w-7 h-7 rounded-full cursor-pointer transition-all hover:scale-110 border-2"
                          :style="'background:' + c"
                          :class="formColor === c ? 'border-gray-900 dark:border-white scale-110 shadow-lg' : 'border-transparent'">
                  </button>
                </template>
                <div class="relative w-7 h-7 rounded-full border-2 border-dashed border-gray-300 cursor-pointer overflow-hidden flex items-center justify-center hover:border-gray-400 transition-colors">
                  <iconify-icon icon="solar:palette-bold" width="14" class="text-gray-400 pointer-events-none"></iconify-icon>
                  <input type="color" x-model="formColor" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
                </div>
              </div>
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 flex justify-end gap-3">
            <button @click="modalOpen = false"
                    class="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-colors">
              Annuler
            </button>
            <button @click="saveEnvironment()"
                    class="px-5 py-2 text-sm font-semibold text-white rounded-xl transition-all hover:shadow-lg flex items-center gap-2"
                    :style="'background:' + formColor"
                    :disabled="!formName.trim() || isSubmitting || checkingConflicts">
              <template x-if="isSubmitting || checkingConflicts">
                <div class="animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full"></div>
              </template>
              <span x-text="checkingConflicts ? 'Vérification...' : (editingEnv ? 'Enregistrer' : (selectedTemplateId ? 'Créer depuis le modèle' : 'Créer'))"></span>
            </button>
          </div>
        </div>
      </template>

      <!-- ══════════════════════════════════════════ -->
      <!-- STEP 3: Conflict Resolution                -->
      <!-- ══════════════════════════════════════════ -->
      <template x-if="step === 'conflicts'">
        <div>
          <!-- Modal Header -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-gray-700">
            <div class="flex items-center gap-3">
              <button @click="step = 'customize'" class="text-gray-400 hover:text-primary transition-colors">
                <iconify-icon icon="solar:alt-arrow-left-linear" width="20"></iconify-icon>
              </button>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Collections existantes détectées</h3>
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">
                  <span x-text="conflicts.length"></span> collection(s) avec le même nom existe(nt) déjà
                </p>
              </div>
            </div>
            <button @click="modalOpen = false" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
              <iconify-icon icon="solar:close-circle-bold" width="22"></iconify-icon>
            </button>
          </div>

          <!-- Modal Body -->
          <div class="px-6 py-5">
            <!-- Warning Banner -->
            <div class="flex items-start gap-3 p-4 rounded-xl bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800/30 mb-5">
              <iconify-icon icon="solar:danger-triangle-bold-duotone" width="24" class="text-amber-500 flex-shrink-0 mt-0.5"></iconify-icon>
              <div>
                <p class="text-sm font-semibold text-amber-800 dark:text-amber-300">Attention</p>
                <p class="text-xs text-amber-700 dark:text-amber-400 mt-1 leading-relaxed">
                  Certaines collections du modèle existent déjà dans votre espace de travail. 
                  Choisissez pour chaque collection si vous souhaitez <strong>écraser</strong> (supprimer l'existante et la remplacer) 
                  ou <strong>renommer</strong> (garder l'existante et créer une nouvelle collection avec un suffixe).
                </p>
              </div>
            </div>

            <!-- Conflict Cards -->
            <div class="space-y-3 max-h-[40vh] overflow-y-auto custom-scrollbar pr-1">
              <template x-for="conflict in conflicts" :key="conflict.templateSlug">
                <div class="rounded-xl border transition-all duration-200"
                     :class="conflictOverrides[conflict.templateSlug] === 'override' 
                       ? 'border-red-300 dark:border-red-700 bg-red-50/50 dark:bg-red-900/10' 
                       : 'border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800/50'">
                  
                  <!-- Entity Info -->
                  <div class="flex items-center gap-3 px-4 py-3">
                    <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
                         :style="'background:' + (conflict.color || '#4361ee') + '15'">
                      <iconify-icon :icon="conflict.icon || 'solar:database-bold-duotone'" width="20" 
                                    :style="'color:' + (conflict.color || '#4361ee')"></iconify-icon>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-semibold text-gray-800 dark:text-gray-200" x-text="conflict.entityName"></div>
                      <div class="flex items-center gap-1.5 mt-0.5">
                        <iconify-icon icon="solar:danger-circle-bold" width="12" class="text-amber-500"></iconify-icon>
                        <span class="text-[11px] text-gray-500 dark:text-gray-400">
                          Slug <code class="bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded text-[10px] font-mono" x-text="conflict.existingSlug"></code> déjà utilisé par « <span x-text="conflict.existingEntityName" class="font-medium"></span> »
                        </span>
                      </div>
                    </div>
                  </div>

                  <!-- Action Buttons -->
                  <div class="flex gap-2 px-4 pb-3">
                    <!-- Rename (safe option) -->
                    <button @click="conflictOverrides[conflict.templateSlug] = 'rename'"
                            class="flex-1 flex items-center justify-center gap-2 px-3 py-2 rounded-lg text-xs font-semibold transition-all"
                            :class="conflictOverrides[conflict.templateSlug] === 'rename' 
                              ? 'bg-blue-500 text-white shadow-sm shadow-blue-500/20' 
                              : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-600'">
                      <iconify-icon icon="solar:copy-bold-duotone" width="14"></iconify-icon>
                      Renommer (garder l'existante)
                    </button>
                    <!-- Override (destructive option) -->
                    <button @click="conflictOverrides[conflict.templateSlug] = 'override'"
                            class="flex-1 flex items-center justify-center gap-2 px-3 py-2 rounded-lg text-xs font-semibold transition-all"
                            :class="conflictOverrides[conflict.templateSlug] === 'override' 
                              ? 'bg-red-500 text-white shadow-sm shadow-red-500/20' 
                              : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-600'">
                      <iconify-icon icon="solar:refresh-circle-bold-duotone" width="14"></iconify-icon>
                      Écraser (remplacer)
                    </button>
                  </div>
                </div>
              </template>
            </div>

            <!-- Override all / Rename all shortcuts -->
            <div class="flex gap-2 mt-4 pt-3 border-t border-gray-100 dark:border-gray-700">
              <button @click="conflicts.forEach(c => { conflictOverrides[c.templateSlug] = 'rename' })"
                      class="flex-1 text-xs text-center py-2 rounded-lg bg-gray-50 dark:bg-gray-800 text-gray-500 dark:text-gray-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium">
                <iconify-icon icon="solar:copy-bold-duotone" width="12" class="mr-1"></iconify-icon>
                Tout renommer
              </button>
              <button @click="conflicts.forEach(c => { conflictOverrides[c.templateSlug] = 'override' })"
                      class="flex-1 text-xs text-center py-2 rounded-lg bg-gray-50 dark:bg-gray-800 text-gray-500 dark:text-gray-400 hover:bg-red-50 dark:hover:bg-red-900/20 hover:text-red-600 dark:hover:text-red-400 transition-colors font-medium">
                <iconify-icon icon="solar:refresh-circle-bold-duotone" width="12" class="mr-1"></iconify-icon>
                Tout écraser
              </button>
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center">
            <button @click="step = 'customize'"
                    class="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-colors">
              Retour
            </button>
            <button @click="applyTemplate()"
                    class="px-5 py-2 text-sm font-semibold text-white rounded-xl transition-all hover:shadow-lg flex items-center gap-2 bg-primary"
                    :disabled="isSubmitting">
              <template x-if="isSubmitting">
                <div class="animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full"></div>
              </template>
              <iconify-icon icon="solar:check-circle-bold" width="16"></iconify-icon>
              Appliquer le modèle
            </button>
          </div>
        </div>
      </template>

    </div>
  </div>
</div>


<script>
  function envModalComponent() {
    return {
      modalOpen: false,
      editingEnv: null,
      formName: '',
      formIcon: 'solar:planet-3-bold-duotone',
      formColor: '#6366f1',
      formImage: '',
      uploadingImage: false,
      isSubmitting: false,
      iconSearch: '',
      iconResults: [],
      selectedLibrary: 'solar',
      libraries: [],

      // Template selection state
      step: 'templates', // 'templates', 'customize', or 'conflicts'
      templates: [],
      loadingTemplates: false,
      selectedTemplateId: null,
      selectedTemplateObj: null,

      // Conflict resolution state
      conflicts: [],
      conflictOverrides: {}, // { templateSlug: 'override' | 'rename' }
      checkingConflicts: false,

      presetColors: [
        '#6366f1', '#8b5cf6', '#ec4899', '#ef4444', '#f97316',
        '#eab308', '#22c55e', '#14b8a6', '#06b6d4', '#3b82f6',
        '#6d28d9', '#dc2626', '#059669', '#0891b2', '#7c3aed'
      ],

      defaultIcons: [
        'solar:planet-3-bold-duotone',
        'solar:star-bold-duotone',
        'solar:home-2-bold-duotone',
        'solar:buildings-3-bold-duotone',
        'solar:chart-square-bold-duotone',
        'solar:users-group-rounded-bold-duotone',
        'solar:inbox-bold-duotone',
        'solar:rocket-2-bold-duotone',
        'solar:folder-favourite-bookmark-bold-duotone',
        'solar:widget-5-bold-duotone',
        'solar:heart-pulse-bold-duotone',
        'solar:diploma-verified-bold-duotone',
        'solar:bookmark-square-bold-duotone',
        'solar:database-bold-duotone',
        'solar:shield-check-bold-duotone',
        'solar:fire-bold-duotone',
        'solar:bill-list-bold-duotone',
        'solar:shop-2-bold-duotone',
        'solar:laptop-minimalistic-bold-duotone',
        'solar:case-round-bold-duotone',
        'solar:pie-chart-2-bold-duotone',
        'solar:bolt-circle-bold-duotone',
        'solar:medal-ribbon-bold-duotone',
        'solar:compass-big-bold-duotone'
      ],

      init() {
        this.iconResults = [...this.defaultIcons];
        this.loadLibraries();
        // Listen for open-env-modal events from the mini-rail
        window.addEventListener('open-env-modal', (e) => {
          const env = e.detail?.env || null;
          if (env) {
            // Edit mode — skip template step
            this.editingEnv = env;
            this.formName = env.name;
            this.formIcon = env.icon;
            this.formColor = env.color;
            this.formImage = env.image || '';
            this.step = 'customize';
            this.selectedTemplateId = null;
            this.selectedTemplateObj = null;
          } else {
            // Create mode — show template step
            this.editingEnv = null;
            this.formName = '';
            this.formIcon = 'solar:planet-3-bold-duotone';
            this.formColor = this.presetColors[Math.floor(Math.random() * this.presetColors.length)];
            this.formImage = '';
            this.step = 'templates';
            this.selectedTemplateId = null;
            this.selectedTemplateObj = null;
            this.conflicts = [];
            this.conflictOverrides = {};
            this.checkingConflicts = false;
            this.fetchTemplates();
          }
          this.isSubmitting = false;
          this.iconSearch = '';
          this.iconResults = [...this.defaultIcons];
          // Force a clean false→true cycle to ensure Alpine detects the change
          // (handles case where modalOpen is already true from stale state)
          this.modalOpen = false;
          this.$nextTick(() => {
            this.modalOpen = true;
            this.$nextTick(() => {
              if (this.step === 'customize' && this.$refs.envNameInput) this.$refs.envNameInput.focus();
            });
          });
        });
      },

      async fetchTemplates() {
        if (this.templates.length > 0) return; // cache
        this.loadingTemplates = true;
        const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
        try {
          const res = await fetch(`/account/${accountNum}/api/space-templates`);
          if (res.ok) {
            const data = await res.json();
            this.templates = data.templates || [];
          }
        } catch (err) {
          console.error('[EnvModal] Fetch templates error:', err);
        } finally {
          this.loadingTemplates = false;
        }
      },

      selectTemplate(tpl) {
        this.selectedTemplateId = tpl._id;
        this.selectedTemplateObj = tpl;
      },

      selectScratch() {
        this.selectedTemplateId = null;
        this.selectedTemplateObj = null;
        this.formName = '';
        this.formIcon = 'solar:planet-3-bold-duotone';
        this.formColor = this.presetColors[Math.floor(Math.random() * this.presetColors.length)];
        this.formImage = '';
        this.step = 'customize';
        this.$nextTick(() => {
          if (this.$refs.envNameInput) this.$refs.envNameInput.focus();
        });
      },

      goToCustomize() {
        if (!this.selectedTemplateObj) return;
        // Pre-fill form from template
        this.formName = this.selectedTemplateObj.name;
        this.formIcon = this.selectedTemplateObj.icon || 'solar:planet-3-bold-duotone';
        this.formColor = this.selectedTemplateObj.color || '#6366f1';
        this.formImage = '';
        this.step = 'customize';
        this.$nextTick(() => {
          if (this.$refs.envNameInput) this.$refs.envNameInput.focus();
        });
      },

      async loadLibraries() {
        const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
        try {
          const res = await fetch(`/account/${accountNum}/api/hierarchy/icon-libraries`);
          if (res.ok) {
            const data = await res.json();
            this.libraries = data.libraries || [];
            if (this.libraries.length > 0 && !this.libraries.find(l => l.id === this.selectedLibrary)) {
              this.selectedLibrary = this.libraries[0].id;
            }
          }
        } catch (e) { console.error('Failed to load env modal libraries', e); }
      },

      async saveEnvironment() {
        if (!this.formName.trim() || this.isSubmitting) return;
        this.isSubmitting = true;
        const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];

        try {
          if (this.editingEnv) {
            // ─── Update existing ───
            await fetch(`/account/${accountNum}/api/hierarchy/environment/update`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id: this.editingEnv.id,
                name: this.formName.trim(),
                icon: this.formIcon,
                color: this.formColor,
                image: this.formImage
              })
            });
            this.modalOpen = false;
            window.dispatchEvent(new CustomEvent('env-modal-saved', { detail: {} }));

          } else if (this.selectedTemplateId) {
            // ─── Create from template: first check for conflicts ───
            this.checkingConflicts = true;
            const checkRes = await fetch(`/account/${accountNum}/api/space-templates/${this.selectedTemplateId}/check-conflicts`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ envName: this.formName.trim() })
            });
            const checkData = await checkRes.json();
            this.checkingConflicts = false;

            if (checkData.hasConflicts && checkData.conflicts.length > 0) {
              // Show conflicts step — user needs to decide per-entity
              this.conflicts = checkData.conflicts;
              this.conflictOverrides = {};
              checkData.conflicts.forEach(c => {
                this.conflictOverrides[c.templateSlug] = 'rename'; // default: rename
              });
              this.step = 'conflicts';
              this.isSubmitting = false;
              return;
            }

            // No conflicts — apply directly
            await this.applyTemplate();
            return;

          } else {
            // ─── Create empty ───
            const res = await fetch(`/account/${accountNum}/api/hierarchy/environment`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: this.formName.trim(),
                icon: this.formIcon,
                color: this.formColor,
                image: this.formImage
              })
            });
            const data = await res.json();
            this.modalOpen = false;
            if (data.success && data.environment) {
              window.dispatchEvent(new CustomEvent('env-modal-saved', { detail: { newEnv: data.environment } }));
            } else {
              window.dispatchEvent(new CustomEvent('env-modal-saved', { detail: {} }));
            }
          }
        } catch (err) {
          console.error('[EnvModal] Save error:', err);
          alert('Erreur lors de la sauvegarde');
        } finally {
          this.isSubmitting = false;
        }
      },

      async applyTemplate() {
        this.isSubmitting = true;
        const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
        try {
          const res = await fetch(`/account/${accountNum}/api/space-templates/${this.selectedTemplateId}/apply`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              envName: this.formName.trim(),
              envIcon: this.formIcon,
              envColor: this.formColor,
              envImage: this.formImage,
              overrides: this.conflictOverrides || {}
            })
          });
          const data = await res.json();
          this.modalOpen = false;
          if (data.success && data.environment) {
            window.dispatchEvent(new CustomEvent('env-modal-saved', { detail: { newEnv: data.environment } }));
          } else {
            window.dispatchEvent(new CustomEvent('env-modal-saved', { detail: {} }));
          }
        } catch (err) {
          console.error('[EnvModal] Apply template error:', err);
          alert('Erreur lors de l\'application du modèle');
        } finally {
          this.isSubmitting = false;
        }
      },

      async uploadImage(event) {
        const file = event.target.files[0];
        if (!file) return;
        this.uploadingImage = true;
        const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
        try {
          const formData = new FormData();
          formData.append('image', file);
          const res = await fetch(`/account/${accountNum}/api/hierarchy/environment/upload-image`, {
            method: 'POST',
            body: formData
          });
          const data = await res.json();
          if (data.success && data.imagePath) {
            this.formImage = data.imagePath;
          }
        } catch (err) {
          console.error('[EnvModal] Image upload error:', err);
        } finally {
          this.uploadingImage = false;
          // Reset file input
          event.target.value = '';
        }
      },

      removeImage() {
        this.formImage = '';
      },

      async searchIcons() {
        if (!this.iconSearch.trim()) {
          this.iconResults = [...this.defaultIcons];
          return;
        }
        const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
        try {
          const library = this.selectedLibrary || 'solar';
          const res = await fetch(`/account/${accountNum}/api/hierarchy/icons?library=${library}&search=${encodeURIComponent(this.iconSearch.trim())}&page=1&limit=32`);
          if (res.ok) {
            const data = await res.json();
            this.iconResults = data.icons || [];
            if (this.iconResults.length === 0) {
              this.iconResults = [...this.defaultIcons];
            }
          }
        } catch (err) {
          console.error('[EnvModal] Icon search error:', err);
        }
      }
    };
  }
</script>

<!-- ═══ Standalone Space Modal (outside nav to avoid transform issues) ═══ -->
<div x-data="spaceModalComponent()">
  <div :style="modalOpen ? 'position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;display:flex;align-items:center;justify-content:center;' : 'display:none;'"
       @keydown.escape.window="modalOpen && (modalOpen = false)">
    <!-- Backdrop -->
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);backdrop-filter:blur(4px);" @click="modalOpen = false"></div>
    <!-- Dialog -->
    <div style="position:relative;width:400px;max-height:90vh;overflow-y:auto;overflow-x:hidden;border-radius:16px;box-shadow:0 25px 50px -12px rgba(0,0,0,.25);background:#fff;"
         class="dark:bg-[#1b2e4b]">

      <!-- Modal Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-gray-700">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white" x-text="editingSpace ? 'Modifier l\'espace' : 'Nouvel espace'"></h3>
        <button @click="modalOpen = false" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
          <iconify-icon icon="solar:close-circle-bold" width="22"></iconify-icon>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="px-6 py-5 space-y-5">
        <!-- Preview -->
        <div class="flex items-center justify-center">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center shadow-lg transition-all duration-300"
               :style="'background:' + (formColor || '#4361ee') + '20; border: 2px solid ' + (formColor || '#4361ee') + '40'">
            <iconify-icon :icon="formIcon" width="32" height="32" :style="'color:' + (formColor || '#4361ee')"></iconify-icon>
          </div>
        </div>

        <!-- Name -->
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Nom de l'espace</label>
          <input type="text" x-model="formName" x-ref="spaceNameInput"
                 placeholder="Ex: Ventes, Marketing, Support..."
                 class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none transition-all text-sm">
        </div>

        <!-- Icon with Library Selector -->
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Icône</label>
          <!-- Library + Search -->
          <div class="flex gap-2 mb-2">
            <select x-model="selectedLibrary" @change="searchIcons()"
                    class="w-1/3 px-2 py-2 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white text-xs outline-none">
              <template x-for="lib in libraries" :key="lib.id">
                <option :value="lib.id" x-text="lib.name"></option>
              </template>
            </select>
            <div class="relative flex-1">
              <input type="text" x-model="iconSearch" placeholder="Rechercher une icône..."
                     @input.debounce.300ms="searchIcons()"
                     class="w-full px-4 py-2 pl-9 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white text-xs focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none transition-all">
              <iconify-icon icon="solar:magnifer-linear" width="14" class="absolute left-3 top-2.5 text-gray-400"></iconify-icon>
            </div>
          </div>
          <!-- Icon Grid -->
          <div style="display:grid;grid-template-columns:repeat(8,1fr);gap:4px;max-height:140px;overflow-y:auto;padding:4px;border-radius:12px;border:1px solid #f3f4f6;" class="custom-scrollbar dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
            <template x-for="ic in iconResults" :key="ic">
              <button type="button" @click="formIcon = ic"
                      class="w-8 h-8 rounded-lg flex items-center justify-center cursor-pointer transition-all hover:bg-white dark:hover:bg-gray-700"
                      :class="formIcon === ic ? 'ring-2 ring-primary bg-primary/10' : ''">
                <iconify-icon :icon="ic" width="18" :style="formIcon === ic ? 'color:' + (formColor || '#4361ee') : ''"></iconify-icon>
              </button>
            </template>
            <template x-if="iconResults.length === 0">
              <div class="col-span-8 text-center py-4 text-xs text-gray-400">Aucune icône trouvée</div>
            </template>
          </div>
          <!-- Manual icon input -->
          <input type="text" x-model="formIcon" class="mt-2 w-full px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-xs text-gray-600 dark:text-gray-400"
                 placeholder="ou saisir un nom d'icône (ex: solar:star-bold-duotone)">
        </div>

        <!-- Color -->
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Couleur</label>
          <div class="flex items-center gap-2 flex-wrap">
            <template x-for="c in presetColors" :key="c">
              <button type="button" @click="formColor = c"
                      class="w-7 h-7 rounded-full cursor-pointer transition-all hover:scale-110 border-2"
                      :style="'background:' + c"
                      :class="formColor === c ? 'border-gray-900 dark:border-white scale-110 shadow-lg' : 'border-transparent'">
              </button>
            </template>
            <div class="relative w-7 h-7 rounded-full border-2 border-dashed border-gray-300 cursor-pointer overflow-hidden flex items-center justify-center hover:border-gray-400 transition-colors">
              <iconify-icon icon="solar:palette-bold" width="14" class="text-gray-400 pointer-events-none"></iconify-icon>
              <input type="color" x-model="formColor" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
            </div>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 flex justify-end gap-3">
        <button @click="modalOpen = false"
                class="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-colors">
          Annuler
        </button>
        <button @click="saveSpace()"
                class="px-5 py-2 text-sm font-semibold text-white rounded-xl transition-all hover:shadow-lg"
                :style="'background:' + (formColor || '#4361ee')"
                :disabled="!formName.trim() || isSaving">
          <span x-show="isSaving" class="animate-spin border-2 border-white border-l-transparent rounded-full w-4 h-4 inline-block align-middle mr-1"></span>
          <span x-text="editingSpace ? 'Enregistrer' : 'Créer'"></span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function spaceModalComponent() {
    return {
      modalOpen: false,
      editingSpace: null,
      environmentId: null,
      formName: '',
      formIcon: 'solar:share-circle-bold-duotone',
      formColor: '#4361ee',
      iconSearch: '',
      iconResults: [],
      isSaving: false,
      selectedLibrary: 'solar',
      libraries: [],

      presetColors: [
        '#4361ee', '#805dca', '#00ab55', '#e7515a', '#e2a03f',
        '#2196f3', '#6366f1', '#8b5cf6', '#ec4899', '#14b8a6',
        '#06b6d4', '#3b82f6', '#dc2626', '#059669', '#7c3aed'
      ],

      defaultIcons: [
        'solar:share-circle-bold-duotone',
        'solar:bag-heart-bold-duotone',
        'solar:magnet-bold-duotone',
        'solar:chat-round-call-bold-duotone',
        'solar:users-group-rounded-bold-duotone',
        'solar:wallet-bold-duotone',
        'solar:bill-list-bold-duotone',
        'solar:rocket-2-bold-duotone',
        'solar:star-bold-duotone',
        'solar:folder-favourite-bookmark-bold-duotone',
        'solar:widget-5-bold-duotone',
        'solar:home-2-bold-duotone',
        'solar:buildings-3-bold-duotone',
        'solar:chart-square-bold-duotone',
        'solar:inbox-bold-duotone',
        'solar:heart-pulse-bold-duotone',
        'solar:diploma-verified-bold-duotone',
        'solar:bookmark-square-bold-duotone',
        'solar:database-bold-duotone',
        'solar:shield-check-bold-duotone',
        'solar:fire-bold-duotone',
        'solar:shop-2-bold-duotone',
        'solar:laptop-minimalistic-bold-duotone',
        'solar:case-round-bold-duotone'
      ],

      init() {
        this.iconResults = [...this.defaultIcons];
        this.loadLibraries();

        // Listen for open-space-modal events
        window.addEventListener('open-space-modal', (e) => {
          const space = e.detail?.space || null;
          this.environmentId = e.detail?.environmentId || null;
          if (space) {
            // Edit mode
            this.editingSpace = space;
            this.formName = space.name;
            this.formIcon = space.icon || 'solar:share-circle-bold-duotone';
            this.formColor = space.color || '#4361ee';
          } else {
            // Create mode
            this.editingSpace = null;
            this.formName = '';
            this.formIcon = 'solar:share-circle-bold-duotone';
            this.formColor = this.presetColors[Math.floor(Math.random() * this.presetColors.length)];
          }
          this.iconSearch = '';
          this.iconResults = [...this.defaultIcons];
          this.modalOpen = true;
          this.$nextTick(() => {
            if (this.$refs.spaceNameInput) this.$refs.spaceNameInput.focus();
          });
        });
      },

      async loadLibraries() {
        const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
        try {
          const res = await fetch(`/account/${accountNum}/api/hierarchy/icon-libraries`);
          if (res.ok) {
            const data = await res.json();
            this.libraries = data.libraries || [];
            if (this.libraries.length > 0 && !this.libraries.find(l => l.id === this.selectedLibrary)) {
              this.selectedLibrary = this.libraries[0].id;
            }
          }
        } catch (e) { console.error('Failed to load libraries', e); }
      },

      async saveSpace() {
        if (!this.formName.trim() || this.isSaving) return;
        this.isSaving = true;
        const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];

        try {
          if (this.editingSpace) {
            // Update existing space
            await fetch(`/account/${accountNum}/api/hierarchy/space/update`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id: this.editingSpace.id || this.editingSpace._id,
                name: this.formName.trim(),
                icon: this.formIcon,
                color: this.formColor
              })
            });
            this.modalOpen = false;
            window.dispatchEvent(new CustomEvent('space-modal-saved', { detail: {} }));
          } else {
            // Create new space
            const body = {
              name: this.formName.trim(),
              icon: this.formIcon,
              color: this.formColor
            };
            if (this.environmentId) {
              body.environmentId = this.environmentId;
            }
            const res = await fetch(`/account/${accountNum}/api/hierarchy/space`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body)
            });
            if (!res.ok) {
              const err = await res.json();
              throw new Error(err.error || `HTTP ${res.status}`);
            }
            const newSpace = await res.json();
            this.modalOpen = false;
            window.dispatchEvent(new CustomEvent('space-modal-saved', { detail: { newSpace } }));
          }
        } catch (err) {
          console.error('[SpaceModal] Save error:', err);
          alert('Erreur: ' + err.message);
        } finally {
          this.isSaving = false;
        }
      },

      async searchIcons() {
        if (!this.iconSearch.trim()) {
          this.iconResults = [...this.defaultIcons];
          return;
        }
        const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
        try {
          const library = this.selectedLibrary || 'solar';
          const res = await fetch(`/account/${accountNum}/api/hierarchy/icons?library=${library}&search=${encodeURIComponent(this.iconSearch.trim())}&page=1&limit=32`);
          if (res.ok) {
            const data = await res.json();
            this.iconResults = data.icons || [];
            if (this.iconResults.length === 0) {
              this.iconResults = [...this.defaultIcons];
            }
          }
        } catch (err) {
          console.error('[SpaceModal] Icon search error:', err);
        }
      }
    };
  }
</script>
