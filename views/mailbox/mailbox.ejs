<link rel="stylesheet" type="text/css" media="screen" href="/themes/default/assets/css/quill.snow.css" />

<div x-data="mailbox">
    <div class="relative flex h-full gap-5 sm:h-[calc(100vh_-_150px)]">
        <!-- Overlay for mobile sidebar -->
        <div class="overlay absolute z-[5] hidden h-full w-full rounded-md bg-black/60"
            :class="{'!block xl:!hidden' : isShowMailMenu}" @click="isShowMailMenu = !isShowMailMenu"></div>

        <!-- ========== SIDEBAR ========== -->
        <div class="panel dark:gray-50 absolute z-10 hidden h-full w-[250px] max-w-full flex-none space-y-3 overflow-hidden p-4 ltr:rounded-r-none rtl:rounded-l-none xl:relative xl:block xl:h-auto ltr:xl:rounded-r-md rtl:xl:rounded-l-md"
            :class="{'!block' : isShowMailMenu}">
            <div class="flex h-full flex-col pb-16">
                <div class="pb-5">
                    <button class="btn btn-primary w-full" type="button" @click="openMail('add')">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 ltr:mr-2 rtl:ml-2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        New Message
                    </button>

                </div>
                <div class="perfect-scrollbar relative -mr-3.5 h-full grow pr-3.5">
                    <div class="space-y-1">
                        <!-- Inbox -->
                        <button type="button"
                            class="flex h-10 w-full items-center justify-between rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary"
                            :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': !isEdit && selectedTab === 'inbox' }"
                            @click="tabChanged('inbox')">
                            <div class="flex items-center">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                    <path opacity="0.5" d="M2 12C2 8.22876 2 6.34315 3.17157 5.17157C4.34315 4 6.22876 4 10 4H14C17.7712 4 19.6569 4 20.8284 5.17157C22 6.34315 22 8.22876 22 12C22 15.7712 22 17.6569 20.8284 18.8284C19.6569 20 17.7712 20 14 20H10C6.22876 20 4.34315 20 3.17157 18.8284C2 17.6569 2 15.7712 2 12Z" stroke="currentColor" stroke-width="1.5" />
                                    <path d="M6 8L8.1589 9.79908C9.99553 11.3296 10.9139 12.0949 12 12.0949C13.0861 12.0949 14.0045 11.3296 15.8411 9.79908L18 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                                <div class="ltr:ml-3 rtl:mr-3">Inbox</div>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <svg x-show="syncing" class="animate-spin h-3.5 w-3.5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <div class="whitespace-nowrap rounded-md bg-primary-light py-0.5 px-2 font-semibold dark:bg-[#060818]"
                                    x-text="mailList && mailList.filter((d) => d.type == 'inbox').length"></div>
                            </div>
                        </button>
                        <!-- Star/Marked -->
                        <button type="button"
                            class="flex h-10 w-full items-center justify-between rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary"
                            :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': !isEdit && selectedTab === 'star' }"
                            @click="tabChanged('star')">
                            <div class="flex items-center">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                    <path d="M9.15316 5.40838C10.4198 3.13613 11.0531 2 12 2C12.9469 2 13.5802 3.13612 14.8468 5.40837L15.1745 5.99623C15.5345 6.64193 15.7144 6.96479 15.9951 7.17781C16.2757 7.39083 16.6251 7.4699 17.3241 7.62805L17.9605 7.77203C20.4201 8.32856 21.65 8.60682 21.9426 9.54773C22.2352 10.4886 21.3968 11.4691 19.7199 13.4299L19.2861 13.9372C18.8096 14.4944 18.5713 14.773 18.4641 15.1177C18.357 15.4624 18.393 15.8341 18.465 16.5776L18.5306 17.2544C18.7841 19.8706 18.9109 21.1787 18.1449 21.7602C17.3788 22.3417 16.2273 21.8115 13.9243 20.7512L13.3285 20.4768C12.6741 20.1755 12.3469 20.0248 12 20.0248C11.6531 20.0248 11.3259 20.1755 10.6715 20.4768L10.0757 20.7512C7.77268 21.8115 6.62118 22.3417 5.85515 21.7602C5.08912 21.1787 5.21588 19.8706 5.4694 17.2544L5.53498 16.5776C5.60703 15.8341 5.64305 15.4624 5.53586 15.1177C5.42868 14.773 5.19043 14.4944 4.71392 13.9372L4.2801 13.4299C2.60325 11.4691 1.76482 10.4886 2.05742 9.54773C2.35002 8.60682 3.57986 8.32856 6.03954 7.77203L6.67589 7.62805C7.37485 7.4699 7.72433 7.39083 8.00494 7.17781C8.28555 6.96479 8.46553 6.64194 8.82547 5.99623L9.15316 5.40838Z" stroke="currentColor" stroke-width="1.5" />
                                </svg>
                                <div class="ltr:ml-3 rtl:mr-3">Marked</div>
                            </div>
                        </button>
                        <!-- Sent -->
                        <button type="button"
                            class="flex h-10 w-full items-center justify-between rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary"
                            :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': !isEdit && selectedTab === 'sent_mail' }"
                            @click="tabChanged('sent_mail')">
                            <div class="flex items-center">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                    <path d="M17.4975 18.4851L20.6281 9.09373C21.8764 5.34874 22.5006 3.47624 21.5122 2.48782C20.5237 1.49939 18.6511 2.12356 14.906 3.37189L5.57477 6.48218C3.49295 7.1761 2.45203 7.52305 2.13608 8.28637C2.06182 8.46577 2.01692 8.65596 2.00311 8.84963C1.94433 9.67365 2.72018 10.4495 4.27188 12.0011L4.55451 12.2837C4.80921 12.5384 4.93655 12.6658 5.03282 12.8075C5.22269 13.0871 5.33046 13.4143 5.34393 13.7519C5.35076 13.9232 5.32403 14.1013 5.27057 14.4574C5.07488 15.7612 4.97703 16.4131 5.0923 16.9147C5.32205 17.9146 6.09599 18.6995 7.09257 18.9433C7.59255 19.0656 8.24576 18.977 9.5522 18.7997L9.62363 18.79C9.99191 18.74 10.1761 18.715 10.3529 18.7257C10.6738 18.745 10.9838 18.8496 11.251 19.0285C11.3981 19.1271 11.5295 19.2585 11.7923 19.5213L12.0436 19.7725C13.5539 21.2828 14.309 22.0379 15.1101 21.9985C15.3309 21.9877 15.5479 21.9365 15.7503 21.8474C16.4844 21.5244 16.8221 20.5113 17.4975 18.4851Z" stroke="currentColor" stroke-width="1.5" />
                                    <path opacity="0.5" d="M6 18L21 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                                <div class="ltr:ml-3 rtl:mr-3">Sent</div>
                            </div>
                        </button>
                        <!-- Spam -->
                        <button type="button"
                            class="flex h-10 w-full items-center justify-between rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary"
                            :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': !isEdit && selectedTab === 'spam' }"
                            @click="tabChanged('spam')">
                            <div class="flex items-center">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                    <path d="M12 7V13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                    <circle cx="12" cy="16" r="1" fill="currentColor" />
                                    <path opacity="0.5" d="M7.84308 3.80211C9.8718 2.6007 10.8862 2 12 2C13.1138 2 14.1282 2.6007 16.1569 3.80211L16.8431 4.20846C18.8718 5.40987 19.8862 6.01057 20.4431 7C21 7.98943 21 9.19084 21 11.5937V12.4063C21 14.8092 21 16.0106 20.4431 17C19.8862 17.9894 18.8718 18.5901 16.8431 19.7915L16.1569 20.1979C14.1282 21.3993 13.1138 22 12 22C10.8862 22 9.8718 21.3993 7.84308 20.1979L7.15692 19.7915C5.1282 18.5901 4.11384 17.9894 3.55692 17C3 16.0106 3 14.8092 3 12.4063V11.5937C3 9.19084 3 7.98943 3.55692 7C4.11384 6.01057 5.1282 5.40987 7.15692 4.20846L7.84308 3.80211Z" stroke="currentColor" stroke-width="1.5" />
                                </svg>
                                <div class="ltr:ml-3 rtl:mr-3">Spam</div>
                            </div>
                        </button>
                        <!-- Draft -->
                        <button type="button"
                            class="flex h-10 w-full items-center justify-between rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary"
                            :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': !isEdit && selectedTab === 'draft' }"
                            @click="tabChanged('draft')">
                            <div class="flex items-center">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5">
                                    <path d="M15.3929 4.05365L14.8912 4.61112L15.3929 4.05365ZM19.3517 7.61654L18.85 8.17402L19.3517 7.61654ZM21.654 10.1541L20.9689 10.4592L21.654 10.1541ZM3.17157 20.8284L3.7019 20.2981L3.17157 20.8284ZM20.8284 20.8284L20.2981 20.2981L20.8284 20.8284ZM14 21.25H10V22.75H14V21.25ZM2.75 14V10H1.25V14H2.75ZM21.25 13.5629V14H22.75V13.5629H21.25ZM14.8912 4.61112L18.85 8.17402L19.8534 7.05907L15.8947 3.49618L14.8912 4.61112ZM22.75 13.5629C22.75 11.8745 22.7651 10.8055 22.3391 9.84897L20.9689 10.4592C21.2349 11.0565 21.25 11.742 21.25 13.5629H22.75ZM18.85 8.17402C20.2034 9.3921 20.7029 9.86199 20.9689 10.4592L22.3391 9.84897C21.9131 8.89241 21.1084 8.18853 19.8534 7.05907L18.85 8.17402ZM10.0298 2.75C11.6116 2.75 12.2085 2.76158 12.7405 2.96573L13.2779 1.5653C12.4261 1.23842 11.498 1.25 10.0298 1.25V2.75ZM15.8947 3.49618C14.8087 2.51878 14.1297 1.89214 13.2779 1.5653L12.7405 2.96573C13.2727 3.16993 13.7215 3.55836 14.8912 4.61112L15.8947 3.49618ZM10 21.25C8.09318 21.25 6.73851 21.2484 5.71085 21.1102C4.70476 20.975 4.12511 20.7213 3.7019 20.2981L2.64124 21.3588C3.38961 22.1071 4.33855 22.4392 5.51098 22.5969C6.66182 22.7516 8.13558 22.75 10 22.75V21.25ZM1.25 14C1.25 15.8644 1.24841 17.3382 1.40313 18.489C1.56076 19.6614 1.89288 20.6104 2.64124 21.3588L3.7019 20.2981C3.27869 19.8749 3.02502 19.2952 2.88976 18.2892C2.75159 17.2615 2.75 15.9068 2.75 14H1.25ZM14 22.75C15.8644 22.75 17.3382 22.7516 18.489 22.5969C19.6614 22.4392 20.6104 22.1071 21.3588 21.3588L20.2981 20.2981C19.8749 20.7213 19.2952 20.975 18.2892 21.1102C17.2615 21.2484 15.9068 21.25 14 21.25V22.75ZM21.25 14C21.25 15.9068 21.2484 17.2615 21.1102 18.2892C20.975 19.2952 20.7213 19.8749 20.2981 20.2981L21.3588 21.3588C22.1071 20.6104 22.4392 19.6614 22.5969 18.489C22.7516 17.3382 22.75 15.8644 22.75 14H21.25ZM2.75 10C2.75 8.09318 2.75159 6.73851 2.88976 5.71085C3.02502 4.70476 3.27869 4.12511 3.7019 3.7019L2.64124 2.64124C1.89288 3.38961 1.56076 4.33855 1.40313 5.51098C1.24841 6.66182 1.25 8.13558 1.25 10H2.75ZM10.0298 1.25C8.15538 1.25 6.67442 1.24842 5.51887 1.40307C4.34232 1.56054 3.39019 1.8923 2.64124 2.64124L3.7019 3.7019C4.12453 3.27928 4.70596 3.02525 5.71785 2.88982C6.75075 2.75158 8.11311 2.75 10.0298 2.75V1.25Z" fill="currentColor" />
                                    <path opacity="0.5" d="M13 2.5V5C13 7.35702 13 8.53553 13.7322 9.26777C14.4645 10 15.643 10 18 10H22" stroke="currentColor" stroke-width="1.5" />
                                </svg>
                                <div class="ltr:ml-3 rtl:mr-3">Drafts</div>
                            </div>
                            <div class="whitespace-nowrap rounded-md bg-primary-light py-0.5 px-2 font-semibold dark:bg-[#060818]"
                                x-text="mailList && mailList.filter((d) => d.type === 'draft').length"></div>
                        </button>
                        <!-- Trash -->
                        <button type="button"
                            class="flex h-10 w-full items-center justify-between rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary"
                            :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': !isEdit && selectedTab === 'trash' }"
                            @click="tabChanged('trash')">
                            <div class="flex items-center">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                    <path opacity="0.5" d="M9.17065 4C9.58249 2.83481 10.6937 2 11.9999 2C13.3062 2 14.4174 2.83481 14.8292 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                    <path d="M20.5001 6H3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                    <path d="M18.8334 8.5L18.3735 15.3991C18.1965 18.054 18.108 19.3815 17.243 20.1907C16.378 21 15.0476 21 12.3868 21H11.6134C8.9526 21 7.6222 21 6.75719 20.1907C5.89218 19.3815 5.80368 18.054 5.62669 15.3991L5.16675 8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                    <path opacity="0.5" d="M9.5 11L10 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                    <path opacity="0.5" d="M14.5 11L14 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                                <div class="ltr:ml-3 rtl:mr-3">Trash</div>
                            </div>
                        </button>
                        <!-- More: Archive / Important -->
                        <div x-data="{ showMore: false }">
                            <button type="button" class="flex h-10 w-full items-center rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary" @click="showMore = !showMore">
                                <div :class="{'rotate-180' : showMore}">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5"><path d="M19 9L12 15L5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                </div>
                                <div class="ltr:ml-3 rtl:mr-3" x-text="showMore ? 'Less' : 'More'"></div>
                            </button>
                            <ul x-cloak x-show="showMore" class="mt-1 space-y-1">
                                <li>
                                    <button type="button" class="flex h-10 w-full items-center rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary"
                                        :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': !isEdit && selectedTab === 'archive' }"
                                        @click="tabChanged('archive')">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                            <path d="M9 12C9 11.5341 9 11.3011 9.07612 11.1173C9.17761 10.8723 9.37229 10.6776 9.61732 10.5761C9.80109 10.5 10.0341 10.5 10.5 10.5H13.5C13.9659 10.5 14.1989 10.5 14.3827 10.5761C14.6277 10.6776 14.8224 10.8723 14.9239 11.1173C15 11.3011 15 11.5341 15 12C15 12.4659 15 12.6989 14.9239 12.8827C14.8224 13.1277 14.6277 13.3224 14.3827 13.4239C14.1989 13.5 13.9659 13.5 13.5 13.5H10.5C10.0341 13.5 9.80109 13.5 9.61732 13.4239C9.37229 13.3224 9.17761 13.1277 9.07612 12.8827C9 12.6989 9 12.4659 9 12Z" stroke="currentColor" stroke-width="1.5"></path>
                                            <path opacity="0.5" d="M20.5 7V13C20.5 16.7712 20.5 18.6569 19.3284 19.8284C18.1569 21 16.2712 21 12.5 21H11.5C7.72876 21 5.84315 21 4.67157 19.8284C3.5 18.6569 3.5 16.7712 3.5 13V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                                            <path d="M2 5C2 4.05719 2 3.58579 2.29289 3.29289C2.58579 3 3.05719 3 4 3H20C20.9428 3 21.4142 3 21.7071 3.29289C22 3.58579 22 4.05719 22 5C22 5.94281 22 6.41421 21.7071 6.70711C21.4142 7 20.9428 7 20 7H4C3.05719 7 2.58579 7 2.29289 6.70711C2 6.41421 2 5.94281 2 5Z" stroke="currentColor" stroke-width="1.5"></path>
                                        </svg>
                                        <div class="ltr:ml-3 rtl:mr-3">Archive</div>
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="flex h-10 w-full items-center rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary"
                                        :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': !isEdit && selectedTab === 'important' }"
                                        @click="tabChanged('important')">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                            <path d="M21 16.0909V11.0975C21 6.80891 21 4.6646 19.682 3.3323C18.364 2 16.2426 2 12 2C7.75736 2 5.63604 2 4.31802 3.3323C3 4.6646 3 6.80891 3 11.0975V16.0909C3 19.1875 3 20.7358 3.73411 21.4123C4.08421 21.735 4.52615 21.9377 4.99692 21.9915C5.98402 22.1045 7.13673 21.0849 9.44216 19.0458C10.4612 18.1445 10.9708 17.6938 11.5603 17.5751C11.8506 17.5166 12.1494 17.5166 12.4397 17.5751C13.0292 17.6938 13.5388 18.1445 14.5578 19.0458C16.8633 21.0849 18.016 22.1045 19.0031 21.9915C19.4739 21.9377 19.9158 21.735 20.2659 21.4123C21 20.7358 21 19.1875 21 16.0909Z" stroke="currentColor" stroke-width="1.5" />
                                        </svg>
                                        <div class="ltr:ml-3 rtl:mr-3">Important</div>
                                    </button>
                                </li>
                            </ul>
                        </div>
                        <!-- Separator -->
                        <div class="h-px border-b border-[#e0e6ed] dark:border-[#1b2e4b]"></div>
                        <!-- Templates (where labels were) -->
                        <button type="button"
                            class="flex h-10 w-full items-center rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary"
                            :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': showTemplates }"
                            @click="showTemplates = !showTemplates; isEdit = false; selectedMail = null; showSignature = false">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                <path opacity="0.5" d="M2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12Z" stroke="currentColor" stroke-width="1.5" />
                                <path d="M7 8H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                <path d="M7 12H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                <path d="M7 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                            <div class="ltr:ml-3 rtl:mr-3">Templates</div>
                        </button>
                    </div>
                </div>
                <!-- Connected Accounts + Add Account (fixed bottom) -->
                <div class="absolute bottom-0 w-full ltr:left-0 rtl:right-0" style="background: inherit;">
                    <!-- Separator -->
                    <div class="h-px border-b border-[#e0e6ed] dark:border-[#1b2e4b] mx-4"></div>

                    <!-- Active Account (default account highlighted) -->
                    <template x-if="activeAccount">
                        <div class="px-4 pt-3 pb-1">
                            <div class="flex items-center gap-2.5 rounded-lg p-2.5" :style="'background:' + (activeAccount.color || '#4361ee') + '12; border: 1px solid ' + (activeAccount.color || '#4361ee') + '30'">
                                <!-- Account avatar -->
                                <div class="flex h-9 w-9 items-center justify-center rounded-full text-xs font-bold text-white shrink-0" :style="'background:' + (activeAccount.color || '#4361ee')">
                                    <span x-text="activeAccount.name ? activeAccount.name.substring(0, 2).toUpperCase() : '?'"></span>
                                </div>
                                <!-- Account info -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-sm font-bold truncate" x-text="activeAccount.name"></span>
                                        <span class="h-1.5 w-1.5 rounded-full bg-success shrink-0" title="Connected"></span>
                                    </div>
                                    <div class="text-[11px] text-white-dark truncate" x-text="activeAccount.email"></div>
                                </div>
                                <!-- Actions dropdown -->
                                <div x-data="{ open: false }" @click.outside="open = false" class="relative shrink-0">
                                    <button type="button" class="flex items-center rounded p-1 hover:bg-black/10 dark:hover:bg-white/10 transition-colors" @click="open = !open">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="6" r="1.5" fill="currentColor"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/><circle cx="12" cy="18" r="1.5" fill="currentColor"/></svg>
                                    </button>
                                    <ul x-cloak x-show="open" x-transition x-transition.duration.200ms class="absolute z-50 bottom-full mb-1 ltr:right-0 rtl:left-0 w-44 rounded-md border border-[#e0e6ed] bg-white py-1 shadow-lg dark:border-[#1b2e4b] dark:bg-[#1b2e4b]">
                                        <li><button type="button" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-gray-100 dark:hover:bg-[#253b5c]" @click="open = false; editAccount(activeAccount)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M13.765 2.152C13.398 2 12.932 2 12 2c-.932 0-1.398 0-1.765.152a2 2 0 00-1.083 1.083c-.092.223-.129.484-.143.863a1.617 1.617 0 01-.79 1.353 1.617 1.617 0 01-1.567.008c-.336-.178-.579-.276-.82-.308a2 2 0 00-1.478.396C4.045 5.787 3.812 6.19 3.346 6.997c-.466.807-.7 1.21-.751 1.616a2 2 0 00.396 1.478c.148.192.37.35.737.545a1.617 1.617 0 01.79 1.364 1.617 1.617 0 01-.79 1.364c-.367.195-.59.353-.737.545a2 2 0 00-.396 1.478c.052.407.285.81.751 1.616.466.807.699 1.21 1.008 1.453a2 2 0 001.478.396c.241-.032.484-.13.82-.308a1.617 1.617 0 011.567.008c.483.28.77.795.79 1.353.014.38.05.64.143.863a2 2 0 001.083 1.083C10.602 22 11.068 22 12 22c.932 0 1.398 0 1.765-.152a2 2 0 001.083-1.083c.092-.223.129-.484.143-.863.02-.558.307-1.074.79-1.353a1.617 1.617 0 011.567-.008c.336.178.579.276.82.308a2 2 0 001.478-.396c.309-.243.542-.646 1.008-1.453.466-.807.7-1.21.751-1.616a2 2 0 00-.396-1.478c-.148-.192-.37-.35-.737-.545a1.617 1.617 0 01-.79-1.364c0-.56.301-1.08.79-1.364.367-.195.59-.353.737-.545a2 2 0 00.396-1.478c-.052-.407-.285-.81-.751-1.616-.466-.807-.699-1.21-1.008-1.453a2 2 0 00-1.478-.396c-.241.032-.484.13-.82.308a1.617 1.617 0 01-1.567-.008 1.617 1.617 0 01-.79-1.353c-.014-.38-.05-.64-.143-.863a2 2 0 00-1.083-1.083z" stroke="currentColor" stroke-width="1.5"/></svg>
                                            Configure</button></li>
                                        <li><button type="button" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm text-danger hover:bg-gray-100 dark:hover:bg-[#253b5c]" @click="open = false; disconnectAccount(activeAccount)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M15 12H6M6 12L8 14M6 12L8 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 21.983C10.036 21.936 8.77 21.723 7.879 20.828C6.75 19.7 6.75 17.866 6.75 14.2V9.8C6.75 6.134 6.75 4.3 7.879 3.172C9.007 2.043 10.84 2.043 14.507 2.043H15.007C18.673 2.043 20.507 2.043 21.635 3.172C22.764 4.3 22.764 6.134 22.764 9.8V14.2C22.764 17.866 22.764 19.7 21.635 20.828C20.745 21.723 19.478 21.936 17.514 21.983" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                            Disconnect</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </template>

                    <!-- Other accounts list -->
                    <template x-if="otherAccounts.length > 0">
                        <div class="max-h-[70px] overflow-y-auto px-4 pt-1 space-y-0.5">
                            <template x-for="(acc, i) in otherAccounts" :key="acc._id">
                                <div class="flex items-center gap-2 rounded-md p-1.5 text-xs hover:bg-white-dark/10 dark:hover:bg-[#181F32] group cursor-pointer"
                                     @click="switchAccount(acc._id)">
                                    <div class="h-2.5 w-2.5 rounded-full shrink-0" :style="'background:' + (acc.color || '#4361ee')"></div>
                                    <div class="truncate flex-1">
                                        <span class="font-semibold" x-text="acc.name"></span>
                                        <span class="text-white-dark ml-1" x-text="acc.email"></span>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </template>

                    <!-- Add Account button -->
                    <div class="p-3 pt-1">
                        <button type="button" class="flex w-full items-center gap-3 rounded-md p-2 font-medium text-white-dark hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary"
                            @click="openAccountModal()">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5" />
                                <path opacity="0.5" d="M5 20C5 17.2386 7.23858 15 10 15H14C16.7614 15 19 17.2386 19 20C19 20.5523 18.5523 21 18 21H6C5.44772 21 5 20.5523 5 20Z" stroke="currentColor" stroke-width="1.5" />
                            </svg>
                            Add Account
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========== MAIN CONTENT PANEL ========== -->
        <div class="panel h-full flex-1 overflow-auto p-0">
            <%- include('partials/mail-list') %>
            <%- include('partials/mail-detail') %>
            <%- include('partials/mail-compose') %>
            <%- include('partials/mail-templates') %>
            <%- include('partials/mail-signature') %>
        </div>
    </div>

    <!-- ========== ADD/EDIT ACCOUNT MODAL ========== -->
    <div x-show="showAccountModal" x-cloak class="fixed inset-0 z-[999] flex items-center justify-center bg-black/60 p-4" @click.self="showAccountModal = false">
        <div class="w-full max-w-lg rounded-lg bg-white p-6 shadow-2xl dark:bg-[#0e1726]" @click.stop>
            <div class="mb-5 flex items-center justify-between">
                <h3 class="text-lg font-bold" x-text="editingAccount && editingAccount._id ? 'Edit Account' : 'Add Email Account'"></h3>
                <button type="button" class="text-white-dark hover:text-dark" @click="showAccountModal = false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>

            <div class="space-y-4 max-h-[60vh] overflow-y-auto pr-2">
                <!-- Account name + email -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="mb-1 block text-sm font-semibold">Account Name *</label>
                        <input type="text" class="form-input" placeholder="e.g. Work Gmail" x-model="editingAccount.name" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-semibold">Email Address *</label>
                        <input type="email" class="form-input" placeholder="you@example.com" x-model="editingAccount.email" />
                    </div>
                </div>

                <!-- Color picker -->
                <div>
                    <label class="mb-1 block text-sm font-semibold">Account Color</label>
                    <div class="flex items-center gap-3">
                        <template x-for="c in ['#4361ee', '#e7515a', '#00ab55', '#e2a03f', '#805dca', '#2196f3', '#1abc9c']" :key="c">
                            <button type="button" class="h-7 w-7 rounded-full border-2 transition-all" :class="editingAccount.color === c ? 'border-dark dark:border-white scale-110 shadow-lg' : 'border-transparent'" :style="'background:' + c" @click="editingAccount.color = c"></button>
                        </template>
                    </div>
                </div>

                <!-- IMAP Section -->
                <div class="rounded-md border border-[#e0e6ed] p-4 dark:border-[#1b2e4b]">
                    <h4 class="mb-3 flex items-center gap-2 font-bold">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M2 12C2 8.229 2 6.343 3.172 5.172C4.343 4 6.229 4 10 4H14C17.771 4 19.657 4 20.828 5.172C22 6.343 22 8.229 22 12C22 15.771 22 17.657 20.828 18.828C19.657 20 17.771 20 14 20H10C6.229 20 4.343 20 3.172 18.828C2 17.657 2 15.771 2 12Z" stroke="currentColor" stroke-width="1.5"/><path d="M6 8L8.159 9.799C9.996 11.33 10.914 12.095 12 12.095C13.086 12.095 14.005 11.33 15.841 9.799L18 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        IMAP Settings (Incoming)
                    </h4>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="mb-1 block text-xs text-white-dark">IMAP Host *</label>
                            <input type="text" class="form-input form-input-sm" placeholder="imap.gmail.com" x-model="editingAccount.imap.host" />
                        </div>
                        <div>
                            <label class="mb-1 block text-xs text-white-dark">Port</label>
                            <input type="number" class="form-input form-input-sm" placeholder="993" x-model="editingAccount.imap.port" />
                        </div>
                        <div>
                            <label class="mb-1 block text-xs text-white-dark">Username *</label>
                            <input type="text" class="form-input form-input-sm" placeholder="you@example.com" x-model="editingAccount.imap.user" />
                        </div>
                        <div>
                            <label class="mb-1 block text-xs text-white-dark">Password *</label>
                            <input type="password" class="form-input form-input-sm" placeholder="App password" x-model="editingAccount.imap.password" />
                        </div>
                    </div>
                    <label class="mt-2 flex items-center gap-2 text-xs">
                        <input type="checkbox" class="form-checkbox h-4 w-4" x-model="editingAccount.imap.tls" />
                        Use TLS/SSL
                    </label>
                </div>

                <!-- SMTP Section (collapsible) -->
                <div x-data="{ showSmtp: false }">
                    <button type="button" class="mb-2 flex items-center gap-2 text-sm font-semibold text-primary" @click="showSmtp = !showSmtp">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 9L12 15L5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span x-text="showSmtp ? 'Hide SMTP Settings' : 'Show SMTP Settings (Optional)'"></span>
                    </button>
                    <div x-cloak x-show="showSmtp" class="rounded-md border border-[#e0e6ed] p-4 dark:border-[#1b2e4b]">
                        <h4 class="mb-3 flex items-center gap-2 font-bold">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M17.498 18.485L20.628 9.094C21.876 5.349 22.5 3.476 21.512 2.488C20.524 1.499 18.651 2.124 14.906 3.372L5.575 6.482C3.493 7.176 2.452 7.523 2.136 8.286C2.062 8.466 2.017 8.656 2.003 8.85C1.944 9.674 2.72 10.449 4.272 12.001L4.555 12.284C4.809 12.538 4.937 12.666 5.033 12.808C5.223 13.087 5.33 13.414 5.344 13.752C5.351 13.923 5.324 14.101 5.271 14.457C5.075 15.761 4.977 16.413 5.092 16.915C5.322 17.915 6.096 18.7 7.093 18.943C7.593 19.066 8.246 18.977 9.552 18.8L9.624 18.79C9.992 18.74 10.176 18.715 10.353 18.726C10.674 18.745 10.984 18.85 11.251 19.029C11.398 19.127 11.53 19.259 11.792 19.521L12.044 19.773C13.554 21.283 14.309 22.038 15.11 21.999C15.331 21.988 15.548 21.937 15.75 21.847C16.484 21.524 16.822 20.511 17.498 18.485Z" stroke="currentColor" stroke-width="1.5"/></svg>
                            SMTP Settings (Outgoing)
                        </h4>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="mb-1 block text-xs text-white-dark">SMTP Host</label>
                                <input type="text" class="form-input form-input-sm" placeholder="smtp.gmail.com" x-model="editingAccount.smtp.host" />
                            </div>
                            <div>
                                <label class="mb-1 block text-xs text-white-dark">Port</label>
                                <input type="number" class="form-input form-input-sm" placeholder="587" x-model="editingAccount.smtp.port" />
                            </div>
                            <div>
                                <label class="mb-1 block text-xs text-white-dark">Username</label>
                                <input type="text" class="form-input form-input-sm" placeholder="Same as IMAP" x-model="editingAccount.smtp.user" />
                            </div>
                            <div>
                                <label class="mb-1 block text-xs text-white-dark">Password</label>
                                <input type="password" class="form-input form-input-sm" placeholder="Same as IMAP" x-model="editingAccount.smtp.password" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="mt-5 flex items-center justify-between border-t border-[#e0e6ed] pt-4 dark:border-[#1b2e4b]">
                <div class="flex items-center gap-2">
                    <!-- Test Connection -->
                    <button type="button" class="btn btn-outline-info btn-sm gap-1" @click="testAccountConnection()" :disabled="accountTesting">
                        <svg x-show="!accountTesting" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12.0789 3V2.25V3ZM3.67981 11.3333H2.92981H3.67981Z" fill="currentColor"/><path d="M19.8934 6.607C18.287 3.994 15.387 2.25 12.079 2.25V3.75C14.848 3.75 17.273 5.208 18.616 7.393L19.893 6.607Z" fill="currentColor"/></svg>
                        <svg x-show="accountTesting" class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="62.83" stroke-dashoffset="20" stroke-linecap="round"/></svg>
                        <span x-text="accountTesting ? 'Testing...' : 'Test Connection'"></span>
                    </button>
                    <!-- Delete (only when editing) -->
                    <template x-if="editingAccount && editingAccount._id">
                        <button type="button" class="btn btn-outline-danger btn-sm" @click="deleteAccount()">Delete</button>
                    </template>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" class="btn btn-outline-dark btn-sm" @click="showAccountModal = false">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" @click="saveAccount()">
                        <span x-text="editingAccount && editingAccount._id ? 'Update' : 'Add Account'"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/themes/default/assets/js/quill.js"></script>
<script>
<%- include('partials/mail-script') %>
</script>