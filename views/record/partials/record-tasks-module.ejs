    .tl-progress-panel { border-radius:13px;box-shadow:0 10px 28px rgba(15,23,42,.03); }
    .dark .tl-pro-header {
        background:linear-gradient(135deg,#0e1726 0%,#0b1320 100%);border-color:#253b5c;box-shadow:none;
    }
    .dark .tl-pro-title h2,.dark .tl-kpi-card strong { color:#e0e6ed; }
    .dark .tl-pro-title p,.dark .tl-kpi-card span { color:#8ea0bd; }
    .dark .tl-mode-segment,.dark .tl-pro-btn,.dark .tl-pro-icon-btn,.dark .tl-kpi-card {
        background:#0e1726;border-color:#253b5c;color:#e0e6ed;box-shadow:none;
    }
