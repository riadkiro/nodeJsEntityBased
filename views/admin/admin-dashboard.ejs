<!-- Tenant Admin Dashboard -->
<div>
    <!-- Header -->
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
        <a href="/account/<%= account_number %>/home" style="display: flex; align-items: center; gap: 6px; color: #4361ee; text-decoration: none; font-size: 13px; font-weight: 500; padding: 6px 14px; border-radius: 8px; background: rgba(67,97,238,0.08);">
            <iconify-icon icon="solar:arrow-left-bold" width="14"></iconify-icon>
            Retour
        </a>
        <div style="flex: 1;">
            <h1 style="font-size: 22px; font-weight: 800; color: #0e1726; margin: 0;">
                <iconify-icon icon="solar:settings-bold-duotone" width="22" style="color: #4361ee; margin-right: 6px; vertical-align: -4px;"></iconify-icon>
                Administration du workspace
            </h1>
            <p style="font-size: 13px; color: #94a3b8; margin: 4px 0 0;"><%= account.name %></p>
        </div>
    </div>

    <!-- Stats Row -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 24px;">
        <div style="background: #fff; border: 1px solid #e0e6ed; border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 14px;">
            <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(67,97,238,0.1); display: flex; align-items: center; justify-content: center;">
                <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="22" style="color: #4361ee;"></iconify-icon>
            </div>
            <div>
                <div style="font-size: 24px; font-weight: 800; color: #0e1726;"><%= stats.totalMembers %></div>
                <div style="font-size: 12px; color: #94a3b8;">Membres actifs</div>
            </div>
            <div style="margin-left: auto; font-size: 11px; color: #94a3b8;">/ <%= stats.maxMembers === -1 ? '∞' : stats.maxMembers %></div>
        </div>
        <div style="background: #fff; border: 1px solid #e0e6ed; border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 14px;">
            <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(245,158,11,0.1); display: flex; align-items: center; justify-content: center;">
                <iconify-icon icon="solar:letter-bold-duotone" width="22" style="color: #f59e0b;"></iconify-icon>
            </div>
            <div>
                <div style="font-size: 24px; font-weight: 800; color: #0e1726;"><%= stats.pendingInvites %></div>
                <div style="font-size: 12px; color: #94a3b8;">Invitations en attente</div>
            </div>
        </div>
        <div style="background: #fff; border: 1px solid #e0e6ed; border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 14px;">
            <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(8,145,178,0.1); display: flex; align-items: center; justify-content: center;">
                <iconify-icon icon="solar:server-minimalistic-bold-duotone" width="22" style="color: #0891b2;"></iconify-icon>
            </div>
            <div>
                <div style="font-size: 24px; font-weight: 800; color: #0e1726;"><%= stats.storageUsed %> MB</div>
                <div style="font-size: 12px; color: #94a3b8;">Stockage / <%= stats.storageLimit === -1 ? '∞' : stats.storageLimit %> MB</div>
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <a href="/account/<%= account_number %>/admin/members" style="background: #fff; border: 1px solid #e0e6ed; border-radius: 12px; padding: 24px; text-decoration: none; display: flex; align-items: center; gap: 16px; transition: all 0.2s;" onmouseover="this.style.borderColor='#4361ee'; this.style.boxShadow='0 4px 12px rgba(67,97,238,0.1)'" onmouseout="this.style.borderColor='#e0e6ed'; this.style.boxShadow='none'">
            <div style="width: 52px; height: 52px; border-radius: 14px; background: rgba(67,97,238,0.1); display: flex; align-items: center; justify-content: center;">
                <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="28" style="color: #4361ee;"></iconify-icon>
            </div>
            <div>
                <div style="font-size: 16px; font-weight: 700; color: #0e1726;">Membres</div>
                <div style="font-size: 13px; color: #94a3b8;">Gérer les membres et invitations</div>
            </div>
            <iconify-icon icon="solar:arrow-right-bold" width="18" style="color: #cbd5e1; margin-left: auto;"></iconify-icon>
        </a>
        <a href="/account/<%= account_number %>/admin/settings" style="background: #fff; border: 1px solid #e0e6ed; border-radius: 12px; padding: 24px; text-decoration: none; display: flex; align-items: center; gap: 16px; transition: all 0.2s;" onmouseover="this.style.borderColor='#0891b2'; this.style.boxShadow='0 4px 12px rgba(8,145,178,0.1)'" onmouseout="this.style.borderColor='#e0e6ed'; this.style.boxShadow='none'">
            <div style="width: 52px; height: 52px; border-radius: 14px; background: rgba(8,145,178,0.1); display: flex; align-items: center; justify-content: center;">
                <iconify-icon icon="solar:settings-bold-duotone" width="28" style="color: #0891b2;"></iconify-icon>
            </div>
            <div>
                <div style="font-size: 16px; font-weight: 700; color: #0e1726;">Paramètres</div>
                <div style="font-size: 13px; color: #94a3b8;">Nom, icône et paramètres du workspace</div>
            </div>
            <iconify-icon icon="solar:arrow-right-bold" width="18" style="color: #cbd5e1; margin-left: auto;"></iconify-icon>
        </a>
    </div>
</div>
