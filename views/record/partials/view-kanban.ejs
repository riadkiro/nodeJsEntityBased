<!-- views/record/partials/view-kanban.ejs -->
<div x-data="recordKanban">
    <!-- project list -->
    <div class="relative pt-5">
        <div class="perfect-scrollbar -mx-2 h-full">
            <div class="flex flex-nowrap items-start gap-5 overflow-x-auto px-2 pb-16">
                <template x-for="column in columns" :key="column.id">
                    <div class="panel w-72 flex-none bg-gray-50 dark:bg-black/20 border dark:border-gray-800"
                        :style="column.color ? `border-top: 4px solid ${column.color}` : ''">
                        <div class="mb-5 flex justify-between items-center">
                            <div class="flex items-center gap-2">
                                <template x-if="column.icon">
                                    <iconify-icon :icon="column.icon" :style="`color: ${column.color}`"></iconify-icon>
                                </template>
                                <h4 x-text="column.title" class="text-base font-bold uppercase tracking-wider"></h4>
                            </div>

                            <div class="flex items-center">
                                <button type="button" class="hover:text-primary ltr:mr-2 rtl:ml-2"
                                    @click="addRecord(column.id)">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                        xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                        <circle opacity="0.5" cx="12" cy="12" r="10" stroke="currentColor"
                                            stroke-width="1.5"></circle>
                                        <path d="M15 12L12 12M12 12L9 12M12 12L12 9M12 12L12 15" stroke="currentColor"
                                            stroke-width="1.5" stroke-linecap="round"></path>
                                    </svg>
                                </button>
                                <div x-data="dropdown" @click.outside="open = false" class="dropdown">
                                    <button type="button" class="hover:text-primary" @click="toggle">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-5 w-5 opacity-70 hover:opacity-100">
                                            <circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5">
                                            </circle>
                                            <circle opacity="0.5" cx="12" cy="12" r="2" stroke="currentColor"
                                                stroke-width="1.5"></circle>
                                            <circle cx="19" cy="12" r="2" stroke="currentColor" stroke-width="1.5">
                                            </circle>
                                        </svg>
                                    </button>
                                    <ul x-cloak x-show="open" x-transition x-transition.duration.300ms
                                        class="ltr:right-0 rtl:left-0 z-[10]">
                                        <li><a href="javascript:;" @click="toggle">Vider la colonne</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- task list -->
                        <div class="sortable-list min-h-[150px] space-y-4" :data-id="column.id">
                            <template x-for="task in column.tasks" :key="task.id">
                                <div :data-id="task.id"
                                    class="cursor-move space-y-3 rounded-lg bg-gray-100 p-4 shadow-sm border border-transparent hover:border-primary transition-all dark:bg-[#121c2c] group max-w-[197px] w-full mx-auto"
                                    style="max-width: 197px">
                                    <div class="flex justify-between items-start mb-2">
                                        <div class="text-xs font-bold text-gray-800 dark:text-white-light leading-4 h-12 overflow-hidden w-full line-clamp-3 break-words"
                                            x-text="task.title"></div>
                                    </div>

                                    <template x-if="task.description">
                                        <p class="text-xs text-white-dark line-clamp-2" x-text="task.description"></p>
                                    </template>

                                    <!-- Tags placeholder - logic can be added later if entity has tags -->
                                    <div class="flex flex-wrap items-center gap-2">
                                        <template x-if="task.tags?.length">
                                            <template x-for="(tag , i) in task.tags" :key="i">
                                                <div
                                                    class="badge bg-primary/10 text-primary text-[10px] px-2 py-0.5 rounded flex items-center gap-1">
                                                    <iconify-icon icon="solar:tag-bold" width="10"></iconify-icon>
                                                    <span x-text="tag"></span>
                                                </div>
                                            </template>
                                        </template>
                                        <template x-if="!task.tags?.length">
                                            <div class="text-[10px] text-white-dark/50 italic flex items-center gap-1">
                                                <iconify-icon icon="solar:tag-linear" width="10"></iconify-icon>
                                                <span>Sans tag</span>
                                            </div>
                                        </template>
                                    </div>

                                    <div
                                        class="flex items-center justify-between mt-4 pt-3 border-t border-gray-50 dark:border-gray-800">
                                        <div class="flex items-center gap-1 text-[10px] font-medium text-white-dark">
                                            <iconify-icon icon="solar:calendar-linear" width="14"></iconify-icon>
                                            <span x-text="task.date"></span>
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <button type="button" class="p-1 hover:text-info transition-colors"
                                                @click="editRecord(task.id)">
                                                <iconify-icon icon="solar:pen-new-square-bold"
                                                    width="16"></iconify-icon>
                                            </button>
                                            <button type="button" class="p-1 hover:text-danger transition-colors"
                                                @click="deleteRecord(task.id)">
                                                <iconify-icon icon="solar:trash-bin-trash-bold"
                                                    width="16"></iconify-icon>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </template>
                        </div>

                        <div class="pt-4 mt-2">
                            <button type="button"
                                class="btn btn-primary flex items-center justify-center w-full gap-2 py-2.5 rounded-lg text-xs font-bold uppercase"
                                @click="addRecord(column.id)">
                                <iconify-icon icon="solar:add-circle-bold" width="18"></iconify-icon>
                                Ajouter un record
                            </button>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>
</div>

<script id="kanban-records-data" type="application/json"><%- JSON.stringify(records || []) %></script>
<script id="kanban-entity-data" type="application/json"><%- JSON.stringify(entity || {}) %></script>

<script src="/themes/default/assets/js/Sortable.min.js"></script>
<script>
    document.addEventListener("alpine:init", () => {
        Alpine.data("recordKanban", () => ({
            columns: [],
            kanbanField: '<%= (view.settings && view.settings.kanbanField) ? view.settings.kanbanField : "status" %>',

            init() {
                this.prepareData();
                this.initializeSortable();
                this.initDragScroll();
            },

            initDragScroll() {
                const slider = document.querySelector('.overflow-x-auto');
                if (!slider) return;
                let isDown = false;
                let startX;
                let scrollLeft;

                slider.addEventListener('mousedown', (e) => {
                    // Don't drag if clicking on a button or card, only background or empty space
                    if (e.target.closest('.cursor-move') || e.target.closest('button') || e.target.closest('.dropdown') || e.target.closest('a') || e.target.closest('input')) return;

                    isDown = true;
                    slider.classList.add('cursor-grabbing');
                    slider.classList.remove('cursor-grab');
                    slider.style.userSelect = 'none'; // Prevent text selection
                    startX = e.pageX - slider.offsetLeft;
                    scrollLeft = slider.scrollLeft;
                });

                slider.addEventListener('mouseleave', () => {
                    isDown = false;
                    slider.classList.remove('cursor-grabbing');
                    slider.style.removeProperty('user-select');
                });

                slider.addEventListener('mouseup', () => {
                    isDown = false;
                    slider.classList.remove('cursor-grabbing');
                    slider.classList.add('cursor-grab');
                    slider.style.removeProperty('user-select');
                });

                slider.addEventListener('mousemove', (e) => {
                    if (!isDown) return;
                    e.preventDefault();
                    const x = e.pageX - slider.offsetLeft;
                    const walk = (x - startX) * 2; // scroll-fast
                    slider.scrollLeft = scrollLeft - walk;
                });

                // Add cursor-grab style initially
                slider.classList.add('cursor-grab');
            },

            prepareData() {
                try {
                    const rawRecords = JSON.parse(document.getElementById('kanban-records-data').textContent);
                    const entity = JSON.parse(document.getElementById('kanban-entity-data').textContent);

                    let cols = [];
                    const field = this.kanbanField;

                    if (field === 'status') {
                        if (entity.statusClassification && entity.statusClassification.options) {
                            cols = entity.statusClassification.options.map(opt => ({
                                id: opt._id,
                                title: opt.label,
                                color: opt.color,
                                icon: opt.icon,
                                tasks: []
                            }));
                            cols.push({ id: 'none', title: 'Sans Statut', tasks: [] });
                        } else {
                            cols = [
                                { id: 'draft', title: 'Brouillon', tasks: [] },
                                { id: 'published', title: 'Publié', tasks: [] },
                                { id: 'archived', title: 'Archivé', tasks: [] }
                            ];
                        }
                    } else {
                        // Classification based columns
                        const cls = entity.classifications ? entity.classifications.find(c => c._id === field) : null;
                        if (cls && cls.options) {
                            cols = cls.options.map(opt => ({
                                id: opt._id,
                                title: opt.label,
                                color: opt.color, // Assuming options have color/icon
                                icon: opt.icon,
                                tasks: []
                            }));
                            cols.push({ id: 'none', title: 'Non classé', tasks: [] });
                        }
                    }

                    (rawRecords || []).forEach(r => {
                        const task = {
                            id: r._id,
                            title: r.title || 'Sans titre',
                            description: r.description || '',
                            date: r.createdAt ? new Date(r.createdAt).toLocaleDateString() : 'N/A',
                            status: r.status,
                            classificationValues: r.classificationValues || [], // Ensure it exists
                            tags: r.tags || [],
                            customFields: r.customFields || []
                        };

                        let colId = 'none';

                        if (field === 'status') {
                            colId = task.status || 'none';
                        } else {
                            if (task.classificationValues) {
                                const val = task.classificationValues.find(cv => cv.classificationId === field);
                                if (val) colId = val.optionId;
                            }
                        }

                        // Find column
                        const col = cols.find(c => c.id === colId);
                        if (col) col.tasks.push(task);
                        else {
                            // Fallback to 'none' or first
                            const fallback = cols.find(c => c.id === 'none') || cols[0];
                            if (fallback) fallback.tasks.push(task);
                        }
                    });

                    this.columns = cols;
                } catch (e) {
                    console.error("[Kanban View] Initialization Error:", e);
                }
            },

            initializeSortable() {
                setTimeout(() => {
                    const sortable = document.querySelectorAll('.sortable-list');
                    const scrollEl = document.querySelector('.overflow-x-auto'); // Identify the scroll container
                    const self = this; // Capture 'this' for onEnd

                    for (let i = 0; i < sortable.length; i++) {
                        Sortable.create(sortable[i], {
                            animation: 200,
                            group: 'status',
                            ghostClass: 'sortable-ghost',
                            dragClass: 'sortable-drag',
                            scroll: scrollEl, // Explicitly set scroll element for auto-scrolling
                            bubbleScroll: true, // Allow nested scrolling
                            scrollSensitivity: 30, // Distance from edge (px) to trigger scroll
                            scrollSpeed: 10, // Speed of scroll
                            async onEnd(evt) {
                                const recordId = evt.item.getAttribute('data-id');
                                const newColId = evt.to.getAttribute('data-id');

                                if (!recordId || !newColId) return;

                                // Prevent unnecessary API calls if dropped in same list
                                if (evt.from === evt.to) return;

                                try {
                                    let url, body;

                                    if (self.kanbanField === 'status') {
                                        url = `/account/<%= account_number %>/api/record/update-status`;
                                        body = { recordId, status: newColId };
                                    } else {
                                        url = `/account/<%= account_number %>/api/record/update-classification`;
                                        body = {
                                            recordId,
                                            classificationId: self.kanbanField,
                                            optionId: newColId
                                        };
                                    }

                                    const res = await fetch(url, {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(body)
                                    });
                                    const data = await res.json();
                                    if (!data.success) {
                                        console.warn('Update failed, reverting (UI sync needed)');
                                        // Ideally revert UI change here if failed
                                    }
                                } catch (error) {
                                    console.error('Error updating record:', error);
                                }
                            }
                        });
                    }
                }, 100);
            },
            addRecord(columnId) {
                let url = `/account/<%= account_number %>/record/<%= entity.slug %>/add`;
                if (this.kanbanField === 'status' && columnId !== 'none') {
                    url += `?status=${columnId}`;
                }
                // Pre-filling classification is harder without updating the ADD form controller/view
                // ignoring for now unless requested
                window.location.href = url;
            },
            editRecord(id) {
                window.location.href = `/account/<%= account_number %>/record/<%= entity.slug %>/edit/${id}`;
            },
            async deleteRecord(id) {
                if (confirm('Confirmer la suppression ?')) {
                    window.location.href = `/account/<%= account_number %>/record/<%= entity.slug %>/delete/${id}`;
                }
            }
        }));
    });
</script>