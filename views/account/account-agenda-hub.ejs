<%# Agenda Hub — Aggregated events across all records %>
<% const _apiBase = '/account/' + account_number; %>

<style>
/* ═══ Agenda Hub — Full-Height App Layout ═══ */
.ah-page {
    display:flex; flex-direction:column; width:100%; height:calc(100vh - 86px); min-height:540px;
    padding:0; overflow:hidden; box-sizing:border-box; border:1px solid var(--focus-border,#e5e7eb);
    border-radius:var(--focus-radius,14px); background:var(--focus-surface,#fff); box-shadow:var(--focus-shadow-soft);
}
.ah-view-pills {
    display:flex; gap:2px; padding:3px; background:var(--focus-surface-alt,#f1f5f9); border-radius:10px; border:1px solid var(--focus-border,#e5e7eb);
}
.ah-vpill {
    display:flex; align-items:center; gap:5px; padding:6px 12px; border:none; border-radius:8px;
    font-size:12px; font-weight:600; color:#6b7280; background:transparent; cursor:pointer;
    transition:all .2s; font-family:'Nunito',sans-serif; white-space:nowrap;
}
.ah-vpill:hover { color:#374151; background:rgba(0,0,0,.04); }
.ah-vpill.active { background:var(--focus-surface,#fff); color:var(--focus-brand,#634efb); box-shadow:0 1px 3px rgba(17,24,39,.08); }
.ah-count-badge {
    display:inline-flex; align-items:center; justify-content:center; min-width:22px; height:22px;
    padding:0 6px; border-radius:11px; font-size:11px; font-weight:700;
    background:var(--focus-brand-soft,#ebe8ff); color:var(--focus-brand,#634efb);
}

.ah-body { display:flex; flex:1; min-height:0; overflow:hidden; }

/* ── Sidebar ── */
.ah-sidebar {
    width:var(--focus-sidebar-width,350px); flex-shrink:0; border-right:1px solid var(--focus-border,#e5e7eb);
    display:flex; flex-direction:column; background:var(--focus-surface,#fff); overflow:hidden; box-sizing:border-box;
}
.ah-sidebar-header {
    min-height:64px; padding:14px 16px; border-bottom:1px solid var(--focus-border,#e5e7eb); box-sizing:border-box;
    font-size:12px; font-weight:700; color:var(--focus-text,#111827); background:var(--focus-surface,#fff);
    display:flex; align-items:center; justify-content:space-between;
}
.ah-sidebar-title { display:flex; align-items:center; gap:7px; min-width:0; font-size:14px; font-weight:800; }
.ah-sidebar-title-icon { width:32px; height:32px; display:inline-flex; align-items:center; justify-content:center; flex:0 0 auto; border-radius:10px; color:var(--focus-brand,#634efb); background:var(--focus-brand-soft,#ebe8ff); }
.ah-sidebar-header .ah-count-badge { min-width:20px; height:20px; padding:0 5px; font-size:10px; }
.ah-sidebar-actions { display:flex; align-items:center; gap:7px; flex-shrink:0; }
.ah-sidebar-header .ah-view-pills { flex-shrink:0; }
.ah-sidebar-header .ah-vpill { padding:5px 8px; font-size:11px; }
.ah-new-event-btn {
    width:30px; height:30px; padding:0; border:0; border-radius:9px; display:inline-flex; align-items:center; justify-content:center;
    color:#fff; background:var(--focus-brand,#634efb); cursor:pointer; box-shadow:0 4px 12px var(--focus-brand-ring);
    transition:background .15s,transform .15s,box-shadow .15s;
}
.ah-new-event-btn:hover { background:var(--focus-brand-hover,#5742e8); transform:translateY(-1px); box-shadow:0 6px 15px rgba(99,78,251,.22); }
.ah-sidebar-search {
    margin:10px 12px; padding:7px 10px; border:1px solid var(--focus-border,#e5e7eb);
    border-radius:var(--focus-control-radius,10px); font-size:12px; background:var(--focus-surface,#fff); color:var(--focus-text,#111827);
    outline:none; font-family:inherit; width:calc(100% - 24px);
}
.ah-sidebar-search:focus { border-color:var(--focus-brand,#634efb); box-shadow:0 0 0 3px var(--focus-brand-ring); }
.ah-sidebar-body { flex:1; overflow-y:auto; padding:4px 0; background:var(--focus-surface,#fff); }
.ah-sidebar-all {
    display:flex; align-items:center; gap:8px; padding:8px 16px;
    font-size:12px; font-weight:700; color:var(--focus-brand,#634efb); cursor:pointer;
    transition:background .15s; border-bottom:1px solid var(--focus-border-soft,#eef1f6);
}
.ah-sidebar-all:hover { background:color-mix(in srgb,var(--focus-brand-soft,#ebe8ff) 68%,#fff); }
.ah-sidebar-all.active { background:var(--focus-brand-soft,#ebe8ff); box-shadow:inset 4px 0 0 var(--focus-brand,#634efb); font-weight:800; }
.ah-entity-group { border-bottom:1px solid #f1f5f9; }
.ah-entity-header {
    display:flex; align-items:center; gap:8px; padding:8px 16px; cursor:pointer;
    font-size:12px; font-weight:700; color:#0e1726; transition:background .15s;
}
.ah-entity-header:hover { background:#f8fafc; }
.ah-entity-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
.ah-entity-count {
    margin-left:auto; font-size:10px; font-weight:700;
    padding:1px 6px; border-radius:6px; background:#f1f5f9; color:#9ca3af;
}
.ah-record-item {
    display:flex; align-items:center; gap:8px; padding:6px 16px 6px 34px;
    font-size:12px; color:#6b7280; cursor:pointer; transition:all .15s;
}
.ah-record-item:hover { background:#f8fafc; color:#0e1726; }
.ah-record-item.active { background:var(--focus-brand-soft,#ebe8ff); color:var(--focus-brand,#634efb); font-weight:700; }
.ah-record-count {
    margin-left:auto; font-size:10px; font-weight:600; color:#d1d5db;
}

/* ── Upcoming events sidebar ── */
.ah-upcoming-sidebar {
    width:320px; flex:0 0 320px; min-width:0; display:flex; flex-direction:column; overflow:hidden;
    border-left:1px solid var(--focus-border,#e5e7eb); background:#fbfcfe; box-sizing:border-box;
}
.ah-upcoming-header {
    min-height:64px; padding:14px 16px; display:flex; align-items:center; justify-content:space-between; gap:10px;
    border-bottom:1px solid var(--focus-border,#e5e7eb); background:#fff; box-sizing:border-box;
}
.ah-upcoming-title { min-width:0; display:flex; align-items:center; gap:9px; color:var(--focus-text,#111827); font-size:13px; font-weight:850; }
.ah-upcoming-title-icon {
    width:30px; height:30px; flex:0 0 auto; display:inline-flex; align-items:center; justify-content:center;
    border-radius:9px; color:var(--focus-brand,#634efb); background:var(--focus-brand-soft,#ebe8ff);
}
.ah-upcoming-all { border:0; background:transparent; color:var(--focus-brand,#634efb); padding:5px 0; font:inherit; font-size:10.5px; font-weight:800; cursor:pointer; white-space:nowrap; }
.ah-upcoming-all:hover { color:var(--focus-brand-hover,#5742e8); }
.ah-upcoming-list { flex:1; min-height:0; overflow-y:auto; padding:12px; display:flex; flex-direction:column; gap:8px; overscroll-behavior:contain; }
.ah-upcoming-card {
    width:100%; min-height:72px; display:grid; grid-template-columns:46px minmax(0,1fr) 30px; align-items:center; gap:10px;
    padding:9px 10px; border:1px solid var(--focus-border,#e5e7eb); border-radius:12px; background:#fff;
    color:inherit; text-align:left; font:inherit; cursor:pointer; box-sizing:border-box; transition:border-color .15s,box-shadow .15s,transform .15s;
}
.ah-upcoming-card:hover { border-color:color-mix(in srgb,var(--focus-brand,#634efb) 25%,#fff); box-shadow:0 7px 18px rgba(15,23,42,.055); transform:translateY(-1px); }
.ah-upcoming-date {
    width:46px; height:50px; display:flex; flex-direction:column; align-items:center; justify-content:center;
    border-radius:11px; color:var(--focus-brand,#634efb); background:color-mix(in srgb,var(--focus-brand-soft,#ebe8ff) 72%,#fff);
}
.ah-upcoming-day { font-size:16px; font-weight:900; line-height:1; }
.ah-upcoming-month { margin-top:4px; font-size:9px; font-weight:850; line-height:1; text-transform:uppercase; letter-spacing:.04em; }
.ah-upcoming-copy { min-width:0; }
.ah-upcoming-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#172033; font-size:12px; font-weight:850; }
.ah-upcoming-meta { min-width:0; margin-top:7px; display:flex; align-items:center; gap:5px; flex-wrap:wrap; color:#8793a8; font-size:9.5px; font-weight:650; }
.ah-upcoming-delay { display:inline-flex; align-items:center; min-height:19px; padding:0 7px; border-radius:999px; color:var(--focus-brand,#634efb); background:var(--focus-brand-soft,#ebe8ff); font-size:9px; font-weight:850; white-space:nowrap; }
.ah-upcoming-record {
    width:30px; height:30px; display:inline-flex; align-items:center; justify-content:center; border:1px solid #dbe4f0;
    border-radius:50%; color:var(--focus-brand,#634efb); background:#f4f6ff; cursor:pointer;
}
.ah-upcoming-record:hover { background:var(--focus-brand-soft,#ebe8ff); border-color:color-mix(in srgb,var(--focus-brand,#634efb) 24%,#fff); }
.ah-upcoming-empty { margin:auto 10px; padding:28px 15px; border:1px dashed #dbe4f0; border-radius:12px; color:#94a3b8; text-align:center; font-size:11px; line-height:1.5; }
.ah-upcoming-footer { flex:0 0 auto; padding:11px 14px; border-top:1px solid var(--focus-border-soft,#eef1f6); background:#fff; }
.ah-upcoming-footer button { width:100%; border:0; background:transparent; color:var(--focus-brand,#634efb); font:inherit; font-size:10.5px; font-weight:800; cursor:pointer; }

/* ── Main ── */
.ah-main { flex:1; min-width:0; display:flex; flex-direction:column; overflow:hidden; }
.ah-calendar-container {
    --fc-button-text-color:var(--focus-brand,#634efb);
    --fc-button-bg-color:var(--focus-surface,#fff);
    --fc-button-border-color:var(--focus-border,#e5e7eb);
    --fc-button-hover-bg-color:var(--focus-brand-soft,#ebe8ff);
    --fc-button-hover-border-color:var(--focus-brand,#634efb);
    --fc-button-active-bg-color:var(--focus-brand,#634efb);
    --fc-button-active-border-color:var(--focus-brand,#634efb);
    flex:1; min-height:0; padding:16px;
}
.ah-list-container { flex:1; min-height:0; overflow-y:auto; padding:16px; }

/* FullCalendar overrides */
.ah-calendar-container .fc { font-family:'Nunito',sans-serif; height:100% !important; }
.ah-calendar-container .fc .fc-toolbar-title { font-size:20px; font-weight:800; color:var(--focus-text,#111827); text-transform:capitalize; }
.ah-calendar-container .fc .fc-toolbar-chunk { display:flex; align-items:center; gap:8px; }
.ah-calendar-container .fc .fc-button-group { gap:6px; }
.ah-calendar-container .fc .fc-button {
    min-height:36px !important; margin:0 !important;
    background-color:var(--focus-surface,#fff) !important; border:1px solid var(--focus-border,#e5e7eb) !important;
    color:var(--focus-brand,#634efb) !important; -webkit-text-fill-color:var(--focus-brand,#634efb) !important;
    font-size:12px !important; font-weight:700 !important;
    padding:7px 13px !important; border-radius:var(--focus-control-radius,10px) !important;
    transition:background-color .15s,border-color .15s,color .15s,box-shadow .15s !important;
    box-shadow:none !important; text-transform:none !important;
}
.ah-calendar-container .fc .fc-button-group > .fc-button { margin:0 !important; border-radius:var(--focus-control-radius,10px) !important; }
.ah-calendar-container .fc .fc-prev-button,
.ah-calendar-container .fc .fc-next-button { width:36px; padding:0 !important; }
.ah-calendar-container .fc .fc-today-button:not(:disabled) { background-color:var(--focus-brand-soft,#ebe8ff) !important; border-color:transparent !important; }
.ah-calendar-container .fc .fc-today-button:disabled { color:var(--focus-muted,#9ca3af) !important; background-color:var(--focus-surface-alt,#f1f5f9) !important; opacity:1; }
.ah-calendar-container .fc .fc-button:focus,
.ah-calendar-container .fc .fc-button:focus-visible { outline:0 !important; box-shadow:0 0 0 2px var(--focus-brand-ring) !important; }
.ah-calendar-container .fc .fc-button:not(:disabled):hover { background-color:var(--focus-brand-soft,#ebe8ff) !important; border-color:color-mix(in srgb,var(--focus-brand,#634efb) 28%,#fff) !important; color:var(--focus-brand,#634efb) !important; }
.ah-calendar-container .fc .fc-button-primary:not(:disabled).fc-button-active,
.ah-calendar-container .fc .fc-button-primary:not(:disabled):active {
    background-color:var(--focus-brand,#634efb) !important;
    border-color:var(--focus-brand,#634efb) !important;
    color:#fff !important; -webkit-text-fill-color:#fff !important; opacity:1 !important;
}
.ah-calendar-container .fc .fc-col-header-cell-cushion { font-size:12px; font-weight:700; color:#6b7280; text-transform:uppercase; letter-spacing:.04em; }
.ah-calendar-container .fc .fc-daygrid-day-number { font-size:13px; font-weight:600; color:#374151; padding:6px 8px; }
.ah-calendar-container .fc .fc-day-today { background:color-mix(in srgb,var(--focus-brand-soft,#ebe8ff) 58%,#fff) !important; }
.ah-calendar-container .fc .fc-event {
    border:none !important; border-radius:6px !important; padding:2px 6px !important;
    font-size:12px !important; font-weight:600 !important; cursor:pointer !important;
    transition:transform .15s, box-shadow .15s !important;
}
.ah-calendar-container .fc .fc-event:hover {
    transform:translateY(-1px) !important; box-shadow:0 4px 12px rgba(0,0,0,.15) !important;
}
.ah-calendar-container .fc td, .ah-calendar-container .fc th { border-color:#f1f3f5 !important; }
.ah-calendar-container .fc .fc-scrollgrid { border-color:#e8ecf1 !important; }
.ah-calendar-container .fc .fc-timegrid-slot { height:40px; }
.ah-calendar-container .fc .fc-timegrid-slot-label-cushion { font-size:11px; font-weight:600; color:#9ca3af; }
.ah-calendar-container .fc .fc-now-indicator-line { border-color:#ef4444 !important; }

/* List view table */
.ah-list-table { width:100%; border-collapse:collapse; }
.ah-list-table th {
    text-align:left; padding:10px 14px; font-size:11px; font-weight:700;
    color:#9ca3af; text-transform:uppercase; letter-spacing:.05em;
    border-bottom:1px solid #e8ecf1; white-space:nowrap;
}
.ah-list-table td {
    padding:10px 14px; border-bottom:1px solid #f1f5f9; font-size:13px;
    color:#374151; white-space:nowrap;
}
.ah-list-table tr { cursor:pointer; transition:background .15s; }
.ah-list-table tr:hover { background:#f9fafb; }
.ah-status-pill {
    font-size:10px; font-weight:700; padding:3px 8px; border-radius:6px;
    text-transform:uppercase; letter-spacing:.03em; white-space:nowrap;
}
.ah-record-link { color:var(--focus-brand,#634efb); font-weight:700; font-size:12px; text-decoration:none; }
.ah-record-link:hover { text-decoration:underline; }

/* Empty state */
.ah-empty { text-align:center; padding:60px 20px; color:#9ca3af; }
.ah-empty svg { opacity:.2; margin-bottom:12px; }
.ah-empty h3 { font-size:16px; font-weight:700; color:#374151; margin:0 0 4px; }
.ah-empty p { font-size:13px; margin:0; }

/* ═══ Event Detail Modal ═══ */
.ah-modal-overlay {
    position:fixed; inset:0; z-index:9999;
    background:rgba(0,0,0,.25);
    backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px);
    display:flex; align-items:center; justify-content:center;
    animation:ahFadeIn .2s ease;
}
.ah-modal {
    background:#fff; border-radius:16px;
    box-shadow:0 20px 60px rgba(0,0,0,.15);
    width:480px; max-width:calc(100vw - 40px);
    max-height:calc(100vh - 40px); overflow-y:auto;
    animation:ahSlideUp .3s ease;
}
@keyframes ahFadeIn { from { opacity:0; } to { opacity:1; } }
@keyframes ahSlideUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }

.ah-modal-header {
    display:flex; align-items:center; justify-content:space-between;
    padding:20px 24px 0;
}
.ah-modal-header-left { display:flex; align-items:center; gap:10px; }
.ah-modal-icon {
    width:36px; height:36px; border-radius:10px;
    display:flex; align-items:center; justify-content:center;
    background:var(--focus-brand-soft,#ebe8ff);
    color:var(--focus-brand,#634efb);
}
.ah-modal-header h3 { font-size:16px; font-weight:700; color:#0e1726; margin:0; }
.ah-modal-close {
    width:32px; height:32px; border:none; border-radius:8px;
    background:transparent; color:#9ca3af; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    transition:all .15s;
}
.ah-modal-close:hover { background:#f1f5f9; color:#374151; }

.ah-modal-body { padding:20px 24px; display:flex; flex-direction:column; gap:14px; }
.ah-detail-row {
    display:flex; align-items:flex-start; gap:10px;
}
.ah-detail-icon {
    width:28px; height:28px; border-radius:8px;
    display:flex; align-items:center; justify-content:center;
    background:#f1f5f9; color:#6b7280; flex-shrink:0; margin-top:1px;
}
.ah-detail-content { flex:1; min-width:0; }
.ah-detail-label {
    font-size:11px; font-weight:700; color:#9ca3af;
    text-transform:uppercase; letter-spacing:.04em; margin-bottom:2px;
}
.ah-detail-value {
    font-size:13px; font-weight:600; color:#0e1726;
}
.ah-detail-notes {
    font-size:13px; color:#6b7280; line-height:1.5;
    background:#f9fafb; border-radius:8px; padding:10px 12px;
    border:1px solid #f1f5f9;
}
.ah-event-form { width:640px; }
.ah-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:13px; }
.ah-form-field { min-width:0; display:flex; flex-direction:column; gap:6px; }
.ah-form-field.is-wide { grid-column:1/-1; }
.ah-form-label { color:#69758a; font-size:10.5px; font-weight:850; text-transform:uppercase; letter-spacing:.045em; }
.ah-form-control {
    width:100%; min-height:40px; box-sizing:border-box; padding:9px 11px; border:1px solid var(--focus-border,#e5e7eb);
    border-radius:var(--focus-control-radius,10px); outline:0; background:#fff; color:var(--focus-text,#111827);
    font:inherit; font-size:12.5px; font-weight:650; transition:border-color .15s,box-shadow .15s,background .15s;
}
.ah-form-control:focus { border-color:var(--focus-brand,#634efb); box-shadow:0 0 0 3px var(--focus-brand-ring); }
.ah-form-control:disabled { opacity:.72; cursor:not-allowed; background:#f6f8fb; }
textarea.ah-form-control { min-height:86px; resize:vertical; line-height:1.45; }
.ah-form-switches { grid-column:1/-1; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:9px; }
.ah-form-switch {
    min-height:48px; display:flex; align-items:center; justify-content:space-between; gap:10px; padding:8px 10px;
    border:1px solid var(--focus-border,#e5e7eb); border-radius:11px; background:#fbfcfe; color:#42506a; cursor:pointer;
}
.ah-form-switch span { display:flex; flex-direction:column; gap:2px; min-width:0; font-size:11px; font-weight:800; }
.ah-form-switch small { color:#98a4b8; font-size:9px; font-weight:650; }
.ah-form-switch input { width:16px; height:16px; accent-color:var(--focus-brand,#634efb); }
.ah-form-error { grid-column:1/-1; padding:9px 11px; border:1px solid #fecaca; border-radius:9px; background:#fff7f7; color:#b91c1c; font-size:11px; font-weight:750; }
.ah-legacy-event-detail { display:none; }
.ah-modal-footer-actions { margin-left:auto; display:flex; align-items:center; gap:8px; }
.ah-modal-btn-danger { color:#ef4444; background:#fff; border:1px solid #fecaca; }
.ah-modal-btn-danger:hover { background:#fff7f7; border-color:#fca5a5; }
.ah-modal-btn:disabled { opacity:.55; cursor:not-allowed; transform:none; box-shadow:none; }

.ah-modal-footer {
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 24px 20px; gap:12px; border-top:1px solid #f1f5f9;
}
.ah-modal-btn {
    display:inline-flex; align-items:center; gap:6px;
    min-height:38px; padding:9px 18px; border-radius:var(--focus-control-radius,10px);
    font-size:13px; font-weight:600; cursor:pointer;
    transition:all .15s; font-family:'Nunito',sans-serif; border:none;
}
.ah-modal-btn-outline {
    background:var(--focus-surface,#fff); border:1px solid var(--focus-border,#e5e7eb); color:var(--focus-text-soft,#6b7280);
}
.ah-modal-btn-outline:hover { background:#f9fafb; border-color:#d1d5db; }
.ah-modal-btn-primary {
    background:var(--focus-brand,#634efb);
    color:#fff; border:none;
}
.ah-modal-btn-primary:hover { background:var(--focus-brand-hover,#5742e8); transform:translateY(-1px); box-shadow:0 5px 14px var(--focus-brand-ring); }

/* Modal dark mode */
.dark .ah-modal { background:#0e1726; border:1px solid #253b5c; }
.dark .ah-modal-header h3 { color:#e0e6ed; }
.dark .ah-modal-close:hover { background:#1b2e4b; color:#e0e6ed; }
.dark .ah-detail-icon { background:#1b2e4b; color:#888da8; }
.dark .ah-detail-label { color:#506690; }
.dark .ah-detail-value { color:#e0e6ed; }
.dark .ah-detail-notes { background:#1b2e4b; border-color:#253b5c; color:#888da8; }
.dark .ah-form-control { background:#1b2e4b; border-color:#253b5c; color:#e0e6ed; }
.dark .ah-form-label { color:#8ea0bd; }
.dark .ah-form-switch { background:#111f35; border-color:#253b5c; color:#dbe5f3; }
.dark .ah-form-switch small { color:#6f819f; }
.dark .ah-form-error { background:rgba(127,29,29,.18); border-color:#7f1d1d; color:#fecaca; }
.dark .ah-modal-btn-danger { background:#1b2e4b; border-color:#7f1d1d; color:#fca5a5; }
.dark .ah-modal-footer { border-color:#253b5c; }
.dark .ah-modal-btn-outline { background:#1b2e4b; border-color:#253b5c; color:#888da8; }

/* Loading */
.ah-loading { display:flex; align-items:center; justify-content:center; gap:10px; padding:60px; color:#888da8; font-size:14px; }
.ah-spin { width:24px; height:24px; border:3px solid #e2e8f0; border-top-color:var(--focus-brand,#634efb); border-radius:50%; animation:ahSpin .8s linear infinite; }
@keyframes ahSpin { to { transform:rotate(360deg); } }

/* ═══ Dark Mode ═══ */
.dark .ah-page { background:#0e1726; border-color:#253b5c; }
.dark .ah-view-pills { background:#1b2e4b; border-color:#253b5c; }
.dark .ah-vpill { color:#888da8; }
.dark .ah-vpill:hover { color:#e0e6ed; background:rgba(255,255,255,.04); }
.dark .ah-vpill.active { background:#0e1726; color:var(--focus-brand,#a78bfa); }
.dark .ah-sidebar { background:#0e1726; border-color:#253b5c; }
.dark .ah-sidebar-header { color:#e0e6ed; border-color:#253b5c; }
.dark .ah-sidebar-search { background:#1b2e4b; border-color:#253b5c; color:#e0e6ed; }
.dark .ah-sidebar-all { border-color:#1b2e4b; }
.dark .ah-sidebar-all:hover, .dark .ah-sidebar-all.active { background:#1b2e4b; }
.dark .ah-entity-group { border-color:#1b2e4b; }
.dark .ah-entity-header { color:#e0e6ed; }
.dark .ah-entity-header:hover { background:#1b2e4b; }
.dark .ah-entity-count { background:#1b2e4b; color:#506690; }
.dark .ah-record-item { color:#888da8; }
.dark .ah-record-item:hover { background:#1b2e4b; color:#e0e6ed; }
.dark .ah-record-item.active { background:var(--focus-brand-soft,#241c3f); color:var(--focus-brand,#a78bfa); }
.dark .ah-record-count { color:#506690; }
.dark .ah-upcoming-sidebar { background:#0b1424; border-color:#253b5c; }
.dark .ah-upcoming-header,.dark .ah-upcoming-footer { background:#0e1726; border-color:#253b5c; }
.dark .ah-upcoming-title,.dark .ah-upcoming-name { color:#e0e6ed; }
.dark .ah-upcoming-card { background:#0e1726; border-color:#253b5c; }
.dark .ah-upcoming-card:hover { border-color:#4f46e5; box-shadow:0 7px 18px rgba(0,0,0,.18); }
.dark .ah-upcoming-date,.dark .ah-upcoming-record { background:#1b2447; border-color:#253b5c; }
.dark .ah-upcoming-meta { color:#8ea0bd; }
.dark .ah-upcoming-empty { border-color:#253b5c; color:#8ea0bd; }
.dark .ah-calendar-container .fc .fc-toolbar-title { color:#e0e6ed; }
.dark .ah-calendar-container .fc .fc-button { background:#1b2e4b !important; border-color:#253b5c !important; color:#888da8 !important; }
.dark .ah-calendar-container .fc .fc-button:hover { background:#253b5c !important; color:#e0e6ed !important; }
.dark .ah-calendar-container .fc .fc-button-active { background:var(--focus-brand,#a78bfa) !important; border-color:var(--focus-brand,#a78bfa) !important; color:#111827 !important; }
.dark .ah-calendar-container .fc .fc-col-header-cell-cushion { color:#506690; }
.dark .ah-calendar-container .fc .fc-daygrid-day-number { color:#888da8; }
.dark .ah-calendar-container .fc .fc-day-today { background:var(--focus-brand-soft,#241c3f) !important; }
.dark .ah-calendar-container .fc td, .dark .ah-calendar-container .fc th { border-color:#1b2e4b !important; }
.dark .ah-calendar-container .fc .fc-scrollgrid { border-color:#253b5c !important; }
.dark .ah-calendar-container .fc .fc-timegrid-slot-label-cushion { color:#506690; }
.dark .ah-list-table th { color:#506690; border-color:#253b5c; }
.dark .ah-list-table td { color:#e0e6ed; border-color:#1b2e4b; }
.dark .ah-list-table tr:hover { background:#1b2e4b; }
.dark .ah-empty h3 { color:#e0e6ed; }
@media(max-width:1200px){
    .ah-upcoming-sidebar { width:280px; flex-basis:280px; }
}
@media(max-width:640px){
    .ah-page { height:auto; min-height:calc(100vh - 78px); overflow:visible; }
    .ah-sidebar-header { padding:12px 14px; }
    .ah-sidebar-header .ah-view-pills { flex-wrap:nowrap; min-width:max-content; }
    .ah-body { flex-direction:column; overflow:visible; }
    .ah-sidebar {
        width:100%;
        max-height:260px;
        border-right:none;
        border-bottom:1px solid #e8ecf1;
    }
    .ah-upcoming-sidebar {
        width:100%;
        max-height:360px;
        flex-basis:auto;
        border-left:none;
        border-bottom:1px solid #e8ecf1;
    }
    .ah-main { min-height:640px; overflow:visible; }
    .ah-calendar-container { min-height:620px; padding:10px; overflow:hidden; }
    .ah-calendar-container .fc .fc-toolbar.fc-header-toolbar {
        align-items:flex-start;
        flex-wrap:wrap;
        gap:8px;
        margin-bottom:10px;
    }
    .ah-calendar-container .fc .fc-toolbar-chunk {
        max-width:100%;
        display:flex;
        flex-wrap:wrap;
        gap:6px;
    }
    .ah-calendar-container .fc .fc-toolbar-title {
        font-size:16px;
        line-height:1.25;
        white-space:normal;
    }
    .ah-calendar-container .fc .fc-button {
        padding:5px 10px !important;
        font-size:11px !important;
    }
    .ah-list-container { overflow-x:auto; }
    .ah-form-grid,.ah-form-switches { grid-template-columns:1fr; }
}
</style>

<script>
document.body.classList.add('focus-workspace-mode', 'agenda-focus-mode');
window.addEventListener('pagehide', () => {
    document.body.classList.remove('focus-workspace-mode', 'agenda-focus-mode');
}, { once:true });
</script>

<div class="ah-page" x-data="agendaHub()" x-cloak>
    <!-- Body -->
    <div class="ah-body">
        <!-- Sidebar -->
        <div class="ah-sidebar">
            <div class="ah-sidebar-header">
                <span class="ah-sidebar-title">
                    <span class="ah-sidebar-title-icon"><iconify-icon icon="solar:calendar-bold-duotone" width="17"></iconify-icon></span>
                    Agenda
                    <span class="ah-count-badge" x-text="filteredEvents.length" x-show="!loading"></span>
                </span>
                <div class="ah-sidebar-actions">
                    <div class="ah-view-pills">
                        <button class="ah-vpill" :class="viewMode==='calendar' && 'active'" @click="setView('calendar')" title="Calendrier">
                            <iconify-icon icon="solar:calendar-bold-duotone" width="14"></iconify-icon>
                        </button>
                        <button class="ah-vpill" :class="viewMode==='list' && 'active'" @click="setView('list')" title="Liste">
                            <iconify-icon icon="solar:list-bold" width="14"></iconify-icon>
                        </button>
                    </div>
                    <button type="button" class="ah-new-event-btn" title="Nouvel événement" aria-label="Nouvel événement" @click="openCreateEvent()">
                        <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
                    </button>
                </div>
            </div>
            <input type="text" class="ah-sidebar-search" placeholder="Rechercher..."
                   x-model="search" @input="filterSearch()">
            <div class="ah-sidebar-body">
                <!-- All -->
                <div class="ah-sidebar-all" :class="!filterRecordId && 'active'" @click="clearFilter()">
                    <iconify-icon icon="solar:calendar-bold-duotone" width="16" style="color:var(--focus-brand,#634efb)"></iconify-icon>
                    Tous les événements
                    <span class="ah-count-badge" x-text="allEvents.length" style="margin-left:auto"></span>
                </div>

                <!-- Entities → Records -->
                <template x-for="ent in filteredEntities" :key="ent.entityId">
                    <div class="ah-entity-group">
                        <div class="ah-entity-header" @click="ent._open = !ent._open">
                            <span class="ah-entity-dot" :style="`background:${ent.entityColor}`"></span>
                            <span x-text="ent.entityName"></span>
                            <span class="ah-entity-count" x-text="ent.totalEvents"></span>
                        </div>
                        <template x-if="ent._open">
                            <div>
                                <template x-for="rec in ent.records" :key="rec.recordId">
                                    <div class="ah-record-item"
                                         :class="filterRecordId === rec.recordId && 'active'"
                                         @click="setFilter(rec.recordId)">
                                        <span x-text="rec.recordTitle"></span>
                                        <span class="ah-record-count" x-text="rec.eventCount"></span>
                                    </div>
                                </template>
                            </div>
                        </template>
                    </div>
                </template>
            </div>
        </div>

        <!-- Main content -->
        <div class="ah-main">
            <!-- Loading -->
            <template x-if="loading">
                <div class="ah-loading"><div class="ah-spin"></div> Chargement de l'agenda...</div>
            </template>

            <!-- Calendar View -->
            <template x-if="!loading && viewMode==='calendar'">
                <div class="ah-calendar-container" x-ref="calendarEl"></div>
            </template>

            <!-- List View -->
            <template x-if="!loading && viewMode==='list'">
                <div class="ah-list-container">
                    <template x-if="filteredEvents.length === 0">
                        <div class="ah-empty">
                            <iconify-icon icon="solar:calendar-minimalistic-linear" width="48"></iconify-icon>
                            <h3>Aucun événement</h3>
                            <p>Les événements créés depuis les fiches apparaîtront ici.</p>
                        </div>
                    </template>
                    <template x-if="filteredEvents.length > 0">
                        <table class="ah-list-table">
                            <thead>
                                <tr>
                                    <th>Titre</th>
                                    <th>Date</th>
                                    <th>Heure</th>
                                    <th>Type</th>
                                    <th>Statut</th>
                                    <th>Enregistrement</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="ev in filteredEvents" :key="ev._id">
                                    <tr @click="showDetail(ev)">
                                        <td style="font-weight:600" x-text="ev.title || 'Sans titre'"></td>
                                        <td x-text="formatDate(ev.date)"></td>
                                        <td style="color:var(--focus-brand,#634efb);font-weight:700" x-text="eventTimeLabel(ev)"></td>
                                        <td><span x-text="getType(ev)"></span></td>
                                        <td>
                                            <span class="ah-status-pill"
                                                  :style="`background:${getStatus(ev).color}15;color:${getStatus(ev).color}`"
                                                  x-text="getStatus(ev).label"></span>
                                        </td>
                                        <td>
                                            <a class="ah-record-link"
                                               :href="getRecordLink(ev)"
                                               @click.stop
                                               x-text="getRecordTitle(ev)"></a>
                                        </td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>
                    </template>
                </div>
            </template>
        </div>

        <!-- Upcoming events -->
        <aside class="ah-upcoming-sidebar" aria-label="Prochains événements">
            <div class="ah-upcoming-header">
                <div class="ah-upcoming-title">
                    <span class="ah-upcoming-title-icon"><iconify-icon icon="solar:calendar-mark-bold-duotone" width="16"></iconify-icon></span>
                    <span>Prochains événements</span>
                </div>
                <button type="button" class="ah-upcoming-all" @click="showAllEvents()">Voir tout</button>
            </div>
            <div class="ah-upcoming-list">
                <template x-for="ev in upcomingEvents" :key="'upcoming-' + ev._id">
                    <div class="ah-upcoming-card"
                         role="button"
                         tabindex="0"
                         @click="showDetail(ev)"
                         @keydown.enter.prevent="showDetail(ev)"
                         @keydown.space.prevent="showDetail(ev)">
                        <span class="ah-upcoming-date">
                            <span class="ah-upcoming-day" x-text="eventDay(ev.date)"></span>
                            <span class="ah-upcoming-month" x-text="eventMonth(ev.date)"></span>
                        </span>
                        <span class="ah-upcoming-copy">
                            <span class="ah-upcoming-name" x-text="ev.title || 'Sans titre'"></span>
                            <span class="ah-upcoming-meta">
                                <span x-text="eventTimeLabel(ev)"></span>
                                <span>·</span>
                                <span x-text="getStatus(ev).label"></span>
                                <span class="ah-upcoming-delay" x-text="relativeDayBadge(ev.date)"></span>
                            </span>
                        </span>
                        <button type="button" class="ah-upcoming-record" title="Ouvrir la fiche" @click.stop="openRecord(ev)">
                            <iconify-icon icon="solar:folder-with-files-bold-duotone" width="15"></iconify-icon>
                        </button>
                    </div>
                </template>
                <div class="ah-upcoming-empty" x-show="!loading && upcomingEvents.length === 0">
                    Aucun événement à venir
                </div>
            </div>
            <div class="ah-upcoming-footer">
                <button type="button" @click="setView('calendar')">Voir le calendrier complet →</button>
            </div>
        </aside>
    </div>

    <!-- Event Detail Modal -->
    <template x-if="eventModalOpen">
        <div class="ah-modal-overlay" @click="closeEventModal()">
            <div class="ah-modal ah-event-form" @click.stop>
                <div class="ah-modal-header">
                    <div class="ah-modal-header-left">
                        <div class="ah-modal-icon">
                            <iconify-icon :icon="eventMode === 'edit' ? 'solar:calendar-mark-bold-duotone' : 'solar:calendar-add-bold-duotone'" width="18"></iconify-icon>
                        </div>
                        <h3 x-text="eventMode === 'edit' ? 'Modifier l\'événement' : 'Nouvel événement'"></h3>
                    </div>
                    <button type="button" class="ah-modal-close" @click="closeEventModal()" aria-label="Fermer">
                        <iconify-icon icon="solar:close-circle-linear" width="18"></iconify-icon>
                    </button>
                </div>

                <div class="ah-modal-body">
                    <div class="ah-form-grid">
                        <div class="ah-form-error" x-show="eventError" x-text="eventError"></div>
                        <label class="ah-form-field is-wide">
                            <span class="ah-form-label">Titre</span>
                            <input x-ref="eventTitleInput" class="ah-form-control" type="text" maxlength="180"
                                   placeholder="Titre de l'événement" x-model="eventForm.title" @keydown.enter.prevent="saveEvent()">
                        </label>
                        <label class="ah-form-field is-wide">
                            <span class="ah-form-label">Fiche associée</span>
                            <select class="ah-form-control" x-model="eventForm.recordId" :disabled="eventMode === 'edit'">
                                <option value="">Agenda général</option>
                                <template x-for="record in recordOptions" :key="record.recordId">
                                    <option :value="record.recordId" x-text="record.entityName + ' · ' + record.recordTitle"></option>
                                </template>
                            </select>
                        </label>
                        <label class="ah-form-field">
                            <span class="ah-form-label" x-text="eventForm.allDay ? 'Date' : 'Début'"></span>
                            <input x-ref="eventStartInput" class="ah-form-control" type="datetime-local"
                                   :type="eventForm.allDay ? 'date' : 'datetime-local'"
                                   :step="eventForm.allDay ? null : 300"
                                   x-model="eventForm.startAt">
                        </label>
                        <label class="ah-form-field">
                            <span class="ah-form-label" x-text="eventForm.allDay ? 'Fin (optionnelle)' : 'Fin'"></span>
                            <input x-ref="eventEndInput" class="ah-form-control" type="datetime-local"
                                   :type="eventForm.allDay ? 'date' : 'datetime-local'"
                                   :step="eventForm.allDay ? null : 300"
                                   x-model="eventForm.endAt">
                        </label>
                        <label class="ah-form-field">
                            <span class="ah-form-label">Type</span>
                            <select class="ah-form-control" x-model="eventForm.type">
                                <template x-for="type in eventTypeOptions" :key="type.value">
                                    <option :value="type.value" x-text="type.label"></option>
                                </template>
                            </select>
                        </label>
                        <label class="ah-form-field">
                            <span class="ah-form-label">Statut</span>
                            <select class="ah-form-control" x-model="eventForm.statusOptionId">
                                <option value="">Statut par défaut</option>
                                <template x-for="status in statusOptions" :key="status._id">
                                    <option :value="String(status._id)" x-text="status.label"></option>
                                </template>
                            </select>
                        </label>
                        <label class="ah-form-field">
                            <span class="ah-form-label">Répétition</span>
                            <select class="ah-form-control" x-model="eventForm.recurrence">
                                <option value="none">Aucune</option>
                                <option value="daily">Tous les jours</option>
                                <option value="weekly">Toutes les semaines</option>
                                <option value="monthly">Tous les mois</option>
                                <option value="quarterly">Tous les 3 mois</option>
                                <option value="yearly">Tous les ans</option>
                            </select>
                        </label>
                        <label class="ah-form-field">
                            <span class="ah-form-label">Lieu</span>
                            <input class="ah-form-control" type="text" maxlength="240" placeholder="Ajouter un lieu" x-model="eventForm.location">
                        </label>
                        <label class="ah-form-field is-wide">
                            <span class="ah-form-label">Étiquettes</span>
                            <input class="ah-form-control" type="text" placeholder="Important, Client, Personnel..." x-model="eventForm.tags">
                        </label>
                        <label class="ah-form-field is-wide">
                            <span class="ah-form-label">Notes</span>
                            <textarea class="ah-form-control" maxlength="5000" placeholder="Ajouter des détails..." x-model="eventForm.notes"></textarea>
                        </label>
                        <div class="ah-form-switches">
                            <label class="ah-form-switch">
                                <span>Journée entière<small>Sans horaire précis</small></span>
                                <input type="checkbox" :checked="eventForm.allDay" @change="setAllDay($event.target.checked)">
                            </label>
                            <label class="ah-form-switch">
                                <span>À venir<small>Afficher dans la sidebar</small></span>
                                <input type="checkbox" x-model="eventForm.showInUpcoming">
                            </label>
                            <label class="ah-form-switch">
                                <span>Date importante<small>Mettre en valeur</small></span>
                                <input type="checkbox" x-model="eventForm.isImportant">
                            </label>
                        </div>
                    </div>
                </div>

                <div class="ah-modal-body ah-legacy-event-detail">
                    <!-- Date & Time -->
                    <div class="ah-detail-row">
                        <div class="ah-detail-icon">
                            <iconify-icon icon="solar:clock-circle-bold-duotone" width="16"></iconify-icon>
                        </div>
                        <div class="ah-detail-content">
                            <div class="ah-detail-label" x-text="isAllDayEvent(selectedEvent) ? 'Date' : 'Date & Heure'"></div>
                            <div class="ah-detail-value">
                                <span x-text="formatDate(selectedEvent.date)"></span>
                                <span style="color:var(--focus-brand,#634efb);margin-left:6px" x-text="eventTimeLabel(selectedEvent)"></span>
                                <template x-if="selectedEvent.end_date && !isAllDayEvent(selectedEvent)">
                                    <span style="color:#9ca3af"> — <span x-text="formatTime(selectedEvent.end_date)"></span></span>
                                </template>
                            </div>
                        </div>
                    </div>

                    <!-- Type -->
                    <div class="ah-detail-row">
                        <div class="ah-detail-icon">
                            <iconify-icon icon="solar:tag-bold-duotone" width="16"></iconify-icon>
                        </div>
                        <div class="ah-detail-content">
                            <div class="ah-detail-label">Type</div>
                            <div class="ah-detail-value" x-text="getType(selectedEvent)"></div>
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="ah-detail-row">
                        <div class="ah-detail-icon">
                            <iconify-icon icon="solar:check-circle-bold-duotone" width="16"></iconify-icon>
                        </div>
                        <div class="ah-detail-content">
                            <div class="ah-detail-label">Statut</div>
                            <div>
                                <span class="ah-status-pill"
                                      :style="`background:${getStatus(selectedEvent).color}15;color:${getStatus(selectedEvent).color}`"
                                      x-text="getStatus(selectedEvent).label"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Location -->
                    <template x-if="getFieldValue(selectedEvent, 'lieu_evenement')">
                        <div class="ah-detail-row">
                            <div class="ah-detail-icon">
                                <iconify-icon icon="solar:map-point-bold-duotone" width="16"></iconify-icon>
                            </div>
                            <div class="ah-detail-content">
                                <div class="ah-detail-label">Lieu</div>
                                <div class="ah-detail-value" x-text="getFieldValue(selectedEvent, 'lieu_evenement')"></div>
                            </div>
                        </div>
                    </template>

                    <!-- Duration -->
                    <template x-if="getFieldValue(selectedEvent, 'duree_evenement')">
                        <div class="ah-detail-row">
                            <div class="ah-detail-icon">
                                <iconify-icon icon="solar:hourglass-bold-duotone" width="16"></iconify-icon>
                            </div>
                            <div class="ah-detail-content">
                                <div class="ah-detail-label">Durée</div>
                                <div class="ah-detail-value" x-text="getFieldValue(selectedEvent, 'duree_evenement') + ' min'"></div>
                            </div>
                        </div>
                    </template>

                    <!-- Record -->
                    <div class="ah-detail-row">
                        <div class="ah-detail-icon">
                            <iconify-icon icon="solar:document-bold-duotone" width="16"></iconify-icon>
                        </div>
                        <div class="ah-detail-content">
                            <div class="ah-detail-label">Enregistrement</div>
                            <div>
                                <a class="ah-record-link" style="font-size:13px"
                                   :href="getRecordLink(selectedEvent)"
                                   x-text="getRecordTitle(selectedEvent)"></a>
                            </div>
                        </div>
                    </div>

                    <!-- Notes -->
                    <template x-if="getFieldValue(selectedEvent, 'notes_evenement')">
                        <div class="ah-detail-row">
                            <div class="ah-detail-icon">
                                <iconify-icon icon="solar:notes-bold-duotone" width="16"></iconify-icon>
                            </div>
                            <div class="ah-detail-content">
                                <div class="ah-detail-label">Notes</div>
                                <div class="ah-detail-notes" x-text="getFieldValue(selectedEvent, 'notes_evenement')"></div>
                            </div>
                        </div>
                    </template>
                </div>

                <div class="ah-modal-footer">
                    <button type="button" class="ah-modal-btn ah-modal-btn-danger"
                            x-show="eventMode === 'edit'" :disabled="eventSaving" @click="deleteEvent()">
                        <iconify-icon icon="solar:trash-bin-trash-linear" width="14"></iconify-icon>
                        Supprimer
                    </button>
                    <div class="ah-modal-footer-actions">
                        <button type="button" class="ah-modal-btn ah-modal-btn-outline" :disabled="eventSaving" @click="closeEventModal()">Annuler</button>
                        <button type="button" class="ah-modal-btn ah-modal-btn-primary" :disabled="eventSaving" @click="saveEvent()">
                            <iconify-icon :icon="eventSaving ? 'line-md:loading-twotone-loop' : 'solar:diskette-bold-duotone'" width="14"></iconify-icon>
                            <span x-text="eventSaving ? 'Enregistrement...' : (eventMode === 'edit' ? 'Enregistrer' : 'Créer')"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </template>
</div>

<link href="/assets/css/fullcalendar.min.css" rel="stylesheet" />
<script src="/assets/js/fullcalendar.min.js"></script>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('agendaHub', () => ({
        loading: true,
        viewMode: 'calendar',
        allEvents: [],
        entities: [],
        entityData: null,
        filterRecordId: null,
        search: '',
        calendar: null,
        selectedEvent: null,
        eventModalOpen: false,
        eventMode: 'create',
        eventSaving: false,
        eventError: '',
        eventForm: {
            title: '',
            recordId: '',
            startAt: '',
            endAt: '',
            type: 'autre',
            statusOptionId: '',
            recurrence: 'none',
            location: '',
            tags: '',
            notes: '',
            allDay: false,
            showInUpcoming: true,
            isImportant: false
        },
        fallbackEventTypeOptions: [
            { value:'anniversaire', label:'Anniversaire' },
            { value:'fete', label:'Fête' },
            { value:'jour_ferie', label:'Jour férié' },
            { value:'reunion', label:'Réunion' },
            { value:'rendez_vous', label:'Rendez-vous' },
            { value:'echeance', label:'Échéance' },
            { value:'rappel', label:'Rappel' },
            { value:'consultation', label:'Consultation' },
            { value:'tache', label:'Tâche' },
            { value:'personnel', label:'Personnel' },
            { value:'autre', label:'Autre' }
        ],
        _parentLookup: {},

        async init() {
            await this.fetchData();
            this.loading = false;
            window.addEventListener('keydown', event => {
                if (event.key === 'Escape' && this.eventModalOpen) this.closeEventModal();
            });
            this.$nextTick(() => {
                if (this.viewMode === 'calendar') this.initCalendar();
            });
        },

        async fetchData() {
            try {
                const res = await fetch('<%= _apiBase %>/api/agenda-hub', { credentials: 'include' });
                const data = await res.json();
                if (data.success) {
                    this.allEvents = data.events || [];
                    this.entities = (data.entities || []).map(e => ({ ...e, _open: true }));
                    this.entityData = data.entityData;
                    this._parentLookup = {};

                    // Build parent lookup from relations
                    this.entities.forEach(ent => {
                        ent.records.forEach(rec => {
                            this._parentLookup[rec.recordId] = {
                                recordId: rec.recordId,
                                recordTitle: rec.recordTitle,
                                entitySlug: ent.entitySlug
                            };
                        });
                    });
                }
            } catch(e) { console.error('[AgendaHub]', e); }
        },

        get filteredEvents() {
            if (!this.filterRecordId) return this.allEvents;
            return this.allEvents.filter(ev => {
                return (ev.relations || []).some(rel => {
                    const ids = Array.isArray(rel.value) ? rel.value : [rel.value];
                    return ids.some(id => id?.toString() === this.filterRecordId);
                });
            });
        },

        get upcomingEvents() {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            return this.filteredEvents
                .filter(ev => {
                    const date = new Date(ev.date);
                    const visible = this.booleanFieldValue(this.getFieldValue(ev, 'widget_prochains_evenements'), true);
                    return visible && !Number.isNaN(date.getTime()) && date.getTime() >= today.getTime();
                })
                .slice()
                .sort((a, b) => new Date(a.date) - new Date(b.date))
                .slice(0, 8);
        },

        get filteredEntities() {
            if (!this.search.trim()) return this.entities;
            const q = this.search.toLowerCase();
            return this.entities.filter(ent => {
                if (ent.entityName.toLowerCase().includes(q)) return true;
                return ent.records.some(r => r.recordTitle.toLowerCase().includes(q));
            });
        },

        get statusOptions() {
            return this.entityData?.statusClassification?.options || [];
        },

        get eventTypeOptions() {
            const field = (this.entityData?.customFields || []).find(item => item.name === 'type_evenement');
            const configured = field?.type_config?.options || field?.ui?.options || [];
            const normalized = configured.map(option => ({
                value: String(option?.value || option?.label || option || ''),
                label: String(option?.label || option?.value || option || '')
            })).filter(option => option.value);
            const options = normalized.length ? normalized : this.fallbackEventTypeOptions.slice();
            const current = String(this.eventForm.type || '');
            if (current && !options.some(option => option.value === current)) {
                options.push({ value:current, label:current.charAt(0).toUpperCase() + current.slice(1) });
            }
            return options;
        },

        get recordOptions() {
            return (this.entities || []).flatMap(entity =>
                (entity.records || []).map(record => ({
                    recordId:String(record.recordId),
                    recordTitle:record.recordTitle || 'Sans titre',
                    entityName:entity.entityName || 'Fiche'
                }))
            ).sort((a, b) => (a.entityName + a.recordTitle).localeCompare(b.entityName + b.recordTitle, 'fr'));
        },

        setView(mode) {
            this.viewMode = mode;
            if (mode === 'calendar') {
                this.$nextTick(() => this.initCalendar());
            }
        },

        showAllEvents() {
            this.setView('list');
        },

        setFilter(recordId) {
            this.filterRecordId = recordId;
            if (this.calendar) {
                this.calendar.removeAllEvents();
                this.calendar.addEventSource(this.toCalendarEvents(this.filteredEvents));
            }
        },

        clearFilter() {
            this.filterRecordId = null;
            if (this.calendar) {
                this.calendar.removeAllEvents();
                this.calendar.addEventSource(this.toCalendarEvents(this.filteredEvents));
            }
        },

        filterSearch() { /* reactive via getter */ },

        getParentId(ev) {
            let pid = null;
            (ev.relations || []).forEach(rel => {
                const ids = Array.isArray(rel.value) ? rel.value : [rel.value];
                if (ids[0]) pid = ids[0].toString();
            });
            return pid;
        },

        getRecordTitle(ev) {
            const pid = this.getParentId(ev);
            return this._parentLookup[pid]?.recordTitle || 'Agenda';
        },

        getRecordLink(ev) {
            const pid = this.getParentId(ev);
            const info = this._parentLookup[pid];
            if (!info) return '#';
            return '<%= _apiBase %>/record/' + info.entitySlug + '/' + info.recordId + '/agenda';
        },

        openRecord(ev) {
            const link = this.getRecordLink(ev);
            if (link !== '#') window.location.href = link;
        },

        showDetail(ev) {
            this.openEditEvent(ev);
        },

        toLocalDateTime(value) {
            const date = value ? new Date(value) : new Date();
            if (Number.isNaN(date.getTime())) return '';
            const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
            return local.toISOString().slice(0, 16);
        },

        dateKeyForInput(value) {
            const raw = String(value || '');
            const direct = raw.match(/^(\d{4}-\d{2}-\d{2})/);
            if (direct) return direct[1];
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return '';
            const pad = number => String(number).padStart(2, '0');
            return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
        },

        setAllDay(enabled) {
            this.eventForm.allDay = !!enabled;
            if (this.eventForm.allDay) {
                this.eventForm.startAt = this.dateKeyForInput(this.eventForm.startAt);
                this.eventForm.endAt = this.eventForm.endAt
                    ? this.dateKeyForInput(this.eventForm.endAt)
                    : '';
            } else {
                const startDate = this.dateKeyForInput(this.eventForm.startAt);
                const endDate = this.dateKeyForInput(this.eventForm.endAt);
                this.eventForm.startAt = startDate ? `${startDate}T09:00` : '';
                this.eventForm.endAt = endDate ? `${endDate}T09:30` : '';
            }
            this.$nextTick(() => {
                window.DxDatePicker?.refresh(this.$refs.eventStartInput);
                window.DxDatePicker?.refresh(this.$refs.eventEndInput);
            });
        },

        emptyEventForm(startValue = null) {
            const dateOnly = String(startValue || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
            const start = dateOnly
                ? new Date(Number(dateOnly[1]), Number(dateOnly[2]) - 1, Number(dateOnly[3]), 9, 0, 0, 0)
                : (startValue ? new Date(startValue) : new Date());
            if (Number.isNaN(start.getTime())) start.setTime(Date.now());
            start.setMinutes(Math.ceil(start.getMinutes() / 5) * 5, 0, 0);
            const end = new Date(start.getTime() + 30 * 60000);
            return {
                title: '',
                recordId: this.filterRecordId || '',
                startAt: this.toLocalDateTime(start),
                endAt: this.toLocalDateTime(end),
                type: 'autre',
                statusOptionId: '',
                recurrence: 'none',
                location: '',
                tags: '',
                notes: '',
                allDay: false,
                showInUpcoming: true,
                isImportant: false
            };
        },

        booleanFieldValue(value, fallback = false) {
            if (value === undefined || value === null || value === '') return fallback;
            if (typeof value === 'boolean') return value;
            if (typeof value === 'number') return value !== 0;
            return ['true', '1', 'yes', 'oui', 'on'].includes(String(value).toLowerCase());
        },

        eventStatusOptionId(ev) {
            const classificationId = this.entityData?.statusClassification?._id?.toString();
            if (!classificationId) return '';
            const value = (ev.classificationValues || []).find(item =>
                item.classificationId?.toString() === classificationId
            );
            return value?.optionId?.toString() || '';
        },

        eventTagsText(ev) {
            const value = this.getFieldValue(ev, 'tags_evenement');
            const tags = Array.isArray(value) ? value : (typeof value === 'string' ? value.split(',') : []);
            return tags.map(item => {
                if (item && typeof item === 'object') return item.label || item.value || item.name || '';
                return String(item || '');
            }).filter(Boolean).join(', ');
        },

        openCreateEvent(startValue = null) {
            this.eventMode = 'create';
            this.selectedEvent = {};
            this.eventError = '';
            this.eventForm = this.emptyEventForm(startValue);
            this.eventModalOpen = true;
            this.$nextTick(() => this.$refs.eventTitleInput?.focus());
        },

        openEditEvent(ev) {
            if (!ev) return;
            const allDay = this.booleanFieldValue(this.getFieldValue(ev, 'toute_la_journee'), false);
            this.eventMode = 'edit';
            this.selectedEvent = ev;
            this.eventError = '';
            this.eventForm = {
                title: ev.title || '',
                recordId: this.getParentId(ev) || '',
                startAt: allDay ? this.dateKeyForInput(ev.date) : this.toLocalDateTime(ev.date),
                endAt: ev.end_date
                    ? (allDay ? this.dateKeyForInput(ev.end_date) : this.toLocalDateTime(ev.end_date))
                    : '',
                type: this.getFieldValue(ev, 'type_evenement') || 'autre',
                statusOptionId: this.eventStatusOptionId(ev),
                recurrence: this.getFieldValue(ev, 'repetition_evenement') || 'none',
                location: this.getFieldValue(ev, 'lieu_evenement') || '',
                tags: this.eventTagsText(ev),
                notes: this.getFieldValue(ev, 'notes_evenement') || ev.description || '',
                allDay,
                showInUpcoming: this.booleanFieldValue(this.getFieldValue(ev, 'widget_prochains_evenements'), true),
                isImportant: this.booleanFieldValue(this.getFieldValue(ev, 'widget_date_importante'), false)
            };
            this.eventModalOpen = true;
            this.$nextTick(() => this.$refs.eventTitleInput?.focus());
        },

        closeEventModal() {
            if (this.eventSaving) return;
            this.eventModalOpen = false;
            this.selectedEvent = null;
            this.eventError = '';
        },

        eventPayload() {
            const title = String(this.eventForm.title || '').trim();
            if (!title) throw new Error('Le titre est requis.');
            const allDay = !!this.eventForm.allDay;
            const startKey = allDay ? this.dateKeyForInput(this.eventForm.startAt) : '';
            const endKey = allDay && this.eventForm.endAt ? this.dateKeyForInput(this.eventForm.endAt) : '';
            const start = allDay
                ? (startKey ? new Date(`${startKey}T12:00:00.000Z`) : new Date(NaN))
                : new Date(this.eventForm.startAt);
            const end = allDay
                ? (endKey ? new Date(`${endKey}T12:00:00.000Z`) : null)
                : (this.eventForm.endAt ? new Date(this.eventForm.endAt) : null);
            if (Number.isNaN(start.getTime())) throw new Error('La date est requise.');
            if (end && Number.isNaN(end.getTime())) throw new Error('La date de fin est invalide.');
            if (end && end.getTime() < start.getTime()) throw new Error('La fin doit être après le début.');
            const payload = {
                title,
                startAt: start.toISOString(),
                endAt: end ? end.toISOString() : null,
                allDay,
                type: this.eventForm.type || 'autre',
                recurrence: this.eventForm.recurrence || 'none',
                location: String(this.eventForm.location || '').trim(),
                tags: String(this.eventForm.tags || '').split(',').map(tag => tag.trim()).filter(Boolean),
                notes: String(this.eventForm.notes || '').trim(),
                showInUpcoming: !!this.eventForm.showInUpcoming,
                isImportant: !!this.eventForm.isImportant
            };
            if (allDay) payload.dateKey = startKey;
            if (this.eventMode === 'create' && this.eventForm.recordId) payload.recordId = this.eventForm.recordId;
            if (this.eventForm.statusOptionId) payload.statusOptionId = this.eventForm.statusOptionId;
            return payload;
        },

        refreshCalendarEvents() {
            if (!this.calendar) return;
            this.calendar.removeAllEvents();
            this.calendar.addEventSource(this.toCalendarEvents(this.filteredEvents));
        },

        async saveEvent() {
            if (this.eventSaving) return;
            let payload;
            try {
                payload = this.eventPayload();
            } catch (error) {
                this.eventError = error.message;
                return;
            }
            this.eventSaving = true;
            this.eventError = '';
            try {
                const editing = this.eventMode === 'edit';
                const eventId = this.selectedEvent?._id?.toString();
                const url = '<%= _apiBase %>/api/agenda-hub/events' + (editing ? '/' + eventId : '');
                const res = await fetch(url, {
                    method: editing ? 'PATCH' : 'POST',
                    headers: { 'Content-Type':'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(payload)
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.success) throw new Error(data.error || 'Enregistrement impossible.');
                await this.fetchData();
                this.refreshCalendarEvents();
                this.eventModalOpen = false;
                this.selectedEvent = null;
                if (window.showMessage) window.showMessage(editing ? 'Événement modifié' : 'Événement créé', 'success');
            } catch (error) {
                console.error('[AgendaHub] Save event error:', error);
                this.eventError = error.message || 'Enregistrement impossible.';
            } finally {
                this.eventSaving = false;
            }
        },

        async deleteEvent() {
            const eventId = this.selectedEvent?._id?.toString();
            if (!eventId || this.eventSaving || !window.confirm('Supprimer cet événement ?')) return;
            this.eventSaving = true;
            this.eventError = '';
            try {
                const res = await fetch('<%= _apiBase %>/api/agenda-hub/events/' + eventId, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.success) throw new Error(data.error || 'Suppression impossible.');
                await this.fetchData();
                this.refreshCalendarEvents();
                this.eventModalOpen = false;
                this.selectedEvent = null;
                if (window.showMessage) window.showMessage('Événement supprimé', 'success');
            } catch (error) {
                console.error('[AgendaHub] Delete event error:', error);
                this.eventError = error.message || 'Suppression impossible.';
            } finally {
                this.eventSaving = false;
            }
        },

        getFieldValue(ev, fieldName) {
            if (!this.entityData) return null;
            const field = (this.entityData.customFields || []).find(f => f.name === fieldName);
            if (!field) return null;
            const cf = (ev.customFields || []).find(c => {
                const fid = c.field_id?._id || c.field_id;
                return fid?.toString() === field._id?.toString();
            });
            return cf ? cf.value : null;
        },

        getType(ev) {
            const t = this.getFieldValue(ev, 'type_evenement');
            return t ? t.charAt(0).toUpperCase() + t.slice(1) : '—';
        },

        getStatus(ev) {
            if (!this.entityData?.statusClassification) return { label: 'Planifié', color: '#3b82f6' };
            const cls = this.entityData.statusClassification;
            const cv = (ev.classificationValues || []).find(c => c.classificationId?.toString() === cls._id?.toString());
            if (!cv) return { label: 'Planifié', color: '#3b82f6' };
            const opt = (cls.options || []).find(o => o._id?.toString() === cv.optionId?.toString());
            return opt ? { label: opt.label, color: opt.color || '#3b82f6' } : { label: 'Planifié', color: '#3b82f6' };
        },

        formatDate(d) {
            if (!d) return '—';
            return new Date(d).toLocaleDateString('fr-FR', { day:'2-digit', month:'short', year:'numeric' });
        },

        formatTime(d) {
            if (!d) return '';
            return new Date(d).toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit', hour12:false });
        },

        isAllDayEvent(ev) {
            return !!ev && this.booleanFieldValue(this.getFieldValue(ev, 'toute_la_journee'), false);
        },

        eventTimeLabel(ev) {
            return this.isAllDayEvent(ev) ? 'Toute la journée' : this.formatTime(ev?.date);
        },

        eventDay(d) {
            const date = new Date(d);
            return Number.isNaN(date.getTime()) ? '--' : String(date.getDate()).padStart(2, '0');
        },

        eventMonth(d) {
            const date = new Date(d);
            if (Number.isNaN(date.getTime())) return '';
            return date.toLocaleDateString('fr-FR', { month:'short' }).replace('.', '').toUpperCase();
        },

        relativeDayBadge(d) {
            const target = new Date(d);
            if (Number.isNaN(target.getTime())) return '';
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            target.setHours(0, 0, 0, 0);
            const days = Math.round((target.getTime() - today.getTime()) / 86400000);
            if (days === 0) return "Aujourd'hui";
            if (days === 1) return 'Demain';
            return `Dans ${days} jours`;
        },

        toCalendarEvents(evts) {
            return evts.map(ev => {
                const status = this.getStatus(ev);
                const duration = this.getFieldValue(ev, 'duree_evenement');
                let start = ev.date ? new Date(ev.date) : new Date();
                let end = ev.end_date ? new Date(ev.end_date) : null;
                if (!end && duration) { end = new Date(start.getTime() + (parseInt(duration) || 30) * 60000); }
                else if (!end) { end = new Date(start.getTime() + 30 * 60000); }

                return {
                    id: ev._id?.toString(),
                    title: ev.title || 'Sans titre',
                    start: start.toISOString(),
                    end: end.toISOString(),
                    backgroundColor: status.color,
                    borderColor: status.color,
                    textColor: '#fff',
                    allDay: this.booleanFieldValue(this.getFieldValue(ev, 'toute_la_journee'), false),
                    extendedProps: { _ev: ev }
                };
            });
        },

        syncCalendarToolbarButtons() {
            const el = this.$refs.calendarEl;
            if (!el) return;
            window.requestAnimationFrame(() => {
                const styles = window.getComputedStyle(el);
                const brand = styles.getPropertyValue('--focus-brand').trim() || '#634efb';
                const muted = styles.getPropertyValue('--focus-muted').trim() || '#9ca3af';
                el.querySelectorAll('.fc-button').forEach(button => {
                    const color = button.classList.contains('fc-button-active')
                        ? '#ffffff'
                        : (button.disabled ? muted : brand);
                    button.style.setProperty('color', color, 'important');
                    button.style.setProperty('-webkit-text-fill-color', color, 'important');
                });
            });
        },

        initCalendar() {
            if (this.calendar) { this.calendar.destroy(); this.calendar = null; }
            const el = this.$refs.calendarEl;
            if (!el || typeof FullCalendar === 'undefined') return;

            const self = this;

            this.calendar = new FullCalendar.Calendar(el, {
                initialView: 'dayGridMonth',
                locale: 'fr',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay',
                },
                buttonText: { today:"Aujourd'hui", month:'Mois', week:'Semaine', day:'Jour' },
                editable: true,
                selectable: true,
                dayMaxEvents: 3,
                nowIndicator: true,
                slotMinTime: '07:00:00',
                slotMaxTime: '21:00:00',
                slotDuration: '00:15:00',
                snapDuration: '00:05:00',
                allDaySlot: false,
                height: '100%',
                expandRows: true,
                eventTimeFormat: { hour:'2-digit', minute:'2-digit', meridiem:false, hour12:false },
                events: this.toCalendarEvents(this.filteredEvents),
                datesSet: () => self.syncCalendarToolbarButtons(),
                eventClick: (info) => {
                    const ev = info.event.extendedProps._ev;
                    self.showDetail(ev);
                },
                dateClick: (info) => {
                    self.openCreateEvent(info.dateStr);
                },
                eventDrop: async (info) => {
                    const ev = info.event.extendedProps._ev;
                    const newStart = info.event.start?.toISOString();
                    const newEnd = info.event.end?.toISOString();
                    try {
                        const res = await fetch(`<%= _apiBase %>/api/agenda-hub/events/${ev._id}`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ startAt: newStart, endAt: newEnd })
                        });
                        const data = await res.json();
                        if (!data.success) { info.revert(); return; }
                        // Update local data
                        const localEv = self.allEvents.find(e => e._id === ev._id);
                        if (localEv) {
                            localEv.date = newStart;
                            if (newEnd) localEv.end_date = newEnd;
                        }
                    } catch (err) {
                        console.error('[AgendaHub] Drag error:', err);
                        info.revert();
                    }
                },
                eventResize: async (info) => {
                    const ev = info.event.extendedProps._ev;
                    const newStart = info.event.start?.toISOString();
                    const newEnd = info.event.end?.toISOString();
                    try {
                        const res = await fetch(`<%= _apiBase %>/api/agenda-hub/events/${ev._id}`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ startAt: newStart, endAt: newEnd })
                        });
                        const data = await res.json();
                        if (!data.success) { info.revert(); return; }
                        const localEv = self.allEvents.find(e => e._id === ev._id);
                        if (localEv) {
                            localEv.date = newStart;
                            if (newEnd) localEv.end_date = newEnd;
                        }
                    } catch (err) {
                        console.error('[AgendaHub] Resize error:', err);
                        info.revert();
                    }
                },
                eventDidMount: (info) => {
                    const ev = info.event.extendedProps._ev;
                    info.el.title = info.event.title + '\n📋 ' + self.getRecordTitle(ev);
                }
            });
            this.calendar.render();
            this.syncCalendarToolbarButtons();
        }
    }));
});
</script>
