<!-- Entity Form Builder -->
<div x-data="formBuilder()" class="flex flex-col" style="height: calc(100vh - 80px);">

  <!-- Header Bar -->
  <div class="bg-white dark:bg-gray-900 border-b dark:border-0 shadow-sm">
    <div class="h-12 flex items-center justify-between px-4">
      <div class="flex items-center gap-3">
        <a href="/account/<%= account_number %>/entity/list" class="w-8 h-8 rounded-md flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors" title="Retour">
          <iconify-icon icon="solar:arrow-left-line-duotone" width="20"></iconify-icon>
        </a>
        <div class="flex items-center gap-2">
          <iconify-icon :icon="entityMeta.icon || 'solar:box-bold-duotone'" width="20" :style="entityMeta.color ? 'color:' + entityMeta.color : ''"></iconify-icon>
          <h1 class="font-bold text-base" x-text="entityMeta.name"></h1>
          <span class="text-xs text-gray-400">— Form Builder</span>
        </div>
        <!-- Preview Toggle -->
        <div class="flex items-center ml-4 bg-gray-100 dark:bg-gray-700 rounded-lg p-0.5">
          <button @click="isPreview = false" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all"
                  :class="!isPreview ? 'bg-white dark:bg-gray-600 shadow-sm text-primary' : 'text-gray-500 hover:text-gray-700'">
            <iconify-icon icon="solar:pen-new-square-bold-duotone" width="14"></iconify-icon>
            Éditer
          </button>
          <button @click="isPreview = true" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all"
                  :class="isPreview ? 'bg-white dark:bg-gray-600 shadow-sm text-primary' : 'text-gray-500 hover:text-gray-700'">
            <iconify-icon icon="solar:eye-bold-duotone" width="14"></iconify-icon>
            Aperçu
          </button>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <!-- Status badge -->
        <span x-show="formLayoutStatus === 'published'" class="text-[10px] font-bold uppercase tracking-wide text-success bg-success/10 px-2 py-0.5 rounded">Published</span>
        <span x-show="formLayoutStatus === 'draft'" class="text-[10px] font-bold uppercase tracking-wide text-gray-400 bg-gray-100 px-2 py-0.5 rounded">Draft</span>
        <!-- Unsaved indicator -->
        <span x-show="isDirty" class="text-xs text-amber-500 flex items-center gap-1">
          <iconify-icon icon="solar:danger-circle-bold" width="14"></iconify-icon>
          Non sauvegardé
        </span>
        <button @click="saveFormLayout()" class="btn btn-primary btn-sm" :disabled="isSaving">
          <iconify-icon icon="solar:diskette-bold" class="mr-1"></iconify-icon>
          <span x-text="isSaving ? 'Sauvegarde...' : 'Sauvegarder'"></span>
        </button>
        <button @click="publishFormLayout()" class="btn btn-success btn-sm" :disabled="isPublishing">
          <iconify-icon icon="solar:check-circle-bold" class="mr-1"></iconify-icon>
          <span x-text="isPublishing ? 'Publication...' : 'Publier'"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main Builder Area -->
  <div class="flex flex-1 overflow-hidden">
    <template x-if="!isPreview">
      <div class="flex flex-1 overflow-hidden">
        <%- include('components/form-builder-sidebar') %>
        <%- include('components/form-builder-canvas') %>
      </div>
    </template>
    <template x-if="isPreview">
      <%- include('components/form-builder-preview') %>
    </template>
  </div>
</div>

<!-- Data Injection -->
<script type="application/json" id="form-builder-data">
<%- JSON.stringify({
  accountNumber: account_number,
  entityId: entity._id,
  entityMeta: {
    name: entity.name,
    slug: entity.slug,
    description: entity.description || '',
    icon: entity.icon || '',
    color: entity.color || ''
  },
  formLayout: formLayout,
  formLayoutStatus: formLayoutStatus,
  standardFieldDefs: {
    title: { key: 'title', label: 'Titre', icon: 'solar:text-bold', inputType: 'text' },
    description: { key: 'description', label: 'Description', icon: 'solar:document-text-bold-duotone', inputType: 'textarea' },
    slug: { key: 'slug', label: 'Slug', icon: 'solar:link-bold', inputType: 'text' },
    date: { key: 'date', label: 'Date', icon: 'solar:calendar-bold-duotone', inputType: 'date' },
    icon: { key: 'icon', label: 'Icône', icon: 'solar:star-bold-duotone', inputType: 'text' },
    image: { key: 'image', label: 'Image', icon: 'solar:gallery-bold-duotone', inputType: 'file' },
    attachments: { key: 'attachments', label: 'Pièces jointes', icon: 'solar:paperclip-bold', inputType: 'file' }
  },
  enabledStandardFields: entity.enabledStandardFields || [],
  customFields: (fields || []).map(f => ({
    _id: f._id.toString(),
    name: f.name,
    label: f.label,
    type: f.type,
    htmlTemplate: f.htmlTemplate || '',
    ui: f.ui || {}
  })),
  relations: (entity.relations || []).map(r => ({
    key: r.key,
    label: r.label,
    inverseLabel: r.inverseLabel,
    cardinality: r.cardinality,
    inputMode: r.inputMode,
    targetEntity: r.targetEntity ? {
      _id: (r.targetEntity._id || r.targetEntity).toString(),
      name: r.targetEntity.name || '',
      icon: r.targetEntity.icon || '',
      color: r.targetEntity.color || ''
    } : null
  })),
  classifications: (allClassifications || []).map(c => ({
    _id: c._id.toString(),
    name: c.name
  })),
  entityClassificationIds: (entity.classifications || []).map(id => id.toString()),
  statusClassificationId: entity.statusClassification ? entity.statusClassification.toString() : ''
}).replace(/</g, '\\u003C') %>
</script>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('formBuilder', () => {
    const data = JSON.parse(document.getElementById('form-builder-data').textContent);
    
    // Normalize formLayout
    let formLayout = data.formLayout;
    if (!formLayout || !formLayout.version) {
      // Migration from old flat array or empty
      formLayout = { version: 1, rows: [] };
      if (Array.isArray(data.formLayout) && data.formLayout.length > 0) {
        // Legacy flat layout: migrate
        if (data.formLayout[0] && data.formLayout[0].columns) {
          formLayout.rows = data.formLayout;
        } else {
          // Old flat format: [ {fieldId, width, id} ] -> single row
          const row = { id: 'row_migrated', columns: [{ width: 12, fields: [] }] };
          data.formLayout.forEach(item => {
            row.columns[0].fields.push({
              id: item.id || 'f_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
              type: 'custom',
              fieldId: item.fieldId,
              label: '',
              required: false,
              placeholder: '',
              helpText: ''
            });
          });
          formLayout.rows = [row];
        }
      }
    }

    const genId = () => 'f_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7);

    return {
      // State
      accountNumber: data.accountNumber,
      entityId: data.entityId,
      entityMeta: data.entityMeta,
      formLayout: formLayout,
      standardFieldDefs: data.standardFieldDefs,
      enabledStandardFields: data.enabledStandardFields,
      availableCustomFields: data.customFields,
      entityRelations: data.relations,
      entityClassifications: data.classifications.filter(c => 
        data.entityClassificationIds.includes(c._id) || data.statusClassificationId === c._id
      ),
      selectedFieldId: null,
      isDirty: false,
      isSaving: false,
      isPreview: false,
      isPublishing: false,
      formLayoutStatus: data.formLayoutStatus || 'draft',

      // Builder State (unified with form-builder-sidebar)
      builderState: {
        mode: 'edit',
        selectedFieldId: null,
        hoveredRowId: null,
        drawerMode: 'fields',
        sidebarOpen: true,
        activeTab: 'default'
      },

      init() {
        this.$watch('formLayout', () => { this.isDirty = true; }, { deep: true });
        this.$nextTick(() => this.initSortables());
      },

      // ========== SIDEBAR HELPERS ==========

      getAvailableStandardFields() {
        return this.enabledStandardFields
          .map(key => this.standardFieldDefs[key])
          .filter(Boolean);
      },

      isFieldOnCanvas(type, fieldId) {
        // Standard & relation are unique, custom can be multiple (for now enforce unique)
        for (const row of this.formLayout.rows) {
          for (const col of row.columns) {
            for (const field of col.fields) {
              if (field.type === type && field.fieldId === String(fieldId)) {
                return true;
              }
            }
          }
        }
        return false;
      },

      onSidebarDragStart(event, type, fieldId, label, icon) {
        if (this.isFieldOnCanvas(type, fieldId)) {
          event.preventDefault();
          return;
        }
        event.dataTransfer.setData('application/json', JSON.stringify({
          type, fieldId: String(fieldId), label, icon
        }));
        event.dataTransfer.effectAllowed = 'copy';
      },

      // ========== CANVAS DROP ==========

      handleCanvasDrop(event, rowIndex, colIndex) {
        let fieldData;
        try {
          fieldData = JSON.parse(event.dataTransfer.getData('application/json'));
        } catch (e) { return; }

        if (!fieldData || !fieldData.type || !fieldData.fieldId) return;
        if (this.isFieldOnCanvas(fieldData.type, fieldData.fieldId)) return;

        const newField = {
          id: genId(),
          type: fieldData.type,
          fieldId: fieldData.fieldId,
          label: '',
          required: false,
          placeholder: '',
          helpText: ''
        };

        // If no rows, create one
        if (this.formLayout.rows.length === 0) {
          this.addRow(1);
          rowIndex = 0;
          colIndex = 0;
        }

        const row = this.formLayout.rows[rowIndex];
        if (row && row.columns[colIndex]) {
          row.columns[colIndex].fields.push(newField);
          this.isDirty = true;
          this.$nextTick(() => this.initSortables());
        }
      },

      // ========== ROW MANAGEMENT ==========

      addRow(numCols, afterIndex) {
        const width = Math.floor(12 / numCols);
        const remainder = 12 - (width * numCols);
        const columns = [];
        for (let i = 0; i < numCols; i++) {
          columns.push({
            width: width + (i === 0 ? remainder : 0),
            fields: []
          });
        }
        const row = { id: 'row_' + Date.now(), columns };
        
        if (typeof afterIndex === 'number') {
          this.formLayout.rows.splice(afterIndex + 1, 0, row);
        } else {
          this.formLayout.rows.push(row);
        }
        this.isDirty = true;
      },

      addRowCustom(widths) {
        const columns = widths.map(w => ({ width: w, fields: [] }));
        const row = { id: 'row_' + Date.now(), columns };
        this.formLayout.rows.push(row);
        this.isDirty = true;
      },

      deleteRow(rowIndex) {
        this.formLayout.rows.splice(rowIndex, 1);
        this.isDirty = true;
      },

      moveRow(rowIndex, direction) {
        const newIndex = rowIndex + direction;
        if (newIndex < 0 || newIndex >= this.formLayout.rows.length) return;
        const rows = this.formLayout.rows;
        const temp = rows[rowIndex];
        rows[rowIndex] = rows[newIndex];
        rows[newIndex] = temp;
        // Force reactivity
        this.formLayout.rows = [...rows];
        this.isDirty = true;
      },

      duplicateRow(rowIndex) {
        const row = JSON.parse(JSON.stringify(this.formLayout.rows[rowIndex]));
        row.id = 'row_' + Date.now();
        // Generate new field IDs to avoid duplicates
        row.columns.forEach(col => {
          col.fields.forEach(f => { f.id = genId(); });
        });
        this.formLayout.rows.splice(rowIndex + 1, 0, row);
        this.isDirty = true;
      },

      // ========== FIELD MANAGEMENT ==========

      selectField(fieldId) {
        this.selectedFieldId = this.selectedFieldId === fieldId ? null : fieldId;
      },

      removeField(rowIndex, colIndex, fieldIndex) {
        this.formLayout.rows[rowIndex].columns[colIndex].fields.splice(fieldIndex, 1);
        this.isDirty = true;
      },

      moveFieldUp(rowIndex, colIndex, fieldIndex) {
        if (fieldIndex === 0) return;
        const fields = this.formLayout.rows[rowIndex].columns[colIndex].fields;
        const temp = fields[fieldIndex];
        fields[fieldIndex] = fields[fieldIndex - 1];
        fields[fieldIndex - 1] = temp;
        this.formLayout.rows[rowIndex].columns[colIndex].fields = [...fields];
      },

      moveFieldDown(rowIndex, colIndex, fieldIndex) {
        const fields = this.formLayout.rows[rowIndex].columns[colIndex].fields;
        if (fieldIndex >= fields.length - 1) return;
        const temp = fields[fieldIndex];
        fields[fieldIndex] = fields[fieldIndex + 1];
        fields[fieldIndex + 1] = temp;
        this.formLayout.rows[rowIndex].columns[colIndex].fields = [...fields];
      },

      // ========== AUTO LAYOUT ==========

      autoLayout(numCols) {
        // Collect all fields currently on canvas
        const allFields = [];
        this.formLayout.rows.forEach(row => {
          row.columns.forEach(col => {
            col.fields.forEach(f => allFields.push({ ...f }));
          });
        });

        // Add un-placed standard fields
        this.enabledStandardFields.forEach(key => {
          if (!allFields.find(f => f.type === 'standard' && f.fieldId === key)) {
            allFields.push({ id: genId(), type: 'standard', fieldId: key, label: '', required: false, placeholder: '', helpText: '' });
          }
        });
        // Add un-placed custom fields
        this.availableCustomFields.forEach(cf => {
          if (!allFields.find(f => f.type === 'custom' && f.fieldId === cf._id)) {
            allFields.push({ id: genId(), type: 'custom', fieldId: cf._id, label: '', required: false, placeholder: '', helpText: '' });
          }
        });
        // Add un-placed relations
        this.entityRelations.forEach(rel => {
          if (!allFields.find(f => f.type === 'relation' && f.fieldId === rel.key)) {
            allFields.push({ id: genId(), type: 'relation', fieldId: rel.key, label: '', required: false, placeholder: '', helpText: '' });
          }
        });

        // Build rows
        const rows = [];
        const colWidth = Math.floor(12 / numCols);
        const remainder = 12 - (colWidth * numCols);

        for (let i = 0; i < allFields.length; i += numCols) {
          const columns = [];
          for (let c = 0; c < numCols; c++) {
            const field = allFields[i + c];
            columns.push({
              width: colWidth + (c === 0 ? remainder : 0),
              fields: field ? [field] : []
            });
          }
          rows.push({ id: 'row_' + Date.now() + '_' + i, columns });
        }

        this.formLayout.rows = rows;
        this.isDirty = true;
        this.$nextTick(() => this.initSortables());
      },

      // ========== FIELD PREVIEW RENDERING ==========

      renderFieldPreview(field) {
        const type = field.type;
        const fieldId = field.fieldId;

        if (type === 'standard') {
          const def = this.standardFieldDefs[fieldId];
          if (!def) return this.renderMissingField(fieldId, 'standard');
          const label = field.label || def.label;
          const icon = def.icon;
          if (def.inputType === 'textarea') {
            return `<div>
              <label class="flex items-center gap-1"><iconify-icon icon="${icon}" width="12" class="text-warning"></iconify-icon>${label}</label>
              <textarea class="form-input" disabled placeholder="${field.placeholder || label}"></textarea>
            </div>`;
          }
          if (def.inputType === 'file') {
            return `<div>
              <label class="flex items-center gap-1"><iconify-icon icon="${icon}" width="12" class="text-warning"></iconify-icon>${label}</label>
              <div class="h-[38px] flex items-center px-3 bg-gray-50 border border-gray-100 rounded-lg text-xs text-gray-400">
                <iconify-icon icon="solar:upload-bold" width="14" class="mr-2"></iconify-icon>Choisir un fichier
              </div>
            </div>`;
          }
          return `<div>
            <label class="flex items-center gap-1"><iconify-icon icon="${icon}" width="12" class="text-warning"></iconify-icon>${label}</label>
            <input type="${def.inputType || 'text'}" class="form-input" disabled placeholder="${field.placeholder || label}" />
          </div>`;
        }

        if (type === 'custom') {
          const cf = this.availableCustomFields.find(f => f._id === fieldId);
          if (!cf) return this.renderMissingField(fieldId, 'custom');
          const label = field.label || cf.label || cf.name;
          const icon = cf.ui?.icon || 'solar:widget-bold-duotone';
          // Use htmlTemplate if available
          if (cf.htmlTemplate) {
            const rendered = cf.htmlTemplate
              .replace(/\{\{\s*label\s*\}\}/g, label)
              .replace(/\{\{\s*name\s*\}\}/g, cf.name || '')
              .replace(/\{\{\s*placeholder\s*\}\}/g, field.placeholder || label)
              .replace(/\{\{\s*required\s*\}\}/g, field.required ? 'required' : '');
            return rendered;
          }
          return `<div>
            <label class="flex items-center gap-1"><iconify-icon icon="${icon}" width="12" class="text-info"></iconify-icon>${label}</label>
            <input type="text" class="form-input" disabled placeholder="${field.placeholder || label}" />
          </div>`;
        }

        if (type === 'relation') {
          const rel = this.entityRelations.find(r => r.key === fieldId);
          if (!rel) return this.renderMissingField(fieldId, 'relation');
          const label = field.label || rel.label || 'Relation';
          const icon = rel.targetEntity?.icon || 'solar:link-round-bold-duotone';
          const color = rel.targetEntity?.color || '#4361ee';
          const cardinality = rel.cardinality === 'one-to-one' ? '1:1' : rel.cardinality === 'one-to-many' ? '1:N' : 'N:N';
          const inputIcon = rel.inputMode === 'select' ? 'solar:alt-arrow-down-bold' : 'solar:magnifer-bold';
          return `<div>
            <label class="flex items-center gap-1.5">
              <iconify-icon icon="${icon}" width="12" style="color:${color}"></iconify-icon>
              ${label}
              <span class="ml-auto text-[9px] font-normal text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded">${cardinality}</span>
            </label>
            <div class="h-[38px] flex items-center px-3 bg-gray-50 border border-gray-100 rounded-lg text-xs text-gray-400" style="border-color:${color}20">
              <iconify-icon icon="${inputIcon}" width="14" class="mr-2" style="color:${color}"></iconify-icon>
              Rechercher ${rel.targetEntity?.name || ''}...
            </div>
          </div>`;
        }

        if (type === 'classification') {
          const cls = this.entityClassifications.find(c => c._id === fieldId);
          if (!cls) return this.renderMissingField(fieldId, 'classification');
          const label = field.label || cls.name;
          return `<div>
            <label class="flex items-center gap-1"><iconify-icon icon="solar:tag-bold-duotone" width="12" class="text-success"></iconify-icon>${label}</label>
            <div class="h-[38px] flex items-center px-3 bg-gray-50 border border-gray-100 rounded-lg text-xs text-gray-400">
              <iconify-icon icon="solar:alt-arrow-down-bold" width="14" class="mr-2"></iconify-icon>
              Sélectionner...
            </div>
          </div>`;
        }

        return this.renderMissingField(fieldId, type);
      },

      renderMissingField(fieldId, type) {
        return `<div class="flex items-center gap-2 p-2 bg-red-50 border border-red-200 rounded-lg text-xs text-red-500">
          <iconify-icon icon="solar:danger-triangle-bold" width="16"></iconify-icon>
          <span>Champ introuvable (${type}: ${fieldId})</span>
        </div>`;
      },

      // ========== PREVIEW FIELD RENDERING ==========

      renderPreviewField(field) {
        const { type, fieldId } = field;

        // Standard fields
        if (type === 'standard') {
          const def = this.standardFieldDefs[fieldId];
          if (!def) return '';
          const label = def.label;
          const req = field.required ? '<span class="text-danger ml-0.5">*</span>' : '';

          if (fieldId === 'title') {
            return `<div>
              <label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label>
              <input type="text" class="form-input w-full" placeholder="Entrez le titre" />
            </div>`;
          }
          if (fieldId === 'description') {
            return `<div>
              <label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label>
              <textarea class="form-textarea w-full" rows="3" placeholder="Entrez la description"></textarea>
            </div>`;
          }
          if (def.inputType === 'date') {
            return `<div>
              <label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label>
              <input type="date" class="form-input w-full" />
            </div>`;
          }
          if (def.inputType === 'checkbox') {
            return `<div class="flex items-center gap-2 py-2">
              <input type="checkbox" class="form-checkbox" />
              <label class="text-xs font-semibold text-gray-600">${label}</label>
            </div>`;
          }
          return `<div>
            <label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label>
            <input type="${def.inputType || 'text'}" class="form-input w-full" placeholder="${label}" />
          </div>`;
        }

        // Custom fields
        if (type === 'custom') {
          const cf = this.availableCustomFields.find(f => f._id === fieldId);
          if (!cf) return this.renderMissingField(fieldId, 'custom');
          const label = field.label || cf.label || cf.name;
          const req = field.required ? '<span class="text-danger ml-0.5">*</span>' : '';
          const inputType = cf.inputType || cf.type || 'text';

          if (inputType === 'textarea' || inputType === 'richtext') {
            return `<div>
              <label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label>
              <textarea class="form-textarea w-full" rows="3" placeholder="${label}"></textarea>
            </div>`;
          }
          if (inputType === 'select' && cf.options?.length) {
            const opts = cf.options.map(o => `<option>${o.label || o}</option>`).join('');
            return `<div>
              <label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label>
              <select class="form-select w-full"><option value="">-- Choisir --</option>${opts}</select>
            </div>`;
          }
          if (inputType === 'checkbox') {
            return `<div class="flex items-center gap-2 py-2">
              <input type="checkbox" class="form-checkbox" />
              <label class="text-xs font-semibold text-gray-600">${label}</label>
            </div>`;
          }
          if (inputType === 'number') {
            return `<div>
              <label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label>
              <input type="number" class="form-input w-full" placeholder="0" />
            </div>`;
          }
          if (inputType === 'date') {
            return `<div>
              <label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label>
              <input type="date" class="form-input w-full" />
            </div>`;
          }
          return `<div>
            <label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label>
            <input type="text" class="form-input w-full" placeholder="${label}" />
          </div>`;
        }

        // Relation fields
        if (type === 'relation') {
          const rel = this.entityRelations.find(r => r.key === fieldId);
          if (!rel) return this.renderMissingField(fieldId, 'relation');
          const label = field.label || rel.label || 'Relation';
          const color = rel.targetEntity?.color || '#4361ee';
          const icon = rel.targetEntity?.icon || 'solar:link-round-bold-duotone';
          const cardinality = rel.cardinality === 'one-to-one' ? '1:1' : rel.cardinality === 'one-to-many' ? '1:N' : 'N:N';
          return `<div>
            <label class="text-xs font-semibold text-gray-600 mb-1 flex items-center gap-1.5">
              <iconify-icon icon="${icon}" width="14" style="color:${color}"></iconify-icon>
              ${label}
              <span class="text-[9px] font-normal text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded ml-auto">${cardinality}</span>
            </label>
            <div class="form-input w-full flex items-center gap-2 text-gray-400 text-sm cursor-pointer hover:border-primary/40 transition-colors" style="border-color:${color}30">
              <iconify-icon icon="solar:magnifer-bold" width="14" style="color:${color}"></iconify-icon>
              Rechercher ${rel.targetEntity?.name || ''}...
            </div>
          </div>`;
        }

        // Classification fields
        if (type === 'classification') {
          const cls = this.entityClassifications.find(c => c._id === fieldId);
          if (!cls) return this.renderMissingField(fieldId, 'classification');
          const label = field.label || cls.name;
          return `<div>
            <label class="text-xs font-semibold text-gray-600 mb-1 flex items-center gap-1.5">
              <iconify-icon icon="solar:tag-bold-duotone" width="14" class="text-success"></iconify-icon>
              ${label}
            </label>
            <select class="form-select w-full">
              <option value="">-- Sélectionner --</option>
              ${(cls.options || []).map(o => `<option>${o.label}</option>`).join('')}
            </select>
          </div>`;
        }

        return this.renderMissingField(fieldId, type);
      },

      // ========== SORTABLE ==========

      initSortables() {
        // Init SortableJS on each column for reordering within canvas
        document.querySelectorAll('[id^="col-"]').forEach(el => {
          if (el._sortable) el._sortable.destroy();
          el._sortable = new Sortable(el, {
            group: { name: 'form-fields', pull: true, put: true },
            animation: 150,
            ghostClass: 'fb-sortable-ghost',
            dragClass: 'fb-sortable-drag',
            handle: '.fb-field-item',
            draggable: '.fb-field-item',
            onEnd: (evt) => {
              // Sync DOM order back to data
              const fromRowIndex = parseInt(evt.from.dataset.rowIndex);
              const fromColIndex = parseInt(evt.from.dataset.colIndex);
              const toRowIndex = parseInt(evt.to.dataset.rowIndex);
              const toColIndex = parseInt(evt.to.dataset.colIndex);

              if (isNaN(fromRowIndex) || isNaN(fromColIndex) || isNaN(toRowIndex) || isNaN(toColIndex)) return;

              // Get the moved field
              const field = this.formLayout.rows[fromRowIndex]?.columns[fromColIndex]?.fields[evt.oldIndex];
              if (!field) return;

              // Remove from source
              this.formLayout.rows[fromRowIndex].columns[fromColIndex].fields.splice(evt.oldIndex, 1);
              // Insert at target
              this.formLayout.rows[toRowIndex].columns[toColIndex].fields.splice(evt.newIndex, 0, field);

              this.isDirty = true;
            }
          });
        });
      },

      // ========== SAVE ==========

      async saveFormLayout() {
        this.isSaving = true;
        try {
          const res = await fetch(`/account/${this.accountNumber}/entity/api/update/${this.entityId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              formLayout: this.formLayout
            })
          });
          
          if (res.ok) {
            this.isDirty = false;
            Swal.fire({
              icon: 'success',
              title: 'Layout sauvegardé',
              showConfirmButton: false,
              timer: 1000,
              toast: true,
              position: 'top-end'
            });
          } else {
            throw new Error('Save failed');
          }
        } catch (e) {
          Swal.fire({ icon: 'error', title: 'Erreur', text: e.message });
        } finally {
          this.isSaving = false;
        }
      },

      // ========== PUBLISH ==========

      async publishFormLayout() {
        // Save first, then publish
        await this.saveFormLayout();
        
        if (this.isDirty) {
          // Save failed
          return;
        }

        this.isPublishing = true;
        try {
          const res = await fetch(`/account/${this.accountNumber}/entity/api/publish-form/${this.entityId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              formLayout: this.formLayout
            })
          });
          
          if (res.ok) {
            this.formLayoutStatus = 'published';
            Swal.fire({
              icon: 'success',
              title: 'Formulaire publié !',
              text: 'Le layout est maintenant actif pour la création de records.',
              showConfirmButton: false,
              timer: 1500,
              toast: true,
              position: 'top-end'
            });

            // Redirect to record add page after short delay
            setTimeout(() => {
              window.location.href = `/account/${this.accountNumber}/record/${this.entityMeta.slug}/add`;
            }, 1000);
          } else {
            throw new Error('Publish failed');
          }
        } catch (e) {
          Swal.fire({ icon: 'error', title: 'Erreur de publication', text: e.message });
        } finally {
          this.isPublishing = false;
        }
      }
    };
  });
});
</script>