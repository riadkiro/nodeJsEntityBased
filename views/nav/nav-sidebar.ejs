        <template x-teleport="body">
        <div x-show="$store.sidebar.showEditMenu" x-transition @mousedown.stop @click.stop @contextmenu.prevent.stop
          @keydown.escape.window="closeSidebarPopovers()"
          style="min-width: 248px; left: 248px; top: 56px; border-left:0px; z-index:9999;"
          class="hierarchy-popover bg-white dark:bg-[#0e1726] p-4 fixed w-60 z-[9999] rounded-md shadow border border-gray-200 dark:border-white/10 text-gray-700 dark:text-gray-300">
