<!-- Calendar Widget Demo Page -->
<link href="/assets/css/fullcalendar.min.css" rel="stylesheet" />
<script src="/assets/js/fullcalendar.min.js"></script>

<div class="animate__animated p-6" :class="[$store.app.animation]">
  <!-- Breadcrumb -->
  <ul class="flex space-x-2 rtl:space-x-reverse mb-6">
    <li>
      <a href="javascript:;" class="text-primary hover:underline">Components</a>
    </li>
    <li class="before:content-['/'] ltr:before:mr-1 rtl:before:ml-1">
      <span>Calendar Widget</span>
    </li>
  </ul>

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-2xl font-bold dark:text-white-light mb-2">Calendar Widget</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400">
      Composant calendrier interactif — React Island avec FullCalendar.js, gestion d'événements, vues mois/semaine/jour
    </p>
  </div>

  <!-- React Island Mount Point -->
  <div 
    data-island="calendar-widget"
    data-account-number="<%= account_number %>"
    data-api-url="/account/<%= account_number %>/api/demo/calendar-events"
    data-editable="true"
  ></div>

</div>

<!-- React Island Script -->
<script src="/dist/calendarWidget.js" type="module" defer></script>
