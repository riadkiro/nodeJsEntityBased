                            :style="'background-color: ' + color + '; border-color: ' + (editingColor === color ? 'black' : 'transparent')"
                            @click="editingColor = color">
                            <iconify-icon icon="solar:check-circle-bold" class="text-white" width="14"
                              x-show="editingColor === color"></iconify-icon>
                          </div>
                        </template>

                        <!-- Custom Picker -->
                        <div
                          class="relative w-6 h-6 rounded-full cursor-pointer border border-gray-300 flex items-center justify-center overflow-hidden hover:border-gray-400"
                          :style="editingColor && !availableColors.includes(editingColor) ? 'background-color: ' + editingColor + '; border-color: ' + editingColor : ''">
                          <iconify-icon icon="solar:pen-new-square-linear" width="14" class="pointer-events-none"
                            :class="editingColor && !availableColors.includes(editingColor) ? 'text-white mix-blend-difference' : 'text-gray-500'"></iconify-icon>
                          <input type="color"
                            class="absolute inset-0 opacity-0 cursor-pointer w-full h-full p-0 border-0"
                            x-model="editingColor" title="Couleur personnalisée" />
                        </div>
                        <span x-show="editingColor && !availableColors.includes(editingColor)" x-text="editingColor"
                          class="text-[10px] self-center font-mono text-gray-500 uppercase"></span>

                        <div
                          class="w-6 h-6 rounded-full cursor-pointer flex items-center justify-center border hover:border-gray-400 bg-transparent text-gray-400"
                          title="Réinitialiser" @click="editingColor = ''" :class="!editingColor && 'border-black'">
                          <iconify-icon icon="solar:close-circle-linear" width="16"></iconify-icon>
                        </div>
                      </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-full" :disabled="isSubmitting">
                      <span x-show="isSubmitting"
                        class="animate-spin border-2 border-white border-l-transparent rounded-full w-5 h-5 ltr:mr-2 rtl:ml-2 inline-block align-middle"></span>
                      Enregistrer
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
          </template>

          <!-- Creation Modal -->
          <template x-teleport="body">
          <div class="fixed inset-0 bg-[black]/60 z-[999] hidden overflow-y-auto" :class="showCreateModal && '!block'">
            <div class="flex items-start justify-center min-h-screen px-4" @click.self="showCreateModal = false">
              <div x-show="showCreateModal" x-transition x-transition.duration.300
                class="panel border-0 py-1 px-4 rounded-lg overflow-hidden w-full max-w-sm my-8 bg-white dark:bg-[#1b2e4b]">
                <div class="flex items-center justify-between p-5 font-semibold text-lg dark:text-white">
                  <span x-text="'Nouveau ' + (creationType === 'entity' ? 'Collection' : creationType)"></span>
                  <button type="button" @click="showCreateModal = false" class="text-white-dark hover:text-dark">
                    <iconify-icon icon="solar:close-circle-bold" width="24" height="24"></iconify-icon>
                  </button>
                </div>
                <div class="p-5">
                  <form @submit.prevent="submitCreateItem">
                    <div class="relative mb-4">
                      <label class="mb-2 block text-sm font-bold">Nom</label>
                      <input type="text" x-model="creationName" x-ref="createInput" placeholder="Entrez le nom..."
                        class="form-input w-full" />
                    </div>
                    <div class="relative mb-4">
                      <label class="mb-2 block text-sm font-bold">Icône</label>

                      <!-- Reuse Picker Logic -->
                      <div class="relative mb-2 flex gap-2">
                        <select x-model="selectedLibrary"
                          class="form-select w-1/3 text-xs py-1.5 border-gray-300 dark:border-gray-600 focus:border-primary">
                          <template x-for="lib in libraries" :key="lib.id">
                            <option :value="lib.id" x-text="lib.name"></option>
                          </template>
                        </select>
                        <div class="relative w-2/3">
                          <input type="text" x-model="iconSearch" placeholder="Rechercher..."
                            class="form-input w-full text-xs pl-8 py-1.5 border-gray-300 dark:border-gray-600" />
                          <iconify-icon icon="solar:magnifer-linear" class="absolute left-2.5 top-2 text-gray-400"
                            width="14"></iconify-icon>
                        </div>
                      </div>

                      <div
                        class="flex gap-2 flex-wrap mb-2 max-h-40 overflow-y-auto custom-scrollbar p-1 border rounded"
                        @scroll.debounce="if($el.scrollTop + $el.clientHeight >= $el.scrollHeight - 20) loadMoreIcons()">
                        <template x-for="icon in icons" :key="icon">
                          <div class="p-2 rounded cursor-pointer border hover:border-primary transition-colors"
                            :class="creationIcon === icon ? 'bg-primary/10 border-primary text-primary' : 'border-transparent bg-gray-50 dark:bg-gray-700'"
                            @click="creationIcon = icon">
                            <iconify-icon :icon="icon" width="20" height="20"></iconify-icon>
                          </div>
                        </template>

                        <template x-if="isLoadingIcons">
                          <div class="w-full text-center py-2">
                            <span
                              class="animate-spin border-dark border-l-transparent rounded-full w-4 h-4 inline-block"></span>
                          </div>
                        </template>

                        <div class="w-full text-center pt-2 pb-1" x-show="hasMore && !isLoadingIcons">
                          <button type="button" @click="loadMoreIcons()" class="text-xs text-primary hover:underline">
                            Charger plus...
                          </button>
                        </div>
                      </div>
                      <input type="text" x-model="creationIcon" class="form-input w-full text-xs"
                        placeholder="ou tapez un nom d'icône..." />

                      <!-- Color Picker Creation -->
                      <div class="mt-4">
                        <label class="mb-2 block text-sm font-bold">Couleur</label>
                        <div class="flex flex-wrap gap-2">
                          <template x-for="color in availableColors" :key="color">
                            <div
                              class="w-6 h-6 rounded-full cursor-pointer flex items-center justify-center border transition-transform hover:scale-110"
                              :style="'background-color: ' + color + '; border-color: ' + (creationColor === color ? 'black' : 'transparent')"
                              @click="creationColor = color">
                              <iconify-icon icon="solar:check-circle-bold" class="text-white" width="14"
                                x-show="creationColor === color"></iconify-icon>
                            </div>
                          </template>

                          <!-- Custom Picker -->
                          <div
                            class="relative w-6 h-6 rounded-full cursor-pointer border border-gray-300 flex items-center justify-center overflow-hidden hover:border-gray-400"
                            :style="creationColor && !availableColors.includes(creationColor) ? 'background-color: ' + creationColor + '; border-color: ' + creationColor : ''">
                            <iconify-icon icon="solar:pen-new-square-linear" width="14" class="pointer-events-none"
                              :class="creationColor && !availableColors.includes(creationColor) ? 'text-white mix-blend-difference' : 'text-gray-500'"></iconify-icon>
                            <input type="color"
                              class="absolute inset-0 opacity-0 cursor-pointer w-full h-full p-0 border-0"
                              x-model="creationColor" title="Couleur personnalisée" />
                          </div>
                          <span x-show="creationColor && !availableColors.includes(creationColor)" x-text="creationColor"
                            class="text-[10px] self-center font-mono text-gray-500 uppercase"></span>
                        </div>
                      </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-full" :disabled="isSubmitting">
                      <span x-show="isSubmitting"
                        class="animate-spin border-2 border-white border-l-transparent rounded-full w-5 h-5 ltr:mr-2 rtl:ml-2 inline-block align-middle"></span>
                      Créer
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
          </template>

          <!-- Hub Modal -->
          <template x-teleport="body">
          <div class="fixed inset-0 bg-[black]/60 z-[999] hidden overflow-y-auto" :class="showHubModal && '!block'">
            <div class="flex items-start justify-center min-h-screen px-4" @click.self="closeHubModal()">
              <div x-show="showHubModal" x-transition x-transition.duration.300
                class="panel border-0 py-1 px-4 rounded-lg overflow-hidden w-full max-w-md my-8 bg-white dark:bg-[#1b2e4b]">
                <div class="flex items-center justify-between p-5 font-semibold text-lg dark:text-white">
                  <span>Nouveau hub</span>
                  <button type="button" @click="closeHubModal()" class="text-white-dark hover:text-dark">
                    <iconify-icon icon="solar:close-circle-bold" width="24" height="24"></iconify-icon>
                  </button>
                </div>
                <div class="p-5">
                  <form @submit.prevent="submitCreateHub">
                    <div class="relative mb-4">
                      <label class="mb-2 block text-sm font-bold">Nom du hub</label>
                      <input type="text" x-model="hubName" x-ref="hubNameInput" :placeholder="hubNamePlaceholder()"
                        class="form-input w-full" />
                    </div>
                    <div class="relative mb-5">
                      <label class="mb-2 block text-sm font-bold">Entité</label>
                      <div class="mb-3 grid grid-cols-2 gap-2 rounded-lg bg-gray-100 p-1 text-xs font-bold dark:bg-gray-800">
                        <button type="button" class="rounded-md px-3 py-2 transition"
                          :class="hubEntityMode === 'new' ? 'bg-white text-primary shadow-sm dark:bg-[#0e1726]' : 'text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-white'"
                          @click="hubEntityMode = 'new'; hubAppsOpen = false; $nextTick(() => mountHubColorPicker())">
                          Nouvelle
                        </button>
                        <button type="button" class="rounded-md px-3 py-2 transition"
                          :class="hubEntityMode === 'existing' ? 'bg-white text-primary shadow-sm dark:bg-[#0e1726]' : 'text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-white'"
                          @click="hubEntityMode = 'existing'; destroyHubPickers(); loadAllEntities()">
                          Existante
                        </button>
                      </div>
                      <template x-if="showHubModal && hubEntityMode === 'new'">
                        <div class="space-y-3">
                          <input type="text" x-model="hubEntityName" :placeholder="hubEntityPlaceholder()"
                            class="form-input w-full" />

                          <div class="rounded-lg border border-gray-200 bg-gray-50/60 p-3 dark:border-gray-700 dark:bg-[#0e1726]">
                            <div class="flex items-center justify-between gap-3">
                              <button type="button"
                                class="group relative flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-xl border transition hover:border-primary"
                                :style="'background:' + hubEntityColor + '18;border-color:' + hubEntityColor + '35'"
                                @click="openHubEntityImagePicker()"
                                title="Choisir une image">
                                <template x-if="hubEntityImage">
                                  <img :src="hubEntityImage" alt="" class="h-full w-full object-cover" />
                                </template>
                                <template x-if="!hubEntityImage">
                                  <iconify-icon :icon="hubEntityIcon" width="22" :style="'color:' + hubEntityColor"></iconify-icon>
                                </template>
                                <span class="absolute inset-0 hidden items-center justify-center bg-black/35 text-white group-hover:flex">
                                  <iconify-icon icon="solar:gallery-add-bold-duotone" width="16"></iconify-icon>
                                </span>
                              </button>
                              <div class="min-w-0 flex-1">
                                <div class="text-sm font-bold text-gray-800 dark:text-white">Identité de l'entité</div>
                                <div class="truncate text-xs text-gray-400" x-text="hubEntityImage ? 'Image, icône et couleur configurées' : 'Icône et couleur configurées'"></div>
                              </div>
                              <div class="flex shrink-0 items-center gap-2">
                                <div x-ref="hubIconPicker"
                                  data-island="icon-picker"
                                  data-name="hubEntityIcon"
                                  data-value="solar:users-group-rounded-bold-duotone"
                                  :data-value="hubEntityIcon"
                                  @icon-selected.stop="hubEntityIcon = $event.detail.icon"
                                  title="Changer l'icône"></div>
                                <div x-ref="hubEntityColorPicker" title="Changer la couleur"></div>
                                <button type="button"
                                  class="flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition hover:border-primary hover:text-primary dark:border-gray-700 dark:bg-gray-800"
                                  @click="openHubEntityImagePicker()"
                                  title="Changer l'image">
                                  <iconify-icon icon="solar:gallery-bold-duotone" width="17"></iconify-icon>
                                </button>
                              </div>
                            </div>
                            <template x-if="hubEntityImage">
                              <button type="button" class="mt-2 text-xs font-semibold text-danger hover:underline"
                                @click="hubEntityImage = ''">
                                Retirer l'image
                              </button>
                            </template>
                          </div>

                          <div class="rounded-lg border border-gray-200 bg-white p-2 dark:border-gray-700 dark:bg-[#0e1726]">
                            <button type="button" class="flex w-full items-center justify-between gap-3 rounded-md px-2 py-2 text-left"
                              @click="hubAppsOpen = !hubAppsOpen">
                              <span class="flex min-w-0 items-center gap-2">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
                                  <iconify-icon icon="solar:widget-5-bold-duotone" width="16"></iconify-icon>
                                </span>
                                <span class="min-w-0">
                                  <span class="block text-sm font-bold text-gray-800 dark:text-white">Apps actives par défaut</span>
                                  <span class="block text-xs text-gray-400" x-text="hubEnabledModulesCount() + ' activées'"></span>
                                </span>
                              </span>
                              <iconify-icon icon="solar:alt-arrow-down-linear" width="16" class="text-gray-400 transition"
                                :class="hubAppsOpen ? 'rotate-180' : ''"></iconify-icon>
                            </button>
                            <div x-show="hubAppsOpen" x-transition class="mt-2 grid grid-cols-2 gap-2">
                              <template x-for="mod in hubModuleOptions" :key="mod.key">
                                <button type="button"
                                  class="flex items-center gap-2 rounded-lg border px-2 py-2 text-left text-xs font-bold transition"
                                  :class="isHubModuleEnabled(mod.key) ? 'border-primary/30 bg-primary/10 text-primary' : 'border-gray-200 bg-white text-gray-500 dark:border-gray-700 dark:bg-[#0e1726] dark:text-gray-400'"
                                  :disabled="mod.key === 'overview'"
                                  @click="toggleHubModule(mod.key)">
                                  <iconify-icon :icon="mod.icon" width="15" :style="'color:' + mod.color"></iconify-icon>
                                  <span class="min-w-0 flex-1 truncate" x-text="mod.label"></span>
                                  <span class="h-4 w-7 rounded-full p-0.5 transition"
                                    :class="isHubModuleEnabled(mod.key) ? 'bg-primary' : 'bg-gray-200 dark:bg-gray-700'">
                                    <span class="block h-3 w-3 rounded-full bg-white transition"
                                      :class="isHubModuleEnabled(mod.key) ? 'translate-x-3' : ''"></span>
                                  </span>
                                </button>
                              </template>
                            </div>
                          </div>
                        </div>
                      </template>
                      <template x-if="hubEntityMode === 'existing'">
                        <div class="space-y-2">
                          <input type="text" x-model="hubEntitySearch" placeholder="Rechercher une entité..."
                            class="form-input w-full" />
                          <div class="max-h-44 overflow-y-auto rounded-lg border border-gray-200 bg-white p-1 dark:border-gray-700 dark:bg-[#0e1726]">
                            <template x-for="entity in filteredHubEntities()" :key="entity.id">
                              <button type="button"
                                class="flex w-full items-center gap-2 rounded-md px-2 py-2 text-left text-sm hover:bg-gray-100 dark:hover:bg-gray-800"
                                :class="hubEntityId === entity.id ? 'bg-primary/10 text-primary' : 'text-gray-700 dark:text-gray-200'"
                                @click="hubEntityId = entity.id">
                                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md"
                                  :style="'background:' + (entity.color || '#4361ee') + '16;color:' + (entity.color || '#4361ee')">
                                  <iconify-icon :icon="entity.icon || 'solar:database-bold-duotone'" width="15"></iconify-icon>
                                </span>
                                <span class="min-w-0 flex-1 truncate" x-text="entity.namePlural || entity.name"></span>
                                <iconify-icon x-show="hubEntityId === entity.id" icon="solar:check-circle-bold" width="16"></iconify-icon>
                              </button>
                            </template>
                            <div x-show="filteredHubEntities().length === 0" class="px-3 py-5 text-center text-xs text-gray-400">
                              Aucune entité trouvée
                            </div>
                          </div>
                        </div>
                      </template>
                    </div>
                    <button type="submit" class="btn btn-primary w-full" :disabled="!canSubmitHub()">
                      <span x-show="hubSubmitting"
                        class="animate-spin border-2 border-white border-l-transparent rounded-full w-5 h-5 ltr:mr-2 rtl:ml-2 inline-block align-middle"></span>
                      Créer
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
          </template>
        </div>
        </div><!-- end x-show spaces -->
        </div><!-- end x-data showAdmin wrapper -->

        <script>
          document.addEventListener("alpine:init", () => {
            // Initialize sidebar store BEFORE Alpine.data() so templates can access $store.sidebar immediately
            if (!Alpine.store('sidebar')) {
              Alpine.store('sidebar', {
                showMenu: false,
                showEditMenu: false,
                contextItem: null
              });
            }

            Alpine.data('sidebarHierarchy', () => ({
              hierarchy: [],
              hierarchyRenderKey: 0,
              activeDropdown: [],
              subActive: [],
              expandedIds: [],
              savePrefsTimeout: null,
              dragOverFolderId: null,
              pendingDropParent: null,
              dragSession: null,
              hoverOpenTimer: null,
              hoverOpenTargetId: null,
              sortableInstances: [],
              sidebarPopoverCloseHandler: null,
              sidebarPopoverCloseTimer: null,
              activeEnvironmentId: null,
              activeEnvironmentName: '',
              activeEnvironmentIcon: '',
              activeEnvironmentColor: '',
              showCreateModal: false,
              creationName: '',
              creationType: 'folder',
              creationIcon: '',
              creationColor: '',
              showHubModal: false,
              hubName: '',
              hubEntityMode: 'new',
              hubEntityId: '',
              hubEntityName: '',
              hubEntityIcon: 'solar:users-group-rounded-bold-duotone',
              hubEntityColor: '#8b5cf6',
              hubEntityImage: '',
              hubEntitySearch: '',
              hubVisibleModules: ['overview', 'fiche', 'drive', 'agenda', 'ai', 'tasks', 'notes'],
              hubAppsOpen: false,
              hubColorPicker: null,
              hubSubmitting: false,
              showIconEditModal: false,
              editingIcon: '',
              editingColor: '',
              
              // === Records Wizard State ===
              showRecordsWizard: false,
              recordsWizardStep: 1,
              recordsWizardMode: '', // 'existing' or 'new'
              recordsWizardSubmitting: false,
              wizardExistingCollection: '',
              wizardListingName: '',
              wizardViewType: 'list',
              wizardViewMode: 'all', // 'all' or 'segmentation'
              wizardFilterField: '',
              wizardFilterValue: '',
              wizardEntityFields: [],
              wizardFieldsLoading: false,
              wizardFilters: [],
              wizardNewName: '',
              wizardNewPlural: '',
              wizardNewIcon: '',
              wizardNewColor: '',
              wizardIconPickerOpen: false,
              wizardCustomFieldName: '',
              wizardCustomFieldType: 'text',
              wizardNewTitre: true,
              wizardNewDesc: true,
              isGeneratingAI: false,
              wizardSuggestedFields: [],
              wizardFieldTypeOptions: [
                { value: 'text', label: 'Texte' },
                { value: 'textarea', label: 'Long texte' },
                { value: 'number', label: 'Nombre' },
                { value: 'date', label: 'Date' },
                { value: 'select', label: 'Selection' },
                { value: 'email', label: 'Email' },
                { value: 'phone', label: 'Telephone' },
                { value: 'url', label: 'Lien' }
              ],

              // Icon Picker State
              icons: [],
              libraries: [],
              selectedLibrary: 'solar',
              iconSearch: '',
              page: 1,
              hasMore: true,
              isLoadingIcons: false,
              searchTimeout: null,
              isLoadingHierarchy: false,
              lastFetchTime: 0,

              availableColors: [
                '#4361ee', '#805dca', '#00ab55', '#e7515a', '#e2a03f',
                '#2196f3', '#3b3f5c', '#818181', '#673ab7', '#ff4081'
              ],

              hubModuleOptions: [
                { key:'overview', icon:'solar:widget-5-bold-duotone', color:'#6366f1', label:'Overview' },
                { key:'fiche', icon:'solar:card-bold-duotone', color:'#4361ee', label:'Fiche' },
                { key:'docs', icon:'solar:document-text-bold-duotone', color:'#f59e0b', label:'Docs' },
                { key:'drive', icon:'solar:cloud-storage-bold-duotone', color:'#ec4899', label:'Drive' },
                { key:'data-room', icon:'solar:shield-keyhole-bold-duotone', color:'#0f766e', label:'Data Room' },
                { key:'tasks', icon:'solar:checklist-minimalistic-bold-duotone', color:'#10b981', label:'Tasks' },
                { key:'agenda', icon:'solar:calendar-bold-duotone', color:'#14b8a6', label:'Agenda' },
                { key:'chat', icon:'solar:chat-round-dots-bold-duotone', color:'#f97316', label:'Chat' },
                { key:'emails', icon:'solar:letter-bold-duotone', color:'#0ea5e9', label:'Emails' },
                { key:'notes', icon:'solar:notebook-bold-duotone', color:'#8b5cf6', label:'Notes' },
                { key:'ai', icon:'solar:magic-stick-3-bold-duotone', color:'#4f46e5', label:'IA' },
                { key:'team', icon:'solar:users-group-rounded-bold-duotone', color:'#7c3aed', label:'Accès' }
              ],

              wizardOperatorOptions: [
                { value: 'equals', label: 'est égal à', types: ['all'] },
                { value: 'not_equals', label: 'différent de', types: ['all'] },
                { value: 'contains', label: 'contient', types: ['text', 'textarea', 'title', 'email', 'phone', 'url', 'select', 'classification', 'relation'] },
                { value: 'not_contains', label: 'ne contient pas', types: ['text', 'textarea', 'title', 'email', 'phone', 'url', 'select', 'classification', 'relation'] },
                { value: 'starts_with', label: 'commence par', types: ['text', 'textarea', 'title', 'email', 'phone', 'url'] },
                { value: 'ends_with', label: 'se termine par', types: ['text', 'textarea', 'title', 'email', 'phone', 'url'] },
                { value: 'gt', label: 'supérieur à', types: ['number', 'currency', 'percent', 'date', 'datetime'] },
                { value: 'gte', label: 'supérieur ou égal', types: ['number', 'currency', 'percent', 'date', 'datetime'] },
                { value: 'lt', label: 'inférieur à', types: ['number', 'currency', 'percent', 'date', 'datetime'] },
                { value: 'lte', label: 'inférieur ou égal', types: ['number', 'currency', 'percent', 'date', 'datetime'] },
                { value: 'between', label: 'entre', types: ['number', 'currency', 'percent', 'date', 'datetime'] },
                { value: 'in', label: 'dans la liste', types: ['all'] },
                { value: 'is_empty', label: 'est vide', types: ['all'] },
                { value: 'is_not_empty', label: "n'est pas vide", types: ['all'] }
              ],

              init() {
                this.loadLibraries();
                this.$watch('iconSearch', () => {
                  if (this.searchTimeout) clearTimeout(this.searchTimeout);
                  this.searchTimeout = setTimeout(() => {
                    this.loadIcons(true);
                  }, 300);
                });
                this.$watch('selectedLibrary', () => {
                  this.loadIcons(true);
                });
                this.$watch('wizardExistingCollection', (entityId) => {
                  this.onWizardCollectionChange(entityId);
                });
                this.$watch('wizardViewMode', (mode) => {
                  if (mode === 'segmentation' && this.wizardFilters.length === 0) {
                    this.addWizardFilter();
                  }
                });

                // Listen for environment changes from the mini-rail
                window.addEventListener('environment-changed', (e) => {
                  this.activeEnvironmentId = e.detail.environmentId;
                  this.activeEnvironmentName = e.detail.environment?.name || '';
                  this.activeEnvironmentIcon = e.detail.environment?.icon || '';
                  this.activeEnvironmentColor = e.detail.environment?.color || '';
                  this.fetchHierarchy(true);
                });

                // Listen for space creation/edit from the Space modal
                window.addEventListener('space-modal-saved', async (e) => {
                  await this.fetchHierarchy(true);
                  const created = e.detail?.newSpace || null;
