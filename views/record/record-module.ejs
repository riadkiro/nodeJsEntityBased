        <% if (moduleName === 'team') { %>
        <%- include('../record/partials/ov-widget-team') %>
        <script>
        document.addEventListener('alpine:init', () => {
            const _teamData = <%- JSON.stringify(teamModuleData || { workspaceTeams: [], workspaceMembers: [], recordGrants: [], assignedTeamIds: [], assignedUserIds: [], pendingInvites: [] }) %>;
            const _accountNumber = '<%= account_number %>';
            const _recordId = '<%= record._id %>';
            const _entityId = '<%= entity._id || '' %>';
            const _recordTitle = '<%= (record.title || "Sans titre").replace(/'/g, "\\'") %>';
            const _recordModuleOptions = [
                { key: 'overview', routeKey: 'overview', label: 'Overview', icon: 'solar:widget-5-bold-duotone', color: '#6366f1' },
                { key: 'fiche', routeKey: 'fiche', label: 'Fiche', icon: 'solar:card-bold-duotone', color: '#4361ee' },
                { key: 'docs', routeKey: 'docs', label: 'Docs', icon: 'solar:document-text-bold-duotone', color: '#f59e0b' },
                { key: 'drive', routeKey: 'drive', label: 'Drive', icon: 'solar:cloud-storage-bold-duotone', color: '#ec4899' },
                { key: 'dataRoom', routeKey: 'data-room', label: 'Data Room', icon: 'solar:shield-keyhole-bold-duotone', color: '#0f766e' },
                { key: 'tasks', routeKey: 'tasks', label: 'Tasks', icon: 'solar:checklist-minimalistic-bold-duotone', color: '#10b981' },
                { key: 'agenda', routeKey: 'agenda', label: 'Agenda', icon: 'solar:calendar-bold-duotone', color: '#14b8a6' },
                { key: 'chat', routeKey: 'chat', label: 'Chat', icon: 'solar:chat-round-dots-bold-duotone', color: '#f97316' },
                { key: 'emails', routeKey: 'emails', label: 'Emails', icon: 'solar:letter-bold-duotone', color: '#0ea5e9' },
                { key: 'notes', routeKey: 'notes', label: 'Notes', icon: 'solar:notebook-bold-duotone', color: '#8b5cf6' },
                { key: 'team', routeKey: 'team', label: 'Accès', icon: 'solar:users-group-rounded-bold-duotone', color: '#7c3aed', requiresShare: true },
            ];
            const _defaultRecordModules = Object.fromEntries(_recordModuleOptions.map(m => [
                m.key,
                { view: m.key !== 'team', edit: false },
            ]));
            const _cloneDefaultRecordModules = () => JSON.parse(JSON.stringify(_defaultRecordModules));

            Alpine.data('recordTeam', () => ({
                allTeams: _teamData.workspaceTeams || [],
                allMembers: _teamData.workspaceMembers || [],
                recordGrants: _teamData.recordGrants || [],
                assignedTeamIds: [...(_teamData.assignedTeamIds || [])],
                assignedUserIds: [...(_teamData.assignedUserIds || [])],
                pendingInvites: [...(_teamData.pendingInvites || [])],
                recordTitle: _recordTitle,
                moduleOptions: _recordModuleOptions,
                assignPerms: { read: true, update: false, delete: false, share: false, modules: _cloneDefaultRecordModules() },
                showCreateModal: false,
                showAddModal: false,
                modalSearch: '',
                modalTab: 'teams',
                newTeam: { name: '', description: '', color: '#7c3aed', memberIds: [] },
                teamColors: ['#4361ee','#7c3aed','#f97316','#10b981','#ec4899','#06b6d4','#ef4444','#8b5cf6','#eab308','#14b8a6'],
                inviteEmail: '',
                inviting: false,
                creating: false,
                toast: '',
                toastType: 'success',
                searchQuery: '',
                confirmRevokeId: null,
                showPermsId: null,

                init() {
                    this.assignPerms = this.normalizePermissions(this.assignPerms);
                },

                defaultModules(perms = {}) {
                    const modules = _cloneDefaultRecordModules();
                    if (perms.share === true) {
                        modules.team.view = true;
                    }
                    if (perms.update === true) {
                        this.moduleOptions.forEach(opt => {
                            if (opt.requiresShare && perms.share !== true) return;
                            if (modules[opt.key].view) modules[opt.key].edit = true;
                        });
                    }
                    return modules;
                },

                normalizeModuleAccess(value, fallback, perms = {}) {
                    if (typeof value === 'boolean') {
                        return { view: value, edit: value === true && perms.update === true };
                    }
                    if (value && typeof value === 'object') {
                        const explicitView = Object.prototype.hasOwnProperty.call(value, 'view');
                        const edit = value.edit === true;
                        return {
                            view: explicitView ? value.view !== false : (fallback.view || edit),
                            edit,
                        };
                    }
                    return { ...fallback };
                },

                normalizePermissions(perms = {}) {
                    const read = perms.read !== false;
                    const share = perms.share === true;
                    const update = perms.update === true;
                    const modules = this.defaultModules({ update, share });
                    if (perms.modules && typeof perms.modules === 'object') {
                        this.moduleOptions.forEach(opt => {
                            if (Object.prototype.hasOwnProperty.call(perms.modules, opt.key)) {
                                modules[opt.key] = this.normalizeModuleAccess(perms.modules[opt.key], modules[opt.key], { update, share });
                            }
                        });
                    }
                    this.moduleOptions.forEach(opt => {
                        if (!read) {
                            modules[opt.key] = { view: false, edit: false };
                            return;
                        }
                        if (opt.requiresShare && !share) {
                            modules[opt.key] = { view: false, edit: false };
                            return;
                        }
                        if (modules[opt.key].edit) modules[opt.key].view = true;
                        if (!modules[opt.key].view) modules[opt.key].edit = false;
                    });
                    const hasModuleEdit = this.moduleOptions.some(opt => modules[opt.key].edit === true);
                    return {
                        read,
                        update: update || hasModuleEdit,
                        delete: perms.delete === true,
                        share,
                        modules,
                    };
                },

                modulesFor(perms = {}) {
                    return this.normalizePermissions(perms).modules;
                },

                moduleAllowed(perms, moduleKey) {
                    return this.modulesFor(perms)[moduleKey]?.view === true;
                },

                moduleCanEdit(perms, moduleKey) {
                    return this.modulesFor(perms)[moduleKey]?.edit === true;
                },

                moduleSummary(perms) {
                    const modules = this.modulesFor(perms);
                    const viewCount = this.moduleOptions.filter(opt => modules[opt.key]?.view).length;
                    const editCount = this.moduleOptions.filter(opt => modules[opt.key]?.edit).length;
                    if (viewCount === 0) return 'Aucune app';
                    if (editCount === 0) return viewCount + ' en lecture';
                    return viewCount + ' vue' + (viewCount > 1 ? 's' : '') + ' · ' + editCount + ' edit';
                },

                toggleAssignPermission(key) {
                    if (key === 'read' && this.assignPerms.read) {
                        this.showToast('Lire reste actif. Limitez plutôt les apps accessibles.', 'error');
                        return;
                    }
                    this.assignPerms = this.normalizePermissions(this.assignPerms);
                    this.assignPerms[key] = !this.assignPerms[key];
                    if (key === 'update') {
                        this.moduleOptions.forEach(opt => {
                            if (opt.requiresShare && !this.assignPerms.share) return;
                            if (!this.assignPerms.modules[opt.key].view) return;
                            this.assignPerms.modules[opt.key].edit = this.assignPerms.update;
                        });
                    }
                    if (key === 'share' && !this.assignPerms.share) {
                        this.assignPerms.modules.team = { view: false, edit: false };
                    }
                    this.assignPerms = this.normalizePermissions(this.assignPerms);
                },

                toggleAssignModule(moduleKey, mode = 'view') {
                    this.assignPerms = this.normalizePermissions(this.assignPerms);
                    const option = this.moduleOptions.find(opt => opt.key === moduleKey);
                    if (option?.requiresShare && !this.assignPerms.share) {
                        this.showToast('Activez Partager pour donner accès à l’onglet Accès', 'error');
                        return;
                    }
                    const current = this.assignPerms.modules[moduleKey] || { view: false, edit: false };
                    if (mode === 'edit') {
                        const nextEdit = !current.edit;
                        current.edit = nextEdit;
                        if (nextEdit) {
                            current.view = true;
                            this.assignPerms.update = true;
                        }
                    } else {
                        const nextView = !current.view;
                        if (!nextView) {
                            const remaining = this.moduleOptions.filter(opt => opt.key !== moduleKey && this.assignPerms.modules[opt.key]?.view).length;
                            if (remaining === 0) {
                                this.showToast('Gardez au moins une app accessible', 'error');
                                return;
                            }
                            current.edit = false;
                        }
                        current.view = nextView;
                    }
                    this.assignPerms.modules[moduleKey] = current;
                    if (current.view) this.assignPerms.read = true;
                    if (!this.moduleOptions.some(opt => this.assignPerms.modules[opt.key]?.edit)) {
                        this.assignPerms.update = false;
                    }
                    this.assignPerms = this.normalizePermissions(this.assignPerms);
                },

                applyUpdateToModules(perms) {
                    this.moduleOptions.forEach(opt => {
                        if (opt.requiresShare && !perms.share) return;
                        if (!perms.modules[opt.key]?.view) return;
                        perms.modules[opt.key].edit = perms.update === true;
                    });
                    return perms;
                },

                applyShareToModules(perms) {
                    if (!perms.share) {
                        perms.modules.team = { view: false, edit: false };
                    }
                    return perms;
                },

                ensureAtLeastOneView(perms, blockedKey = '') {
                    if (this.moduleOptions.some(opt => opt.key !== blockedKey && perms.modules[opt.key]?.view)) return true;
                    this.showToast('Gardez au moins une app accessible', 'error');
                    return false;
                },

                syncUpdateFromModuleEdits(perms) {
                    perms.update = this.moduleOptions.some(opt => perms.modules[opt.key]?.edit);
                    return perms;
                },

                toggleModuleAccess(perms, moduleKey, mode = 'view') {
                    const option = this.moduleOptions.find(opt => opt.key === moduleKey);
                    if (option?.requiresShare && !perms.share) {
                        this.showToast('Activez Partager pour donner accès à l’onglet Accès', 'error');
                        return null;
                    }
                    const current = perms.modules[moduleKey] || { view: false, edit: false };
                    if (mode === 'edit') {
                        current.edit = !current.edit;
                        if (current.edit) current.view = true;
                    } else {
                        const nextView = !current.view;
                        if (!nextView && !this.ensureAtLeastOneView(perms, moduleKey)) return null;
                        current.view = nextView;
                        if (!nextView) current.edit = false;
                    }
                    perms.modules[moduleKey] = current;
                    return this.normalizePermissions(this.syncUpdateFromModuleEdits(perms));
                },

                payloadAssignPerms() {
                    return this.normalizePermissions(this.assignPerms);
                },

                // ─── Computed: assigned teams with permissions ───
                get assignedTeams() {
                    return this.allTeams
                        .filter(t => this.assignedTeamIds.includes(t._id))
                        .map(t => {
                            const grant = this.recordGrants.find(g => g.granteeType === 'team' && g.granteeId === t._id);
                            return {
                                ...t,
                                permissions: this.normalizePermissions(grant?.permissions || {}),
                                grantedAt: grant?.grantedAt || null,
                            };
                        });
                },

                // ─── Computed: individually assigned users with permissions ───
                get assignedUsers() {
                    return this.assignedUserIds.map(uid => {
                        const member = this.allMembers.find(m => m._id === uid);
                        const grant = this.recordGrants.find(g => g.granteeType === 'user' && g.granteeId === uid);
                        return {
                            _id: uid,
                            name: member?.name || 'Utilisateur',
                            email: member?.email || '',
                            avatar: member?.avatar || null,
                            role: member?.role || 'member',
                            permissions: this.normalizePermissions(grant?.permissions || {}),
                            grantedAt: grant?.grantedAt || null,
                        };
                    }).filter(u => u.name);
                },

                // ─── Computed: teams not yet assigned ───
                get availableTeams() {
                    return this.allTeams.filter(t => !this.assignedTeamIds.includes(t._id));
                },

                // ─── Computed: users not individually assigned (and not in an assigned team) ───
                get availableUsers() {
                    // Get all member IDs that are in already-assigned teams
                    const teamMemberIds = new Set();
                    this.assignedTeams.forEach(t => {
                        (t.memberIds || []).forEach(mid => teamMemberIds.add(String(mid)));
                    });
                    return this.allMembers.filter(m =>
                        !this.assignedUserIds.includes(m._id) &&
                        !teamMemberIds.has(m._id)
                    );
                },

                // ─── Computed: filtered add items ───
                get filteredAddItems() {
                    const q = (this.searchQuery || '').toLowerCase().trim();
                    const teams = this.availableTeams.filter(t => !q || t.name.toLowerCase().includes(q));
                    const users = this.availableUsers.filter(u => !q || u.name.toLowerCase().includes(q) || (u.email || '').toLowerCase().includes(q));
                    return { teams, users };
                },

                // ─── Computed: modal filtered users (all non-assigned) ───
                get modalFilteredUsers() {
                    const q = (this.modalSearch || '').toLowerCase().trim();
                    return this.allMembers.filter(m => {
                        if (this.assignedUserIds.includes(m._id)) return false;
                        if (!q) return true;
                        return m.name.toLowerCase().includes(q) || (m.email || '').toLowerCase().includes(q);
                    });
                },

                // ─── Computed: modal filtered teams (available, not assigned) ───
                get modalFilteredTeams() {
                    const q = (this.modalSearch || '').toLowerCase().trim();
                    return this.availableTeams.filter(t => !q || t.name.toLowerCase().includes(q));
                },

                // ─── Helpers ───
                getTeamMembers(team) {
                    return (team.memberIds || []).map(mid => {
                        const m = this.allMembers.find(m => m._id === String(mid));
                        return m || { _id: mid, name: 'Utilisateur', email: '', role: 'member' };
                    });
                },

                getMemberName(memberId) {
                    const m = this.allMembers.find(m => m._id === String(memberId));
                    return m?.name || 'Utilisateur';
                },

                avatarColor(name) {
                    const colors = ['#4361ee','#e7515a','#00ab55','#e2a03f','#805dca','#2196f3','#3b3f5c','#009688','#e91e63','#ff5722'];
                    let hash = 0;
                    for (let i = 0; i < (name || '').length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
                    return colors[Math.abs(hash) % colors.length];
                },

                formatDate(d) {
                    if (!d) return '';
                    const dt = new Date(d);
                    return dt.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
                },

                // ─── Team actions ───
                async assignTeam(teamId) {
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/grant`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                granteeType: 'team',
                                granteeId: teamId,
                                entityId: _entityId,
                                permissions: this.payloadAssignPerms(),
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.assignedTeamIds.push(teamId);
                            this.recordGrants.push({
                                granteeType: 'team',
                                granteeId: teamId,
                                permissions: this.payloadAssignPerms(),
                                grantedAt: new Date().toISOString(),
                            });
                            this.showToast('Équipe assignée', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] assign error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                async saveGrantPermissions(granteeType, granteeId, newPerms) {
                    const grant = this.recordGrants.find(g => g.granteeType === granteeType && g.granteeId === granteeId);
                    if (!grant) return;
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/grant`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ granteeType, granteeId, entityId: _entityId, permissions: newPerms })
                        });
                        const data = await res.json();
                        if (data.success) {
                            grant.permissions = this.normalizePermissions(newPerms);
                            this.showToast('Permission mise à jour', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] save permissions error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                // ─── Toggle a single CRUD permission on an existing grant ───
                async togglePermission(granteeType, granteeId, permKey) {
                    const grant = this.recordGrants.find(g => g.granteeType === granteeType && g.granteeId === granteeId);
                    if (!grant) return;
                    const newPerms = this.normalizePermissions(grant.permissions || {});
                    if (permKey === 'read' && newPerms.read) {
                        this.showToast('Retirez l’accès ou limitez les apps plutôt que de couper Lire', 'error');
                        return;
                    }
                    newPerms[permKey] = !newPerms[permKey];
                    if (permKey === 'update') {
                        this.applyUpdateToModules(newPerms);
                    }
                    if (permKey === 'share') {
                        this.applyShareToModules(newPerms);
                    }
                    await this.saveGrantPermissions(granteeType, granteeId, this.normalizePermissions(newPerms));
                },

                async toggleModule(granteeType, granteeId, moduleKey, mode = 'view') {
                    const grant = this.recordGrants.find(g => g.granteeType === granteeType && g.granteeId === granteeId);
                    if (!grant) return;
                    const newPerms = this.normalizePermissions(grant.permissions || {});
                    const nextPerms = this.toggleModuleAccess(newPerms, moduleKey, mode);
                    if (!nextPerms) return;
                    await this.saveGrantPermissions(granteeType, granteeId, nextPerms);
                },

                async revokeTeam(teamId) {
                    if (this.confirmRevokeId !== 'team-' + teamId) {
                        this.confirmRevokeId = 'team-' + teamId;
                        setTimeout(() => { if (this.confirmRevokeId === 'team-' + teamId) this.confirmRevokeId = null; }, 3000);
                        return;
                    }
                    this.confirmRevokeId = null;
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/revoke`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ granteeType: 'team', granteeId: teamId })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.assignedTeamIds = this.assignedTeamIds.filter(id => id !== teamId);
                            this.recordGrants = this.recordGrants.filter(g => !(g.granteeType === 'team' && g.granteeId === teamId));
                            this.showToast('Accès retiré', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] revoke error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                // ─── User actions ───
                async assignUser(userId) {
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/grant`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                granteeType: 'user',
                                granteeId: userId,
                                entityId: _entityId,
                                permissions: this.payloadAssignPerms(),
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.assignedUserIds.push(userId);
                            this.recordGrants.push({
                                granteeType: 'user',
                                granteeId: userId,
                                permissions: this.payloadAssignPerms(),
                                grantedAt: new Date().toISOString(),
                            });
                            this.showToast('Utilisateur ajouté', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] assignUser error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                async assignUserFromModal(userId) {
                    await this.assignUser(userId);
                },

                async revokeUser(userId) {
                    if (this.confirmRevokeId !== 'user-' + userId) {
                        this.confirmRevokeId = 'user-' + userId;
                        setTimeout(() => { if (this.confirmRevokeId === 'user-' + userId) this.confirmRevokeId = null; }, 3000);
                        return;
                    }
                    this.confirmRevokeId = null;
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/revoke`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ granteeType: 'user', granteeId: userId })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.assignedUserIds = this.assignedUserIds.filter(id => id !== userId);
                            this.recordGrants = this.recordGrants.filter(g => !(g.granteeType === 'user' && g.granteeId === userId));
                            this.showToast('Accès retiré', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] revokeUser error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                // ─── Team creation ───
                toggleNewTeamMember(memberId) {
                    const idx = this.newTeam.memberIds.indexOf(memberId);
                    if (idx >= 0) {
                        this.newTeam.memberIds.splice(idx, 1);
                    } else {
                        this.newTeam.memberIds.push(memberId);
                    }
                },

                async createTeamAndAssign() {
                    if (!this.newTeam.name.trim()) {
                        this.showToast('Le nom de l\'équipe est requis', 'error');
                        return;
                    }
                    this.creating = true;
                    try {
                        const createRes = await fetch(`/account/${_accountNumber}/api/team/teams`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                name: this.newTeam.name.trim(),
                                description: this.newTeam.description,
                                color: this.newTeam.color,
                                icon: 'solar:users-group-rounded-bold-duotone',
                                memberIds: this.newTeam.memberIds,
                            })
                        });
                        const createData = await createRes.json();
                        if (createData.success && createData.team) {
                            const newTeamId = createData.team._id;
                            this.allTeams.push({
                                _id: newTeamId,
                                name: this.newTeam.name.trim(),
                                description: this.newTeam.description,
                                color: this.newTeam.color,
                                icon: 'solar:users-group-rounded-bold-duotone',
                                memberIds: [...this.newTeam.memberIds],
                                memberCount: this.newTeam.memberIds.length,
                            });
                            await this.assignTeam(newTeamId);
                            this.newTeam = { name: '', description: '', color: '#7c3aed', memberIds: [] };
                            this.showCreateModal = false;
                            this.showToast('Équipe créée et assignée !', 'success');
                        } else {
                            this.showToast(createData.error || 'Erreur lors de la création', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] create error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                    this.creating = false;
                },

                async inviteMember() {
                    const email = this.inviteEmail.trim().toLowerCase();
                    if (!email || !email.includes('@')) {
                        this.showToast('Email invalide', 'error');
                        return;
                    }

                    // Check if already pending
                    if (this.pendingInvites.some(p => p.email === email)) {
                        this.showToast('Une invitation est déjà en attente pour cet email', 'error');
                        return;
                    }

                    // Check if this email belongs to an existing workspace member
                    const existingMember = this.allMembers.find(m => (m.email || '').toLowerCase() === email);
                    if (existingMember) {
                        if (this.assignedUserIds.includes(existingMember._id)) {
                            this.showToast('Cet utilisateur a déjà accès à cette fiche', 'error');
                            return;
                        }
                        await this.assignUser(existingMember._id);
                        this.inviteEmail = '';
                        return;
                    }

                    // Not a workspace member — create pending invite + workspace invite + send email
                    this.inviting = true;
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/pending-invite`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                email,
                                entityId: _entityId,
                                permissions: this.payloadAssignPerms(),
                                recordTitle: _recordTitle,
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.inviteEmail = '';
                            if (data.pendingInvite) {
                                this.pendingInvites.push(data.pendingInvite);
                            }
                            this.showToast(data.message || 'Invitation en attente', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] invite error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                    this.inviting = false;
                },

                confirmCancelEmail: null,

                async cancelPendingInvite(email) {
                    if (this.confirmCancelEmail !== email) {
                        this.confirmCancelEmail = email;
                        setTimeout(() => { if (this.confirmCancelEmail === email) this.confirmCancelEmail = null; }, 3000);
                        return;
                    }
                    this.confirmCancelEmail = null;
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/cancel-pending`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ email })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.pendingInvites = this.pendingInvites.filter(p => p.email !== email);
                            this.showToast('Invitation annulée', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] cancel pending error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                showToast(msg, type) {
                    this.toast = msg;
                    this.toastType = type;
                    setTimeout(() => { this.toast = ''; }, 3000);
                }
            }));
        });
        </script>
        <% } %>

