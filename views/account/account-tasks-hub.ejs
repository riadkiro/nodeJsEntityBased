<!-- Tasks Hub — aggregated workspace -->
<style>
.th-wrap{height:calc(100vh - 70px);min-height:720px;background:#fff;color:#0f172a;overflow:hidden;font-family:inherit}
.th-shell{height:100%;display:grid;grid-template-columns:268px minmax(0,1fr);border-top:1px solid #eef2f7}
.th-rail{min-width:0;border-right:1px solid #e8ecf1;background:linear-gradient(180deg,#fbfcff 0%,#f8fafc 100%);display:flex;flex-direction:column}
.th-rail-head{padding:22px 20px 18px;border-bottom:1px solid #eef2f7}
.th-brand{display:flex;align-items:center;gap:12px}
.th-brand-icon,.th-icon-box{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#6366f118,#6366f108);color:#6366f1;flex:0 0 auto}
.th-brand h1{margin:0;color:#0f172a;font-size:17px;font-weight:800;letter-spacing:0}
.th-brand p{margin:2px 0 0;color:#7c89a6;font-size:12.5px;font-weight:500;line-height:1.35}
.th-search{position:relative;margin-top:18px}
.th-search iconify-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#9aa6bf}
.th-input{width:100%;height:40px;border:1px solid #dfe6f2;border-radius:10px;background:#fff;color:#0f172a;font-size:12.5px;font-weight:500;padding:0 12px 0 36px;outline:none;transition:border-color .18s,box-shadow .18s}
.th-input:focus{border-color:#6366f1;box-shadow:0 0 0 3px rgba(99,102,241,.09)}
.th-input::placeholder{color:#b2bdd0}
.th-rail-body{flex:1;overflow:auto;padding:13px 10px 16px}
.th-rail-body::-webkit-scrollbar,.th-scroll::-webkit-scrollbar{width:5px;height:5px}
.th-rail-body::-webkit-scrollbar-thumb,.th-scroll::-webkit-scrollbar-thumb{background:#d9e1ef;border-radius:999px}
.th-side-title{margin:11px 8px 6px;color:#7c89a6;font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:.45px}
.th-space{width:100%;min-height:34px;display:flex;align-items:center;gap:8px;border:none;background:transparent;border-radius:0;padding:6px 8px;color:#475569;font-family:inherit;text-align:left;cursor:pointer;transition:all .18s;margin-bottom:1px;border-left:2.5px solid transparent}
.th-space:hover{background:#fafbff;border-left-color:#c7d2fe}
.th-space.active{background:#eef2ff;border-left-color:#4f46e5;color:#4f46e5}
.th-space-icon{width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.th-space-title{flex:1;min-width:0;font-size:12.2px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.th-record-node{margin-bottom:2px}
.th-list-node{margin:0 0 3px 13px;padding-left:9px;border-left:1.5px solid #e7ecf5}
.th-list-node .th-space{min-height:27px;padding:3px 7px 3px 6px;gap:7px;border-radius:8px;margin-bottom:0;border-left:none}
.th-list-node .th-space-icon{width:19px;height:19px;border-radius:6px}
.th-list-node .th-space-title{font-size:11.5px;font-weight:700}
.th-list-node .th-badge{min-width:18px;height:18px;padding:0 5px;font-size:10px}
.th-badge{min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:#eef2f7;color:#7c89a6;font-size:10.5px;font-weight:800;display:inline-flex;align-items:center;justify-content:center}
.th-space.active .th-badge{background:#ddd6fe;color:#5b4df5}
.th-rail-widget{border:1px solid #e8ecf1;border-radius:12px;background:#fff;margin:12px 0 14px;padding:12px;box-shadow:0 8px 22px rgba(15,23,42,.025)}
.th-rail-widget-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
.th-rail-widget-head span{display:flex;align-items:center;gap:7px;color:#475569;font-size:12px;font-weight:760}
.th-rail-widget-head b{height:22px;min-width:24px;padding:0 7px;border-radius:999px;background:#eef2ff;color:#4f46e5;font-size:11px;font-weight:850;display:inline-flex;align-items:center;justify-content:center}
.th-rail-bars{height:92px;display:grid;grid-template-columns:repeat(7,1fr);gap:5px;align-items:end}
.th-rail-bar-wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:5px;justify-content:flex-end}
.th-rail-bar-bg{height:66px;width:11px;border-radius:999px;background:#f1f5f9;display:flex;align-items:end;justify-content:center;overflow:hidden}
.th-rail-bar{width:100%;min-height:6px;border-radius:999px;background:linear-gradient(180deg,#a5b4fc,#6366f1)}
.th-rail-bar-wrap span{color:#8b98b1;font-size:9px;font-weight:750}
.th-manage{margin-top:auto;padding:14px 12px 18px;border-top:1px solid #eef2f7}
.th-manage-btn{width:100%;height:44px;border-radius:10px;border:1px solid #dde5f0;background:#fff;color:#475569;font-family:inherit;font-size:12.5px;font-weight:700;display:flex;align-items:center;justify-content:space-between;padding:0 12px;cursor:pointer;transition:all .18s}
.th-manage-btn:hover{border-color:#c7d2fe;color:#4f46e5;box-shadow:0 8px 18px rgba(15,23,42,.04)}
.th-main{min-width:0;overflow:auto;background:#fff}
.th-main-inner{padding:24px 32px 40px;max-width:920px;margin:0 auto}
.th-check{width:18px;height:18px;border:1.7px solid #cbd5e1;border-radius:5px;background:#fff;display:flex;align-items:center;justify-content:center;color:#fff;transition:all .16s;flex:0 0 auto}
.th-check.checked{background:#10b981;border-color:#10b981}
.th-count-chip{height:22px;min-width:24px;padding:0 7px;border-radius:999px;background:#eef2ff;color:#4f46e5;font-size:11px;font-weight:850;display:inline-flex;align-items:center;justify-content:center}
.th-add-row{height:38px;display:flex;align-items:center;gap:7px;padding:0 18px;color:#9aa6bf;font-size:12.5px;font-weight:650;cursor:pointer}
.th-add-row:hover{color:#4f46e5;background:#fbfcff}
.th-quick-add{min-height:52px;border:1px solid #dfe6f2;border-radius:12px;background:#fff;box-shadow:0 12px 26px rgba(15,23,42,.045);display:grid;grid-template-columns:28px minmax(0,1fr) auto auto;align-items:center;gap:10px;padding:9px 12px;margin:-4px 0 16px}
.th-quick-add input{height:34px;border:0;outline:0;background:transparent;color:#0f172a;font-family:inherit;font-size:12.8px;font-weight:600;min-width:0}
.th-quick-add input::placeholder{color:#aab5c8}
.th-quick-add-error{margin:-8px 0 14px;color:#ef4444;font-size:12px;font-weight:650}
.th-empty{padding:54px 20px;text-align:center;color:#94a3b8}
.th-empty h3{margin:10px 0 4px;color:#111827;font-size:15px;font-weight:800}
.th-empty p{margin:0;font-size:12.5px}
/* ═══ Content area ═══ */
.th-content-header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:28px}
.th-content-title{font-size:22px;font-weight:850;color:#111827;margin:0;letter-spacing:-.01em}
.th-content-subtitle{font-size:13px;color:#94a3b8;font-weight:500;margin:5px 0 0;line-height:1.4}
.th-new-task-btn{height:42px;border-radius:10px;border:none;background:linear-gradient(135deg,#4f46e5,#6366f1);color:#fff;font-family:inherit;font-size:13px;font-weight:750;padding:0 22px;display:inline-flex;align-items:center;gap:8px;cursor:pointer;box-shadow:0 6px 18px rgba(79,70,229,.22);transition:all .18s;white-space:nowrap;flex:0 0 auto}
.th-new-task-btn:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(79,70,229,.3)}
.th-date-tabs{display:flex;align-items:center;gap:6px;margin-bottom:16px;flex-wrap:wrap}
.th-date-tab{height:36px;padding:0 15px;border-radius:999px;border:1.5px solid #e8ecf1;background:#fff;color:#64748b;font-family:inherit;font-size:12.5px;font-weight:700;display:inline-flex;align-items:center;gap:7px;cursor:pointer;transition:all .16s}
.th-date-tab:hover{border-color:#c7d2fe;color:#4f46e5}
.th-date-tab.active{border-color:#4f46e5;background:#eef2ff;color:#4f46e5}
.th-tab-count{min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:#eef2f7;color:#64748b;font-size:10.5px;font-weight:850;display:inline-flex;align-items:center;justify-content:center}
.th-date-tab.active .th-tab-count{background:#ddd6fe;color:#4f46e5}
.th-date-tabs-right{margin-left:auto;display:inline-flex;align-items:center;border:1.5px solid #e8ecf1;border-radius:999px;overflow:hidden;background:#fff}
.th-view-toggle{height:34px;padding:0 14px;border:none;background:transparent;color:#64748b;font-family:inherit;font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:5px;cursor:pointer;transition:all .14s}
.th-view-toggle:hover{color:#4f46e5}
.th-view-toggle.active{background:#eef2ff;color:#4f46e5}
.th-priority-pills{display:flex;align-items:center;gap:8px;margin-bottom:24px}
.th-priority-pill{height:32px;padding:0 14px;border-radius:999px;border:none;background:#f1f5f9;color:#64748b;font-family:inherit;font-size:12.5px;font-weight:700;display:inline-flex;align-items:center;gap:6px;cursor:pointer;transition:all .14s}
.th-priority-pill:hover{background:#e8ecf1}
.th-priority-pill.active{background:#eef2ff;color:#4f46e5}
.th-priority-pill .pdot{width:7px;height:7px;border-radius:50%;flex:0 0 auto}
.th-group-header{display:flex;align-items:center;gap:8px;padding:12px 0 6px}
.th-group-flag{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.th-group-title{font-size:13px;font-weight:800;color:#111827}
.th-group-count{min-width:20px;height:20px;padding:0 6px;border-radius:999px;font-size:10.5px;font-weight:850;display:inline-flex;align-items:center;justify-content:center}
.th-task-item{display:grid;grid-template-columns:26px minmax(0,1fr) auto auto 24px;align-items:center;gap:10px;padding:7px 8px;border-bottom:1px solid #f3f4f6;transition:background .12s;cursor:pointer}
.th-task-item:hover{background:#fafbff}
.th-task-checkbox{width:18px;height:18px;border:1.5px solid #d1d5db;border-radius:5px;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;color:transparent}
.th-task-checkbox.checked{background:#10b981;border-color:#10b981;color:#fff}
.th-task-info{min-width:0}
.th-task-title-text{font-size:12.5px;font-weight:700;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.th-task-item.done .th-task-title-text{text-decoration:line-through;color:#94a3b8}
.th-task-record-label{display:flex;align-items:center;gap:4px;margin-top:2px;font-size:10.5px;color:#94a3b8;font-weight:600}
.th-task-record-dot{width:6px;height:6px;border-radius:50%;flex:0 0 auto}
.th-task-date-label{display:inline-flex;align-items:center;gap:4px;color:#94a3b8;font-size:11px;font-weight:650;white-space:nowrap}
.th-task-priority-badge{height:20px;padding:0 8px;border-radius:5px;font-size:10px;font-weight:800;display:inline-flex;align-items:center;white-space:nowrap}
.th-task-menu-btn{width:24px;height:24px;border:none;background:transparent;color:#c5cdd8;display:flex;align-items:center;justify-content:center;cursor:pointer;border-radius:5px;transition:all .12s;position:relative}
.th-task-menu-btn:hover{background:#f3f4f6;color:#6b7280}
.th-ctx-menu{position:absolute;top:100%;right:0;min-width:160px;background:#fff;border:1px solid #e8ecf1;border-radius:10px;box-shadow:0 12px 32px rgba(15,23,42,.12);z-index:99;padding:4px}
.th-ctx-item{display:flex;align-items:center;gap:8px;width:100%;padding:7px 10px;border:none;background:transparent;color:#475569;font-family:inherit;font-size:12px;font-weight:650;border-radius:7px;cursor:pointer;transition:background .12s;text-align:left}
.th-ctx-item:hover{background:#f3f4f6}
.th-ctx-item.danger{color:#ef4444}
.th-ctx-item.danger:hover{background:#fef2f2}
.th-inline-add{display:flex;align-items:center;gap:6px;padding:6px 8px;color:#b0b8c9;font-size:11.5px;font-weight:600;cursor:pointer;transition:color .12s}
.th-inline-add:hover{color:#4f46e5}
/* Dark mode — sidebar */
.dark .th-wrap,.dark .th-main{background:#060818;color:#e5edf7}
.dark .th-shell,.dark .th-rail{border-color:#1b2e4b}
.dark .th-rail{background:#0b1320}
.dark .th-rail-head,.dark .th-manage{border-color:#1b2e4b}
.dark .th-brand h1,.dark .th-content-title,.dark .th-group-title,.dark .th-modal-title{color:#e0e6ed}
.dark .th-brand p,.dark .th-content-subtitle{color:#8ea0bd}
.dark .th-input,.dark .th-manage-btn,.dark .th-quick-add{background:#0e1726;border-color:#253b5c;color:#e0e6ed;box-shadow:none}
.dark .th-rail-widget{background:#0e1726;border-color:#253b5c;box-shadow:none}
.dark .th-rail-widget-head span{color:#8ea0bd}
.dark .th-rail-bar-bg{background:#17233a}
.dark .th-quick-add input{color:#e0e6ed}
.dark .th-space:hover{background:#111f35;border-left-color:#253b5c}
.dark .th-space.active{background:#1b2447;border-left-color:#6366f1;color:#a5b4fc}
.dark .th-list-node{border-color:#253b5c}
.dark .th-ctx-menu{background:#0e1726;border-color:#253b5c;box-shadow:0 12px 32px rgba(0,0,0,.35)}
.dark .th-ctx-item{color:#e0e6ed}
.dark .th-ctx-item:hover{background:#17233a}
.dark .th-badge{background:#1b2e4b;color:#8ea0bd}
/* Dark mode — content */
.dark .th-new-task-btn{box-shadow:0 6px 18px rgba(79,70,229,.35)}
.dark .th-date-tab{background:#0e1726;border-color:#253b5c;color:#8ea0bd}
.dark .th-date-tab.active{background:#1b2447;border-color:#4f46e5;color:#a5b4fc}
.dark .th-tab-count{background:#17233a;color:#8ea0bd}
.dark .th-date-tab.active .th-tab-count{background:#2d2b73;color:#a5b4fc}
.dark .th-date-tabs-right{background:#0e1726;border-color:#253b5c}
.dark .th-view-toggle{color:#8ea0bd}
.dark .th-view-toggle.active{background:#1b2447;color:#a5b4fc}
.dark .th-priority-pill{background:#17233a;color:#8ea0bd}
.dark .th-priority-pill.active{background:#1b2447;color:#a5b4fc}
.dark .th-task-item{border-color:#1b2e4b}
.dark .th-task-item:hover{background:#111f35}
.dark .th-task-checkbox{border-color:#475569;background:#0e1726}
.dark .th-task-title-text{color:#e0e6ed}
.dark .th-task-record-label,.dark .th-task-date-label{color:#6b7f9e}
.dark .th-inline-add{color:#6b7f9e}.dark .th-inline-add:hover{color:#a5b4fc}

/* ═══ Simple onboarding-style tasks page ═══ */
.th-wrap.th-simple{height:auto;min-height:calc(100vh - 70px);overflow:visible;background:#fff;color:#0e1726}
.th-simple-shell{max-width:1180px;margin:0 auto;padding:26px 24px 42px}
.th-simple-header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:28px}
.th-simple-header h1{margin:0;color:#0e1726;font-size:26px;font-weight:850;line-height:1.2;letter-spacing:0}
.th-simple-header p{margin:8px 0 0;color:#5c6f98;font-size:13px;font-weight:700;line-height:1.35}
.th-simple-grid{display:grid;grid-template-columns:264px minmax(0,1fr);gap:24px;align-items:start}
.th-side-stack{display:flex;flex-direction:column;gap:14px;position:sticky;top:88px}
.th-panel{border:1px solid #e5edf6;border-radius:14px;background:#fff;box-shadow:0 10px 26px rgba(15,23,42,.035)}
.th-panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px 10px}
.th-panel-title{display:inline-flex;align-items:center;gap:8px;color:#0e1726;font-size:13px;font-weight:850}
.th-panel-icon{width:28px;height:28px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;background:#efe8ff;color:#805dca;flex:0 0 auto}
.th-panel-count{height:22px;min-width:24px;padding:0 8px;border-radius:8px;background:#eef2ff;color:#6f55dc;font-size:10.5px;font-weight:850;display:inline-flex;align-items:center;justify-content:center}
.th-calendar-nav{display:flex;align-items:center;gap:4px}
.th-calendar-nav button{width:24px;height:24px;border:0;border-radius:7px;background:transparent;color:#94a3b8;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:background .14s,color .14s}
.th-calendar-nav button:hover{background:#f4f6fb;color:#6f55dc}
.th-mini-calendar{padding:0 14px 14px}
.th-month-label{font-size:12px;font-weight:850;color:#334155;text-transform:capitalize}
.th-weekdays,.th-days{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.th-weekdays{margin:10px 0 6px}
.th-weekdays span{height:22px;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:10px;font-weight:850;text-transform:uppercase}
.th-day{height:30px;border:0;border-radius:9px;background:transparent;color:#334155;font-family:inherit;font-size:11.5px;font-weight:800;display:flex;align-items:center;justify-content:center;position:relative;cursor:pointer;transition:background .14s,color .14s,box-shadow .14s}
.th-day:hover{background:#f4f6fb;color:#6f55dc}
.th-day.is-muted{color:#cbd5e1}
.th-day.is-today{color:#6f55dc;background:#f7f2ff}
.th-day.is-active{background:#805dca;color:#fff;box-shadow:0 8px 16px rgba(128,93,202,.22)}
.th-day-dot{position:absolute;bottom:4px;width:4px;height:4px;border-radius:50%;background:currentColor;opacity:.55}
.th-workload{padding:0 16px 16px}
.th-workload-bars{height:106px;display:grid;grid-template-columns:repeat(7,1fr);gap:6px;align-items:end}
.th-workload-bar-wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:6px;justify-content:flex-end;border:0;background:transparent;padding:0;font-family:inherit;cursor:pointer}
.th-workload-bg{height:74px;width:12px;border-radius:999px;background:#f1f5f9;display:flex;align-items:end;overflow:hidden}
.th-workload-fill{width:100%;min-height:6px;border-radius:999px;background:linear-gradient(180deg,#a78bfa,#805dca)}
.th-workload-bar-wrap span{color:#94a3b8;font-size:9.5px;font-weight:850}
.th-workload-bar-wrap:hover .th-workload-bg{background:#e9eef8}
.th-workload-bar-wrap.is-active .th-workload-fill{background:linear-gradient(180deg,#7c5cff,#5b4df5)}
.th-workload-bar-wrap.is-active span{color:#6f55dc}
.th-center{min-width:0}
.th-today-card{border:1px solid #dfe8f3;border-radius:14px;background:#fff;box-shadow:0 10px 24px rgba(15,23,42,.025);padding:18px 22px 20px}
.th-today-header{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:16px}
.th-today-title{display:inline-flex;align-items:center;gap:8px;min-width:0;flex-wrap:wrap;color:#0e1726;font-size:14px;font-weight:850}
.th-today-icon{width:28px;height:28px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;background:#efe8ff;color:#805dca;flex:0 0 auto}
.th-count-pill{height:22px;display:inline-flex;align-items:center;justify-content:center;padding:0 9px;border-radius:8px;background:#efe8ff;color:#9273e8;font-size:10.5px;font-weight:850;white-space:nowrap}
.th-day-nav{height:22px;border:1px solid #e7defe;border-radius:8px;background:#fff;color:#6f55dc;padding:0 9px;font-family:inherit;font-size:10.5px;font-weight:850;line-height:1;display:inline-flex;align-items:center;gap:4px;cursor:pointer;transition:background .14s,border-color .14s,color .14s}
.th-day-nav:hover,.th-day-nav.is-active{background:#efe8ff;border-color:#d7c6ff;color:#7c5cff}
.th-day-nav.is-overdue{color:#b45309;border-color:#f7d9ab}
.th-day-nav.is-overdue:hover,.th-day-nav.is-overdue.is-active{background:#fff7ed;border-color:#fdba74;color:#d97706}
.th-day-calendar-btn{height:22px;min-width:20px;border:0;border-radius:8px;background:transparent;color:#8b7cf8;padding:0 2px;font-family:inherit;font-size:10.5px;font-weight:850;display:inline-flex;align-items:center;gap:5px;cursor:pointer;transform:translateY(1px)}
.th-day-calendar-btn:hover{color:#6f55dc}
.th-day-calendar-btn.is-active{padding:0 8px;background:#efe8ff;color:#7c5cff}
.th-card-link{color:#6f55dc;text-decoration:none;font-size:12px;font-weight:800;white-space:nowrap}
.th-card-link:hover{text-decoration:underline}
.th-today-body{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:26px;align-items:stretch}
.th-open-list{display:flex;flex-direction:column;gap:6px;min-width:0}
.th-task-row-simple{display:grid;grid-template-columns:18px minmax(0,1fr) auto;gap:10px;align-items:center;min-height:28px;padding:1px 8px;border-radius:8px;position:relative}
.th-task-row-simple:hover{background:#fbfcff}
.th-task-check-simple{width:15px;height:15px;border-radius:4px;border:1.5px solid #9aa8c2;background:#fff;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex:0 0 auto;color:transparent}
.th-task-check-simple.is-checked{background:#edf3ff;border-color:#90a7d8;color:#647aa8}
.th-task-check-simple iconify-icon{display:none}
.th-task-check-simple.is-checked iconify-icon{display:block}
.th-task-main-simple{min-width:0;display:flex;align-items:center;gap:7px}
.th-task-title-simple{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#17223c;font-size:13px;font-weight:700;cursor:pointer}
.th-task-row-simple.is-done .th-task-title-simple{color:#94a3b8;text-decoration:line-through;font-weight:600}
.th-task-meta-simple{display:flex;align-items:center;gap:9px;justify-content:flex-end;min-width:120px}
.th-attachment-mini{display:inline-flex;align-items:center;color:#b8c3d6}
.th-reminder-mini{width:18px;height:18px;border-radius:6px;color:var(--primary-color,#6e5afb);display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto}
.th-priority-simple{border:0;background:transparent;padding:0;color:var(--priority-color,#cbd5e1);display:inline-flex;align-items:center;gap:4px;font-family:inherit;font-size:10.5px;font-weight:850;white-space:nowrap;cursor:pointer}
.th-priority-simple iconify-icon{color:currentColor}
.th-inline-form{display:grid;grid-template-columns:minmax(0,1fr) 34px;gap:8px;margin-top:4px}
.th-inline-form input{height:31px;border:1px solid #dbe4f0;border-radius:8px;background:#fff;color:#0e1726;padding:0 11px;font-family:inherit;font-size:12.5px;font-weight:600;outline:none}
.th-inline-form input:focus{border-color:#7c5cff;box-shadow:0 0 0 3px rgba(124,92,255,.11)}
.th-inline-form input::placeholder{color:#aab6ca}
.th-inline-form button{height:31px;border:1px solid #dbe4f0;border-radius:9px;background:#fff;color:#4f46e5;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.th-inline-form button:hover{border-color:#c7d2fe;background:#fbfaff}
.th-completed{border-left:1px solid #e8edf5;padding-left:22px;min-width:0}
.th-completed-head{display:flex;align-items:center;gap:7px;color:#0e1726;font-size:12px;font-weight:850;margin-bottom:16px}
.th-completed-list{display:flex;flex-direction:column;gap:7px;max-height:170px;overflow:auto;padding-right:4px}
.th-completed-list::-webkit-scrollbar{width:5px}
.th-completed-list::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:999px}
.th-completed-row{display:grid;grid-template-columns:16px minmax(0,1fr) auto;gap:7px;align-items:center;min-height:23px;color:#94a3b8;font-size:12px;font-weight:650}
.th-done-action{border:0;background:transparent;color:#22c55e;padding:0;width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.th-completed-title{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-decoration:line-through;cursor:pointer}
.th-completed-record{font-size:10px;font-weight:800;color:#8fa0bd;white-space:nowrap}
.th-empty-simple{min-height:80px;border:1px dashed #dbe4f0;border-radius:10px;background:#fafbff;color:#8fa0bd;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;text-align:center;padding:16px}
.th-error-simple{margin-top:8px;color:#ef4444;font-size:12px;font-weight:750}
.th-task-ctx{position:fixed;z-index:10020;width:240px;background:#fff;border:1px solid #e8ecf1;border-radius:13px;box-shadow:0 18px 46px rgba(15,23,42,.16);padding:8px}
.th-task-ctx button{width:100%;min-height:32px;border:0;border-radius:9px;background:transparent;color:#475569;font-family:inherit;font-size:12px;font-weight:750;display:flex;align-items:center;gap:8px;padding:7px 9px;cursor:pointer;text-align:left;transition:background .14s,color .14s}
.th-task-ctx button:hover{background:#f8fafc;color:#4f46e5}
.th-task-ctx button.danger{color:#ef4444}
.th-task-ctx button.danger:hover{background:#fef2f2;color:#dc2626}
.th-task-ctx-label{margin:8px 7px 6px;color:#94a3b8;font-size:10px;font-weight:850;text-transform:uppercase;letter-spacing:.45px}
.th-task-ctx-priorities{display:grid;grid-template-columns:1fr 1fr;gap:5px}
.th-task-ctx-priorities button{min-height:30px;background:color-mix(in srgb,var(--priority-color,#94a3b8) 12%,#fff);color:var(--priority-color,#64748b);justify-content:flex-start}
.th-task-ctx-toggle{justify-content:space-between}
.th-task-ctx-toggle-main{display:inline-flex;align-items:center;gap:8px;min-width:0}
.th-task-switch{width:34px;height:18px;border-radius:999px;background:#e2e8f0;position:relative;flex:0 0 auto;transition:background .15s}
.th-task-switch::after{content:'';position:absolute;top:3px;left:3px;width:12px;height:12px;border-radius:50%;background:#fff;box-shadow:0 1px 4px rgba(15,23,42,.18);transition:transform .15s}
.th-task-switch.is-on{background:#10b981}
.th-task-switch.is-on::after{transform:translateX(16px)}
.dark .th-wrap.th-simple,.dark .th-today-card,.dark .th-panel{background:#060818;color:#e0e6ed;border-color:#253b5c}
.dark .th-simple-header h1,.dark .th-today-title,.dark .th-panel-title,.dark .th-completed-head,.dark .th-task-title-simple{color:#e0e6ed}
.dark .th-simple-header p{color:#8ea0bd}
.dark .th-day,.dark .th-month-label{color:#c1cad6}
.dark .th-day.is-muted{color:#506690}
.dark .th-workload-bg,.dark .th-empty-simple{background:#111f35;border-color:#253b5c}
.dark .th-task-row-simple:hover{background:#111f35}
.dark .th-inline-form input,.dark .th-inline-form button{background:#0e1726;border-color:#253b5c;color:#e0e6ed}
.dark .th-completed{border-color:#253b5c}
.dark .th-task-ctx{background:#0e1726;border-color:#253b5c;box-shadow:0 18px 46px rgba(0,0,0,.35)}
.dark .th-task-ctx button{color:#dbe5f3}
.dark .th-task-ctx button:hover{background:#111f35;color:#a5b4fc}
.dark .th-task-ctx-priorities button{background:color-mix(in srgb,var(--priority-color,#94a3b8) 18%,#0e1726)}
/* Responsive */
@media(max-width:1280px){.th-shell{grid-template-columns:248px minmax(0,1fr)}}
@media(max-width:900px){.th-wrap{height:auto;min-height:calc(100vh - 70px);overflow:visible}.th-shell{display:block}.th-rail{height:auto;border-right:0;border-bottom:1px solid #e8ecf1}.th-rail-body{max-height:300px}.th-main{overflow:visible}.th-main-inner{padding:16px}.th-content-header{flex-direction:column;gap:12px}.th-date-tabs{flex-wrap:wrap}.th-date-tabs-right{margin-left:0;margin-top:6px}.th-task-item{grid-template-columns:32px minmax(0,1fr) 28px}.th-task-item>.th-task-date-label,.th-task-item>.th-task-priority-badge{display:none}}
@media(max-width:980px){.th-simple-grid{grid-template-columns:1fr}.th-side-stack{position:static;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.th-today-body{grid-template-columns:1fr}.th-completed{border-left:0;border-top:1px solid #e8edf5;padding-left:0;padding-top:18px}}
@media(max-width:640px){.th-simple-shell{padding:18px 14px 32px}.th-simple-header h1{font-size:24px}.th-side-stack{display:flex}.th-today-card{padding:16px 14px}.th-today-header{align-items:flex-start}.th-card-link{display:none}.th-task-meta-simple{min-width:0}.th-priority-simple span{display:none}}
</style>

<div class="th-wrap th-simple"
     x-data="tasksHubApp"
     x-cloak
     @click.window="closeTaskMenu()"
     @keydown.escape.window="closeTaskMenu(); closeTask()">
    <div class="th-simple-shell">
        <header class="th-simple-header">
            <div>
                <h1>Bonjour, <%= typeof user !== 'undefined' && user && user.name ? user.name.split(' ')[0] : 'Riad' %> 👋</h1>
                <p>Voici ce qui se passe aujourd'hui</p>
            </div>
        </header>

        <div class="th-simple-grid">
            <aside class="th-side-stack">
                <section class="th-panel">
                    <div class="th-panel-head">
                        <div class="th-panel-title">
                            <span class="th-panel-icon"><iconify-icon icon="solar:calendar-bold-duotone" width="16"></iconify-icon></span>
                            <span x-text="calendarMonthLabel"></span>
                        </div>
                        <div class="th-calendar-nav">
                            <button type="button" @click="shiftCalendarMonth(-1)" title="Mois précédent">
                                <iconify-icon icon="solar:alt-arrow-left-linear" width="14"></iconify-icon>
                            </button>
                            <button type="button" @click="shiftCalendarMonth(1)" title="Mois suivant">
                                <iconify-icon icon="solar:alt-arrow-right-linear" width="14"></iconify-icon>
                            </button>
                        </div>
                    </div>
                    <div class="th-mini-calendar">
                        <div class="th-weekdays">
                            <span>Lu</span><span>Ma</span><span>Me</span><span>Je</span><span>Ve</span><span>Sa</span><span>Di</span>
                        </div>
                        <div class="th-days">
                            <template x-for="day in calendarDays" :key="day.key">
                                <button type="button"
                                        class="th-day"
                                        :class="{ 'is-muted': !day.inMonth, 'is-today': day.isToday, 'is-active': selectedMode === 'date' && selectedDateKey === day.key }"
                                        @click="selectDate(day.key)">
                                    <span x-text="day.day"></span>
                                    <span class="th-day-dot" x-show="day.count > 0"></span>
                                </button>
                            </template>
                        </div>
                    </div>
                </section>

                <section class="th-panel">
                    <div class="th-panel-head">
                        <div class="th-panel-title">
                            <span class="th-panel-icon"><iconify-icon icon="solar:chart-2-bold-duotone" width="16"></iconify-icon></span>
                            <span>Charge de travail</span>
                        </div>
                        <span class="th-panel-count" x-text="weekTaskCount"></span>
                    </div>
                    <div class="th-workload">
                        <div class="th-workload-bars">
                            <template x-for="bar in workloadBars" :key="'work-' + bar.label">
                                <button type="button"
                                        class="th-workload-bar-wrap"
                                        :class="{ 'is-active': selectedMode === 'date' && selectedDateKey === bar.key }"
                                        :title="bar.count + ' tâche' + (bar.count > 1 ? 's' : '') + ' le ' + formatDayKey(bar.key, { long: true })"
                                        @click="selectDate(bar.key)">
                                    <div class="th-workload-bg"><div class="th-workload-fill" :style="'height:' + bar.height + '%'"></div></div>
                                    <span x-text="bar.label"></span>
                                </button>
                            </template>
                        </div>
                    </div>
                </section>
            </aside>

            <main class="th-center">
                <section class="th-today-card">
                    <div class="th-today-header">
                        <div class="th-today-title">
                            <span class="th-today-icon"><iconify-icon icon="solar:bolt-bold-duotone" width="16"></iconify-icon></span>
                            <span>Tâches du jour</span>
                            <span class="th-count-pill" x-text="selectedOpenTasks.length + ' à faire'"></span>
                            <button type="button"
                                    class="th-day-nav is-overdue"
                                    x-show="overdueTasks.length > 0"
                                    :class="{ 'is-active': selectedMode === 'overdue' }"
                                    @click="selectOverdue()">
                                <iconify-icon icon="solar:danger-triangle-linear" width="11"></iconify-icon>
                                <span x-text="overdueTasks.length + ' en retard'"></span>
                            </button>
                            <button type="button"
                                    class="th-day-nav"
                                    x-show="!selectedIsToday || selectedMode === 'overdue'"
                                    @click="selectToday()">
                                Aujourd'hui
                            </button>
                            <button type="button"
                                    class="th-day-nav"
                                    :class="{ 'is-active': selectedIsTomorrow }"
                                    @click="selectTomorrow()">
                                Demain
                            </button>
                            <button type="button"
                                    class="th-day-calendar-btn"
                                    :class="{ 'is-active': selectedHasCustomDate }"
                                    title="Choisir une date"
                                    @click="focusCalendar()">
                                <iconify-icon icon="solar:calendar-linear" width="13"></iconify-icon>
                                <span x-show="selectedHasCustomDate" x-text="selectedShortLabel"></span>
                            </button>
                        </div>
                        <a class="th-card-link" href="/account/<%= account_number %>/tasks">Voir tout</a>
                    </div>

                    <div class="th-today-body">
                        <div class="th-open-list" :data-task-widget-id="'tasks-page-today'" x-init="$nextTick(() => initTodaySortable($el))">
                            <template x-for="task in selectedOpenTasks" :key="task._id || task.id">
                                <div class="th-task-row-simple"
                                     :class="{ 'is-done': isDone(task) }"
                                     :data-task-id="task._id || task.id"
                                     @contextmenu.prevent.stop="openTaskMenu($event, task)">
                                    <button type="button"
                                            class="th-task-check-simple"
                                            :class="{ 'is-checked': isDone(task) }"
                                            :title="isDone(task) ? 'Marquer à faire' : 'Marquer terminé'"
                                            @click.stop="toggleTaskStatus(task)">
                                        <iconify-icon icon="solar:check-read-linear" width="12"></iconify-icon>
                                    </button>
                                    <div class="th-task-main-simple">
                                        <span class="th-task-title-simple" x-text="task.title" @click="openTask(task)"></span>
                                    </div>
                                    <div class="th-task-meta-simple">
                                        <span class="th-reminder-mini" x-show="taskHasReminder(task)" :title="'Rappel ' + formatTime(task.reminder?.scheduledAt)">
                                            <iconify-icon icon="solar:bell-bing-bold-duotone" width="12"></iconify-icon>
                                        </span>
                                        <span class="th-attachment-mini" x-show="taskHasAttachments(task)" title="Pièce jointe">
                                            <iconify-icon icon="solar:paperclip-rounded-linear" width="12"></iconify-icon>
                                        </span>
                                        <button type="button"
                                                class="th-priority-simple"
                                                :style="'--priority-color:' + taskPriorityColor(task)"
                                                :title="'Priorité ' + taskPriorityText(task)"
                                                @click.stop="openTaskPriorityMenu($event, task)">
                                            <iconify-icon icon="solar:flag-linear" width="12"></iconify-icon>
                                            <span x-text="taskPriorityText(task)"></span>
                                        </button>
                                    </div>
                                </div>
                            </template>
                            <template x-if="selectedOpenTasks.length === 0 && !sideLoading">
                                <div class="th-empty-simple" x-text="selectedEmptyLabel"></div>
                            </template>
                            <form class="th-inline-form" x-show="selectedMode !== 'overdue'" @submit.prevent="createTodayTask()">
                                <input x-ref="newTaskInput" type="text" x-model="newTaskTitle" :placeholder="addPlaceholder" :disabled="creatingTask">
                                <button type="submit" :disabled="creatingTask" title="Ajouter">
                                    <iconify-icon :icon="creatingTask ? 'line-md:loading-twotone-loop' : 'tabler:plus'" width="15"></iconify-icon>
                                </button>
                            </form>
                            <div class="th-error-simple" x-show="addError" x-text="addError"></div>
                        </div>

                        <aside class="th-completed">
                            <div class="th-completed-head">
                                <iconify-icon icon="solar:check-circle-bold" width="15" style="color:#22c55e"></iconify-icon>
                                <strong x-text="completedTitle"></strong>
                            </div>
                            <div class="th-completed-list">
                                <template x-for="task in completedSelectedTasks" :key="task._id || task.id">
                                    <div class="th-completed-row">
                                        <button type="button" class="th-done-action" title="Remettre à faire" @click.stop="toggleTaskStatus(task)">
                                            <iconify-icon icon="solar:check-circle-bold" width="13"></iconify-icon>
                                        </button>
                                        <span class="th-completed-title" x-text="task.title" @click="openTask(task)"></span>
                                        <span class="th-completed-record" x-show="task.recordTitle && task.recordTitle !== 'Espace perso'" x-text="task.recordTitle"></span>
                                    </div>
                                </template>
                                <template x-if="completedSelectedTasks.length === 0">
                                    <div class="th-empty-simple" x-text="completedEmptyLabel"></div>
                                </template>
                            </div>
                        </aside>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <div class="th-task-ctx"
         x-show="taskMenu"
         x-cloak
         :style="taskMenu ? 'left:' + taskMenu.x + 'px;top:' + taskMenu.y + 'px' : ''"
         @click.stop>
        <button type="button" x-show="!taskMenu?.priorityOnly" @click="editTaskFromMenu()">
            <iconify-icon icon="solar:pen-2-linear" width="14"></iconify-icon>
            Modifier
        </button>
        <button type="button" class="th-task-ctx-toggle" x-show="!taskMenu?.priorityOnly" @click="toggleDayPriorityFromMenu()">
            <span class="th-task-ctx-toggle-main">
                <iconify-icon icon="solar:bolt-bold-duotone" width="14"></iconify-icon>
                <span>À faire aujourd’hui</span>
            </span>
            <span class="th-task-switch" :class="{ 'is-on': menuTaskIsDayPriority() }"></span>
        </button>
        <div class="th-task-ctx-label">Priorité</div>
        <div class="th-task-ctx-priorities">
            <template x-for="priority in taskPriorityMenuOptions()" :key="priority.label">
                <button type="button"
                        :style="'--priority-color:' + priority.color"
                        @click="setTaskPriorityFromMenu(priority)">
                    <iconify-icon icon="solar:flag-linear" width="11"></iconify-icon>
                    <span x-text="priority.label"></span>
                </button>
            </template>
        </div>
        <button type="button" class="danger" x-show="!taskMenu?.priorityOnly" @click="deleteTaskFromMenu()">
            <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="14"></iconify-icon>
            Supprimer
        </button>
    </div>

    <!-- ═══ Shared Task Detail Modal ═══ -->
    <%- include('../partials/task-detail-modal') %>
</div>

<script>
document.addEventListener('alpine:init', () => {
    const API = '/account/<%= account_number %>';

    Alpine.data('tasksHubApp', () => ({
        entities: [],
        sideLoading: true,
        searchQuery: '',
        taskSearch: '',
        activeScope: 'personal',
        activeRecordId: null,
        activeListId: null,
        activeFilter: 'today',
        selectedDateKey: '',
        selectedMode: 'date',
        calendarCursor: '',
        todaySortable: null,
        taskMenu: null,
        priorityFilter: 'all',
        sortMode: 'all',
        ctxTaskId: null,
        addingTask: false,
        creatingTask: false,
        newTaskTitle: '',
        quickAddStatus: 'À faire',
        quickAddPriority: 'Aucune',
        addError: '',
        priorityChoices: [
            { label: 'Aucune', color: '#cbd5e1', order: 0 },
            { label: 'Normal', color: '#06b6d4', order: 1 },
            { label: 'Important', color: '#f59e0b', order: 2 },
            { label: 'Urgent', color: '#ef4444', order: 3 }
        ],
        fallbackTasks: [
            { _id:'static-1', title:'Pédiatre Adam', status:'À faire', priority:'Haute', dueDate:'2026-06-16', startDate:'2026-06-16', createdAt:'2026-06-15', assignedTo:'Moi', listLabel:"Aujourd'hui", recordTitle:'Papa', recordIcon:'solar:user-rounded-bold-duotone', recordColor:'#8b5cf6', entityName:'Famille', entitySlug:'famille', entityIcon:'solar:users-group-rounded-bold-duotone', entityColor:'#8b5cf6', scope:'personal' },
            { _id:'static-2', title:'Renouveler assurance Clio 4', status:'À faire', priority:'Basse', dueDate:'2026-06-20', startDate:'2026-06-18', createdAt:'2026-06-15', assignedTo:'Moi', listLabel:'Cette semaine', recordTitle:'Clio 4', recordIcon:'solar:car-bold-duotone', recordColor:'#3b82f6', entityName:'Voiture', entitySlug:'voiture', entityIcon:'solar:car-bold-duotone', entityColor:'#3b82f6', scope:'personal' },
            { _id:'static-3', title:'Préparer réunion client', status:'En cours', priority:'Moyenne', dueDate:'2026-06-18', startDate:'2026-06-16', createdAt:'2026-06-15', assignedTo:'Yanis', listLabel:'À venir', recordTitle:'Lotissement Saidia', recordIcon:'solar:buildings-2-bold-duotone', recordColor:'#0284c7', entityName:'Société', entitySlug:'societe', entityIcon:'solar:buildings-2-bold-duotone', entityColor:'#0284c7', scope:'company' },
            { _id:'static-4', title:'Envoyer devis #2026-045', status:'En revue', priority:'Moyenne', dueDate:'2026-06-16', startDate:'2026-06-15', createdAt:'2026-06-15', assignedTo:'Sofia', listLabel:'Priorités', recordTitle:'CSA', recordIcon:'solar:buildings-bold-duotone', recordColor:'#7c3aed', entityName:'Société', entitySlug:'societe', entityIcon:'solar:buildings-2-bold-duotone', entityColor:'#0284c7', scope:'company' },
            { _id:'static-5', title:'Tache test 2', status:'À faire', priority:'Moyenne', dueDate:'2026-06-15', startDate:'2026-06-14', createdAt:'2026-06-15', assignedTo:'Ben', listLabel:"Aujourd'hui", recordTitle:'Papa', recordIcon:'solar:user-rounded-bold-duotone', recordColor:'#8b5cf6', entityName:'Famille', entitySlug:'famille', entityIcon:'solar:users-group-rounded-bold-duotone', entityColor:'#8b5cf6', scope:'personal' }
        ],

        async init() {
            this.selectedDateKey = this.todayKey();
            this.calendarCursor = this.monthKeyFromDateKey(this.selectedDateKey);
            window.addEventListener('keydown', e => { if (e.key === 'Escape') this.closeTask(); });
            await this.loadHub();
        },

        async loadHub() {
            this.sideLoading = true;
            try {
                const res = await fetch(API + '/api/tasks-hub', { credentials:'include' });
                const data = await res.json();
                if (data.success) {
                    this.entities = data.entities || [];
                    if (!this.activeScope) this.activeScope = 'personal';
                }
            } catch (e) { console.error('[TasksHub]', e); }
            this.sideLoading = false;
            this.$nextTick(() => this.refreshTodaySortable());
        },

        get allRecords() {
            const records = [];
            (this.entities || []).forEach(entity => {
                (entity.records || []).forEach(record => {
                    const scope = this.classifyRecord(record, entity);
                    const normalized = { ...record, entityName: record.entityName || entity.entityName, entitySlug: record.entitySlug || entity.entitySlug, entityIcon: record.entityIcon || entity.entityIcon, entityColor: record.entityColor || entity.entityColor, scope };
                    normalized.lists = (record.lists || []).map(list => ({ ...list, id: String(list.id || list.listId || ''), listId: String(list.listId || list.id || ''), icon: list.icon || 'solar:checklist-bold-duotone', color: list.color || record.recordColor || entity.entityColor || '#6366f1' })).filter(list => list.id);
                    normalized.tasks = (record.tasks || []).map(task => ({ ...task, scope }));
                    records.push(normalized);
                });
            });
            if (!records.length) return this.fallbackRecords;
            return records;
        },

        get fallbackRecords() {
            const byKey = {};
            this.fallbackTasks.forEach(task => {
                const key = task.recordTitle;
                if (!byKey[key]) byKey[key] = { recordId: 'static-' + key.toLowerCase().replace(/\s+/g, '-'), recordTitle: task.recordTitle, recordIcon: task.recordIcon, recordColor: task.recordColor, entityName: task.entityName, entitySlug: task.entitySlug, entityIcon: task.entityIcon, entityColor: task.entityColor, scope: task.scope, totalTasks: 0, doneTasks: 0, listsCount: 1, lists: [], tasks: [] };
                byKey[key].tasks.push(task);
                byKey[key].totalTasks++;
                if (this.isDone(task)) byKey[key].doneTasks++;
            });
            Object.values(byKey).forEach(record => {
                record.lists = [{ id: record.recordId + '-default', listId: record.recordId + '-default', label: 'Liste des tâches', icon: 'solar:checklist-bold-duotone', color: record.recordColor, totalTasks: record.totalTasks, doneTasks: record.doneTasks }];
            });
            return Object.values(byKey);
        },

        classifyRecord(record, entity = {}) {
            const text = [record.entitySlug, record.entityName, entity.entitySlug, entity.entityName, record.recordTitle].filter(Boolean).join(' ').toLowerCase();
            const companyWords = ['soci', 'societe', 'société', 'entreprise', 'company', 'client', 'prospect', 'projet', 'chantier', 'lotissement', 'group', 'csa', 'da group'];
            return companyWords.some(word => text.includes(word)) ? 'company' : 'personal';
        },

        get filteredPersonalRecords() { return this.filterSidebar(this.allRecords.filter(r => r.scope === 'personal' && r.totalTasks > 0)); },
        get filteredCompanyRecords() { return this.filterSidebar(this.allRecords.filter(r => r.scope === 'company' && r.totalTasks > 0)); },
        filterSidebar(records) {
            const q = this.searchQuery.trim().toLowerCase();
            if (!q) return records;
            return records.filter(r => ((r.recordTitle || '').toLowerCase().includes(q) || (r.entityName || '').toLowerCase().includes(q) || (r.lists || []).some(list => (list.label || '').toLowerCase().includes(q))));
        },
        selectScope(scope) { this.activeScope = scope; this.activeRecordId = null; this.activeListId = null; this.activeFilter = 'today'; this.priorityFilter = 'all'; },
        selectRecord(record, scope) { this.activeScope = scope || record.scope || 'personal'; this.activeRecordId = record.recordId; this.activeListId = null; this.activeFilter = 'all'; this.priorityFilter = 'all'; },
        selectList(record, list, scope) { this.activeScope = scope || record.scope || 'personal'; this.activeRecordId = record.recordId; this.activeListId = String(list.id || list.listId || ''); this.activeFilter = 'all'; this.priorityFilter = 'all'; },

        get activeRecords() {
            let records = this.allRecords.filter(r => r.totalTasks > 0);
            if (this.activeRecordId) return records.filter(r => r.recordId === this.activeRecordId);
            return records.filter(r => r.scope === this.activeScope);
        },
        get activeRecord() { return this.activeRecordId ? this.allRecords.find(r => r.recordId === this.activeRecordId) : null; },
        get activeList() {
            if (!this.activeListId) return null;
            return (this.activeRecord?.lists || []).find(list => String(list.id || list.listId || '') === this.activeListId) || null;
        },
        get rawVisibleTasks() {
            return this.activeRecords.flatMap(record => (record.tasks || [])
                .filter(task => !this.activeListId || String(task.listId || task.taskListId || '') === this.activeListId)
                .map(task => {
                    const taskListId = String(task.listId || task.taskListId || '');
                    const fallbackList = (record.lists || []).find(list => String(list.id || list.listId || '') === taskListId) || (record.lists || [])[0] || {};
                    const listId = taskListId || String(fallbackList.id || fallbackList.listId || '');
                    return Object.assign(task, {
                        recordId: task.recordId || record.recordId,
                        listId,
                        taskListId: listId,
                        listLabel: task.listLabel || fallbackList.label || 'Liste des tâches',
                        listIcon: task.listIcon || fallbackList.icon || 'solar:checklist-bold-duotone',
                        listColor: task.listColor || fallbackList.color || record.recordColor || record.entityColor || '#6366f1',
                        statuses: task.statuses || fallbackList.statuses || [],
                        priorities: task.priorities || fallbackList.priorities || [],
                        recordTitle: task.recordTitle || record.recordTitle,
                        recordIcon: task.recordIcon || record.recordIcon,
                        recordColor: task.recordColor || record.recordColor,
                        entityName: task.entityName || record.entityName,
                        entityIcon: task.entityIcon || record.entityIcon,
                        entityColor: task.entityColor || record.entityColor,
                        scope: record.scope
                    });
                }));
        },

        // ═══ "Aujourd'hui" = startDate ≤ today + dueDate not expired, OR isDayPriority ═══
        isTodayTask(task) {
            if (this.isDone(task)) return false;
            // isDayPriority always shows
            if (task.isDayPriority) return true;
            const now = new Date();
            const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            // startDate ≤ today AND (no dueDate OR dueDate ≥ today)
            const start = task.startDate ? new Date(task.startDate) : null;
            const due = task.dueDate ? new Date(task.dueDate) : null;
            if (start && !Number.isNaN(start.getTime())) {
                const startDay = new Date(start.getFullYear(), start.getMonth(), start.getDate());
                if (startDay <= todayStart) {
                    if (!due || Number.isNaN(due.getTime())) return true;
                    const dueDay = new Date(due.getFullYear(), due.getMonth(), due.getDate());
                    return dueDay >= todayStart;
                }
            }
            // If only dueDate = today
            if (due && !Number.isNaN(due.getTime())) return this.isSameDay(task.dueDate);
            return false;
        },

        get visibleTasks() {
            const q = this.taskSearch.trim().toLowerCase();
            const filtered = this.rawVisibleTasks
                .filter(task => {
                    if (this.activeFilter === 'today') return this.isTodayTask(task);
                    if (this.activeFilter === 'tomorrow') return this.isTomorrow(task);
                    if (this.activeFilter === 'week') return this.isTaskInThisWeek(task) || this.isTodayTask(task);
                    if (this.activeFilter === 'late') return this.isOverdue(task);
                    return true;
                })
                .filter(task => !q || [task.title, task.recordTitle, task.entityName, task.listLabel].filter(Boolean).join(' ').toLowerCase().includes(q));
            if (this.sortMode === 'recent') return filtered.sort((a, b) => this.latestTaskTime(b) - this.latestTaskTime(a));
            return filtered.sort((a, b) => this.sortDate(a) - this.sortDate(b));
        },

        get mainTitle() {
            if (this.activeList) return this.activeList.label || 'Liste de tâches';
            if (this.activeRecordId) return this.activeRecords[0]?.recordTitle || 'Tasks Hub';
            return 'Tasks Hub Perso';
        },
        get mainSubtitle() {
            if (this.activeList) return (this.activeRecord?.recordTitle || 'Record') + ' · liste de tâches';
            if (this.activeRecordId) return (this.activeRecords[0]?.entityName || 'Enregistrement') + ' · tâches du record';
            return 'Vos tâches, organisées simplement pour avancer chaque jour.';
        },

        // Filter counts (on rawVisibleTasks, before date filter)
        get lateFilterCount() { return this.rawVisibleTasks.filter(t => this.isOverdue(t)).length; },
        get todayFilterCount() { return this.rawVisibleTasks.filter(t => this.isTodayTask(t)).length; },
        get tomorrowFilterCount() { return this.rawVisibleTasks.filter(t => this.isTomorrow(t)).length; },
        get weekFilterCount() { return this.rawVisibleTasks.filter(t => this.isTaskInThisWeek(t) || this.isTodayTask(t)).length; },

        // Priority filtered tasks
        get priorityFilteredTasks() {
            if (this.priorityFilter === 'all') return this.visibleTasks;
            if (this.priorityFilter === 'Haute') return this.visibleTasks.filter(t => t.priority === 'Haute' || t.priority === 'Urgente');
            if (this.priorityFilter === 'Moyenne') return this.visibleTasks.filter(t => t.priority === 'Moyenne');
            if (this.priorityFilter === 'Normale') return this.visibleTasks.filter(t => !t.priority || t.priority === 'Aucune' || t.priority === 'Basse' || t.priority === 'Normale');
            return this.visibleTasks;
        },

        // Priority sections: Haute, Moyenne, Normale
        get prioritySections() {
            const groups = [
                { key:'high', title:'Priorité haute', icon:'solar:flag-bold', color:'#ef4444', bg:'#fef2f2', priorities:['Haute','Urgente'] },
                { key:'medium', title:'Priorité moyenne', icon:'solar:flag-bold', color:'#f97316', bg:'#fff7ed', priorities:['Moyenne'] },
                { key:'normal', title:'Priorité normale', icon:'solar:flag-bold', color:'#10b981', bg:'#ecfdf5', priorities:['Basse','Normale','Aucune',''] }
            ];
            const tasks = this.priorityFilteredTasks.filter(t => !this.isDone(t));
            return groups.map(g => ({ ...g, tasks: tasks.filter(t => g.priorities.includes(t.priority || 'Aucune')).sort((a, b) => this.sortDate(a) - this.sortDate(b)) }));
        },

        get quickAddPlaceholder() {
            if (this.activeList) return 'Ajouter dans ' + this.activeList.label;
            if (this.activeRecord) return 'Ajouter dans ' + this.activeRecord.recordTitle + ' · Liste des tâches';
            return 'Ajouter dans Espace perso · Liste des tâches';
        },
        get workloadBars() {
            const labels = ['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'];
            const counts = [0,0,0,0,0,0,0];
            const today = this.dateFromKey(this.todayKey());
            const weekStart = new Date(today);
            weekStart.setDate(today.getDate() - ((today.getDay() + 6) % 7));
            const weekEnd = new Date(weekStart);
            weekEnd.setDate(weekStart.getDate() + 6);
            this.rawVisibleTasks.filter(task => !this.isDone(task)).forEach(task => {
                const key = this.dateKeyFromValue(task.dueDate || task.startDate);
                if (!key) return;
                const date = this.dateFromKey(key);
                if (date < weekStart || date > weekEnd) return;
                const day = (date.getDay() + 6) % 7;
                counts[day]++;
            });
            const max = Math.max(1, ...counts);
            return labels.map((label, index) => {
                const d = new Date(weekStart);
                d.setDate(weekStart.getDate() + index);
                return { label, key: this.dateToKey(d), count: counts[index], height: Math.max(10, Math.round((counts[index] / max) * 92)) };
            });
        },
        get weekTaskCount() { return this.workloadBars.reduce((sum, bar) => sum + (bar.count || 0), 0); },

        async openTask(task) {
            const self = this;
            Alpine.store('taskModal').open(task, {
                onUpdate: () => self.loadHub(),
                onDelete: () => self.loadHub(),
            });
        },
        closeTask() { Alpine.store('taskModal').close(); },
        async updateTaskField(task, field, value) {
            Alpine.store('taskModal').updateField(field, value);
        },
        async deleteTask(task) {
            Alpine.store('taskModal').task = task;
            Alpine.store('taskModal')._onDelete = () => this.loadHub();
            Alpine.store('taskModal').remove();
        },
        taskId(task = {}) {
            return String(task._id || task.id || '');
        },
        findTaskById(taskId) {
            const id = String(taskId || '');
            if (!id) return null;
            for (const entity of this.entities || []) {
                for (const record of entity.records || []) {
                    const task = (record.tasks || []).find(item => this.taskId(item) === id);
                    if (!task) continue;
                    const listId = String(task.listId || task.taskListId || '');
                    const list = (record.lists || []).find(item => String(item.id || item.listId || '') === listId) || null;
                    return { task, record, list };
                }
            }
            const fallback = (this.fallbackTasks || []).find(item => this.taskId(item) === id);
            return fallback ? { task: fallback, record: null, list: null } : null;
        },
        patchTaskEverywhere(taskId, patch = {}) {
            const id = String(taskId || '');
            if (!id) return;
            (this.entities || []).forEach(entity => {
                (entity.records || []).forEach(record => {
                    (record.tasks || []).forEach(item => {
                        if (this.taskId(item) === id) Object.assign(item, patch);
                    });
                });
            });
            (this.fallbackTasks || []).forEach(item => {
                if (this.taskId(item) === id) Object.assign(item, patch);
            });
        },
        removeTaskEverywhere(taskId) {
            const id = String(taskId || '');
            if (!id) return;
            (this.entities || []).forEach(entity => {
                (entity.records || []).forEach(record => {
                    const before = (record.tasks || []).length;
                    record.tasks = (record.tasks || []).filter(item => this.taskId(item) !== id);
                    if (record.tasks.length !== before) {
                        record.totalTasks = Math.max(0, Number(record.totalTasks || before) - 1);
                        entity.totalTasks = Math.max(0, Number(entity.totalTasks || 0) - 1);
                    }
                });
            });
            this.fallbackTasks = (this.fallbackTasks || []).filter(item => this.taskId(item) !== id);
        },
        async toggleTaskStatus(task) {
            const id = this.taskId(task);
            if (!id) return;
            const newStatus = this.isDone(task) ? 'À faire' : 'Terminé';
            const previous = { status: task.status, statusColor: task.statusColor, completedAt: task.completedAt, updatedAt: task.updatedAt };
            const optimistic = {
                status: newStatus,
                statusColor: newStatus === 'Terminé' ? '#22c55e' : '#9ca3af',
                completedAt: newStatus === 'Terminé' ? new Date().toISOString() : null,
                updatedAt: new Date().toISOString()
            };
            Object.assign(task, optimistic);
            this.patchTaskEverywhere(id, optimistic);
            this.$nextTick(() => this.refreshTodaySortable());
            try {
                const res = await fetch(API + '/api/record-tasks/' + id, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ status: newStatus })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Mise à jour impossible');
                if (data.task) {
                    Object.assign(task, data.task);
                    this.patchTaskEverywhere(id, data.task);
                }
                this.$nextTick(() => this.refreshTodaySortable());
                if (window.showMessage) window.showMessage(newStatus === 'Terminé' ? 'Tâche terminée' : 'Tâche rouverte', 'success');
            } catch (e) {
                Object.assign(task, previous);
                this.patchTaskEverywhere(id, previous);
                this.$nextTick(() => this.refreshTodaySortable());
                console.error('[TasksHub] Toggle error:', e);
                if (window.showMessage) window.showMessage(e.message || 'Erreur', 'danger');
            }
        },
        toDateInputValue(value) {
            if (!value) return '';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '';
            return d.toISOString().split('T')[0];
        },
        showQuickAdd(status = 'À faire', priority = 'Aucune') {
            this.quickAddStatus = status || 'À faire';
            this.quickAddPriority = priority || 'Aucune';
            this.addingTask = true;
            this.addError = '';
            this.$nextTick(() => this.$refs.newTaskInput?.focus());
        },
        cancelQuickAdd() {
            if (this.creatingTask) return;
            this.addingTask = false;
            this.newTaskTitle = '';
            this.quickAddStatus = 'À faire';
            this.quickAddPriority = 'Aucune';
            this.addError = '';
        },
        async createPersonalTask() {
            const title = String(this.newTaskTitle || '').trim();
            if (!title || this.creatingTask) return;
            this.creatingTask = true;
            this.addError = '';
            try {
                const res = await fetch(API + '/api/tasks-hub/personal-tasks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ title, status: this.quickAddStatus || 'À faire', priority: this.quickAddPriority || 'Aucune', startDate: new Date().toISOString().split('T')[0], taskListId: this.activeListId || '' }) });
                const data = await res.json();
                if (!data.success) throw new Error(data.error || 'Impossible de créer la tâche');
                this.newTaskTitle = '';
                this.quickAddStatus = 'À faire';
                if (!this.activeListId && !this.activeRecordId) this.activeScope = 'personal';
                this.activeFilter = 'all';
                this.taskSearch = '';
                await this.loadHub();
                this.$nextTick(() => this.$refs.newTaskInput?.focus());
                if (window.showMessage) window.showMessage('Tâche ajoutée dans ' + (this.activeList?.label || 'Espace perso · Liste des tâches'), 'success');
            } catch (e) {
                console.error('[TasksHub] Create task error:', e);
                this.addError = e.message || 'Impossible de créer la tâche';
                if (window.showMessage) window.showMessage(this.addError, 'danger');
            } finally { this.creatingTask = false; }
        },

        // ═══ Simple today surface ═══
        todayKey(offset = 0) {
            const d = new Date();
            d.setHours(0, 0, 0, 0);
            d.setDate(d.getDate() + Number(offset || 0));
            return this.dateToKey(d);
        },
        dateToKey(date) {
            const d = date instanceof Date ? date : new Date(date);
            if (Number.isNaN(d.getTime())) return '';
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${y}-${m}-${day}`;
        },
        dateKeyFromValue(value) {
            if (!value) return '';
            const text = String(value);
            const m = text.match(/^(\d{4})-(\d{2})-(\d{2})/);
            if (m) return `${m[1]}-${m[2]}-${m[3]}`;
            return this.dateToKey(new Date(value));
        },
        dateFromKey(key) {
            const m = String(key || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
            if (!m) return new Date();
            return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
        },
        monthKeyFromDateKey(key) {
            return String(key || this.todayKey()).slice(0, 7);
        },
        get calendarMonthDate() {
            const key = this.calendarCursor || this.monthKeyFromDateKey(this.selectedDateKey || this.todayKey());
            const m = String(key).match(/^(\d{4})-(\d{2})$/);
            if (!m) return new Date();
            return new Date(Number(m[1]), Number(m[2]) - 1, 1);
        },
        get calendarMonthLabel() {
            return this.calendarMonthDate.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
        },
        get calendarDays() {
            const first = this.calendarMonthDate;
            const start = new Date(first);
            const mondayOffset = (first.getDay() + 6) % 7;
            start.setDate(first.getDate() - mondayOffset);
            const month = first.getMonth();
            return Array.from({ length: 42 }, (_, index) => {
                const d = new Date(start);
                d.setDate(start.getDate() + index);
                const key = this.dateToKey(d);
                return {
                    key,
                    day: d.getDate(),
                    inMonth: d.getMonth() === month,
                    isToday: key === this.todayKey(),
                    count: this.dayTaskCount(key)
                };
            });
        },
        shiftCalendarMonth(delta) {
            const d = this.calendarMonthDate;
            d.setMonth(d.getMonth() + Number(delta || 0));
            this.calendarCursor = this.monthKeyFromDateKey(this.dateToKey(d));
        },
        focusCalendar() {
            const target = this.$el?.querySelector?.('.th-mini-calendar');
            if (target) target.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        },
        selectDate(key) {
            this.selectedDateKey = this.dateKeyFromValue(key) || this.todayKey();
            this.selectedMode = 'date';
            this.calendarCursor = this.monthKeyFromDateKey(this.selectedDateKey);
            this.addError = '';
            this.$nextTick(() => this.refreshTodaySortable());
        },
        selectToday() { this.selectDate(this.todayKey()); },
        selectTomorrow() { this.selectDate(this.todayKey(1)); },
        selectOverdue() {
            this.selectedMode = 'overdue';
            this.addError = '';
            this.$nextTick(() => this.refreshTodaySortable());
        },
        get selectedIsToday() {
            return this.selectedMode === 'date' && this.selectedDateKey === this.todayKey();
        },
        get selectedIsTomorrow() {
            return this.selectedMode === 'date' && this.selectedDateKey === this.todayKey(1);
        },
        get selectedHasCustomDate() {
            return this.selectedMode === 'date' && !this.selectedIsToday && !this.selectedIsTomorrow;
        },
        get selectedShortLabel() {
            return this.formatDayKey(this.selectedDateKey);
        },
        formatDayKey(key, options = {}) {
            const d = this.dateFromKey(key);
            if (options.long) return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' });
            return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }).replace('.', '');
        },
        taskReferenceKey(task = {}) {
            return this.dateKeyFromValue(task.dueDate || task.startDate || '');
        },
        isTaskOverdueForToday(task = {}) {
            if (this.isDone(task)) return false;
            const key = this.taskReferenceKey(task);
            return !!key && key < this.todayKey();
        },
        taskMatchesDate(task = {}, key = this.selectedDateKey) {
            if (!key) return false;
            const startKey = this.dateKeyFromValue(task.startDate);
            const dueKey = this.dateKeyFromValue(task.dueDate);
            if (key === this.todayKey()) {
                if (task.isDayPriority && (!startKey || startKey <= key) && (!dueKey || dueKey >= key)) return true;
                if (startKey && startKey <= key && (!dueKey || dueKey >= key)) return true;
                return !startKey && dueKey === key;
            }
            if (startKey === key || dueKey === key) return true;
            return !!(startKey && dueKey && startKey <= key && dueKey >= key);
        },
        compareDayTasks(a, b) {
            const ao = Number.isFinite(Number(a.order)) ? Number(a.order) : 0;
            const bo = Number.isFinite(Number(b.order)) ? Number(b.order) : 0;
            if (ao !== bo) return ao - bo;
            const ap = this.taskReferenceKey(a) || '9999-12-31';
            const bp = this.taskReferenceKey(b) || '9999-12-31';
            if (ap !== bp) return ap.localeCompare(bp);
            return new Date(a.createdAt || 0) - new Date(b.createdAt || 0);
        },
        get overdueTasks() {
            return this.rawVisibleTasks
                .filter(task => this.isTaskOverdueForToday(task))
                .sort((a, b) => this.compareDayTasks(a, b));
        },
        get selectedOpenTasks() {
            const tasks = this.selectedMode === 'overdue'
                ? this.overdueTasks
                : this.rawVisibleTasks.filter(task => !this.isDone(task) && this.taskMatchesDate(task, this.selectedDateKey));
            return tasks.slice().sort((a, b) => this.compareDayTasks(a, b));
        },
        get completedSelectedTasks() {
            if (this.selectedMode === 'overdue') return [];
            return this.rawVisibleTasks
                .filter(task => this.isDone(task))
                .filter(task => {
                    const completedKey = this.dateKeyFromValue(task.completedAt || task.updatedAt);
                    return completedKey === this.selectedDateKey;
                })
                .sort((a, b) => new Date(b.completedAt || b.updatedAt || 0) - new Date(a.completedAt || a.updatedAt || 0));
        },
        get completedTitle() {
            const suffix = ` (${this.completedSelectedTasks.length})`;
            if (this.selectedIsToday || this.selectedMode === 'overdue') return "Terminées aujourd'hui" + suffix;
            if (this.selectedIsTomorrow) return 'Terminées demain' + suffix;
            return 'Terminées le ' + this.formatDayKey(this.selectedDateKey) + suffix;
        },
        get completedEmptyLabel() {
            if (this.selectedIsToday || this.selectedMode === 'overdue') return "Aucune tâche terminée aujourd'hui";
            return 'Aucune tâche terminée pour cette date';
        },
        get selectedEmptyLabel() {
            if (this.selectedMode === 'overdue') return 'Aucune tâche en retard';
            if (this.selectedIsToday) return 'Aucune tâche pour le moment';
            if (this.selectedIsTomorrow) return 'Aucune tâche pour demain';
            return 'Aucune tâche pour le ' + this.formatDayKey(this.selectedDateKey, { long: true });
        },
        get addPlaceholder() {
            if (this.selectedIsToday) return 'Ajouter une tâche...';
            if (this.selectedIsTomorrow) return 'Ajouter une tâche pour demain...';
            return 'Ajouter une tâche pour le ' + this.formatDayKey(this.selectedDateKey, { long: true }) + '...';
        },
        dayTaskCount(key) {
            return this.rawVisibleTasks.filter(task => !this.isDone(task) && this.taskMatchesDate(task, key)).length;
        },
        taskHasAttachments(task = {}) {
            return Array.isArray(task.attachments) && task.attachments.length > 0;
        },
        taskHasReminder(task = {}) {
            const raw = task?.reminder?.scheduledAt;
            if (!raw) return false;
            const date = new Date(raw);
            return !Number.isNaN(date.getTime());
        },
        taskPriorityText(task = {}) {
            const label = String(task.priority || 'Aucune');
            if (!label || label === 'Aucune' || label === 'Basse' || label === 'Normale') return 'Normal';
            if (label === 'Moyenne') return 'Important';
            if (label === 'Haute' || label === 'Urgente') return 'Urgent';
            return label;
        },
        taskPriorityColor(task = {}) {
            const label = String(task.priority || 'Aucune');
            if (task.priorityColor) return task.priorityColor;
            if (label === 'Urgente' || label === 'Haute' || label === 'Urgent') return '#ef4444';
            if (label === 'Moyenne' || label === 'Important') return '#f59e0b';
            if (label === 'Basse' || label === 'Normal' || label === 'Normale') return '#06b6d4';
            return '#cbd5e1';
        },
        async createTodayTask() {
            const title = String(this.newTaskTitle || '').trim();
            if (!title || this.creatingTask) return;
            this.creatingTask = true;
            this.addError = '';
            try {
                const res = await fetch(API + '/api/tasks-hub/personal-tasks', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        title,
                        status: 'À faire',
                        priority: 'Aucune',
                        isDayPriority: true,
                        startDate: this.selectedDateKey || this.todayKey(),
                        taskListId: this.activeListId || ''
                    })
                });
                const data = await res.json().catch(() => ({}));
                if (!data.success || !data.task) throw new Error(data.error || 'Impossible de créer la tâche');
                this.newTaskTitle = '';
                await this.loadHub();
                this.$nextTick(() => {
                    this.$refs.newTaskInput?.focus();
                    this.refreshTodaySortable();
                });
            } catch (e) {
                console.error('[TasksHub] Create today task error:', e);
                this.addError = e.message || 'Impossible de créer la tâche';
                if (window.showMessage) window.showMessage(this.addError, 'danger');
            } finally {
                this.creatingTask = false;
            }
        },
        initTodaySortable(el) {
            if (!el || typeof Sortable === 'undefined') return;
            if (this.todaySortable) {
                try { this.todaySortable.destroy(); } catch (e) {}
                this.todaySortable = null;
            }
            this.todaySortable = Sortable.create(el, {
                animation: 160,
                draggable: '.th-task-row-simple',
                filter: 'button,input',
                preventOnFilter: false,
                onEnd: evt => this.persistTodayOrder(evt)
            });
        },
        refreshTodaySortable() {
            const el = this.$el?.querySelector?.('[data-task-widget-id="tasks-page-today"]');
            if (el) this.initTodaySortable(el);
        },
        async persistTodayOrder(evt) {
            const rows = Array.from(evt?.to?.querySelectorAll?.('.th-task-row-simple[data-task-id]') || []);
            const ids = rows.map(row => row.dataset.taskId).filter(Boolean);
            if (ids.length < 2) return;
            try {
                const res = await fetch(API + '/api/tasks-hub/reorder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ taskIds: ids })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Réorganisation impossible');
                await this.loadHub();
            } catch (e) {
                console.error('[TasksHub] Reorder error:', e);
                if (window.showMessage) window.showMessage(e.message || 'Réorganisation impossible', 'danger');
                await this.loadHub();
            }
        },
        closeTaskMenu() {
            this.taskMenu = null;
        },
        openTaskMenu(event, task, options = {}) {
            const id = this.taskId(task);
            if (!id) return;
            const width = 240;
            const height = options.priorityOnly ? 128 : 264;
            const source = event?.currentTarget || event?.target;
            const rect = source?.getBoundingClientRect?.();
            const rawX = event?.clientX || (rect ? rect.right : 0);
            const rawY = event?.clientY || (rect ? rect.bottom : 0);
            const x = Math.max(8, Math.min(rawX, window.innerWidth - width - 8));
            const y = Math.max(8, Math.min(rawY, window.innerHeight - height - 8));
            this.taskMenu = { x, y, taskId: id, priorityOnly: options.priorityOnly === true };
        },
        openTaskPriorityMenu(event, task) {
            this.openTaskMenu(event, task, { priorityOnly: true });
        },
        menuTask() {
            return this.findTaskById(this.taskMenu?.taskId)?.task || null;
        },
        menuTaskIsDayPriority() {
            return !!this.menuTask()?.isDayPriority;
        },
        editTaskFromMenu() {
            const task = this.menuTask();
            this.closeTaskMenu();
            if (task) this.openTask(task);
        },
        normalizePriorityOptions(options = []) {
            const source = Array.isArray(options) && options.length ? options : this.priorityChoices;
            const fallbackByLabel = new Map(this.priorityChoices.map(item => [String(item.label).toLowerCase(), item]));
            const seen = new Set();
            return source
                .map((option, index) => {
                    const label = String(option?.label || option || 'Aucune').trim() || 'Aucune';
                    const fallback = fallbackByLabel.get(label.toLowerCase()) || this.priorityChoices[index] || {};
                    return {
                        label,
                        color: option?.color || fallback.color || '#94a3b8',
                        order: Number.isFinite(Number(option?.order)) ? Number(option.order) : index
                    };
                })
                .filter(option => {
                    const key = option.label.toLowerCase();
                    if (seen.has(key)) return false;
                    seen.add(key);
                    return true;
                })
                .sort((a, b) => a.order - b.order);
        },
        taskPriorityOptions(task = null) {
            const found = task ? this.findTaskById(this.taskId(task)) : this.findTaskById(this.taskMenu?.taskId);
            const options = this.normalizePriorityOptions(task?.priorities || found?.task?.priorities || found?.list?.priorities || []);
            if (!options.some(option => option.label === 'Aucune')) {
                return [{ label: 'Aucune', color: '#cbd5e1', order: -1 }, ...options];
            }
            return options;
        },
        taskPriorityMenuOptions() {
            return this.taskPriorityOptions(this.menuTask());
        },
        async updateTaskPatch(task, updates = {}, optimisticExtra = {}) {
            const id = this.taskId(task);
            if (!id || !updates || typeof updates !== 'object') return false;
            const previous = { ...task };
            const patch = { ...updates, ...optimisticExtra, updatedAt: new Date().toISOString() };
            Object.assign(task, patch);
            this.patchTaskEverywhere(id, patch);
            this.$nextTick(() => this.refreshTodaySortable());
            try {
                const res = await fetch(API + '/api/record-tasks/' + id, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(updates)
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Modification impossible');
                if (data.task) {
                    Object.assign(task, data.task);
                    this.patchTaskEverywhere(id, data.task);
                }
                this.$nextTick(() => this.refreshTodaySortable());
                return true;
            } catch (e) {
                Object.assign(task, previous);
                this.patchTaskEverywhere(id, previous);
                this.$nextTick(() => this.refreshTodaySortable());
                if (window.showMessage) window.showMessage(e.message || 'Modification impossible', 'danger');
                return false;
            }
        },
        async setTaskPriorityFromMenu(priority) {
            const task = this.menuTask();
            if (!task) return;
            this.closeTaskMenu();
            const label = String(priority?.label || priority || 'Aucune').trim() || 'Aucune';
            await this.updateTaskPatch(task, { priority: label }, { priorityColor: priority?.color || this.taskPriorityColor({ priority: label }) });
        },
        async toggleDayPriorityFromMenu() {
            const task = this.menuTask();
            if (!task) return;
            this.closeTaskMenu();
            await this.updateTaskPatch(task, { isDayPriority: !task.isDayPriority });
        },
        async deleteTaskFromMenu() {
            const task = this.menuTask();
            const id = this.taskId(task);
            this.closeTaskMenu();
            if (!task || !id) return;
            const previousEntities = JSON.parse(JSON.stringify(this.entities || []));
            const previousFallback = JSON.parse(JSON.stringify(this.fallbackTasks || []));
            this.removeTaskEverywhere(id);
            try {
                const res = await fetch(API + '/api/record-tasks/' + id, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Suppression impossible');
                this.$nextTick(() => this.refreshTodaySortable());
            } catch (e) {
                this.entities = previousEntities;
                this.fallbackTasks = previousFallback;
                if (window.showMessage) window.showMessage(e.message || 'Suppression impossible', 'danger');
            }
        },

        // ═══ Helpers ═══
        isDone(task) { return (task.status || '').toLowerCase() === 'terminé'; },
        isOverdue(task) {
            return this.isTaskOverdueForToday(task);
        },
        isToday(task) { return task.dueDate ? this.isSameDay(task.dueDate) : false; },
        isTomorrow(task) {
            const key = this.dateKeyFromValue(task.dueDate || task.startDate);
            return !!key && key === this.todayKey(1);
        },
        isTaskInThisWeek(task) { return this.isDateThisWeek(task.startDate) || this.isDateThisWeek(task.dueDate); },
        isSameDay(value) {
            if (!value) return false;
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return false;
            const n = new Date();
            return d.getFullYear() === n.getFullYear() && d.getMonth() === n.getMonth() && d.getDate() === n.getDate();
        },
        isDateThisWeek(value) {
            if (!value) return false;
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return false;
            const n = new Date();
            const start = new Date(n); start.setHours(0,0,0,0);
            const end = new Date(start); end.setDate(end.getDate() + 7);
            return d >= start && d <= end;
        },
        latestTaskTime(task) {
            const dates = [task.updatedAt, task.createdAt].map(v => v ? new Date(v).getTime() : 0).filter(v => Number.isFinite(v));
            return dates.length ? Math.max(...dates) : 0;
        },
        taskDisplayDate(task) { return task.startDate || task.dueDate || task.updatedAt || task.createdAt; },
        sortDate(task) {
            const d = task.startDate ? new Date(task.startDate) : (task.dueDate ? new Date(task.dueDate) : new Date(task.createdAt || Date.now()));
            return Number.isNaN(d.getTime()) ? Date.now() : d.getTime();
        },
        formatDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '—';
            return d.toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit', year:'2-digit' });
        },
        formatTime(value) {
            if (!value) return '';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '';
            return d.toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' });
        },
        formatLongDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '—';
            return d.toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' });
        },
        formatRelativeDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '—';
            const now = new Date();
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const target = new Date(d.getFullYear(), d.getMonth(), d.getDate());
            const diff = Math.round((target - today) / 86400000);
            if (diff === 0) return "Aujourd'hui";
            if (diff === 1) return 'Demain';
            if (diff === -1) return 'Hier';
            if (diff < -1) return 'Il y a ' + Math.abs(diff) + 'j';
            if (diff <= 7) return d.toLocaleDateString('fr-FR', { weekday: 'long' });
            return d.toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit', year:'2-digit' });
        },
        // Priority label: Basse → Normale
        priorityLabel(priority) {
            if (!priority || priority === 'Aucune') return 'Normale';
            if (priority === 'Basse') return 'Normale';
            return priority;
        },
        priorityStyle(priority) {
            const map = { Urgente:['#fee2e2','#dc2626'], Haute:['#fef2f2','#ef4444'], Moyenne:['#fff7ed','#f97316'], Basse:['#ecfdf5','#10b981'], Normale:['#ecfdf5','#10b981'], Aucune:['#f1f5f9','#64748b'] };
            const [bg, color] = map[priority || 'Aucune'] || map.Aucune;
            return `background:${bg};color:${color}`;
        },
        colorSoft(color) {
            const hex = color || '#6366f1';
            return String(hex).startsWith('#') ? hex + '16' : 'rgba(99,102,241,.09)';
        }
    }));
});
</script>
