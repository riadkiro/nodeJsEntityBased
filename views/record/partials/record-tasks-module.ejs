        height:34px;border:0;background:transparent;border-radius:8px;padding:0 13px;color:#64748b;
        font-family:inherit;font-size:12px;font-weight:800;display:inline-flex;align-items:center;gap:6px;
        cursor:pointer;transition:all .16s;
    }
    .tl-mode-segment button.active { background:#eef2ff;color:#4f46e5;box-shadow:0 1px 3px rgba(15,23,42,.06); }
    .tl-mode-segment button:disabled { opacity:.45;cursor:not-allowed; }
    .tl-pro-btn,.tl-pro-primary,.tl-pro-icon-btn {
        height:38px;border-radius:10px;border:1px solid #dfe6f2;background:#fff;color:#475569;
        font-family:inherit;font-size:12px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;
        gap:7px;padding:0 13px;cursor:pointer;transition:all .17s;white-space:nowrap;
