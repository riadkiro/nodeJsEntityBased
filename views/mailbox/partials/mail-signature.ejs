<!-- ========== SIGNATURE PANEL ========== -->
<div x-show="showSignature" style="display: none;">
    <div class="flex items-center justify-between px-6 py-4">
        <h4 class="text-lg font-semibold dark:text-gray-300">Email Signatures</h4>
        <button type="button" class="btn btn-primary btn-sm gap-1" @click="addSignature()">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Signature
        </button>
    </div>
    <div class="h-px border-b border-[#e0e6ed] dark:border-[#1b2e4b]"></div>

    <!-- Signature Form (add/edit) -->
    <template x-if="editingSignature !== null">
        <div class="p-6">
            <div class="space-y-4">
                <div>
                    <label class="mb-1 block text-sm font-semibold dark:text-gray-300">Signature Name:</label>
                    <input type="text" class="form-input" x-model="editingSignature.name" placeholder="e.g. Professional" />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-semibold dark:text-gray-300">Content (HTML):</label>
                    <textarea class="form-textarea" rows="6" x-model="editingSignature.content" placeholder="<p>Best regards,<br>Your Name</p>"></textarea>
                </div>
                <div class="flex items-center gap-3">
                    <button type="button" class="btn btn-primary" @click="saveSignature()">Save Signature</button>
                    <button type="button" class="btn btn-outline-danger" @click="editingSignature = null">Cancel</button>
                </div>
                <!-- Preview -->
                <template x-if="editingSignature.content">
                    <div>
                        <label class="mb-1 block text-sm font-semibold dark:text-gray-300">Preview:</label>
                        <div class="rounded-md border border-[#e0e6ed] p-4 dark:border-[#1b2e4b]" x-html="editingSignature.content"></div>
                    </div>
                </template>
            </div>
        </div>
    </template>

    <!-- Signatures List -->
    <template x-if="editingSignature === null">
        <div class="p-6">
            <template x-if="signatures.length === 0">
                <div class="grid min-h-[200px] place-content-center text-lg font-semibold text-white-dark">
                    No signatures yet. Click "Add Signature" to create one.
                </div>
            </template>
            <div class="space-y-4">
                <template x-for="(sig, idx) in signatures" :key="idx">
                    <div class="rounded-md border border-[#e0e6ed] p-4 dark:border-[#1b2e4b]" :class="{ 'border-primary': sig.isDefault }">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <h5 class="text-base font-semibold dark:text-gray-300" x-text="sig.name"></h5>
                                <template x-if="sig.isDefault">
                                    <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary">Default</span>
                                </template>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm" @click="editSignature(idx)">Edit</button>
                                <button type="button" class="btn btn-outline-success btn-sm" @click="setDefaultSignature(idx)" x-show="!sig.isDefault">Set Default</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" @click="deleteSignature(idx)">Delete</button>
                            </div>
                        </div>
                        <div class="mt-3 rounded-md bg-gray-50 p-3 text-sm dark:bg-[#0e1726]" x-html="sig.content"></div>
                    </div>
                </template>
            </div>
        </div>
    </template>
</div>
