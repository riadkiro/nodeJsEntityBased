<!-- ╪══════════════ Unified Widget Picker Modal ══════════════╪ -->
<template x-teleport="body">
    <div data-widget-picker-overlay
         x-show="$store.widgetPicker.open"
         x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
         style="display: none; position: fixed; inset: 0; z-index: 9999; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); background: rgba(0,0,0,0.25);"
         class="flex items-center justify-center"
         @click.self="$store.widgetPicker.close()"
         @keydown.escape.window="$store.widgetPicker.close()"
         x-cloak>

        <div @click.stop
             style="background: white; border-radius: 20px; padding: 0; width: 100%; max-width: 480px; margin: 16px; box-shadow: 0 25px 60px rgba(0,0,0,0.15), 0 4px 16px rgba(0,0,0,0.08); border: 1px solid rgba(0,0,0,0.04); overflow: hidden; display: flex; flex-direction: column; max-height: 90vh;"
             x-show="$store.widgetPicker.open"
             x-transition:enter="transition ease-out duration-250 delay-50"
             x-transition:enter-start="opacity-0 scale-95 translate-y-3" x-transition:enter-end="opacity-100 scale-100 translate-y-0">

            <!-- Modal Header -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid #f3f4f6;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center;"
                         :style="'background: ' + ($store.widgetPicker.step === 'form' ? $store.widgetPicker.newWidget.color + '12' : 'rgba(67,97,238,0.08)')">
                        <iconify-icon :icon="$store.widgetPicker.step === 'form' ? $store.widgetPicker.newWidget.icon : 'solar:widget-add-bold-duotone'"
                                      width="20"
                                      :style="'color:' + ($store.widgetPicker.step === 'form' ? $store.widgetPicker.newWidget.color : '#4361ee')"></iconify-icon>
                    </div>
                    <div>
                        <h3 style="font-size: 16px; font-weight: 700; color: #111827; margin: 0; line-height: 1.3;"
                            x-text="$store.widgetPicker.step === 'form' ? 'Configurer ' + $store.widgetPicker.newWidget.label : 'Ajouter un widget'"></h3>
                        <p style="font-size: 12px; color: #9ca3af; margin: 2px 0 0 0;"
                           x-text="$store.widgetPicker.step === 'form' ? ($store.widgetPicker.catalogItem($store.widgetPicker.newWidget._catalogType || $store.widgetPicker.newWidget.type)?.desc || 'Personnalisez les paramètres') : 'Choisissez un composant à insérer'"></p>
                    </div>
                </div>
                <button type="button" @click="$store.widgetPicker.close()"
                        style="width: 32px; height: 32px; border-radius: 50%; border: 1px solid #e5e7eb; cursor: pointer; background: white; color: #9ca3af; display: flex; align-items: center; justify-content: center; transition: all 0.15s;"
                        onmouseover="this.style.background='#f9fafb';this.style.color='#6b7280'" onmouseout="this.style.background='white';this.style.color='#9ca3af'">
                    <iconify-icon icon="tabler:x" width="16"></iconify-icon>
                </button>
            </div>

            <!-- Modal Content (Catalog) -->
            <div x-show="$store.widgetPicker.step === 'catalog'" style="padding: 20px 24px; overflow-y: auto; max-height: 60vh;" class="custom-scrollbar">
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
                    <template x-for="w in $store.widgetPicker.visibleCatalog()" :key="w.type">
                        <button type="button"
                                @click="$store.widgetPicker.selectType(w.type)"
                                style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 16px 8px; border-radius: 14px; border: 1px solid #f3f4f6; background: white; cursor: pointer; transition: all 0.2s;"
                                onmouseover="this.style.borderColor='rgba(67,97,238,0.3)';this.style.background='rgba(67,97,238,0.02)';this.style.transform='translateY(-1px)'"
                                onmouseout="this.style.borderColor='#f3f4f6';this.style.background='white';this.style.transform='translateY(0)'">
                            <div style="width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center;"
                                 :style="'background: ' + w.color + '10'">
                                <iconify-icon :icon="w.icon" width="20" :style="'color: ' + w.color"></iconify-icon>
                            </div>
                            <span style="font-size: 12px; font-weight: 600; color: #374151;" x-text="w.label"></span>
                            <span style="font-size: 10px; color: #9ca3af; line-height: 1.3; text-align: center;" x-text="w.desc"></span>
                        </button>
                    </template>
                </div>
            </div>

            <!-- Modal Content (Form) -->
            <div x-show="$store.widgetPicker.step === 'form'" style="padding: 20px 24px; overflow-y: auto; max-height: 60vh;" class="custom-scrollbar">
                <div style="display: flex; flex-direction: column; gap: 20px;">

                    <!-- Common: Title -->
                    <div>
                        <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Titre du widget</label>
                        <input type="text" x-model="$store.widgetPicker.newWidget.label"
                               style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; font-weight: 600; outline: none; transition: border-color 0.15s; box-sizing: border-box; color: #111827;"
                               onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                               placeholder="Ex: Ma Note, Stats...">
                    </div>

                    <!-- Dynamic Fields based on type -->

                    <!-- 1. HTML / Rich Text -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'html'">
                        <div>
                            <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Contenu HTML</label>
                            <textarea x-model="$store.widgetPicker.newWidget.config.content" rows="6"
                                      style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; font-family: monospace; outline: none; box-sizing: border-box; resize: vertical;"
                                      onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                      placeholder="<p>Bonjour...</p>"></textarea>
                        </div>
                    </template>

                    <!-- 2. Note -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'note' || $store.widgetPicker.newWidget.type === 'notes'">
                        <div>
                            <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Mémo / Note</label>
                            <textarea x-model="$store.widgetPicker.newWidget.config.content" rows="4"
                                      style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box; resize: vertical;"
                                      onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                      placeholder="Écrire quelque chose..."></textarea>
                        </div>
                    </template>

                    <!-- 3. Link -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'link'">
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">URL de destination</label>
                                <input type="url" x-model="$store.widgetPicker.newWidget.config.url"
                                       style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                       placeholder="https://...">
                            </div>
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Description (facultatif)</label>
                                <input type="text" x-model="$store.widgetPicker.newWidget.config.description"
                                       style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                       placeholder="Bouton vers...">
                            </div>
                            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="checkbox" x-model="$store.widgetPicker.newWidget.config.newTab" class="form-checkbox" style="accent-color: #4361ee;">
                                <span style="font-size: 12px; color: #6b7280;">Ouvrir dans un nouvel onglet</span>
                            </label>
                        </div>
                    </template>

                    <!-- 4. iFrame / Embed -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'iframe'">
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">URL de la page</label>
                                <input type="url" x-model="$store.widgetPicker.newWidget.config.url"
                                       style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                       placeholder="https://...">
                            </div>
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Hauteur (px)</label>
                                <input type="number" x-model="$store.widgetPicker.newWidget.config.height"
                                       style="width: 200px; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'">
                            </div>
                        </div>
                    </template>

                    <!-- 4b. Video -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'video'">
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">URL de la vidéo</label>
                                <input type="url" x-model="$store.widgetPicker.newWidget.config.url"
                                       style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                       placeholder="https://youtube.com/... ou https://.../video.mp4">
                            </div>
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Hauteur (px)</label>
                                <input type="number" x-model="$store.widgetPicker.newWidget.config.height"
                                       style="width: 200px; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'">
                            </div>
                        </div>
                    </template>

                    <!-- 5. Image -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'image'">
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">URL de l'image</label>
                                <input type="url" x-model="$store.widgetPicker.newWidget.config.url"
                                       style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                       placeholder="https://...">
                            </div>
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Texte alternatif</label>
                                <input type="text" x-model="$store.widgetPicker.newWidget.config.alt"
                                       style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'">
                            </div>
                        </div>
                    </template>

                    <!-- 6. Relational / Dynamic Table -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'dynamic-table'">
                        <div style="display: flex; flex-direction: column; gap: 16px;">
	                            <div>
	                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Mode d'affichage</label>
	                                <div style="display:flex;gap:8px;margin-bottom:12px;">
	                                    <button type="button"
	                                            @click="$store.widgetPicker.setDynamicTableMode('tabs')"
	                                            :style="'flex:1;padding:9px 10px;border-radius:10px;border:' + ($store.widgetPicker.newWidget.config.displayMode !== 'panels' ? '1.5px solid #4361ee' : '1px solid #e5e7eb') + ';background:' + ($store.widgetPicker.newWidget.config.displayMode !== 'panels' ? 'rgba(67,97,238,.07)' : '#fff') + ';color:' + ($store.widgetPicker.newWidget.config.displayMode !== 'panels' ? '#4361ee' : '#64748b') + ';font-size:12px;font-weight:700;cursor:pointer;'">
	                                        Multiple avec onglets
	                                    </button>
	                                    <button type="button"
	                                            @click="$store.widgetPicker.setDynamicTableMode('panels')"
	                                            :style="'flex:1;padding:9px 10px;border-radius:10px;border:' + ($store.widgetPicker.newWidget.config.displayMode === 'panels' ? '1.5px solid #4361ee' : '1px solid #e5e7eb') + ';background:' + ($store.widgetPicker.newWidget.config.displayMode === 'panels' ? 'rgba(67,97,238,.07)' : '#fff') + ';color:' + ($store.widgetPicker.newWidget.config.displayMode === 'panels' ? '#4361ee' : '#64748b') + ';font-size:12px;font-weight:700;cursor:pointer;'">
	                                        Single
	                                    </button>
	                                </div>
                                    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;">
                                        <label style="font-size: 12px; font-weight: 600; color: #374151;">Tableaux disponibles</label>
                                        <button type="button"
                                                @click="$store.widgetPicker.openSchemaCreator()"
                                                style="display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(67,97,238,.25);background:rgba(67,97,238,.06);color:#4361ee;border-radius:9px;padding:7px 10px;font-size:11px;font-weight:800;cursor:pointer;">
                                            <iconify-icon icon="solar:add-square-bold-duotone" width="13"></iconify-icon>
                                            Créer un nouveau TD
                                        </button>
                                    </div>
	                                <!-- Schema list -->
                                <style>
                                    .wp-schema-row { display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; align-items: center !important; gap: 10px; padding: 10px 12px; border-radius: 12px; border: 1px solid #f3f4f6; cursor: pointer; transition: all 0.15s; }
                                    .wp-schema-row:hover { border-color: #e5e7eb; }
                                    .wp-schema-row.wp-selected { border-color: rgba(67,97,238,0.25); background: rgba(67,97,238,0.02); }
                                    .wp-schema-row .wp-drag { cursor: grab; color: #d1d5db; display: flex !important; align-items: center; flex-shrink: 0; width: auto !important; }
                                    .wp-schema-row .wp-icon-box { width: 32px; height: 32px; border-radius: 8px; background: rgba(0,171,85,0.08); display: flex !important; align-items: center; justify-content: center; flex-shrink: 0; }
                                    .wp-schema-row .wp-text { flex: 1; min-width: 0; overflow: hidden; }
                                    .wp-schema-row .wp-text .wp-name { font-size: 13px; font-weight: 600; color: #111827; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
                                    .wp-schema-row .wp-text .wp-sub { font-size: 11px; color: #9ca3af; margin-top: 1px; white-space: nowrap; }
                                    .wp-schema-row .wp-select-mark { width: 16px; height: 16px; border: 1.5px solid #9ca3af; background: #fff; color: #fff; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; transition: all .15s; }
                                    .wp-schema-row .wp-select-mark.wp-check { border-radius: 4px; }
                                    .wp-schema-row .wp-select-mark.wp-radio { border-radius: 50%; }
                                    .wp-schema-row.wp-selected .wp-select-mark { border-color: #4361ee; background: #4361ee; }
                                    .wp-schema-row .wp-select-mark iconify-icon { opacity: 0; transition: opacity .1s; }
                                    .wp-schema-row.wp-selected .wp-select-mark iconify-icon { opacity: 1; }
                                    .wp-schema-row .wp-trash { width: 30px; height: 30px; border: 1px solid #fee2e2; border-radius: 9px; background: #fff; color: #ef4444; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; opacity: .62; transition: all .15s; }
                                    .wp-schema-row:hover .wp-trash, .wp-schema-row .wp-trash.wp-confirm { opacity: 1; }
                                    .wp-schema-row .wp-trash.wp-confirm { background: #ef4444; border-color: #ef4444; color: #fff; }
                                    .wp-schema-row .wp-trash:disabled { cursor: wait; opacity: .6; }
                                </style>
                                <div style="display: flex; flex-direction: column; gap: 6px;"
                                     x-ref="schemaSortable"
                                     x-init="$nextTick(() => $store.widgetPicker.initSchemaSortable($refs.schemaSortable))">
                                    <template x-for="s in $store.widgetPicker.gridSchemas" :key="s.id">
                                        <div :data-id="s.id"
                                               class="wp-schema-row"
                                               :class="($store.widgetPicker.newWidget.config.schemaIds || []).includes(s.id) ? 'wp-selected' : ''"
                                               @click="$store.widgetPicker.toggleSchemaSelection(s.id)">
                                            <div class="schema-drag-handle wp-drag">
                                                <iconify-icon icon="tabler:grip-vertical" width="14"></iconify-icon>
                                            </div>
                                            <span class="wp-select-mark"
                                                  :class="$store.widgetPicker.newWidget.config.displayMode === 'panels' ? 'wp-radio' : 'wp-check'">
                                                <iconify-icon icon="solar:check-bold" width="11"></iconify-icon>
                                            </span>
                                            <div class="wp-icon-box">
                                                <iconify-icon icon="solar:notebook-bold-duotone" width="16" style="color: #00ab55;"></iconify-icon>
                                            </div>
                                            <div class="wp-text">
                                                <div class="wp-name" x-text="s.name"></div>
                                                <div class="wp-sub">Direct — <span x-text="s.entityName || 'Entity'"></span></div>
                                            </div>
                                            <button type="button"
                                                    class="wp-trash"
                                                    :class="$store.widgetPicker.pendingSchemaDeleteId === s.id ? 'wp-confirm' : ''"
                                                    :disabled="$store.widgetPicker.deletingSchemaId === s.id"
                                                    :title="$store.widgetPicker.pendingSchemaDeleteId === s.id ? 'Confirmer la suppression' : 'Supprimer ce TD'"
                                                    @click.stop="$store.widgetPicker.deleteLineSchema(s.id, s.name)">
                                                <iconify-icon :icon="$store.widgetPicker.deletingSchemaId === s.id ? 'svg-spinners:ring-resize' : ($store.widgetPicker.pendingSchemaDeleteId === s.id ? 'solar:trash-bin-trash-bold' : 'solar:trash-bin-trash-bold-duotone')" width="15"></iconify-icon>
                                            </button>
                                        </div>
                                    </template>
                                </div>
                                <template x-if="$store.widgetPicker.gridSchemas.length === 0">
                                    <div style="text-align: center; padding: 24px; color: #9ca3af; font-size: 12px;">
                                        <iconify-icon icon="solar:document-text-linear" width="28" style="opacity: 0.3; display: block; margin: 0 auto 6px auto;"></iconify-icon>
                                        Aucun tableau dynamique configuré pour cette entité
                                    </div>
                                </template>
                            </div>

                            <!-- Info box -->
                            <div style="padding: 14px 16px; background: #f0fdf4; border-radius: 12px; border: 1px solid #dcfce7;">
                                <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
                                    <iconify-icon icon="solar:info-circle-bold" width="14" style="color: #00ab55;"></iconify-icon>
                                    <span style="font-size: 12px; font-weight: 700; color: #15803d;">Tableau relationnel</span>
                                </div>
	                                <p style="font-size: 11px; color: #4b5563; margin: 0; line-height: 1.5;">Choisis un tableau existant ou crée un nouveau TD depuis zéro, puis affiche-le seul ou groupé avec onglets.</p>
                            </div>

                            <!-- Options as checkboxes (simple, like image 1) -->
                            <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                    <input type="checkbox" x-model="$store.widgetPicker.newWidget.config.enableAdd" class="form-checkbox" style="accent-color: #22b7e9; width: 16px; height: 16px;">
                                    <span style="font-size: 12px; font-weight: 600; color: #374151;">Permettre l'ajout</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                    <input type="checkbox" x-model="$store.widgetPicker.newWidget.config.enableDocPreview" class="form-checkbox" style="accent-color: #22b7e9; width: 16px; height: 16px;">
                                    <span style="font-size: 12px; font-weight: 600; color: #374151;">Preview Documents</span>
                                </label>
                            </div>
                        </div>
                    </template>

                    <!-- Generic info for simple types -->
                    <template x-if="['tasks','timeline','kpi','chart','fields','cards','separator'].includes($store.widgetPicker.newWidget.type)">
                        <div style="padding: 14px 16px; background: #f0fdf4; border-radius: 12px; border: 1px solid #dcfce7;">
                            <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
                                <iconify-icon icon="solar:info-circle-bold" width="14" style="color: #00ab55;"></iconify-icon>
                                <span style="font-size: 12px; font-weight: 700; color: #15803d;" x-text="$store.widgetPicker.newWidget.label"></span>
                            </div>
                            <p style="font-size: 11px; color: #4b5563; margin: 0; line-height: 1.5;"
                               x-text="$store.widgetPicker.catalogItem($store.widgetPicker.newWidget.type)?.desc || 'Ce widget sera ajouté à votre onglet.'"></p>
                        </div>
                    </template>

                </div>
            </div>

            <!-- Modal Footer -->
            <div style="display: flex; justify-content: center; gap: 10px; padding: 16px 24px; border-top: 1px solid #f3f4f6;">
                <button type="button" @click="$store.widgetPicker.step === 'form' ? $store.widgetPicker.step = 'catalog' : $store.widgetPicker.close()"
                        style="padding: 10px 24px; border-radius: 10px; font-size: 13px; font-weight: 600; border: 1px solid #e5e7eb; background: white; color: #374151; cursor: pointer; transition: all 0.15s;"
                        onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='white'"
                        x-text="$store.widgetPicker.step === 'form' ? 'Annuler' : 'Fermer'">
                </button>
                <template x-if="$store.widgetPicker.step === 'form'">
                    <button type="button" @click="$store.widgetPicker.save()"
                            :disabled="$store.widgetPicker.saving"
                            style="padding: 10px 28px; border-radius: 10px; font-size: 13px; font-weight: 700; border: none; background: #4361ee; color: white; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.15s; box-shadow: 0 4px 12px rgba(67,97,238,0.25);"
                            onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                        <iconify-icon x-show="!$store.widgetPicker.saving" icon="solar:check-circle-bold" width="16"></iconify-icon>
                        <iconify-icon x-show="$store.widgetPicker.saving" icon="svg-spinners:ring-resize" width="16"></iconify-icon>
                        <span x-text="$store.widgetPicker.saving ? 'Création...' : 'Enregistrer'"></span>
                    </button>
                </template>
            </div>

        </div>
    </div>
</template>

<script>
(function() {
    const registerWidgetPicker = () => {
        if (Alpine.store('widgetPicker')) return;
        Alpine.store('widgetPicker', {
            open: false,
            step: 'catalog', // 'catalog' | 'form'
            saving: false,
            target: null, // { type: 'sidebar', entityId } | { type: 'tab', tabKey, rowId, colId }
            newWidget: {
                _id: null, // For edit mode
                _catalogType: '',
                type: '',
                label: '',
                icon: '',
                color: '#4361ee',
                config: {}
            },
            gridSchemas: [], // Passed on init
            accountNumber: '',
            entityId: '',
            entityName: '',
            schemaCreatorRequestId: '',
            _schemaBridgeAttached: false,
            pendingSchemaDeleteId: '',
            deletingSchemaId: '',
            _pendingSchemaDeleteTimer: null,
            deletedSchemaIds: [],
            catalog: [
                { type: 'overview-fields', label: 'Informations', icon: 'solar:card-bold-duotone', color: '#4361ee', desc: 'Champs principaux de la fiche', targets: ['overview'], instant: true },
                { type: 'overview-tasks', label: 'Tâches', icon: 'solar:checklist-minimalistic-bold-duotone', color: '#10b981', desc: 'Tâches liées au record', targets: ['overview'], instant: true },
                { type: 'overview-docs', label: 'Docs', icon: 'solar:document-text-bold-duotone', color: '#f59e0b', desc: 'Documents modèles liés', targets: ['overview'], instant: true },
                { type: 'overview-drive', label: 'Drive', icon: 'solar:cloud-storage-bold-duotone', color: '#ec4899', desc: 'Fichiers récents', targets: ['overview'], instant: true },
                { type: 'overview-agenda', label: 'Agenda', icon: 'solar:calendar-bold-duotone', color: '#14b8a6', desc: '4 prochains événements', targets: ['overview'], instant: true },
                { type: 'overview-important-dates', label: 'Dates importantes', icon: 'solar:calendar-mark-bold-duotone', color: '#f59e0b', desc: 'Échéances et dates clés', targets: ['overview'], instant: true },
                { type: 'overview-notes', label: 'Notes', icon: 'solar:notebook-bold-duotone', color: '#8b5cf6', desc: 'Notes liées au record', targets: ['overview'], instant: true },
                { type: 'home-today-tasks', label: 'Tâches du jour', icon: 'solar:checklist-minimalistic-bold-duotone', color: '#10b981', desc: 'Toutes les tâches à faire aujourd’hui', targets: ['home-overview'], instant: true },
                { type: 'home-stats', label: 'Résumé', icon: 'solar:chart-square-bold-duotone', color: '#6366f1', desc: 'Synthèse globale du compte', targets: ['home-overview'], instant: true },
                { type: 'home-recent-records', label: 'Activité récente', icon: 'solar:history-bold-duotone', color: '#f59e0b', desc: 'Records récemment modifiés', targets: ['home-overview'], instant: true },
                { type: 'home-quick-links', label: 'Raccourcis', icon: 'solar:bolt-circle-bold-duotone', color: '#8b5cf6', desc: 'Accès rapides aux hubs', targets: ['home-overview'], instant: true },
                { type: 'note',    label: 'Note',       icon: 'solar:notes-bold-duotone',         color: '#f59e0b', desc: 'Bloc de texte simple' },
                { type: 'tasks',   label: 'Checklist',  icon: 'solar:checklist-bold-duotone',      color: '#ec4899', desc: 'Gestion de tâches', targets: ['sidebar', 'tab'] },
                { type: 'html',    label: 'HTML',       icon: 'solar:code-bold-duotone',           color: '#f97316', desc: 'Contenu personnalisé' },
                { type: 'iframe',  label: 'Embed',      icon: 'solar:monitor-bold-duotone',        color: '#06b6d4', desc: 'Page web externe' },
                { type: 'video',   label: 'Vidéo',      icon: 'solar:video-library-bold-duotone',  color: '#ef4444', desc: 'Lecteur vidéo ou YouTube' },
                { type: 'link',    label: 'Lien',       icon: 'solar:link-round-bold-duotone',     color: '#3b82f6', desc: 'Accès rapide URL' },
                { type: 'image',   label: 'Image',      icon: 'solar:gallery-bold-duotone',        color: '#10b981', desc: 'Visuel ou logo' },
                { type: 'dynamic-table', label: 'Tableau relationnel', icon: 'solar:list-check-bold-duotone',  color: '#00ab55', desc: 'Single ou multiple' },
                { type: 'separator', label: 'Séparateur', icon: 'solar:minus-circle-bold-duotone', color: '#9ca3af', desc: 'Ligne de division' },
                { type: 'timeline', label: 'Timeline',  icon: 'solar:clock-circle-bold-duotone',   color: '#805dca', desc: 'Fil d\'actualité' },
                { type: 'kpi',      label: 'KPI',       icon: 'solar:graph-up-bold-duotone',       color: '#e7515a', desc: 'Indicateur clé' },
                { type: 'chart',    label: 'Graphique', icon: 'solar:chart-bold-duotone',          color: '#e2a03f', desc: 'Courbes et stats' },
                { type: 'fields',   label: 'Champs',    icon: 'solar:layers-bold-duotone',         color: '#2196f3', desc: 'Vue data synthèse' },
                { type: 'cards',    label: 'Cartes',    icon: 'solar:card-bold-duotone',           color: '#e2a03f', desc: 'Relation records' }
            ],

            visibleCatalog() {
                const targetType = this.target?.type || '';
                return (this.catalog || []).filter(item => {
                    if (targetType === 'home-overview' && item.type === 'dynamic-table') return false;
                    if (!Array.isArray(item.targets) || item.targets.length === 0) return true;
                    return item.targets.includes(targetType);
                });
            },

            catalogItem(type) {
                return (this.catalog || []).find(c => c.type === type) || null;
            },

            initPicker(data = {}) {
                const incoming = Array.isArray(data.gridSchemas) ? data.gridSchemas : [];
                const deletedIds = new Set((this.deletedSchemaIds || []).map(String));
                const merged = new Map();
                [...(this.gridSchemas || []), ...incoming].forEach(schema => {
                    const id = String(schema?.id || schema?._id || '');
                    if (!id || deletedIds.has(id)) return;
                    merged.set(id, { ...schema, id });
                });
                this.gridSchemas = Array.from(merged.values());
                this.accountNumber = data.accountNumber || this.accountNumber || '';
                this.entityId = data.entityId || this.entityId || '';
                this.entityName = data.entityName || this.entityName || '';
                this.ensureSchemaCreateBridge();
            },

            initSchemaSortable(el) {
                if (!el || typeof Sortable === 'undefined') return;
                Sortable.create(el, {
                    animation: 150,
                    handle: '.schema-drag-handle',
                    ghostClass: 'bg-gray-50',
                    onEnd: (evt) => {
                        const newOrderIds = Array.from(el.children).map(child => child.dataset.id);
                        const sorted = newOrderIds.map(id => this.gridSchemas.find(s => s.id === id)).filter(Boolean);
                        this.gridSchemas = sorted;
                    }
                });
            },

            syncSchemaId() {
                const cfg = this.newWidget.config || {};
                cfg.schemaIds = Array.isArray(cfg.schemaIds) ? cfg.schemaIds.map(String).filter(Boolean) : [];
                cfg.schemaId = cfg.schemaIds.length === 1 ? cfg.schemaIds[0] : '';
                this.newWidget.config = cfg;
            },

            setDynamicTableMode(mode) {
                const cfg = this.newWidget.config || {};
                cfg.displayMode = mode;
                cfg.schemaIds = Array.isArray(cfg.schemaIds) ? cfg.schemaIds.map(String).filter(Boolean) : [];
                if (mode === 'panels' && cfg.schemaIds.length > 1) {
                    cfg.schemaIds = [cfg.schemaIds[0]];
                }
                this.newWidget.config = cfg;
                this.syncSchemaId();
                this.pendingSchemaDeleteId = '';
            },

            toggleSchemaSelection(schemaId) {
                const id = String(schemaId || '');
                if (!id) return;
                const cfg = this.newWidget.config || {};
                cfg.schemaIds = Array.isArray(cfg.schemaIds) ? cfg.schemaIds.map(String).filter(Boolean) : [];

                if (cfg.displayMode === 'panels') {
                    cfg.schemaIds = cfg.schemaIds.includes(id) ? [] : [id];
                } else {
                    const idx = cfg.schemaIds.indexOf(id);
                    if (idx >= 0) cfg.schemaIds.splice(idx, 1);
                    else cfg.schemaIds.push(id);
                }

                this.newWidget.config = cfg;
                this.syncSchemaId();
            },

            initOpen(target) {
                this.target = target;
                this.step = 'catalog';
                this.saving = false;
                this.pendingSchemaDeleteId = '';
                this.deletingSchemaId = '';
                this.newWidget = { _id: null, _catalogType: '', type: '', label: '', icon: '', color: '#4361ee', config: {} };
                this.ensureSchemaCreateBridge();
                this.open = true;
                this.forceOverlayState(true);
            },

            openEditWidget(target, widget) {
                this.target = target;
                this.newWidget = {
                    _id: widget._id,
                    _catalogType: '',
                    type: widget.type,
                    label: widget.label,
                    icon: widget.icon,
                    color: widget.color,
                    config: JSON.parse(JSON.stringify(widget.config || {}))
                };
                // Backwards-compat: migrate schemaId → schemaIds for dynamic-table
	                if (widget.type === 'dynamic-table') {
	                    const cfg = this.newWidget.config;
	                    if (!cfg.schemaIds || cfg.schemaIds.length === 0) {
	                        cfg.schemaIds = cfg.schemaId ? [cfg.schemaId] : [];
	                    }
	                    if (!cfg.displayMode) cfg.displayMode = cfg.schemaIds.length > 1 ? 'tabs' : 'tabs';
                        if (cfg.displayMode === 'panels' && cfg.schemaIds.length > 1) cfg.schemaIds = [cfg.schemaIds[0]];
                        this.syncSchemaId();
	                }
                this.step = 'form';
                this.open = true;
                this.saving = false;
            },

            close() {
                this.open = false;
                this.pendingSchemaDeleteId = '';
                this.deletingSchemaId = '';
                this.forceOverlayState(false);
            },

            ensureSchemaCreateBridge() {
                if (this._schemaBridgeAttached) return;
                this._schemaBridgeAttached = true;
                window.addEventListener('dynamic-table-schema-created', (event) => {
                    const detail = event.detail || {};
                    if (!detail.requestId || detail.requestId !== this.schemaCreatorRequestId) return;
                    this.handleCreatedLineSchema(detail.schema);
                });
            },

            handleCreatedLineSchema(schema) {
                if (!schema?._id) return;
                const schemaId = String(schema._id);
                this.deletedSchemaIds = (this.deletedSchemaIds || []).filter(id => String(id) !== schemaId);
                const normalized = {
                    id: schemaId,
                    name: schema.label || schema.name || 'Nouveau TD',
                    entityName: this.target?.entityName || this.entityName || 'Entity'
                };
                this.gridSchemas = [
                    ...this.gridSchemas.filter(s => String(s.id) !== schemaId),
                    normalized
                ];
                const cfg = this.newWidget.config || {};
                cfg.schemaIds = Array.isArray(cfg.schemaIds) ? cfg.schemaIds : [];
                if (!cfg.schemaIds.includes(schemaId)) cfg.schemaIds.push(schemaId);
                if (cfg.displayMode === 'panels' && cfg.schemaIds.length > 1) cfg.schemaIds = [schemaId];
                cfg.schemaId = cfg.schemaIds.length === 1 ? schemaId : '';
                this.newWidget.config = cfg;
                this.schemaCreatorRequestId = '';
                this.step = 'form';
                this.open = true;
                this.forceOverlayState(true);
                window.showMessage && window.showMessage('Nouveau TD créé et sélectionné', 'success');
            },

            openSchemaCreator() {
                const accountNumber = this.target?.accountNumber || this.accountNumber;
                const entityId = this.target?.entityId || this.entityId;
                if (!accountNumber || !entityId) {
                    window.showMessage ? window.showMessage('Contexte entité introuvable pour créer le TD.', 'warning') : alert('Contexte entité introuvable pour créer le TD.');
                    return;
                }
                this.ensureSchemaCreateBridge();
                const requestId = `wp_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
                this.schemaCreatorRequestId = requestId;

                const detail = { accountNumber, entityId, requestId };
                if (window.openDynamicTableCreateModal) {
                    window.openDynamicTableCreateModal(detail);
                    return;
                }

                window.dispatchEvent(new CustomEvent('open-dynamic-table-create-modal', { detail }));
                setTimeout(() => {
                    if (!document.querySelector('[data-dt-create-modal="1"]') && !window.openDynamicTableCreateModal) {
                        window.showMessage ? window.showMessage('Modal de création TD indisponible. Recharge la page puis réessaie.', 'danger') : alert('Modal de création TD indisponible.');
                    }
                }, 350);
            },

            async deleteLineSchema(schemaId, schemaName = '') {
                const id = String(schemaId || '');
                const accountNumber = this.target?.accountNumber || this.accountNumber;
                if (!id || !accountNumber) return;

                if (this.pendingSchemaDeleteId !== id) {
                    this.pendingSchemaDeleteId = id;
                    clearTimeout(this._pendingSchemaDeleteTimer);
                    this._pendingSchemaDeleteTimer = setTimeout(() => {
                        if (this.pendingSchemaDeleteId === id) this.pendingSchemaDeleteId = '';
                    }, 3200);
                    window.showMessage && window.showMessage('Clique encore sur la corbeille pour confirmer la suppression du TD.', 'warning');
                    return;
                }

                this.deletingSchemaId = id;
                clearTimeout(this._pendingSchemaDeleteTimer);
                try {
                    const res = await fetch(`/account/${accountNumber}/api/line-schemas/${id}`, {
                        method: 'DELETE',
                        credentials: 'include'
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok || data.success === false) {
                        throw new Error(data.error || `Erreur HTTP ${res.status}`);
                    }

                    this.gridSchemas = (this.gridSchemas || []).filter(s => String(s.id) !== id);
                    if (!this.deletedSchemaIds.map(String).includes(id)) this.deletedSchemaIds = [...this.deletedSchemaIds, id];
                    const cfg = this.newWidget.config || {};
                    cfg.schemaIds = (Array.isArray(cfg.schemaIds) ? cfg.schemaIds : []).filter(selectedId => String(selectedId) !== id);
                    this.newWidget.config = cfg;
                    this.syncSchemaId();
                    this.pendingSchemaDeleteId = '';
                    window.showMessage && window.showMessage(`TD supprimé${schemaName ? ` : ${schemaName}` : ''}`, 'success');
                } catch (e) {
                    window.showMessage ? window.showMessage('Suppression impossible : ' + (e.message || 'erreur inconnue'), 'danger') : alert('Suppression impossible : ' + (e.message || 'erreur inconnue'));
                } finally {
                    this.deletingSchemaId = '';
                }
            },

            forceOverlayState(open) {
                const apply = () => {
                    document.querySelectorAll('[data-widget-picker-overlay]').forEach(el => {
                        el.style.display = open ? 'flex' : 'none';
                    });
                };
                apply();
                setTimeout(apply, 0);
                setTimeout(apply, 180);
            },

            selectType(type) {
                const w = this.catalogItem(type);
                if (!w) return;
                const actualType = type === 'dynamic-table-single' ? 'dynamic-table' : type;

                const defaults = {
                    'overview-fields': { config: {} },
                    'overview-tasks': { config: {} },
                    'overview-docs': { config: {} },
                    'overview-drive': { config: {} },
                    'overview-agenda': { config: {} },
                    'overview-important-dates': { config: {} },
                    'overview-notes': { config: {} },
                    'home-today-tasks': { config: {} },
                    'home-stats': { config: {} },
                    'home-recent-records': { config: {} },
                    'home-quick-links': { config: {} },
                    'note': { config: { content: '' } },
                    'tasks': { config: { tasks: [] } },
                    'html': { config: { content: '' } },
                    'iframe': { config: { url: '', height: 300 } },
                    'video': { config: { url: '', height: 320 } },
                    'link': { config: { url: '', description: '', newTab: true } },
                    'image': { config: { url: '', alt: '' } },
	                    'dynamic-table': { config: { schemaId: '', schemaIds: [], displayMode: type === 'dynamic-table-single' ? 'panels' : 'tabs', enableAdd: true, enableDocPreview: false } },
                    'timeline': { config: {} },
                    'kpi': { config: {} },
                    'chart': { config: {} },
                    'fields': { config: {} },
                    'cards': { config: {} },
                    'separator': { config: {} }
                };

                const d = defaults[actualType] || { config: {} };
                this.newWidget = {
                    _catalogType: type,
                    type: actualType,
                    label: w.label,
                    icon: w.icon,
                    color: w.color,
                    config: JSON.parse(JSON.stringify(d.config))
                };

                if (w.instant || type === 'separator') {
                    this.save();
                } else {
                    this.step = 'form';
                }
            },

            async save() {
                this.saving = true;

                // Finalize schema order for dynamic-table
                if (this.newWidget.type === 'dynamic-table') {
                    const checkedIds = this.newWidget.config.schemaIds || [];
                    // Follow the visual order from gridSchemas
                    this.newWidget.config.schemaIds = this.gridSchemas
                        .filter(s => checkedIds.includes(s.id))
                        .map(s => s.id);
                    if (this.newWidget.config.displayMode === 'panels' && this.newWidget.config.schemaIds.length > 1) {
                        this.newWidget.config.schemaIds = [this.newWidget.config.schemaIds[0]];
                    }
                    this.syncSchemaId();
                    if (this.newWidget.config.schemaIds.length === 0) {
                        this.saving = false;
                        window.showMessage ? window.showMessage('Choisis ou crée un TD avant d’ajouter ce widget.', 'warning') : alert('Choisis ou crée un TD avant d’ajouter ce widget.');
                        return;
                    }
                }

                try {
                    if (this.newWidget._id) {
                        await this.saveExistingWidget();
                    } else {
                        if (this.target.type === 'sidebar') {
                            await this.saveToSidebar();
                        } else if (this.target.type === 'tab') {
                            await this.saveToTab();
                        } else if (this.target.type === 'overview') {
                            await this.saveToOverview();
                        } else if (this.target.type === 'home-overview') {
                            await this.saveToHomeOverview();
                        }
                    }

                    this.close();

                    // Only reload for sidebar widgets (entity-level config)
                    // Tab widgets are managed by the recordTabs component which handles its own persistence
                    if (this.target.type === 'sidebar') {
                        window.location.reload();
                    }
                } catch (e) {
                    console.error('Widget saving error:', e);
                    window.showMessage ? window.showMessage('Erreur lors de l\'ajout du widget', 'danger') : alert('Erreur lors de l\'ajout du widget');
                } finally {
                    this.saving = false;
                }
            },

	            _expandedWidgetsForSave() {
	                const widget = JSON.parse(JSON.stringify(this.newWidget));
                    delete widget._catalogType;
	                if (
	                    widget.type !== 'dynamic-table' ||
	                    widget._id ||
	                    widget.config?.displayMode !== 'panels' ||
	                    !Array.isArray(widget.config?.schemaIds) ||
	                    widget.config.schemaIds.length <= 1
	                ) {
	                    return [widget];
	                }

	                return widget.config.schemaIds.map(schemaId => {
	                    const schema = this.gridSchemas.find(s => s.id === schemaId);
	                    return {
	                        ...widget,
	                        label: schema?.name || widget.label,
	                        config: {
	                            ...widget.config,
	                            schemaId,
	                            schemaIds: [schemaId],
	                            displayMode: 'single'
	                        }
	                    };
	                });
	            },

	            async saveToSidebar() {
	                const url = `/account/${this.target.accountNumber}/api/entity/${this.target.entityId}/sidebar-widgets`;
	                const widgets = this._expandedWidgetsForSave();
	                for (const widget of widgets) {
	                    const res = await fetch(url, {
	                        method: 'POST',
	                        headers: { 'Content-Type': 'application/json' },
	                        credentials: 'include',
	                        body: JSON.stringify(widget)
	                    });
	                    const data = await res.json();
	                    if (!data.success) throw new Error(data.error);
	                }
	            },

	            async saveToTab() {
	                for (const widget of this._expandedWidgetsForSave()) {
	                    window.dispatchEvent(new CustomEvent('insert-tab-widget', {
	                        detail: {
	                            target: this.target,
	                            widget
	                        }
	                    }));
	                }
	            },

	            async saveToOverview() {
	                for (const widget of this._expandedWidgetsForSave()) {
	                    window.dispatchEvent(new CustomEvent('insert-overview-widget', {
	                        detail: {
	                            target: this.target,
	                            widget
	                        }
	                    }));
	                }
	            },

	            async saveToHomeOverview() {
	                const eventName = this.newWidget._id ? 'update-home-overview-widget' : 'insert-home-overview-widget';
	                for (const widget of this._expandedWidgetsForSave()) {
	                    window.dispatchEvent(new CustomEvent(eventName, {
	                        detail: {
	                            target: this.target,
	                            widget
	                        }
	                    }));
	                }
	            },

            async saveExistingWidget() {
                if (this.target?.type === 'home-overview') {
                    await this.saveToHomeOverview();
                    return;
                }
                console.log('[widgetPicker] saveExistingWidget:', this.newWidget);
                const url = `/account/${this.target.accountNumber}/api/entity/${this.target.entityId}/sidebar-widgets/${this.newWidget._id}`;
                const payload = JSON.parse(JSON.stringify(this.newWidget));
                delete payload._catalogType;
                const res = await fetch(url, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (!data.success) throw new Error(data.error);
            },

            async deleteExistingWidget(target, widgetId) {
                console.log('[widgetPicker] deleteExistingWidget called with:', JSON.stringify(target), widgetId);

                // Double-click safety: first click arms, second click within 3s actually deletes
                if (this._pendingDeleteId !== widgetId) {
                    this._pendingDeleteId = widgetId;
                    clearTimeout(this._pendingDeleteTimer);
                    // Visual feedback: make the button red momentarily
                    const btn = document.querySelector(`[data-widget-delete="${widgetId}"]`);
                    if (btn) {
                        btn.style.background = 'rgba(239, 68, 68, 0.15)';
                        btn.style.color = '#ef4444';
                        btn.title = 'Cliquer encore pour confirmer';
                    }
                    console.log('[widgetPicker] First click - click again within 3s to confirm delete');
                    this._pendingDeleteTimer = setTimeout(() => {
                        this._pendingDeleteId = null;
                        if (btn) {
                            btn.style.background = '';
                            btn.style.color = '';
                            btn.title = '';
                        }
                    }, 3000);
                    return;
                }

                // Second click - actually delete
                this._pendingDeleteId = null;
                clearTimeout(this._pendingDeleteTimer);
                console.log('[widgetPicker] Confirmed! Sending DELETE request...');

                try {
                    const url = `/account/${target.accountNumber}/api/entity/${target.entityId}/sidebar-widgets/${widgetId}`;
                    console.log('[widgetPicker] DELETE URL:', url);
                    const res = await fetch(url, {
                        method: 'DELETE',
                        credentials: 'include'
                    });
                    console.log('[widgetPicker] Response status:', res.status);
                    const data = await res.json();
                    console.log('[widgetPicker] Response data:', JSON.stringify(data));
                    if (data.success) {
                        console.log('[widgetPicker] Success! Reloading page...');
                        window.location.reload();
                    } else {
                        throw new Error(data.error || 'Unknown error');
                    }
                } catch (e) {
                    console.error('[widgetPicker] Delete error:', e);
                    window.showMessage ? window.showMessage('Erreur lors de la suppression: ' + e.message, 'danger') : alert('Erreur lors de la suppression: ' + e.message);
                }
            }
        });
    };

    if (window.Alpine) {
        registerWidgetPicker();
    } else {
        document.addEventListener('alpine:init', registerWidgetPicker);
    }
})();
</script>

<script type="module" src="/dist/dynamicTable.js"></script>

