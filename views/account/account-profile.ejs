<div class="animate__animated p-6" :class="[$store.app.animation]">
    <ul class="flex space-x-2 rtl:space-x-reverse">
        <li>
            <a href="/account/<%= account_number %>/dashboard" class="text-primary hover:underline">Dashboard</a>
        </li>
        <li class="before:content-['/'] ltr:before:mr-1 rtl:before:ml-1">
            <span>Profil</span>
        </li>
    </ul>

    <div class="pt-5">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            <!-- ═══ Left Column: Profile Card ═══ -->
            <div class="space-y-5">
                <!-- Profile Card -->
                <div class="panel">
                    <div class="flex flex-col items-center py-4">
                        <% if (user && user.avatar) { %>
                            <img src="<%= user.avatar %>" alt="avatar" class="mb-4 h-24 w-24 rounded-full object-cover ring-4 ring-primary/20" />
                        <% } else { %>
                            <div class="mb-4 h-24 w-24 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-3xl">
                                <%= user && user.name ? user.name.charAt(0).toUpperCase() : (user && user.email ? user.email.charAt(0).toUpperCase() : 'U') %>
                            </div>
                        <% } %>
                        <h4 class="text-xl font-bold text-black dark:text-white-light">
                            <%= user ? user.name || 'Utilisateur' : 'Utilisateur' %>
                        </h4>
                        <p class="text-sm text-gray-500 mt-1"><%= user ? user.email : '' %></p>
                        <% if (user && user.membership && user.membership.plan) { %>
                            <span class="mt-2 px-3 py-1 rounded-full text-xs font-bold uppercase
                                <%= user.membership.plan === 'premium' ? 'bg-amber-100 text-amber-700' : user.membership.plan === 'enterprise' ? 'bg-purple-100 text-purple-600' : 'bg-blue-100 text-blue-600' %>">
                                <iconify-icon icon="<%= user.membership.plan === 'premium' ? 'solar:crown-bold' : 'solar:star-bold' %>" width="12" class="mr-0.5"></iconify-icon>
                                <%= user.membership.plan %>
                            </span>
                        <% } %>
                    </div>
                    <div class="border-t border-gray-100 dark:border-[#1b2e4b] px-4 py-3">
                        <ul class="space-y-3 text-sm text-gray-500 dark:text-gray-400">
                            <li class="flex items-center gap-3">
                                <iconify-icon icon="solar:letter-bold-duotone" width="18" class="text-primary"></iconify-icon>
                                <span class="truncate"><%= user ? user.email : '' %></span>
                            </li>
                            <% if (user && user.phone) { %>
                            <li class="flex items-center gap-3">
                                <iconify-icon icon="solar:phone-bold-duotone" width="18" class="text-primary"></iconify-icon>
                                <span><%= user.phone %></span>
                            </li>
                            <% } %>
                            <li class="flex items-center gap-3">
                                <iconify-icon icon="solar:calendar-bold-duotone" width="18" class="text-primary"></iconify-icon>
                                <span>Inscrit le <%= user && user.created_on ? new Date(user.created_on).toLocaleDateString('fr-FR', {day:'2-digit', month:'short', year:'numeric'}) : '—' %></span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- ═══ Right Column: Workspaces + Invitations ═══ -->
            <div class="lg:col-span-2 space-y-5">
                <!-- Pending Invitations -->
                <% if (locals.pendingInvitations && pendingInvitations.length > 0) { %>
                <div class="panel border-warning/30">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="p-2.5 bg-warning/10 text-warning rounded-xl">
                            <iconify-icon icon="solar:letter-bold-duotone" width="22"></iconify-icon>
                        </div>
                        <div>
                            <h5 class="text-base font-bold dark:text-white-light">Invitations en attente</h5>
                            <p class="text-xs text-gray-500 mt-0.5"><%= pendingInvitations.length %> invitation<%= pendingInvitations.length > 1 ? 's' : '' %></p>
                        </div>
                    </div>
                    <div class="space-y-2.5">
                        <% for (let inv of pendingInvitations) { %>
                        <div class="flex items-center p-3 rounded-xl border border-warning/20 bg-warning/5 gap-3">
                            <div class="w-10 h-10 rounded-xl bg-warning/10 flex items-center justify-center shrink-0">
                                <iconify-icon icon="<%= inv.accountIcon %>" width="20" class="text-warning"></iconify-icon>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h6 class="font-bold text-sm dark:text-white-light truncate"><%= inv.accountName %></h6>
                                <div class="flex items-center gap-2 mt-0.5">
                                    <span class="text-[11px] text-gray-400 font-mono">#<%= inv.accountNumber %></span>
                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase
                                        <%= inv.role === 'admin' ? 'bg-blue-100 text-blue-600' : inv.role === 'manager' ? 'bg-orange-100 text-orange-600' : 'bg-gray-100 text-gray-500' %>">
                                        <%= inv.role === 'admin' ? 'Admin' : inv.role === 'manager' ? 'Manager' : 'Membre' %>
                                    </span>
                                </div>
                            </div>
                            <div class="flex gap-1.5 shrink-0">
                                <form method="POST" action="/user/invitations/decline" style="margin:0;">
                                    <input type="hidden" name="token" value="<%= inv.token %>" />
                                    <button type="submit" class="w-8 h-8 rounded-lg border border-gray-200 dark:border-[#253b5c] bg-white dark:bg-[#1b2e4b] flex items-center justify-center text-gray-400 hover:text-danger hover:border-danger transition-all" title="Refuser">
                                        <iconify-icon icon="solar:close-circle-bold" width="16"></iconify-icon>
                                    </button>
                                </form>
                                <form method="POST" action="/user/invitations/accept" style="margin:0;">
                                    <input type="hidden" name="token" value="<%= inv.token %>" />
                                    <button type="submit" class="px-3 h-8 rounded-lg bg-success text-white text-xs font-bold flex items-center gap-1 hover:bg-success/90 transition-all">
                                        <iconify-icon icon="solar:check-circle-bold" width="14"></iconify-icon>
                                        Accepter
                                    </button>
                                </form>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% } %>

                <!-- My Workspaces -->
                <div class="panel">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-3">
                            <div class="p-2.5 bg-primary/10 text-primary rounded-xl">
                                <iconify-icon icon="solar:buildings-2-bold-duotone" width="22"></iconify-icon>
                            </div>
                            <div>
                                <h5 class="text-base font-bold dark:text-white-light">Mes espaces de travail</h5>
                                <p class="text-xs text-gray-500 mt-0.5"><%= user && user.accounts ? user.accounts.length : 0 %> espace<%= user && user.accounts && user.accounts.length > 1 ? 's' : '' %></p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2.5">
                        <% if (user && user.accounts && user.accounts.length > 0) { %>
                            <% for (let acc of user.accounts) { %>
                            <div class="group relative" x-data="{ showLeave: false }">
                                <div class="flex items-center p-3.5 rounded-xl border border-white-light dark:border-[#1b2e4b] hover:border-primary/40 bg-white dark:bg-[#1b2e4b] transition-all gap-3">
                                    <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-white font-bold text-sm" style="background:linear-gradient(135deg,#4361ee,#3b82f6);">
                                        <iconify-icon icon="<%= acc.icon || 'solar:home-2-bold-duotone' %>" width="20"></iconify-icon>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <a href="/account/<%= acc.account_number %>/dashboard" class="font-bold text-sm text-black dark:text-white-light hover:text-primary transition-colors truncate block">
                                            <%= acc.name || 'Compte #' + acc.account_number %>
                                        </a>
                                        <div class="flex items-center gap-2 mt-0.5">
                                            <span class="text-[11px] text-gray-400 font-mono">#<%= acc.account_number %></span>
                                            <% 
                                                const roleColors = {
                                                    owner: 'bg-amber-100 text-amber-700',
                                                    admin: 'bg-blue-100 text-blue-600',
                                                    manager: 'bg-orange-100 text-orange-600',
                                                    member: 'bg-gray-100 text-gray-500',
                                                    viewer: 'bg-green-100 text-green-600',
                                                };
                                                const roleLabels = {
                                                    owner: 'Propriétaire',
                                                    admin: 'Admin',
                                                    manager: 'Manager',
                                                    member: 'Membre',
                                                    viewer: 'Observateur',
                                                };
                                                const accRole = acc.role || 'member';
                                            %>
                                            <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase <%= roleColors[accRole] || roleColors.member %>">
                                                <%= roleLabels[accRole] || accRole %>
                                            </span>
                                            <% if (String(acc.account_number) === String(account_number)) { %>
                                                <span class="w-2 h-2 rounded-full bg-success" title="Espace actuel"></span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 shrink-0">
                                        <a href="/account/<%= acc.account_number %>/dashboard" class="text-gray-300 hover:text-primary transition-colors">
                                            <iconify-icon icon="solar:arrow-right-linear" width="18"></iconify-icon>
                                        </a>
                                        <% if (accRole !== 'owner') { %>
                                            <button @click.stop="showLeave = !showLeave"
                                                class="w-7 h-7 rounded-lg border border-gray-200 dark:border-[#253b5c] bg-white dark:bg-[#0e1726] flex items-center justify-center text-gray-300 hover:text-danger hover:border-danger transition-all opacity-0 group-hover:opacity-100"
                                                title="Quitter cet espace">
                                                <iconify-icon icon="solar:logout-2-bold" width="14"></iconify-icon>
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                                <% if (accRole !== 'owner') { %>
                                <!-- Leave confirmation -->
                                <div x-show="showLeave" x-transition @click.outside="showLeave = false"
                                    class="absolute right-0 top-full mt-1 z-10 bg-white dark:bg-[#0e1726] border border-gray-200 dark:border-[#253b5c] rounded-xl p-3.5 shadow-xl w-72">
                                    <p class="text-xs text-gray-600 dark:text-gray-400 mb-3">
                                        Voulez-vous vraiment quitter <strong class="text-gray-800 dark:text-white"><%= acc.name %></strong> ?
                                        Vous perdrez l'accès à cet espace.
                                    </p>
                                    <div class="flex gap-2">
                                        <button @click="showLeave = false" class="flex-1 px-3 py-2 rounded-lg border border-gray-200 dark:border-[#253b5c] text-xs font-semibold text-gray-500 hover:bg-gray-50 dark:hover:bg-[#1b2e4b] transition-colors">Annuler</button>
                                        <form method="POST" action="/user/accounts/leave" style="margin:0;flex:1;">
                                            <input type="hidden" name="accountNumber" value="<%= acc.account_number %>" />
                                            <button type="submit" class="w-full px-3 py-2 rounded-lg bg-danger text-white text-xs font-bold hover:bg-danger/90 transition-all">
                                                <iconify-icon icon="solar:logout-2-bold" width="12" class="mr-1"></iconify-icon>
                                                Quitter
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                <% } %>
                            </div>
                            <% } %>
                        <% } else { %>
                            <div class="text-center py-8">
                                <div class="w-14 h-14 rounded-2xl bg-gray-100 dark:bg-[#1b2e4b] flex items-center justify-center mx-auto mb-3">
                                    <iconify-icon icon="solar:buildings-2-bold-duotone" width="28" class="text-gray-400"></iconify-icon>
                                </div>
                                <p class="text-gray-500 mb-1">Aucun espace de travail</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Informations de l'Entreprise -->
                <div class="panel" x-data="companyForm"
                     data-company-name="<%= account?.company?.name || '' %>"
                     data-company-number="<%= account?.company?.number || '' %>"
                     data-company-address="<%= account?.company?.address || '' %>"
                     data-company-vat="<%= account?.company?.vat || '' %>"
                     data-company-phone="<%= account?.company?.phone || '' %>"
                     data-company-email="<%= account?.company?.email || '' %>"
                     data-company-representative="<%= account?.company?.representative || '' %>">
                    
                    <div class="flex items-center gap-3 mb-5">
                        <div class="p-2.5 bg-secondary/10 text-secondary rounded-xl">
                            <iconify-icon icon="solar:shop-bold-duotone" width="22"></iconify-icon>
                        </div>
                        <div>
                            <h5 class="text-base font-bold dark:text-white-light">Informations de l'Entreprise</h5>
                            <p class="text-xs text-gray-500 mt-0.5">Ces informations seront utilisables comme variables dynamiques dans vos documents (ex: <code>{{company.name}}</code>, <code>{{company.number}}</code>).</p>
                        </div>
                    </div>

                    <form @submit.prevent="saveCompany" class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Nom de l'entreprise</label>
                                <input type="text" x-model="form.name" class="form-input" placeholder="Ex: Ma Société SAS" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Numéro d'entreprise / SIRET</label>
                                <input type="text" x-model="form.number" class="form-input" placeholder="Ex: 123 456 789 00010" />
                            </div>
                            <div class="md:col-span-2">
                                <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Adresse</label>
                                <input type="text" x-model="form.address" class="form-input" placeholder="Ex: 10 Rue de la Paix, 75002 Paris" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Numéro de TVA</label>
                                <input type="text" x-model="form.vat" class="form-input" placeholder="Ex: FR 12 345678901" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Représentant légal / Gérant</label>
                                <input type="text" x-model="form.representative" class="form-input" placeholder="Ex: Jean Dupont" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Téléphone de l'entreprise</label>
                                <input type="text" x-model="form.phone" class="form-input" placeholder="Ex: +33 1 23 45 67 89" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Email de l'entreprise</label>
                                <input type="email" x-model="form.email" class="form-input" placeholder="Ex: contact@masociete.com" />
                            </div>
                        </div>

                        <!-- Notification -->
                        <div x-show="message" x-transition x-cloak class="p-3 rounded-lg text-sm" :class="success ? 'bg-success/10 text-success' : 'bg-danger/10 text-danger'">
                            <span x-text="message"></span>
                        </div>

                        <div class="flex justify-end pt-3">
                            <button type="submit" class="btn btn-primary flex items-center gap-2" :disabled="loading">
                                <iconify-icon x-show="!loading" icon="solar:diskette-bold" width="16"></iconify-icon>
                                <svg x-show="loading" class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span x-text="loading ? 'Enregistrement...' : 'Enregistrer les informations'"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener('alpine:init', () => {
                Alpine.data('companyForm', () => ({
                    loading: false,
                    message: '',
                    success: true,
                    form: {
                        name: '',
                        number: '',
                        address: '',
                        vat: '',
                        phone: '',
                        email: '',
                        representative: ''
                    },
                    init() {
                        this.form.name = this.$el.dataset.companyName || '';
                        this.form.number = this.$el.dataset.companyNumber || '';
                        this.form.address = this.$el.dataset.companyAddress || '';
                        this.form.vat = this.$el.dataset.companyVat || '';
                        this.form.phone = this.$el.dataset.companyPhone || '';
                        this.form.email = this.$el.dataset.companyEmail || '';
                        this.form.representative = this.$el.dataset.companyRepresentative || '';
                    },
                    async saveCompany() {
                        this.loading = true;
                        this.message = '';
                        try {
                            const res = await fetch('/account/<%= account_number %>/profile/company/update', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify(this.form)
                            });
                            const data = await res.json();
                            if (data.success) {
                                this.success = true;
                                this.message = data.message;
                                if (window.showMessage) {
                                    window.showMessage(data.message, 'success');
                                }
                            } else {
                                this.success = false;
                                this.message = data.message || "Une erreur est survenue";
                                if (window.showMessage) {
                                    window.showMessage(this.message, 'error');
                                }
                            }
                        } catch (e) {
                            console.error("Save company error:", e);
                            this.success = false;
                            this.message = "Erreur réseau. Veuillez réessayer.";
                            if (window.showMessage) {
                                window.showMessage(this.message, 'error');
                            }
                        } finally {
                            this.loading = false;
                        }
                    }
                }));
            });
        </script>
    </div>
</div>
