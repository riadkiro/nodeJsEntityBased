<!-- Record Contextual Module Page -->
<%
const _modulesDef = {
  overview: { icon: 'solar:widget-5-bold-duotone', color: '#6366f1', label: 'Overview', desc: "Vue d'ensemble" },
  fiche:  { icon: 'solar:card-bold-duotone', color: '#4361ee', label: 'Fiche', desc: 'Informations et champs encodés' },
  docs:   { icon: 'solar:document-text-bold-duotone', color: '#f59e0b', label: 'Documents', desc: 'Modèles et documents générés' },
  drive:  { icon: 'solar:cloud-storage-bold-duotone', color: '#ec4899', label: 'Drive', desc: 'Fichiers et médias organisés' },
  tasks:  { icon: 'solar:checklist-minimalistic-bold-duotone', color: '#10b981', label: 'Tâches', desc: 'Suivi des actions et rappels' },
  agenda: { icon: 'solar:calendar-bold-duotone', color: '#14b8a6', label: 'Agenda', desc: 'Rendez-vous et événements' },
  chat:   { icon: 'solar:chat-round-dots-bold-duotone', color: '#f97316', label: 'Chat', desc: 'Conversations et échanges' },
  emails: { icon: 'solar:letter-bold-duotone', color: '#0ea5e9', label: 'Emails', desc: 'Correspondance liée' },
  notes:  { icon: 'solar:notebook-bold-duotone', color: '#8b5cf6', label: 'Notes', desc: 'Notes et observations' }
};
const _mod = _modulesDef[moduleName];
const _modColor = _mod.color;
const _ficheFields = (typeof ficheFields !== 'undefined') ? ficheFields : [];
const _recBase = "/account/" + account_number + "/record/" + entity.slug + "/" + record._id;
%>

<style>
.rm-page { max-width:1200px; margin:0 auto; padding:24px 32px; }
.rm-hero {
    display:flex; align-items:center; gap:20px; padding:28px 32px;
    background:linear-gradient(135deg, <%= _modColor %>08, <%= _modColor %>04);
    border:1px solid <%= _modColor %>20; border-radius:16px; margin-bottom:28px;
    position:relative; overflow:hidden;
}
.rm-hero::before {
    content:''; position:absolute; top:-40px; right:-40px; width:160px; height:160px;
    background:radial-gradient(circle, <%= _modColor %>12, transparent 70%);
    border-radius:50%; pointer-events:none;
}
.rm-hero-icon {
    width:56px; height:56px; border-radius:14px; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg, <%= _modColor %>20, <%= _modColor %>10); flex-shrink:0; position:relative; z-index:1;
}
.rm-hero-info { flex:1; z-index:1; }
.rm-hero-info h1 { font-size:20px; font-weight:700; color:#0e1726; margin:0 0 4px; display:flex; align-items:center; gap:8px; }
.rm-hero-info h1 span { font-size:13px; font-weight:500; color:#888da8; }
.rm-hero-info p { font-size:13px; color:#888da8; margin:0; }
.rm-hero-meta { text-align:center; z-index:1; }
.rm-hero-count { font-size:28px; font-weight:800; color:<%= _modColor %>; line-height:1; }
.rm-hero-count-label { font-size:11px; color:#888da8; text-transform:uppercase; letter-spacing:.5px; }
.rm-back { display:inline-flex; align-items:center; gap:6px; font-size:13px; color:#888da8; text-decoration:none; margin-bottom:16px; transition:color .2s; }
.rm-back:hover { color:<%= _modColor %>; }
.rm-toolbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; gap:12px; }
.rm-search { display:flex; align-items:center; gap:8px; padding:8px 14px; background:#f8fafc; border:1px solid #e0e6ed; border-radius:10px; flex:1; max-width:360px; }
.rm-search input { border:none; background:none; outline:none; font-size:13px; color:#0e1726; width:100%; font-family:inherit; }
.rm-search input::placeholder { color:#bfc9d4; }
.rm-btn-primary {
    display:inline-flex; align-items:center; gap:6px; padding:8px 18px;
    background:linear-gradient(135deg, <%= _modColor %>, <%= _modColor %>dd);
    color:#fff; border:none; border-radius:10px; font-size:13px; font-weight:600;
    cursor:pointer; transition:all .2s; font-family:inherit; text-decoration:none;
}
.rm-btn-primary:hover { transform:translateY(-1px); box-shadow:0 4px 12px <%= _modColor %>40; }
.rm-nav { display:flex; gap:4px; margin-bottom:24px; padding:4px; background:#f8fafc; border-radius:12px; border:1px solid #e0e6ed; overflow-x:auto; }
.rm-nav a { display:flex; align-items:center; gap:6px; padding:8px 14px; border-radius:8px; font-size:12px; font-weight:500; color:#888da8; text-decoration:none; transition:all .2s; white-space:nowrap; }
.rm-nav a:hover { background:#fff; color:#0e1726; }
.rm-nav a.active { background:#fff; color:#0e1726; box-shadow:0 1px 3px rgba(0,0,0,.08); font-weight:600; }
.rm-items-list { display:flex; flex-direction:column; gap:2px; }
.rm-item {
    display:flex; align-items:center; gap:14px; padding:14px 16px;
    background:#fff; border-radius:10px; border:1px solid transparent;
    transition:all .25s; cursor:pointer; animation:rmFadeIn .4s ease both;
}
.rm-item:hover { border-color:#e0e6ed; box-shadow:0 2px 8px rgba(0,0,0,.04); transform:translateX(2px); }
.rm-item-icon { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.rm-item-body { flex:1; min-width:0; }
.rm-item-title { font-size:13.5px; font-weight:600; color:#0e1726; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.rm-item-date { font-size:11.5px; color:#888da8; display:flex; align-items:center; gap:4px; margin-top:2px; }
.rm-item-badge { padding:3px 10px; border-radius:6px; font-size:11px; font-weight:600; white-space:nowrap; }
.rm-item-action { width:28px; height:28px; border:none; background:none; border-radius:6px; color:#bfc9d4; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all .2s; }
.rm-item-action:hover { background:#f1f5f9; color:#0e1726; }

/* ═══ Fiche Module Styles ═══ */
.fiche-grid { display:grid; grid-template-columns:repeat(2, 1fr); gap:4px; }
.fiche-field {
    display:flex; align-items:flex-start; gap:12px; padding:16px 18px;
    background:#fff; border-radius:12px; border:1px solid transparent;
    transition:all .3s; position:relative; cursor:default;
    animation:rmFadeIn .4s ease both;
}
.fiche-field:hover {
    border-color:#e0e6ed; background:#fafbfc;
    box-shadow:0 2px 8px rgba(0,0,0,.03);
}
.fiche-field:hover .fiche-edit-hint { opacity:1; transform:translateX(0); }
.fiche-field.full-width { grid-column:1/-1; }
.fiche-field-icon {
    width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg, #4361ee10, #4361ee05); flex-shrink:0; margin-top:1px;
}
.fiche-field-body { flex:1; min-width:0; }
.fiche-field-label {
    font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.6px;
    color:#888da8; margin-bottom:4px; display:flex; align-items:center; gap:4px;
}
.fiche-field-value {
    font-size:14px; font-weight:500; color:#0e1726; line-height:1.5;
    word-break:break-word;
}
.fiche-field-value.empty { color:#bfc9d4; font-style:italic; font-weight:400; }
.fiche-edit-hint {
    position:absolute; top:12px; right:12px;
    display:flex; align-items:center; gap:4px;
    font-size:11px; color:#888da8; opacity:0;
    transition:all .25s; transform:translateX(4px);
    background:linear-gradient(135deg, #4361ee08, #4361ee04);
    padding:4px 10px; border-radius:6px;
}
.fiche-edit-hint iconify-icon { color:#4361ee; }
.fiche-section {
    margin-bottom:8px; padding:12px 0 8px;
    border-bottom:1px solid #f1f5f9;
    display:flex; align-items:center; gap:8px;
}
.fiche-section-title {
    font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:#4361ee;
}
.fiche-section-line { flex:1; height:1px; background:linear-gradient(to right, #4361ee15, transparent); }
.fiche-empty-state {
    grid-column:1/-1; display:flex; flex-direction:column; align-items:center;
    padding:60px 20px; text-align:center;
}
.fiche-empty-state iconify-icon { margin-bottom:12px; }
.fiche-empty-state h3 { font-size:15px; color:#0e1726; margin:0 0 4px; }
.fiche-empty-state p { font-size:13px; color:#888da8; margin:0; }

@keyframes rmFadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
[data-theme="dark"] .rm-hero { background:linear-gradient(135deg, <%= _modColor %>10, <%= _modColor %>05); border-color:<%= _modColor %>30; }
[data-theme="dark"] .rm-hero-info h1 { color:#e0e6ed; }
[data-theme="dark"] .rm-nav { background:#1b2e4b; border-color:#253b5c; }
[data-theme="dark"] .rm-nav a { color:#888da8; }
[data-theme="dark"] .rm-nav a:hover,[data-theme="dark"] .rm-nav a.active { background:#0e1726; color:#e0e6ed; }
[data-theme="dark"] .rm-item,[data-theme="dark"] .fiche-field { background:#0e1726; }
[data-theme="dark"] .rm-item:hover,[data-theme="dark"] .fiche-field:hover { border-color:#253b5c; background:#1b2e4b; }
[data-theme="dark"] .rm-item-title,[data-theme="dark"] .fiche-field-value { color:#e0e6ed; }
[data-theme="dark"] .rm-search { background:#1b2e4b; border-color:#253b5c; }
[data-theme="dark"] .rm-search input { color:#e0e6ed; }
[data-theme="dark"] .fiche-section { border-color:#253b5c; }

@media (max-width:768px) {
    .rm-page { padding:16px; }
    .fiche-grid { grid-template-columns:1fr; }
    .rm-hero { flex-direction:column; text-align:center; padding:20px; }
}
</style>

<div class="rm-page">
    <a href="<%= _recBase %>/edit" class="rm-back">
        <iconify-icon icon="solar:arrow-left-linear" width="16"></iconify-icon>
        Retour à <strong><%= record.title || 'la fiche' %></strong>
    </a>

    <div class="rm-hero">
        <div class="rm-hero-icon">
            <iconify-icon icon="<%= _mod.icon %>" width="28" style="color:<%= _modColor %>"></iconify-icon>
        </div>
        <div class="rm-hero-info">
            <h1><%= _mod.label %> <span>— <%= record.title || 'Sans titre' %></span></h1>
            <p><%= _mod.desc %> pour ce <span style="text-transform:lowercase"><%= entity.name %></span></p>
        </div>
        <div class="rm-hero-meta">
            <div>
                <% if (moduleName === 'overview') { %>
                    <div class="rm-hero-count"><%= _ficheFields.length %></div>
                    <div class="rm-hero-count-label">champs</div>
                <% } else if (moduleName === 'fiche') { %>
                    <div class="rm-hero-count"><%= _ficheFields.length %></div>
                    <div class="rm-hero-count-label">champs</div>
                <% } else { %>
                    <div class="rm-hero-count"><%= _mod.count || 0 %></div>
                    <div class="rm-hero-count-label">éléments</div>
                <% } %>
            </div>
        </div>
    </div>

    <nav class="rm-nav">
        <% const _allMods = [
            { key:'overview', icon:'solar:widget-5-bold-duotone', color:'#6366f1', label:'Overview' },
            { key:'fiche', icon:'solar:card-bold-duotone', color:'#4361ee', label:'Fiche' },
            { key:'docs', icon:'solar:document-text-bold-duotone', color:'#f59e0b', label:'Docs' },
            { key:'drive', icon:'solar:cloud-storage-bold-duotone', color:'#ec4899', label:'Drive' },
            { key:'tasks', icon:'solar:checklist-minimalistic-bold-duotone', color:'#10b981', label:'Tasks' },
            { key:'agenda', icon:'solar:calendar-bold-duotone', color:'#14b8a6', label:'Agenda' },
            { key:'chat', icon:'solar:chat-round-dots-bold-duotone', color:'#f97316', label:'Chat' },
            { key:'emails', icon:'solar:letter-bold-duotone', color:'#0ea5e9', label:'Emails' },
            { key:'notes', icon:'solar:notebook-bold-duotone', color:'#8b5cf6', label:'Notes' }
        ]; %>
        <% _allMods.forEach(function(m) { %>
        <a href="<%= _recBase %>/<%= m.key %>" class="<%= moduleName === m.key ? 'active' : '' %>"
           style="<%= moduleName === m.key ? 'color:' + m.color : '' %>">
            <iconify-icon icon="<%= m.icon %>" width="16" style="color:<%= m.color %>"></iconify-icon>
            <%= m.label %>
        </a>
        <% }); %>
    </nav>


    <!-- ═══ OVERVIEW MODULE ═══ -->
    <% if (moduleName === 'overview') { %>
    <%
        var _ovFields = (typeof overviewFields !== 'undefined' && overviewFields.length > 0) ? overviewFields : _ficheFields.map(function(f){ return Object.assign({}, f, { layoutWidth: 12 }); });
    %>
    <div x-data="ovLayoutBuilder()" :class="layoutMode ? 'ov-dm' : ''">
        <!-- Design mode banner -->
        <div class="ov-dm-banner">
            <iconify-icon icon="tabler:layout-dashboard" width="16"></iconify-icon>
            <span>Mode mise en page activé — Glissez les widgets pour réorganiser</span>
            <button type="button" @click="$store.app.layoutMode = false" style="margin-left:auto;padding:4px 12px;border-radius:6px;border:1px solid rgba(67,97,238,.2);background:#fff;color:#4361ee;font-size:11px;font-weight:600;cursor:pointer;">Terminé</button>
        </div>

        <!-- Dynamic layout rows -->
        <div x-ref="ovRowContainer">
            <template x-for="row in rows" :key="row.id">
                <div class="ov-layout-row" :data-row-id="row.id">
                    <div class="ov-row-drag" title="Déplacer la ligne">⠿</div>
                    <button type="button" class="ov-row-remove" @click="removeRow(row.id)" title="Supprimer la ligne">✕</button>
                    <template x-for="(col, ci) in row.columns" :key="col.id">
                        <div class="ov-layout-col" :style="'width:' + (col.width/12*100) + '%;position:relative;'">
                            <!-- Column toolbar -->
                            <div class="ov-col-toolbar">
                                <button type="button" @click="splitColumn(row.id, col.id)" title="Diviser" x-show="col.width >= 4">⫽</button>
                                <button type="button" @click="removeColumn(row.id, col.id)" title="Supprimer colonne" x-show="row.columns.length > 1" style="color:#ef4444;">✕</button>
                            </div>
                            <!-- Resize handle between columns -->
                            <template x-if="ci < row.columns.length - 1">
                                <div class="ov-resize-handle" @mousedown="$event.preventDefault(); _onResizeStart($event, row.id, ci)"></div>
                            </template>
                            <!-- Widgets in this column -->
                            <div class="ov-col-widgets" :data-col-id="col.id">
                                <template x-for="wid in col.widgetIds" :key="wid">
                                    <div class="ov-widget-wrap" :data-widget-id="wid">
                                        <div class="ov-widget-drag" title="Déplacer">⠿</div>
                                        <button type="button" class="ov-widget-remove" @click="removeWidget(wid)" title="Retirer">✕</button>
                                        <!-- Widget: fields -->
                                        <template x-if="wid === 'fields'">
                                        <div class="ov-card ov-card-fields" x-data="ovInlineEdit()">
                                            <% if (typeof _ovFields !== 'undefined') { %><%- include('partials/ov-widget-fields', { _ovFields: _ovFields, _recBase: _recBase }) %><% } %>
                                        </div>
                                        </template>
                                        <!-- Widget: tasks -->
                                        <template x-if="wid === 'tasks'">
                                        <div class="ov-card ov-card-tasks">
                                            <%- include('partials/ov-widget-tasks', { _recBase: _recBase }) %>
                                        </div>
                                        </template>
                                        <!-- Widget: docs -->
                                        <template x-if="wid === 'docs'">
                                        <div class="ov-card ov-card-docs" x-data="ovSmartDocs()">
                                            <%- include('partials/ov-widget-docs', { _recBase: _recBase }) %>
                                        </div>
                                        </template>
                                        <!-- Widget: drive -->
                                        <template x-if="wid === 'drive'">
                                        <div class="ov-card ov-card-drive">
                                            <%- include('partials/ov-widget-drive', { _recBase: _recBase }) %>
                                        </div>
                                        </template>
                                        <!-- Widget: lines -->
                                        <template x-if="wid === 'lines'">
                                        <div class="ov-card ov-card-lines">
                                            <script type="module" src="/dist/dynamicTable.js"></script>
                                            <div
                                                data-island="dynamic-table"
                                                data-account-number="<%= account_number %>"
                                                data-record-id="<%= record._id %>"
                                                data-entity-id="<%= entity._id %>"
                                                data-schema-filter=""
                                                data-compact="false"
                                            ></div>
                                        </div>
                                        </template>
                                        <!-- Widget: agenda -->
                                        <template x-if="wid === 'agenda'">
                                        <div class="ov-card ov-card-agenda">
                                            <%- include('partials/ov-widget-agenda', { _recBase: _recBase }) %>
                                        </div>
                                        </template>
                                    </div>
                                </template>
                            </div>
                            <!-- Add widget button OUTSIDE sortable container -->
                                <div class="ov-add-widget-btn" style="position:relative;" x-data="{ pickerOpen: false }" @click.outside="pickerOpen = false">
                                    <div @click="pickerOpen = !pickerOpen" style="display:flex;align-items:center;gap:6px;width:100%;justify-content:center;">
                                        <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                                        <span>Widget</span>
                                    </div>
                                    <div class="ov-widget-picker" x-show="pickerOpen" x-cloak>
                                        <template x-for="w in _availableWidgets()" :key="w.id">
                                            <div class="ov-widget-picker-item" @click="addWidget(col.id, w.id); pickerOpen = false">
                                                <iconify-icon :icon="w.icon" width="15" :style="'color:' + w.color"></iconify-icon>
                                                <span x-text="w.label"></span>
                                            </div>
                                        </template>
                                        <div x-show="_availableWidgets().length === 0" style="padding:10px;text-align:center;color:#888da8;font-size:11px;">Tous les widgets sont placés</div>
                                    </div>
                                </div>
                        </div>
                    </template>
                </div>
            </template>
        </div>
        <!-- Add row button -->
        <div class="ov-add-row-btn" @click="addRow()">
            <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
            <span>Ajouter une ligne</span>
        </div>
    </div>

    <style>
    .ov-grid{display:grid;grid-template-columns:8fr 4fr;gap:16px;}
    .ov-full{grid-column:1/-1;}
    .ov-card{background:#fff;border-radius:14px;border:1px solid #e8ecf1;padding:18px;transition:box-shadow .3s;animation:rmFadeIn .4s ease both;overflow:visible;position:relative;}
    .ov-card-fields{z-index:10;}
    .ov-card:hover{box-shadow:0 4px 16px rgba(0,0,0,.04);}
    .ov-card-header{display:flex;align-items:center;gap:8px;margin-bottom:12px;font-size:14px;font-weight:700;color:#0e1726;}
    .ov-card-link{margin-left:auto;font-size:12px;font-weight:500;color:#888da8;text-decoration:none;transition:color .2s;}
    .ov-card-link:hover{color:#4361ee;}
    .ov-right-col{display:flex;flex-direction:column;gap:16px;}
    /* ── Fields list (compact, one per line) ── */
    .ov-fields-list{display:flex;flex-direction:column;gap:0;}
    .ov-ef{display:flex;align-items:flex-start;gap:10px;padding:10px 12px;border-radius:8px;cursor:pointer;transition:background .15s;border:1px solid transparent;position:relative;}
    .ov-ef:hover{background:#f8fafc;border-color:#e8ecf1;}
    .ov-ef + .ov-ef{border-top:1px solid #f1f3f5;}
    .ov-ef:hover + .ov-ef{border-top-color:transparent;}
    .ov-ef-head{display:flex;align-items:center;gap:7px;width:180px;min-width:180px;flex-shrink:0;padding-top:2px;}
    .ov-ef-icon{width:24px;height:24px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .ov-ef-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:#888da8;white-space:nowrap;}
    .ov-ef-body{flex:1;min-width:0;}
    .ov-ef-view{min-height:24px;display:flex;align-items:center;flex-wrap:wrap;gap:5px;}
    .ov-ef-val{font-size:13px;font-weight:500;color:#0e1726;}
    .ov-ef-text{font-size:13px;font-weight:500;color:#0e1726;white-space:pre-wrap;line-height:1.45;}
    .ov-placeholder{font-size:12.5px;color:#bfc9d4;font-weight:400;font-style:italic;}
    /* Tags */
    .ov-tags{display:flex;flex-wrap:wrap;gap:4px;}
    .ov-tag{display:inline-flex;align-items:center;gap:3px;padding:2px 8px;border-radius:5px;font-size:12px;font-weight:600;border:1px solid;line-height:1.4;}
    .ov-tag-x{background:none;border:none;cursor:pointer;font-size:13px;line-height:1;padding:0 0 0 2px;color:inherit;opacity:.6;transition:opacity .15s;}
    .ov-tag-x:hover{opacity:1;}
    /* Multiselect pills */
    .ov-ms-pills{display:flex;flex-wrap:wrap;gap:5px;}
    .ov-ms-pill{display:inline-flex;align-items:center;gap:3px;padding:3px 8px;border-radius:5px;font-size:11.5px;font-weight:600;cursor:pointer;border:1px solid #e2e8f0;background:#fff;color:#888da8;transition:all .2s;user-select:none;}
    .ov-ms-pill.active{background:rgba(67,97,238,.1);border-color:#4361ee;color:#4361ee;}
    .ov-ms-pill:hover{border-color:rgba(67,97,238,.3);background:rgba(67,97,238,.05);color:rgba(67,97,238,.7);}
    .ov-ms-check{width:13px;height:13px;flex-shrink:0;}
    /* Relation editor */
    .ov-rel-editor{position:relative;}
    .ov-rel-tags{display:flex;flex-wrap:wrap;gap:5px;padding:5px 8px;border:1.5px solid #e2e8f0;border-radius:7px;min-height:32px;background:#fff;transition:border-color .2s;cursor:text;align-items:center;}
    .ov-rel-tags:focus-within{border-color:#4361ee;box-shadow:0 0 0 3px rgba(67,97,238,.08);}
    .ov-rel-search{border:none;outline:none;font-size:12.5px;min-width:60px;flex:1;background:transparent;color:#0e1726;font-family:inherit;padding:1px 0;}
    .ov-rel-search::placeholder{color:#bfc9d4;}
    .ov-rel-dropdown{position:absolute;left:0;right:0;top:100%;margin-top:3px;background:#fff;border:1px solid #e2e8f0;border-radius:8px;box-shadow:0 10px 32px rgba(0,0,0,.12);max-height:220px;overflow-y:auto;z-index:9999;}
    .ov-rel-option{display:flex;align-items:center;gap:6px;padding:7px 10px;font-size:12.5px;font-weight:500;color:#0e1726;cursor:pointer;transition:background .12s;}
    .ov-rel-option:hover{background:#f0f3ff;}
    .ov-rel-option:first-child{border-radius:8px 8px 0 0;}
    .ov-rel-option:last-child{border-radius:0 0 8px 8px;}
    .ov-rel-create{display:flex;align-items:center;gap:6px;padding:8px 10px;font-size:12px;font-weight:600;color:#4361ee;cursor:pointer;transition:background .12s;border-top:1px solid #e8ecf1;border-radius:0 0 8px 8px;}
    .ov-rel-create:hover{background:#f0f3ff;}
    .ov-rel-empty{padding:10px 12px;font-size:12px;color:#888da8;text-align:center;}
    /* Edit state */
    .ov-ef-edit{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px;}
    .ov-input{width:100%;padding:6px 10px;border:1.5px solid #e2e8f0;border-radius:7px;font-size:13px;font-family:inherit;color:#0e1726;background:#fff;transition:border-color .2s,box-shadow .2s;outline:none;}
    .ov-input:focus{border-color:#4361ee;box-shadow:0 0 0 3px rgba(67,97,238,.08);}
    .ov-textarea{resize:vertical;min-height:50px;line-height:1.45;}
    .ov-tags-wrap{display:flex;flex-wrap:wrap;gap:5px;padding:5px 8px;border:1.5px solid #e2e8f0;border-radius:7px;min-height:32px;background:#fff;transition:border-color .2s;}
    .ov-tags-wrap:focus-within{border-color:#4361ee;box-shadow:0 0 0 3px rgba(67,97,238,.08);}
    .ov-tag-input{border:none;outline:none;font-size:12.5px;min-width:80px;flex:1;background:transparent;color:#888da8;font-family:inherit;cursor:pointer;}
    .ov-ef-btns{display:flex;gap:3px;justify-content:flex-end;}
    .ov-ef-ok,.ov-ef-cancel{background:none;border:none;cursor:pointer;padding:1px;border-radius:4px;transition:transform .15s;line-height:0;}
    .ov-ef-ok{color:#10b981;}.ov-ef-ok:hover{transform:scale(1.15);}
    .ov-ef-cancel{color:#ef4444;}.ov-ef-cancel:hover{transform:scale(1.15);}
    /* Tasks chart */
    .ov-tasks-chart{padding:8px 0;}
    .ov-chart-bars{display:flex;align-items:flex-end;gap:12px;height:80px;padding:0 8px;}
    .ov-bar{flex:1;height:var(--bar-h);border-radius:6px 6px 0 0;display:flex;align-items:flex-start;justify-content:center;transition:height .6s ease;min-width:0;}
    .ov-bar span{font-size:13px;font-weight:700;color:#fff;padding-top:6px;}
    .ov-chart-labels{display:flex;gap:12px;padding:8px 8px 0;font-size:11px;font-weight:600;}
    .ov-chart-labels span{flex:1;text-align:center;}
    /* Docs */
    .ov-doc-list{display:flex;flex-direction:column;gap:4px;}
    .ov-doc-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;font-size:13px;color:#0e1726;transition:background .2s;}
    .ov-doc-item:hover{background:#f8fafc;}
    .ov-doc-item span{flex:1;font-weight:500;}
    .ov-doc-gen{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border:none;border-radius:6px;background:linear-gradient(135deg,#f59e0b15,#f59e0b08);color:#f59e0b;font-size:11px;font-weight:600;cursor:pointer;transition:all .2s;font-family:inherit;}
    .ov-doc-gen:hover{background:#f59e0b;color:#fff;}
    /* Drive */
    .ov-drive-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
    .ov-drive-file{text-align:center;cursor:pointer;transition:transform .2s;}
    .ov-drive-file:hover{transform:translateY(-2px);}
    .ov-drive-thumb{height:80px;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:8px;}
    .ov-drive-name{font-size:12px;font-weight:600;color:#0e1726;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .ov-drive-meta{font-size:11px;color:#888da8;margin-top:2px;}
    /* ── Dynamic Tables (Lignes) ── */
    .ov-card-lines{overflow:visible;}
    .ov-card-lines .ov-card-header{margin-bottom:0;}
    .ov-lines-tabs{display:flex;align-items:center;gap:0;padding:0 20px;border-bottom:1px solid #f1f3f5;margin-top:8px;}
    .ov-lines-tab{display:inline-flex;align-items:center;gap:7px;padding:10px 16px 12px;border:none;border-bottom:2px solid transparent;background:transparent;color:#888da8;font-size:12.5px;font-weight:600;cursor:pointer;transition:all .2s;white-space:nowrap;font-family:inherit;}
    .ov-lines-tab:hover{color:#0e1726;}
    .ov-lines-tab.active{color:#0e1726;border-bottom-color:#4361ee;}
    .ov-lines-dot{width:7px;height:7px;border-radius:50%;background:#c8cdd6;flex-shrink:0;transition:background .2s;}
    .ov-lines-tab.active .ov-lines-dot{background:#4361ee;}
    .ov-lines-count{font-size:9px;min-width:16px;height:16px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-weight:700;padding:0 4px;background:rgba(0,171,85,.08);color:#00ab55;}
    .ov-lines-table-wrap{padding:0;overflow-x:auto;}
    .ov-lines-table{width:100%;border-collapse:collapse;font-size:13px;}
    .ov-lines-table thead th{padding:10px 20px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#888da8;background:transparent;border-bottom:1px solid #f1f3f5;text-align:left;white-space:nowrap;}
    .ov-lines-table tbody td{padding:12px 20px;border-bottom:1px solid #f8f9fa;color:#0e1726;vertical-align:middle;}
    .ov-lines-table tbody tr:last-child td{border-bottom:none;}
    .ov-lines-table tbody tr{transition:background .15s;}
    .ov-lines-table tbody tr:hover{background:#f8fafc;}
    .ov-lines-primary{font-weight:600;color:#0e1726;}
    .ov-lines-muted{color:#888da8;font-size:12.5px;}
    .ov-lines-pill{display:inline-flex;align-items:center;padding:3px 10px;border-radius:6px;font-size:11.5px;font-weight:600;white-space:nowrap;}
    .ov-lines-footer{display:flex;align-items:center;justify-content:space-between;padding:10px 20px;border-top:1px solid #f1f3f5;}
    .ov-lines-add{font-size:12.5px;font-weight:500;color:#888da8;cursor:pointer;transition:color .2s;}
    .ov-lines-add:hover{color:#4361ee;}
    .ov-lines-meta{font-size:11px;color:#bfc9d4;font-weight:500;}
    /* Dark: Lines */
    [data-theme="dark"] .ov-lines-tabs{border-bottom-color:#1b2e4b;}
    [data-theme="dark"] .ov-lines-tab{color:#506690;}
    [data-theme="dark"] .ov-lines-tab:hover,[data-theme="dark"] .ov-lines-tab.active{color:#e0e6ed;}
    [data-theme="dark"] .ov-lines-tab.active{border-bottom-color:#818cf8;}
    [data-theme="dark"] .ov-lines-dot{background:#506690;}
    [data-theme="dark"] .ov-lines-tab.active .ov-lines-dot{background:#818cf8;}
    [data-theme="dark"] .ov-lines-table thead th{border-bottom-color:#1b2e4b;color:#506690;}
    [data-theme="dark"] .ov-lines-table tbody td{border-bottom-color:#1b2e4b;color:#e0e6ed;}
    [data-theme="dark"] .ov-lines-table tbody tr:hover{background:#1b2e4b;}
    [data-theme="dark"] .ov-lines-primary{color:#e0e6ed;}
    [data-theme="dark"] .ov-lines-muted{color:#506690;}
    [data-theme="dark"] .ov-lines-footer{border-top-color:#1b2e4b;}
    [data-theme="dark"] .ov-lines-add{color:#506690;}
    [data-theme="dark"] .ov-lines-add:hover{color:#818cf8;}
    [data-theme="dark"] .ov-lines-meta{color:#3b4f6f;}
    /* Agenda */
    .ov-agenda-row{display:flex;gap:12px;}
    .ov-agenda-item{flex:1;display:flex;align-items:center;gap:12px;padding:12px;border-radius:10px;border:1px solid #e8ecf1;transition:all .2s;}
    .ov-agenda-item:hover{border-color:#14b8a640;box-shadow:0 2px 8px rgba(0,0,0,.03);}
    .ov-agenda-date-box{width:48px;height:48px;border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;}
    .ov-agenda-day{font-size:18px;font-weight:800;line-height:1;}
    .ov-agenda-month{font-size:10px;font-weight:700;text-transform:uppercase;color:#888da8;letter-spacing:.5px;}
    .ov-agenda-title{font-size:13px;font-weight:600;color:#0e1726;}
    .ov-agenda-time{font-size:11.5px;color:#888da8;margin-top:2px;}
    /* Dark mode */
    [data-theme="dark"] .ov-card{background:#0e1726;border-color:#253b5c;}
    [data-theme="dark"] .ov-card-header,[data-theme="dark"] .ov-ef-val,[data-theme="dark"] .ov-ef-text,[data-theme="dark"] .ov-doc-item,[data-theme="dark"] .ov-drive-name,[data-theme="dark"] .ov-agenda-title{color:#e0e6ed;}
    [data-theme="dark"] .ov-ef:hover{background:#1b2e4b;border-color:#253b5c;}
    [data-theme="dark"] .ov-ef + .ov-ef{border-top-color:#1b2e4b;}
    [data-theme="dark"] .ov-input{background:#0e1726;border-color:#253b5c;color:#e0e6ed;}
    [data-theme="dark"] .ov-tags-wrap{background:#0e1726;border-color:#253b5c;}
    [data-theme="dark"] .ov-ms-pill{background:#0e1726;border-color:#253b5c;color:#888da8;}
    [data-theme="dark"] .ov-ms-pill.active{background:rgba(67,97,238,.15);border-color:#4361ee;color:#4361ee;}
    [data-theme="dark"] .ov-doc-item:hover{background:#1b2e4b;}
    [data-theme="dark"] .ov-agenda-item{border-color:#253b5c;}
    [data-theme="dark"] .ov-placeholder{color:#506690;}
    [data-theme="dark"] .ov-rel-tags{background:#0e1726;border-color:#253b5c;}
    [data-theme="dark"] .ov-rel-search{color:#e0e6ed;}
    [data-theme="dark"] .ov-rel-dropdown{background:#0e1726;border-color:#253b5c;}
    [data-theme="dark"] .ov-rel-option{color:#e0e6ed;}
    [data-theme="dark"] .ov-rel-option:hover{background:#1b2e4b;}
    @media(max-width:768px){.ov-grid{grid-template-columns:1fr;}.ov-drive-grid{grid-template-columns:repeat(2,1fr);}.ov-agenda-row{flex-direction:column;}}
    /* ── Layout Builder Design Mode ── */
    .ov-layout-row{display:flex;gap:16px;margin-bottom:16px;position:relative;}
    .ov-layout-col{position:relative;display:flex;flex-direction:column;gap:16px;min-height:40px;}
    .ov-col-widgets{display:flex;flex-direction:column;gap:16px;min-height:40px;flex:1;}
    .ov-widget-wrap{position:relative;}
    /* Design mode overlays */
    .ov-dm .ov-widget-wrap{border:2px dashed transparent;border-radius:14px;transition:border-color .2s;}
    .ov-dm .ov-widget-wrap:hover{border-color:#4361ee40;}
    .ov-dm .ov-layout-col{border:1px dashed #e2e8f0;border-radius:12px;padding:8px;background:rgba(67,97,238,.01);}
    .ov-widget-drag,.ov-row-drag{display:none;}
    .ov-dm .ov-widget-drag{display:flex;position:absolute;top:6px;left:6px;z-index:20;width:22px;height:22px;align-items:center;justify-content:center;border-radius:6px;background:rgba(67,97,238,.08);color:#4361ee;cursor:grab;opacity:0;transition:opacity .15s;}
    .ov-dm .ov-widget-wrap:hover .ov-widget-drag{opacity:1;}
    .ov-dm .ov-row-drag{display:flex;position:absolute;top:50%;left:-28px;transform:translateY(-50%);width:20px;height:20px;align-items:center;justify-content:center;border-radius:6px;background:rgba(67,97,238,.08);color:#4361ee;cursor:grab;opacity:0;transition:opacity .15s;}
    .ov-dm .ov-layout-row:hover > .ov-row-drag{opacity:1;}
    .ov-row-remove{display:none;}
    .ov-dm .ov-row-remove{display:flex;position:absolute;top:50%;right:-28px;transform:translateY(-50%);width:20px;height:20px;align-items:center;justify-content:center;border-radius:50%;background:rgba(239,68,68,.08);color:#ef4444;cursor:pointer;opacity:0;transition:opacity .15s;border:none;font-size:11px;}
    .ov-dm .ov-layout-row:hover > .ov-row-remove{opacity:1;}
    .ov-dm .ov-row-remove:hover{background:rgba(239,68,68,.15);}
    .ov-widget-remove{display:none;}
    .ov-dm .ov-widget-remove{display:flex;position:absolute;top:6px;right:6px;z-index:20;width:20px;height:20px;align-items:center;justify-content:center;border-radius:50%;background:rgba(239,68,68,.08);color:#ef4444;cursor:pointer;opacity:0;transition:opacity .15s;border:none;font-size:12px;}
    .ov-dm .ov-widget-wrap:hover .ov-widget-remove{opacity:1;}
    .ov-resize-handle{display:none;}
    .ov-dm .ov-resize-handle{display:block;position:absolute;top:0;right:-10px;width:20px;height:100%;cursor:col-resize;z-index:30;}
    .ov-dm .ov-resize-handle::after{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:4px;height:32px;border-radius:2px;background:#4361ee40;transition:background .15s;}
    .ov-dm .ov-resize-handle:hover::after{background:#4361ee;}
    .ov-sort-ghost{opacity:.15;border:2px dashed #4361ee !important;border-radius:12px;background:rgba(67,97,238,.04) !important;}
    .ov-add-widget-btn{display:none;}
    .ov-dm .ov-add-widget-btn{display:flex;align-items:center;justify-content:center;gap:6px;padding:10px;border:2px dashed #e2e8f0;border-radius:10px;color:#888da8;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;background:transparent;}
    .ov-dm .ov-add-widget-btn:hover{border-color:#4361ee;color:#4361ee;background:rgba(67,97,238,.03);}
    .ov-add-row-btn{display:none;}
    .ov-dm .ov-add-row-btn{display:flex;align-items:center;justify-content:center;gap:6px;padding:12px;border:2px dashed #e2e8f0;border-radius:12px;color:#888da8;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;margin-top:4px;}
    .ov-dm .ov-add-row-btn:hover{border-color:#4361ee;color:#4361ee;background:rgba(67,97,238,.03);}
    .ov-col-toolbar{display:none;}
    .ov-dm .ov-col-toolbar{display:flex;gap:4px;position:absolute;top:-8px;right:8px;z-index:25;}
    .ov-dm .ov-col-toolbar button{width:18px;height:18px;border-radius:4px;border:1px solid #e2e8f0;background:#fff;color:#888da8;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:10px;transition:all .15s;}
    .ov-dm .ov-col-toolbar button:hover{border-color:#4361ee;color:#4361ee;background:rgba(67,97,238,.05);}
    .ov-widget-picker{position:absolute;top:100%;left:0;right:0;margin-top:4px;background:#fff;border:1px solid #e2e8f0;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.1);z-index:100;padding:6px;max-height:200px;overflow-y:auto;}
    .ov-widget-picker-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;font-size:12px;font-weight:500;color:#0e1726;cursor:pointer;transition:background .15s;}
    .ov-widget-picker-item:hover{background:#f0f3ff;}
    .ov-dm-banner{display:none;}
    .ov-dm .ov-dm-banner{display:flex;align-items:center;gap:10px;padding:10px 16px;background:linear-gradient(135deg,rgba(67,97,238,.06),rgba(67,97,238,.02));border:1px solid rgba(67,97,238,.15);border-radius:12px;margin-bottom:16px;font-size:12px;color:#4361ee;font-weight:600;}
    </style>

    <script>
    document.addEventListener('alpine:init', () => {
        const _baseUrl = window.location.pathname.replace(/\/overview$/, '');
        const _recUrl = '/account/<%= account_number %>/record/<%= entity.slug %>/<%= record._id %>';

        Alpine.data('ovInlineEdit', () => ({
            editingKey: '',
            saving: false,
            startEdit(key, e) {
                if (this.editingKey === key) return;
                // If another field was being edited, auto-save it first
                if (this.editingKey) this._doSave(this.editingKey);
                this.editingKey = key;
                this.$nextTick(() => {
                    const ref = this.$refs['input_' + key];
                    if (ref) ref.focus();
                });
            },
            cancelEdit() { this.editingKey = ''; },
            // Called by @click.outside on each ov-ef
            autoSave(key) {
                if (this.editingKey !== key) return;
                this._doSave(key);
            },
            saveCurrentField() {
                if (!this.editingKey) return;
                this._doSave(this.editingKey);
            },
            _doSave(key) {
                const ref = this.$refs['input_' + key];
                if (!ref) { this.editingKey = ''; return; }
                // For multiselect pills, get the selected array from the inner x-data
                if (ref.hasAttribute && ref.hasAttribute('x-data') && ref._x_dataStack) {
                    const inner = ref._x_dataStack[0];
                    if (inner && inner.selected) {
                        this.saveField(key, inner.selected);
                        return;
                    }
                }
                this.saveField(key, ref.value);
            },
            async saveField(key, value) {
                if (this.saving) return;
                this.saving = true;
                const editingK = key;
                try {
                    const res = await fetch(_recUrl + '/update-field', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ fieldKey: key, value })
                    });
                    if (res.ok) {
                        // Update DOM in place
                        const fieldEl = document.querySelector('.ov-ef[data-key="' + editingK + '"]');
                        if (fieldEl) {
                            const viewEl = fieldEl.querySelector('.ov-ef-view');
                            if (viewEl) {
                                const displayVal = Array.isArray(value) ? value.join(', ') : (value || '');
                                if (displayVal) {
                                    viewEl.innerHTML = '<span class="ov-ef-val">' + displayVal.replace(/</g,'&lt;') + '</span>';
                                } else {
                                    viewEl.innerHTML = '<span class="ov-placeholder">' + (fieldEl.querySelector('.ov-ef-label')?.textContent || 'Valeur') + '</span>';
                                }
                            }
                        }
                        this.editingKey = '';
                    }
                } catch (e) { console.error('[OV save]', e); }
                this.saving = false;
            }
        }));

        // Relation editor sub-component
        Alpine.data('ovRelEditor', (cfg) => ({
            key: cfg.key,
            targetEntityId: cfg.targetEntityId,
            targetEntitySlug: cfg.targetEntitySlug || '',
            isMulti: cfg.isMulti,
            color: cfg.color || '#4361ee',
            tags: [...(cfg.initial || [])],
            searchQ: '',
            results: [],
            showDropdown: false,
            dirty: false,
            init() {
                this.$nextTick(() => {
                    const inp = this.$refs.relSearchInput;
                    if (inp) inp.focus();
                });
            },
            async search() {
                if (!this.targetEntityId) return;
                const q = this.searchQ.trim();
                try {
                    const url = '/account/<%= account_number %>/record/api/search?entityId=' + this.targetEntityId + '&q=' + encodeURIComponent(q) + '&limit=8';
                    const res = await fetch(url, { credentials: 'include' });
                    const data = await res.json();
                    // Exclude already-selected tags
                    const tagIds = this.tags.map(t => t._id);
                    this.results = (data.data || []).filter(r => !tagIds.includes(r.id)).map(r => ({
                        _id: r.id,
                        title: r.label || 'Sans titre'
                    }));
                    this.showDropdown = true;
                } catch (e) { console.error('[RelSearch]', e); }
            },
            async addTag(record) {
                if (!this.isMulti) this.tags = [];
                this.tags.push({ _id: record._id, title: record.title });
                this.searchQ = '';
                this.results = [];
                this.showDropdown = false;
                this.dirty = true;
                // Persist immediately - use 'set' for single-value, 'add' for multi
                if (this.isMulti) {
                    await this._persist('add', record._id);
                } else {
                    await this._persistSet([record._id]);
                    this.closeAndSave();
                }
            },
            async removeTag(id) {
                this.tags = this.tags.filter(t => t._id !== id);
                this.dirty = true;
                await this._persist('remove', id);
            },
            async _persist(action, targetId) {
                try {
                    await fetch(_recUrl + '/update-relation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ relationKey: this.key, action, targetId })
                    });
                } catch (e) { console.error('[RelPersist]', e); }
            },
            async _persistSet(ids) {
                try {
                    await fetch(_recUrl + '/update-relation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ relationKey: this.key, action: 'set', targetIds: ids })
                    });
                } catch (e) { console.error('[RelPersist]', e); }
            },
            async createNew() {
                const title = this.searchQ.trim();
                if (!title || !this.targetEntityId) return;
                try {
                    const res = await fetch('/account/<%= account_number %>/record/api/quick-create', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ entityId: this.targetEntityId, title })
                    });
                    const data = await res.json();
                    if (data.success && data.record) {
                        // Add the newly created record as a tag
                        await this.addTag({ _id: data.record._id, title: data.record.title });
                    }
                } catch (e) { console.error('[QuickCreate]', e); }
            },
            closeAndSave() {
                this.results = [];
                this.searchQ = '';
                this.showDropdown = false;
                // Update the view-state DOM
                const parent = this.$el.closest('.ov-ef');
                if (parent) {
                    const viewEl = parent.querySelector('.ov-ef-view');
                    if (viewEl) {
                        if (this.tags.length > 0) {
                            viewEl.innerHTML = '<div class="ov-tags">' + this.tags.map(t =>
                                '<span class="ov-tag" style="background:' + this.color + '10;border-color:' + this.color + '30;color:' + this.color + '">' + t.title.replace(/</g,'&lt;') + '</span>'
                            ).join('') + '</div>';
                        } else {
                            viewEl.innerHTML = '<span class="ov-placeholder">Sélectionner...</span>';
                        }
                    }
                }
                // Close by setting parent editingKey
                const grid = this.$el.closest('[x-data]');
                if (grid && grid._x_dataStack) {
                    const root = grid._x_dataStack.find(d => d.editingKey !== undefined);
                    if (root) root.editingKey = '';
                }
            }
        }));

        // ═══ Overview SmartDocs Component ═══
        Alpine.data('ovSmartDocs', () => ({
            templates: [],
            loading: true,
            generatingId: null,
            showPreview: false,
            previewName: '',
            draftDocId: null,
            finalizing: false,
            finalized: false,
            downloadUrl: '',
            _accountNumber: '<%= account_number %>',
            _entityId: '<%= entity._id %>',
            _recordId: '<%= record._id %>',

            init() {
                this.loadTemplates();
                // Listen for cancel from iframe
                window.addEventListener('message', (e) => {
                    if (e.data && e.data.type === 'smartdoc-cancel') {
                        this.cancelPreview();
                    }
                });
            },

            async loadTemplates() {
                this.loading = true;
                try {
                    const url = `/account/${this._accountNumber}/api/smartdoc/templates/${this._entityId}?recordId=${this._recordId}`;
                    const res = await fetch(url, { credentials: 'include' });
                    const data = await res.json();
                    if (data.success && data.templates) {
                        this.templates = data.templates;
                    }
                } catch (e) {
                    console.error('[OvSmartDocs] Load error:', e);
                }
                this.loading = false;
            },

            async generateDoc(tpl) {
                this.generatingId = tpl._id;
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/smartdoc/generate-draft/${tpl._id}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ recordId: this._recordId, inputs: {} })
                    });
                    const data = await res.json();
                    if (data.success && data.draftDocumentId) {
                        this.draftDocId = data.draftDocumentId;
                        this.previewName = data.outputName || tpl.name || 'Document';
                        this.showPreview = true;
                        this.$nextTick(() => {
                            const iframe = document.getElementById('ov-smartdoc-preview-iframe');
                            if (iframe) {
                                iframe.src = `/account/${this._accountNumber}/documents/${data.draftDocumentId}/edit-react?minimal=true`;
                            }
                        });
                    } else {
                        alert(data.error || 'Erreur lors de la génération');
                    }
                } catch (e) {
                    console.error('[OvSmartDocs] Generate error:', e);
                    alert('Erreur de connexion');
                }
                this.generatingId = null;
            },

            async finalizePreview() {
                if (!this.draftDocId || this.finalizing) return;
                this.finalizing = true;
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/smartdoc/finalize-draft/${this.draftDocId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ recordId: this._recordId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        // Switch to finalized state — show Télécharger + Fermer
                        this.downloadUrl = data.attachment?.url || '';
                        this.finalized = true;
                        this.draftDocId = null;
                        if (window.showMessage) {
                            window.showMessage('Document généré avec succès !', 'success');
                        }
                    } else {
                        alert(data.error || 'Erreur de finalisation');
                    }
                } catch (e) {
                    console.error('[OvSmartDocs] Finalize error:', e);
                    alert('Erreur de connexion');
                }
                this.finalizing = false;
            },

            closePreview() {
                this.showPreview = false;
                this.finalized = false;
                this.downloadUrl = '';
                this.draftDocId = null;
                this.previewName = '';
                const iframe = document.getElementById('ov-smartdoc-preview-iframe');
                if (iframe) iframe.src = '';
                // Reload to show the newly attached file
                window.location.reload();
            },

            async cancelPreview() {
                // Delete the draft
                if (this.draftDocId) {
                    try {
                        await fetch(`/account/${this._accountNumber}/api/smartdoc/draft/${this.draftDocId}`, {
                            method: 'DELETE',
                            credentials: 'include'
                        });
                    } catch (e) { /* ignore */ }
                }
                this.showPreview = false;
                this.draftDocId = null;
                this.previewName = '';
                this.finalized = false;
                this.downloadUrl = '';
                // Clear iframe
                const iframe = document.getElementById('ov-smartdoc-preview-iframe');
                if (iframe) iframe.src = 'about:blank';
            }
        }));

        // ═══ Overview Layout Builder ═══
        Alpine.data('ovLayoutBuilder', () => ({
            layoutMode: false,
            rows: [],
            _defaultRows: [
                { id: 'r1', columns: [{ id: 'c1', width: 8, widgetIds: ['fields'] }, { id: 'c2', width: 4, widgetIds: ['tasks','docs'] }] },
                { id: 'r2', columns: [{ id: 'c3', width: 12, widgetIds: ['drive'] }] },
                { id: 'r3', columns: [{ id: 'c4', width: 12, widgetIds: ['lines'] }] },
                { id: 'r4', columns: [{ id: 'c5', width: 12, widgetIds: ['agenda'] }] }
            ],
            _accountNumber: '<%= account_number %>',
            _entityId: '<%= entity._id %>',
            _viewId: 'overview_<%= entity._id %>',
            _sortables: [],
            _resizing: null,

            _sortableTimer: null,
            _observer: null,
            _sortableIniting: false,
            _isDragging: false,

            init() {
                this.rows = JSON.parse(JSON.stringify(this._defaultRows));
                this._loadLayout();
                this.$watch('$store.app.layoutMode', (v) => {
                    this.layoutMode = v;
                    if (v) {
                        this.$nextTick(() => this._startObserver());
                    } else {
                        this._stopObserver();
                        this._destroySortables();
                    }
                });
                this.layoutMode = this.$store.app.layoutMode;
                if (this.layoutMode) {
                    this.$nextTick(() => this._startObserver());
                }
                window.addEventListener('mousemove', (e) => this._onResizeMove(e));
                window.addEventListener('mouseup', () => this._onResizeEnd());
            },

            // MutationObserver watches for Alpine x-for DOM changes and re-inits Sortables
            _startObserver() {
                this._stopObserver();
                this._scheduleSortableInit();
                const container = this.$refs.ovRowContainer;
                if (!container) return;
                this._observer = new MutationObserver(() => {
                    if (!this._sortableIniting && !this._isDragging) this._scheduleSortableInit();
                });
                this._observer.observe(container, { childList: true, subtree: true });
            },

            _stopObserver() {
                if (this._observer) { this._observer.disconnect(); this._observer = null; }
                if (this._sortableTimer) { clearTimeout(this._sortableTimer); this._sortableTimer = null; }
            },

            _scheduleSortableInit() {
                if (this._sortableTimer) clearTimeout(this._sortableTimer);
                this._sortableTimer = setTimeout(() => { this._initSortables(); }, 80);
            },

            async _loadLayout() {
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/user/view-preferences/${this._viewId}`, { credentials: 'include' });
                    const data = await res.json();
                    if (data.success && data.preferences && data.preferences.rows) {
                        this.rows = data.preferences.rows;
                    }
                } catch (e) { /* use defaults */ }
            },

            async _saveLayout() {
                try {
                    await fetch(`/account/${this._accountNumber}/api/user/view-preferences`, {
                        method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
                        body: JSON.stringify({ viewId: this._viewId, preferences: { rows: this.rows } })
                    });
                } catch (e) { console.error('[OvLayout] save error', e); }
            },

            _initSortables() {
                this._sortableIniting = true;
                this._destroySortables();
                if (typeof Sortable === 'undefined') { this._sortableIniting = false; return; }
                const self = this;

                // ── Row reorder ──
                const rowContainer = this.$refs.ovRowContainer;
                if (rowContainer) {
                    this._sortables.push(new Sortable(rowContainer, {
                        animation: 150,
                        handle: '.ov-row-drag',
                        ghostClass: 'ov-sort-ghost',
                        draggable: '.ov-layout-row',
                        onStart() { self._isDragging = true; },
                        onEnd(evt) {
                            self._isDragging = false;
                            const rowId = evt.item.dataset.rowId;
                            const oldIdx = evt.oldIndex;
                            const newIdx = evt.newIndex;
                            if (oldIdx === newIdx) return;

                            // Revert DOM — put item back where it was
                            evt.from.removeChild(evt.item);
                            const rows = evt.from.querySelectorAll(':scope > .ov-layout-row');
                            if (oldIdx >= rows.length) {
                                evt.from.appendChild(evt.item);
                            } else {
                                evt.from.insertBefore(evt.item, rows[oldIdx]);
                            }

                            // Update Alpine data
                            const idx = self.rows.findIndex(r => r.id === rowId);
                            if (idx === -1) return;
                            const [moved] = self.rows.splice(idx, 1);
                            self.rows.splice(newIdx, 0, moved);
                            self._saveLayout();
                        }
                    }));
                }

                // ── Widget drag across columns ──
                this.$el.querySelectorAll('.ov-col-widgets').forEach(colEl => {
                    this._sortables.push(new Sortable(colEl, {
                        animation: 150,
                        handle: '.ov-widget-drag',
                        ghostClass: 'ov-sort-ghost',
                        draggable: '.ov-widget-wrap',
                        group: 'ov-widgets',
                        swapThreshold: 0.65,
                        // filter out non-draggable children
                        filter: '.ov-add-widget-btn',
                        onStart() { self._isDragging = true; },
                        onEnd(evt) {
                            self._isDragging = false;
                            const widgetId = evt.item.dataset.widgetId;
                            const fromColId = evt.from.dataset.colId;
                            const toColId = evt.to.dataset.colId;
                            if (!widgetId || !fromColId) return;

                            // Compute real newIndex by counting only .ov-widget-wrap before evt.item in evt.to
                            const toWidgets = Array.from(evt.to.querySelectorAll(':scope > .ov-widget-wrap'));
                            let newIdx = toWidgets.indexOf(evt.item);
                            if (newIdx === -1) newIdx = toWidgets.length;

                            // ── REVERT Sortable's DOM move ──
                            // Always remove the item from wherever Sortable put it
                            if (evt.item.parentNode) evt.item.parentNode.removeChild(evt.item);
                            // Put it back in the source container at its original position
                            const fromWidgets = Array.from(evt.from.querySelectorAll(':scope > .ov-widget-wrap'));
                            if (evt.oldIndex >= fromWidgets.length) {
                                evt.from.appendChild(evt.item);
                            } else {
                                evt.from.insertBefore(evt.item, fromWidgets[evt.oldIndex] || null);
                            }

                            // ── Update Alpine data by ID ──
                            let fromCol = null, toCol = null;
                            self.rows.forEach(r => r.columns.forEach(c => {
                                if (c.id === fromColId) fromCol = c;
                                if (c.id === toColId) toCol = c;
                            }));
                            if (!fromCol) return;

                            const fi = fromCol.widgetIds.findIndex(w => w === widgetId);
                            if (fi === -1) return;
                            fromCol.widgetIds.splice(fi, 1);

                            if (toCol) {
                                toCol.widgetIds.splice(newIdx, 0, widgetId);
                            }
                            self._saveLayout();
                        }
                    }));
                });
                this._sortableIniting = false;
            },

            _destroySortables() {
                this._sortables.forEach(s => { try { s.destroy(); } catch(e) {} });
                this._sortables = [];
            },

            _reinitSortables() {
                this._scheduleSortableInit();
            },

            addRow() {
                const id = 'r_' + Date.now();
                const colId = 'c_' + Date.now();
                this.rows.push({ id, columns: [{ id: colId, width: 12, widgetIds: [] }] });
                this._saveLayout();
            },

            removeRow(rowId) {
                this.rows = this.rows.filter(r => r.id !== rowId);
                this._saveLayout();
            },

            splitColumn(rowId, colId) {
                const row = this.rows.find(r => r.id === rowId);
                if (!row) return;
                const ci = row.columns.findIndex(c => c.id === colId);
                if (ci === -1) return;
                const col = row.columns[ci];
                if (col.width < 4) return;
                const half = Math.floor(col.width / 2);
                col.width = col.width - half;
                row.columns.splice(ci + 1, 0, { id: 'c_' + Date.now(), width: half, widgetIds: [] });
                this._saveLayout();
            },

            removeColumn(rowId, colId) {
                const row = this.rows.find(r => r.id === rowId);
                if (!row || row.columns.length <= 1) return;
                const ci = row.columns.findIndex(c => c.id === colId);
                if (ci === -1) return;
                const removed = row.columns.splice(ci, 1)[0];
                // Give width back to neighbor
                const neighbor = row.columns[Math.min(ci, row.columns.length - 1)];
                if (neighbor) neighbor.width = Math.min(12, neighbor.width + removed.width);
                this._saveLayout();
            },

            _onResizeStart(e, rowId, colIndex) {
                e.preventDefault();
                this._resizing = { rowId, colIndex, startX: e.clientX };
                document.body.style.cursor = 'col-resize';
                document.body.style.userSelect = 'none';
            },

            _onResizeMove(e) {
                if (!this._resizing) return;
                const row = this.rows.find(r => r.id === this._resizing.rowId);
                if (!row) return;
                const ci = this._resizing.colIndex;
                const col = row.columns[ci], next = row.columns[ci + 1];
                if (!col || !next) return;
                const rowEl = this.$el.querySelector(`[data-row-id="${this._resizing.rowId}"]`);
                if (!rowEl) return;
                const totalW = rowEl.offsetWidth;
                const unitW = totalW / 12;
                const dx = e.clientX - this._resizing.startX;
                const deltaUnits = Math.round(dx / unitW);
                if (deltaUnits === 0) return;
                const newW = col.width + deltaUnits;
                const newNextW = next.width - deltaUnits;
                if (newW >= 2 && newNextW >= 2) {
                    col.width = newW;
                    next.width = newNextW;
                    this._resizing.startX = e.clientX;
                }
            },

            _onResizeEnd() {
                if (!this._resizing) return;
                this._resizing = null;
                document.body.style.cursor = '';
                document.body.style.userSelect = '';
                this._saveLayout();
            },

            // Get all widget IDs currently placed
            _placedWidgets() {
                const ids = [];
                this.rows.forEach(r => r.columns.forEach(c => ids.push(...(c.widgetIds || []))));
                return ids;
            },

            // Available widgets not yet placed
            _availableWidgets() {
                const all = [
                    { id: 'fields', label: 'Informations clés', icon: 'solar:card-bold-duotone', color: '#4361ee' },
                    { id: 'tasks', label: 'Tâches', icon: 'solar:checklist-minimalistic-bold-duotone', color: '#10b981' },
                    { id: 'docs', label: 'Documents', icon: 'solar:document-text-bold-duotone', color: '#f59e0b' },
                    { id: 'drive', label: 'Fichiers récents', icon: 'solar:cloud-storage-bold-duotone', color: '#ec4899' },
                    { id: 'lines', label: 'Traitement', icon: 'solar:document-text-bold-duotone', color: '#6366f1' },
                    { id: 'agenda', label: 'Rendez-vous', icon: 'solar:calendar-bold-duotone', color: '#14b8a6' },
                    { id: 'notes', label: 'Notes', icon: 'solar:notebook-bold-duotone', color: '#8b5cf6' }
                ];
                const placed = this._placedWidgets();
                return all.filter(w => !placed.includes(w.id));
            },

            addWidget(colId, widgetId) {
                this.rows.forEach(r => r.columns.forEach(c => {
                    if (c.id === colId) c.widgetIds.push(widgetId);
                }));
                this._saveLayout();
            },

            removeWidget(widgetId) {
                this.rows.forEach(r => r.columns.forEach(c => {
                    c.widgetIds = (c.widgetIds || []).filter(w => w !== widgetId);
                }));
                this._saveLayout();
            },

            isWidgetVisible(widgetId) {
                return this._placedWidgets().includes(widgetId);
            }
        }));
    });
    </script>
    <% } %>

