	        async saveOptions(kind, options, metaPayload = {}) {
	            const meta = this.optionMeta(kind);
	            const cleaned = this.normalizeOptions(options, this.defaults[meta.payload]);
		            const previous = this[meta.optionsKey] || [];
		            this[meta.optionsKey] = cleaned;
		            if (kind !== 'priority' && !this.task?.taskListId) return cleaned;
		            try {
	                const endpoint = kind === 'priority'
	                    ? API + '/api/task-priorities'
	                    : API + '/api/task-lists/' + this.task.taskListId + '/' + meta.endpoint;
                const res = await fetch(endpoint, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ [meta.payload]: cleaned, ...metaPayload })
                });
	                const data = await res.json().catch(() => ({}));
	                if (!res.ok || data.success === false) throw new Error(data.error || 'Options non enregistrées');
	                this[meta.optionsKey] = this.normalizeOptions(data[meta.payload], cleaned);
	                if (kind === 'tag') {
	                    this.task.tagOptions = this[meta.optionsKey];
	                    this.task.tags = this.normalizeTaskTags(this.task.tags || [], this.tagOptions);
	                    if (this._onUpdate) this._onUpdate(this.task._id, 'tagOptions', this[meta.optionsKey], this.task);
	                } else {
	                    this.task[meta.payload] = this[meta.optionsKey];
	                    if (this._onUpdate) this._onUpdate(this.task._id, meta.payload, this[meta.optionsKey], this.task);
	                }
	                if (kind === 'priority') {
	                    window.dispatchEvent(new CustomEvent('task-priorities-updated', { detail: { priorities: this[meta.optionsKey] } }));
	                }
		                return this[meta.optionsKey];
		            } catch (e) {
		                this[meta.optionsKey] = previous;
		                if (kind === 'tag') this.task.tagOptions = previous;
		                else this.task[meta.payload] = previous;
	                console.error('[TaskModal] Option save error:', e);
	                if (window.showMessage) window.showMessage('Erreur lors de l’enregistrement des options', 'danger');
	                throw e;
	            }
	        },

	        initDescriptionEditor(root) {
	            if (!root || !window.DexRichTextEditor) return;
	            if (this.descriptionEditorInstance?.root === root) return;
	            if (this.descriptionEditorInstance) this.descriptionEditorInstance.destroy();
	            this.descriptionEditorInstance = window.DexRichTextEditor.create(root, {
