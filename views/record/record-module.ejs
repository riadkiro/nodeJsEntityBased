                                    <iconify-icon :icon="f.icon || 'solar:widget-bold-duotone'" width="15" :style="'color:' + (selectedType.color || '#4361ee')"></iconify-icon>
                                </div>
                                <div class="fp-field-info">
                                    <div class="fp-field-name" x-text="f.label"></div>
                                    <div class="fp-field-meta" x-text="f.name"></div>
                                </div>
                                <button type="button" class="fp-field-add-btn" @click="addExistingField(f._id)" :disabled="addingId === f._id">
                                    <template x-if="addingId !== f._id">
                                        <span><iconify-icon icon="solar:add-circle-bold" width="14" style="vertical-align:-2px"></iconify-icon> Ajouter</span>
                                    </template>
                                    <template x-if="addingId === f._id">
                                        <iconify-icon icon="line-md:loading-twotone-loop" width="14"></iconify-icon>
                                    </template>
                                </button>
                            </div>
                        </template>
                    </div>
                </div>

