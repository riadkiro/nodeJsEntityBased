<!-- Admin Accounts List -->
<div class="min-h-screen">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
            <a href="/account/<%= account_number %>/admin" class="w-8 h-8 rounded-lg bg-gray-100 dark:bg-[#1b2e4b] flex items-center justify-center hover:bg-primary/10 transition-colors">
                <iconify-icon icon="solar:arrow-left-bold" width="16" class="text-gray-500"></iconify-icon>
            </a>
            <div>
                <h1 class="text-2xl font-bold dark:text-white">Comptes & Workspaces</h1>
                <p class="text-sm text-gray-500"><%= pagination.total %> comptes au total</p>
            </div>
        </div>
    </div>

    <!-- Search -->
    <div class="panel mb-5">
        <form method="GET" class="flex items-center gap-3">
            <div class="flex-1">
                <div class="relative">
                    <iconify-icon icon="solar:magnifer-bold" width="16" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></iconify-icon>
                    <input type="text" name="search" value="<%= filters.search %>" placeholder="Rechercher par nom ou numéro de compte..." class="form-input pl-9 !h-9 text-sm" />
                </div>
            </div>
            <button type="submit" class="btn btn-outline-primary btn-sm">Rechercher</button>
        </form>
    </div>

    <!-- Accounts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <% accounts.forEach(function(acc) { %>
        <div class="panel group hover:shadow-lg transition-all" x-data="{ showInvite: false }">
            <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl bg-success/10 flex items-center justify-center">
                        <iconify-icon icon="<%= acc.icon || 'solar:home-2-bold-duotone' %>" width="22" class="text-success"></iconify-icon>
                    </div>
                    <div>
                        <h3 class="font-bold text-sm dark:text-white"><%= acc.name %></h3>
                        <p class="text-xs text-gray-500 font-mono">#<%= acc.account_number %></p>
                    </div>
                </div>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold
                    <%= acc.status === 'active' ? 'bg-success/10 text-success' : acc.status === 'suspended' ? 'bg-danger/10 text-danger' : 'bg-gray-100 text-gray-500' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= acc.status === 'active' ? 'bg-success' : acc.status === 'suspended' ? 'bg-danger' : 'bg-gray-300' %>"></span>
                    <%= acc.status %>
                </span>
            </div>

            <!-- Stats -->
            <div class="grid grid-cols-3 gap-2 mb-4">
                <div class="text-center p-2 rounded-lg bg-gray-50 dark:bg-[#1b2e4b]">
                    <div class="text-lg font-bold text-primary"><%= acc.users?.length || 0 %></div>
                    <div class="text-[10px] text-gray-500">Membres</div>
                </div>
                <div class="text-center p-2 rounded-lg bg-gray-50 dark:bg-[#1b2e4b]">
                    <div class="text-lg font-bold text-success"><%= acc.invitations?.filter(i => i.status === 'pending').length || 0 %></div>
                    <div class="text-[10px] text-gray-500">Invitations</div>
                </div>
                <div class="text-center p-2 rounded-lg bg-gray-50 dark:bg-[#1b2e4b]">
                    <div class="text-lg font-bold text-info"><%= acc.sharing?.sharedSpaces?.length || 0 %></div>
                    <div class="text-[10px] text-gray-500">Partagés</div>
                </div>
            </div>

            <!-- Members Preview -->
            <% if (acc.users && acc.users.length > 0) { %>
            <div class="flex items-center gap-2 mb-4">
                <div class="flex -space-x-2">
                    <% acc.users.slice(0, 4).forEach(function(u) { %>
                        <div class="w-7 h-7 rounded-full bg-primary/10 border-2 border-white dark:border-[#0e1726] flex items-center justify-center text-[10px] font-bold text-primary" title="<%= u.email %>">
                            <%= u.email ? u.email.charAt(0).toUpperCase() : '?' %>
                        </div>
                    <% }); %>
                    <% if (acc.users.length > 4) { %>
                        <div class="w-7 h-7 rounded-full bg-gray-100 border-2 border-white dark:border-[#0e1726] flex items-center justify-center text-[10px] font-bold text-gray-500">
                            +<%= acc.users.length - 4 %>
                        </div>
                    <% } %>
                </div>
            </div>
            <% } %>

            <!-- Actions -->
            <div class="flex items-center gap-2 pt-3 border-t border-gray-100 dark:border-[#1b2e4b]">
                <% if (acc.status === 'active') { %>
                    <button onclick="updateAccountStatus('<%= acc._id %>', 'suspended')" class="btn btn-outline-danger btn-xs flex-1">Suspendre</button>
                <% } else { %>
                    <button onclick="updateAccountStatus('<%= acc._id %>', 'active')" class="btn btn-success btn-xs flex-1">Activer</button>
                <% } %>
                <button @click="showInvite = !showInvite" class="btn btn-outline-primary btn-xs flex-1">
                    <iconify-icon icon="solar:user-plus-bold" width="13" class="mr-1"></iconify-icon>
                    Inviter
                </button>
            </div>

            <!-- Invite Form -->
            <div x-show="showInvite" x-transition class="mt-3 pt-3 border-t border-gray-100 dark:border-[#1b2e4b]" x-cloak>
                <form @submit.prevent="
                    const fd = new FormData($el);
                    fetch('/account/<%= account_number %>/admin/api/accounts/invite', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        credentials: 'include',
                        body: JSON.stringify({
                            accountNumber: '<%= acc.account_number %>',
                            email: fd.get('inviteEmail'),
                            role: fd.get('inviteRole')
                        })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert('Invitation envoyée ! Lien : ' + data.inviteLink);
                            showInvite = false;
                        } else {
                            alert(data.error);
                        }
                    });
                " class="space-y-2">
                    <input type="email" name="inviteEmail" required class="form-input !h-8 text-xs" placeholder="email@example.com" />
                    <div class="flex items-center gap-2">
                        <select name="inviteRole" class="form-select !h-8 text-xs flex-1">
                            <option value="member">Membre</option>
                            <option value="admin">Admin</option>
                            <option value="viewer">Viewer</option>
                        </select>
                        <button type="submit" class="btn btn-primary btn-xs">Envoyer</button>
                    </div>
                </form>
            </div>
        </div>
        <% }); %>
    </div>

    <!-- Pagination -->
    <% if (pagination.pages > 1) { %>
    <div class="flex items-center justify-center mt-6 gap-1">
        <% for (let p = 1; p <= pagination.pages; p++) { %>
            <a href="?page=<%= p %>&search=<%= filters.search %>" 
               class="w-8 h-8 rounded-lg flex items-center justify-center text-xs font-semibold transition-colors
                      <%= p === pagination.page ? 'bg-primary text-white' : 'hover:bg-gray-100 dark:hover:bg-[#1b2e4b] text-gray-600' %>">
                <%= p %>
            </a>
        <% } %>
    </div>
    <% } %>
</div>

<script>
async function updateAccountStatus(accountId, status) {
    if (!confirm('Confirmer ?')) return;
    const res = await fetch('/account/<%= account_number %>/admin/api/accounts/status', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        credentials: 'include',
        body: JSON.stringify({ accountId, status })
    });
    const data = await res.json();
    if (data.success) location.reload();
    else alert(data.error);
}
</script>
