<!-- 403 Forbidden -->
<div class="flex items-center justify-center min-h-[60vh]">
    <div class="text-center">
        <div class="w-20 h-20 rounded-full bg-danger/10 flex items-center justify-center mx-auto mb-5">
            <iconify-icon icon="solar:shield-warning-bold-duotone" width="40" class="text-danger"></iconify-icon>
        </div>
        <h1 class="text-4xl font-bold text-danger mb-2">403</h1>
        <h2 class="text-xl font-semibold dark:text-white mb-2">Accès refusé</h2>
        <p class="text-gray-500 mb-6">Vous n'avez pas les permissions nécessaires pour accéder à cette page.</p>
        <a href="/account/<%= account_number %>/home" class="btn btn-primary">
            <iconify-icon icon="solar:home-2-bold" width="16" class="mr-1.5"></iconify-icon>
            Retour à l'accueil
        </a>
    </div>
</div>
