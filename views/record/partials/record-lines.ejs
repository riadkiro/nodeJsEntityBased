                                                                 @click.stop="openMultiselectDropdown('add_' + item._id + '_' + col.key, col.key, $event)">
                                                                <template x-if="(getSelectedItemValue(item._id, col.key) || []).length === 0">
                                                                    <span class="lp-ms-placeholder">Sélectionner...</span>
                                                                </template>
                                                                <template x-for="selVal in (getSelectedItemValue(item._id, col.key) || [])" :key="selVal">
                                                                    <span class="tp-tag"
                                                                          :style="'background:' + getMultiselectOptStyle(col, selVal).bg + '; color:' + getMultiselectOptStyle(col, selVal).text"
                                                                          x-text="getMultiselectOptLabel(col, selVal)">
                                                                    </span>
                                                                </template>
                                                            </div>
                                                            <template x-if="msDropdown.lineIdx === ('add_' + item._id + '_' + col.key) && msDropdown.colKey === col.key && msDropdown.open">
                                                                <div>
                                                                    <div style="position: fixed; inset: 0; z-index: 9998;"
                                                                         @click.stop="closeMultiselectDropdown()"></div>
                                                                    <div class="lp-ms-dropdown"
                                                                         :style="'top:' + (msDropdown.pos?.top || 0) + 'px; left:' + (msDropdown.pos?.left || 0) + 'px'">
                                                                        <div class="tp-search-wrap">
                                                                            <input type="text" class="tp-search-input"
                                                                                   placeholder="Rechercher..."
                                                                                   :value="msDropdown.query"
                                                                                   @input="msDropdown.query = $event.target.value" />
                                                                        </div>
                                                                        <div class="tp-divider"></div>
                                                                        <div class="tp-options">
                                                                            <template x-for="opt in filterMsOptions(col)" :key="opt.value">
                                                                                <div class="tp-option"
                                                                                     @click.stop="toggleSelectedItemMultiselect(item._id, col.key, opt.value)">
                                                                                    <div class="tp-option-icon"
                                                                                         :style="(getSelectedItemValue(item._id, col.key) || []).includes(opt.value)
                                                                                             ? 'background:' + getMultiselectOptStyle(col, opt.value).bg + '; border: 2px solid ' + getMultiselectOptStyle(col, opt.value).bg
                                                                                             : 'background: #fff; border: 2px solid #d1d5db'">
                                                                                        <iconify-icon x-show="(getSelectedItemValue(item._id, col.key) || []).includes(opt.value)"
                                                                                                      icon="tabler:check" width="12"
                                                                                                      :style="'color:' + getMultiselectOptStyle(col, opt.value).text"></iconify-icon>
                                                                                    </div>
                                                                                    <span class="tp-option-label" x-text="opt.label"></span>
                                                                                </div>
                                                                            </template>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </template>
                                                        </div>
                                                    </template>

