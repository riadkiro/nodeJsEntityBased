<!-- Tasks Hub — aggregated workspace -->
<style>
.th-wrap{height:calc(100vh - 70px);min-height:720px;background:#fff;color:#0f172a;overflow:hidden;font-family:inherit}
.th-shell{height:100%;display:grid;grid-template-columns:268px minmax(0,1fr);border-top:1px solid #eef2f7}
.th-rail{min-width:0;border-right:1px solid #e8ecf1;background:linear-gradient(180deg,#fbfcff 0%,#f8fafc 100%);display:flex;flex-direction:column}
.th-rail-head{padding:22px 20px 18px;border-bottom:1px solid #eef2f7}
.th-brand{display:flex;align-items:center;gap:12px}
.th-brand-icon,.th-icon-box{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#6366f118,#6366f108);color:#6366f1;flex:0 0 auto}
.th-brand h1{margin:0;color:#0f172a;font-size:17px;font-weight:800;letter-spacing:0}
.th-brand p{margin:2px 0 0;color:#7c89a6;font-size:12.5px;font-weight:500;line-height:1.35}
.th-search{position:relative;margin-top:18px}
.th-search iconify-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#9aa6bf}
.th-input{width:100%;height:40px;border:1px solid #dfe6f2;border-radius:10px;background:#fff;color:#0f172a;font-size:12.5px;font-weight:500;padding:0 12px 0 36px;outline:none;transition:border-color .18s,box-shadow .18s}
.th-input:focus{border-color:#6366f1;box-shadow:0 0 0 3px rgba(99,102,241,.09)}
.th-input::placeholder{color:#b2bdd0}
.th-rail-body{flex:1;overflow:auto;padding:13px 10px 16px}
.th-rail-body::-webkit-scrollbar,.th-scroll::-webkit-scrollbar{width:5px;height:5px}
.th-rail-body::-webkit-scrollbar-thumb,.th-scroll::-webkit-scrollbar-thumb{background:#d9e1ef;border-radius:999px}
.th-side-title{margin:11px 8px 6px;color:#7c89a6;font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:.45px}
.th-space{width:100%;min-height:34px;display:flex;align-items:center;gap:8px;border:none;background:transparent;border-radius:0;padding:6px 8px;color:#475569;font-family:inherit;text-align:left;cursor:pointer;transition:all .18s;margin-bottom:1px;border-left:2.5px solid transparent}
.th-space:hover{background:#fafbff;border-left-color:#c7d2fe}
.th-space.active{background:#eef2ff;border-left-color:#4f46e5;color:#4f46e5}
.th-space-icon{width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.th-space-title{flex:1;min-width:0;font-size:12.2px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.th-record-node{margin-bottom:2px}
.th-list-node{margin:0 0 3px 13px;padding-left:9px;border-left:1.5px solid #e7ecf5}
.th-list-node .th-space{min-height:27px;padding:3px 7px 3px 6px;gap:7px;border-radius:8px;margin-bottom:0;border-left:none}
.th-list-node .th-space-icon{width:19px;height:19px;border-radius:6px}
.th-list-node .th-space-title{font-size:11.5px;font-weight:700}
.th-list-node .th-badge{min-width:18px;height:18px;padding:0 5px;font-size:10px}
.th-badge{min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:#eef2f7;color:#7c89a6;font-size:10.5px;font-weight:800;display:inline-flex;align-items:center;justify-content:center}
.th-space.active .th-badge{background:#ddd6fe;color:#5b4df5}
.th-rail-widget{border:1px solid #e8ecf1;border-radius:12px;background:#fff;margin:12px 0 14px;padding:12px;box-shadow:0 8px 22px rgba(15,23,42,.025)}
.th-rail-widget-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
.th-rail-widget-head span{display:flex;align-items:center;gap:7px;color:#475569;font-size:12px;font-weight:760}
.th-rail-widget-head b{height:22px;min-width:24px;padding:0 7px;border-radius:999px;background:#eef2ff;color:#4f46e5;font-size:11px;font-weight:850;display:inline-flex;align-items:center;justify-content:center}
.th-rail-bars{height:92px;display:grid;grid-template-columns:repeat(7,1fr);gap:5px;align-items:end}
.th-rail-bar-wrap{height:100%;display:flex;flex-direction:column;align-items:center;gap:5px;justify-content:flex-end}
.th-rail-bar-bg{height:66px;width:11px;border-radius:999px;background:#f1f5f9;display:flex;align-items:end;justify-content:center;overflow:hidden}
.th-rail-bar{width:100%;min-height:6px;border-radius:999px;background:linear-gradient(180deg,#a5b4fc,#6366f1)}
.th-rail-bar-wrap span{color:#8b98b1;font-size:9px;font-weight:750}
.th-manage{margin-top:auto;padding:14px 12px 18px;border-top:1px solid #eef2f7}
.th-manage-btn{width:100%;height:44px;border-radius:10px;border:1px solid #dde5f0;background:#fff;color:#475569;font-family:inherit;font-size:12.5px;font-weight:700;display:flex;align-items:center;justify-content:space-between;padding:0 12px;cursor:pointer;transition:all .18s}
.th-manage-btn:hover{border-color:#c7d2fe;color:#4f46e5;box-shadow:0 8px 18px rgba(15,23,42,.04)}
.th-main{min-width:0;overflow:auto;background:#fff}
.th-main-inner{padding:24px 32px 40px;max-width:920px;margin:0 auto}
.th-check{width:18px;height:18px;border:1.7px solid #cbd5e1;border-radius:5px;background:#fff;display:flex;align-items:center;justify-content:center;color:#fff;transition:all .16s;flex:0 0 auto}
.th-check.checked{background:#10b981;border-color:#10b981}
.th-count-chip{height:22px;min-width:24px;padding:0 7px;border-radius:999px;background:#eef2ff;color:#4f46e5;font-size:11px;font-weight:850;display:inline-flex;align-items:center;justify-content:center}
.th-add-row{height:38px;display:flex;align-items:center;gap:7px;padding:0 18px;color:#9aa6bf;font-size:12.5px;font-weight:650;cursor:pointer}
.th-add-row:hover{color:#4f46e5;background:#fbfcff}
.th-quick-add{min-height:52px;border:1px solid #dfe6f2;border-radius:12px;background:#fff;box-shadow:0 12px 26px rgba(15,23,42,.045);display:grid;grid-template-columns:28px minmax(0,1fr) auto auto;align-items:center;gap:10px;padding:9px 12px;margin:-4px 0 16px}
.th-quick-add input{height:34px;border:0;outline:0;background:transparent;color:#0f172a;font-family:inherit;font-size:12.8px;font-weight:600;min-width:0}
.th-quick-add input::placeholder{color:#aab5c8}
.th-quick-add-error{margin:-8px 0 14px;color:#ef4444;font-size:12px;font-weight:650}
.th-empty{padding:54px 20px;text-align:center;color:#94a3b8}
.th-empty h3{margin:10px 0 4px;color:#111827;font-size:15px;font-weight:800}
.th-empty p{margin:0;font-size:12.5px}
/* ═══ Content area ═══ */
.th-content-header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:28px}
.th-content-title{font-size:22px;font-weight:850;color:#111827;margin:0;letter-spacing:-.01em}
.th-content-subtitle{font-size:13px;color:#94a3b8;font-weight:500;margin:5px 0 0;line-height:1.4}
.th-new-task-btn{height:42px;border-radius:10px;border:none;background:linear-gradient(135deg,#4f46e5,#6366f1);color:#fff;font-family:inherit;font-size:13px;font-weight:750;padding:0 22px;display:inline-flex;align-items:center;gap:8px;cursor:pointer;box-shadow:0 6px 18px rgba(79,70,229,.22);transition:all .18s;white-space:nowrap;flex:0 0 auto}
.th-new-task-btn:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(79,70,229,.3)}
.th-date-tabs{display:flex;align-items:center;gap:6px;margin-bottom:16px;flex-wrap:wrap}
.th-date-tab{height:36px;padding:0 15px;border-radius:999px;border:1.5px solid #e8ecf1;background:#fff;color:#64748b;font-family:inherit;font-size:12.5px;font-weight:700;display:inline-flex;align-items:center;gap:7px;cursor:pointer;transition:all .16s}
.th-date-tab:hover{border-color:#c7d2fe;color:#4f46e5}
.th-date-tab.active{border-color:#4f46e5;background:#eef2ff;color:#4f46e5}
.th-tab-count{min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:#eef2f7;color:#64748b;font-size:10.5px;font-weight:850;display:inline-flex;align-items:center;justify-content:center}
.th-date-tab.active .th-tab-count{background:#ddd6fe;color:#4f46e5}
.th-date-tabs-right{margin-left:auto;display:inline-flex;align-items:center;border:1.5px solid #e8ecf1;border-radius:999px;overflow:hidden;background:#fff}
.th-view-toggle{height:34px;padding:0 14px;border:none;background:transparent;color:#64748b;font-family:inherit;font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:5px;cursor:pointer;transition:all .14s}
.th-view-toggle:hover{color:#4f46e5}
.th-view-toggle.active{background:#eef2ff;color:#4f46e5}
.th-priority-pills{display:flex;align-items:center;gap:8px;margin-bottom:24px}
.th-priority-pill{height:32px;padding:0 14px;border-radius:999px;border:none;background:#f1f5f9;color:#64748b;font-family:inherit;font-size:12.5px;font-weight:700;display:inline-flex;align-items:center;gap:6px;cursor:pointer;transition:all .14s}
.th-priority-pill:hover{background:#e8ecf1}
.th-priority-pill.active{background:#eef2ff;color:#4f46e5}
.th-priority-pill .pdot{width:7px;height:7px;border-radius:50%;flex:0 0 auto}
.th-group-header{display:flex;align-items:center;gap:8px;padding:12px 0 6px}
.th-group-flag{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.th-group-title{font-size:13px;font-weight:800;color:#111827}
.th-group-count{min-width:20px;height:20px;padding:0 6px;border-radius:999px;font-size:10.5px;font-weight:850;display:inline-flex;align-items:center;justify-content:center}
.th-task-item{display:grid;grid-template-columns:26px minmax(0,1fr) auto auto 24px;align-items:center;gap:10px;padding:7px 8px;border-bottom:1px solid #f3f4f6;transition:background .12s;cursor:pointer}
.th-task-item:hover{background:#fafbff}
.th-task-checkbox{width:18px;height:18px;border:1.5px solid #d1d5db;border-radius:5px;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;color:transparent}
.th-task-checkbox.checked{background:#10b981;border-color:#10b981;color:#fff}
.th-task-info{min-width:0}
.th-task-title-text{font-size:12.5px;font-weight:700;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.th-task-item.done .th-task-title-text{text-decoration:line-through;color:#94a3b8}
.th-task-record-label{display:flex;align-items:center;gap:4px;margin-top:2px;font-size:10.5px;color:#94a3b8;font-weight:600}
.th-task-record-dot{width:6px;height:6px;border-radius:50%;flex:0 0 auto}
.th-task-date-label{display:inline-flex;align-items:center;gap:4px;color:#94a3b8;font-size:11px;font-weight:650;white-space:nowrap}
.th-task-priority-badge{height:20px;padding:0 8px;border-radius:5px;font-size:10px;font-weight:800;display:inline-flex;align-items:center;white-space:nowrap}
.th-task-menu-btn{width:24px;height:24px;border:none;background:transparent;color:#c5cdd8;display:flex;align-items:center;justify-content:center;cursor:pointer;border-radius:5px;transition:all .12s;position:relative}
.th-task-menu-btn:hover{background:#f3f4f6;color:#6b7280}
.th-ctx-menu{position:absolute;top:100%;right:0;min-width:160px;background:#fff;border:1px solid #e8ecf1;border-radius:10px;box-shadow:0 12px 32px rgba(15,23,42,.12);z-index:99;padding:4px}
.th-ctx-item{display:flex;align-items:center;gap:8px;width:100%;padding:7px 10px;border:none;background:transparent;color:#475569;font-family:inherit;font-size:12px;font-weight:650;border-radius:7px;cursor:pointer;transition:background .12s;text-align:left}
.th-ctx-item:hover{background:#f3f4f6}
.th-ctx-item.danger{color:#ef4444}
.th-ctx-item.danger:hover{background:#fef2f2}
.th-inline-add{display:flex;align-items:center;gap:6px;padding:6px 8px;color:#b0b8c9;font-size:11.5px;font-weight:600;cursor:pointer;transition:color .12s}
.th-inline-add:hover{color:#4f46e5}
/* Dark mode — sidebar */
.dark .th-wrap,.dark .th-main{background:#060818;color:#e5edf7}
.dark .th-shell,.dark .th-rail{border-color:#1b2e4b}
.dark .th-rail{background:#0b1320}
.dark .th-rail-head,.dark .th-manage{border-color:#1b2e4b}
.dark .th-brand h1,.dark .th-content-title,.dark .th-group-title,.dark .th-modal-title{color:#e0e6ed}
.dark .th-brand p,.dark .th-content-subtitle{color:#8ea0bd}
.dark .th-input,.dark .th-manage-btn,.dark .th-quick-add{background:#0e1726;border-color:#253b5c;color:#e0e6ed;box-shadow:none}
.dark .th-rail-widget{background:#0e1726;border-color:#253b5c;box-shadow:none}
.dark .th-rail-widget-head span{color:#8ea0bd}
.dark .th-rail-bar-bg{background:#17233a}
.dark .th-quick-add input{color:#e0e6ed}
.dark .th-space:hover{background:#111f35;border-left-color:#253b5c}
.dark .th-space.active{background:#1b2447;border-left-color:#6366f1;color:#a5b4fc}
.dark .th-list-node{border-color:#253b5c}
.dark .th-ctx-menu{background:#0e1726;border-color:#253b5c;box-shadow:0 12px 32px rgba(0,0,0,.35)}
.dark .th-ctx-item{color:#e0e6ed}
.dark .th-ctx-item:hover{background:#17233a}
.dark .th-badge{background:#1b2e4b;color:#8ea0bd}
/* Dark mode — content */
.dark .th-new-task-btn{box-shadow:0 6px 18px rgba(79,70,229,.35)}
.dark .th-date-tab{background:#0e1726;border-color:#253b5c;color:#8ea0bd}
.dark .th-date-tab.active{background:#1b2447;border-color:#4f46e5;color:#a5b4fc}
.dark .th-tab-count{background:#17233a;color:#8ea0bd}
.dark .th-date-tab.active .th-tab-count{background:#2d2b73;color:#a5b4fc}
.dark .th-date-tabs-right{background:#0e1726;border-color:#253b5c}
.dark .th-view-toggle{color:#8ea0bd}
.dark .th-view-toggle.active{background:#1b2447;color:#a5b4fc}
.dark .th-priority-pill{background:#17233a;color:#8ea0bd}
.dark .th-priority-pill.active{background:#1b2447;color:#a5b4fc}
.dark .th-task-item{border-color:#1b2e4b}
.dark .th-task-item:hover{background:#111f35}
.dark .th-task-checkbox{border-color:#475569;background:#0e1726}
.dark .th-task-title-text{color:#e0e6ed}
.dark .th-task-record-label,.dark .th-task-date-label{color:#6b7f9e}
.dark .th-inline-add{color:#6b7f9e}.dark .th-inline-add:hover{color:#a5b4fc}
/* Responsive */
@media(max-width:1280px){.th-shell{grid-template-columns:248px minmax(0,1fr)}}
@media(max-width:900px){.th-wrap{height:auto;min-height:calc(100vh - 70px);overflow:visible}.th-shell{display:block}.th-rail{height:auto;border-right:0;border-bottom:1px solid #e8ecf1}.th-rail-body{max-height:300px}.th-main{overflow:visible}.th-main-inner{padding:16px}.th-content-header{flex-direction:column;gap:12px}.th-date-tabs{flex-wrap:wrap}.th-date-tabs-right{margin-left:0;margin-top:6px}.th-task-item{grid-template-columns:32px minmax(0,1fr) 28px}.th-task-item>.th-task-date-label,.th-task-item>.th-task-priority-badge{display:none}}
</style>

<div class="th-wrap" x-data="tasksHubApp" x-cloak>
    <div class="th-shell">
        <aside class="th-rail">
            <div class="th-rail-head">
                <div class="th-brand">
                    <div class="th-brand-icon"><iconify-icon icon="solar:checklist-minimalistic-bold-duotone" width="22"></iconify-icon></div>
                    <div>
                        <h1>Tasks Hub</h1>
                        <p>Toutes les tâches de vos espaces et enregistrements</p>
                    </div>
                </div>
                <div class="th-search">
                    <iconify-icon icon="solar:magnifer-linear" width="16"></iconify-icon>
                    <input class="th-input" type="text" placeholder="Rechercher un espace..." x-model="searchQuery">
                </div>
            </div>
            <div class="th-rail-body">
	                <button class="th-space" :class="{'active': activeScope === 'personal' && !activeRecordId && !activeListId}" @click="selectScope('personal')">
	                    <span class="th-space-icon" style="background:#ede9fe;color:#7c3aed"><iconify-icon icon="solar:user-rounded-bold-duotone" width="16"></iconify-icon></span>
	                    <span class="th-space-title">Espace perso</span>
	                </button>
                <div class="th-rail-widget">
                    <div class="th-rail-widget-head">
                        <span><iconify-icon icon="solar:chart-2-bold-duotone" width="15"></iconify-icon> Charge de travail</span>
                        <b x-text="weekTaskCount"></b>
                    </div>
                    <div class="th-rail-bars">
                        <template x-for="bar in workloadBars" :key="'rail-' + bar.label">
                            <div class="th-rail-bar-wrap">
                                <div class="th-rail-bar-bg"><div class="th-rail-bar" :style="'height:' + bar.height + '%'"></div></div>
                                <span x-text="bar.label"></span>
                            </div>
                        </template>
                    </div>
                </div>
                <div class="th-side-title">Perso</div>
                <template x-if="sideLoading">
                    <div style="padding:18px;text-align:center"><iconify-icon icon="line-md:loading-twotone-loop" width="22" style="color:#6366f1"></iconify-icon></div>
                </template>
	                <template x-for="record in filteredPersonalRecords" :key="record.recordId">
	                    <div class="th-record-node">
	                        <button class="th-space" :class="{'active': activeRecordId === record.recordId && !activeListId}" @click="selectRecord(record,'personal')">
	                            <span class="th-space-icon" :style="'background:' + colorSoft(record.recordColor) + ';color:' + record.recordColor">
	                                <iconify-icon :icon="record.recordIcon || record.entityIcon || 'solar:folder-bold-duotone'" width="16"></iconify-icon>
	                            </span>
	                            <span class="th-space-title" x-text="record.recordTitle"></span>
	                            <span class="th-badge" x-text="record.totalTasks || 0"></span>
	                        </button>
	                        <div class="th-list-node" x-show="(record.lists || []).length">
	                            <template x-for="list in record.lists" :key="list.id || list.listId">
	                                <button class="th-space" :class="{'active': activeListId === (list.id || list.listId)}" @click="selectList(record, list, 'personal')">
	                                    <span class="th-space-icon" :style="'background:' + colorSoft(list.color || record.recordColor) + ';color:' + (list.color || record.recordColor)">
	                                        <iconify-icon :icon="list.icon || 'solar:checklist-bold-duotone'" width="13"></iconify-icon>
	                                    </span>
	                                    <span class="th-space-title" x-text="list.label"></span>
	                                    <span class="th-badge" x-text="list.totalTasks || list.count || 0"></span>
	                                </button>
	                            </template>
	                        </div>
	                    </div>
	                </template>
            </div>
            <div class="th-manage">
                <button class="th-manage-btn" type="button">
                    <span style="display:flex;align-items:center;gap:9px"><iconify-icon icon="solar:settings-linear" width="17"></iconify-icon> Gérer les espaces</span>
                    <iconify-icon icon="solar:alt-arrow-right-linear" width="14"></iconify-icon>
                </button>
            </div>
        </aside>

        <main class="th-main th-scroll">
            <div class="th-main-inner">
                <div class="th-content-header">
                    <div>
                        <h2 class="th-content-title" x-text="mainTitle"></h2>
                        <p class="th-content-subtitle" x-text="mainSubtitle"></p>
                    </div>
                    <button class="th-new-task-btn" type="button" @click="showQuickAdd()">
                        <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
                        Nouvelle tâche
                    </button>
                </div>

                <div class="th-date-tabs">
                    <button class="th-date-tab" type="button" :class="{'active': activeFilter === 'late'}" @click="activeFilter = 'late'">
                        En retard <span class="th-tab-count" x-text="lateFilterCount"></span>
                    </button>
                    <button class="th-date-tab" type="button" :class="{'active': activeFilter === 'today'}" @click="activeFilter = 'today'">
                        Aujourd'hui <span class="th-tab-count" x-text="todayFilterCount"></span>
                    </button>
                    <button class="th-date-tab" type="button" :class="{'active': activeFilter === 'tomorrow'}" @click="activeFilter = 'tomorrow'">
                        Demain <span class="th-tab-count" x-text="tomorrowFilterCount"></span>
                    </button>
                    <button class="th-date-tab" type="button" :class="{'active': activeFilter === 'week'}" @click="activeFilter = 'week'">
                        Cette semaine <span class="th-tab-count" x-text="weekFilterCount"></span>
                    </button>
                    <div class="th-date-tabs-right">
                        <button class="th-view-toggle" type="button" :class="{'active': activeFilter === 'all'}" @click="activeFilter = 'all'; sortMode = 'all'">
                            <iconify-icon icon="solar:list-bold" width="14"></iconify-icon> Toutes
                        </button>
                        <button class="th-view-toggle" type="button" :class="{'active': sortMode === 'recent'}" @click="activeFilter = 'all'; sortMode = sortMode === 'recent' ? 'all' : 'recent'">
                            <iconify-icon icon="solar:clock-circle-bold" width="14"></iconify-icon> Récentes
                        </button>
                    </div>
                </div>

                <div class="th-priority-pills">
                    <button class="th-priority-pill" type="button" :class="{'active': priorityFilter === 'all'}" @click="priorityFilter = 'all'">
                        <iconify-icon icon="solar:check-circle-bold" width="14" x-show="priorityFilter === 'all'" style="color:#4f46e5"></iconify-icon>
                        Toutes
                    </button>
                    <button class="th-priority-pill" type="button" :class="{'active': priorityFilter === 'Haute'}" @click="priorityFilter = 'Haute'">
                        <span class="pdot" style="background:#ef4444"></span> Haute
                    </button>
                    <button class="th-priority-pill" type="button" :class="{'active': priorityFilter === 'Moyenne'}" @click="priorityFilter = 'Moyenne'">
                        <span class="pdot" style="background:#f97316"></span> Moyenne
                    </button>
                    <button class="th-priority-pill" type="button" :class="{'active': priorityFilter === 'Normale'}" @click="priorityFilter = 'Normale'">
                        <span class="pdot" style="background:#10b981"></span> Normale
                    </button>
                </div>

                <form class="th-quick-add" x-show="addingTask" x-transition @submit.prevent="createPersonalTask()">
                    <span class="th-check"></span>
                    <input x-ref="newTaskInput" type="text" x-model="newTaskTitle" :placeholder="quickAddPlaceholder" :disabled="creatingTask" @keydown.escape.prevent="cancelQuickAdd()">
                    <button class="th-new-task-btn" type="submit" :disabled="creatingTask" style="height:34px;padding:0 14px;font-size:12px;box-shadow:none">
                        <iconify-icon :icon="creatingTask ? 'line-md:loading-twotone-loop' : 'solar:add-circle-bold'" width="15"></iconify-icon>
                        Ajouter
                    </button>
                    <button class="th-task-menu-btn" type="button" @click="cancelQuickAdd()" :disabled="creatingTask"><iconify-icon icon="solar:close-circle-linear" width="17"></iconify-icon></button>
                </form>
                <div class="th-quick-add-error" x-show="addError" x-text="addError"></div>

                <template x-for="section in prioritySections" :key="section.key">
                    <div x-show="section.tasks.length">
                        <div class="th-group-header">
                            <span class="th-group-flag" :style="'background:' + section.bg + ';color:' + section.color">
                                <iconify-icon :icon="section.icon" width="14"></iconify-icon>
                            </span>
                            <span class="th-group-title" x-text="section.title"></span>
                            <span class="th-group-count" :style="'background:' + section.bg + ';color:' + section.color" x-text="section.tasks.length"></span>
                        </div>
                        <div>
                            <template x-for="task in section.tasks" :key="task._id">
                                <div class="th-task-item" :class="{'done': isDone(task)}" @click="openTask(task)">
                                    <span class="th-task-checkbox" :class="{'checked': isDone(task)}" @click.stop="toggleTaskStatus(task)">
                                        <iconify-icon icon="solar:check-read-linear" width="13"></iconify-icon>
                                    </span>
                                    <div class="th-task-info">
                                        <div class="th-task-title-text" x-text="task.title"></div>
                                        <div class="th-task-record-label">
                                            <span class="th-task-record-dot" :style="'background:' + (task.recordColor || task.entityColor || '#6366f1')"></span>
                                            <span x-text="task.recordTitle"></span>
                                        </div>
                                    </div>
                                    <span class="th-task-date-label">
                                        <iconify-icon icon="solar:calendar-linear" width="14"></iconify-icon>
                                        <span x-text="formatRelativeDate(taskDisplayDate(task))"></span>
                                    </span>
                                    <span class="th-task-priority-badge" :style="priorityStyle(task.priority)" x-text="priorityLabel(task.priority)"></span>
                                    <div style="position:relative">
                                        <button class="th-task-menu-btn" type="button" @click.stop="ctxTaskId = ctxTaskId === task._id ? null : task._id">
                                            <iconify-icon icon="solar:menu-dots-bold" width="17"></iconify-icon>
                                        </button>
                                        <div class="th-ctx-menu" x-show="ctxTaskId === task._id" x-transition.opacity @click.outside="ctxTaskId = null" @click.stop style="display:none">
                                            <button class="th-ctx-item" type="button" @click="ctxTaskId = null; openTask(task)">
                                                <iconify-icon icon="solar:pen-new-square-linear" width="14"></iconify-icon> Modifier
                                            </button>
                                            <button class="th-ctx-item" type="button" @click="ctxTaskId = null; toggleTaskStatus(task)">
                                                <iconify-icon icon="solar:check-circle-linear" width="14"></iconify-icon>
                                                <span x-text="isDone(task) ? 'Rouvrir' : 'Terminer'"></span>
                                            </button>
                                            <button class="th-ctx-item danger" type="button" @click="ctxTaskId = null; deleteTask(task)">
                                                <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="14"></iconify-icon> Supprimer
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </template>
                            <div class="th-inline-add" @click="showQuickAdd('À faire', section.priorities[0] || 'Aucune')">
                                <iconify-icon icon="solar:add-circle-linear" width="15"></iconify-icon>
                                Ajouter une tâche
                            </div>
                        </div>
                    </div>
                </template>

                <template x-if="!priorityFilteredTasks.length && !sideLoading">
                    <div class="th-empty">
                        <iconify-icon icon="solar:checklist-minimalistic-bold-duotone" width="42"></iconify-icon>
                        <h3>Aucune tâche dans cette vue</h3>
                        <p>Changez de filtre ou sélectionnez un autre espace.</p>
                    </div>
                </template>
            </div>
        </main>
    </div>

    <!-- ═══ Shared Task Detail Modal ═══ -->
    <%- include('../partials/task-detail-modal') %>
</div>

<script>
document.addEventListener('alpine:init', () => {
    const API = '/account/<%= account_number %>';

    Alpine.data('tasksHubApp', () => ({
        entities: [],
        sideLoading: true,
        searchQuery: '',
        taskSearch: '',
        activeScope: 'personal',
        activeRecordId: null,
        activeListId: null,
        activeFilter: 'today',
        priorityFilter: 'all',
        sortMode: 'all',
        ctxTaskId: null,
        addingTask: false,
        creatingTask: false,
        newTaskTitle: '',
        quickAddStatus: 'À faire',
        quickAddPriority: 'Aucune',
        addError: '',
        fallbackTasks: [
            { _id:'static-1', title:'Pédiatre Adam', status:'À faire', priority:'Haute', dueDate:'2026-06-16', startDate:'2026-06-16', createdAt:'2026-06-15', assignedTo:'Moi', listLabel:"Aujourd'hui", recordTitle:'Papa', recordIcon:'solar:user-rounded-bold-duotone', recordColor:'#8b5cf6', entityName:'Famille', entitySlug:'famille', entityIcon:'solar:users-group-rounded-bold-duotone', entityColor:'#8b5cf6', scope:'personal' },
            { _id:'static-2', title:'Renouveler assurance Clio 4', status:'À faire', priority:'Basse', dueDate:'2026-06-20', startDate:'2026-06-18', createdAt:'2026-06-15', assignedTo:'Moi', listLabel:'Cette semaine', recordTitle:'Clio 4', recordIcon:'solar:car-bold-duotone', recordColor:'#3b82f6', entityName:'Voiture', entitySlug:'voiture', entityIcon:'solar:car-bold-duotone', entityColor:'#3b82f6', scope:'personal' },
            { _id:'static-3', title:'Préparer réunion client', status:'En cours', priority:'Moyenne', dueDate:'2026-06-18', startDate:'2026-06-16', createdAt:'2026-06-15', assignedTo:'Yanis', listLabel:'À venir', recordTitle:'Lotissement Saidia', recordIcon:'solar:buildings-2-bold-duotone', recordColor:'#0284c7', entityName:'Société', entitySlug:'societe', entityIcon:'solar:buildings-2-bold-duotone', entityColor:'#0284c7', scope:'company' },
            { _id:'static-4', title:'Envoyer devis #2026-045', status:'En revue', priority:'Moyenne', dueDate:'2026-06-16', startDate:'2026-06-15', createdAt:'2026-06-15', assignedTo:'Sofia', listLabel:'Priorités', recordTitle:'CSA', recordIcon:'solar:buildings-bold-duotone', recordColor:'#7c3aed', entityName:'Société', entitySlug:'societe', entityIcon:'solar:buildings-2-bold-duotone', entityColor:'#0284c7', scope:'company' },
            { _id:'static-5', title:'Tache test 2', status:'À faire', priority:'Moyenne', dueDate:'2026-06-15', startDate:'2026-06-14', createdAt:'2026-06-15', assignedTo:'Ben', listLabel:"Aujourd'hui", recordTitle:'Papa', recordIcon:'solar:user-rounded-bold-duotone', recordColor:'#8b5cf6', entityName:'Famille', entitySlug:'famille', entityIcon:'solar:users-group-rounded-bold-duotone', entityColor:'#8b5cf6', scope:'personal' }
        ],

        async init() {
            window.addEventListener('keydown', e => { if (e.key === 'Escape') this.closeTask(); });
            await this.loadHub();
        },

        async loadHub() {
            this.sideLoading = true;
            try {
                const res = await fetch(API + '/api/tasks-hub', { credentials:'include' });
                const data = await res.json();
                if (data.success) {
                    this.entities = data.entities || [];
                    if (!this.activeScope) this.activeScope = 'personal';
                }
            } catch (e) { console.error('[TasksHub]', e); }
            this.sideLoading = false;
        },

        get allRecords() {
            const records = [];
            (this.entities || []).forEach(entity => {
                (entity.records || []).forEach(record => {
                    const scope = this.classifyRecord(record, entity);
                    const normalized = { ...record, entityName: record.entityName || entity.entityName, entitySlug: record.entitySlug || entity.entitySlug, entityIcon: record.entityIcon || entity.entityIcon, entityColor: record.entityColor || entity.entityColor, scope };
                    normalized.lists = (record.lists || []).map(list => ({ ...list, id: String(list.id || list.listId || ''), listId: String(list.listId || list.id || ''), icon: list.icon || 'solar:checklist-bold-duotone', color: list.color || record.recordColor || entity.entityColor || '#6366f1' })).filter(list => list.id);
                    normalized.tasks = (record.tasks || []).map(task => ({ ...task, scope }));
                    records.push(normalized);
                });
            });
            if (!records.length) return this.fallbackRecords;
            return records;
        },

        get fallbackRecords() {
            const byKey = {};
            this.fallbackTasks.forEach(task => {
                const key = task.recordTitle;
                if (!byKey[key]) byKey[key] = { recordId: 'static-' + key.toLowerCase().replace(/\s+/g, '-'), recordTitle: task.recordTitle, recordIcon: task.recordIcon, recordColor: task.recordColor, entityName: task.entityName, entitySlug: task.entitySlug, entityIcon: task.entityIcon, entityColor: task.entityColor, scope: task.scope, totalTasks: 0, doneTasks: 0, listsCount: 1, lists: [], tasks: [] };
                byKey[key].tasks.push(task);
                byKey[key].totalTasks++;
                if (this.isDone(task)) byKey[key].doneTasks++;
            });
            Object.values(byKey).forEach(record => {
                record.lists = [{ id: record.recordId + '-default', listId: record.recordId + '-default', label: 'Liste des tâches', icon: 'solar:checklist-bold-duotone', color: record.recordColor, totalTasks: record.totalTasks, doneTasks: record.doneTasks }];
            });
            return Object.values(byKey);
        },

        classifyRecord(record, entity = {}) {
            const text = [record.entitySlug, record.entityName, entity.entitySlug, entity.entityName, record.recordTitle].filter(Boolean).join(' ').toLowerCase();
            const companyWords = ['soci', 'societe', 'société', 'entreprise', 'company', 'client', 'prospect', 'projet', 'chantier', 'lotissement', 'group', 'csa', 'da group'];
            return companyWords.some(word => text.includes(word)) ? 'company' : 'personal';
        },

        get filteredPersonalRecords() { return this.filterSidebar(this.allRecords.filter(r => r.scope === 'personal' && r.totalTasks > 0)); },
        get filteredCompanyRecords() { return this.filterSidebar(this.allRecords.filter(r => r.scope === 'company' && r.totalTasks > 0)); },
        filterSidebar(records) {
            const q = this.searchQuery.trim().toLowerCase();
            if (!q) return records;
            return records.filter(r => ((r.recordTitle || '').toLowerCase().includes(q) || (r.entityName || '').toLowerCase().includes(q) || (r.lists || []).some(list => (list.label || '').toLowerCase().includes(q))));
        },
        selectScope(scope) { this.activeScope = scope; this.activeRecordId = null; this.activeListId = null; this.activeFilter = 'today'; this.priorityFilter = 'all'; },
        selectRecord(record, scope) { this.activeScope = scope || record.scope || 'personal'; this.activeRecordId = record.recordId; this.activeListId = null; this.activeFilter = 'all'; this.priorityFilter = 'all'; },
        selectList(record, list, scope) { this.activeScope = scope || record.scope || 'personal'; this.activeRecordId = record.recordId; this.activeListId = String(list.id || list.listId || ''); this.activeFilter = 'all'; this.priorityFilter = 'all'; },

        get activeRecords() {
            let records = this.allRecords.filter(r => r.totalTasks > 0);
            if (this.activeRecordId) return records.filter(r => r.recordId === this.activeRecordId);
            return records.filter(r => r.scope === this.activeScope);
        },
        get activeRecord() { return this.activeRecordId ? this.allRecords.find(r => r.recordId === this.activeRecordId) : null; },
        get activeList() {
            if (!this.activeListId) return null;
            return (this.activeRecord?.lists || []).find(list => String(list.id || list.listId || '') === this.activeListId) || null;
        },
        get rawVisibleTasks() {
            return this.activeRecords.flatMap(record => (record.tasks || [])
                .filter(task => !this.activeListId || String(task.listId || task.taskListId || '') === this.activeListId)
                .map(task => {
                    const taskListId = String(task.listId || task.taskListId || '');
                    const fallbackList = (record.lists || []).find(list => String(list.id || list.listId || '') === taskListId) || (record.lists || [])[0] || {};
                    const listId = taskListId || String(fallbackList.id || fallbackList.listId || '');
                    return { ...task, recordId: task.recordId || record.recordId, listId, taskListId: listId, listLabel: task.listLabel || fallbackList.label || 'Liste des tâches', listIcon: task.listIcon || fallbackList.icon || 'solar:checklist-bold-duotone', listColor: task.listColor || fallbackList.color || record.recordColor || record.entityColor || '#6366f1', recordTitle: task.recordTitle || record.recordTitle, recordIcon: task.recordIcon || record.recordIcon, recordColor: task.recordColor || record.recordColor, entityName: task.entityName || record.entityName, entityIcon: task.entityIcon || record.entityIcon, entityColor: task.entityColor || record.entityColor, scope: record.scope };
                }));
        },

        // ═══ "Aujourd'hui" = startDate ≤ today + dueDate not expired, OR isDayPriority ═══
        isTodayTask(task) {
            if (this.isDone(task)) return false;
            // isDayPriority always shows
            if (task.isDayPriority) return true;
            const now = new Date();
            const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            // startDate ≤ today AND (no dueDate OR dueDate ≥ today)
            const start = task.startDate ? new Date(task.startDate) : null;
            const due = task.dueDate ? new Date(task.dueDate) : null;
            if (start && !Number.isNaN(start.getTime())) {
                const startDay = new Date(start.getFullYear(), start.getMonth(), start.getDate());
                if (startDay <= todayStart) {
                    if (!due || Number.isNaN(due.getTime())) return true;
                    const dueDay = new Date(due.getFullYear(), due.getMonth(), due.getDate());
                    return dueDay >= todayStart;
                }
            }
            // If only dueDate = today
            if (due && !Number.isNaN(due.getTime())) return this.isSameDay(task.dueDate);
            return false;
        },

        get visibleTasks() {
            const q = this.taskSearch.trim().toLowerCase();
            const filtered = this.rawVisibleTasks
                .filter(task => {
                    if (this.activeFilter === 'today') return this.isTodayTask(task);
                    if (this.activeFilter === 'tomorrow') return this.isTomorrow(task);
                    if (this.activeFilter === 'week') return this.isTaskInThisWeek(task) || this.isTodayTask(task);
                    if (this.activeFilter === 'late') return this.isOverdue(task);
                    return true;
                })
                .filter(task => !q || [task.title, task.recordTitle, task.entityName, task.listLabel].filter(Boolean).join(' ').toLowerCase().includes(q));
            if (this.sortMode === 'recent') return filtered.sort((a, b) => this.latestTaskTime(b) - this.latestTaskTime(a));
            return filtered.sort((a, b) => this.sortDate(a) - this.sortDate(b));
        },

        get mainTitle() {
            if (this.activeList) return this.activeList.label || 'Liste de tâches';
            if (this.activeRecordId) return this.activeRecords[0]?.recordTitle || 'Tasks Hub';
            return 'Tasks Hub Perso';
        },
        get mainSubtitle() {
            if (this.activeList) return (this.activeRecord?.recordTitle || 'Record') + ' · liste de tâches';
            if (this.activeRecordId) return (this.activeRecords[0]?.entityName || 'Enregistrement') + ' · tâches du record';
            return 'Vos tâches, organisées simplement pour avancer chaque jour.';
        },

        // Filter counts (on rawVisibleTasks, before date filter)
        get lateFilterCount() { return this.rawVisibleTasks.filter(t => this.isOverdue(t)).length; },
        get todayFilterCount() { return this.rawVisibleTasks.filter(t => this.isTodayTask(t)).length; },
        get tomorrowFilterCount() { return this.rawVisibleTasks.filter(t => this.isTomorrow(t)).length; },
        get weekFilterCount() { return this.rawVisibleTasks.filter(t => this.isTaskInThisWeek(t) || this.isTodayTask(t)).length; },

        // Priority filtered tasks
        get priorityFilteredTasks() {
            if (this.priorityFilter === 'all') return this.visibleTasks;
            if (this.priorityFilter === 'Haute') return this.visibleTasks.filter(t => t.priority === 'Haute' || t.priority === 'Urgente');
            if (this.priorityFilter === 'Moyenne') return this.visibleTasks.filter(t => t.priority === 'Moyenne');
            if (this.priorityFilter === 'Normale') return this.visibleTasks.filter(t => !t.priority || t.priority === 'Aucune' || t.priority === 'Basse' || t.priority === 'Normale');
            return this.visibleTasks;
        },

        // Priority sections: Haute, Moyenne, Normale
        get prioritySections() {
            const groups = [
                { key:'high', title:'Priorité haute', icon:'solar:flag-bold', color:'#ef4444', bg:'#fef2f2', priorities:['Haute','Urgente'] },
                { key:'medium', title:'Priorité moyenne', icon:'solar:flag-bold', color:'#f97316', bg:'#fff7ed', priorities:['Moyenne'] },
                { key:'normal', title:'Priorité normale', icon:'solar:flag-bold', color:'#10b981', bg:'#ecfdf5', priorities:['Basse','Normale','Aucune',''] }
            ];
            const tasks = this.priorityFilteredTasks.filter(t => !this.isDone(t));
            return groups.map(g => ({ ...g, tasks: tasks.filter(t => g.priorities.includes(t.priority || 'Aucune')).sort((a, b) => this.sortDate(a) - this.sortDate(b)) }));
        },

        get quickAddPlaceholder() {
            if (this.activeList) return 'Ajouter dans ' + this.activeList.label;
            if (this.activeRecord) return 'Ajouter dans ' + this.activeRecord.recordTitle + ' · Liste des tâches';
            return 'Ajouter dans Espace perso · Liste des tâches';
        },
        get workloadBars() {
            const labels = ['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'];
            const counts = [0,0,0,0,0,0,0];
            this.rawVisibleTasks.forEach(task => {
                const value = task.startDate || task.dueDate;
                const date = value ? new Date(value) : null;
                if (!date || Number.isNaN(date.getTime())) return;
                const day = (date.getDay() + 6) % 7;
                counts[day]++;
            });
            const max = Math.max(1, ...counts);
            return labels.map((label, index) => ({ label, height: Math.max(10, Math.round((counts[index] / max) * 92)) }));
        },
        get weekTaskCount() { return this.rawVisibleTasks.filter(task => this.isTaskInThisWeek(task)).length; },

        async openTask(task) {
            const self = this;
            Alpine.store('taskModal').open(task, {
                onUpdate: () => self.loadHub(),
                onDelete: () => self.loadHub(),
            });
        },
        closeTask() { Alpine.store('taskModal').close(); },
        async updateTaskField(task, field, value) {
            Alpine.store('taskModal').updateField(field, value);
        },
        async deleteTask(task) {
            Alpine.store('taskModal').task = task;
            Alpine.store('taskModal')._onDelete = () => this.loadHub();
            Alpine.store('taskModal').remove();
        },
        async toggleTaskStatus(task) {
            if (!task?._id) return;
            const newStatus = this.isDone(task) ? 'À faire' : 'Terminé';
            try {
                await fetch(API + '/api/record-tasks/' + task._id, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ status: newStatus })
                });
                await this.loadHub();
                if (window.showMessage) window.showMessage(newStatus === 'Terminé' ? 'Tâche terminée' : 'Tâche rouverte', 'success');
            } catch (e) { console.error('[TasksHub] Toggle error:', e); }
        },
        toDateInputValue(value) {
            if (!value) return '';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '';
            return d.toISOString().split('T')[0];
        },
        showQuickAdd(status = 'À faire', priority = 'Aucune') {
            this.quickAddStatus = status || 'À faire';
            this.quickAddPriority = priority || 'Aucune';
            this.addingTask = true;
            this.addError = '';
            this.$nextTick(() => this.$refs.newTaskInput?.focus());
        },
        cancelQuickAdd() {
            if (this.creatingTask) return;
            this.addingTask = false;
            this.newTaskTitle = '';
            this.quickAddStatus = 'À faire';
            this.quickAddPriority = 'Aucune';
            this.addError = '';
        },
        async createPersonalTask() {
            const title = String(this.newTaskTitle || '').trim();
            if (!title || this.creatingTask) return;
            this.creatingTask = true;
            this.addError = '';
            try {
                const res = await fetch(API + '/api/tasks-hub/personal-tasks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ title, status: this.quickAddStatus || 'À faire', priority: this.quickAddPriority || 'Aucune', startDate: new Date().toISOString().split('T')[0], taskListId: this.activeListId || '' }) });
                const data = await res.json();
                if (!data.success) throw new Error(data.error || 'Impossible de créer la tâche');
                this.newTaskTitle = '';
                this.quickAddStatus = 'À faire';
                if (!this.activeListId && !this.activeRecordId) this.activeScope = 'personal';
                this.activeFilter = 'all';
                this.taskSearch = '';
                await this.loadHub();
                this.$nextTick(() => this.$refs.newTaskInput?.focus());
                if (window.showMessage) window.showMessage('Tâche ajoutée dans ' + (this.activeList?.label || 'Espace perso · Liste des tâches'), 'success');
            } catch (e) {
                console.error('[TasksHub] Create task error:', e);
                this.addError = e.message || 'Impossible de créer la tâche';
                if (window.showMessage) window.showMessage(this.addError, 'danger');
            } finally { this.creatingTask = false; }
        },

        // ═══ Helpers ═══
        isDone(task) { return (task.status || '').toLowerCase() === 'terminé'; },
        isOverdue(task) {
            if (this.isDone(task) || !task.dueDate) return false;
            const due = new Date(task.dueDate);
            if (Number.isNaN(due.getTime())) return false;
            due.setHours(23,59,59,999);
            return due < new Date();
        },
        isToday(task) { return task.dueDate ? this.isSameDay(task.dueDate) : false; },
        isTomorrow(task) {
            const d = task.dueDate ? new Date(task.dueDate) : null;
            if (!d || Number.isNaN(d.getTime())) return false;
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            return d.getFullYear() === tomorrow.getFullYear() && d.getMonth() === tomorrow.getMonth() && d.getDate() === tomorrow.getDate();
        },
        isTaskInThisWeek(task) { return this.isDateThisWeek(task.startDate) || this.isDateThisWeek(task.dueDate); },
        isSameDay(value) {
            if (!value) return false;
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return false;
            const n = new Date();
            return d.getFullYear() === n.getFullYear() && d.getMonth() === n.getMonth() && d.getDate() === n.getDate();
        },
        isDateThisWeek(value) {
            if (!value) return false;
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return false;
            const n = new Date();
            const start = new Date(n); start.setHours(0,0,0,0);
            const end = new Date(start); end.setDate(end.getDate() + 7);
            return d >= start && d <= end;
        },
        latestTaskTime(task) {
            const dates = [task.updatedAt, task.createdAt].map(v => v ? new Date(v).getTime() : 0).filter(v => Number.isFinite(v));
            return dates.length ? Math.max(...dates) : 0;
        },
        taskDisplayDate(task) { return task.startDate || task.dueDate || task.updatedAt || task.createdAt; },
        sortDate(task) {
            const d = task.startDate ? new Date(task.startDate) : (task.dueDate ? new Date(task.dueDate) : new Date(task.createdAt || Date.now()));
            return Number.isNaN(d.getTime()) ? Date.now() : d.getTime();
        },
        formatDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '—';
            return d.toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit', year:'2-digit' });
        },
        formatLongDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '—';
            return d.toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' });
        },
        formatRelativeDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '—';
            const now = new Date();
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const target = new Date(d.getFullYear(), d.getMonth(), d.getDate());
            const diff = Math.round((target - today) / 86400000);
            if (diff === 0) return "Aujourd'hui";
            if (diff === 1) return 'Demain';
            if (diff === -1) return 'Hier';
            if (diff < -1) return 'Il y a ' + Math.abs(diff) + 'j';
            if (diff <= 7) return d.toLocaleDateString('fr-FR', { weekday: 'long' });
            return d.toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit', year:'2-digit' });
        },
        // Priority label: Basse → Normale
        priorityLabel(priority) {
            if (!priority || priority === 'Aucune') return 'Normale';
            if (priority === 'Basse') return 'Normale';
            return priority;
        },
        priorityStyle(priority) {
            const map = { Urgente:['#fee2e2','#dc2626'], Haute:['#fef2f2','#ef4444'], Moyenne:['#fff7ed','#f97316'], Basse:['#ecfdf5','#10b981'], Normale:['#ecfdf5','#10b981'], Aucune:['#f1f5f9','#64748b'] };
            const [bg, color] = map[priority || 'Aucune'] || map.Aucune;
            return `background:${bg};color:${color}`;
        },
        colorSoft(color) {
            const hex = color || '#6366f1';
            return String(hex).startsWith('#') ? hex + '16' : 'rgba(99,102,241,.09)';
        }
    }));
});
</script>
