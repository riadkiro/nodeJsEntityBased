	        },

	        // ── Interactive widget task adapters ──
	        todayDateKey(offsetDays = 0) {
	            const date = new Date();
	            date.setHours(12, 0, 0, 0);
	            date.setDate(date.getDate() + Number(offsetDays || 0));
	            return [
	                date.getFullYear(),
	                String(date.getMonth() + 1).padStart(2, '0'),
	                String(date.getDate()).padStart(2, '0')
	            ].join('-');
	        },
	        normalizeDayDateKey(value) {
	            if (!value) return this.todayDateKey();
	            if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) return value;
	            const date = new Date(value);
	            if (Number.isNaN(date.getTime())) return this.todayDateKey();
	            return this.dateKeyFromDate(date);
	        },
	        dateKeyFromDate(date) {
	            if (!(date instanceof Date) || Number.isNaN(date.getTime())) return this.todayDateKey();
	            return [
	                date.getFullYear(),
	                String(date.getMonth() + 1).padStart(2, '0'),
	                String(date.getDate()).padStart(2, '0')
	            ].join('-');
	        },
	        todayWidgetDate(wid) {
	            return this.normalizeDayDateKey(this.todayWidgetDates?.[wid] || this.todayDateKey());
	        },
	        todayWidgetMode(wid) {
	            return this.todayWidgetModes?.[wid] || 'date';
	        },
	        todayWidgetIsOverdue(wid) {
	            return this.todayWidgetMode(wid) === 'overdue';
	        },
	        setTodayWidgetMode(wid, mode = 'date') {
	            if (!wid) return;
	            this.todayWidgetModes = {
	                ...(this.todayWidgetModes || {}),
	                [wid]: mode
	            };
	            this.bumpHomeTaskRender(wid);
	            this.$nextTick(() => this.refreshHomeTaskSortables());
	        },
	        setTodayWidgetDate(wid, value) {
	            if (!wid) return;
	            const dateKey = this.normalizeDayDateKey(value);
	            this.todayWidgetDates = {
	                ...(this.todayWidgetDates || {}),
	                [wid]: dateKey
	            };
	            this.todayWidgetModes = {
	                ...(this.todayWidgetModes || {}),
	                [wid]: 'date'
	            };
	            this.bumpHomeTaskRender(wid);
	            this.$nextTick(() => this.refreshHomeTaskSortables());
	        },
	        openTodayWidgetDatePicker(event, wid) {
	            this.closeHomeTaskMenu();
	            if (window.DxDatePicker && typeof window.DxDatePicker.open === 'function') {
	                window.DxDatePicker.open({
	                    anchor: event?.currentTarget,
	                    type: 'date',
	                    value: this.todayWidgetDate(wid),
	                    onSelect: value => this.setTodayWidgetDate(wid, value)
	                });
	                return;
	            }
	            const fallback = window.prompt('Choisir une date (AAAA-MM-JJ)', this.todayWidgetDate(wid));
	            if (fallback) this.setTodayWidgetDate(wid, fallback);
	        },
	        closeTodayWidgetCalendar() {
	            if (window.DxDatePicker && typeof window.DxDatePicker.close === 'function') {
	                window.DxDatePicker.close();
	            }
	        },
	        resetTodayWidgetDate(wid) {
	            this.setTodayWidgetDate(wid, this.todayDateKey());
	            this.closeTodayWidgetCalendar();
	        },
	        selectTomorrowTodayWidget(wid) {
	            this.setTodayWidgetDate(wid, this.todayDateKey(1));
	            this.closeTodayWidgetCalendar();
	        },
	        selectOverdueTodayWidget(wid) {
	            this.setTodayWidgetMode(wid, 'overdue');
	            this.closeTodayWidgetCalendar();
	        },
	        todayWidgetIsToday(wid) {
	            return !this.todayWidgetIsOverdue(wid) && this.todayWidgetDate(wid) === this.todayDateKey();
	        },
	        todayWidgetIsTomorrow(wid) {
	            return !this.todayWidgetIsOverdue(wid) && this.todayWidgetDate(wid) === this.todayDateKey(1);
	        },
	        todayWidgetHasCustomDate(wid) {
	            return !this.todayWidgetIsOverdue(wid) && !this.todayWidgetIsToday(wid) && !this.todayWidgetIsTomorrow(wid);
	        },
	        formatDayDateKey(dateKey, options = {}) {
	            const key = this.normalizeDayDateKey(dateKey);
	            const [year, month, day] = key.split('-').map(Number);
	            const date = new Date(year, month - 1, day);
	            const format = options.long
	                ? { day: 'numeric', month: 'long' }
	                : { day: 'numeric', month: 'short' };
	            return date.toLocaleDateString('fr-FR', format).replace('.', '');
	        },
	        todayWidgetDatePhrase(wid) {
	            if (this.todayWidgetIsOverdue(wid)) return 'les tâches en retard';
	            if (this.todayWidgetIsToday(wid)) return "aujourd'hui";
	            if (this.todayWidgetIsTomorrow(wid)) return 'demain';
	            return 'le ' + this.formatDayDateKey(this.todayWidgetDate(wid), { long: true });
	        },
	        todayWidgetSelectedLabel(wid) {
	            return this.formatDayDateKey(this.todayWidgetDate(wid));
	        },
	        todayWidgetEmptyLabel(wid) {
	            if (this.todayWidgetIsOverdue(wid)) return 'Aucune tâche en retard';
	            if (this.todayWidgetIsToday(wid)) return 'Aucune tâche pour le moment';
	            return 'Aucune tâche pour ' + this.todayWidgetDatePhrase(wid);
	        },
	        todayWidgetAddPlaceholder(wid) {
	            if (this.todayWidgetIsOverdue(wid)) return 'Ajouter une tâche...';
	            if (this.todayWidgetIsToday(wid)) return 'Ajouter une tâche...';
	            return 'Ajouter une tâche pour ' + this.todayWidgetDatePhrase(wid) + '...';
	        },
	        taskScheduleDateKey(task = {}) {
	            const value = task.dueDate || task.startDate;
	            if (!value) return '';
	            const useLocal = this.dateValueHasExplicitTime(value);
	            return this.taskDateKey(value, useLocal);
	        },
	        taskMatchesTodayWidgetDate(task, wid) {
	            const selected = this.todayWidgetDate(wid);
	            const scheduled = this.taskScheduleDateKey(task);
	            if (scheduled) return scheduled === selected;
	            return selected === this.todayDateKey();
	        },
	        todayWidgetSourceTasks(wid) {
	            const list = this.homeTaskListForWidget(wid);
	            if (list) return (list.tasks || []).filter(t => t && (t._id || t.id));
	            const selected = this.todayWidgetDate(wid);
	            const byId = new Map();
	            const addTask = task => {
	                const id = this.homeTaskId(task);
	                if (id && !byId.has(id)) byId.set(id, task);
	            };
	            (this.todayTasks || []).forEach(addTask);
	            (this.allTasks || []).forEach(task => {
	                if (this.taskScheduleDateKey(task) === selected) addTask(task);
	            });
	            const source = Array.from(byId.values());
	            return source.filter(t => t && (t._id || t.id));
	        },
	        todayWidgetDateTasks(wid) {
	            if (this.todayWidgetIsOverdue(wid)) return this.todayWidgetOverdueTasks(wid);
	            return this.todayWidgetSourceTasks(wid)
	                .filter(task => this.taskMatchesTodayWidgetDate(task, wid));
	        },
	        todayWidgetTasks(wid) {
	            const all = this.todayWidgetDateTasks(wid);
	            if (!this.homeTaskListForWidget(wid)) return all;
	            return all.slice(0, this.widgetLimit(wid, 8));
	        },
		        todayWidgetOpenTasks(wid) {
		            const all = this.todayWidgetDateTasks(wid);
		            return all.filter(t => t.status !== 'Terminé');
		        },
		        todayWidgetOverdueTasks(wid) {
		            const list = this.homeTaskListForWidget(wid);
		            const source = list
		                ? (list.tasks || [])
		                : [...(this.allTasks || []), ...(this.todayTasks || [])];
		            const seen = new Set();
		            return source.filter(task => {
		                const id = this.homeTaskId(task);
		                if (!id || seen.has(id) || task.status === 'Terminé' || !this.isOverdue(task)) return false;
		                seen.add(id);
		                return true;
		            });
		        },
		        todayWidgetOverdueCount(wid) {
		            return this.todayWidgetOverdueTasks(wid).length;
		        },
		        todayWidgetShowCompletedInline(wid) {
		            return this.widgetOption(wid, 'hideCompleted', false) === true
		                || this.widgetOption(wid, 'showCompleted', false) === true;
	        },
	        todayWidgetCompletedPanelEnabled(wid) {
	            return this.widgetOption(wid, 'showCompletedPanel', true) !== false;
	        },
	        todayWidgetVisibleTasks(wid) {
	            const all = this.todayWidgetTasks(wid);
	            if (this.todayWidgetShowCompletedInline(wid)) return all;
	            return all.filter(t => t.status !== 'Terminé');
	        },
	        completedTodayTasks() {
	            const now = new Date();
	            const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
	            const todayEnd = todayStart + 86400000;
	            const allSources = [...(this.completedTodayData || []), ...(this.todayTasks || []), ...(this.allTasks || [])];
	            // De-duplicate by id
	            const seen = new Set();
	            const result = [];
	            for (const t of allSources) {
	                const id = t?._id || t?.id;
	                if (!id || seen.has(id)) continue;
	                seen.add(id);
	                if (t.status !== 'Terminé') continue;
	                const cAt = t.completedAt ? new Date(t.completedAt).getTime() : 0;
	                const uAt = t.updatedAt ? new Date(t.updatedAt).getTime() : 0;
	                const checkTime = cAt || uAt;
	                if (checkTime >= todayStart && checkTime < todayEnd) {
	                    result.push(t);
	                }
	            }
	            return result.sort((a, b) => this.compareCompletedHomeTasks(a, b));
	        },
	        completedHomeTaskTimestamp(value) {
	            const time = new Date(value || 0).getTime();
	            return Number.isNaN(time) ? 0 : time;
	        },
	        compareCompletedHomeTasks(a = {}, b = {}) {
	            const at = this.completedHomeTaskTimestamp(a.completedAt || a.updatedAt);
	            const bt = this.completedHomeTaskTimestamp(b.completedAt || b.updatedAt);
	            if (at !== bt) return bt - at;
	            const ao = Number.isFinite(Number(a.order)) ? Number(a.order) : 0;
	            const bo = Number.isFinite(Number(b.order)) ? Number(b.order) : 0;
	            if (ao !== bo) return ao - bo;
	            return this.completedHomeTaskTimestamp(b.createdAt) - this.completedHomeTaskTimestamp(a.createdAt);
	        },
	        completedTodayDayTasks(wid = null) {
	            if (!wid || this.todayWidgetIsToday(wid)) {
	                return this.completedTodayTasks();
	            }
	            const source = wid ? this.todayWidgetDateTasks(wid) : (this.todayTasks || []);
	            return source
	                .filter(t => t && t.status === 'Terminé')
	                .sort((a, b) => this.compareCompletedHomeTasks(a, b));
	        },
	        completedDayTitle(wid) {
	            const phrase = this.todayWidgetDatePhrase(wid);
	            const prefix = this.todayWidgetIsToday(wid) ? 'Terminées ' : 'Terminées pour ';
	            return prefix + phrase + ' (' + this.completedTodayDayTasks(wid).length + ')';
	        },
	        completedDayEmptyLabel(wid) {
	            const phrase = this.todayWidgetDatePhrase(wid);
	            return this.todayWidgetIsToday(wid)
	                ? 'Aucune tâche terminée ' + phrase
	                : 'Aucune tâche terminée pour ' + phrase;
	        },
	        allWidgetTasks(wid) {
	            const list = this.homeTaskListForWidget(wid);
	            if (list) return this.homeTaskWidgetItems(wid);
	            return (this.allTasks || []).filter(t => t && (t._id || t.id));
	        },
	        async toggleTodayTaskItem(wid, task) {
	            // If it's a task-list widget, delegate
	            const list = this.homeTaskListForWidget(wid);
	            if (list) return this.toggleHomeTaskItem(wid, task);
	            // Direct API toggle
	            if (!task?._id && !task?.id) return;
	            const id = task._id || task.id;
	            const prevStatus = task.status;
	            const prevStatusColor = task.statusColor;
	            const prevCompletedAt = task.completedAt;
	            const nextStatus = prevStatus === 'Terminé' ? 'À faire' : 'Terminé';
	            task.status = nextStatus;
	            task.statusColor = nextStatus === 'Terminé' ? '#22c55e' : '#9ca3af';
	            task.completedAt = nextStatus === 'Terminé' ? new Date().toISOString() : null;
	            this.patchHomeTaskEverywhere(id, { status: nextStatus, statusColor: task.statusColor, completedAt: task.completedAt });
	            this.syncCompletedTodayData(id, task);
	            try {
	                const res = await fetch(`/account/${_accountNumber}/api/record-tasks/${id}`, {
	                    method: 'PUT',
	                    headers: { 'Content-Type': 'application/json' },
		                    credentials: 'include',
		                    body: JSON.stringify({ status: nextStatus })
		                });
		                const data = await res.json().catch(() => ({}));
		                if (!res.ok || data.success === false) throw new Error(data.error || 'Mise à jour impossible');
		                const serverTask = data.task ? this.normalizeHomeTask({ ...task, ...data.task }) : task;
		                task.status = serverTask.status || nextStatus;
		                task.statusColor = serverTask.statusColor || task.statusColor;
		                task.completedAt = task.status === 'Terminé' ? (serverTask.completedAt || task.completedAt || new Date().toISOString()) : null;
		                this.patchHomeTaskEverywhere(id, { status: task.status, statusColor: task.statusColor, completedAt: task.completedAt });
		                this.syncCompletedTodayData(id, task);
		            } catch (e) {
	                task.status = prevStatus;
	                task.statusColor = prevStatusColor;
	                task.completedAt = prevCompletedAt;
	                this.patchHomeTaskEverywhere(id, { status: prevStatus, statusColor: prevStatusColor, completedAt: prevCompletedAt });
	                this.syncCompletedTodayData(id, task);
	                window.showMessage && window.showMessage(e.message || 'Erreur', 'danger');
	            }
	        },
	        async addTodayTask(wid) {
	            // If it's a task-list widget, delegate
	            const list = this.homeTaskListForWidget(wid);
	            if (list) return this.addHomeTaskItem(wid);
	            // Add as personal task via hub API
	            const title = String(this.newTaskTitles[wid] || '').trim();
		            if (!title) return;
		            this.newTaskTitles[wid] = '';
		            const selectedDate = this.todayWidgetDate(wid);
		            try {
		                const res = await fetch(`/account/${_accountNumber}/api/tasks-hub/personal-tasks`, {
		                    method: 'POST',
		                    headers: { 'Content-Type': 'application/json' },
	                    credentials: 'include',
	                    body: JSON.stringify({
		                        title,
		                        status: 'À faire',
		                        priority: 'Aucune',
		                        isDayPriority: wid === 'priority-day' || wid === 'today-tasks',
		                        startDate: selectedDate
		                    })
		                });
	                const data = await res.json().catch(() => ({}));
	                if (!data.success || !data.task) throw new Error(data.error || 'Ajout impossible');
	                const normalized = this.normalizeHomeTask(data.task);
	                this.allTasks = [...(this.allTasks || []), normalized];
	                if (wid === 'priority-day' || wid === 'today-tasks') {
	                    this.todayTasks = [...(this.todayTasks || []), normalized];
	                }
	                this.bumpHomeTaskRender(wid);
	            } catch (e) {
	                this.newTaskTitles[wid] = title;
	                window.showMessage && window.showMessage(e.message || 'Ajout impossible', 'danger');
	            }
	        },
	        startEditTodayTask(wid, task) {
	            const list = this.homeTaskListForWidget(wid);
	            if (list) return this.startEditHomeTask(wid, task);
	            const id = task._id || task.id;
	            if (!id) return;
	            this.editingHomeTaskId = id;
	            this.editingHomeTaskWidgetId = wid;
	            this.editingHomeTaskTitle = task.title || '';
	            this.$nextTick(() => {
	                const input = Array.from(this.$el?.querySelectorAll?.('.dx-task-edit') || [])
	                    .find(el => String(el.dataset.taskId || '') === id);
	                if (input) { input.focus(); input.select(); }
	            });
	        },
	        async saveEditTodayTask(wid, task) {
	            const list = this.homeTaskListForWidget(wid);
	            if (list) return this.saveEditHomeTask(wid, task);
	            const id = task._id || task.id;
	            if (!id || this.editingHomeTaskId !== id) return;
	            const title = String(this.editingHomeTaskTitle || '').trim();
	            if (!title || title === task.title) { this.cancelEditHomeTask(); return; }
	            this.cancelEditHomeTask();
	            const prevTitle = task.title;
	            task.title = title;
	            this.patchHomeTaskEverywhere(id, { title });
	            try {
	                const res = await fetch(`/account/${_accountNumber}/api/record-tasks/${id}`, {
	                    method: 'PUT',
	                    headers: { 'Content-Type': 'application/json' },
	                    credentials: 'include',
	                    body: JSON.stringify({ title })
	                });
	                const data = await res.json().catch(() => ({}));
	                if (!res.ok || data.success === false) throw new Error(data.error || 'Modification impossible');
	            } catch (e) {
	                task.title = prevTitle;
	                this.patchHomeTaskEverywhere(id, { title: prevTitle });
	                window.showMessage && window.showMessage(e.message || 'Erreur', 'danger');
	            }
	        },
	        homeEventItems(kind = 'upcoming') {
	            const source = kind === 'important' ? this.importantDates : this.upcomingEvents;
	            const dynamic = (source || []).map(ev => ({
	                ...ev,
	                day: ev.day || this.datePart(ev.date, 'day'),
	                month: ev.month || this.datePart(ev.date, 'month'),
	                url: ev.url || `/account/${_accountNumber}/agenda`
	            }));
	            return dynamic.length ? dynamic : this.fallbackEvents(kind);
	        },
	        eventRecordLabel(ev) {
	            const record = String(ev?.recordTitle || '').trim();
	            if (record && !['Record inconnu', 'Sans titre'].includes(record)) return record;
	            const entity = String(ev?.entityName || '').trim();
	            return entity && entity !== 'Sans entité' ? entity : '';
	        },
	        eventRecordIcon(ev) {
	            return ev?.recordIcon || ev?.entityIcon || 'solar:folder-bold-duotone';
	        },
	        eventRecordColor(ev) {
	            return ev?.recordColor || ev?.entityColor || ev?.color || '#4361ee';
	        },
	        taskRecordLabel(task) {
	            const record = String(task?.recordTitle || '').trim();
	            if (record && !['Record inconnu', 'Sans titre', 'Espace perso'].includes(record)) return record;
	            return '';
	        },
	        taskListLabel(task) {
	            const label = String(task?.listLabel || '').trim();
	            if (label && !['Record inconnu', 'Sans titre', 'Espace perso'].includes(label)) return label;
	            return 'Liste des t\u00e2ches';
	        },
	        homeTaskSubtitleVisible(wid, task) {
	            return !!this.homeTaskSubtitleLabel(wid, task);
	        },
	        homeTaskSubtitleRowVisible(wid, task) {
	            return this.homeTaskSubtitleVisible(wid, task)
	                || this.taskHasReminder(task)
	                || (this.homeTaskAttachmentsEnabled(wid) && this.taskHasAttachments(task));
	        },
	        homeTaskSubtitleLabel(wid, task) {
	            const record = this.taskRecordLabel(task);
	            if (record && this.homeTaskRecordEnabled(wid)) return record;
	            return this.homeTaskListEnabled(wid) ? this.taskListLabel(task) : '';
	        },
	        homeTaskSubtitleIcon(wid, task) {
	            const record = this.taskRecordLabel(task);
	            return record && this.homeTaskRecordEnabled(wid) ? this.taskRecordIcon(task) : 'solar:list-check-bold-duotone';
	        },
	        homeTaskSubtitleColor(wid, task) {
	            const record = this.taskRecordLabel(task);
	            if (record && this.homeTaskRecordEnabled(wid)) return this.taskRecordColor(task);
	            return task?.listColor || '#805dca';
	        },
	        homeTaskRowAccentColor(task) {
	            const label = this.homeTaskPriorityLabel(task?.priority);
	            if (!label || label === 'Aucune') return '#cbd5e1';
	            return task?.priorityColor || this.homeTaskPriorityColor(task?.priority, task) || '#ef4444';
	        },
	        taskRecordSubtitle(task) {
	            return this.taskRecordLabel(task) || 'Liste des t\u00e2ches';
	        },
	        taskRecordSubtitleIcon(task) {
	            return this.taskRecordLabel(task) ? this.taskRecordIcon(task) : 'solar:list-check-bold-duotone';
	        },
	        taskRecordSubtitleColor(task) {
	            return this.taskRecordLabel(task) ? this.taskRecordColor(task) : '#805dca';
	        },
	        taskRecordIcon(task) {
	            return task?.recordIcon || task?.entityIcon || 'solar:folder-bold-duotone';
	        },
	        taskRecordColor(task) {
	            return task?.recordColor || task?.entityColor || '#4361ee';
	        },
	        taskRecordItems() {
	            const dynamic = (this.tasksByRecord || []).map((record, idx) => ({
	                id: record.id || 'record_task_' + idx,
	                title: record.title || 'Sans titre',
	                meta: record.entityName || 'Record',
	                open: record.openTasks || record.open || 0,
	                icon: record.icon || 'solar:folder-bold-duotone',
	                color: record.color || '#4361ee',
	                link: record.link || `/account/${_accountNumber}/tasks`
	            }));
	            if (dynamic.length) return dynamic;
	            return [
	                { id: 'r1', title: 'Clio 4', meta: '2 échéances actives', open: 2, icon: 'solar:car-bold-duotone', color: '#4361ee', link: `/account/${_accountNumber}/tasks` },
	                { id: 'r2', title: 'Maison', meta: '3 tâches restantes', open: 3, icon: 'solar:home-bold-duotone', color: '#10b981', link: `/account/${_accountNumber}/tasks` },
	                { id: 'r3', title: 'Famille', meta: '1 rappel important', open: 1, icon: 'solar:users-group-rounded-bold-duotone', color: '#f97316', link: `/account/${_accountNumber}/tasks` }
	            ];
	        },
	        activityItems() {
	            const dynamic = (this.recentRecords || []).map((rec, idx) => ({
	                id: rec.id || 'act_' + idx,
	                title: rec.title || 'Record modifié',
	                meta: `${rec.entityName || 'Record'} · ${this.timeAgo(rec.updatedAt) || 'aujourd’hui'}`,
	                icon: rec.icon || 'solar:folder-bold-duotone',
	                color: rec.color || '#4361ee',
	                link: rec.link || `/account/${_accountNumber}/home`
	            }));
	            if (dynamic.length) return dynamic;
	            return [
	                { id: 'a1', title: 'Facture Électricité.pdf', meta: 'Ajouté il y a 2h', icon: 'solar:bill-list-bold-duotone', color: '#ef4444', link: `/account/${_accountNumber}/home` },
	                { id: 'a2', title: 'Paiement Netflix', meta: '-9,99€ · Aujourd’hui', icon: 'solar:play-bold-duotone', color: '#111827', link: `/account/${_accountNumber}/home` },
	                { id: 'a3', title: 'Note Pédiatre Adam', meta: 'Modifiée il y a 3h', icon: 'solar:notes-bold-duotone', color: '#f59e0b', link: `/account/${_accountNumber}/home` },
	                { id: 'a4', title: 'Assurance Clio 4', meta: 'Rappel créé · Hier', icon: 'solar:car-bold-duotone', color: '#4361ee', link: `/account/${_accountNumber}/home` },
	                { id: 'a5', title: 'Anniversaire Maman', meta: 'Dans 4 jours · 20 Juin', icon: 'solar:gift-bold-duotone', color: '#ec4899', link: `/account/${_accountNumber}/home` }
	            ];
	        },
	        dateValueHasExplicitTime(value) {
	            if (!value) return false;
	            if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
	            const date = new Date(value);
	            if (Number.isNaN(date.getTime())) return false;
	            return date.getUTCHours() !== 0
	                || date.getUTCMinutes() !== 0
	                || date.getUTCSeconds() !== 0
	                || date.getUTCMilliseconds() !== 0;
	        },
	        taskDateKey(value, useLocal = false) {
	            if (!value) return '';
	            const date = new Date(value);
	            if (Number.isNaN(date.getTime())) return '';
	            if (!useLocal) return date.toISOString().split('T')[0];
	            return [
	                date.getFullYear(),
	                String(date.getMonth() + 1).padStart(2, '0'),
	                String(date.getDate()).padStart(2, '0')
	            ].join('-');
	        },
	        taskDayDiff(value, useLocal = false) {
	            const key = this.taskDateKey(value, useLocal);
	            if (!key) return 0;
	            const todayKey = this.todayDateKey();
	            const toUtcDay = raw => {
	                const [year, month, day] = raw.split('-').map(Number);
	                return Date.UTC(year, month - 1, day);
	            };
	            return Math.round((toUtcDay(key) - toUtcDay(todayKey)) / 86400000);
	        },
	        taskTime(task) {
	            const value = task?.dueDate || task?.startDate;
	            if (!value || !this.dateValueHasExplicitTime(value)) return '';
	            const date = new Date(value);
	            if (Number.isNaN(date.getTime())) return '';
	            return date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', hour12: false });
	        },
	        taskDateLabel(task) {
	            const value = task?.dueDate || task?.startDate;
	            if (!value) return '';
	            const date = new Date(value);
	            if (Number.isNaN(date.getTime())) return '';
	            const hasTime = this.dateValueHasExplicitTime(value);
	            const diffDays = this.taskDayDiff(value, hasTime);
	            const labelDate = hasTime ? date : (() => {
	                const [year, month, day] = this.taskDateKey(value, false).split('-').map(Number);
	                return new Date(year, month - 1, day);
	            })();
	            if (diffDays === 0) return "Aujourd'hui";
	            if (diffDays === 1) return 'Demain';
	            if (diffDays === -1) return 'Hier';
	            if (diffDays < -1) return labelDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }).replace('.', '');
	            if (diffDays <= 6) return labelDate.toLocaleDateString('fr-FR', { weekday: 'short' }).replace('.', '');
	            return labelDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }).replace('.', '');
	        },
	        taskDueLabel(task) {
	            if (!task?.dueDate || task?.status === 'Terminé') return '';
	            const date = new Date(task.dueDate);
	            if (Number.isNaN(date.getTime())) return '';
	            const hasTime = this.dateValueHasExplicitTime(task.dueDate);
	            if (!hasTime) {
	                const diffDays = this.taskDayDiff(task.dueDate, false);
	                if (diffDays < 0) return 'En retard';
	                return this.taskDateLabel(task);
	            }
	            const diffMs = date.getTime() - Date.now();
	            if (diffMs < 0) return 'En retard';
	            const minutes = Math.max(1, Math.round(diffMs / 60000));
	            if (minutes < 60) return `dans ${minutes} min`;
	            const hours = Math.round(minutes / 60);
	            if (hours < 24) return `dans ${hours}h`;
	            return [this.taskDateLabel(task), this.taskTime(task)].filter(Boolean).join(' ');
	        },
	        taskDueState(task) {
	            if (!task?.dueDate || task?.status === 'Terminé') return '';
	            const date = new Date(task.dueDate);
	            if (Number.isNaN(date.getTime())) return '';
	            if (this.dateValueHasExplicitTime(task.dueDate)) return date.getTime() < Date.now() ? 'overdue' : 'upcoming';
	            return this.taskDayDiff(task.dueDate, false) < 0 ? 'overdue' : 'upcoming';
	        },
	        taskDueTitle(task) {
	            if (!task?.dueDate) return '';
	            const date = new Date(task.dueDate);
	            if (Number.isNaN(date.getTime())) return '';
	            const hasTime = this.dateValueHasExplicitTime(task.dueDate);
	            const labelDate = hasTime ? date : (() => {
	                const [year, month, day] = this.taskDateKey(task.dueDate, false).split('-').map(Number);
	                return new Date(year, month - 1, day);
	            })();
	            const day = labelDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
	            const time = this.taskTime(task);
	            return `Échéance ${day}${time ? ' à ' + time : ''}`;
	        },
	        datePart(value, part) {
	            const date = new Date(value);
	            if (Number.isNaN(date.getTime())) return part === 'day' ? '--' : '';
	            if (part === 'day') return String(date.getDate()).padStart(2, '0');
	            return date.toLocaleDateString('fr-FR', { month: 'short' }).replace('.', '').toUpperCase();
	        },
	        isOverdue(task) {
	            if (!task || task.status === 'Terminé') return false;
	            if (task.dueDate) return this.taskDueState(task) === 'overdue';
	            if (!task.startDate) return false;
	            const date = new Date(task.startDate);
	            if (Number.isNaN(date.getTime())) return false;
	            return this.taskDayDiff(task.startDate, this.dateValueHasExplicitTime(task.startDate)) < 0;
	        },
        timeAgo(dateStr) {
            if (!dateStr) return '';
            const diff = Date.now() - new Date(dateStr).getTime();
            const mins = Math.floor(diff / 60000);
            if (mins < 1) return "À l'instant";
            if (mins < 60) return mins + ' min';
            const hrs = Math.floor(mins / 60);
            if (hrs < 24) return hrs + 'h';
            const days = Math.floor(hrs / 24);
            if (days < 7) return days + 'j';
            return new Date(dateStr).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
        }
    }));
});
</script>

<style>@keyframes spin { to { transform: rotate(360deg); } }</style>
