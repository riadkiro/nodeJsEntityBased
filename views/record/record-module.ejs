                            <td><span class="ov-lines-pill" style="background:rgba(249,115,22,.1);color:#f97316">Soir</span></td>
                            <td><span class="ov-lines-pill" style="background:rgba(99,102,241,.1);color:#6366f1">2x / jour</span></td>
                            <td><span class="ov-lines-pill" style="background:rgba(14,165,233,.1);color:#0ea5e9">7 jours</span></td>
