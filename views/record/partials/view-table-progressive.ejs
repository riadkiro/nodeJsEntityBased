<%#
  view-table-progressive.ejs
  
  React Island DataTable with Virtual Scrolling
  No more HTMX mode - React only
%>

<%
  // Build viewId for uniqueness
  const viewId = (typeof view !== 'undefined' && view._id) ? view._id.toString() : entity._id.toString();
  const viewDisplayName = (typeof view !== 'undefined' && view && view.name) ? view.name : entity.name;
  const newsletterHref = (typeof view !== 'undefined' && view && view.slug)
    ? `/account/${account_number}/record/${entity.slug}/${view.slug}/newsletter`
    : `/account/${account_number}/record/${entity.slug}/newsletter`;
%>

<!-- views/record/partials/view-table-progressive.ejs -->
<div class="flex flex-col h-[calc(100vh_-_120px)]">
    <div class="mb-4 flex items-center justify-between gap-3 flex-shrink-0">
        <ul class="flex space-x-2 rtl:space-x-reverse">
            <li>
                <a href="/account/<%= account_number %>/dashboard" class="text-primary hover:underline">Dashboard</a>
            </li>
            <li class="before:content-['/'] ltr:before:mr-1 rtl:before:ml-1">
                <span><%= viewDisplayName %></span>
            </li>
        </ul>
        <a href="<%= newsletterHref %>"
           class="inline-flex items-center gap-2 rounded-lg border border-[#dfe6f1] bg-white px-3 py-2 text-xs font-bold text-[#334155] transition hover:border-primary/40 hover:bg-primary/5 hover:text-primary dark:border-[#253b5c] dark:bg-[#0e1726] dark:text-white-dark"
           title="Configurer une newsletter pour cette liste">
            <iconify-icon icon="solar:letter-bold-duotone" width="16"></iconify-icon>
            Newsletter
        </a>
    </div>
    <div class="flex-1 min-h-0 overflow-hidden">
        <div id="records-grid-<%= viewId %>"
             data-island="records-grid"
             data-account-id="<%= typeof account !== 'undefined' && account ? account._id : '' %>"
             data-account-number="<%= account_number %>"
             data-entity-id="<%= entity._id %>"
             data-entity-name="<%= entity.name %>"
             data-entity-name-plural="<%= entity.namePlural || (entity.name + 's') %>"
             data-entity-slug="<%= entity.slug %>"
             data-view-id="<%= viewId %>"
             class="h-full sm:h-[calc(100vh_-_150px)] sm:min-h-0">
            <!-- Loading state while React mounts -->
            <div class="flex items-center justify-center h-64">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
            </div>
        </div>
        <link href="/assets/css/fullcalendar.min.css" rel="stylesheet" />
        <script src="/assets/js/fullcalendar.min.js"></script>
        <script type="module" src="/dist/recordsGrid.js?v=20260607-unique-filter"></script>
    </div>
</div>
