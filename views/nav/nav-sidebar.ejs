            x-collapse
            class="sub-menu text-gray-500 mx-4 mb-2"
          >
            <li x-data="{ subActive: null, hovered: false }">
              <div
                class="flex items-center hover:bg-gray-100 dark:text-[#888ea8] dark:hover:bg-gray-900"
                @mouseenter="hovered = true"
                @mouseleave="hovered = false"
              >
                <!-- Icône dossier -->
                <iconify-icon
                  :icon="(subActive === 'error' || hovered) ? 'solar:folder-2-broken' : 'solar:folder-2-line-duotone'"
                  class="ml-2"
                  width="16"
                  height="16"
                ></iconify-icon>

