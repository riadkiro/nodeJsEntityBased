	.tdm-conv-user{color:#64748b;font-size:10.5px;font-weight:700;line-height:1.3}
	.tdm-conv-text{color:#334155;font-size:12.5px;font-weight:500;line-height:1.5;white-space:pre-wrap;word-break:break-word}
	.tdm-conv-date{color:#bfc9d4;font-size:9.5px;font-weight:600;margin-top:3px}
	.tdm-activity-val{display:inline-flex;align-items:center;gap:4px;border-radius:5px;padding:1px 6px;font-size:9.5px;font-weight:700}
	.tdm-msg-wrap{padding:10px 12px;border-top:1px solid #f1f3f5;flex:0 0 auto}
	.tdm-chat-attachments{display:flex;flex-direction:column;gap:6px;margin-top:7px}
	.tdm-chat-attachment{border:1px solid #e8ecf1;border-radius:10px;background:#fff;color:#334155;font-family:inherit;text-align:left;padding:7px;display:flex;align-items:center;gap:8px;cursor:pointer;transition:all .14s;max-width:230px}
	.tdm-chat-attachment:hover{border-color:#c7d2fe;background:#f8faff}
	.tdm-chat-thumb{width:132px;max-width:100%;height:86px;border-radius:9px;object-fit:cover;display:block;background:#f8fafc}
	.tdm-chat-file-icon{width:28px;height:28px;border-radius:9px;background:#eef2ff;color:#4f46e5;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
	.tdm-chat-file-meta{min-width:0;display:flex;flex-direction:column;gap:2px}
	.tdm-chat-file-name{font-size:11.5px;font-weight:700;line-height:1.25;color:#1e293b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
	.tdm-chat-file-size{font-size:10px;font-weight:600;line-height:1.2;color:#94a3b8}
	.tdm-chat-pending{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
	.tdm-chat-pending-item{height:28px;max-width:170px;border:1px solid #e8ecf1;background:#fff;border-radius:8px;padding:0 6px;display:flex;align-items:center;gap:6px;color:#334155;font-size:11px;font-weight:600}
	.tdm-chat-pending-name{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
	.tdm-chat-pending-remove{width:18px;height:18px;border:0;border-radius:5px;background:transparent;color:#94a3b8;display:flex;align-items:center;justify-content:center;cursor:pointer}
	.tdm-chat-pending-remove:hover{background:#fef2f2;color:#ef4444}
	.tdm-chat-input-shell{border:1.5px solid #e8ecf1;border-radius:12px;background:#fff;padding:7px;transition:all .15s}
	.tdm-chat-input-shell:focus-within{border-color:#4361ee;box-shadow:0 0 0 3px #4361ee10}
	.tdm-chat-input-row{display:flex;align-items:flex-end;gap:7px}
	.tdm-chat-icon-btn{width:30px;height:30px;border:0;border-radius:9px;background:#f8fafc;color:#6366f1;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .14s;flex:0 0 auto}
	.tdm-chat-icon-btn:hover{background:#eef2ff;color:#4361ee}
	.tdm-chat-icon-btn:disabled{opacity:.55;cursor:not-allowed}
	.tdm-chat-send{background:#4361ee;color:#fff}
	.tdm-chat-send:hover{background:#3651d4;color:#fff}
	.tdm-chat-options{display:flex;justify-content:flex-end;margin-top:6px}
	.tdm-chat-toggle{border:0;background:transparent;color:#94a3b8;font-family:inherit;font-size:10.5px;font-weight:650;display:inline-flex;align-items:center;gap:6px;cursor:pointer;padding:0}
	.tdm-chat-toggle.active{color:#64748b}
	.tdm-chat-toggle-switch{width:28px;height:16px;border-radius:999px;background:#e0e6ed;position:relative;transition:background .15s;flex:0 0 auto}
	.tdm-chat-toggle-switch::after{content:'';position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(15,23,42,.18);transition:transform .15s}
	.tdm-chat-toggle.active .tdm-chat-toggle-switch{background:#4361ee}
	.tdm-chat-toggle.active .tdm-chat-toggle-switch::after{transform:translateX(12px)}
	.tdm-msg-input{width:100%;min-height:30px;max-height:98px;border:0;border-radius:0;color:#0e1726;font-family:inherit;font-size:12px;font-weight:500;line-height:1.5;padding:6px 2px;outline:none;background:transparent;resize:none}
.tdm-foot{height:58px;border-top:1px solid #f1f3f5;display:flex;align-items:center;justify-content:space-between;padding:0 24px;flex:0 0 auto}
.tdm-foot-created,.tdm-foot-esc{color:#bfc9d4;font-size:11px;font-weight:600}
.tdm-delete{height:36px;border:1.5px solid #fecaca;background:#fff;color:#ef4444;border-radius:9px;padding:0 14px;font-family:inherit;font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:6px;cursor:pointer;transition:all .14s}
.tdm-delete:hover{background:#fef2f2;border-color:#ef4444}
.tdm-hidden-input{display:none}

.dark .tdm-modal{background:#0e1726;color:#e0e6ed;box-shadow:0 32px 90px rgba(0,0,0,.45)}
.dark .tdm-head,.dark .tdm-main,.dark .tdm-props,.dark .tdm-conv,.dark .tdm-conv-head,.dark .tdm-msg-wrap,.dark .tdm-foot{border-color:#253b5c}
.dark .tdm-conv,.dark .tdm-attachment-drop{background:#0b1320}
	.dark .tdm-title-input,.dark .tdm-msg-input,.dark .tdm-prop-input,.dark .tdm-prop-date,.dark .tdm-prop-time,.dark .tdm-list-select,.dark .tdm-reminder-clear,.dark .tdm-option-popover,.dark .tdm-option-search,.dark .tdm-option-editor-input,.dark .tdm-assign-popover,.dark .tdm-invite-input{background:#111f35;border-color:#253b5c;color:#e0e6ed}
	.dark .tdm-desc-editor{background:#111f35;border-color:#253b5c}
	.dark .tdm-desc-toolbar{background:#111f35;border-color:#253b5c}
	.dark .tdm-desc-area{background:#111f35;color:#e0e6ed}
	.dark .tdm-desc-area h1,.dark .tdm-desc-area h2,.dark .tdm-desc-area h3{color:#e0e6ed}
	.dark .tdm-desc-area blockquote{background:#16264a;border-color:#2a3f72;color:#a8b5cf}
	.dark .tdm-desc-area img{border-color:#253b5c}
	.dark .tdm-option-row{color:#e0e6ed}
	.dark .tdm-option-row:hover,.dark .tdm-option-row.active,.dark .tdm-assign-row:hover,.dark .tdm-assign-row.active{background:#1b2e4b}
	.dark .tdm-attachment-item,.dark .tdm-conv-entry,.dark .tdm-chat-bubble,.dark .tdm-chat-attachment,.dark .tdm-chat-pending-item,.dark .tdm-chat-input-shell{background:#111f35;border-color:#253b5c}
	.dark .tdm-subtask-input,.dark .tdm-subtask-add-btn,.dark .tdm-subtask-row,.dark .tdm-subtask-check,.dark .tdm-tag-trigger{background:#111f35;border-color:#253b5c;color:#e0e6ed}
	.dark .tdm-subtask-title{color:#e0e6ed}
	.dark .tdm-conv-entry.is-mine .tdm-chat-bubble{background:#16264a;border-color:#2a3f72}
	.dark .tdm-attachment-name,.dark .tdm-prop-text,.dark .tdm-conv-text,.dark .tdm-assign-name,.dark .tdm-chat-file-name{color:#e0e6ed}
	.dark .tdm-chat-toggle-switch{background:#253b5c}
	.dark .tdm-close{background:#17233a;color:#8ea0bd}
	.dark .tdm-close:hover{background:#253b5c;color:#e0e6ed}

@media(max-width:1040px){
    .tdm-modal{width:96vw;height:94vh}
    .tdm-body{grid-template-columns:1fr;overflow:auto}
    .tdm-main,.tdm-props{border-right:0;border-bottom:1px solid #f1f3f5;overflow:visible}
    .tdm-conv{min-height:360px}
}
@media(max-width:640px){
    .tdm-modal{width:100vw;height:100vh;border-radius:0}
    .tdm-head{padding:0 16px}
    .tdm-main,.tdm-props{padding:20px 16px}
    .tdm-prop{align-items:flex-start}
    .tdm-prop-value{justify-content:flex-start}
    .tdm-prop-datetime{justify-content:flex-start;flex-wrap:wrap}
	    .tdm-option-popover,.tdm-assign-popover{right:auto;left:0;width:min(292px,calc(100vw - 32px))}
}
