	        },

	        async toggleSubtask(target) {
	            if (!this.task) return;
	            const key = target?._id || target?.order + '-' + target?.title;
	            const next = this.subtasks().map(subtask => {
	                const currentKey = subtask._id || subtask.order + '-' + subtask.title;
	                if (currentKey !== key) return subtask;
	                const done = !subtask.done;
	                return { ...subtask, done, completedAt: done ? new Date().toISOString() : null };
	            });
	            await this.saveSubtasks(next);
	        },

	        async removeSubtask(target) {
	            if (!this.task) return;
	            const key = target?._id || target?.order + '-' + target?.title;
