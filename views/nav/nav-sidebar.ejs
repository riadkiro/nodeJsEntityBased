                    @mouseenter="hovered = true" @mouseleave="hovered = false"
                    @contextmenu.prevent="openEditMenu($event, child.type, child, hierarchy[0])">
                      <iconify-icon
                        :icon="getIcon(child, child.children && child.children.length > 0, subActive.includes(child.id), hovered)"
                        class="ml-2 cursor-pointer bg-transparent" width="16" height="16"
                        :style="child.color ? 'color: ' + child.color : ''"
                        @click.stop="if(['folder', 'environment'].includes(child.type)) { toggleSub(child.id); }"></iconify-icon>

