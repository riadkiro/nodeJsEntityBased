<!-- Canvas Area (WYSIWYG) -->
<div class="flex-1 overflow-auto bg-gray-100 dark:bg-gray-900 p-6">
  <div class="max-w-7xl mx-auto">
    
    <!-- Empty State -->
    <template x-if="!pageConfig.layout[builderState.activeTab] || pageConfig.layout[builderState.activeTab].length === 0">
      <div class="flex flex-col items-center justify-center h-96 border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-lg">
        <iconify-icon icon="solar:widget-5-bold-duotone" width="64" class="text-gray-400 mb-4"></iconify-icon>
        <p class="text-gray-500 mb-4">No rows yet. Start building your page!</p>
        <button @click="addRow()" class="btn btn-primary">
          <iconify-icon icon="solar:add-circle-bold" class="mr-1"></iconify-icon>
          Add First Row
        </button>
      </div>
    </template>

    <!-- Rows Container -->
    <div class="space-y-6">
      <template x-for="(row, rowIndex) in pageConfig.layout[builderState.activeTab]" :key="row.id">
        <div 
          class="group relative"
          @mouseenter="builderState.hoveredRowId = row.id"
          @mouseleave="builderState.hoveredRowId = null"
          @click="selectRow(row.id)">
          
          <!-- Row Toolbar (hover) -->
          <div 
            x-data="{ layoutMode: false }"
            x-show="builderState.mode === 'edit' && builderState.hoveredRowId === row.id"
            class="absolute -top-8 left-1/2 -translate-x-1/2 bg-white dark:bg-gray-800 shadow-lg rounded-lg p-1 flex gap-1 z-20">
            
            <!-- Normal mode buttons -->
            <template x-if="!layoutMode">
              <div class="flex gap-1">
                <button 
                  @click.stop="layoutMode = true"
                  title="Column Layout" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                  <iconify-icon icon="solar:widget-5-bold" width="16"></iconify-icon>
                </button>
                <button 
                  @click.stop="duplicateRow(row.id)"
                  title="Duplicate Row" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                  <iconify-icon icon="solar:copy-bold" width="16"></iconify-icon>
                </button>
                <button 
                  @click.stop="deleteRow(row.id)"
                  title="Delete Row" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-danger/10 hover:text-danger">
                  <iconify-icon icon="solar:trash-bin-2-bold" width="16"></iconify-icon>
                </button>
              </div>
            </template>

            <!-- Layout mode buttons -->
            <template x-if="layoutMode">
              <div class="flex gap-1 items-center">
                <!-- Preset 1 column -->
                <button 
                  @click.stop="setRowLayout(row.id, 1); layoutMode = false"
                  title="1 Column" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-primary/10 hover:text-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="4" y="4" width="16" height="16" rx="2"/>
                  </svg>
                </button>
                
                <!-- Preset 2 columns -->
                <button 
                  @click.stop="setRowLayout(row.id, 2); layoutMode = false"
                  title="2 Columns" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-primary/10 hover:text-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="4" y="4" width="6" height="16" rx="1"/>
                    <rect x="14" y="4" width="6" height="16" rx="1"/>
                  </svg>
                </button>
                
                <!-- Preset 3 columns -->
                <button 
                  @click.stop="setRowLayout(row.id, 3); layoutMode = false"
                  title="3 Columns" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-primary/10 hover:text-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="4" height="16" rx="1"/>
                    <rect x="10" y="4" width="4" height="16" rx="1"/>
                    <rect x="17" y="4" width="4" height="16" rx="1"/>
                  </svg>
                </button>
                
                <!-- Preset 4 columns -->
                <button 
                  @click.stop="setRowLayout(row.id, 4); layoutMode = false"
                  title="4 Columns" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-primary/10 hover:text-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="3" height="16" rx="1"/>
                    <rect x="8.5" y="4" width="3" height="16" rx="1"/>
                    <rect x="14" y="4" width="3" height="16" rx="1"/>
                    <rect x="19.5" y="4" width="3" height="16" rx="1"/>
                  </svg>
                </button>

                <div class="w-px h-6 bg-gray-300 dark:bg-gray-600"></div>

                <!-- Add column -->
                <button 
                  @click.stop="addColumnToRow(row.id)"
                  title="Add Column (max 12)" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-success/10 hover:text-success">
                  <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
                </button>

                <!-- Close layout mode -->
                <button 
                  @click.stop="layoutMode = false"
                  title="Close" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                  <iconify-icon icon="solar:close-circle-bold" width="16"></iconify-icon>
                </button>
              </div>
            </template>
          </div>

          <!-- Row Grid -->
          <div 
            :class="[
              'grid gap-6',
              builderState.mode === 'edit' && builderState.selectedRowId === row.id && 'ring-2 ring-primary ring-offset-4',
              builderState.mode === 'edit' && 'min-h-[100px]'
            ]"
            :style="`grid-template-columns: repeat(12, 1fr)`">
            
            <!-- Columns -->
            <template x-for="(column, colIndex) in row.columns" :key="colIndex">
              <div 
                :style="`grid-column: span ${column.width}`"
                class="relative"
                @drop.prevent="handleDrop($event, row.id, colIndex)"
                @dragover.prevent
                :class="builderState.mode === 'edit' && 'min-h-[80px] border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg p-3 bg-white dark:bg-gray-800'">
                
                <!-- Blocks in Column -->
                <div class="space-y-4">
                  <template x-for="blockId in column.blocks" :key="blockId">
                    <div 
                      @click.stop="selectBlock(blockId)"
                      @mouseenter="builderState.hoveredBlockId = blockId"
                      @mouseleave="builderState.hoveredBlockId = null"
                      class="relative"
                      :class="[
                        builderState.mode === 'edit' && builderState.selectedBlockId === blockId && 'ring-2 ring-primary',
                        builderState.mode === 'edit' && 'cursor-pointer'
                      ]">
                      
                      <!-- Block Popover (on selection) -->
                      <div 
                        x-show="builderState.mode === 'edit' && builderState.selectedBlockId === blockId"
                        class="absolute -top-10 right-0 bg-white dark:bg-gray-800 shadow-lg rounded-lg p-1 flex gap-1 z-30">
                        <button 
                          @click.stop="openDrawer('block-settings')"
                          title="Settings" 
                          class="w-7 h-7 flex items-center justify-center rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                          ⚙️
                        </button>
                        <button title="Duplicate" class="w-7 h-7 flex items-center justify-center rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                          📋
                        </button>
                        <button title="Delete" class="w-7 h-7 flex items-center justify-center rounded hover:bg-danger/10 hover:text-danger">
                          🗑️
                        </button>
                      </div>

                      <!-- Block Renderer -->
                      <div x-html="renderBlock(blockId)"></div>
                    </div>
                  </template>
                </div>

                <!-- Drop Placeholder -->
                <div 
                  x-show="builderState.mode === 'edit' && column.blocks.length === 0"
                  class="h-full flex items-center justify-center text-gray-400 text-sm">
                  Drop blocks here
                </div>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>

  </div>
</div>

<script>
function handleDrop(event, rowId, columnIndex) {
  const dragSource = this.builderState.dragSource;
  
  if (dragSource && dragSource.type === 'block') {
    this.addBlock(dragSource.blockType, rowId, columnIndex);
    this.builderState.dragSource = null;
  }
}

function renderBlock(blockId) {
  const block = this.pageConfig.blocks[blockId];
  if (!block) return '';
  
  switch (block.type) {
    case 'panel':
      return `
        <div class="panel">
          <div class="mb-5 flex items-center justify-between">
            <h5 class="text-lg font-semibold" contenteditable="${this.builderState.mode === 'edit'}">${block.title || 'Panel Title'}</h5>
          </div>
          <div class="text-sm text-gray-500">Panel content...</div>
        </div>
      `;
    
    case 'text':
      return `
        <div class="panel p-4">
          <div contenteditable="${this.builderState.mode === 'edit'}" class="prose max-w-none">
            ${block.content || 'Double-click to edit text...'}
          </div>
        </div>
      `;
    
    case 'kpi-card':
      return `
        <div class="panel h-full p-5">
          <div class="mb-1 text-xs font-semibold text-gray-500 uppercase">${block.label || 'KPI'}</div>
          <div class="text-3xl font-bold text-primary mb-2">0</div>
          <div class="text-xs text-success">↑ 12%</div>
        </div>
      `;
    
    default:
      return `<div class="panel">Unknown block type: ${block.type}</div>`;
  }
}
</script>
