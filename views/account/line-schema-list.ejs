<%- include("../nav/nav-breadcrumb") %>

<div class="pt-5" x-data="lineSchemaListApp()">
    <div class="mb-6 flex items-center justify-between">
        <h2 class="text-xl font-bold dark:text-white-light">Configuration des Schémas de Lignes</h2>
        <a href="/account/<%= account_number %>/line-schemas/new" class="btn btn-primary">
            <svg class="h-5 w-5 ltr:mr-2 rtl:ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Créer Schéma
        </a>
    </div>

    <!-- Schema Cards Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% if (schemas && schemas.length > 0) { %>
            <% schemas.forEach(function(schema) { %>
                <div class="panel h-full">
                    <div class="mb-4 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </div>
                            <div>
                                <h5 class="text-base font-semibold dark:text-white-light"><%= schema.name %></h5>
                                <p class="text-xs text-white-dark"><%= schema.slug %></p>
                            </div>
                        </div>
                        <div class="dropdown" x-data="{ open: false }">
                            <button @click="open = !open" class="text-white-dark hover:text-primary">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                                    <circle cx="12" cy="5" r="2"></circle>
                                    <circle cx="12" cy="12" r="2"></circle>
                                    <circle cx="12" cy="19" r="2"></circle>
                                </svg>
                            </button>
                            <div x-show="open" @click.outside="open = false" x-transition
                                class="absolute right-0 z-10 mt-1 w-40 rounded-md border border-[#e0e6ed] bg-white p-1 shadow-md dark:border-[#1b2e4b] dark:bg-[#1b2e4b]">
                                <a href="/account/<%= account_number %>/line-schemas/<%= schema._id %>/edit"
                                    class="flex items-center gap-2 rounded px-3 py-2 text-sm hover:bg-primary/10 hover:text-primary">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                    Modifier
                                </a>
                                <button @click="deleteSchema('<%= schema._id %>')"
                                    class="flex w-full items-center gap-2 rounded px-3 py-2 text-sm text-danger hover:bg-danger/10">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                    Supprimer
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Schema info -->
                    <div class="mb-4 space-y-2">
                        <% if (schema.description) { %>
                            <p class="text-sm text-white-dark"><%= schema.description %></p>
                        <% } %>
                        <div class="flex flex-wrap gap-1">
                            <% if (schema.appliesTo && schema.appliesTo.documentType) { %>
                                <span class="badge bg-primary/10 text-primary rounded-full text-xs"><%= schema.appliesTo.documentType %></span>
                            <% } %>
                        </div>
                    </div>

                    <!-- Line types -->
                    <div class="mb-4">
                        <p class="mb-1 text-xs font-semibold text-white-dark">Types de lignes</p>
                        <div class="flex flex-wrap gap-1">
                            <% (schema.lineTypes || []).forEach(function(lt) { %>
                                <span class="badge bg-dark/10 text-dark dark:bg-dark dark:text-white-light rounded-full text-xs"><%= lt %></span>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Columns count -->
                    <div class="flex items-center justify-between border-t border-[#e0e6ed] pt-3 dark:border-[#1b2e4b]">
                        <span class="text-sm text-white-dark"><%= (schema.columns || []).length %> colonnes</span>
                        <a href="/account/<%= account_number %>/line-schemas/<%= schema._id %>/edit"
                            class="btn btn-sm btn-outline-primary">
                            Configurer
                        </a>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <!-- Empty state -->
            <div class="panel col-span-full flex flex-col items-center justify-center py-16">
                <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-primary">
                    <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0     0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="12" y1="11" x2="12" y2="17"></line>
                        <line x1="9" y1="14" x2="15" y2="14"></line>
                    </svg>
                </div>
                <h4 class="mb-2 text-lg font-semibold dark:text-white-light">Aucun schéma</h4>
                <p class="mb-4 text-sm text-white-dark">Créez votre premier schéma de lignes pour commencer.</p>
                <a href="/account/<%= account_number %>/line-schemas/new" class="btn btn-primary">
                    Créer un Schéma
                </a>
            </div>
        <% } %>
    </div>
</div>

<script>
function lineSchemaListApp() {
    return {
        async deleteSchema(id) {
            if (!confirm('Supprimer ce schéma ?')) return;
            try {
                const res = await fetch(`/account/<%= account_number %>/api/line-schemas/${id}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert('Erreur lors de la suppression');
                }
            } catch (e) {
                console.error(e);
                alert('Erreur réseau');
            }
        }
    }
}
</script>
