<%- include('../record/partials/widget-picker') %>
<%- include('../partials/task-detail-modal') %>

<style>
    <%- include('../partials/today-tasks-widget-styles') %>

    .home-overview-shell {
        max-width: 1320px;
        margin: 0 auto;
        padding: 8px 6px 32px;
    }
    .home-ov-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }
    .home-ov-title {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }
    .home-ov-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4361ee;
        background: linear-gradient(135deg, rgba(67,97,238,.12), rgba(16,185,129,.08));
        border: 1px solid rgba(67,97,238,.12);
    }
    .home-ov-title h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: #1e293b;
        letter-spacing: -.01em;
    }
    .home-ov-title p {
        margin: 3px 0 0;
        font-size: 12px;
        font-weight: 500;
        color: #94a3b8;
    }
    .home-ov-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }
    .home-ov-btn {
        height: 36px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #475569;
        padding: 0 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all .15s ease;
        white-space: nowrap;
    }
    .home-ov-btn:hover {
        border-color: #4361ee;
        color: #4361ee;
    }
    .home-ov-btn.active {
        border-color: #4361ee;
        color: #fff;
        background: #4361ee;
        box-shadow: 0 4px 12px rgba(67,97,238,.22);
    }
    /* ── Card ── */
    .ov-card {
        position: relative;
        overflow: hidden;
        border: 1px solid #e8edf4;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(15,23,42,.03);
    }
    .ov-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 18px 10px;
    }
    .ov-card-title {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 0;
        color: #1e293b;
        font-size: 14px;
        font-weight: 600;
    }
    .ov-card-title iconify-icon {
        width: 28px;
        height: 28px;
        min-width: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: var(--ov-color, #4361ee);
        background: color-mix(in srgb, var(--ov-color, #4361ee) 13%, white);
    }
    .ov-card-link {
        color: #94a3b8;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }
    .ov-card-link:hover { color: #4361ee; }
    .ov-card-body { padding: 8px 18px 18px; }
    /* ── Task item ── */
    .home-task-list { display: flex; flex-direction: column; gap: 6px; }
    .home-task-item {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 10px;
        align-items: center;
        padding: 10px 12px;
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        background: #fafbff;
        text-decoration: none;
        transition: all .12s ease;
    }
    .home-task-item:hover {
        border-color: #e2e8f0;
        background: #fff;
        box-shadow: 0 4px 12px rgba(15,23,42,.04);
    }
    .home-task-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }
    .home-task-main { min-width: 0; }
    .home-task-title {
        color: #1e293b;
        font-size: 13px;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .home-task-meta {
        margin-top: 2px;
        display: flex;
        align-items: center;
        gap: 6px;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 400;
    }
    .home-task-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 20px;
        padding: 0 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 500;
    }
    .home-task-badge.overdue { background: #fef2f2; color: #dc2626; }
    .home-task-badge.today { background: #f0fdf4; color: #16a34a; }
    /* ── Recent records ── */
    .home-record-list { display: flex; flex-direction: column; gap: 6px; }
    .home-record-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        background: #fafbff;
        text-decoration: none;
        transition: all .12s ease;
    }
    .home-record-item:hover {
        border-color: #e2e8f0;
        background: #fff;
        transform: translateY(-1px);
    }
    .home-mini-icon {
        width: 30px;
        height: 30px;
        min-width: 30px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--item-color, #4361ee);
        background: color-mix(in srgb, var(--item-color, #4361ee) 10%, white);
    }
    .home-record-text { min-width: 0; flex: 1; }
    .home-record-text strong {
        display: block;
        color: #1e293b;
        font-size: 13px;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .home-record-text span {
        display: block;
        margin-top: 1px;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 400;
    }
    .home-record-time {
        font-size: 11px;
        color: #cbd5e1;
        font-weight: 400;
        white-space: nowrap;
        flex-shrink: 0;
    }
    /* ── Home event widgets ── */
    .home-event-list { display: flex; flex-direction: column; gap: 6px; }
    .home-event-item {
        display: grid;
        grid-template-columns: 42px minmax(0, 1fr);
        gap: 10px;
        align-items: center;
        min-height: 64px;
        padding: 8px 10px;
        border: 1px solid #e8ecf1;
        border-radius: 10px;
        background: #fafbff;
        color: inherit;
        text-decoration: none;
        transition: all .12s ease;
    }
    .home-event-item:hover {
        border-color: color-mix(in srgb, var(--event-color, #14b8a6) 32%, #e8ecf1);
        background: #fff;
        box-shadow: 0 4px 12px rgba(15,23,42,.04);
        transform: translateY(-1px);
    }
    .home-event-date {
        width: 42px;
        height: 42px;
        border-radius: 9px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, var(--event-color, #14b8a6) 10%, white);
        flex-shrink: 0;
    }
    .home-event-day {
        color: var(--event-color, #14b8a6);
        font-size: 16px;
        line-height: 1;
        font-weight: 800;
    }
    .home-event-month {
        margin-top: 2px;
        color: #888da8;
        font-size: 9px;
        line-height: 1;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0;
    }
    .home-event-body { min-width: 0; }
    .home-event-title-row {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 0;
    }
    .home-event-title {
        color: #0f172a;
        font-size: 12.5px;
        font-weight: 800;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }
    .home-event-label {
        display: inline-flex;
        align-items: center;
        max-width: 92px;
        height: 17px;
        padding: 0 6px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--label-color, #64748b) 24%, #fff);
        background: color-mix(in srgb, var(--label-color, #64748b) 12%, #fff);
        color: var(--label-color, #64748b);
        font-size: 9.5px;
        font-weight: 800;
        line-height: 17px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: none;
    }
    .home-event-source,
    .home-event-meta {
        display: flex;
        align-items: center;
        gap: 5px;
        min-width: 0;
        margin-top: 2px;
        color: #94a3b8;
        font-size: 11px;
        line-height: 1.25;
    }
    .home-event-source {
        color: #64748b;
        font-weight: 700;
    }
    .home-event-source iconify-icon { color: var(--entity-color, #4361ee); flex: none; }
    .home-event-source span,
    .home-event-meta-main,
    .home-event-location span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .home-event-meta-main { flex: 0 1 auto; }
    .home-event-location {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        min-width: 0;
        flex: 1 1 auto;
        white-space: nowrap;
    }
    /* ── Stats ── */
    .home-stat-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }
    .home-stat-card {
        display: flex;
        flex-direction: column;
        justify-content: center;
        border-radius: 10px;
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        padding: 12px;
        text-align: center;
    }
    .home-stat-card strong {
        color: #1e293b;
        font-size: 20px;
        font-weight: 600;
    }
    .home-stat-card span {
        margin-top: 2px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: .02em;
    }
    /* ── Quick links ── */
    .home-quick-list { display: flex; flex-direction: column; gap: 6px; }
    .home-quick-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        background: #fafbff;
        text-decoration: none;
        transition: all .12s ease;
    }
    .home-quick-item:hover {
        border-color: #e2e8f0;
        background: #fff;
        transform: translateY(-1px);
    }
    .home-quick-text strong {
        color: #334155;
        font-size: 13px;
        font-weight: 500;
    }
    /* ── Empty ── */
    .home-empty {
        min-height: 100px;
        border: 1px dashed #e2e8f0;
        border-radius: 10px;
        background: #fafbff;
        color: #94a3b8;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-align: center;
        font-size: 12px;
        font-weight: 400;
    }
    .home-loading {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        border: 1px solid #e8edf4;
        border-radius: 12px;
        background: #fff;
        color: #94a3b8;
        font-size: 12px;
    }
    /* ── Layout builder ── */
    .ov-layout-row { display: flex; gap: 16px; margin-bottom: 16px; position: relative; }
    .ov-layout-col { position: relative; display: flex; flex-direction: column; gap: 16px; min-height: 40px; }
    .ov-col-widgets { display: flex; flex-direction: column; gap: 16px; min-height: 40px; flex: 1; }
    .ov-widget-wrap { position: relative; }
    /* Design mode overlays */
    .ov-dm .ov-widget-wrap { border: 2px dashed transparent; border-radius: 14px; transition: border-color .2s; }
    .ov-dm .ov-widget-wrap:hover { border-color: #4361ee40; }
    .ov-dm .ov-layout-col { border: 1px dashed #e2e8f0; border-radius: 12px; padding: 8px; background: rgba(67,97,238,.01); }
    .ov-widget-drag, .ov-row-drag { display: none; }
    .ov-dm .ov-widget-drag { display: flex; position: absolute; top: 6px; left: 6px; z-index: 20; width: 22px; height: 22px; align-items: center; justify-content: center; border-radius: 6px; background: rgba(67,97,238,.08); color: #4361ee; cursor: grab; opacity: 0; transition: opacity .15s; }
    .ov-dm .ov-widget-wrap:hover .ov-widget-drag { opacity: 1; }
    .ov-dm .ov-row-drag { display: flex; position: absolute; top: 50%; left: -28px; transform: translateY(-50%); width: 20px; height: 20px; align-items: center; justify-content: center; border-radius: 6px; background: rgba(67,97,238,.08); color: #4361ee; cursor: grab; opacity: 0; transition: opacity .15s; }
    .ov-dm .ov-layout-row:hover > .ov-row-drag { opacity: 1; }
    .ov-row-remove { display: none; }
    .ov-dm .ov-row-remove { display: flex; position: absolute; top: 50%; right: -28px; transform: translateY(-50%); width: 20px; height: 20px; align-items: center; justify-content: center; border-radius: 50%; background: rgba(239,68,68,.08); color: #ef4444; cursor: pointer; opacity: 0; transition: opacity .15s; border: none; font-size: 11px; }
    .ov-dm .ov-layout-row:hover > .ov-row-remove { opacity: 1; }
    .ov-dm .ov-row-remove:hover { background: rgba(239,68,68,.15); }
    .ov-widget-config { display: none; }
    .ov-dm .ov-widget-config { display: flex; position: absolute; top: 6px; right: 30px; z-index: 20; width: 20px; height: 20px; align-items: center; justify-content: center; border-radius: 50%; background: rgba(67,97,238,.08); color: #4361ee; cursor: pointer; opacity: 0; transition: opacity .15s; border: none; font-size: 12px; }
    .ov-dm .ov-widget-wrap:hover .ov-widget-config { opacity: 1; }
    .ov-dm .ov-widget-config:hover { background: rgba(67,97,238,.16); }
    .ov-widget-remove { display: none; }
    .ov-dm .ov-widget-remove { display: flex; position: absolute; top: 6px; right: 6px; z-index: 20; width: 20px; height: 20px; align-items: center; justify-content: center; border-radius: 50%; background: rgba(239,68,68,.08); color: #ef4444; cursor: pointer; opacity: 0; transition: opacity .15s; border: none; font-size: 12px; }
    .ov-dm .ov-widget-wrap:hover .ov-widget-remove { opacity: 1; }
    .ov-resize-handle { display: none; }
    .ov-dm .ov-resize-handle { display: block; position: absolute; top: 0; right: -10px; width: 20px; height: 100%; cursor: col-resize; z-index: 30; }
    .ov-dm .ov-resize-handle::after { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 4px; height: 32px; border-radius: 2px; background: #4361ee40; transition: background .15s; }
    .ov-dm .ov-resize-handle:hover::after { background: #4361ee; }
    .ov-sort-ghost { opacity: .15; border: 2px dashed #4361ee !important; border-radius: 12px; background: rgba(67,97,238,.04) !important; }
    .ov-add-widget-btn { display: none; }
    .ov-dm .ov-add-widget-btn { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 10px; border: 2px dashed #e2e8f0; border-radius: 10px; color: #94a3b8; font-size: 12px; font-weight: 500; cursor: pointer; transition: all .2s; background: transparent; }
    .ov-dm .ov-add-widget-btn:hover { border-color: #4361ee; color: #4361ee; background: rgba(67,97,238,.03); }
    .ov-add-row-btn { display: none; }
    .ov-dm .ov-add-row-btn { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 12px; border: 2px dashed #e2e8f0; border-radius: 12px; color: #94a3b8; font-size: 12px; font-weight: 500; cursor: pointer; transition: all .2s; margin-top: 4px; }
    .ov-dm .ov-add-row-btn:hover { border-color: #4361ee; color: #4361ee; background: rgba(67,97,238,.03); }
    .ov-col-toolbar { display: none; }
    .ov-dm .ov-col-toolbar { display: flex; gap: 4px; position: absolute; top: -8px; right: 8px; z-index: 25; }
    .ov-dm .ov-col-toolbar button { width: 18px; height: 18px; border-radius: 4px; border: 1px solid #e2e8f0; background: #fff; color: #94a3b8; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 10px; transition: all .15s; }
    .ov-dm .ov-col-toolbar button:hover { border-color: #4361ee; color: #4361ee; background: rgba(67,97,238,.05); }
    .ov-dm-banner { display: none; }
    .ov-dm .ov-dm-banner { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: linear-gradient(135deg,rgba(67,97,238,.06),rgba(67,97,238,.02)); border: 1px solid rgba(67,97,238,.15); border-radius: 12px; margin-bottom: 16px; font-size: 12px; color: #4361ee; font-weight: 500; }
    /* ── Custom widgets ── */
    .ov-card-custom { overflow: hidden; }
    .ov-custom-frame { display: block; width: 100%; min-height: 180px; border: 1px solid #eef2f7; border-radius: 12px; background: #f8fafc; }
    .ov-custom-video { display: block; width: 100%; border-radius: 12px; background: #0f172a; }
    .ov-custom-image { display: block; width: 100%; max-height: 460px; object-fit: contain; border-radius: 12px; background: #f8fafc; }
    .ov-custom-html { font-size: 13px; line-height: 1.65; color: #334155; overflow: auto; }
    .ov-custom-note { padding: 13px 14px; border: 1px solid #ede9fe; border-radius: 12px; background: linear-gradient(135deg,#fbfaff,#fff); font-size: 13px; line-height: 1.65; color: #475569; white-space: pre-wrap; }
    .ov-custom-link { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px; border: 1px solid #dbeafe; border-radius: 12px; background: #eff6ff; color: #2563eb; text-decoration: none; font-size: 13px; font-weight: 600; }
    .ov-custom-link span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ov-custom-separator { height: 1px; background: linear-gradient(90deg, transparent, #e2e8f0, transparent); margin: 4px 0; }
    .ov-custom-empty { display: flex; align-items: center; justify-content: center; min-height: 86px; border: 1px dashed #e2e8f0; border-radius: 12px; background: #fafbff; color: #94a3b8; font-size: 12px; font-weight: 500; text-align: center; }
    /* ── Dark ── */
    .dark .home-ov-title h1 { color: #f1f5f9; }
    .dark .ov-card { background: #0e1726; border-color: #1e293b; }
    .dark .ov-card-title, .dark .home-task-title, .dark .home-stat-card strong, .dark .home-event-title,
    .dark .home-record-text strong, .dark .home-quick-text strong { color: #f1f5f9; }
    .dark .home-ov-btn { background: #0f172a; border-color: #1e293b; color: #94a3b8; }
    .dark .home-task-item, .dark .home-record-item, .dark .home-event-item, .dark .home-quick-item,
    .dark .home-stat-card, .dark .home-empty, .dark .ov-custom-empty { background: #111c2d; border-color: #1e293b; }
    .dark .home-event-item:hover { background: #0f172a; border-color: color-mix(in srgb, var(--event-color, #14b8a6) 42%, #1e293b); }
    .dark .home-event-date { background: color-mix(in srgb, var(--event-color, #14b8a6) 18%, #0e1726); }
    .dark .home-event-label { background: color-mix(in srgb,var(--label-color,#94a3b8) 18%,#0e1726); border-color: color-mix(in srgb,var(--label-color,#94a3b8) 34%,#0e1726); }
    .dark .home-loading { background: #0f172a; border-color: #1e293b; }
    .dark .ov-custom-html, .dark .ov-custom-note { color: #cbd5e1; }
    .dark .ov-custom-note { background: #111c2d; border-color: #1e293b; }
    .dark .ov-custom-frame, .dark .ov-custom-image, .dark .ov-custom-empty { background: #0b1320; border-color: #1e293b; }
    .dark .ov-custom-link { background: #111c2d; border-color: #1e293b; color: #93c5fd; }
    @media (max-width: 1024px) {
        .ov-layout-row { flex-direction: column; }
        .ov-layout-col { width: 100% !important; }
    }
    @media (max-width: 640px) {
        .home-overview-shell { padding: 2px 0 24px; }
        .home-ov-header { align-items: flex-start; flex-direction: column; }
        .home-ov-actions { width: 100%; justify-content: flex-start; }
        .home-stat-grid { grid-template-columns: 1fr; }
    }
</style>

<style>
    .home-overview-shell {
        max-width: 1590px;
        padding: 0 0 28px;
        font-family: Inter, Nunito, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .home-ov-header {
        margin-bottom: 28px;
        align-items: flex-start;
    }
    .home-ov-icon { display: none; }
    .home-ov-title h1 {
        color: #10192f;
        font-size: 25px;
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: 0;
    }
    .home-ov-title p {
        color: #66789d;
        font-size: 13px;
        margin-top: 10px;
        font-weight: 700;
    }
    .home-ov-actions { gap: 9px; }
    .home-ov-btn {
        height: 34px;
        border-radius: 8px;
        border-color: #e0e6ed;
        box-shadow: none;
        color: #475569;
        font-weight: 600;
        transition: all .2s;
    }
    .home-ov-btn:hover,
    .home-ov-btn.active {
        color: #4361ee;
        border-color: #c7d2fe;
        background: #f8fbff;
    }
    .ov-layout-row {
        gap: 20px;
        margin-bottom: 20px;
        align-items: stretch;
    }
    .ov-layout-col { gap: 20px; }
    .ov-layout-col-nested-only { gap: 0; }
    .ov-col-widgets {
        gap: 20px;
        flex: 1 1 auto;
        min-height: 0;
