<div x-data="documentEditor()" class="h-[calc(100vh-80px)] flex flex-col">
  <!-- Header Bar -->
  <div class="bg-white dark:bg-gray-900 border-b dark:border-gray-800 px-4 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/account/<%= account_number %>/documents" class="text-gray-500 hover:text-primary">
        <iconify-icon icon="solar:arrow-left-line-duotone" width="24"></iconify-icon>
      </a>
      <input 
        type="text" 
        x-model="doc.name" 
        @input="saveDocument"
        class="form-input font-semibold text-lg border-0 focus:ring-0 px-2 w-80"
        placeholder="Sans titre"
      >
      <span class="text-xs text-gray-400" x-show="lastSaved">
        Sauvegardé <span x-text="lastSaved"></span>
      </span>
    </div>

    <div class="flex items-center gap-2">
      <select x-model="doc.format" @change="updateDimensions" class="form-select text-sm">
        <option value="A4">A4</option>
        <option value="A5">A5</option>
        <option value="A3">A3</option>
        <option value="Letter">Letter</option>
        <option value="Legal">Legal</option>
      </select>

      <select x-model="doc.orientation" @change="updateDimensions" class="form-select text-sm">
        <option value="portrait">Portrait</option>
        <option value="landscape">Paysage</option>
      </select>

      <select x-model="doc.status" @change="saveDocument" class="form-select text-sm">
        <option value="draft">Brouillon</option>
        <option value="published">Publié</option>
      </select>

      <button @click="saveDocument" class="btn btn-primary btn-sm">
        <iconify-icon icon="solar:diskette-bold" class="mr-1"></iconify-icon>
        Sauvegarder
      </button>
    </div>
  </div>

  <!-- Main Content -->
  <div class="flex-1 flex overflow-hidden">
    <!-- Toolbar (Left) -->
    <div class="w-16 bg-white dark:bg-gray-900 border-r dark:border-gray-800 flex flex-col items-center py-4 gap-4">
      <button class="w-10 h-10 rounded hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center" title="Texte">
        <iconify-icon icon="solar:text-bold-duotone" width="24"></iconify-icon>
      </button>
      <button class="w-10 h-10 rounded hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center" title="Image">
        <iconify-icon icon="solar:gallery-bold-duotone" width="24"></iconify-icon>
      </button>
      <div class="h-px w-8 bg-gray-200 dark:bg-gray-700"></div>
      <button class="w-10 h-10 rounded hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center" title="Layout 2 colonnes">
        <iconify-icon icon="solar:layers-minimalistic-bold-duotone" width="24"></iconify-icon>
      </button>
      <button class="w-10 h-10 rounded hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center" title="Layout 3 colonnes">
        <iconify-icon icon="solar:widget-4-bold-duotone" width="24"></iconify-icon>
      </button>
      <div class="h-px w-8 bg-gray-200 dark:bg-gray-700"></div>
      <button class="w-10 h-10 rounded hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center" title="Variable DB">
        <iconify-icon icon="solar:database-bold-duotone" width="24"></iconify-icon>
      </button>
    </div>

    <!-- Canvas Area -->
    <div class="flex-1 bg-gray-100 dark:bg-gray-800 overflow-auto p-8" id="canvas-container">
      <div class="flex flex-col gap-8 items-center" style="padding-top: 43px;">
        <template x-for="(page, index) in doc.pages" :key="'page-' + index">
          <div class="relative group">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-10">
              <span class="bg-primary text-white text-xs px-2 py-1 rounded-full shadow-md">
                Page <span x-text="index + 1"></span>
              </span>
            </div>

            <div 
              class="bg-white shadow-2xl relative overflow-hidden" 
              :style="'width: ' + doc.dimensions.width + 'px; height: ' + doc.dimensions.height + 'px;'" 
              @click="selectPage(index)" 
              :class="{ 'ring-2 ring-primary': selectedPageIndex === index }"
            >
              <!-- Editable content area with dynamic margins -->
              <div 
                class="w-full h-full outline-none text-gray-800 leading-relaxed page-content overflow-hidden"
                contenteditable="true"
                :data-page-index="index"
                @input="handlePageInput($event, index)"
                @paste="handlePaste($event, index)"
                @focus="selectPage(index)"
                @blur="syncPageContent($event, index)"
                x-init="$el.innerHTML = page.content || ''"
                x-ref="pageContent"
                :style="'font-family: Times New Roman, serif; font-size: 12pt; white-space: pre-wrap; word-wrap: break-word; line-height: 1.15; padding-top: ' + doc.margins.top + 'px; padding-bottom: ' + doc.margins.bottom + 'px; padding-left: ' + doc.margins.left + 'px; padding-right: ' + doc.margins.right + 'px;'"
              ></div>
            </div>

            <!-- Page Actions Bar (bottom) -->
            <div class="flex items-center justify-center gap-1 mt-2 opacity-0 group-hover:opacity-100 transition-opacity">
              <button @click="addPageAfter(index)" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-primary transition-colors" title="Ajouter une page après">
                <iconify-icon icon="solar:add-circle-bold" width="18"></iconify-icon>
              </button>
              <button @click="duplicatePage(index)" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-primary transition-colors" title="Dupliquer">
                <iconify-icon icon="solar:copy-bold" width="18"></iconify-icon>
              </button>
              <button @click="deletePage(index)" x-show="doc.pages.length > 1" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-danger transition-colors" title="Supprimer">
                <iconify-icon icon="solar:trash-bin-trash-bold" width="18"></iconify-icon>
              </button>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- Properties Panel -->
    <div class="w-80 bg-white dark:bg-gray-900 border-l dark:border-gray-800 p-4 overflow-auto">
      <h3 class="font-semibold mb-4 dark:text-white">Propriétés</h3>
      
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Nom du document</label>
          <input type="text" x-model="doc.name" @input="saveDocument" class="form-input">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Format</label>
          <p class="text-sm text-gray-600 dark:text-gray-400" x-text="doc.format + ' - ' + doc.orientation"></p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Dimensions</label>
          <p class="text-sm text-gray-600 dark:text-gray-400" x-text="doc.dimensions.width + ' x ' + doc.dimensions.height + ' px'"></p>
        </div>
        
        <!-- Margins Section -->
        <div>
          <label class="block text-sm font-medium mb-2 text-gray-700 dark:text-gray-300">Marges (px)</label>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="text-xs text-gray-500">Haut</label>
              <input type="number" x-model.number="doc.margins.top" @input="saveDocument" class="form-input text-sm" min="0" max="200">
            </div>
            <div>
              <label class="text-xs text-gray-500">Bas</label>
              <input type="number" x-model.number="doc.margins.bottom" @input="saveDocument" class="form-input text-sm" min="0" max="200">
            </div>
            <div>
              <label class="text-xs text-gray-500">Gauche</label>
              <input type="number" x-model.number="doc.margins.left" @input="saveDocument" class="form-input text-sm" min="0" max="200">
            </div>
            <div>
              <label class="text-xs text-gray-500">Droite</label>
              <input type="number" x-model.number="doc.margins.right" @input="saveDocument" class="form-input text-sm" min="0" max="200">
            </div>
          </div>
        </div>
      </div>

      <div class="border-t dark:border-gray-700 pt-4">
        <div class="flex items-center justify-between mb-3">
          <h4 class="font-medium text-sm dark:text-white">Pages (<span x-text="doc.pages.length"></span>)</h4>
          <button @click="addPage" class="text-primary hover:text-primary-dark">
            <iconify-icon icon="solar:add-circle-bold" width="20"></iconify-icon>
          </button>
        </div>

        <div class="space-y-2 max-h-[300px] overflow-auto">
          <template x-for="(page, index) in doc.pages" :key="index">
            <div class="flex items-center gap-2 p-2 rounded hover:bg-gray-50 dark:hover:bg-gray-800 cursor-pointer" :class="{ 'bg-primary/10 border border-primary': selectedPageIndex === index }" @click="selectPage(index)">
              <iconify-icon icon="solar:document-text-bold-duotone" width="16" class="text-gray-400"></iconify-icon>
              <span class="flex-1 text-sm" x-text="'Page ' + (index + 1)"></span>
              <span class="text-xs text-gray-400" x-text="page.elements.length + ' élément(s)'"></span>
            </div>
          </template>
        </div>
      </div>

      <template x-if="selectedPageIndex !== null">
        <div class="border-t dark:border-gray-700 pt-4 mt-4">
          <h4 class="font-medium text-sm mb-3 dark:text-white">Page <span x-text="selectedPageIndex + 1"></span></h4>
          <div class="space-y-2">
            <button @click="duplicatePage(selectedPageIndex)" class="btn btn-outline-primary btn-sm w-full">
              <iconify-icon icon="solar:copy-bold" class="mr-1"></iconify-icon>
              Dupliquer
            </button>
            <button @click="deletePage(selectedPageIndex)" x-show="doc.pages.length > 1" class="btn btn-outline-danger btn-sm w-full">
              <iconify-icon icon="solar:trash-bin-trash-bold" class="mr-1"></iconify-icon>
              Supprimer
            </button>
          </div>
        </div>
      </template>
    </div>
  </div>
</div>

<!-- Data passed from server -->
<script type="application/json" id="document-data">
<%- JSON.stringify({
  isNew: isNew,
  docId: isNew ? null : document._id,
  name: isNew ? 'Sans titre' : document.name,
  format: isNew ? 'A4' : document.format,
  orientation: isNew ? 'portrait' : document.orientation,
  dimensions: isNew ? { width: 794, height: 1123 } : document.dimensions,
  pages: isNew ? [{ elements: [], background: { color: '#ffffff' }, order: 0 }] : document.pages,
  status: isNew ? 'draft' : document.status
}).replace(/</g, '\\u003C') %>
</script>

<script>
  document.addEventListener('alpine:init', function() {
    Alpine.data('documentEditor', function() {
      var data = JSON.parse(document.getElementById('document-data').textContent);
      var accountNumber = '<%= account_number %>';
      
      return {
        doc: {
          _id: data.docId,
          name: data.name,
          format: data.format,
          orientation: data.orientation,
          dimensions: data.dimensions,
          pages: data.pages,
          status: data.status,
          margins: data.margins || { top: 72, bottom: 72, left: 72, right: 72 }
        },
        selectedPageIndex: 0,
        lastSaved: null,
        saveTimeout: null,

        formats: {
          'A4': { width: 794, height: 1123 },
          'A5': { width: 559, height: 794 },
          'A3': { width: 1123, height: 1587 },
          'Letter': { width: 816, height: 1056 },
          'Legal': { width: 816, height: 1344 }
        },

        updateDimensions: function() {
          var format = this.formats[this.doc.format];
          if (this.doc.orientation === 'landscape') {
            this.doc.dimensions = { width: format.height, height: format.width };
          } else {
            this.doc.dimensions = { width: format.width, height: format.height };
          }
          this.saveDocument();
        },

        addPage: function() {
          var newPage = {
            elements: [],
            background: { color: '#ffffff' },
            order: this.doc.pages.length
          };
          this.doc.pages.push(newPage);
          this.selectedPageIndex = this.doc.pages.length - 1;
          this.saveDocument();
          
          var self = this;
          this.$nextTick(function() {
            var container = document.getElementById('canvas-container');
            container.scrollTo({
              top: container.scrollHeight,
              behavior: 'smooth'
            });
          });
        },

        addPageAfter: function(index) {
          var newPage = {
            elements: [],
            background: { color: '#ffffff' },
            order: index + 1
          };
          this.doc.pages.splice(index + 1, 0, newPage);
          this.selectedPageIndex = index + 1;
          this.saveDocument();
        },

        duplicatePage: function(index) {
          var pageToDuplicate = JSON.parse(JSON.stringify(this.doc.pages[index]));
          pageToDuplicate.order = this.doc.pages.length;
          this.doc.pages.splice(index + 1, 0, pageToDuplicate);
          this.selectedPageIndex = index + 1;
          this.saveDocument();
        },

        deletePage: function(index) {
          if (this.doc.pages.length <= 1) {
            alert('Vous devez avoir au moins une page');
            return;
          }
          
          if (confirm('Supprimer la page ' + (index + 1) + ' ?')) {
            this.doc.pages.splice(index, 1);
            if (this.selectedPageIndex >= this.doc.pages.length) {
              this.selectedPageIndex = this.doc.pages.length - 1;
            }
            this.saveDocument();
          }
        },

        selectPage: function(index) {
          this.selectedPageIndex = index;
        },

        syncPageContent: function(event, pageIndex) {
          // Sync content when user leaves the page
          var element = event.target;
          this.doc.pages[pageIndex].content = element.innerHTML;
        },

        handlePageInput: function(event, pageIndex) {
          var element = event.target;
          var content = element.innerHTML;
          
          // Save content to page data
          this.doc.pages[pageIndex].content = content;
          
          // Check for overflow (content too big -> push to next page)
          this.checkOverflow(element, pageIndex);
          
          // Check for underflow (space available -> pull from next page)
          this.checkUnderflow(element, pageIndex);
          
          this.saveDocument();
        },

        handlePaste: function(event, pageIndex) {
          event.preventDefault();
          var self = this;
          
          // Get pasted text
          var pastedText = (event.clipboardData || window.clipboardData).getData('text/html');
          if (!pastedText) {
            pastedText = (event.clipboardData || window.clipboardData).getData('text/plain');
            pastedText = pastedText.replace(/\n/g, '<br>');
          } else {
            // Clean Word HTML - remove excessive spacing
            pastedText = this.cleanWordHtml(pastedText);
          }
          
          // Insert at cursor position
          document.execCommand('insertHTML', false, pastedText);
          
          // Get the element and check for overflow
          var element = event.target;
          this.doc.pages[pageIndex].content = element.innerHTML;
          
          // Use setTimeout to allow DOM to update
          setTimeout(function() {
            self.checkOverflow(element, pageIndex);
            self.saveDocument();
          }, 100);
        },

        cleanWordHtml: function(html) {
          // Create a temporary div to parse HTML
          var temp = document.createElement('div');
          temp.innerHTML = html;
          
          // Remove Word-specific tags and attributes
          var elementsToClean = temp.querySelectorAll('*');
          elementsToClean.forEach(function(el) {
            // Remove margin and padding styles
            if (el.style) {
              el.style.marginTop = '';
              el.style.marginBottom = '';
              el.style.marginLeft = '';
              el.style.marginRight = '';
              el.style.paddingTop = '';
              el.style.paddingBottom = '';
              el.style.lineHeight = '';
            }
            
            // Remove mso- styles (Microsoft Office)
            var style = el.getAttribute('style');
            if (style) {
              style = style.replace(/mso-[^;]+;?/gi, '');
              style = style.replace(/margin[^;]*;?/gi, '');
              style = style.replace(/line-height[^;]*;?/gi, '');
              el.setAttribute('style', style);
            }
            
            // Remove class attributes (Word adds many)
            el.removeAttribute('class');
          });
          
          // Get clean HTML
          var result = temp.innerHTML;
          
          // FIRST: Replace literal newlines and carriage returns with spaces
          // This fixes the "La\nsociété" problem from Word
          result = result.replace(/[\r\n]+/g, ' ');
          
          // Remove Word-specific tags
          result = result.replace(/<o:p><\/o:p>/gi, '');
          result = result.replace(/<!--\[if[^>]*>[\s\S]*?<!\[endif\]-->/gi, '');
          result = result.replace(/<!\[if[^>]*>[\s\S]*?<!\[endif\]>/gi, '');
          
          // Remove empty span tags and merge text
          result = result.replace(/<span[^>]*>\s*<\/span>/gi, '');
          
          // Replace single <br> NOT followed by another <br> with a space (Word soft line breaks)
          result = result.replace(/<br\s*\/?>\s*(?!<br)/gi, ' ');
          
          // Now clean up double+ breaks to proper paragraph breaks
          result = result.replace(/(<br\s*\/?>\s*){2,}/gi, '<br><br>');
          
          // Remove empty paragraphs
          result = result.replace(/<p[^>]*>\s*(&nbsp;|\s)*\s*<\/p>/gi, '');
          
          // Clean up multiple spaces
          result = result.replace(/\s{2,}/g, ' ');
          
          return result;
        },

        checkOverflow: function(element, pageIndex) {
          var self = this;
          
          // Check if content overflows
          if (element.scrollHeight > element.clientHeight) {
            // Content overflows - need to move excess to next page
            var overflowContent = this.extractOverflow(element);
            
            if (overflowContent) {
              // Create next page if it doesn't exist
              if (pageIndex + 1 >= this.doc.pages.length) {
                this.doc.pages.push({
                  content: '',
                  elements: [],
                  background: { color: '#ffffff' },
                  order: this.doc.pages.length
                });
              }
              
              // Prepend overflow to next page
              var nextPageContent = this.doc.pages[pageIndex + 1].content || '';
              this.doc.pages[pageIndex + 1].content = overflowContent + nextPageContent;
              
              // Update current page content
              this.doc.pages[pageIndex].content = element.innerHTML;
              
              // After Alpine re-renders, update DOM and check next page for overflow too
              this.$nextTick(function() {
                var nextPageElement = document.querySelector('[data-page-index="' + (pageIndex + 1) + '"]');
                if (nextPageElement) {
                  // Update the DOM with new content (since x-init only runs once)
                  nextPageElement.innerHTML = self.doc.pages[pageIndex + 1].content;
                  self.checkOverflow(nextPageElement, pageIndex + 1);
                }
              });
            }
          }
        },

        checkUnderflow: function(element, pageIndex) {
          var self = this;
          
          // Only check if there's a next page with content
          if (pageIndex + 1 >= this.doc.pages.length) {
            return;
          }
          
          var nextPageContent = this.doc.pages[pageIndex + 1].content;
          if (!nextPageContent || !nextPageContent.trim()) {
            return;
          }
          
          // Get next page element
          var nextPageElement = document.querySelector('[data-page-index="' + (pageIndex + 1) + '"]');
          if (!nextPageElement) {
            return;
          }
          
          // Try to pull first element from next page
          var pulled = this.tryPullFromNextPage(element, nextPageElement, pageIndex);
          
          if (pulled) {
            // Update data
            this.doc.pages[pageIndex].content = element.innerHTML;
            this.doc.pages[pageIndex + 1].content = nextPageElement.innerHTML;
            
            // Check if next page became empty
            this.$nextTick(function() {
              var nextContent = self.doc.pages[pageIndex + 1];
              if (nextContent && (!nextContent.content || !nextContent.content.trim())) {
                self.doc.pages.splice(pageIndex + 1, 1);
                // After removing page, check if current page can still pull more
                self.checkUnderflow(element, pageIndex);
              } else {
                // Try to pull more to current page
                self.checkUnderflow(element, pageIndex);
                
                // CHAIN: Also check if next page can now pull from page after it
                self.$nextTick(function() {
                  if (pageIndex + 1 < self.doc.pages.length) {
                    var updatedNextElement = document.querySelector('[data-page-index="' + (pageIndex + 1) + '"]');
                    if (updatedNextElement) {
                      self.checkUnderflow(updatedNextElement, pageIndex + 1);
                    }
                  }
                });
              }
            });
          }
        },

        tryPullFromNextPage: function(currentElement, nextElement, pageIndex) {
          // Get first child node from next page
          var firstChild = nextElement.firstChild;
          if (!firstChild) {
            return false;
          }
          
          // Clone it for testing
          var testNode;
          if (firstChild.nodeType === Node.ELEMENT_NODE) {
            testNode = firstChild.cloneNode(true);
          } else if (firstChild.nodeType === Node.TEXT_NODE) {
            testNode = document.createTextNode(firstChild.textContent);
          } else {
            return false;
          }
          
          // Add to current page temporarily
          currentElement.appendChild(testNode);
          
          // Check if it still fits (no overflow)
          var fits = currentElement.scrollHeight <= currentElement.clientHeight;
          
          if (fits) {
            // It fits! Now actually remove from next page
            nextElement.removeChild(firstChild);
            return true;
          } else {
            // Doesn't fit, remove test node
            currentElement.removeChild(testNode);
            return false;
          }
        },

        extractOverflow: function(element) {
          // Use a more robust iterative approach
          // Instead of calculating heights, we'll remove elements from the end
          // until scrollHeight <= clientHeight
          
          var removedNodes = [];
          var maxIterations = 100; // Safety limit
          var iterations = 0;
          
          // First, check if there's actually overflow
          if (element.scrollHeight <= element.clientHeight) {
            return ''; // No overflow
          }
          
          // Get all top-level child nodes
          var children = Array.from(element.childNodes);
          
          // If there are no children or only one, we can't split
          if (children.length <= 1) {
            return '';
          }
          
          // Iteratively remove nodes from the end until no overflow
          while (element.scrollHeight > element.clientHeight && iterations < maxIterations) {
            // Remove the last child
            var lastChild = element.lastChild;
            
            if (!lastChild) {
              break; // No more children to remove
            }
            
            // Remove and store the node
            element.removeChild(lastChild);
            removedNodes.unshift(lastChild); // Add to beginning of array
            
            iterations++;
          }
          
          // If we removed everything and still have overflow, something's wrong
          if (element.childNodes.length === 0 && removedNodes.length > 0) {
            // Put back the first removed node at least
            element.appendChild(removedNodes.shift());
          }
          
          // Convert removed nodes to HTML
          var overflowHtml = '';
          removedNodes.forEach(function(node) {
            if (node.nodeType === Node.ELEMENT_NODE) {
              overflowHtml += node.outerHTML;
            } else if (node.nodeType === Node.TEXT_NODE) {
              overflowHtml += node.textContent;
            }
          });
          
          return overflowHtml;
        },

        saveDocument: function() {
          clearTimeout(this.saveTimeout);
          var self = this;
          this.saveTimeout = setTimeout(function() {
            var method = self.doc._id ? 'PUT' : 'POST';
            var url = self.doc._id 
              ? '/account/' + accountNumber + '/documents/api/' + self.doc._id
              : '/account/' + accountNumber + '/documents/api';

            fetch(url, {
              method: method,
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(self.doc)
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (data.document) {
                if (!self.doc._id) {
                  self.doc._id = data.document._id;
                  window.history.replaceState({}, '', '/account/' + accountNumber + '/documents/' + data.document._id + '/edit');
                }
                self.lastSaved = new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
              }
            })
            .catch(function(error) {
              console.error('Error saving document:', error);
            });
          }, 1000);
        }
      };
    });
  });
</script>
