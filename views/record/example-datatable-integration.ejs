<%# 
  Example Integration of HTMX + Stimulus DataTable
  This shows how to use the new datatable component in a page
%>

<%- contentFor('body') %>

<div class="flex h-screen overflow-hidden">
    <%# Sidebar (if needed) %>
    <aside class="w-64 bg-gray-100 dark:bg-gray-900 border-r border-gray-200 dark:border-gray-800">
        <!-- Your sidebar content -->
    </aside>
    
    <%# Main Content Area %>
    <main class="flex-1 flex flex-col overflow-hidden">
        <%# Header %>
        <header class="px-6 py-4 border-b border-gray-200 dark:border-gray-800">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
                <%= entity.name %>
            </h1>
        </header>
        
        <%# DataTable Container %>
        <div class="flex-1 p-6 overflow-hidden">
            <div class="h-full bg-white dark:bg-gray-800 rounded-lg shadow">
                <%
                // Prepare data for datatable
                const viewId = 'contacts-list'; // unique ID for this view
                const entityId = entity._id.toString();
                
                // Build columns from entity fields
                const columns = [
                    { id: 'title', name: 'Titre', hidden: false, order: 0 }
                ];
                
                entity.customFields.forEach((field, index) => {
                    columns.push({
                        id: field._id.toString(),
                        fieldId: field._id,
                        name: field.label,
                        hidden: false,
                        order: index + 1
                    });
                });
                
                columns.push({
                    id: 'createdAt',
                    name: 'Créé le',
                    hidden: false,
                    order: columns.length
                });
                
                // Pagination defaults
                const pagination = {
                    page: 1,
                    limit: 10,
                    total: records.length,
                    pages: Math.ceil(records.length / 10)
                };
                
                // Sort defaults
                const sort = {
                    field: 'createdAt',
                    direction: 'desc'
                };
                %>
                
                <%# Include the DataTable Component %>
                <%- include('./partials/datatable/_datatable', {
                    viewId,
                    entityId,
                    entity,
                    records,
                    columns,
                    pagination,
                    sort,
                    searchQuery: '',
                    account_number
                }) %>
            </div>
        </div>
    </main>
</div>

<%# Make sure HTMX is loaded in your layout %>
<%# <script src="https://unpkg.com/htmx.org@1.9.10"></script> %>

<%# Make sure Stimulus is initialized with your controllers %>
<%# Controllers should be in public/js/controllers/ and auto-registered %>
