    .tl-pro-primary {
        border-color:#4f46e5;background:linear-gradient(135deg,#4f46e5,#6366f1);color:#fff;
        box-shadow:0 10px 22px rgba(79,70,229,.18);
    }
    .tl-pro-primary:hover { transform:translateY(-1px);box-shadow:0 12px 24px rgba(79,70,229,.24); }
    .tl-pro-icon-btn { width:38px;padding:0; }
    .tl-kpi-grid { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px; }
    .tl-kpi-card {
        border:1px solid #e8ecf1;border-radius:12px;background:#fff;padding:14px 16px;
        display:flex;align-items:center;gap:12px;transition:all .18s;
    }
    .tl-kpi-card:hover { transform:translateY(-1px);box-shadow:0 12px 24px rgba(15,23,42,.055);border-color:#d7deea; }
    .tl-kpi-icon { width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex:0 0 auto; }
    .tl-kpi-card strong { display:block;color:#111827;font-size:17px;font-weight:850;line-height:1; }
    .tl-kpi-card span { display:block;margin-top:4px;color:#64748b;font-size:12px;font-weight:600; }
    .tl-list-toolbar-legacy { display:none!important; }
    .tl-overview-layout { grid-template-columns:292px minmax(0,1fr);gap:18px; }
    .tl-card {
        border-color:#e8ecf1;border-radius:13px;padding:14px 16px;box-shadow:0 10px 28px rgba(15,23,42,.026);
    }
    .tl-card:hover { transform:none;box-shadow:0 12px 24px rgba(15,23,42,.055);border-color:#d7deea; }
    .tl-card-icon { border-radius:10px; }
    .tl-card-name { font-size:14px;font-weight:850;color:#111827; }
    .tl-card-count { font-size:12px;font-weight:600;color:#7c89a6;display:flex;align-items:center;gap:6px;flex-wrap:wrap; }
    .tl-kanban-link { text-decoration:none;font-weight:800; }
    .tl-card-progress { height:4px;width:76px;background:#eef2f7;border-radius:999px; }
    .tl-card-preview { padding:10px 0 0 44px;border-color:#eef2f7;margin-top:12px; }
    .tl-preview-item {
        min-height:42px;padding:0 8px;border-bottom:1px solid #f1f4f8;border-radius:0;color:#475569;
    }
