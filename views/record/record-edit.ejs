                                        <iconify-icon icon="tabler:circle-plus" width="14"></iconify-icon>
                                        <span>AJOUTER UN CHAMP</span>
                                    </button>
                                    <button type="button" @click="designMode = !designMode"
                                        class="p-1.5 rounded-lg bg-primary text-white shadow-md transition-all"
                                        title="Quitter le mode layout">
                                        <iconify-icon icon="tabler:layout-dashboard" width="16"></iconify-icon>
                                    </button>
                                </div>
                            </div>

                            <!-- Tab editing inline (when editing tab name) -->
                            <template x-if="editingTabId">
                                <div class="flex items-center gap-2 mb-3 px-2 py-1.5 bg-white dark:bg-[#1b2e4b] rounded-lg shadow-sm ring-1 ring-gray-200 dark:ring-gray-700 w-fit">
                                    <%- include('../components/icon-picker', {
                                        onSelect: '(icon) => { tempTabIcon = icon }' ,
                                        initialIcon: 'tempTabIcon' }) %>
