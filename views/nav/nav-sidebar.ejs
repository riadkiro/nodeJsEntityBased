                  @click="$store.sidebar.showMenu = false; window.location.href = '/account/<%= account_number %>/page-builder/cockpit/new?parentId=' + $store.sidebar.contextItem.id + '&parentType=' + $store.sidebar.contextItem.type">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:monitor-smartphone-bold-duotone" width="18" height="18" style="color: #10b981"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Cockpit</span>
                  </div>
                </li>
              </ul>
            </div>
          </template>

          <!-- Mode DATA -->
          <template x-if="menuMode === 'data'">
            <div>
              <h2
                class="text-xs font-medium text-gray-500 dark:text-white-dark mb-3 pb-2 border-b border-gray-200 dark:border-white/10">
                <button @click="menuMode = 'main'" class="mr-2 hover:text-primary transition-colors">
                  <iconify-icon icon="solar:alt-arrow-left-linear" width="18" class="mt-1"></iconify-icon>
                </button>
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:database-bold" width="18" height="18"></iconify-icon>
                  <span>Données</span>
                </div>
              </h2>

              <div class="py-2 space-y-3">
                <!-- Créer nouvelle -->
                <button @click="createItem('entity')" class="btn btn-primary btn-sm w-full gap-2">
                  <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
                  Créer nouvelle
                </button>

                <!-- Séparateur -->
                <div class="flex items-center gap-2 text-xs text-gray-400 py-1">
                  <div class="h-px bg-gray-200 dark:bg-gray-800 flex-1"></div>
                  <span>OU CHOISIR EXISTANTE</span>
                  <div class="h-px bg-gray-200 dark:bg-gray-800 flex-1"></div>
                </div>

                <!-- Recherche -->
                <div class="relative">
                  <input type="text" x-model="entitySearch" placeholder="Rechercher..."
                    class="form-input text-xs pr-8 py-1.5 focus:border-primary w-full bg-white dark:bg-transparent">
                  <iconify-icon icon="solar:magnifer-linear" class="absolute right-2 top-1.5 text-gray-400"
                    width="16"></iconify-icon>
                </div>

                <!-- Liste -->
                <ul class="space-y-0.5 overflow-y-auto max-h-[60vh] custom-scrollbar">
                  <template x-for="entity in filteredEntities()" :key="entity.id">
                    <li
                      class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                      @click="linkExistingEntity(entity)">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <iconify-icon icon="solar:database-line-duotone" width="16"></iconify-icon>
                          <span x-text="entity.name" class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary"></span>
                        </div>
                        <iconify-icon icon="solar:link-bold-duotone"
                          class="opacity-0 group-hover:opacity-100"
                          width="16"></iconify-icon>
                      </div>
                    </li>
                  </template>
                  <template x-if="filteredEntities().length === 0">
                    <li class="text-center py-4 text-xs text-gray-400 dark:text-gray-500 italic">Aucune entité trouvée</li>
                  </template>
                </ul>
              </div>
            </div>
          </template>
        </div>

        <!-- POPUP MENU Edit -->
        <div x-show="$store.sidebar.showEditMenu" @click.outside="$store.sidebar.showEditMenu = false" x-transition
          @click.stop style="min-width: 248px; margin-left: 248px; top: 56px; border-left:0px;"
          class="sidebar bg-white dark:bg-[#0e1726] p-4 fixed w-60 z-[100] rounded-md shadow border border-gray-200 dark:border-white/10">
          <h2
            class="text-xs font-medium text-gray-500 dark:text-white-dark mb-3 pb-2 border-b border-gray-200 dark:border-white/10">
            <div class="flex items-center gap-2">
              <iconify-icon icon="solar:add-square-linear" class="ml-2" width="18" height="18"></iconify-icon>
              <span>Créer</span>
            </div>
          </h2>
          <ul class="space-y-0.5">
            <!-- Si c'est une entité, afficher uniquement "Ajouter [nom]" -->
            <template x-if="$store.sidebar.contextItem?.type === 'entity'">
              <div>
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="window.location.href = $store.sidebar.contextItem.link + '/new'">
                  <div class="flex items-center gap-2">
                    <iconify-icon :icon="$store.sidebar.contextItem.icon || 'solar:add-circle-line-duotone'" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary" x-text="'Ajouter ' + ($store.sidebar.contextItem.name || 'élément')"></span>
                  </div>
                </li>
                <!-- Divider -->
                <div class="border-t border-gray-100 dark:border-gray-800 my-1.5 mx-2"></div>
                <!-- View Forms -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="$store.sidebar.showEditMenu = false; window.location.href = '/account/<%= account_number %>/entity/' + $store.sidebar.contextItem.entityId + '/forms'">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:document-text-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Voir les formulaires</span>
                  </div>
                </li>
                <!-- Add Form -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="$store.sidebar.showEditMenu = false; window.location.href = '/account/<%= account_number %>/entity/' + $store.sidebar.contextItem.entityId + '/forms/add'">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:add-square-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Ajouter un formulaire</span>
                  </div>
                </li>
              </div>
            </template>

            <!-- Sinon, afficher la liste complète (pour space, folder, environment) -->
            <template x-if="$store.sidebar.contextItem?.type !== 'entity'">
              <div>
                <!-- Dossier -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="createItem('folder')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:folder-2-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Dossier</span>
                  </div>
                </li>

                <!-- Collection -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="menuMode = 'data'; openCreateMenu($event, $store.sidebar.contextItem)">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:database-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Collection</span>
                  </div>
                </li>

                <!-- Documents -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="createItem('entity', 'document')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:document-text-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Documents</span>
                  </div>
                </li>

                <!-- Médias -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="createItem('entity', 'media')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:gallery-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Médias</span>
                  </div>
                </li>

                <!-- Notes -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="createItem('entity', 'note')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:notes-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Notes</span>
                  </div>
                </li>

                <!-- Tâches -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="createItem('entity', 'task')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:clipboard-check-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Tâches</span>
                  </div>
                </li>

                <!-- Calendrier -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="createItem('entity', 'calendar')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:calendar-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Calendrier</span>
                  </div>
                </li>

                <!-- Contact -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="createItem('entity', 'contact')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:user-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Contact</span>
                  </div>
                </li>

                <!-- Drive -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="createItem('entity', 'drive')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:folder-cloud-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Drive</span>
                  </div>
                </li>

                <!-- Discussion -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="createItem('entity', 'discussion')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:chat-round-line-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Discussion</span>
                  </div>
                </li>

                <!-- Analyse -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="createItem('entity', 'analyse')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:chart-line-duotone" width="18" height="18"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Analyse</span>
                  </div>
                </li>

                <!-- Cockpit -->
                <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
                  @click="$store.sidebar.showEditMenu = false; window.location.href = '/account/<%= account_number %>/page-builder/cockpit/new?parentId=' + $store.sidebar.contextItem.id + '&parentType=' + $store.sidebar.contextItem.type">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:monitor-smartphone-bold-duotone" width="18" height="18" style="color: #10b981"></iconify-icon>
                    <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Cockpit</span>
                  </div>
                </li>
              </div>
            </template>

            <!-- Séparateur -->
            <li class="py-2">
              <div class="h-px bg-gray-200 dark:bg-white/10"></div>
            </li>

            <!-- Renommer -->
            <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
              @click="startRename($store.sidebar.contextItem)">
              <div class="flex items-center gap-2">
                <iconify-icon icon="solar:pen-line-duotone" width="18" height="18"></iconify-icon>
                <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Renommer</span>
              </div>
            </li>

            <!-- Changer l'icône -->
            <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group"
              @click="openIconEditor($store.sidebar.contextItem)">
              <div class="flex items-center gap-2">
                <iconify-icon icon="solar:star-line-duotone" width="18" height="18"></iconify-icon>
                <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Changer l'icône</span>
              </div>
            </li>

            <!-- Partager -->
            <li class="hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1.5 rounded-lg cursor-pointer transition-colors group">
              <div class="flex items-center gap-2">
                <iconify-icon icon="solar:share-line-duotone" width="18" height="18"></iconify-icon>
                <span class="text-xs text-gray-700 dark:text-gray-400 group-hover:text-primary">Partager</span>
              </div>
            </li>

            <!-- Supprimer -->
            <li class="hover:bg-red-50 dark:hover:bg-red-900/20 px-2 py-1.5 rounded-lg cursor-pointer transition-colors text-red-500"
              @click="deleteItem()">
              <div class="flex items-center gap-2">
                <iconify-icon icon="solar:trash-bin-trash-line-duotone" width="18"
                  height="18"></iconify-icon>
                <span class="text-xs">Supprimer</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- CONFIG MODAL (Fixed at center) -->
        <div x-show="showViewConfigModal"
          class="fixed inset-0 z-[1000] flex items-center justify-center bg-black/50 p-4" x-cloak>
          <div class="bg-white dark:bg-[#1b2e4b] w-full max-w-xl rounded-xl shadow-2xl overflow-hidden"
            @click.outside="showViewConfigModal = false">
            <div class="p-6 border-b dark:border-gray-800 flex justify-between items-center">
              <h3 class="text-xl font-bold dark:text-white"
                x-text="'Configurer la vue : ' + (configView ? configView.name : '')"></h3>
              <button @click="showViewConfigModal = false" class="text-gray-400 hover:text-white transition-colors">
                <iconify-icon icon="solar:close-circle-bold" width="24"></iconify-icon>
              </button>
            </div>

            <div class="p-6 space-y-6 max-h-[70vh] overflow-y-auto custom-scrollbar">
              <!-- View Type Selector -->
              <div class="space-y-2">
                <label class="block text-sm font-semibold dark:text-gray-300">Type d'affichage</label>
                <div class="grid grid-cols-4 gap-3">
                  <template x-for="type in ['list', 'kanban', 'checklist', 'table']">
                    <button class="p-3 rounded-lg border-2 flex flex-col items-center gap-2 transition-all"
                      :class="tempViewType === type ? 'border-primary bg-primary/5 text-primary' : 'border-gray-100 dark:border-gray-800 text-gray-500 grayscale hover:grayscale-0 hover:border-primary/50'"
                      @click="tempViewType = type">
                      <iconify-icon :icon="getIcon(type === 'list' || type === 'table' ? 'entity' : type)"
                        width="24"></iconify-icon>
                      <span class="text-[10px] font-bold uppercase" x-text="type"></span>
                    </button>
                  </template>
                </div>
              </div>

              <!-- Filters Section -->
              <div class="space-y-4 pt-4 border-t dark:border-gray-800">
                <div class="flex items-center justify-between">
                  <label class="text-sm font-semibold dark:text-gray-300">Filtres dynamiques</label>
                  <button class="btn btn-sm btn-outline-primary" @click="addFilter()">
                    <iconify-icon icon="solar:add-circle-bold" class="mr-1"></iconify-icon> Ajouter un filtre
                  </button>
                </div>

                <div class="space-y-3">
                  <template x-for="(filter, index) in tempFilters" :key="index">
                    <div
                      class="flex items-center gap-2 bg-gray-50 dark:bg-black/20 p-3 rounded-lg border dark:border-gray-800">
                      <select x-model="filter.field" class="form-select flex-1 text-xs">
                        <option value="">Choisir un champ...</option>
                        <optgroup label="Standard">
                          <option value="title">Titre</option>
                          <option value="status">Statut</option>
                          <option value="createdAt">Date de création</option>
                        </optgroup>
                        <optgroup label="Personnalisé" x-show="configEntity">
                          <template x-for="f in (configEntity ? configEntity.customFields : [])" :key="f._id">
                            <option :value="f._id" x-text="f.label"></option>
                          </template>
                        </optgroup>
                      </select>
                      <select x-model="filter.operator" class="form-select w-28 text-xs">
                        <option value="equals">=</option>
                        <option value="not_equals">!=</option>
                        <option value="contains">contient</option>
                        <option value="greater_than">&gt;</option>
                        <option value="less_than">&lt;</option>
                      </select>
                      <input type="text" x-model="filter.value" class="form-input flex-1 text-xs"
                        placeholder="Valeur...">
                      <button class="text-red-500 p-1 hover:bg-red-50/10 rounded" @click="removeFilter(index)">
                        <iconify-icon icon="solar:trash-bin-minimalistic-bold" width="18"></iconify-icon>
                      </button>
                    </div>
                  </template>
                  <div x-show="tempFilters.length === 0" class="text-center py-4 text-gray-400 italic text-xs">
                    Aucun filtre actif (affiche tout)
                  </div>
                </div>
              </div>
            </div>

            <div class="p-6 border-t dark:border-gray-800 bg-gray-50 dark:bg-black/10 flex justify-end gap-3">
              <button class="btn btn-outline-danger" @click="showViewConfigModal = false">Annuler</button>
              <button class="btn btn-primary" @click="saveViewConfig()">Enregistrer les modifications</button>
            </div>
          </div>
        </div>
    </div>
</div>
</nav>
</div>

<!-- ═══ Standalone Environment Modal (outside nav to avoid transform issues) ═══ -->
<div x-data="envModalComponent()">
  <div :style="modalOpen ? 'position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;display:flex;align-items:center;justify-content:center;' : 'display:none;'"
       @keydown.escape.window="modalOpen && (modalOpen = false)">
    <!-- Backdrop -->
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);backdrop-filter:blur(4px);" @click="modalOpen = false"></div>
    <!-- Dialog -->
    <div style="position:relative;width:380px;max-height:90vh;overflow-y:auto;overflow-x:hidden;border-radius:16px;box-shadow:0 25px 50px -12px rgba(0,0,0,.25);background:#fff;"
         class="dark:bg-[#1b2e4b]">

      <!-- Modal Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-gray-700">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white" x-text="editingEnv ? 'Modifier' : 'Nouvel environnement'"></h3>
        <button @click="modalOpen = false" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
          <iconify-icon icon="solar:close-circle-bold" width="22"></iconify-icon>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="px-6 py-5 space-y-5">
        <!-- Preview -->
        <div class="flex items-center justify-center">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center shadow-lg transition-all duration-300"
               :style="'background:' + formColor + '20; border: 2px solid ' + formColor + '40'">
            <iconify-icon :icon="formIcon" width="32" height="32" :style="'color:' + formColor"></iconify-icon>
          </div>
        </div>

        <!-- Name -->
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Nom</label>
          <input type="text" x-model="formName" x-ref="envNameInput"
                 placeholder="Ex: Production, CRM, RH..."
                 class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none transition-all text-sm">
        </div>

        <!-- Icon -->
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Icône</label>
          <div class="relative">
            <input type="text" x-model="iconSearch" placeholder="Rechercher une icône..."
                   @input.debounce.300ms="searchIcons()"
                   class="w-full px-4 py-2.5 pl-10 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary/30 focus:border-primary outline-none transition-all text-sm">
            <iconify-icon icon="solar:magnifer-linear" width="16" class="absolute left-3 top-3 text-gray-400"></iconify-icon>
          </div>
          <div style="display:grid;grid-template-columns:repeat(8,1fr);gap:4px;margin-top:8px;max-height:128px;overflow-y:auto;padding:4px;border-radius:12px;border:1px solid #f3f4f6;" class="custom-scrollbar dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
            <template x-for="ic in iconResults" :key="ic">
              <button @click="formIcon = ic"
                      class="w-8 h-8 rounded-lg flex items-center justify-center cursor-pointer transition-all hover:bg-white dark:hover:bg-gray-700"
                      :class="formIcon === ic ? 'ring-2 ring-primary bg-primary/10' : ''">
                <iconify-icon :icon="ic" width="18" :style="formIcon === ic ? 'color:' + formColor : ''"></iconify-icon>
              </button>
            </template>
          </div>
        </div>

        <!-- Color -->
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Couleur</label>
          <div class="flex items-center gap-2 flex-wrap">
            <template x-for="c in presetColors" :key="c">
              <button @click="formColor = c"
                      class="w-7 h-7 rounded-full cursor-pointer transition-all hover:scale-110 border-2"
                      :style="'background:' + c"
                      :class="formColor === c ? 'border-gray-900 dark:border-white scale-110 shadow-lg' : 'border-transparent'">
              </button>
            </template>
            <div class="relative w-7 h-7 rounded-full border-2 border-dashed border-gray-300 cursor-pointer overflow-hidden flex items-center justify-center hover:border-gray-400 transition-colors">
              <iconify-icon icon="solar:palette-bold" width="14" class="text-gray-400 pointer-events-none"></iconify-icon>
              <input type="color" x-model="formColor" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
            </div>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 flex justify-end gap-3">
        <button @click="modalOpen = false"
                class="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-colors">
          Annuler
        </button>
        <button @click="saveEnvironment()"
                class="px-5 py-2 text-sm font-semibold text-white rounded-xl transition-all hover:shadow-lg"
                :style="'background:' + formColor"
                :disabled="!formName.trim()">
          <span x-text="editingEnv ? 'Enregistrer' : 'Créer'"></span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function envModalComponent() {
    return {
      modalOpen: false,
      editingEnv: null,
      formName: '',
      formIcon: 'solar:planet-3-bold-duotone',
      formColor: '#6366f1',
      iconSearch: '',
      iconResults: [],

      presetColors: [
        '#6366f1', '#8b5cf6', '#ec4899', '#ef4444', '#f97316',
        '#eab308', '#22c55e', '#14b8a6', '#06b6d4', '#3b82f6',
        '#6d28d9', '#dc2626', '#059669', '#0891b2', '#7c3aed'
      ],

      defaultIcons: [
        'solar:planet-3-bold-duotone',
        'solar:star-bold-duotone',
        'solar:home-2-bold-duotone',
        'solar:buildings-3-bold-duotone',
        'solar:chart-square-bold-duotone',
        'solar:users-group-rounded-bold-duotone',
        'solar:inbox-bold-duotone',
        'solar:rocket-2-bold-duotone',
        'solar:folder-favourite-bookmark-bold-duotone',
        'solar:widget-5-bold-duotone',
        'solar:heart-pulse-bold-duotone',
        'solar:diploma-verified-bold-duotone',
        'solar:bookmark-square-bold-duotone',
        'solar:database-bold-duotone',
        'solar:shield-check-bold-duotone',
        'solar:fire-bold-duotone',
        'solar:bill-list-bold-duotone',
        'solar:shop-2-bold-duotone',
        'solar:laptop-minimalistic-bold-duotone',
        'solar:case-round-bold-duotone',
        'solar:pie-chart-2-bold-duotone',
        'solar:bolt-circle-bold-duotone',
        'solar:medal-ribbon-bold-duotone',
        'solar:compass-big-bold-duotone'
      ],

      init() {
        this.iconResults = [...this.defaultIcons];
        // Listen for open-env-modal events from the mini-rail
        window.addEventListener('open-env-modal', (e) => {
          const env = e.detail?.env || null;
          if (env) {
            // Edit mode
            this.editingEnv = env;
            this.formName = env.name;
            this.formIcon = env.icon;
            this.formColor = env.color;
          } else {
            // Create mode
            this.editingEnv = null;
            this.formName = '';
            this.formIcon = 'solar:planet-3-bold-duotone';
            this.formColor = this.presetColors[Math.floor(Math.random() * this.presetColors.length)];
          }
          this.iconSearch = '';
          this.iconResults = [...this.defaultIcons];
          this.modalOpen = true;
          this.$nextTick(() => {
            if (this.$refs.envNameInput) this.$refs.envNameInput.focus();
          });
        });
      },

      async saveEnvironment() {
        if (!this.formName.trim()) return;
        const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];

        try {
          if (this.editingEnv) {
            await fetch(`/account/${accountNum}/api/hierarchy/environment/update`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id: this.editingEnv.id,
                name: this.formName.trim(),
                icon: this.formIcon,
                color: this.formColor
              })
            });
            this.modalOpen = false;
            window.dispatchEvent(new CustomEvent('env-modal-saved', { detail: {} }));
          } else {
            const res = await fetch(`/account/${accountNum}/api/hierarchy/environment`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: this.formName.trim(),
                icon: this.formIcon,
                color: this.formColor
              })
            });
            const data = await res.json();
            this.modalOpen = false;
            if (data.success && data.environment) {
              window.dispatchEvent(new CustomEvent('env-modal-saved', { detail: { newEnv: data.environment } }));
            } else {
              window.dispatchEvent(new CustomEvent('env-modal-saved', { detail: {} }));
            }
          }
        } catch (err) {
          console.error('[EnvModal] Save error:', err);
          alert('Erreur lors de la sauvegarde');
        }
      },

      async searchIcons() {
        if (!this.iconSearch.trim()) {
          this.iconResults = [...this.defaultIcons];
          return;
        }
        const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
        try {
          const res = await fetch(`/account/${accountNum}/api/hierarchy/icons?library=solar&search=${encodeURIComponent(this.iconSearch.trim())}&page=1&limit=32`);
          if (res.ok) {
            const data = await res.json();
            this.iconResults = (data.icons || []).map(ic => ic.name);
            if (this.iconResults.length === 0) {
              this.iconResults = [...this.defaultIcons];
            }
          }
        } catch (err) {
          console.error('[EnvModal] Icon search error:', err);
        }
      }
    };
  }
</script>