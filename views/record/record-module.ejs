    [data-theme="dark"] .tqv-comment { background:#1b2e4b; }
    [data-theme="dark"] .tqv-comment-name { color:#e0e6ed; }
    [data-theme="dark"] .tqv-comment-text { color:#bfc9d4; }
    [data-theme="dark"] .tqv-link { background:#1b2e4b; border-color:#253b5c; }
</style>
<div x-data="taskQuickView" x-cloak>
    <div class="tqv-overlay" :class="open ? 'open' : ''" @click="close()"></div>
    <div class="tqv-modal" :class="open ? 'open' : ''" @keydown.escape.window="open && close()">
        <div class="tqv-header">
            <div class="tqv-header-icon">
                <iconify-icon icon="solar:checklist-minimalistic-bold-duotone" width="16" style="color:#10b981"></iconify-icon>
            </div>
            <div class="tqv-title" x-text="task?.title || ''"></div>
            <button class="tqv-close" @click="close()"><iconify-icon icon="solar:close-circle-linear" width="18"></iconify-icon></button>
        </div>
        <div class="tqv-body">
            <div class="tqv-info">
                <div class="tqv-prop">
                    <span class="tqv-prop-label">Statut</span>
                    <span class="tqv-pill" :style="'background:' + statusColor + '15;color:' + statusColor">
                        <span class="tqv-pill-dot" :style="'background:' + statusColor"></span>
                        <span x-text="task?.status || '—'"></span>
                    </span>
                </div>
                <div class="tqv-prop">
                    <span class="tqv-prop-label">Priorité</span>
                    <span class="tqv-prop-val" x-text="task?.priority || 'Aucune'"></span>
                </div>
                <div class="tqv-prop" x-show="task?.assignedTo">
                    <span class="tqv-prop-label">Assigné</span>
                    <span class="tqv-prop-val" x-text="task?.assignedTo || '—'"></span>
                </div>
                <div class="tqv-prop" x-show="task?.dueDate">
                    <span class="tqv-prop-label">Échéance</span>
                    <span class="tqv-prop-val" x-text="task?.dueDate ? new Date(task.dueDate).toLocaleDateString('fr-FR',{day:'2-digit',month:'short',year:'numeric'}) : ''"></span>
                </div>
                <template x-if="task?.description">
                    <div class="tqv-desc" x-text="task.description"></div>
                </template>
                <a class="tqv-link" :href="tasksUrl">
                    <iconify-icon icon="solar:arrow-right-linear" width="12"></iconify-icon>
                    Ouvrir dans les tâches
                </a>
            </div>
            <div class="tqv-comments">
                <div class="tqv-comments-header">
                    <iconify-icon icon="solar:chat-round-dots-bold-duotone" width="13"></iconify-icon>
                    Activité
                    <span style="font-weight:500;text-transform:none;letter-spacing:0;font-size:11px" x-text="'(' + comments.length + ')'"></span>
                </div>
                <div class="tqv-comments-feed">
                    <template x-if="comments.length === 0">
                        <div class="tqv-empty">
                            <iconify-icon icon="solar:chat-round-dots-linear" width="28" style="opacity:.3"></iconify-icon>
                            <p>Aucune activité</p>
                        </div>
                    </template>
                    <template x-for="c in comments" :key="c._id">
                        <div>
                            <template x-if="c.type === 'comment'">
                                <div class="tqv-comment">
                                    <div class="tqv-comment-head">
                                        <div class="tqv-comment-avatar" x-text="(c.userName||'?')[0]"></div>
                                        <span class="tqv-comment-name" x-text="c.userName || 'Anonyme'"></span>
                                        <span class="tqv-comment-time" x-text="fmtTime(c.createdAt)"></span>
                                    </div>
                                    <div class="tqv-comment-text" x-text="c.text"></div>
                                </div>
                            </template>
                            <template x-if="c.type === 'activity'">
                                <div class="tqv-activity">
                                    <iconify-icon icon="solar:restart-linear" width="11"></iconify-icon>
                                    <span><b x-text="c.userName || 'Système'"></b> a changé <span x-text="c.metadata?.field === 'status' ? 'le statut' : 'la priorité'"></span></span>
                                </div>
                            </template>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('taskQuickView', () => ({
        open: false,
        task: null,
        comments: [],
        statusColor: '#9ca3af',
        tasksUrl: '',
        init() {
            window.addEventListener('open-task-detail', (e) => {
                const taskId = e.detail?.taskId;
                if (taskId) this.loadTask(taskId);
            });
        },
        async loadTask(taskId) {
            const acct = '<%= account_number %>';
            this.tasksUrl = window.location.pathname.replace(/\/[^/]*$/, '/tasks') + '?openTask=' + taskId;
            try {
                const res = await fetch(`/account/${acct}/api/record-tasks/${taskId}`, { credentials: 'include' });
                const data = await res.json();
                if (data.success && data.task) {
                    this.task = data.task;
                    const colors = { 'À faire':'#9ca3af', 'En cours':'#3b82f6', 'En revue':'#f59e0b', 'Terminé':'#22c55e', 'Bloqué':'#ef4444' };
                    this.statusColor = colors[this.task.status] || '#9ca3af';
                    this.open = true;
                    const cRes = await fetch(`/account/${acct}/api/record-tasks/${taskId}/comments`, { credentials: 'include' });
                    const cData = await cRes.json();
                    this.comments = cData.success ? (cData.comments || []) : [];
                }
            } catch (e) { console.error('[TaskQuickView] Error:', e); }
        },
        close() { this.open = false; this.task = null; this.comments = []; },
        fmtTime(d) {
            if (!d) return '';
            const diff = Date.now() - new Date(d);
            if (diff < 60000) return "à l'instant";
            if (diff < 3600000) return Math.floor(diff / 60000) + ' min';
            if (diff < 86400000) return Math.floor(diff / 3600000) + ' h';
            return new Date(d).toLocaleDateString('fr-FR', { day:'2-digit', month:'short' });
        }
    }));
});
</script>
<% } %>

</div>
