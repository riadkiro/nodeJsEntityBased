<!-- Record Contextual Module Page -->
<%
const _modulesDef = {
  overview: { icon: 'solar:widget-5-bold-duotone', color: '#6366f1', label: 'Overview', desc: "Vue d'ensemble" },
  fiche:  { icon: 'solar:card-bold-duotone', color: '#4361ee', label: 'Fiche', desc: 'Informations et champs encodés' },
  docs:   { icon: 'solar:document-text-bold-duotone', color: '#f59e0b', label: 'Documents', desc: 'Modèles et documents générés' },
  drive:  { icon: 'solar:cloud-storage-bold-duotone', color: '#ec4899', label: 'Drive', desc: 'Fichiers et médias organisés' },
  'data-room': { icon: 'solar:shield-keyhole-bold-duotone', color: '#0f766e', label: 'Data Room', desc: 'Partage sécurisé, accès et journal' },
  tasks:  { icon: 'solar:checklist-minimalistic-bold-duotone', color: '#10b981', label: 'Tâches', desc: 'Suivi des actions et rappels' },
  agenda: { icon: 'solar:calendar-bold-duotone', color: '#14b8a6', label: 'Agenda', desc: 'Rendez-vous et événements' },
  chat:   { icon: 'solar:chat-round-dots-bold-duotone', color: '#f97316', label: 'Chat', desc: 'Conversations et échanges' },
  emails: { icon: 'solar:letter-bold-duotone', color: '#0ea5e9', label: 'Emails', desc: 'Correspondance liée' },
  notes:  { icon: 'solar:notebook-bold-duotone', color: '#8b5cf6', label: 'Notes', desc: 'Notes et observations' },
  team:   { icon: 'solar:users-group-rounded-bold-duotone', color: '#7c3aed', label: 'Accès', desc: 'Gestion des accès équipe' }
};
const _mod = _modulesDef[moduleName];
const _modColor = _mod.color;
const _ficheFields = (typeof ficheFields !== 'undefined') ? ficheFields : [];
const _recBase = "/account/" + account_number + "/record/" + entity.slug + "/" + record._id;
const _sharedDataRoomOnly = !!(locals.sharedDataRoomMode || (typeof sharedDataRoomMode !== 'undefined' && sharedDataRoomMode));
const _allowedRecordModules = Array.isArray(locals.accessibleRecordModules) ? locals.accessibleRecordModules : null;
const _recordModulePermissions = (locals.accessibleRecordModulePermissions && typeof locals.accessibleRecordModulePermissions === 'object') ? locals.accessibleRecordModulePermissions : null;
const _currentModulePermissions = _recordModulePermissions ? (_recordModulePermissions[moduleName] || { view: false, edit: false }) : { view: true, edit: true };
const _canEditCurrentModule = _recordModulePermissions ? _currentModulePermissions.edit === true : true;
%>

<style>
.rm-page { max-width:1200px; margin:0 auto; padding:24px 32px; }
.rm-hero {
    display:flex; align-items:center; gap:20px; padding:28px 32px;
    background:linear-gradient(135deg, <%= _modColor %>08, <%= _modColor %>04);
    border:1px solid <%= _modColor %>20; border-radius:16px; margin-bottom:28px;
    position:relative; overflow:hidden;
}
.rm-hero::before {
    content:''; position:absolute; top:-40px; right:-40px; width:160px; height:160px;
    background:radial-gradient(circle, <%= _modColor %>12, transparent 70%);
    border-radius:50%; pointer-events:none;
}
.rm-hero-icon {
    width:56px; height:56px; border-radius:14px; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg, <%= _modColor %>20, <%= _modColor %>10); flex-shrink:0; position:relative; z-index:1;
}
.rm-hero-info { flex:1; z-index:1; }
.rm-hero-info h1 { font-size:20px; font-weight:700; color:#0e1726; margin:0 0 4px; display:flex; align-items:center; gap:8px; }
.rm-hero-info h1 span { font-size:13px; font-weight:500; color:#888da8; }
.rm-hero-info p { font-size:13px; color:#888da8; margin:0; }
.rm-hero-meta { text-align:center; z-index:1; }
.rm-hero-count { font-size:28px; font-weight:800; color:<%= _modColor %>; line-height:1; }
.rm-hero-count-label { font-size:11px; color:#888da8; text-transform:uppercase; letter-spacing:.5px; }
.rm-back { display:inline-flex; align-items:center; gap:6px; font-size:13px; color:#888da8; text-decoration:none; margin-bottom:16px; transition:color .2s; }
.rm-back:hover { color:<%= _modColor %>; }
.rm-toolbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; gap:12px; }
.rm-search { display:flex; align-items:center; gap:8px; padding:8px 14px; background:#f8fafc; border:1px solid #e0e6ed; border-radius:10px; flex:1; max-width:360px; }
.rm-search input { border:none; background:none; outline:none; font-size:13px; color:#0e1726; width:100%; font-family:inherit; }
.rm-search input::placeholder { color:#bfc9d4; }
.rm-btn-primary {
    display:inline-flex; align-items:center; gap:6px; padding:8px 18px;
    background:linear-gradient(135deg, <%= _modColor %>, <%= _modColor %>dd);
    color:#fff; border:none; border-radius:10px; font-size:13px; font-weight:600;
    cursor:pointer; transition:all .2s; font-family:inherit; text-decoration:none;
}
.rm-btn-primary:hover { transform:translateY(-1px); box-shadow:0 4px 12px <%= _modColor %>40; }
.rm-nav { display:flex; gap:4px; margin-bottom:24px; padding:4px; background:#f8fafc; border-radius:12px; border:1px solid #e0e6ed; overflow-x:auto; }
.rm-nav a { display:flex; align-items:center; gap:6px; padding:8px 14px; border-radius:8px; font-size:12px; font-weight:500; color:#888da8; text-decoration:none; transition:all .2s; white-space:nowrap; }
.rm-nav a:hover { background:#fff; color:#0e1726; }
.rm-nav a.active { background:#fff; color:#0e1726; box-shadow:0 1px 3px rgba(0,0,0,.08); font-weight:600; }
.rm-items-list { display:flex; flex-direction:column; gap:2px; }
.rm-item {
    display:flex; align-items:center; gap:14px; padding:14px 16px;
    background:#fff; border-radius:10px; border:1px solid transparent;
    transition:all .25s; cursor:pointer; animation:rmFadeIn .4s ease both;
}
.rm-item:hover { border-color:#e0e6ed; box-shadow:0 2px 8px rgba(0,0,0,.04); transform:translateX(2px); }
.rm-item-icon { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.rm-item-body { flex:1; min-width:0; }
.rm-item-title { font-size:13.5px; font-weight:600; color:#0e1726; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.rm-item-date { font-size:11.5px; color:#888da8; display:flex; align-items:center; gap:4px; margin-top:2px; }
.rm-item-badge { padding:3px 10px; border-radius:6px; font-size:11px; font-weight:600; white-space:nowrap; }
.rm-item-action { width:28px; height:28px; border:none; background:none; border-radius:6px; color:#bfc9d4; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all .2s; }
.rm-item-action:hover { background:#f1f5f9; color:#0e1726; }

/* ═══ Shared Field Styles (Overview + Fiche) ═══ */
.ov-card{background:#fff;border-radius:14px;border:1px solid #e8ecf1;padding:18px;transition:box-shadow .3s;animation:rmFadeIn .4s ease both;overflow:visible;position:relative;}
.ov-card-fields{z-index:10;}
.ov-card:hover{box-shadow:0 4px 16px rgba(0,0,0,.04);}
.ov-card-header{display:flex;align-items:center;gap:8px;margin-bottom:12px;font-size:14px;font-weight:700;color:#0e1726;}
.ov-card-link{margin-left:auto;font-size:12px;font-weight:500;color:#888da8;text-decoration:none;transition:color .2s;}
.ov-card-link:hover{color:#4361ee;}
.ov-fields-list{display:flex;flex-direction:column;gap:0;}
.ov-ef{display:flex;align-items:flex-start;gap:10px;padding:10px 12px;border-radius:8px;cursor:pointer;transition:background .15s;border:1px solid transparent;position:relative;}
.ov-ef:hover{background:#f8fafc;border-color:#e8ecf1;}
.ov-ef + .ov-ef{border-top:1px solid #f1f3f5;}
.ov-ef:hover + .ov-ef{border-top-color:transparent;}
.ov-ef:focus-within + .ov-ef{border-top-color:transparent;}
.ov-ef-head{display:flex;align-items:center;gap:7px;width:180px;min-width:180px;flex-shrink:0;padding-top:2px;}
.ov-ef-icon{width:24px;height:24px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.ov-ef-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:#888da8;white-space:nowrap;}
.ov-ef-body{flex:1;min-width:0;}
.ov-ef-view{min-height:24px;display:flex;align-items:center;flex-wrap:wrap;gap:5px;}
.ov-ef-val{font-size:13px;font-weight:500;color:#0e1726;}
.ov-ef-text{font-size:13px;font-weight:500;color:#0e1726;white-space:pre-wrap;line-height:1.45;}
.ov-placeholder{font-size:12.5px;color:#bfc9d4;font-weight:400;font-style:italic;}
.ov-tags{display:flex;flex-wrap:wrap;gap:4px;}
.ov-tag{display:inline-flex;align-items:center;gap:3px;padding:2px 8px;border-radius:5px;font-size:12px;font-weight:600;border:1px solid;line-height:1.4;}
.ov-tag-x{background:none;border:none;cursor:pointer;font-size:13px;line-height:1;padding:0 0 0 2px;color:inherit;opacity:.6;transition:opacity .15s;}
.ov-tag-x:hover{opacity:1;}
.ov-ms-pills{display:flex;flex-wrap:wrap;gap:5px;}
.ov-ms-pill{display:inline-flex;align-items:center;gap:3px;padding:3px 8px;border-radius:5px;font-size:11.5px;font-weight:600;cursor:pointer;border:1px solid #e2e8f0;background:#fff;color:#888da8;transition:all .2s;user-select:none;}
.ov-ms-pill.active{background:rgba(67,97,238,.1);border-color:#4361ee;color:#4361ee;}
.ov-ms-pill:hover{border-color:rgba(67,97,238,.3);background:rgba(67,97,238,.05);color:rgba(67,97,238,.7);}
.ov-ms-check{width:13px;height:13px;flex-shrink:0;}
.ov-rel-editor{position:relative;}
.ov-rel-tags{display:flex;flex-wrap:wrap;gap:5px;padding:5px 8px;border:1.5px solid #e2e8f0;border-radius:7px;min-height:32px;background:#fff;transition:border-color .2s;cursor:text;align-items:center;}
.ov-rel-tags:focus-within{border-color:#4361ee;box-shadow:0 0 0 3px rgba(67,97,238,.08);}
.ov-rel-search{border:none;outline:none;font-size:12.5px;min-width:60px;flex:1;background:transparent;color:#0e1726;font-family:inherit;padding:1px 0;}
.ov-rel-search::placeholder{color:#bfc9d4;}
.ov-rel-dropdown{position:absolute;left:0;right:0;top:100%;margin-top:3px;background:#fff;border:1px solid #e2e8f0;border-radius:8px;box-shadow:0 10px 32px rgba(0,0,0,.12);max-height:220px;overflow-y:auto;z-index:9999;}
.ov-rel-option{display:flex;align-items:center;gap:6px;padding:7px 10px;font-size:12.5px;font-weight:500;color:#0e1726;cursor:pointer;transition:background .12s;}
.ov-rel-option:hover{background:#f0f3ff;}
.ov-rel-option:first-child{border-radius:8px 8px 0 0;}
.ov-rel-option:last-child{border-radius:0 0 8px 8px;}
.ov-rel-create{display:flex;align-items:center;gap:6px;padding:8px 10px;font-size:12px;font-weight:600;color:#4361ee;cursor:pointer;transition:background .12s;border-top:0;border-radius:0 0 8px 8px;}
.ov-rel-create:hover{background:#f0f3ff;}
.ov-rel-empty{padding:10px 12px;font-size:12px;color:#888da8;text-align:center;}
.ov-ef-edit{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px;}
.ov-input{width:100%;padding:6px 10px;border:1.5px solid #e2e8f0;border-radius:7px;font-size:13px;font-family:inherit;color:#0e1726;background:#fff;transition:border-color .2s,box-shadow .2s;outline:none;}
.ov-input:focus{border-color:#4361ee;box-shadow:0 0 0 3px rgba(67,97,238,.08);}
.ov-textarea{resize:vertical;min-height:50px;line-height:1.45;}
.ov-tags-wrap{display:flex;flex-wrap:wrap;gap:5px;padding:5px 8px;border:1.5px solid #e2e8f0;border-radius:7px;min-height:32px;background:#fff;transition:border-color .2s;}
.ov-tags-wrap:focus-within{border-color:#4361ee;box-shadow:0 0 0 3px rgba(67,97,238,.08);}
.ov-tag-input{border:none;outline:none;font-size:12.5px;min-width:80px;flex:1;background:transparent;color:#888da8;font-family:inherit;cursor:pointer;}
.ov-ef-btns{display:flex;gap:3px;justify-content:flex-end;}
.ov-ef-ok,.ov-ef-cancel{background:none;border:none;cursor:pointer;padding:1px;border-radius:4px;transition:transform .15s;line-height:0;}
.ov-ef-ok{color:#10b981;}.ov-ef-ok:hover{transform:scale(1.15);}
.ov-ef-cancel{color:#ef4444;}.ov-ef-cancel:hover{transform:scale(1.15);}
/* Dark mode — shared fields */
.dark .ov-card{background:#0e1726;border-color:#253b5c;}
.dark .ov-card-header{color:#e0e6ed;}
.dark .ov-card-link{color:#506690;}
.dark .ov-ef{border-color:transparent;}
.dark .ov-ef:hover{background:#1b2e4b;border-color:#253b5c;}
.dark .ov-ef + .ov-ef{border-top-color:#1b2e4b;}
.dark .ov-ef:hover + .ov-ef{border-top-color:transparent;}
.dark .ov-ef:focus-within + .ov-ef{border-top-color:transparent;}
.dark .ov-ef-label{color:#506690;}
.dark .ov-ef-val,.dark .ov-ef-text{color:#e0e6ed;}
.dark .ov-placeholder{color:#506690;}
.dark .ov-input{background:#0e1726;border-color:#253b5c;color:#e0e6ed;}
.dark .ov-input:focus{border-color:#4361ee;}
.dark .ov-textarea{background:#0e1726;border-color:#253b5c;color:#e0e6ed;}
.dark .ov-rel-tags{background:#0e1726;border-color:#253b5c;}
.dark .ov-rel-dropdown{background:#0e1726;border-color:#253b5c;}
.dark .ov-rel-option{color:#e0e6ed;}
.dark .ov-rel-option:hover{background:#1b2e4b;}

/* ═══ Fiche Config Mode ═══ */
.fiche-toolbar{display:flex;align-items:center;justify-content:flex-end;gap:8px;padding:4px 8px 12px;margin-bottom:4px;}
.fiche-config-btn{display:flex;align-items:center;gap:5px;padding:5px 12px;border-radius:7px;border:1px solid #e2e8f0;background:#fff;color:#888da8;font-size:11.5px;font-weight:600;cursor:pointer;transition:all .2s;font-family:inherit;}
.fiche-config-btn:hover{border-color:#4361ee;color:#4361ee;background:rgba(67,97,238,.04);}
.fiche-config-btn.active{border-color:#4361ee;color:#4361ee;background:rgba(67,97,238,.06);}
.fiche-config-bar{display:flex;align-items:center;gap:10px;padding:10px 14px;margin-bottom:10px;border-radius:10px;background:linear-gradient(135deg,rgba(67,97,238,.06),rgba(67,97,238,.02));border:1px solid rgba(67,97,238,.12);animation:rmFadeIn .25s ease both;}
.fiche-config-bar-label{font-size:12px;font-weight:700;color:#4361ee;display:flex;align-items:center;gap:5px;}
.fiche-config-bar-actions{margin-left:auto;display:flex;gap:6px;}
.fiche-config-bar-btn{padding:4px 12px;border-radius:6px;border:1px solid rgba(67,97,238,.2);background:#fff;color:#4361ee;font-size:11px;font-weight:600;cursor:pointer;transition:all .15s;font-family:inherit;}
.fiche-config-bar-btn:hover{background:rgba(67,97,238,.06);}
.fiche-config-bar-btn--primary{background:#4361ee;color:#fff;border-color:#4361ee;}
.fiche-config-bar-btn--primary:hover{background:#3651d4;}
.fiche-config-bar-btn--muted{color:#888da8;border-color:#e2e8f0;}
.fiche-config-bar-btn--muted:hover{color:#4361ee;border-color:rgba(67,97,238,.2);}
.fiche-configuring{user-select:none;-webkit-user-select:none;}
.fiche-configuring .ov-ef{cursor:default;}
.fiche-configuring .ov-ef .ov-ef-body{pointer-events:none;opacity:.7;}
.fiche-configuring .ov-ef .fiche-drag-handle,.fiche-configuring .ov-ef .fiche-vis-toggle,.fiche-configuring .ov-ef .fiche-delete-field,.fiche-configuring .ov-ef .fiche-req-badge{pointer-events:auto;}
.ov-ef .fiche-drag-handle{display:none;width:18px;height:18px;align-items:center;justify-content:center;cursor:grab;color:#bfc9d4;font-size:13px;flex-shrink:0;border-radius:4px;transition:color .15s,background .15s;margin-right:2px;}
.fiche-configuring .ov-ef .fiche-drag-handle{display:flex;}
.ov-ef .fiche-drag-handle:hover{color:#4361ee;background:rgba(67,97,238,.06);}
.ov-ef .fiche-drag-handle:active{cursor:grabbing;}
.ov-ef .fiche-vis-toggle{display:none;margin-left:auto;padding:3px;border:none;background:none;cursor:pointer;color:#bfc9d4;border-radius:4px;transition:color .15s,background .15s;flex-shrink:0;line-height:0;}
.fiche-configuring .ov-ef .fiche-vis-toggle{display:block;}
.ov-ef .fiche-vis-toggle:hover{color:#4361ee;background:rgba(67,97,238,.06);}
.ov-ef .fiche-delete-field{display:none;padding:3px;border:none;background:none;cursor:pointer;color:#cbd5e1;border-radius:4px;transition:color .15s,background .15s;flex-shrink:0;line-height:0;}
.fiche-configuring .ov-ef .fiche-delete-field{display:block;}
.ov-ef .fiche-delete-field:hover{color:#ef4444;background:rgba(239,68,68,.08);}
.ov-ef .fiche-delete-field:disabled{opacity:.45;cursor:wait;}
.ov-ef--hidden{opacity:.35;background:#f8fafc;}
.ov-ef--hidden .ov-ef-val,.ov-ef--hidden .ov-ef-text,.ov-ef--hidden .ov-placeholder{text-decoration:line-through;}
.ov-ef .fiche-req-badge{display:none;padding:1px 6px;border-radius:4px;font-size:9.5px;font-weight:700;letter-spacing:.3px;text-transform:uppercase;background:rgba(67,97,238,.08);color:#4361ee;flex-shrink:0;margin-left:auto;}
.fiche-configuring .ov-ef .fiche-req-badge{display:inline-block;}
.ov-ef.sortable-ghost{opacity:.3;background:rgba(67,97,238,.05);border:1px dashed rgba(67,97,238,.3);border-radius:8px;}
.ov-ef.sortable-chosen{box-shadow:0 4px 20px rgba(67,97,238,.12);background:#fff;border-radius:8px;z-index:10;}
/* Dark mode — fiche config */
.dark .fiche-config-btn{background:#0e1726;border-color:#253b5c;color:#506690;}
.dark .fiche-config-btn:hover,.dark .fiche-config-btn.active{border-color:#4361ee;color:#4361ee;background:rgba(67,97,238,.1);}
.dark .fiche-config-bar{background:linear-gradient(135deg,rgba(67,97,238,.12),rgba(67,97,238,.04));border-color:rgba(67,97,238,.2);}
.dark .fiche-config-bar-btn{background:#0e1726;border-color:#253b5c;color:#4361ee;}
.dark .fiche-config-bar-btn--primary{background:#4361ee;color:#fff;}
.dark .fiche-config-bar-btn--muted{color:#506690;border-color:#253b5c;}
.dark .ov-ef--hidden{background:#1b2e4b;}
.dark .ov-ef.sortable-chosen{background:#0e1726;box-shadow:0 4px 20px rgba(0,0,0,.3);}

@keyframes rmFadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
/* ═══ Dark Mode — Record Module ═══ */
.dark .rm-page { background:transparent; }
.dark .rm-back { color:#888da8; }
.dark .rm-back:hover { color:#e0e6ed; }
.dark .rm-hero { background:linear-gradient(135deg, <%= _modColor %>10, <%= _modColor %>05); border-color:<%= _modColor %>30; }
.dark .rm-hero-info h1 { color:#e0e6ed; }
.dark .rm-hero-info p { color:#888da8; }
.dark .rm-nav { background:#1b2e4b; border-color:#253b5c; }
.dark .rm-nav a { color:#888da8; }
.dark .rm-nav a:hover,.dark .rm-nav a.active { background:#0e1726; color:#e0e6ed; }
.dark .rm-item { background:transparent; border-color:transparent; }
.dark .rm-item:hover { border-color:#253b5c; background:#1b2e4b; }
.dark .rm-item-title { color:#e0e6ed; }
.dark .fiche-empty-state h3 { color:#e0e6ed; }
.dark .fiche-empty-state p { color:#506690; }
.dark .rm-search { background:#1b2e4b; border-color:#253b5c; }
.dark .rm-search input { color:#e0e6ed; }
.dark .rm-toolbar { background:#0e1726; border-color:#253b5c; }

@media (max-width:768px) {
    .rm-page { padding:16px; }
    .rm-hero { flex-direction:column; text-align:center; padding:20px; }
}

/* ═══ Field Picker Modal ═══ */
.fiche-add-field-btn{
    display:inline-flex;align-items:center;gap:6px;padding:8px 20px;border-radius:10px;
    border:1.5px dashed #d1d5db;background:transparent;color:#94a3b8;font-size:12.5px;
    font-weight:600;cursor:pointer;transition:all .2s;font-family:inherit;
}
.fiche-add-field-btn:hover{border-color:#4361ee;color:#4361ee;background:rgba(67,97,238,.03);}
.fp-overlay{
    position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(4px);
    z-index:1000;opacity:0;pointer-events:none;transition:opacity .3s;
}
.fp-overlay.fp-open{opacity:1;pointer-events:auto;}
.fp-modal{
    position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.96);
    width:560px;max-width:92vw;max-height:82vh;background:#fff;border-radius:18px;
    box-shadow:0 24px 80px rgba(0,0,0,.15),0 0 0 1px rgba(0,0,0,.04);
    z-index:1001;opacity:0;pointer-events:none;transition:all .3s cubic-bezier(.34,1.56,.64,1);
    display:flex;flex-direction:column;overflow:hidden;
}
.fp-modal.fp-open{opacity:1;pointer-events:auto;transform:translate(-50%,-50%) scale(1);}
.fp-header{
    display:flex;align-items:center;gap:10px;padding:18px 22px 14px;
    border-bottom:1px solid #f1f3f5;flex-shrink:0;
}
.fp-header-title{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700;color:#0e1726;flex:1;}
.fp-back{
    width:30px;height:30px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;
    display:flex;align-items:center;justify-content:center;cursor:pointer;color:#94a3b8;
    transition:all .15s;flex-shrink:0;
}
.fp-back:hover{border-color:#4361ee;color:#4361ee;background:rgba(67,97,238,.04);}
.fp-close{
    width:30px;height:30px;border-radius:8px;border:none;background:none;
    display:flex;align-items:center;justify-content:center;cursor:pointer;color:#bfc9d4;
    transition:all .15s;flex-shrink:0;
}
.fp-close:hover{color:#e7515a;background:rgba(231,81,90,.06);}
.fp-body{padding:18px 22px 22px;overflow-y:auto;flex:1;}
/* Type grid */
.fp-type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.fp-type-card{
    display:flex;flex-direction:column;align-items:center;gap:8px;padding:18px 10px 14px;
    border-radius:12px;border:1.5px solid #f1f3f5;background:#fff;cursor:pointer;
    transition:all .2s;font-family:inherit;text-align:center;
}
.fp-type-card:hover{border-color:#4361ee;background:rgba(67,97,238,.02);transform:translateY(-2px);box-shadow:0 4px 16px rgba(67,97,238,.08);}
.fp-type-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.fp-type-label{font-size:12.5px;font-weight:700;color:#0e1726;line-height:1.2;}
.fp-type-desc{font-size:10.5px;color:#94a3b8;line-height:1.3;}
/* Search */
.fp-search-wrap{
    display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:10px;
    border:1.5px solid #e8ecf1;background:#fafbfc;margin-bottom:14px;transition:border-color .2s;
}
.fp-search-wrap:focus-within{border-color:#4361ee;background:#fff;}
.fp-search{flex:1;border:none;outline:none;background:transparent;font-size:12.5px;font-family:inherit;color:#0e1726;}
.fp-search::placeholder{color:#bfc9d4;}
/* Sections */
.fp-section{margin-bottom:12px;}
.fp-section-title{
    display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;
    text-transform:uppercase;letter-spacing:.4px;color:#94a3b8;margin-bottom:8px;
}
.fp-section-count{
    padding:1px 7px;border-radius:99px;background:#eff6ff;color:#2563eb;
    font-size:10px;font-weight:700;margin-left:2px;
}
/* Field rows */
.fp-fields-list{display:flex;flex-direction:column;gap:4px;}
.fp-field-row{
    display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;
    transition:background .15s;
}
.fp-field-row:hover{background:#f8fafc;}
.fp-field-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.fp-field-info{flex:1;min-width:0;}
.fp-field-name{font-size:13px;font-weight:600;color:#0e1726;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.fp-field-meta{font-size:10.5px;color:#94a3b8;margin-top:1px;}
.fp-field-add-btn{
    padding:5px 12px;border-radius:7px;border:1px solid #e2e8f0;background:#fff;
    font-size:11px;font-weight:600;color:#4361ee;cursor:pointer;transition:all .15s;
    font-family:inherit;display:inline-flex;align-items:center;gap:4px;flex-shrink:0;
}
.fp-field-add-btn:hover{border-color:#4361ee;background:rgba(67,97,238,.04);}
.fp-field-add-btn:disabled{opacity:.5;cursor:default;}
/* Empty hint */
.fp-empty-hint{
    display:flex;flex-direction:column;align-items:center;gap:6px;padding:20px;
    text-align:center;color:#bfc9d4;font-size:12px;
}
/* Create form */
.fp-create-form{
    padding:14px;border-radius:12px;border:1.5px solid #f1f3f5;background:#fafbfc;
}
.fp-create-row{margin-bottom:10px;}
.fp-create-row:last-child{margin-bottom:0;}
.fp-create-label{display:block;font-size:11px;font-weight:700;color:#64748b;margin-bottom:4px;text-transform:uppercase;letter-spacing:.3px;}
.fp-create-input{
    width:100%;padding:8px 12px;border-radius:8px;border:1.5px solid #e8ecf1;
    background:#fff;font-size:13px;font-family:inherit;color:#0e1726;
    transition:border-color .2s;box-sizing:border-box;
}
.fp-create-input:focus{outline:none;border-color:#4361ee;box-shadow:0 0 0 3px rgba(67,97,238,.08);}
.fp-create-textarea{
    width:100%;padding:8px 12px;border-radius:8px;border:1.5px solid #e8ecf1;
    background:#fff;font-size:13px;font-family:inherit;color:#0e1726;resize:vertical;
    transition:border-color .2s;box-sizing:border-box;min-height:60px;
}
.fp-create-textarea:focus{outline:none;border-color:#4361ee;box-shadow:0 0 0 3px rgba(67,97,238,.08);}
.fp-create-btn{
    width:100%;padding:10px;border-radius:10px;border:none;
    background:linear-gradient(135deg,#4361ee,#6366f1);color:#fff;font-size:13px;
    font-weight:700;cursor:pointer;transition:all .2s;font-family:inherit;
    display:inline-flex;align-items:center;justify-content:center;gap:6px;margin-top:10px;
}
.fp-create-btn:hover{transform:translateY(-1px);box-shadow:0 4px 16px rgba(67,97,238,.3);}
.fp-create-btn:disabled{opacity:.5;cursor:default;transform:none;box-shadow:none;}

/* Dark mode — Field Picker */
.dark .fiche-add-field-btn{border-color:#253b5c;color:#506690;background:transparent;}
.dark .fiche-add-field-btn:hover{border-color:#4361ee;color:#4361ee;background:rgba(67,97,238,.06);}
.dark .fp-overlay{background:rgba(0,0,0,.55);}
.dark .fp-modal{background:#0e1726;box-shadow:0 24px 80px rgba(0,0,0,.4),0 0 0 1px #253b5c;}
.dark .fp-header{border-color:#253b5c;}
.dark .fp-header-title{color:#e0e6ed;}
.dark .fp-back{background:#1b2e4b;border-color:#253b5c;color:#94a3b8;}
.dark .fp-back:hover{border-color:#4361ee;color:#4361ee;}
.dark .fp-close{color:#506690;}
.dark .fp-close:hover{color:#e7515a;}
.dark .fp-type-card{border-color:#253b5c;background:#1b2e4b;}
.dark .fp-type-card:hover{border-color:#4361ee;background:rgba(67,97,238,.08);box-shadow:0 4px 16px rgba(67,97,238,.12);}
.dark .fp-type-label{color:#e0e6ed;}
.dark .fp-type-desc{color:#506690;}
.dark .fp-search-wrap{background:#1b2e4b;border-color:#253b5c;}
.dark .fp-search-wrap:focus-within{border-color:#4361ee;background:#0e1726;}
.dark .fp-search{color:#e0e6ed;}
.dark .fp-section-count{background:rgba(67,97,238,.15);color:#818cf8;}
.dark .fp-field-row:hover{background:#1b2e4b;}
.dark .fp-field-name{color:#e0e6ed;}
.dark .fp-field-meta{color:#506690;}
.dark .fp-field-add-btn{background:#1b2e4b;border-color:#253b5c;color:#818cf8;}
.dark .fp-field-add-btn:hover{border-color:#4361ee;}
.dark .fp-create-form{background:#1b2e4b;border-color:#253b5c;}
.dark .fp-create-label{color:#94a3b8;}
.dark .fp-create-input{background:#0e1726;border-color:#253b5c;color:#e0e6ed;}
.dark .fp-create-input:focus{border-color:#4361ee;}
.dark .fp-create-textarea{background:#0e1726;border-color:#253b5c;color:#e0e6ed;}
.dark .fp-create-textarea:focus{border-color:#4361ee;}
.dark .fp-empty-hint{color:#506690;}

@media (max-width:600px) {
    .fp-type-grid{grid-template-columns:repeat(2,1fr);}
    .fp-modal{width:96vw;max-height:90vh;border-radius:14px;}
}
</style>

<div class="rm-page" <% if (moduleName === 'agenda') { %>style="height:calc(100vh - 70px);display:flex;flex-direction:column;padding-top:16px;padding-bottom:0;"<% } %>>
    <a href="<%= _sharedDataRoomOnly ? ('/account/' + account_number + '/shared-with-you') : ('/account/' + account_number + '/record/' + entity.slug + '/list') %>" class="rm-back">
        <iconify-icon icon="solar:arrow-left-linear" width="16"></iconify-icon>
        Retour à <strong><%= _sharedDataRoomOnly ? 'Shared with you' : entity.name %></strong>
        <% if (moduleName === 'agenda') { %>
        <span style="color:#bfc9d4;margin:0 4px">·</span>
        <span style="font-weight:600;color:#0e1726"><%= record.title || 'Sans titre' %></span>
        <% } %>
    </a>

    <% if (moduleName !== 'agenda') { %>
    <div class="rm-hero">
        <div class="rm-hero-icon">
            <iconify-icon icon="<%= entity.icon || _mod.icon %>" width="28" style="color:<%= entity.color || _modColor %>"></iconify-icon>
        </div>
        <div class="rm-hero-info">
            <h1 id="record-hero-title"><%= record.title || 'Sans titre' %></h1>
            <p><%= entity.nameSingular || entity.name %></p>
        </div>
        <% if (moduleName !== 'team' && !_sharedDataRoomOnly && _canEditCurrentModule) { %>
        <div class="rm-hero-actions" style="display:flex;align-items:center;gap:8px;z-index:1;">
            <button type="button" onclick="createDraftRecord()" class="rm-btn-primary" style="background:linear-gradient(135deg,<%= entity.color || '#4361ee' %>,<%= entity.color || '#4361ee' %>dd);font-size:12px;padding:7px 14px;border:none;cursor:pointer;">
                <iconify-icon icon="solar:add-circle-bold" width="15"></iconify-icon>
                Nouveau
            </button>
            <form method="POST" action="/account/<%= account_number %>/record/<%= entity.slug %>/delete/<%= record._id %>" onsubmit="return confirm('Supprimer cet enregistrement ?')" style="margin:0;">
                <button type="submit" class="rm-btn-primary" style="background:linear-gradient(135deg,#e7515a,#e7515add);font-size:12px;padding:7px 14px;">
                    <iconify-icon icon="solar:trash-bin-trash-bold" width="15"></iconify-icon>
                    Supprimer
                </button>
            </form>
        </div>
        <% } %>
    </div>
    <% } %>

    <nav class="rm-nav">
        <% const _allMods = [
            { key:'overview', icon:'solar:widget-5-bold-duotone', color:'#6366f1', label:'Overview' },
            { key:'fiche', icon:'solar:card-bold-duotone', color:'#4361ee', label:'Fiche' },
            { key:'docs', icon:'solar:document-text-bold-duotone', color:'#f59e0b', label:'Docs' },
            { key:'drive', icon:'solar:cloud-storage-bold-duotone', color:'#ec4899', label:'Drive' },
            { key:'data-room', icon:'solar:shield-keyhole-bold-duotone', color:'#0f766e', label:'Data Room' },
            { key:'tasks', icon:'solar:checklist-minimalistic-bold-duotone', color:'#10b981', label:'Tasks' },
            { key:'agenda', icon:'solar:calendar-bold-duotone', color:'#14b8a6', label:'Agenda' },
            { key:'chat', icon:'solar:chat-round-dots-bold-duotone', color:'#f97316', label:'Chat' },
            { key:'emails', icon:'solar:letter-bold-duotone', color:'#0ea5e9', label:'Emails' },
            { key:'notes', icon:'solar:notebook-bold-duotone', color:'#8b5cf6', label:'Notes' },
            { key:'team', icon:'solar:users-group-rounded-bold-duotone', color:'#7c3aed', label:'Accès' }
        ]; %>
        <% const _visibleMods = _sharedDataRoomOnly
            ? _allMods.filter(function(m){ return m.key === 'data-room'; })
            : (_allowedRecordModules ? _allMods.filter(function(m){ return _allowedRecordModules.includes(m.key); }) : _allMods); %>
        <% _visibleMods.forEach(function(m) { %>
        <a href="<%= _recBase %>/<%= m.key %>" class="<%= moduleName === m.key ? 'active' : '' %>"
           style="<%= moduleName === m.key ? 'color:' + m.color : '' %>">
            <iconify-icon icon="<%= m.icon %>" width="16" style="color:<%= m.color %>"></iconify-icon>
            <%= m.label %>
        </a>
        <% }); %>
    </nav>


    <!-- ═══ OVERVIEW MODULE ═══ -->
    <% if (moduleName === 'overview') { %>
    <%
        var _fichePrefs = (typeof fichePreferences !== 'undefined') ? fichePreferences : {};
        var _hiddenFields = (_fichePrefs && _fichePrefs.hiddenFields) ? _fichePrefs.hiddenFields : [];
        var _ovFields = (typeof overviewFields !== 'undefined' && overviewFields.length > 0) ? overviewFields : _ficheFields.map(function(f){ return Object.assign({}, f, { layoutWidth: 12 }); });
    %>
    <div x-data="ovLayoutBuilder()" :class="layoutMode ? 'ov-dm' : ''">
        <!-- Design mode banner -->
        <div class="ov-dm-banner">
            <iconify-icon icon="tabler:layout-dashboard" width="16"></iconify-icon>
            <span>Mode mise en page activé — Glissez les widgets pour réorganiser</span>
            <button type="button" @click="$store.app.layoutMode = false" style="margin-left:auto;padding:4px 12px;border-radius:6px;border:1px solid rgba(67,97,238,.2);background:#fff;color:#4361ee;font-size:11px;font-weight:600;cursor:pointer;">Terminé</button>
        </div>

        <!-- Dynamic layout rows -->
        <div x-ref="ovRowContainer">
            <template x-for="row in rows" :key="row.id">
                <div class="ov-layout-row" :data-row-id="row.id">
                    <div class="ov-row-drag" title="Déplacer la ligne">⠿</div>
                    <button type="button" class="ov-row-remove" @click="removeRow(row.id)" title="Supprimer la ligne">✕</button>
                    <template x-for="(col, ci) in row.columns" :key="col.id">
                        <div class="ov-layout-col" :style="'width:' + (col.width/12*100) + '%;position:relative;'">
                            <!-- Column toolbar -->
                            <div class="ov-col-toolbar">
                                <button type="button" @click="splitColumn(row.id, col.id)" title="Diviser" x-show="col.width >= 4">⫽</button>
                                <button type="button" @click="removeColumn(row.id, col.id)" title="Supprimer colonne" x-show="row.columns.length > 1" style="color:#ef4444;">✕</button>
                            </div>
                            <!-- Resize handle between columns -->
                            <template x-if="ci < row.columns.length - 1">
                                <div class="ov-resize-handle" @mousedown="$event.preventDefault(); _onResizeStart($event, row.id, ci)"></div>
                            </template>
                            <!-- Widgets in this column -->
                            <div class="ov-col-widgets" :data-col-id="col.id">
                                <template x-for="wid in col.widgetIds" :key="wid">
                                    <div class="ov-widget-wrap" :data-widget-id="wid">
                                        <div class="ov-widget-drag" title="Déplacer">⠿</div>
                                        <button type="button" class="ov-widget-remove" @click="removeWidget(wid)" title="Retirer">✕</button>
                                        <!-- Widget: fields -->
                                        <template x-if="wid === 'fields'">
                                        <div class="ov-card ov-card-fields" x-data="ovInlineEdit()">
                                            <% if (typeof _ovFields !== 'undefined') { %><%- include('partials/ov-widget-fields', { _ovFields: _ovFields, _recBase: _recBase, _hiddenFields: _hiddenFields }) %><% } %>
                                        </div>
                                        </template>
                                        <!-- Widget: tasks -->
                                        <template x-if="wid === 'tasks'">
                                        <div class="ov-card ov-card-tasks">
                                            <%- include('partials/ov-widget-tasks', { _recBase: _recBase }) %>
                                        </div>
                                        </template>
                                        <!-- Widget: docs -->
                                        <template x-if="wid === 'docs'">
                                        <div class="ov-card ov-card-docs" x-data="ovSmartDocs()">
                                            <%- include('partials/ov-widget-docs', { _recBase: _recBase }) %>
                                        </div>
                                        </template>
                                        <!-- Widget: drive -->
                                        <template x-if="wid === 'drive'">
                                        <div class="ov-card ov-card-drive">
                                            <%- include('partials/ov-widget-drive', { _recBase: _recBase }) %>
                                        </div>
                                        </template>
                                        <!-- Widget: lines -->
                                        <template x-if="wid === 'lines'">
                                        <div class="ov-card ov-card-lines">
                                            <script type="module" src="/dist/dynamicTable.js"></script>
                                            <div
                                                data-island="dynamic-table"
                                                data-account-number="<%= account_number %>"
                                                data-record-id="<%= record._id %>"
                                                data-entity-id="<%= entity._id %>"
                                                data-schema-filter=""
                                                data-compact="false"
                                            ></div>
                                        </div>
                                        </template>
                                        <!-- Widget: agenda -->
                                        <template x-if="wid === 'agenda'">
                                        <div class="ov-card ov-card-agenda">
                                            <%- include('partials/ov-widget-agenda', { _recBase: _recBase }) %>
                                        </div>
                                        </template>
                                        <!-- Widget: notes -->
                                        <template x-if="wid === 'notes'">
                                        <div class="ov-card ov-card-notes" x-data="ovNotesWidget()">
                                            <%- include('partials/ov-widget-notes', { _recBase: _recBase }) %>
                                        </div>
                                        </template>
                                    </div>
                                </template>
                            </div>
                            <!-- Add widget button OUTSIDE sortable container -->
                                <div class="ov-add-widget-btn" style="position:relative;" x-data="{ pickerOpen: false }" @click.outside="pickerOpen = false">
                                    <div @click="pickerOpen = !pickerOpen" style="display:flex;align-items:center;gap:6px;width:100%;justify-content:center;">
                                        <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                                        <span>Widget</span>
                                    </div>
                                    <div class="ov-widget-picker" x-show="pickerOpen" x-cloak>
                                        <template x-for="w in _availableWidgets()" :key="w.id">
                                            <div class="ov-widget-picker-item" @click="addWidget(col.id, w.id); pickerOpen = false">
                                                <iconify-icon :icon="w.icon" width="15" :style="'color:' + w.color"></iconify-icon>
                                                <span x-text="w.label"></span>
                                            </div>
                                        </template>
                                        <div x-show="_availableWidgets().length === 0" style="padding:10px;text-align:center;color:#888da8;font-size:11px;">Tous les widgets sont placés</div>
                                    </div>
                                </div>
                        </div>
                    </template>
                </div>
            </template>
        </div>
        <!-- Add row button -->
        <div class="ov-add-row-btn" @click="addRow()">
            <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
            <span>Ajouter une ligne</span>
        </div>
    </div>

    <style>
    .ov-grid{display:grid;grid-template-columns:8fr 4fr;gap:16px;}
    .ov-full{grid-column:1/-1;}
    .ov-right-col{display:flex;flex-direction:column;gap:16px;}
    /* Tasks chart */
    .ov-tasks-chart{padding:8px 0;}
    .ov-chart-bars{display:flex;align-items:flex-end;gap:12px;height:80px;padding:0 8px;}
    .ov-bar{flex:1;height:var(--bar-h);border-radius:6px 6px 0 0;display:flex;align-items:flex-start;justify-content:center;transition:height .6s ease;min-width:0;}
    .ov-bar span{font-size:13px;font-weight:700;color:#fff;padding-top:6px;}
    .ov-chart-labels{display:flex;gap:12px;padding:8px 8px 0;font-size:11px;font-weight:600;}
    .ov-chart-labels span{flex:1;text-align:center;}
    /* Docs */
    .ov-doc-list{display:flex;flex-direction:column;gap:4px;}
    .ov-doc-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;font-size:13px;color:#0e1726;transition:background .2s;}
    .ov-doc-item:hover{background:#f8fafc;}
    .ov-doc-item span{flex:1;font-weight:500;}
    .ov-doc-gen{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border:none;border-radius:6px;background:linear-gradient(135deg,#f59e0b15,#f59e0b08);color:#f59e0b;font-size:11px;font-weight:600;cursor:pointer;transition:all .2s;font-family:inherit;}
    .ov-doc-gen:hover{background:#f59e0b;color:#fff;}
    /* Drive */
    .ov-drive-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
    .ov-drive-file{text-align:center;cursor:pointer;transition:transform .2s;min-width:0;}
    .ov-drive-file:hover{transform:translateY(-2px);}
    .ov-drive-thumb{aspect-ratio:4/3;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:8px;background:#f8fafc;}
    .ov-drive-name{font-size:12px;font-weight:600;color:#0e1726;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 2px;}
    .ov-drive-meta{font-size:11px;color:#888da8;margin-top:2px;}
    /* ── Dynamic Tables (Lignes) ── */
    .ov-card-lines{overflow:visible;}
    .ov-card-lines .ov-card-header{margin-bottom:0;}
    .ov-lines-tabs{display:flex;align-items:center;gap:0;padding:0 20px;border-bottom:1px solid #f1f3f5;margin-top:8px;}
    .ov-lines-tab{display:inline-flex;align-items:center;gap:7px;padding:10px 16px 12px;border:none;border-bottom:2px solid transparent;background:transparent;color:#888da8;font-size:12.5px;font-weight:600;cursor:pointer;transition:all .2s;white-space:nowrap;font-family:inherit;}
    .ov-lines-tab:hover{color:#0e1726;}
    .ov-lines-tab.active{color:#0e1726;border-bottom-color:#4361ee;}
    .ov-lines-dot{width:7px;height:7px;border-radius:50%;background:#c8cdd6;flex-shrink:0;transition:background .2s;}
    .ov-lines-tab.active .ov-lines-dot{background:#4361ee;}
    .ov-lines-count{font-size:9px;min-width:16px;height:16px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-weight:700;padding:0 4px;background:rgba(0,171,85,.08);color:#00ab55;}
    .ov-lines-table-wrap{padding:0;overflow-x:auto;}
    .ov-lines-table{width:100%;border-collapse:collapse;font-size:13px;}
    .ov-lines-table thead th{padding:10px 20px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#888da8;background:transparent;border-bottom:1px solid #f1f3f5;text-align:left;white-space:nowrap;}
    .ov-lines-table tbody td{padding:12px 20px;border-bottom:1px solid #f8f9fa;color:#0e1726;vertical-align:middle;}
    .ov-lines-table tbody tr:last-child td{border-bottom:none;}
    .ov-lines-table tbody tr{transition:background .15s;}
    .ov-lines-table tbody tr:hover{background:#f8fafc;}
    .ov-lines-primary{font-weight:600;color:#0e1726;}
    .ov-lines-muted{color:#888da8;font-size:12.5px;}
    .ov-lines-pill{display:inline-flex;align-items:center;padding:3px 10px;border-radius:6px;font-size:11.5px;font-weight:600;white-space:nowrap;}
    .ov-lines-footer{display:flex;align-items:center;justify-content:space-between;padding:10px 20px;border-top:1px solid #f1f3f5;}
    .ov-lines-add{font-size:12.5px;font-weight:500;color:#888da8;cursor:pointer;transition:color .2s;}
    .ov-lines-add:hover{color:#4361ee;}
    .ov-lines-meta{font-size:11px;color:#bfc9d4;font-weight:500;}
    /* Dark: Lines */
