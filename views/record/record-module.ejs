        .drive-btn-secondary:hover { background:#f1f5f9; border-color:#cbd5e1; color:#334155; }
        .drive-dropzone-overlay { position:absolute; inset:0; z-index:50; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; background:rgba(255,255,255,0.95); border:3px dashed #4361ee; border-radius:16px; backdrop-filter:blur(4px); animation:drive-drop-in 0.2s ease; }
        .drive-dropzone-overlay p { font-size:14px; font-weight:600; color:#4361ee; margin:0; }
        .drive-dropzone-overlay span { font-size:11px; color:#94a3b8; }
        @keyframes drive-drop-in { from { opacity:0; transform:scale(0.97); } to { opacity:1; transform:scale(1); } }
        .drive-new-folder { display:flex; align-items:center; gap:8px; padding:10px 14px; margin-bottom:12px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; }
        .drive-new-folder-input { flex:1; border:none; background:transparent; font-size:13px; outline:none; color:#1e293b; }
        .drive-new-folder-input::placeholder { color:#cbd5e1; }
        .drive-new-folder-btn { padding:5px 14px; border-radius:8px; font-size:11px; font-weight:600; background:#4361ee; color:#fff; border:none; cursor:pointer; }
        .drive-new-folder-btn:disabled { opacity:0.4; cursor:default; }
        .drive-new-folder-cancel { background:none; border:none; cursor:pointer; color:#94a3b8; display:flex; padding:2px; }
        .drive-new-folder-cancel:hover { color:#ef4444; }
        .drive-upload-progress { display:flex; align-items:center; gap:10px; padding:10px 14px; margin-bottom:12px; background:#4361ee08; border:1px solid #4361ee20; border-radius:10px; font-size:12px; color:#4361ee; font-weight:500; }
        .drive-progress-bar { flex:1; height:4px; background:#e2e8f0; border-radius:4px; overflow:hidden; }
        .drive-progress-fill { height:100%; background:linear-gradient(90deg,#4361ee,#3b82f6); border-radius:4px; transition:width 0.3s; }
        .drive-file-actions { display:flex; gap:2px; }
        .drive-folder-item:hover { background:#f8fafc; }
        .drive-folder-item--drop-target { background:#4361ee0a !important; box-shadow:inset 0 0 0 2px #4361ee40; border-radius:12px; }
        .drive-empty { text-align:center; padding:40px 20px; color:#94a3b8; }
        .rm-item[draggable='true'] { cursor:grab; }
        .rm-item[draggable='true']:active { cursor:grabbing; opacity:0.6; }
    </style>
    <script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('driveModule', () => ({
            allFiles: [],
            loading: true,
            uploading: false,
            uploadProgress: 0,
            uploadCount: 0,
            isDragging: false,
            draggedFileId: null,
            dropTargetFolder: null,
            currentFolder: '',
            viewingGenerated: false,
            showNewFolderInput: false,
            newFolderName: '',
            customFolders: [],
            _accountNumber: '<%= account_number %>',
            _recordId: '<%= record._id %>',

            get generatedCount() {
                return this.allFiles.filter(f => f.isGenerated).length;
            },

            get displayFolders() {
                if (this.currentFolder || this.viewingGenerated) return [];
                // Compute folders from unique folder names
                const folderMap = {};
                this.allFiles.filter(f => !f.isGenerated && f.folder).forEach(f => {
                    folderMap[f.folder] = (folderMap[f.folder] || 0) + 1;
                });
                // Include custom empty folders
                this.customFolders.forEach(name => {
                    if (!folderMap[name]) folderMap[name] = 0;
                });
                return Object.entries(folderMap)
                    .map(([name, count]) => ({ name, count }))
                    .sort((a, b) => a.name.localeCompare(b.name));
            },

            get displayFiles() {
                if (this.viewingGenerated) {
                    return this.allFiles.filter(f => f.isGenerated).sort((a, b) => new Date(b.uploadedAt) - new Date(a.uploadedAt));
                }
                return this.allFiles
                    .filter(f => !f.isGenerated && (f.folder || '') === this.currentFolder)
                    .sort((a, b) => new Date(b.uploadedAt) - new Date(a.uploadedAt));
            },

            init() {
                this.loadFiles();
            },

            async loadFiles() {
                this.loading = true;
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/attachments`, { credentials: 'include' });
                    const data = await res.json();
                    if (data.success && data.attachments) {
                        this.allFiles = data.attachments;
                    }
                    // Load persisted custom folders
                    if (data.driveFolders && Array.isArray(data.driveFolders)) {
                        this.customFolders = data.driveFolders;
                    }
                } catch (e) {
                    console.error('[Drive] Load error:', e);
                }
                this.loading = false;
            },

            navigateTo(folder) {
                this.currentFolder = folder;
                this.viewingGenerated = false;
            },

            async createFolder() {
                const name = this.newFolderName.trim();
                if (!name) return;
                if (this.customFolders.includes(name) || this.allFiles.some(f => f.folder === name)) {
                    alert('Ce dossier existe déjà');
                    return;
                }
                // Persist via API
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/drive-folders`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ name })
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.customFolders.push(name);
                        if (window.showMessage) window.showMessage('Dossier créé', 'success');
                    } else {
                        alert(data.error || 'Erreur');
                    }
                } catch (e) {
                    console.error('[Drive] Create folder error:', e);
                    alert('Erreur lors de la création');
                }
                this.newFolderName = '';
                this.showNewFolderInput = false;
            },

            handleFileSelect(e) {
                const files = e.target.files;
                if (files.length > 0) this.uploadFiles(files);
                e.target.value = '';
            },

            _dragCounter: 0,

            // --- Internal file drag (file → folder) ---
            startDragFile(e, fileId) {
                this.draggedFileId = fileId;
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', fileId);
            },

            onFolderDragEnter(e, folderName) {
                e.preventDefault();
                if (this.draggedFileId) {
                    this.dropTargetFolder = folderName;
                }
            },

            onFolderDragLeave(e, folderName) {
                // Only clear if leaving this specific folder
                if (this.dropTargetFolder === folderName) {
                    this.dropTargetFolder = null;
                }
            },

            onFolderDrop(e, folderName) {
                e.preventDefault();
                e.stopPropagation();
                if (this.draggedFileId) {
                    this.moveFileToFolder(this.draggedFileId, folderName);
                    this.draggedFileId = null;
                    this.dropTargetFolder = null;
                    return;
                }
                // External file drop on folder → upload to that folder
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    const prevFolder = this.currentFolder;
                    this.currentFolder = folderName;
                    this.uploadFiles(files);
                    this.currentFolder = prevFolder;
                }
            },

            onDragEnd() {
                this.draggedFileId = null;
                this.dropTargetFolder = null;
            },

            async moveFileToFolder(fileId, folderName) {
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/attachments/${fileId}`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ folder: folderName })
                    });
                    const data = await res.json();
                    if (data.success) {
                        // Update local state
                        const file = this.allFiles.find(f => f._id === fileId);
                        if (file) file.folder = folderName;
                        if (window.showMessage) window.showMessage('Fichier déplacé', 'success');
                    }
                } catch (e) {
                    console.error('[Drive] Move error:', e);
                }
            },

            // --- External file drag (OS → browser) ---
            onDragEnter(e) {
                if (this.viewingGenerated) return;
                if (this.draggedFileId) return; // internal drag, don't show overlay
                this._dragCounter++;
                if (e.dataTransfer?.types?.includes('Files')) {
                    this.isDragging = true;
                }
            },

            onDragLeave(e) {
                if (this.draggedFileId) return;
                this._dragCounter--;
                if (this._dragCounter <= 0) {
                    this._dragCounter = 0;
                    this.isDragging = false;
                }
            },

            handleDrop(e) {
                this._dragCounter = 0;
                this.isDragging = false;
                if (this.draggedFileId) {
                    this.draggedFileId = null;
                    this.dropTargetFolder = null;
                    return;
                }
                const files = e.dataTransfer.files;
                if (files.length > 0) this.uploadFiles(files);
            },

            async uploadFiles(fileList) {
                this.uploading = true;
                this.uploadProgress = 0;
                this.uploadCount = fileList.length;

                const formData = new FormData();
                for (const file of fileList) {
                    formData.append('files', file);
                }
                formData.append('folder', this.currentFolder);

                try {
                    const xhr = new XMLHttpRequest();
                    xhr.upload.addEventListener('progress', (e) => {
                        if (e.lengthComputable) this.uploadProgress = Math.round((e.loaded / e.total) * 100);
                    });

                    await new Promise((resolve, reject) => {
                        xhr.onload = () => {
                            if (xhr.status >= 200 && xhr.status < 300) {
                                try {
                                    const data = JSON.parse(xhr.responseText);
                                    if (data.success && data.attachments) {
                                        // Add folder to uploaded attachments
                                        data.attachments.forEach(a => { a.folder = this.currentFolder; });
                                        this.allFiles.push(...data.attachments);
                                    }
                                } catch (e) { /* ignore */ }
                                resolve();
                            } else {
                                reject(new Error('Upload failed'));
                            }
                        };
                        xhr.onerror = reject;
                        xhr.open('POST', `/account/${this._accountNumber}/api/records/${this._recordId}/attachments`);
                        xhr.withCredentials = true;
                        xhr.send(formData);
                    });

                    if (window.showMessage) window.showMessage(this.uploadCount + ' fichier(s) ajouté(s)', 'success');
                } catch (e) {
                    console.error('[Drive] Upload error:', e);
                    alert('Erreur lors de l\'upload');
                }
                this.uploading = false;
                this.uploadProgress = 0;
            },

            async deleteFile(file) {
                if (!confirm('Supprimer "' + file.originalName + '" ?')) return;
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/attachments/${file._id}`, {
                        method: 'DELETE', credentials: 'include'
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.allFiles = this.allFiles.filter(f => f._id !== file._id);
                        if (window.showMessage) window.showMessage('Fichier supprimé', 'success');
                    }
                } catch (e) {
                    console.error('[Drive] Delete error:', e);
                }
            },

            formatDate(dateStr) {
                if (!dateStr) return '';
                return new Date(dateStr).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
            },

            getCategoryIcon(cat) {
                const map = { image: 'solar:gallery-bold-duotone', pdf: 'solar:file-text-bold-duotone', word: 'solar:document-bold-duotone', excel: 'solar:chart-square-bold-duotone', video: 'solar:videocamera-record-bold-duotone', audio: 'solar:music-note-2-bold-duotone' };
                return map[cat] || 'solar:file-bold-duotone';
            },

            getCategoryColor(cat) {
                const map = { image: '#8b5cf6', pdf: '#ef4444', word: '#3b82f6', excel: '#10b981', video: '#f59e0b', audio: '#ec4899' };
                return map[cat] || '#6b7280';
            }
        }));
    });
    </script>
    <% } %>

    <!-- ═══ FICHE MODULE ═══ -->
    <% if (moduleName === 'fiche') { %>
    <div class="fiche-grid">
        <% if (_ficheFields.length === 0) { %>
            <div class="fiche-empty-state">
                <iconify-icon icon="solar:card-bold-duotone" width="48" style="color:#bfc9d4"></iconify-icon>
                <h3>Aucun champ renseigné</h3>
                <p>Les informations encodées apparaîtront ici</p>
            </div>
        <% } else { %>
            <% _ficheFields.forEach(function(f, idx) { %>
            <div class="fiche-field<%= (f.type === 'textarea' || f.type === 'richtext' || f.key === 'description' || String(f.value).length > 80) ? ' full-width' : '' %>"
                 style="animation-delay:<%= idx * 40 %>ms"
                 title="Cliquer pour modifier">
                <div class="fiche-field-icon" style="background:linear-gradient(135deg, <%= f.color || '#4361ee' %>12, <%= f.color || '#4361ee' %>06)">
                    <iconify-icon icon="<%= f.icon %>" width="18" style="color:<%= f.color || '#4361ee' %>"></iconify-icon>
                </div>
                <div class="fiche-field-body">
                    <div class="fiche-field-label"><%= f.label %></div>
                    <div class="fiche-field-value"><%= f.value %></div>
                </div>
                <div class="fiche-edit-hint">
                    <iconify-icon icon="solar:pen-2-bold" width="12"></iconify-icon>
                    Modifier
                </div>
            </div>
            <% }); %>
        <% } %>
    </div>
    <% } %>

    <!-- ═══ OTHER MODULES (non-docs) ═══ -->
    <% if (moduleName !== 'fiche' && moduleName !== 'overview' && moduleName !== 'docs' && moduleName !== 'drive' && moduleName !== 'tasks' && moduleName !== 'chat' && moduleName !== 'notes') { %>
    <div class="rm-toolbar">
        <div class="rm-search">
            <iconify-icon icon="solar:magnifer-linear" width="16" style="color:#bfc9d4"></iconify-icon>
            <input type="text" placeholder="Rechercher dans <%= _mod.label.toLowerCase() %>...">
        </div>
        <a href="#" class="rm-btn-primary">
            <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
            Nouveau
        </a>
    </div>
    <% } %>

    
        <% if (moduleName === 'docs') { %>
        <div x-data="docsModule" x-cloak>
            <!-- Tabs -->
            <div class="rm-toolbar" style="flex-direction:column; gap:0; padding-bottom:0;">
                <div style="display:flex; align-items:center; gap:0; border-bottom:2px solid #f1f3f5; width:100%;">
                    <button @click="activeTab = 'generated'"
                        :class="activeTab === 'generated' ? 'rm-docs-tab--active' : ''"
                        class="rm-docs-tab">
                        <iconify-icon icon="solar:file-check-bold-duotone" width="15"></iconify-icon>
                        Générés
                        <span class="rm-docs-tab-count" x-text="generatedDocs.length" x-show="generatedDocs.length > 0"></span>
                    </button>
                    <button @click="activeTab = 'templates'"
                        :class="activeTab === 'templates' ? 'rm-docs-tab--active' : ''"
                        class="rm-docs-tab">
                        <iconify-icon icon="solar:file-text-bold-duotone" width="15"></iconify-icon>
                        Templates
                        <span class="rm-docs-tab-count" x-text="templates.length" x-show="templates.length > 0"></span>
                    </button>
                </div>
            </div>

            <!-- Tab: Générés -->
            <div x-show="activeTab === 'generated'" class="rm-items-list">
                <!-- Loading state -->
                <div x-show="loading" style="text-align:center; padding:32px 0; color:#94a3b8;">
                    <iconify-icon icon="line-md:loading-twotone-loop" width="28"></iconify-icon>
                    <p style="font-size:12px; margin-top:8px;">Chargement...</p>
                </div>
                <!-- Empty state -->
                <div x-show="!loading && generatedDocs.length === 0" style="text-align:center; padding:40px 20px; color:#94a3b8;">
                    <iconify-icon icon="solar:file-check-bold-duotone" width="40" style="opacity:0.3"></iconify-icon>
                    <p style="font-size:13px; margin-top:10px; font-weight:500;">Aucun document généré</p>
                    <p style="font-size:11px; margin-top:4px;">Les documents apparaîtront ici après génération</p>
                </div>
                <!-- Generated docs list -->
                <template x-for="(doc, idx) in generatedDocs" :key="doc._id || idx">
                    <div class="rm-item" :style="'animation-delay:' + (idx * 50) + 'ms'">
