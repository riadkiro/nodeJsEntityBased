                                                        <iconify-icon x-show="getEditLines()[editModal.lineIdx]?.values[getRelationCol()?.key] === result.id" icon="tabler:check" width="12" style="color:#2563eb;"></iconify-icon>
                                                    </div>
                                                    <span class="tp-option-label" x-text="result.label"></span>
                                                </div>
                                            </template>
                                            <template x-if="!editRelLoading && !(editRelResults || []).length">
                                                <div style="padding:12px; text-align:center; color:#9ca3af; font-size:12px;">Aucun résultat</div>
                                            </template>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </template>
                        <template x-for="col in getVisibleColumnsForLine(getEditLines()[editModal.lineIdx]).filter(c => c.type !== 'relation')" :key="col.key">
