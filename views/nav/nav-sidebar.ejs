                              x-model="editingName" @keyup.enter="saveRename(child)" @blur="saveRename(child)"
                              x-init="$nextTick(() => $el.focus())">
                          </template>
                        </div>

                        <div class="flex items-center gap-1 pr-4 transition-opacity"
                          :class="hovered ? 'opacity-100' : 'opacity-0'">
                          <iconify-icon icon="solar:add-square-linear" width="14" height="14"
                            class="cursor-pointer hover:text-primary"
                            @click.stop="openEditMenu($event, child.type, child, item)"></iconify-icon>
                        </div>

                      </div>

                      <!-- Nested children for Folders/Environments -->
                      <ul x-show="['folder', 'environment'].includes(child.type) && subActive.includes(child.id)"
