{
  "name": "saasnodetemplate",
  "version": "1.0.0",
  "description": "",
  "main": "generator.js",
  "scripts": {
    "server": "nodemon server.js",
    "client": "vite build --watch",
    "tailwind": "npx @tailwindcss/cli -i ./public/themes/default/assets/css/tailwind.css -o ./public/themes/default/assets/css/style.css",
    "tailwind:watch": "npx @tailwindcss/cli -i ./public/themes/default/assets/css/tailwind.css -o ./public/themes/default/assets/css/style.css --watch",
    "dev": "concurrently \"npm run server\" \"npm run client\" \"npm run tailwind:watch\"",
    "build": "vite build && npm run tailwind",
    "build:watch": "vite build --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.0.0",
    "axios": "^1.13.4",
    "bcrypt": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "imap-simple": "^5.1.0",
    "is-hotkey": "^0.2.0",
    "kiro-app-gen": "^1.0.6",
    "mailparser": "^3.9.1",
    "multer": "^2.0.1",
    "passport-google-oauth20": "^2.0.0",
    "puppeteer": "^24.37.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "vite": "^5.0.0"
  }
}
