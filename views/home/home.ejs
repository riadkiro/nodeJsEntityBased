<% const _homeApi = '/account/' + account_number; %>

<style>
.ai-home{height:calc(100dvh - 86px);min-height:0;overflow:hidden;color:#172033;font-family:inherit}
.ai-home-shell{position:relative;height:100%;display:grid;grid-template-columns:230px minmax(480px,1.08fr) minmax(350px,.82fr);overflow:hidden;border:1px solid var(--focus-border,#e5e7eb);border-radius:var(--focus-radius,14px);background:#fff;box-shadow:var(--focus-shadow-soft,0 8px 30px rgba(15,23,42,.05))}
.ai-conversation-sidebar{min-width:0;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr);border-right:1px solid #e8edf4;background:#fbfcff}
.ai-history-head{height:68px;padding:0 14px 0 17px;display:flex;align-items:center;justify-content:space-between;gap:10px;border-bottom:1px solid #e8edf4}
.ai-history-title{display:flex;align-items:center;gap:8px;color:#263146;font-size:12.5px;font-weight:900}
.ai-history-title span:first-child{width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:10px;background:#efedff;color:#634efb}
.ai-history-new{width:32px;height:32px;display:flex;align-items:center;justify-content:center;border:1px solid #ded9ff;border-radius:10px;background:#fff;color:#634efb;cursor:pointer;transition:.15s}
.ai-history-new:hover{background:#f1efff;border-color:#c9c1ff}
.ai-history-list{min-height:0;overflow-y:auto;padding:10px 8px 16px}
.ai-history-list::-webkit-scrollbar{width:5px}.ai-history-list::-webkit-scrollbar-thumb{border-radius:999px;background:#dfe5ee}
.ai-history-empty{padding:36px 13px;text-align:center;color:#96a1b3;font-size:10.5px;font-weight:700;line-height:1.55}
.ai-history-empty iconify-icon{display:block;margin:0 auto 8px;color:#b9b1ff}
.ai-history-item{position:relative;margin-bottom:4px;border-radius:11px;transition:.15s}
.ai-history-item:hover,.ai-history-item.is-active{background:#f0edff}
.ai-history-open{width:100%;min-width:0;padding:10px 31px 10px 10px;display:block;border:0;background:transparent;text-align:left;font:inherit;cursor:pointer}
.ai-history-label{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#3c4659;font-size:10.8px;font-weight:850}
.ai-history-meta{margin-top:4px;display:flex;align-items:center;gap:6px;color:#9aa5b5;font-size:8.5px;font-weight:750}
.ai-history-meta i{width:3px;height:3px;border-radius:50%;background:#c2cad6}
.ai-history-remove{position:absolute;right:6px;top:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;transform:translateY(-50%);border:0;border-radius:7px;background:transparent;color:#a6afbe;opacity:0;cursor:pointer}
.ai-history-item:hover .ai-history-remove,.ai-history-item.is-active .ai-history-remove{opacity:1}.ai-history-remove:hover{background:#fff;color:#ef4444}
.ai-history-backdrop{display:none}
.ai-chat{min-width:0;min-height:0;display:grid;grid-template-rows:68px minmax(0,1fr) auto;border-right:1px solid #e8edf4;background:#fff}
.ai-chat-head{padding:0 22px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid #e8edf4}
.ai-chat-identity{min-width:0;display:flex;align-items:center;gap:11px}
.ai-agent-avatar{position:relative;width:40px;height:40px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;border-radius:13px;background:linear-gradient(145deg,#7561ff,#4f3de7);color:#fff;box-shadow:0 8px 22px rgba(99,78,251,.23)}
.ai-agent-avatar::after{content:'';position:absolute;right:-1px;bottom:-1px;width:10px;height:10px;border:2px solid #fff;border-radius:50%;background:#22c55e}
.ai-chat-title{min-width:0}
.ai-chat-title h1{margin:0;color:#172033;font-size:15px;font-weight:850;letter-spacing:-.01em}
.ai-chat-title p{margin:3px 0 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#8b97aa;font-size:10.5px;font-weight:700}
.ai-chat-tools{display:flex;align-items:center;gap:8px}
.ai-history-toggle{display:none;width:34px;height:34px;align-items:center;justify-content:center;border:1px solid #e0e6ef;border-radius:10px;background:#fff;color:#657187;cursor:pointer}
.ai-model-picker{position:relative}
.ai-model-trigger{height:36px;min-width:126px;padding:0 10px;display:flex;align-items:center;gap:8px;border:1px solid #e1e6ef;border-radius:10px;background:#f9fafc;color:#536075;font:inherit;cursor:pointer;transition:.15s}
.ai-model-trigger:hover,.ai-model-trigger.is-open{border-color:#cfc8ff;background:#f7f5ff;color:#4f3fe2}
.ai-model-trigger:focus-visible{outline:0;border-color:#bfb5ff;box-shadow:0 0 0 3px rgba(99,78,251,.1)}
.ai-model-trigger>iconify-icon:first-child{color:#725dff}
.ai-model-trigger-label{min-width:0;flex:1;text-align:left;color:#313b4e;font-size:10.5px;font-weight:900;white-space:nowrap}
.ai-model-chevron{color:#98a3b5;transition:transform .16s}.ai-model-chevron.is-open{transform:rotate(180deg)}
.ai-model-menu{position:absolute;z-index:60;top:calc(100% + 8px);right:0;width:210px;padding:6px;border:1px solid #e1e5ee;border-radius:13px;background:#fff;box-shadow:0 16px 42px rgba(28,35,58,.16)}
.ai-model-option{width:100%;padding:9px 10px;display:grid;grid-template-columns:28px minmax(0,1fr) 18px;align-items:center;gap:8px;border:0;border-radius:9px;background:transparent;color:#4c586c;text-align:left;font:inherit;cursor:pointer;transition:.14s}
.ai-model-option:hover,.ai-model-option.is-active{background:#f2efff;color:#4f3fe2}
.ai-model-option-icon{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:9px;background:#efedff;color:#6852f6}
.ai-model-option-copy{min-width:0}.ai-model-option-copy strong{display:block;color:#273246;font-size:10.5px;font-weight:900}.ai-model-option-copy small{display:block;margin-top:2px;color:#97a2b3;font-size:8.5px;font-weight:700}
.ai-model-check{color:#624cf4}
.ai-new-chat{height:36px;padding:0 12px;display:inline-flex;align-items:center;gap:7px;border:1px solid #e0e6ef;border-radius:10px;background:#fff;color:#647086;font:inherit;font-size:11px;font-weight:800;cursor:pointer;transition:.15s}
.ai-new-chat:hover{border-color:#cec7ff;background:#faf9ff;color:var(--focus-brand,#634efb)}
.ai-messages{min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:24px 24px 18px;scroll-behavior:smooth}
.ai-messages::-webkit-scrollbar{width:6px}
.ai-messages::-webkit-scrollbar-thumb{border-radius:999px;background:#dfe5ee}
.ai-welcome{min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:20px}
.ai-welcome-mark{width:64px;height:64px;display:flex;align-items:center;justify-content:center;border-radius:21px;background:linear-gradient(145deg,#f0edff,#f8fbff);color:var(--focus-brand,#634efb);box-shadow:inset 0 0 0 1px #e8e3ff,0 16px 35px rgba(99,78,251,.09)}
.ai-welcome h2{margin:17px 0 7px;color:#172033;font-size:23px;font-weight:900;letter-spacing:-.025em}
.ai-welcome>p{max-width:510px;margin:0;color:#7d899d;font-size:12.5px;font-weight:650;line-height:1.6}
.ai-suggestions{width:min(560px,100%);margin-top:24px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.ai-suggestion{min-height:58px;padding:10px 12px;display:flex;align-items:center;gap:10px;border:1px solid #e9edf4;border-radius:13px;background:#fff;color:#3b465a;font:inherit;text-align:left;cursor:pointer;transition:border-color .15s,background .15s,transform .15s,box-shadow .15s}
.ai-suggestion:hover{border-color:#d6d0ff;background:#fbfaff;transform:translateY(-1px);box-shadow:0 7px 18px rgba(65,52,150,.06)}
.ai-suggestion-icon{width:34px;height:34px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;border-radius:10px;background:var(--suggestion-bg,#f0edff);color:var(--suggestion-color,#634efb)}
.ai-suggestion span:last-child{font-size:11.5px;font-weight:800;line-height:1.35}
.ai-thread{display:flex;flex-direction:column;gap:17px}
.ai-message{display:flex;align-items:flex-start;gap:9px}
.ai-message.is-user{justify-content:flex-end}
.ai-message-avatar{width:30px;height:30px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;border-radius:10px;background:#f0edff;color:var(--focus-brand,#634efb)}
.ai-bubble{max-width:min(78%,680px);padding:11px 13px;border:1px solid #e9edf4;border-radius:5px 14px 14px 14px;background:#f8f9fc;color:#354055;font-size:12.5px;font-weight:600;line-height:1.6;overflow-wrap:anywhere}
.ai-message.is-user .ai-bubble{border-color:var(--focus-brand,#634efb);border-radius:14px 5px 14px 14px;background:var(--focus-brand,#634efb);color:#fff;box-shadow:0 7px 18px rgba(99,78,251,.16)}
.ai-bubble strong{font-weight:900;color:inherit}
.ai-bubble code{padding:2px 5px;border-radius:5px;background:rgba(99,78,251,.1);color:#5040d8;font-size:11px}
.ai-bubble a{color:#5546df;font-weight:800;text-decoration:underline;text-decoration-color:#c8c1ff;text-underline-offset:2px}
.ai-bubble a:hover{color:#3f31bd;text-decoration-color:currentColor}
.ai-message.is-user .ai-bubble code{background:rgba(255,255,255,.16);color:#fff}
.ai-message-time{margin-top:5px;color:#a0aabc;font-size:9px;font-weight:700}
.ai-message.is-user .ai-message-time{text-align:right;color:rgba(255,255,255,.72)}
.ai-response-actions{margin:8px 0 0 39px;display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.ai-response-action{min-height:34px;padding:0 11px;display:inline-flex;align-items:center;gap:6px;border:1px solid #dcd6ff;border-radius:9px;background:#f7f5ff;color:var(--focus-brand,#634efb);font:inherit;font-size:10.5px;font-weight:850;cursor:pointer}
.ai-response-action:hover{background:#eeebff}
.ai-response-action:disabled{opacity:.55;cursor:wait}
.ai-plan{margin:8px 0 0 39px;max-width:560px;padding:12px;border:1px solid #e4e0ff;border-radius:12px;background:#faf9ff}
.ai-plan strong{display:block;color:#322766;font-size:11.5px;font-weight:900}
.ai-plan p{margin:4px 0 0;color:#786e9c;font-size:10.5px;font-weight:650;line-height:1.45}
.ai-typing{display:flex;align-items:center;gap:4px;padding:4px 1px}
.ai-typing i{width:6px;height:6px;border-radius:50%;background:#8b7cff;animation:aiTyping 1s infinite ease-in-out}
.ai-typing i:nth-child(2){animation-delay:.14s}.ai-typing i:nth-child(3){animation-delay:.28s}
.ai-live-search-status{display:inline-flex;align-items:center;gap:7px;color:#6355d9;font-size:10.5px;font-weight:850}
.ai-live-search-status iconify-icon{color:#6c56ff}
@keyframes aiTyping{0%,60%,100%{transform:translateY(0);opacity:.45}30%{transform:translateY(-4px);opacity:1}}
.ai-composer-wrap{padding:10px 18px 12px;border-top:1px solid #edf0f5;background:#fff}
.ai-composer{min-height:54px;display:grid;grid-template-columns:minmax(0,1fr) 42px;align-items:center;gap:10px;padding:5px 6px 5px 17px;border:1px solid #dce3ed;border-radius:18px;background:#fff;box-shadow:0 6px 22px rgba(26,38,64,.045);transition:border-color .15s,box-shadow .15s,background .15s}
.ai-composer:focus-within{border-color:var(--focus-brand,#634efb);background:#fff;box-shadow:0 0 0 3px var(--focus-brand-ring,rgba(99,78,251,.11)),0 8px 24px rgba(36,44,78,.06)}
.ai-composer textarea{display:block;width:100%;min-height:22px;max-height:120px;margin:0;padding:0;resize:none;border:0;outline:0;overflow-y:auto;background:transparent;color:#172033;font:inherit;font-size:12.5px;font-weight:650;line-height:22px}
.ai-composer textarea::placeholder{color:#a2adbf}
.ai-send{width:42px;height:42px;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:13px;background:var(--focus-brand,#634efb);color:#fff;cursor:pointer;box-shadow:0 6px 15px rgba(99,78,251,.2);transition:transform .15s,background .15s}
.ai-send:hover{background:var(--focus-brand-hover,#5742e8);transform:translateY(-1px)}
.ai-send:disabled{opacity:.48;cursor:not-allowed;transform:none;box-shadow:none}
.ai-composer-note{margin:5px 3px 0;text-align:center;color:#a3adbd;font-size:8.5px;font-weight:650;line-height:1.2}
.ai-connections{min-width:0;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto;overflow:hidden;background:linear-gradient(180deg,#fbfaff 0%,#f8fbff 56%,#fff 100%)}
.ai-connections-head{padding:18px 22px 6px;display:flex;align-items:center;justify-content:space-between;gap:14px}
.ai-connections-title h2{margin:0;color:#172033;font-size:14px;font-weight:900}
.ai-connections-title p{margin:3px 0 0;color:#8b97aa;font-size:10px;font-weight:700}
.ai-live-badge{min-height:27px;padding:0 9px;display:inline-flex;align-items:center;gap:6px;border:1px solid #d6f4e1;border-radius:999px;background:#f2fcf6;color:#159957;font-size:9px;font-weight:850;white-space:nowrap}
.ai-live-badge i{width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.1)}
.ai-visual{min-height:0;padding:4px 18px 8px;display:flex;align-items:center;justify-content:center}
.ai-visual-card{position:relative;width:100%;max-width:670px;overflow:hidden;border:1px solid rgba(218,216,248,.78);border-radius:20px;background:rgba(255,255,255,.72);box-shadow:0 20px 45px rgba(57,45,133,.07)}
.ai-visual-card::after{content:'';position:absolute;inset:auto 15% -32% 15%;height:42%;border-radius:50%;background:rgba(99,78,251,.11);filter:blur(42px);pointer-events:none}
.ai-visual-card img{position:relative;z-index:1;width:100%;height:auto;max-height:500px;display:block;object-fit:contain;mix-blend-mode:multiply}
.ai-integrations{padding:13px 18px 18px;border-top:1px solid rgba(228,231,241,.9);background:rgba(255,255,255,.84);backdrop-filter:blur(12px)}
.ai-integrations-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}
.ai-integrations-head h3{margin:0;color:#394459;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.55px}
.ai-integration-count{min-width:22px;height:20px;padding:0 6px;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;background:#eeebff;color:var(--focus-brand,#634efb);font-size:9px;font-weight:900}
.ai-integration-row{display:flex;align-items:center;gap:7px;overflow-x:auto;padding:1px 1px 8px}
.ai-integration-row::-webkit-scrollbar{height:4px}.ai-integration-row::-webkit-scrollbar-thumb{border-radius:999px;background:#e0e4ec}
.ai-integration-chip{height:35px;padding:0 10px 0 7px;display:inline-flex;align-items:center;gap:7px;flex:0 0 auto;border:1px solid #e7eaf1;border-radius:10px;background:#fff;color:#4b576c;font-size:10px;font-weight:850;white-space:nowrap}
.ai-integration-chip-icon{width:23px;height:23px;display:inline-flex;align-items:center;justify-content:center;border-radius:7px;background:var(--chip-bg,#f0edff);color:var(--chip-color,#634efb)}
.ai-add-integration{width:100%;height:40px;margin-top:2px;display:flex;align-items:center;justify-content:center;gap:7px;border:1px dashed #cfc8ff;border-radius:11px;background:#faf9ff;color:var(--focus-brand,#634efb);font-size:11px;font-weight:900;text-decoration:none;transition:.15s}
.ai-add-integration:hover{border-style:solid;background:#f0edff;color:#5040df}
.dark .ai-home-shell,.dark .ai-chat,.dark .ai-composer-wrap{background:#060818;border-color:#253b5c}
.dark .ai-conversation-sidebar{background:#090e1b;border-color:#253b5c}.dark .ai-history-head{border-color:#253b5c}.dark .ai-history-title,.dark .ai-history-label{color:#dbe5f2}.dark .ai-history-item:hover,.dark .ai-history-item.is-active{background:#171b35}
.dark .ai-chat-head,.dark .ai-composer-wrap{border-color:#253b5c}
.dark .ai-chat-title h1,.dark .ai-welcome h2,.dark .ai-connections-title h2{color:#e4eaf4}
.dark .ai-new-chat,.dark .ai-suggestion,.dark .ai-composer,.dark .ai-integration-chip,.dark .ai-model-trigger,.dark .ai-history-new,.dark .ai-history-toggle{background:#0e1726;border-color:#253b5c;color:#aab8ce}
.dark .ai-model-menu{background:#0c1422;border-color:#253b5c}.dark .ai-model-option:hover,.dark .ai-model-option.is-active{background:#171b35}.dark .ai-model-option-copy strong,.dark .ai-model-trigger-label{color:#dce5f2}
.dark .ai-bubble{background:#111f35;border-color:#253b5c;color:#dce5f2}
.dark .ai-connections{background:linear-gradient(180deg,#0b1020,#080d19)}
.dark .ai-visual-card,.dark .ai-integrations{background:rgba(14,23,38,.82);border-color:#253b5c}
.dark .ai-visual-card img{mix-blend-mode:normal;opacity:.9}
@media(max-width:1320px) and (min-width:761px){.ai-home-shell{grid-template-columns:215px minmax(0,1fr)}.ai-connections{display:none}.ai-chat-head{padding:0 16px}.ai-messages{padding:20px 16px 16px}}
@media(max-width:760px){.ai-home{height:calc(100dvh - 80px)}.ai-home-shell{grid-template-columns:1fr;grid-template-rows:minmax(0,1fr) 210px;border-radius:10px}.ai-conversation-sidebar{position:absolute;z-index:32;inset:0 auto 0 0;width:min(86vw,310px);transform:translateX(-105%);box-shadow:18px 0 45px rgba(15,23,42,.16);transition:transform .2s}.ai-conversation-sidebar.is-open{transform:translateX(0)}.ai-history-backdrop{position:absolute;z-index:31;inset:0;display:block;background:rgba(15,23,42,.24);backdrop-filter:blur(2px)}.ai-chat{min-height:0;height:auto;border-right:0;border-bottom:1px solid #e8edf4}.ai-chat-head{padding:0 10px}.ai-chat-title p,.ai-new-chat span,.ai-model-trigger>iconify-icon:first-child{display:none}.ai-chat-identity{gap:7px}.ai-agent-avatar{width:35px;height:35px;border-radius:11px}.ai-chat-tools{gap:5px}.ai-history-toggle{display:flex}.ai-model-trigger{min-width:96px}.ai-model-menu{right:0;width:200px}.ai-messages{padding:16px 12px}.ai-suggestions{grid-template-columns:1fr}.ai-suggestion{min-height:50px}.ai-bubble{max-width:88%}.ai-composer-wrap{padding:8px 10px 10px}.ai-connections{min-height:0;display:grid;grid-template-columns:minmax(120px,.8fr) minmax(0,1.2fr);grid-template-rows:50px minmax(0,1fr)}.ai-connections-head{grid-column:1/-1;padding:8px 12px 4px}.ai-connections-title p{display:none}.ai-live-badge{min-height:24px}.ai-visual{grid-column:1;grid-row:2;padding:5px 3px 8px 8px;min-width:0}.ai-visual-card{height:100%;border-radius:13px}.ai-visual-card img{width:100%;height:100%;object-fit:cover}.ai-integrations{grid-column:2;grid-row:2;min-width:0;padding:6px 8px 8px;border-top:0;background:transparent}.ai-integrations-head{margin-bottom:5px}.ai-integration-row{padding-bottom:5px}.ai-integration-chip{height:30px}.ai-add-integration{height:34px;margin-top:0}.ai-response-actions,.ai-plan{margin-left:39px}}
</style>

<script>
document.body.classList.add('focus-workspace-mode', 'ai-home-focus-mode');
window.addEventListener('pagehide', () => {
    document.body.classList.remove('focus-workspace-mode', 'ai-home-focus-mode');
}, { once:true });
</script>

<main class="ai-home" x-data="homeAgentApp()">
    <div class="ai-home-shell">
        <aside class="ai-conversation-sidebar" :class="{ 'is-open': historyOpen }" aria-label="Historique des conversations">
            <header class="ai-history-head">
                <div class="ai-history-title">
                    <span><iconify-icon icon="solar:chat-round-dots-bold-duotone" width="17"></iconify-icon></span>
                    <span>Conversations</span>
                </div>
                <button type="button" class="ai-history-new" @click="newConversation()" :disabled="sending" aria-label="Nouvelle conversation">
                    <iconify-icon icon="solar:add-circle-linear" width="18"></iconify-icon>
                </button>
            </header>
            <div class="ai-history-list">
                <div class="ai-history-empty" x-show="conversations.length === 0" x-cloak>
                    <iconify-icon icon="solar:chat-round-line-linear" width="28"></iconify-icon>
                    Vos conversations apparaîtront ici après votre premier message.
                </div>
                <template x-for="conversation in conversations" :key="conversation.id">
                    <div class="ai-history-item" :class="{ 'is-active': conversation.id === conversationId }">
                        <button type="button" class="ai-history-open" @click="selectConversation(conversation.id)">
                            <span class="ai-history-label" x-text="conversation.title"></span>
                            <span class="ai-history-meta">
                                <span x-text="modelLabel(conversation.model)"></span>
                                <i></i>
                                <span x-text="conversationTime(conversation.updatedAt)"></span>
                            </span>
                        </button>
                        <button type="button" class="ai-history-remove" @click.stop="removeConversation(conversation.id)" aria-label="Supprimer la conversation">
                            <iconify-icon icon="solar:trash-bin-trash-linear" width="14"></iconify-icon>
                        </button>
                    </div>
                </template>
            </div>
        </aside>
        <div class="ai-history-backdrop" x-show="historyOpen" x-cloak @click="historyOpen = false"></div>

        <section class="ai-chat" aria-label="Agent IA DexApp">
            <header class="ai-chat-head">
                <div class="ai-chat-identity">
                    <span class="ai-agent-avatar"><iconify-icon icon="solar:magic-stick-3-bold-duotone" width="21"></iconify-icon></span>
                    <span class="ai-chat-title">
                        <h1>Agent IA DexApp</h1>
                        <p>Votre espace, vos données et vos outils réunis</p>
                    </span>
                </div>
                <div class="ai-chat-tools">
                    <button type="button" class="ai-history-toggle" @click="historyOpen = true" aria-label="Afficher les conversations">
                        <iconify-icon icon="solar:hamburger-menu-linear" width="17"></iconify-icon>
                    </button>
                    <div class="ai-model-picker" @click.outside="modelMenuOpen = false">
                        <button type="button" class="ai-model-trigger" :class="{ 'is-open': modelMenuOpen }" @click="modelMenuOpen = !modelMenuOpen" :aria-expanded="modelMenuOpen" aria-haspopup="listbox" title="Choisir le modèle IA">
                            <iconify-icon icon="solar:cpu-bolt-bold-duotone" width="16"></iconify-icon>
                            <span class="ai-model-trigger-label" x-text="modelLabel(selectedModel)"></span>
                            <iconify-icon class="ai-model-chevron" :class="{ 'is-open': modelMenuOpen }" icon="solar:alt-arrow-down-linear" width="13"></iconify-icon>
                        </button>
                        <div class="ai-model-menu" x-show="modelMenuOpen" x-cloak x-transition.origin.top.right role="listbox" aria-label="Modèle IA">
                            <template x-for="model in modelOptions" :key="model.id">
                                <button type="button" class="ai-model-option" :class="{ 'is-active': selectedModel === model.id }" @click="selectModel(model.id)" role="option" :aria-selected="selectedModel === model.id">
                                    <span class="ai-model-option-icon"><iconify-icon icon="solar:stars-minimalistic-bold-duotone" width="15"></iconify-icon></span>
                                    <span class="ai-model-option-copy">
                                        <strong x-text="model.label"></strong>
                                        <small x-text="model.description"></small>
                                    </span>
                                    <iconify-icon class="ai-model-check" x-show="selectedModel === model.id" icon="solar:check-circle-bold" width="16"></iconify-icon>
                                </button>
                            </template>
                        </div>
                    </div>
                    <button type="button" class="ai-new-chat" @click="newConversation()" :disabled="sending">
                        <iconify-icon icon="solar:chat-round-plus-linear" width="16"></iconify-icon>
                        <span>Nouvelle conversation</span>
                    </button>
                </div>
            </header>

            <div class="ai-messages" x-ref="messageScroll">
                <div class="ai-welcome" x-show="messages.length === 0" x-cloak>
                    <div class="ai-welcome-mark"><iconify-icon icon="solar:stars-minimalistic-bold-duotone" width="31"></iconify-icon></div>
                    <h2>Que puis-je faire pour vous&nbsp;?</h2>
                    <p>Demandez-moi d’organiser votre travail, de retrouver une information ou d’agir dans votre espace DexApp.</p>
                    <div class="ai-suggestions">
                        <button type="button" class="ai-suggestion" @click="useSuggestion('Quelles sont mes priorités pour aujourd’hui ?')">
                            <span class="ai-suggestion-icon"><iconify-icon icon="solar:checklist-minimalistic-bold-duotone" width="18"></iconify-icon></span>
                            <span>Mes priorités aujourd’hui</span>
                        </button>
                        <button type="button" class="ai-suggestion" @click="useSuggestion('Résume-moi les prochains événements de mon agenda.')">
                            <span class="ai-suggestion-icon" style="--suggestion-bg:#eef7ff;--suggestion-color:#2583e9"><iconify-icon icon="solar:calendar-mark-bold-duotone" width="18"></iconify-icon></span>
                            <span>Résumer mon agenda</span>
                        </button>
                        <button type="button" class="ai-suggestion" @click="useSuggestion('Quels emails récents nécessitent mon attention ?')">
                            <span class="ai-suggestion-icon" style="--suggestion-bg:#ecfbf6;--suggestion-color:#13a878"><iconify-icon icon="solar:letter-bold-duotone" width="18"></iconify-icon></span>
                            <span>Vérifier mes emails importants</span>
                        </button>
                        <button type="button" class="ai-suggestion" @click="useSuggestion('Aide-moi à planifier ma journée efficacement.')">
                            <span class="ai-suggestion-icon" style="--suggestion-bg:#fff6eb;--suggestion-color:#e38a24"><iconify-icon icon="solar:bolt-bold-duotone" width="18"></iconify-icon></span>
                            <span>Planifier ma journée</span>
                        </button>
                    </div>
                </div>

                <div class="ai-thread" x-show="messages.length > 0" x-cloak>
                    <template x-for="(message, index) in messages" :key="message.id">
                        <div>
                            <div class="ai-message" :class="{ 'is-user': message.role === 'user' }">
                                <span class="ai-message-avatar" x-show="message.role !== 'user'">
                                    <iconify-icon icon="solar:stars-minimalistic-bold-duotone" width="16"></iconify-icon>
                                </span>
                                <div class="ai-bubble">
                                    <div x-html="formatMessage(message.content)"></div>
                                    <div class="ai-message-time" x-text="message.time"></div>
                                </div>
                            </div>
                            <div class="ai-response-actions" x-show="message.role === 'assistant' && normalizedActions(message.actions).length">
                                <template x-for="(action, actionIndex) in normalizedActions(message.actions)" :key="actionIndex">
                                    <button type="button" class="ai-response-action" :disabled="executingAction === message.id + '-' + actionIndex" @click="executeAction(message, action, actionIndex)">
                                        <iconify-icon :icon="actionIcon(action)" width="14"></iconify-icon>
                                        <span x-text="action.label || 'Exécuter'"></span>
                                    </button>
                                </template>
                            </div>
                            <div class="ai-plan" x-show="message.role === 'assistant' && message.plan">
                                <strong x-text="message.plan?.title || 'Plan proposé'"></strong>
                                <p x-text="planSummary(message.plan)"></p>
                                <button type="button" class="ai-response-action" style="margin-top:9px" :disabled="executingPlan === message.id" @click="executePlan(message)">
                                    <iconify-icon icon="solar:play-circle-bold-duotone" width="14"></iconify-icon>
                                    Exécuter le plan
                                </button>
                            </div>
                        </div>
                    </template>
                    <div class="ai-message" x-show="sending">
                        <span class="ai-message-avatar"><iconify-icon icon="solar:stars-minimalistic-bold-duotone" width="16"></iconify-icon></span>
                        <div class="ai-bubble">
                            <span class="ai-live-search-status" x-show="liveSearchActive" x-cloak>
                                <iconify-icon icon="line-md:loading-twotone-loop" width="16"></iconify-icon>
                                Recherche web en direct…
                            </span>
                            <span class="ai-typing" x-show="!liveSearchActive"><i></i><i></i><i></i></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ai-composer-wrap">
                <form class="ai-composer" @submit.prevent="sendMessage()">
                    <textarea x-ref="composer" rows="1" x-model="draft" @input="resizeComposer()" @keydown.enter.exact.prevent="sendMessage()" placeholder="Demandez quelque chose à votre agent IA…" :disabled="sending"></textarea>
                    <button type="submit" class="ai-send" :disabled="sending || !draft.trim()" aria-label="Envoyer">
                        <iconify-icon :icon="sending ? 'line-md:loading-twotone-loop' : 'solar:plain-2-bold'" width="19"></iconify-icon>
                    </button>
                </form>
                <div class="ai-composer-note">L’agent peut consulter votre espace et proposer des actions à valider.</div>
            </div>
        </section>

        <aside class="ai-connections" aria-label="Connexions de l’agent IA">
            <header class="ai-connections-head">
                <div class="ai-connections-title">
                    <h2>Votre agent connecté</h2>
                    <p>Un seul assistant pour piloter tous vos outils</p>
                </div>
                <span class="ai-live-badge"><i></i> Agent actif</span>
            </header>

            <div class="ai-visual">
                <figure class="ai-visual-card">
                    <img src="/assets/images/dex-ai-agent-connections.png" alt="Agent IA connecté à l’agenda, aux emails, aux tâches, au CRM, au téléphone et aux documents">
                </figure>
            </div>

            <section class="ai-integrations">
                <div class="ai-integrations-head">
                    <h3>Intégrations actives</h3>
                    <span class="ai-integration-count" x-text="activeIntegrations.length"></span>
                </div>
                <div class="ai-integration-row">
                    <template x-for="integration in activeIntegrations" :key="integration.key">
                        <span class="ai-integration-chip">
                            <span class="ai-integration-chip-icon" :style="`--chip-bg:${integration.background};--chip-color:${integration.color}`">
                                <iconify-icon :icon="integration.icon" width="14"></iconify-icon>
                            </span>
                            <span x-text="integration.name"></span>
                        </span>
                    </template>
                </div>
                <a class="ai-add-integration" href="<%= _homeApi %>/integrations">
                    <iconify-icon icon="solar:add-circle-bold-duotone" width="16"></iconify-icon>
                    Ajouter une intégration
                </a>
            </section>
        </aside>
    </div>
</main>

<script>
document.addEventListener('alpine:init', () => {
    const API = '<%= _homeApi %>';

    Alpine.data('homeAgentApp', () => ({
        draft: '',
        sending: false,
        liveSearchActive: false,
        conversationId: null,
        messages: [],
        conversations: [],
        historyOpen: false,
        modelMenuOpen: false,
        selectedModel: 'gpt-5.5',
        modelOptions: [
            { id:'gpt-5.5', label:'GPT-5.5', description:'Le plus performant' },
            { id:'gpt-4o', label:'GPT-4o', description:'Rapide et polyvalent' },
            { id:'gpt-4o-mini', label:'GPT-4o Mini', description:'Léger et rapide' }
        ],
        workspaceContext: null,
        executingAction: '',
        executingPlan: '',
        coreIntegrations: [
            { key:'agenda', name:'Agenda', icon:'solar:calendar-mark-bold-duotone', color:'#634efb', background:'#efedff' },
            { key:'tasks', name:'Tâches', icon:'solar:checklist-minimalistic-bold-duotone', color:'#16a77a', background:'#eafaf4' },
            { key:'crm', name:'CRM', icon:'solar:users-group-rounded-bold-duotone', color:'#2583e9', background:'#edf7ff' },
            { key:'documents', name:'Documents', icon:'solar:documents-bold-duotone', color:'#8b5cf6', background:'#f3efff' }
        ],
        connectedIntegrations: [],

        async init() {
            this.restoreConversation();
            await Promise.allSettled([this.loadContext(), this.loadIntegrations()]);
            this.$nextTick(() => this.$refs.composer?.focus());
        },

        conversationStorageKey() {
            return `dexapp-home-agent:${API}:conversations:v2`;
        },

        legacyConversationStorageKey() {
            return `dexapp-home-agent:${API}`;
        },

        activeConversationStorageKey() {
            return `${this.conversationStorageKey()}:active`;
        },

        modelStorageKey() {
            return `${this.conversationStorageKey()}:model`;
        },

        allowedModel(value) {
            const model = String(value || '');
            return this.modelOptions.some(option => option.id === model) ? model : 'gpt-5.5';
        },

        normalizeStoredMessages(messages) {
            return (Array.isArray(messages) ? messages : [])
                .filter(message => ['user', 'assistant'].includes(message?.role) && message?.content)
                .slice(-40)
                .map(message => ({
                    id:message.id || `message-${Date.now()}-${Math.random().toString(16).slice(2)}`,
                    role:message.role,
                    content:String(message.content || '').slice(0, 12000),
                    time:message.time || '',
                    actions:message.actions || null,
                    plan:message.plan || null
                }));
        },

        restoreConversation() {
            try {
                this.selectedModel = this.allowedModel(localStorage.getItem(this.modelStorageKey()));
                const stored = JSON.parse(localStorage.getItem(this.conversationStorageKey()) || '[]');
                this.conversations = (Array.isArray(stored) ? stored : [])
                    .map(conversation => ({
                        id:String(conversation?.id || ''),
                        title:String(conversation?.title || 'Nouvelle conversation').slice(0, 90),
                        model:this.allowedModel(conversation?.model),
                        messages:this.normalizeStoredMessages(conversation?.messages),
                        createdAt:conversation?.createdAt || new Date().toISOString(),
                        updatedAt:conversation?.updatedAt || conversation?.createdAt || new Date().toISOString()
                    }))
                    .filter(conversation => conversation.id && conversation.messages.length)
                    .sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt))
                    .slice(0, 50);

                if (!this.conversations.length) this.migrateLegacyConversation();

                const activeId = localStorage.getItem(this.activeConversationStorageKey());
                const active = this.conversations.find(conversation => conversation.id === activeId)
                    || this.conversations[0];
                if (active) this.activateConversation(active);
            } catch (error) {
                console.warn('[HomeAgent] Conversation restore failed:', error);
            }
        },

        migrateLegacyConversation() {
            try {
                const legacy = JSON.parse(sessionStorage.getItem(this.legacyConversationStorageKey()) || '{}');
                const messages = this.normalizeStoredMessages(legacy.messages);
                if (!messages.length) return;
                const now = new Date().toISOString();
                const conversation = {
                    id:String(legacy.conversationId || `conv_${Date.now()}`),
                    title:this.conversationTitle(messages),
                    model:this.selectedModel,
                    messages,
                    createdAt:now,
                    updatedAt:now
                };
                this.conversations = [conversation];
                this.persistConversations();
                sessionStorage.removeItem(this.legacyConversationStorageKey());
            } catch (error) {
                console.warn('[HomeAgent] Legacy conversation migration failed:', error);
            }
        },

        activateConversation(conversation) {
            this.conversationId = conversation.id;
            this.messages = this.normalizeStoredMessages(conversation.messages);
            this.selectedModel = this.allowedModel(conversation.model);
            localStorage.setItem(this.activeConversationStorageKey(), conversation.id);
            localStorage.setItem(this.modelStorageKey(), this.selectedModel);
            this.$nextTick(() => this.scrollToBottom());
        },

        persistConversations() {
            localStorage.setItem(this.conversationStorageKey(), JSON.stringify(this.conversations.slice(0, 50)));
            localStorage.setItem(this.modelStorageKey(), this.selectedModel);
            if (this.conversationId) localStorage.setItem(this.activeConversationStorageKey(), this.conversationId);
        },

        saveConversation() {
            try {
                if (!this.messages.length) return;
                if (!this.conversationId) this.conversationId = `conv_${Date.now()}_${Math.random().toString(16).slice(2, 8)}`;
                const existing = this.conversations.find(conversation => conversation.id === this.conversationId);
                const now = new Date().toISOString();
                const conversation = {
                    id:this.conversationId,
                    title:this.conversationTitle(this.messages),
                    model:this.selectedModel,
                    messages:this.normalizeStoredMessages(this.messages),
                    createdAt:existing?.createdAt || now,
                    updatedAt:now
                };
                this.conversations = [conversation, ...this.conversations.filter(item => item.id !== conversation.id)]
                    .slice(0, 50);
                this.persistConversations();
            } catch (error) {
                console.warn('[HomeAgent] Conversation save failed:', error);
            }
        },

        conversationTitle(messages = this.messages) {
            const firstUserMessage = messages.find(message => message?.role === 'user')?.content || 'Nouvelle conversation';
            const title = String(firstUserMessage).replace(/\s+/g, ' ').trim();
            return title.length > 48 ? `${title.slice(0, 48).trim()}…` : title;
        },

        selectConversation(id) {
            if (this.sending) return;
            const conversation = this.conversations.find(item => item.id === id);
            if (!conversation) return;
            if (this.conversationId && this.messages.length) this.saveConversation();
            this.activateConversation(conversation);
            this.draft = '';
            this.historyOpen = false;
            this.$nextTick(() => {
                this.resizeComposer();
                this.$refs.composer?.focus();
            });
        },

        removeConversation(id) {
            if (this.sending) return;
            this.conversations = this.conversations.filter(conversation => conversation.id !== id);
            if (this.conversationId === id) {
                this.conversationId = null;
                this.messages = [];
                const nextConversation = this.conversations[0];
                if (nextConversation) this.activateConversation(nextConversation);
                else localStorage.removeItem(this.activeConversationStorageKey());
            }
            this.persistConversations();
        },

        changeModel() {
            this.selectedModel = this.allowedModel(this.selectedModel);
            localStorage.setItem(this.modelStorageKey(), this.selectedModel);
            if (this.conversationId && this.messages.length) this.saveConversation();
        },

        selectModel(model) {
            this.selectedModel = this.allowedModel(model);
            this.modelMenuOpen = false;
            this.changeModel();
        },

        modelLabel(model) {
            return this.modelOptions.find(option => option.id === model)?.label || 'GPT-5.5';
        },

        conversationTime(value) {
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return '';
            const today = new Date();
            return date.toDateString() === today.toDateString()
                ? date.toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' })
                : date.toLocaleDateString('fr-FR', { day:'2-digit', month:'short' });
        },

        get activeIntegrations() {
            const seen = new Set();
            return [...this.coreIntegrations, ...this.connectedIntegrations].filter(item => {
                const key = String(item.key || item.name || '').toLowerCase();
                if (!key || seen.has(key)) return false;
                seen.add(key);
                return true;
            });
        },

        async loadContext() {
            try {
                const res = await fetch(API + '/api/ai-assistant/context', { credentials:'include' });
                if (res.ok) this.workspaceContext = await res.json();
            } catch (error) {
                console.warn('[HomeAgent] Context unavailable:', error);
            }
        },

        async loadIntegrations() {
            try {
                const res = await fetch(API + '/integrations', {
                    credentials:'include',
                    headers:{ Accept:'application/json' }
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.success) return;
                this.connectedIntegrations = (data.integrations || [])
                    .filter(item => item.isConnected)
                    .map(item => this.normalizeIntegration(item));
            } catch (error) {
                console.warn('[HomeAgent] Integrations unavailable:', error);
            }
        },

        normalizeIntegration(item = {}) {
            const key = String(item.key || item.name || 'integration').toLowerCase();
            const styles = {
                openai:{ icon:'simple-icons:openai', color:'#129b78', background:'#e8faf4' },
                google:{ icon:'solar:letter-bold-duotone', color:'#4285f4', background:'#edf5ff' },
                gmail:{ icon:'solar:letter-bold-duotone', color:'#e0524d', background:'#fff0ef' },
                slack:{ icon:'solar:chat-round-dots-bold-duotone', color:'#7c3aed', background:'#f3edff' },
                notion:{ icon:'solar:notes-bold-duotone', color:'#172033', background:'#eef1f5' },
                whatsapp:{ icon:'solar:phone-calling-bold-duotone', color:'#16a765', background:'#eafaf2' }
            };
            const styleKey = Object.keys(styles).find(name => key.includes(name));
            const style = styles[styleKey] || { icon:'solar:plug-circle-bold-duotone', color:'#634efb', background:'#efedff' };
            return { key, name:item.name || item.label || key, ...style };
        },

        newConversation() {
            if (this.sending) return;
            if (this.conversationId && this.messages.length) this.saveConversation();
            this.messages = [];
            this.conversationId = null;
            this.draft = '';
            this.historyOpen = false;
            localStorage.removeItem(this.activeConversationStorageKey());
            this.$nextTick(() => {
                this.resizeComposer();
                this.$refs.composer?.focus();
            });
        },

        useSuggestion(text) {
            if (this.sending) return;
            this.draft = text;
            this.sendMessage();
        },

        async sendMessage() {
            const content = String(this.draft || '').trim();
            if (!content || this.sending) return;
            const history = this.messages.slice(-24).map(message => ({ role:message.role, content:message.content }));
            this.messages.push(this.makeMessage('user', content));
            this.draft = '';
            this.sending = true;
            this.liveSearchActive = this.isLiveSearchQuery(content);
            this.saveConversation();
            this.resizeComposer();
            this.scrollToBottom();

            try {
                await this.loadContext();
                const res = await fetch(API + '/api/ai-assistant/chat', {
                    method:'POST',
                    headers:{ 'Content-Type':'application/json' },
                    credentials:'include',
                    body:JSON.stringify({
                        message:content,
                        conversationId:this.conversationId,
                        model:this.selectedModel,
                        history,
                        context:{ page:'home-agent', workspace:this.workspaceContext }
                    })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.error || 'L’agent ne peut pas répondre pour le moment.');
                this.conversationId = data.conversationId || this.conversationId;
                this.selectedModel = this.allowedModel(data.model || this.selectedModel);
                this.messages.push({
                    ...this.makeMessage('assistant', data.response || 'Je suis prêt à vous aider.'),
                    actions:data.actions || null,
                    plan:data.plan || null
                });
                this.saveConversation();
            } catch (error) {
                console.error('[HomeAgent] Chat error:', error);
                this.messages.push(this.makeMessage('assistant', error.message || 'Une erreur est survenue. Réessayez dans un instant.'));
                this.saveConversation();
            } finally {
                this.sending = false;
                this.liveSearchActive = false;
                this.scrollToBottom();
                this.$nextTick(() => this.$refs.composer?.focus());
            }
        },

        isLiveSearchQuery(value) {
            const text = String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
            const explicit = /\b(web|internet|en ligne|online|live|temps reel|actualise|actualisee|actualiser)\b/.test(text);
            const sports = /\b(match|matchs|football|foot|futsal|basket|rugby|tennis|equipe nationale|selection|joue|jouera|affronte|adversaire|score|resultat|classement|coupe du monde|championnat)\b/.test(text);
            const schedule = /\b(quand|quelle date|quel jour|a quelle heure|prochain|prochaine|calendrier|programme|score|resultat|classement)\b/.test(text);
            const realtime = /\b(meteo|temperature|taux de change|cours de bourse|prix du petrole|trafic|circulation)\b/.test(text);
            return explicit || (sports && schedule) || realtime;
        },

        makeMessage(role, content) {
            return {
                id:`message-${Date.now()}-${Math.random().toString(16).slice(2)}`,
                role,
                content:String(content || ''),
                time:new Date().toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' }),
                actions:null,
                plan:null
            };
        },

        normalizedActions(actions) {
            if (Array.isArray(actions)) return actions;
            if (Array.isArray(actions?.actions)) return actions.actions;
            return [];
        },

        actionIcon(action = {}) {
            const icons = {
                navigate:'solar:arrow-right-up-linear',
                create:'solar:add-circle-bold-duotone',
                'agenda-create':'solar:calendar-add-bold-duotone',
                search:'solar:magnifer-linear',
                'email-search':'solar:letter-bold-duotone',
                'email-detail':'solar:letter-opened-bold-duotone',
                'email-create':'solar:pen-new-square-bold-duotone',
                'email-reply':'solar:reply-bold-duotone'
            };
            return icons[action.type] || 'solar:play-circle-bold-duotone';
        },

        async executeAction(message, action, actionIndex) {
            const actionKey = message.id + '-' + actionIndex;
            if (this.executingAction) return;
            if (action?.type === 'navigate' && action?.data?.url) {
                window.location.href = action.data.url;
                return;
            }
            this.executingAction = actionKey;
            try {
                const res = await fetch(API + '/api/ai-assistant/execute', {
                    method:'POST',
                    headers:{ 'Content-Type':'application/json' },
                    credentials:'include',
                    body:JSON.stringify({ action })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.error || data.response || 'Action impossible.');
                const completedMessage = this.makeMessage('assistant', data.response || 'Action terminée.');
                if (data.result?.openUrl) {
                    completedMessage.actions = [{
                        type:'navigate',
                        label:'Ouvrir le brouillon',
                        description:'Relire et envoyer depuis la messagerie',
                        data:{ url:data.result.openUrl, pageName:'Brouillons' }
                    }];
                }
                this.messages.push(completedMessage);
                message.actions = null;
                await this.loadContext();
            } catch (error) {
                this.messages.push(this.makeMessage('assistant', error.message || 'Cette action n’a pas pu être exécutée.'));
            } finally {
                this.executingAction = '';
                this.saveConversation();
                this.scrollToBottom();
            }
        },

        planSummary(plan = {}) {
            const steps = Array.isArray(plan.steps) ? plan.steps : [];
            if (steps.length) return `${steps.length} étape${steps.length > 1 ? 's' : ''} à valider avant exécution.`;
            return plan.description || 'Vérifiez ce plan avant de lancer son exécution.';
        },

        async executePlan(message) {
            if (this.executingPlan || !message.plan) return;
            this.executingPlan = message.id;
            try {
                const res = await fetch(API + '/api/ai-assistant/validate-plan', {
                    method:'POST',
                    headers:{ 'Content-Type':'application/json' },
                    credentials:'include',
                    body:JSON.stringify({ plan:message.plan, conversationId:this.conversationId, model:this.selectedModel, context:{ page:'home-agent', workspace:this.workspaceContext } })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.error || 'Le plan ne peut pas être exécuté.');
                this.messages.push(this.makeMessage('assistant', data.response || 'Plan exécuté.'));
                message.plan = null;
            } catch (error) {
                this.messages.push(this.makeMessage('assistant', error.message || 'Le plan ne peut pas être exécuté.'));
            } finally {
                this.executingPlan = '';
                this.saveConversation();
                this.scrollToBottom();
            }
        },

        formatMessage(value) {
            const escaped = String(value || '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
            return escaped
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/`([^`]+)`/g, '<code>$1</code>')
                .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
                .replace(/\n/g, '<br>');
        },

        resizeComposer() {
            this.$nextTick(() => {
                const element = this.$refs.composer;
                if (!element) return;
                element.style.height = 'auto';
                element.style.height = `${Math.min(element.scrollHeight, 120)}px`;
            });
        },

        scrollToBottom() {
            this.$nextTick(() => {
                const element = this.$refs.messageScroll;
                if (element) element.scrollTop = element.scrollHeight;
            });
        }
    }));
});
</script>
