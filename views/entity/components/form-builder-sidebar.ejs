<!-- Sidebar Panel (221px) -->
<div 
  x-show="builderState.sidebarOpen"
  x-transition:enter="transform transition ease-out duration-200"
  x-transition:enter-start="-translate-x-full opacity-0"
  x-transition:enter-end="translate-x-0 opacity-100"
  x-transition:leave="transform transition ease-in duration-150"
  x-transition:leave-start="translate-x-0 opacity-100"
  x-transition:leave-end="-translate-x-full opacity-0"
  class="w-[221px] bg-white dark:bg-gray-800 border-r dark:border-gray-800 flex flex-col shrink-0 overflow-hidden" style="width: 221px;">
  
  <!-- ====================================== -->
  <!-- FIELD SETTINGS MODE (field selected)   -->
  <!-- ====================================== -->
  <template x-if="builderState.drawerMode === 'field-settings' && builderState.selectedFieldId">
    <div class="flex flex-col h-full overflow-hidden">
      
      <!-- Header with field name + back button -->
      <div class="h-11 border-b dark:border-gray-800 px-3 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-1.5 min-w-0">
          <button 
            @click="builderState.selectedFieldId = null; builderState.drawerMode = 'fields'"
            class="w-6 h-6 rounded flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors shrink-0"
            title="Retour aux champs">
            <iconify-icon icon="solar:arrow-left-line-duotone" width="16"></iconify-icon>
          </button>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold text-xs truncate" 
                x-text="getFieldMeta(getSelectedField())?.label || getFieldMeta(getSelectedField())?.name || getFieldMeta(getSelectedField())?.key || 'Champ'"></h3>
            <span class="text-[9px] text-gray-400 uppercase tracking-wider" 
                  x-text="getSelectedField()?.type"></span>
          </div>
        </div>
        <button @click="builderState.selectedFieldId = null; builderState.drawerMode = 'fields'" class="w-6 h-6 rounded flex items-center justify-center text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
          <iconify-icon icon="solar:close-circle-bold" width="16"></iconify-icon>
        </button>
      </div>

      <!-- Settings Content -->
      <div class="flex-1 overflow-y-auto p-3 space-y-4" x-data="{ field: getSelectedField() }" x-effect="field = getSelectedField()">
        
        <!-- Label Override -->
        <div>
          <label class="block text-[10px] font-semibold mb-1 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Label personnalisé</label>
          <input 
            type="text" 
            class="form-input w-full text-xs py-1.5 rounded-lg"
            :value="field?.label || ''"
            @input="updateFieldProperty(builderState.selectedFieldId, 'label', $event.target.value)"
            placeholder="Label par défaut">
        </div>

        <div class="border-t dark:border-gray-800"></div>

        <!-- Required Toggle -->
        <label class="flex items-center gap-2 cursor-pointer group p-1.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
          <input type="checkbox" class="form-checkbox rounded" 
                 :checked="field?.required"
                 @change="updateFieldProperty(builderState.selectedFieldId, 'required', $event.target.checked)">
          <div>
            <span class="text-xs font-medium">Champ requis</span>
            <p class="text-[9px] text-gray-400">Ce champ doit être rempli</p>
          </div>
        </label>

        <div class="border-t dark:border-gray-800"></div>

        <!-- Placeholder -->
        <div>
          <label class="block text-[10px] font-semibold mb-1 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Placeholder</label>
          <input 
            type="text" 
            class="form-input w-full text-xs py-1.5 rounded-lg"
            :value="field?.placeholder || ''"
            @input="updateFieldProperty(builderState.selectedFieldId, 'placeholder', $event.target.value)"
            placeholder="Texte d'aide">
        </div>

        <!-- Help Text -->
        <div>
          <label class="block text-[10px] font-semibold mb-1 text-gray-500 dark:text-gray-400 uppercase tracking-wide">Texte d'aide</label>
          <textarea 
            class="form-textarea w-full text-xs py-1.5 rounded-lg" rows="2"
            :value="field?.helpText || ''"
            @input="updateFieldProperty(builderState.selectedFieldId, 'helpText', $event.target.value)"
            placeholder="Description sous le champ"></textarea>
        </div>

      </div>

      <!-- Footer: Remove Field -->
      <div class="border-t dark:border-gray-800 p-2 shrink-0">
        <button @click="removeFieldById(builderState.selectedFieldId); builderState.selectedFieldId = null; builderState.drawerMode = 'fields'" class="btn btn-outline-danger btn-sm w-full rounded-lg text-xs">
          <iconify-icon icon="solar:trash-bin-minimalistic-bold" class="mr-1"></iconify-icon>
          Retirer le champ
        </button>
      </div>
    </div>
  </template>

  <!-- ====================================== -->
  <!-- FIELD LIBRARY MODE (no field selected) -->
  <!-- ====================================== -->
  <template x-if="builderState.drawerMode !== 'field-settings'">
    <div class="flex flex-col h-full overflow-hidden">
      
      <!-- Header with tabs -->
      <div class="border-b dark:border-gray-800 shrink-0">
        <div class="h-10 px-3 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <iconify-icon icon="solar:widget-add-bold-duotone" width="15" class="text-primary"></iconify-icon>
            <h3 class="font-semibold text-xs" x-text="builderState.drawerMode === 'fields' ? 'Champs' : builderState.drawerMode === 'rows' ? 'Lignes' : 'Paramètres'"></h3>
          </div>
          <button @click="builderState.sidebarOpen = false" class="w-6 h-6 rounded flex items-center justify-center text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
            <iconify-icon icon="solar:close-circle-bold" width="16"></iconify-icon>
          </button>
        </div>
        <!-- Tabs -->
        <div class="flex border-t dark:border-gray-800">
          <button @click="builderState.drawerMode = 'fields'"
                  :class="builderState.drawerMode === 'fields' ? 'text-primary border-b-2 border-primary bg-primary/5' : 'text-gray-400 hover:text-gray-600'"
                  class="flex-1 text-[10px] font-semibold tracking-wide py-1.5 transition-colors">
            Champs
          </button>
          <button @click="builderState.drawerMode = 'rows'"
                  :class="builderState.drawerMode === 'rows' ? 'text-primary border-b-2 border-primary bg-primary/5' : 'text-gray-400 hover:text-gray-600'"
                  class="flex-1 text-[10px] font-semibold tracking-wide py-1.5 transition-colors">
            Lignes
          </button>
          <button @click="builderState.drawerMode = 'settings'"
                  :class="builderState.drawerMode === 'settings' ? 'text-primary border-b-2 border-primary bg-primary/5' : 'text-gray-400 hover:text-gray-600'"
                  class="flex-1 text-[10px] font-semibold tracking-wide py-1.5 transition-colors">
            Config
          </button>
        </div>
      </div>

      <!-- Fields Panel -->
      <div x-show="builderState.drawerMode === 'fields'" class="flex-1 overflow-y-auto p-2">
        
        <!-- Standard Fields -->
        <template x-if="getAvailableStandardFields().length > 0">
          <div class="mb-4">
            <p class="text-[10px] text-gray-400 dark:text-gray-500 font-semibold mb-1.5 px-1">Standards</p>
            <div class="flex flex-col gap-1"
                 x-init="Sortable.create($el, { group: { name: 'form-fields', pull: 'clone', put: false }, animation: 150, sort: false, draggable: '.fb-sidebar-field' })">
              <template x-for="stdField in getAvailableStandardFields()" :key="'std-'+stdField.key">
                <div 
                  class="fb-sidebar-field h-[30px] px-2 border border-dashed border-gray-300 dark:border-gray-600 rounded flex items-center gap-2 transition-colors"
                  :class="isFieldOnCanvas('standard', stdField.key) ? 'opacity-40 cursor-not-allowed' : 'cursor-move hover:border-primary hover:bg-primary/5'"
                  data-field-type="standard"
                  :data-field-id="stdField.key"
                  :data-field-label="stdField.label"
                  :data-field-icon="stdField.icon || 'solar:text-bold'">
                  <iconify-icon :icon="stdField.icon || 'solar:text-bold'" width="14" class="text-primary shrink-0"></iconify-icon>
                  <span class="text-[11px] font-medium truncate" x-text="stdField.label"></span>
                  <template x-if="isFieldOnCanvas('standard', stdField.key)">
                    <iconify-icon icon="solar:check-circle-bold" width="12" class="text-success ml-auto shrink-0"></iconify-icon>
                  </template>
                </div>
              </template>
            </div>
          </div>
        </template>

        <!-- Custom Fields -->
        <template x-if="availableCustomFields.length > 0">
          <div class="mb-4">
            <p class="text-[10px] text-gray-400 dark:text-gray-500 font-semibold mb-1.5 px-1">Personnalisés</p>
            <div class="flex flex-col gap-1"
                 x-init="Sortable.create($el, { group: { name: 'form-fields', pull: 'clone', put: false }, animation: 150, sort: false, draggable: '.fb-sidebar-field' })">
              <template x-for="cfItem in availableCustomFields" :key="'cf-'+cfItem._id">
                <div 
                  class="fb-sidebar-field h-[30px] px-2 border border-dashed border-gray-300 dark:border-gray-600 rounded flex items-center gap-2 transition-colors"
                  :class="isFieldOnCanvas('custom', cfItem._id) ? 'opacity-40 cursor-not-allowed' : 'cursor-move hover:border-info hover:bg-info/5'"
                  data-field-type="custom"
                  :data-field-id="cfItem._id"
                  :data-field-label="cfItem.label || cfItem.name"
                  :data-field-icon="cfItem.ui?.icon || 'solar:widget-bold-duotone'">
                  <iconify-icon :icon="cfItem.ui?.icon || 'solar:widget-bold-duotone'" width="14" class="text-info shrink-0"></iconify-icon>
                  <span class="text-[11px] font-medium truncate" x-text="cfItem.label || cfItem.name"></span>
                  <template x-if="isFieldOnCanvas('custom', cfItem._id)">
                    <iconify-icon icon="solar:check-circle-bold" width="12" class="text-success ml-auto shrink-0"></iconify-icon>
                  </template>
                </div>
              </template>
            </div>
          </div>
        </template>

        <!-- Relations -->
        <template x-if="entityRelations.length > 0">
          <div class="mb-4">
            <p class="text-[10px] text-gray-400 dark:text-gray-500 font-semibold mb-1.5 px-1">Relations</p>
            <div class="flex flex-col gap-1"
                 x-init="Sortable.create($el, { group: { name: 'form-fields', pull: 'clone', put: false }, animation: 150, sort: false, draggable: '.fb-sidebar-field' })">
              <template x-for="rel in entityRelations" :key="'rel-'+rel.key">
                <div 
                  class="fb-sidebar-field h-[30px] px-2 border border-dashed border-gray-300 dark:border-gray-600 rounded flex items-center gap-2 transition-colors"
                  :class="isFieldOnCanvas('relation', rel.key) ? 'opacity-40 cursor-not-allowed' : 'cursor-move hover:border-warning hover:bg-warning/5'"
                  data-field-type="relation"
                  :data-field-id="rel.key"
                  :data-field-label="rel.label"
                  :data-field-icon="rel.targetEntity?.icon || 'solar:link-round-bold-duotone'">
                  <iconify-icon :icon="rel.targetEntity?.icon || 'solar:link-round-bold-duotone'" width="14" class="shrink-0" :style="rel.targetEntity?.color ? 'color:' + rel.targetEntity.color : 'color: var(--warning)'"></iconify-icon>
                  <span class="text-[11px] font-medium truncate" x-text="rel.label"></span>
                  <span class="text-[9px] text-gray-400 ml-auto shrink-0" x-text="rel.cardinality === 'one-to-one' ? '1:1' : rel.cardinality === 'one-to-many' ? '1:N' : 'N:N'"></span>
                  <template x-if="isFieldOnCanvas('relation', rel.key)">
                    <iconify-icon icon="solar:check-circle-bold" width="12" class="text-success shrink-0"></iconify-icon>
                  </template>
                </div>
              </template>
            </div>
          </div>
        </template>

        <!-- Classifications -->
        <template x-if="entityClassifications.length > 0">
          <div class="mb-4">
            <p class="text-[10px] text-gray-400 dark:text-gray-500 font-semibold mb-1.5 px-1">Classifications</p>
            <div class="flex flex-col gap-1"
                 x-init="Sortable.create($el, { group: { name: 'form-fields', pull: 'clone', put: false }, animation: 150, sort: false, draggable: '.fb-sidebar-field' })">
              <template x-for="cls in entityClassifications" :key="'cls-'+cls._id">
                <div 
                  class="fb-sidebar-field h-[30px] px-2 border border-dashed border-gray-300 dark:border-gray-600 rounded flex items-center gap-2 transition-colors"
                  :class="isFieldOnCanvas('classification', cls._id) ? 'opacity-40 cursor-not-allowed' : 'cursor-move hover:border-success hover:bg-success/5'"
                  data-field-type="classification"
                  :data-field-id="cls._id"
                  :data-field-label="cls.name"
                  data-field-icon="solar:tag-bold-duotone">
                  <iconify-icon icon="solar:tag-bold-duotone" width="14" class="text-success shrink-0"></iconify-icon>
                  <span class="text-[11px] font-medium truncate" x-text="cls.name"></span>
                  <template x-if="isFieldOnCanvas('classification', cls._id)">
                    <iconify-icon icon="solar:check-circle-bold" width="12" class="text-success ml-auto shrink-0"></iconify-icon>
                  </template>
                </div>
              </template>
            </div>
          </div>
        </template>

        <!-- Auto-layout button -->
        <div class="border-t dark:border-gray-800 pt-3">
          <p class="text-[10px] text-gray-400 dark:text-gray-500 font-semibold mb-1.5 px-1">Auto-layout</p>
          <div class="flex gap-1.5">
            <button @click="autoLayout(1)" class="flex-1 btn btn-outline-primary btn-sm text-[10px] py-1">1 col</button>
            <button @click="autoLayout(2)" class="flex-1 btn btn-outline-primary btn-sm text-[10px] py-1">2 cols</button>
            <button @click="autoLayout(3)" class="flex-1 btn btn-outline-primary btn-sm text-[10px] py-1">3 cols</button>
          </div>
        </div>
      </div>

      <!-- Rows Panel -->
      <div x-show="builderState.drawerMode === 'rows'" class="flex-1 p-3 text-center text-gray-500 overflow-y-auto">
        <p class="text-[10px] text-gray-400 font-semibold mb-3">Ajouter une ligne</p>
        <div class="grid grid-cols-2 gap-1.5">
          <button @click="addRow(1)" class="p-2 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-1.5 hover:border-primary hover:bg-primary/5 transition-colors">
            <div class="flex gap-0.5"><div class="w-10 h-2.5 bg-primary/30 rounded-sm"></div></div>
            <span class="text-[10px] font-medium">1 col</span>
          </button>
          <button @click="addRow(2)" class="p-2 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-1.5 hover:border-primary hover:bg-primary/5 transition-colors">
            <div class="flex gap-0.5"><div class="w-4 h-2.5 bg-primary/30 rounded-sm"></div><div class="w-4 h-2.5 bg-primary/30 rounded-sm"></div></div>
            <span class="text-[10px] font-medium">2 cols</span>
          </button>
          <button @click="addRow(3)" class="p-2 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-1.5 hover:border-primary hover:bg-primary/5 transition-colors">
            <div class="flex gap-0.5"><div class="w-2.5 h-2.5 bg-primary/30 rounded-sm"></div><div class="w-2.5 h-2.5 bg-primary/30 rounded-sm"></div><div class="w-2.5 h-2.5 bg-primary/30 rounded-sm"></div></div>
            <span class="text-[10px] font-medium">3 cols</span>
          </button>
          <button @click="addRow(4)" class="p-2 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-1.5 hover:border-primary hover:bg-primary/5 transition-colors">
            <div class="flex gap-0.5"><div class="w-2 h-2.5 bg-primary/30 rounded-sm"></div><div class="w-2 h-2.5 bg-primary/30 rounded-sm"></div><div class="w-2 h-2.5 bg-primary/30 rounded-sm"></div><div class="w-2 h-2.5 bg-primary/30 rounded-sm"></div></div>
            <span class="text-[10px] font-medium">4 cols</span>
          </button>
        </div>
        <div class="mt-2 grid grid-cols-2 gap-1.5">
          <button @click="addRowCustom([4, 8])" class="p-2 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-1.5 hover:border-primary hover:bg-primary/5 transition-colors">
            <div class="flex gap-0.5"><div class="w-3 h-2.5 bg-primary/30 rounded-sm"></div><div class="w-6 h-2.5 bg-primary/30 rounded-sm"></div></div>
            <span class="text-[10px] font-medium">⅓ + ⅔</span>
          </button>
          <button @click="addRowCustom([8, 4])" class="p-2 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex flex-col items-center gap-1.5 hover:border-primary hover:bg-primary/5 transition-colors">
            <div class="flex gap-0.5"><div class="w-6 h-2.5 bg-primary/30 rounded-sm"></div><div class="w-3 h-2.5 bg-primary/30 rounded-sm"></div></div>
            <span class="text-[10px] font-medium">⅔ + ⅓</span>
          </button>
        </div>
      </div>

      <!-- Settings Panel -->
      <div x-show="builderState.drawerMode === 'settings'" class="flex-1 p-3 overflow-y-auto">
        <div class="space-y-3">
          <div>
            <label class="block text-[10px] font-semibold mb-1 text-gray-500 dark:text-gray-400 tracking-wide">Nom du formulaire</label>
            <input type="text" class="form-input w-full text-xs py-1.5 rounded-lg" x-model="formName">
          </div>
          <!-- Right Sidebar Toggle -->
          <div class="border-t dark:border-gray-700 pt-2">
            <div class="flex items-center justify-between py-1" x-data="{ get isOn() { return (formLayout.settings?.showRightSidebar !== false) } }">
              <div class="flex items-center gap-1.5">
                <iconify-icon icon="solar:sidebar-minimalistic-bold-duotone" width="13" class="text-gray-400"></iconify-icon>
                <span class="text-[11px] text-gray-600 dark:text-gray-300">Panneau latéral</span>
              </div>
              <button type="button" @click="if (!formLayout.settings) formLayout.settings = {}; formLayout.settings.showRightSidebar = !isOn; isDirty = true;"
                      class="relative w-7 h-4 rounded-full transition-colors duration-200 flex-shrink-0"
                      :class="isOn ? 'bg-primary' : 'bg-gray-300 dark:bg-gray-600'">
                <span class="absolute top-0.5 left-0.5 w-3 h-3 bg-white rounded-full shadow transition-transform duration-200"
                      :class="isOn ? 'translate-x-3' : 'translate-x-0'"></span>
              </button>
            </div>
            <p class="text-[9px] text-gray-400 mt-0.5 leading-tight">Panneau droit (actions, classifications) lors de l'encodage</p>
          </div>
        </div>
      </div>

    </div>
  </template>

</div>
