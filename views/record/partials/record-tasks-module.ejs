    .dark .tl-comment { background: #1b2e4b; border-color: #253b5c; }
    .dark .tl-msg-row.mine .tl-comment { background: linear-gradient(135deg, #4361ee, #5a73f0); border-color: transparent; }
    .dark .tl-msg-name { color: #506690; }
