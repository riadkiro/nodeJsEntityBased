        <!-- Entity Variables (from collections) -->
        <template x-if="doc.collections && doc.collections.length > 0">
            <div class="mb-4">
                <div class="h-px bg-gray-200 dark:bg-gray-700 my-3"></div>
                <p class="text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2 flex items-center gap-1">
                    <iconify-icon icon="solar:folder-with-files-bold-duotone" width="14"></iconify-icon>
                    Collections
                </p>
                <template x-for="col in doc.collections.filter(c => c.type === 'single')" :key="col.alias">
                    <div class="mb-3">
                        <p class="text-[9px] font-semibold text-purple-600 dark:text-purple-400 uppercase mb-1.5" x-text="col.alias"></p>
                        <div class="flex flex-wrap gap-2.5">
                            <button 
                                @click="insertVariableToken(col.alias + '.title')"
                                class="px-2 py-0 rounded bg-yellow-100 hover:bg-yellow-200 dark:bg-yellow-900/30 dark:hover:bg-yellow-900/50 text-yellow-800 dark:text-yellow-200 text-xs font-semibold transition-colors cursor-pointer border border-yellow-300 dark:border-yellow-700"
                            >
                                Titre
                            </button>
                            <button 
                                @click="insertVariableToken(col.alias + '.description')"
                                class="px-2 py-0 rounded bg-yellow-100 hover:bg-yellow-200 dark:bg-yellow-900/30 dark:hover:bg-yellow-900/50 text-yellow-800 dark:text-yellow-200 text-xs font-semibold transition-colors cursor-pointer border border-yellow-300 dark:border-yellow-700"
                            >
                                Description
                            </button>
                        </div>
                    </div>
                </template>
            </div>
        </template>
    </div>

    <!-- Relation Selection Modal (Style Icon Picker) -->
    <template x-teleport="body">
        <div x-show="showRelationModal" class="fixed inset-0 z-[999] overflow-y-auto" x-cloak>
            <!-- Backdrop -->
            <div x-show="showRelationModal" 
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0" 
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-200" 
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0" 
                @click="showRelationModal = false"
                class="fixed inset-0 bg-black/60 backdrop-blur-sm">
            </div>

            <!-- Modal Content -->
            <div class="flex items-start justify-center min-h-screen px-4" @click.self="showRelationModal = false">
                <div x-show="showRelationModal" 
                    x-transition:enter="transition ease-out duration-300"
                    x-transition:enter-start="opacity-0 scale-95 translate-y-4"
                    x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                    x-transition:leave="transition ease-in duration-200"
                    x-transition:leave-start="opacity-100 scale-100 translate-y-0"
                    x-transition:leave-end="opacity-0 scale-95 translate-y-4"
                    class="panel border-0 py-1 px-4 rounded-lg overflow-hidden w-full max-w-sm my-8 bg-white dark:bg-[#1b2e4b]"
                    @click.stop>

                    <!-- Header -->
                    <div class="flex items-center justify-between p-5 font-semibold text-lg dark:text-white">
                        <span>Ajouter des relations</span>
                        <button type="button" @click="showRelationModal = false" class="text-white-dark hover:text-dark">
                            <iconify-icon icon="solar:close-circle-bold" width="24"></iconify-icon>
                        </button>
                    </div>

                    <!-- Content -->
                    <div class="p-5">
                        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">Sélectionnez les entités à lier au document :</p>
                        
                        <!-- Entity List with Border Box -->
                        <div class="flex flex-col gap-1.5 mb-2 max-h-60 overflow-y-auto custom-scrollbar p-1 border rounded dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/50">
                            <template x-for="entity in availableEntities" :key="entity.id">
                                <label 
                                    class="flex items-center gap-3 p-1 rounded-lg border cursor-pointer transition-all hover:border-primary/30 hover:bg-white dark:hover:bg-gray-700"
                                    :class="selectedEntities.includes(entity.id) ? 'bg-primary/10 border-primary/30' : 'border-transparent'"
                                >
                                    <input 
                                        type="checkbox" 
                                        :value="entity.id"
                                        x-model="selectedEntities"
                                        class="w-4 h-4 text-primary rounded border-gray-300 focus:ring-primary/50"
                                    >
                                    <div class="flex items-center gap-2.5 flex-1">
                                        <div class="w-7 h-7 rounded-lg bg-white dark:bg-gray-700 flex items-center justify-center shrink-0">
                                            <iconify-icon 
                                                :icon="entity.icon || 'solar:database-broken'" 
                                                class="text-gray-500 dark:text-gray-400" 
                                                width="16"
                                            ></iconify-icon>
                                        </div>
                                        <div class="min-w-0">
                                            <div class="text-sm font-medium text-gray-900 dark:text-white truncate" x-text="entity.name"></div>
                                            <div class="text-xs text-gray-400 dark:text-gray-500" x-text="entity.fieldsCount + ' champs'"></div>
                                        </div>
                                    </div>
                                </label>
                            </template>

                            <!-- Empty State -->
                            <div x-show="availableEntities.length === 0" class="text-center py-8">
                                <iconify-icon icon="tabler:folder-off" class="text-gray-300" width="40"></iconify-icon>
                                <p class="text-xs text-gray-400 mt-2">Aucune entité disponible</p>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="flex items-center justify-between pt-4">
                            <div class="text-xs text-gray-500 dark:text-gray-400">
                                <span x-text="selectedEntities.length"></span> sélectionnée(s)
                            </div>
                            <button @click="saveRelations()"
                                class="btn btn-primary" type="button">
                                Enregistrer
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Footer -->
    <div class="p-3 border-t dark:border-gray-800 bg-gray-50/50 dark:bg-gray-900/50">
        <p class="text-[10px] text-gray-400 text-center">
            Cliquez pour insérer à la position du curseur
        </p>
    </div>
</div>
