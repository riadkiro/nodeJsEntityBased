                        :class="subActive.includes(child.id) ? 'bg-gray-100/40 dark:bg-gray-800' : ''"
                        @mouseenter="hovered = true" @mouseleave="hovered = false"
                        @contextmenu.prevent="openEditMenu($event, child.type, child, item)">
                          <iconify-icon
                            :icon="getIcon(child, child.children && child.children.length > 0, subActive.includes(child.id), hovered)"
                            class="ml-2 cursor-pointer bg-transparent" width="16" height="16"
                          :style="child.color ? 'color: ' + child.color : ''"
                          @click.stop="if(['folder', 'environment'].includes(child.type)) { toggleSub(child.id); }"></iconify-icon>

                        <div class="flex-1 min-w-0">
                          <template x-if="editingId !== child.id">
                            <a :href="child.link || '#'" class="block ml-1 truncate text-gray-700 dark:text-gray-400 transition-colors"
                              :class="isItemActive(child.link) ? '!text-primary font-bold' : ''"
                              @click="if(['folder', 'environment'].includes(child.type)) { $event.preventDefault(); toggleSub(child.id); }">
                              <span x-text="child.name"></span>
                            </a>
                          </template>
                          <template x-if="editingId === child.id">
                            <input x-ref="editInput" type="text"
