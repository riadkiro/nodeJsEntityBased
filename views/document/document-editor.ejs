<div x-data="documentEditor()" class="h-[calc(100vh-80px)] flex flex-col">
  <!-- Header Bar -->
  <div class="bg-white dark:bg-gray-900 border-b dark:border-gray-800 px-4 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/account/<%= account_number %>/documents" class="text-gray-500 hover:text-primary">
        <iconify-icon icon="solar:arrow-left-line-duotone" width="24"></iconify-icon>
      </a>
      <input 
        type="text" 
        x-model="doc.name" 
        @input="saveDocument"
        class="form-input font-semibold text-lg border-0 focus:ring-0 px-2 w-80"
        placeholder="Sans titre"
      >
      <span class="text-xs text-gray-400" x-show="lastSaved">
        Sauvegardé <span x-text="lastSaved"></span>
      </span>
    </div>
    
    <!-- Mode Switcher -->
    <div class="flex items-center gap-1 bg-gray-100 dark:bg-gray-800 rounded-lg p-1">
      <button 
        @click="editorMode = 'edition'"
        :class="editorMode === 'edition' ? 'bg-white dark:bg-gray-700 shadow-sm' : 'text-gray-600 dark:text-gray-400'"
        class="px-4 py-2 rounded-md text-sm font-medium transition-all flex items-center gap-2"
      >
        <iconify-icon icon="solar:pen-bold-duotone" width="18"></iconify-icon>
        Édition
      </button>
      <button 
        @click="editorMode = 'layout'"
        :class="editorMode === 'layout' ? 'bg-white dark:bg-gray-700 shadow-sm' : 'text-gray-600 dark:text-gray-400'"
        class="px-4 py-2 rounded-md text-sm font-medium transition-all flex items-center gap-2"
      >
        <iconify-icon icon="solar:layers-minimalistic-bold-duotone" width="18"></iconify-icon>
        Layout
      </button>
      <button 
        @click="editorMode = 'designer'"
        :class="editorMode === 'designer' ? 'bg-white dark:bg-gray-700 shadow-sm' : 'text-gray-600 dark:text-gray-400'"
        class="px-4 py-2 rounded-md text-sm font-medium transition-all flex items-center gap-2"
      >
        <iconify-icon icon="solar:palette-2-bold-duotone" width="18"></iconify-icon>
        Designer
      </button>
    </div>

    <div class="flex items-center gap-2">
      <select x-model="doc.format" @change="updateDimensions" class="form-select text-sm">
        <option value="A4">A4</option>
        <option value="A5">A5</option>
        <option value="A3">A3</option>
        <option value="Letter">Letter</option>
        <option value="Legal">Legal</option>
      </select>

      <select x-model="doc.orientation" @change="updateDimensions" class="form-select text-sm">
        <option value="portrait">Portrait</option>
        <option value="landscape">Paysage</option>
      </select>

      <select x-model="doc.status" @change="saveDocument" class="form-select text-sm">
        <option value="draft">Brouillon</option>
        <option value="published">Publié</option>
      </select>

      <button @click="printDocument" class="btn btn-outline-primary btn-sm bg-white hover:bg-gray-50 text-primary border border-primary">
        <iconify-icon icon="solar:file-download-bold" class="mr-1"></iconify-icon>
        Télécharger PDF
      </button>

      <button @click="saveDocument" class="btn btn-primary btn-sm">
        <iconify-icon icon="solar:diskette-bold" class="mr-1"></iconify-icon>
        Sauvegarder
      </button>
    </div>
  </div>

  <!-- Main Content -->
  <div class="flex-1 flex overflow-hidden">
    <!-- Toolbar (Left) -->
    <div class="w-16 bg-white dark:bg-gray-900 border-r dark:border-gray-800 flex flex-col items-center py-4 gap-4">
      <button 
        class="w-10 h-10 rounded hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center cursor-move" 
        title="Texte"
        draggable="true"
        @dragstart="startDrag($event, 'text')"
      >
        <iconify-icon icon="solar:text-bold-duotone" width="24"></iconify-icon>
      </button>
      <button class="w-10 h-10 rounded hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center" title="Image">
        <iconify-icon icon="solar:gallery-bold-duotone" width="24"></iconify-icon>
      </button>
      <div class="h-px w-8 bg-gray-200 dark:bg-gray-700"></div>
      <button class="w-10 h-10 rounded hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center" title="Layout 2 colonnes">
        <iconify-icon icon="solar:layers-minimalistic-bold-duotone" width="24"></iconify-icon>
      </button>
      <button class="w-10 h-10 rounded hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center" title="Layout 3 colonnes">
        <iconify-icon icon="solar:widget-4-bold-duotone" width="24"></iconify-icon>
      </button>
      <div class="h-px w-8 bg-gray-200 dark:bg-gray-700"></div>
      <button class="w-10 h-10 rounded hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center" title="Variable DB">
        <iconify-icon icon="solar:database-bold-duotone" width="24"></iconify-icon>
      </button>
    </div>

    <!-- Canvas Area -->
    <div class="flex-1 bg-gray-100 dark:bg-gray-800 overflow-auto p-8" id="canvas-container">
      <div id="pages-container" class="flex flex-col gap-8 items-center" style="padding-top: 43px;">
        <template x-for="(page, index) in doc.pages" :key="'page-' + index">
          <div class="relative group">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-10">
              <span class="bg-primary text-white text-xs px-2 py-1 rounded-full shadow-md">
                Page <span x-text="index + 1"></span>
              </span>
            </div>

            <div 
              class="bg-white shadow-2xl relative overflow-hidden" 
              :style="'width: ' + doc.dimensions.width + 'px; height: ' + doc.dimensions.height + 'px;'" 
              @click="selectPage(index)" 
              :class="{ 'ring-2 ring-primary': selectedPageIndex === index }"
            >
              <!-- EDITION MODE: Editable content area with dynamic margins -->
              <div 
                x-show="editorMode === 'edition'"
                class="w-full h-full outline-none text-gray-800 leading-relaxed page-content overflow-hidden"
                contenteditable="true"
                :data-page-index="index"
                @input="handlePageInput($event, index)"
                @paste="handlePaste($event, index)"
                @focus="selectPage(index)"
                @blur="syncPageContent($event, index)"
                x-init="$el.innerHTML = page.content || ''"
                x-ref="pageContent"
                :style="'font-family: Times New Roman, serif; font-size: 12pt; white-space: pre-wrap; word-wrap: break-word; line-height: 1.15; padding-top: ' + doc.margins.top + 'px; padding-bottom: ' + doc.margins.bottom + 'px; padding-left: ' + doc.margins.left + 'px; padding-right: ' + doc.margins.right + 'px; overflow: hidden;'"
              ></div>
              
              <!-- DESIGN MODE: Layout with rows -->
              <div 
                x-show="editorMode === 'layout' || editorMode === 'designer'"
                class="w-full h-full"
                :style="'padding-top: ' + doc.margins.top + 'px; padding-bottom: ' + doc.margins.bottom + 'px; padding-left: ' + doc.margins.left + 'px; padding-right: ' + doc.margins.right + 'px;'"
              >
                <!-- Add row button (Top) -->
                <button 
                  @click="addRow(index)"
                  class="w-full border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg p-4 hover:border-primary hover:bg-gray-50 dark:hover:bg-gray-800 transition-all flex items-center justify-center gap-2 text-gray-400 hover:text-primary mb-4"
                >
                  <iconify-icon icon="solar:add-circle-bold" width="20"></iconify-icon>
                  <span class="text-sm">Ajouter une section</span>
                </button>
                
                <!-- Render existing rows -->
                <template x-for="(row, rowIndex) in page.rows" :key="'row-' + index + '-' + rowIndex">
                  <div class="relative group mb-4">
                    <!-- Row container with dashed border -->
                    <div 
                      class="border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg p-4 hover:border-primary transition-colors min-h-[100px] relative"
                      @click="selectedRow = { pageIndex: index, rowIndex: rowIndex }"
                    >
                      <!-- Layout selector (top-right) -->
                      <div class="absolute -top-3 right-2 bg-white dark:bg-gray-800 p-1 rounded shadow-sm opacity-0 group-hover:opacity-100 transition-opacity flex gap-0.5">
                        <button 
                          @click.stop="setRowLayout(index, rowIndex, 1)"
                          :class="row.columns === 1 ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400'"
                          class="w-6 h-6 rounded hover:scale-110 transition-transform flex items-center justify-center text-xs"
                          title="1 colonne"
                        >
                          <iconify-icon icon="tabler:rectangle" width="14"></iconify-icon>
                        </button>
                        <button 
                          @click.stop="setRowLayout(index, rowIndex, 2)"
                          :class="row.columns === 2 ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400'"
                          class="w-6 h-6 rounded hover:scale-110 transition-transform flex items-center justify-center text-xs"
                          title="2 colonnes"
                        >
                          <iconify-icon icon="tabler:columns-2" width="14"></iconify-icon>
                        </button>
                        <button 
                          @click.stop="setRowLayout(index, rowIndex, 3)"
                          :class="row.columns === 3 ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400'"
                          class="w-6 h-6 rounded hover:scale-110 transition-transform flex items-center justify-center text-xs"
                          title="3 colonnes"
                        >
                          <iconify-icon icon="tabler:columns-3" width="14"></iconify-icon>
                        </button>
                        <div class="w-px h-3 bg-gray-300 dark:bg-gray-600 mx-0.5 self-center"></div>
                        <button 
                          @click.stop="addColumnToRow(index, rowIndex)"
                          class="w-6 h-6 rounded bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 hover:bg-primary hover:text-white hover:scale-110 transition-all flex items-center justify-center text-xs"
                          title="Ajouter une colonne (+1)"
                          x-show="(row.columns || 1) < 12"
                        >
                          <iconify-icon icon="tabler:square-plus-2" width="14"></iconify-icon>
                        </button>
                      </div>
                      
                      <!-- Row content (columns) -->
                      <div class="grid gap-4" :style="'grid-template-columns: repeat(' + (row.columns || 1) + ', minmax(0, 1fr))'">
                        <template x-for="col in (row.columns || 1)" :key="'col-' + col">
                          <div 
                            class="rounded min-h-[100px] group/col relative transition-all border border-dashed border-transparent"
                            x-data="{ isOver: false, isHover: false }"
                            @mouseenter="isHover = true"
                            @mouseleave="isHover = false"
                            :style="isHover ? 'border-color: #e5e7eb !important;' : ''"
                            :class="{ 
                              'bg-gray-100 dark:bg-gray-800': !(row.elements || []).some(e => e.column === col - 1),
                              'ring-2 ring-primary/50 bg-primary/5': isOver 
                            }"
                            @dragover.prevent="isOver = true"
                            @dragleave="isOver = false"
                            @drop="isOver = false; handleDrop($event, index, rowIndex, col - 1)"
                          >
                            <!-- Render Elements -->
                            <div class="flex flex-col gap-2 relative z-10" :class="{ 'p-4': !(row.elements || []).some(e => e.column === col - 1) }">
                              <template x-for="element in (row.elements || []).filter(e => e.column === col - 1)" :key="element.id">
                                <div class="group/el">
                                  <div 
                                    contenteditable="true" 
                                    class="outline-none text-sm min-h-[1.5em] p-1 border border-transparent hover:border-gray-100 focus:!border-blue-400/30 focus:!ring-2 focus:!ring-blue-400/10 rounded transition-all"
                                    style="outline: none !important;"
                                    x-text="element.content"
                                    @blur="updateElementContent($event, index, rowIndex, element.id)"
                                  ></div>
                                </div>
                              </template>
                            </div>

                            <!-- Empty State / Add Button -->
                            <div 
                              x-show="!(row.elements || []).some(e => e.column === col - 1)" 
                              class="absolute inset-0 flex items-center justify-center pointer-events-none"
                            >
                              <button class="w-8 h-8 rounded-full bg-white dark:bg-gray-600 shadow-sm flex items-center justify-center text-gray-400 pointer-events-auto">
                                <iconify-icon icon="solar:add-circle-bold" width="20"></iconify-icon>
                              </button>
                            </div>
                          </div>
                        </template>
                      </div>
                    </div>
                  </div>
                </template>
              </div>
            </div>

            <!-- Page Actions Bar (bottom) -->
            <div class="flex items-center justify-center gap-1 mt-2 opacity-0 group-hover:opacity-100 transition-opacity">
              <button @click="addPageAfter(index)" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-primary transition-colors" title="Ajouter une page après">
                <iconify-icon icon="solar:add-circle-bold" width="18"></iconify-icon>
              </button>
              <button @click="duplicatePage(index)" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-primary transition-colors" title="Dupliquer">
                <iconify-icon icon="solar:copy-bold" width="18"></iconify-icon>
              </button>
              <button @click="deletePage(index)" x-show="doc.pages.length > 1" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-danger transition-colors" title="Supprimer">
                <iconify-icon icon="solar:trash-bin-trash-bold" width="18"></iconify-icon>
              </button>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- Properties Panel -->
    <div class="w-80 bg-white dark:bg-gray-900 border-l dark:border-gray-800 flex flex-col h-full">
      <!-- Panel Header -->
      <div class="p-4 border-b dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/50">
        <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 dark:text-gray-500">Document Settings</h3>
        <h2 class="text-lg font-bold text-gray-900 dark:text-white mt-1">Propriétés</h2>
      </div>
      
      <div class="flex-1 overflow-auto">
        <!-- Section: Information -->
        <div class="border-b dark:border-gray-700">
          <button @click="openSections.info = !openSections.info" class="w-full flex items-center justify-between p-4 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors group">
            <div class="flex items-center gap-3">
              <iconify-icon icon="tabler:info-circle" width="20" class="text-gray-400 group-hover:text-primary transition-colors"></iconify-icon>
              <span class="text-sm font-bold text-gray-700 dark:text-gray-200">Général</span>
            </div>
            <iconify-icon :icon="openSections.info ? 'tabler:chevron-up' : 'tabler:chevron-down'" width="16" class="text-gray-400"></iconify-icon>
          </button>
          
          <div x-show="openSections.info" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="px-4 pb-4 space-y-4">
            <div>
              <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-2">Nom du document</label>
              <input type="text" x-model="doc.name" @input="saveDocument" class="form-input bg-gray-50 dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-sm focus:ring-primary/20">
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-1">Format</label>
                <p class="text-sm font-medium text-gray-900 dark:text-white" x-text="doc.format"></p>
              </div>
              <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-1">Orientation</label>
                <p class="text-sm font-medium text-gray-900 dark:text-white capitalize" x-text="doc.orientation"></p>
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-1">Dimensions</label>
              <p class="text-sm font-medium text-gray-900 dark:text-white" x-text="doc.dimensions.width + ' x ' + doc.dimensions.height + ' px'"></p>
            </div>
          </div>
        </div>

        <!-- Section: Margins -->
        <div class="border-b dark:border-gray-700">
          <button @click="openSections.margins = !openSections.margins" class="w-full flex items-center justify-between p-4 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors group">
            <div class="flex items-center gap-3">
              <iconify-icon icon="tabler:layout-padding-left" width="20" class="text-gray-400 group-hover:text-primary transition-colors"></iconify-icon>
              <span class="text-sm font-bold text-gray-700 dark:text-gray-200">Marges de page</span>
            </div>
            <iconify-icon :icon="openSections.margins ? 'tabler:chevron-up' : 'tabler:chevron-down'" width="16" class="text-gray-400"></iconify-icon>
          </button>
          
          <div x-show="openSections.margins" x-transition class="px-4 pb-4">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="text-[10px] font-bold uppercase text-gray-400 dark:text-gray-500 block mb-1">Haut</label>
                <div class="relative">
                  <input type="number" x-model.number="doc.margins.top" @input="saveDocument" class="form-input pl-2 pr-8 py-1.5 text-sm" min="0" max="200">
                  <span class="absolute right-2 top-1.5 text-[10px] text-gray-400">px</span>
                </div>
              </div>
              <div>
                <label class="text-[10px] font-bold uppercase text-gray-400 dark:text-gray-500 block mb-1">Bas</label>
                <div class="relative">
                  <input type="number" x-model.number="doc.margins.bottom" @input="saveDocument" class="form-input pl-2 pr-8 py-1.5 text-sm" min="0" max="200">
                  <span class="absolute right-2 top-1.5 text-[10px] text-gray-400">px</span>
                </div>
              </div>
              <div>
                <label class="text-[10px] font-bold uppercase text-gray-400 dark:text-gray-500 block mb-1">Gauche</label>
                <div class="relative">
                  <input type="number" x-model.number="doc.margins.left" @input="saveDocument" class="form-input pl-2 pr-8 py-1.5 text-sm" min="0" max="200">
                  <span class="absolute right-2 top-1.5 text-[10px] text-gray-400">px</span>
                </div>
              </div>
              <div>
                <label class="text-[10px] font-bold uppercase text-gray-400 dark:text-gray-500 block mb-1">Droite</label>
                <div class="relative">
                  <input type="number" x-model.number="doc.margins.right" @input="saveDocument" class="form-input pl-2 pr-8 py-1.5 text-sm" min="0" max="200">
                  <span class="absolute right-2 top-1.5 text-[10px] text-gray-400">px</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="border-b dark:border-gray-700">
          <div @click="openSections.pages = !openSections.pages" class="w-full flex items-center justify-between p-4 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors group cursor-pointer">
            <div class="flex items-center gap-3">
              <iconify-icon icon="tabler:files" width="20" class="text-gray-400 group-hover:text-primary transition-colors"></iconify-icon>
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-gray-700 dark:text-gray-200">Pages</span>
                <span class="bg-gray-100 dark:bg-gray-800 text-gray-500 text-[10px] font-bold px-1.5 py-0.5 rounded-full" x-text="doc.pages.length"></span>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <button @click.stop="addPage" class="w-6 h-6 rounded-full hover:bg-primary/10 text-primary flex items-center justify-center transition-all hover:scale-110 active:scale-95">
                <iconify-icon icon="tabler:plus" width="18"></iconify-icon>
              </button>
              <iconify-icon :icon="openSections.pages ? 'tabler:chevron-up' : 'tabler:chevron-down'" width="16" class="text-gray-400"></iconify-icon>
            </div>
          </div>

          <div x-show="openSections.pages" x-transition class="px-2 pb-4">
            <div class="space-y-1 max-h-[250px] overflow-auto px-2">
              <template x-for="(page, index) in doc.pages" :key="index">
                <div 
                  class="group/page flex items-center gap-3 p-2 rounded-lg transition-all cursor-pointer relative" 
                  :class="selectedPageIndex === index ? 'bg-primary/5 ring-1 ring-primary/20 shadow-sm' : 'hover:bg-gray-50 dark:hover:bg-gray-800'" 
                  @click="selectPage(index)"
                >
                  <div class="w-8 h-10 rounded-md bg-white dark:bg-gray-700 border dark:border-gray-600 flex items-center justify-center shadow-xs group-hover/page:scale-105 transition-transform" :class="{ 'border-primary/30 ring-2 ring-primary/10': selectedPageIndex === index }">
                    <span class="text-[10px] font-bold text-gray-400" x-text="index + 1"></span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold truncate" :class="selectedPageIndex === index ? 'text-primary' : 'text-gray-700 dark:text-gray-200'" x-text="'Page ' + (index + 1)"></p>
                    <p class="text-[10px] text-gray-400" x-text="page.elements.length + ' élément(s)'"></p>
                  </div>
                  <div class="opacity-0 group-hover/page:opacity-100 transition-opacity flex items-center gap-1">
                    <button @click.stop="duplicatePage(index)" class="p-1 text-gray-400 hover:text-primary"><iconify-icon icon="tabler:copy" width="14"></iconify-icon></button>
                    <button @click.stop="deletePage(index)" x-show="doc.pages.length > 1" class="p-1 text-gray-400 hover:text-danger"><iconify-icon icon="tabler:trash" width="14"></iconify-icon></button>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </div>


      </div>
    </div>
  </div>
</div>

<!-- Data passed from server -->
<script type="application/json" id="document-data">
<%- JSON.stringify({
  isNew: isNew,
  docId: isNew ? null : document._id,
  name: isNew ? 'Sans titre' : document.name,
  format: isNew ? 'A4' : document.format,
  orientation: isNew ? 'portrait' : document.orientation,
  dimensions: isNew ? { width: 794, height: 1123 } : document.dimensions,
  pages: isNew ? [{ elements: [], background: { color: '#ffffff' }, order: 0 }] : document.pages,
  status: isNew ? 'draft' : document.status
}).replace(/</g, '\\u003C') %>
</script>

<script>
  document.addEventListener('alpine:init', function() {
    Alpine.data('documentEditor', function() {
      var data = JSON.parse(document.getElementById('document-data').textContent);
      var accountNumber = '<%= account_number %>';
      
      return {
        doc: {
          _id: data.docId,
          name: data.name,
          format: data.format,
          orientation: data.orientation,
          dimensions: data.dimensions,
          pages: data.pages,
          status: data.status,
          margins: data.margins || { top: 72, bottom: 72, left: 72, right: 72 }
        },
        editorMode: 'edition',
        selectedPageIndex: 0,
        selectedRow: null,
        lastSaved: null,
        saveTimeout: null,
        openSections: {
          info: true,
          margins: true,
          pages: true
        },

        formats: {
          'A4': { width: 794, height: 1123 },
          'A5': { width: 559, height: 794 },
          'A3': { width: 1123, height: 1587 },
          'Letter': { width: 816, height: 1056 },
          'Legal': { width: 816, height: 1344 }
        },

        updateDimensions: function() {
          var format = this.formats[this.doc.format];
          if (this.doc.orientation === 'landscape') {
            this.doc.dimensions = { width: format.height, height: format.width };
          } else {
            this.doc.dimensions = { width: format.width, height: format.height };
          }
          this.saveDocument();
        },

        addPage: function() {
          var newPage = {
            elements: [],
            background: { color: '#ffffff' },
            order: this.doc.pages.length
          };
          this.doc.pages.push(newPage);
          this.selectedPageIndex = this.doc.pages.length - 1;
          this.saveDocument();
          
          var self = this;
          this.$nextTick(function() {
            var container = document.getElementById('canvas-container');
            container.scrollTo({
              top: container.scrollHeight,
              behavior: 'smooth'
            });
          });
        },

        addPageAfter: function(index) {
          var newPage = {
            elements: [],
            background: { color: '#ffffff' },
            order: index + 1
          };
          this.doc.pages.splice(index + 1, 0, newPage);
          this.selectedPageIndex = index + 1;
          this.saveDocument();
        },

        addRow: function(pageIndex) {
          if (!this.doc.pages[pageIndex].rows) {
            this.doc.pages[pageIndex].rows = [];
          }
          this.doc.pages[pageIndex].rows.push({
            columns: 1,
            elements: []
          });
          this.saveDocument();
        },

        setRowLayout: function(pageIndex, rowIndex, columns) {
          if (!this.doc.pages[pageIndex].rows) return;
          this.doc.pages[pageIndex].rows[rowIndex].columns = columns;
          this.saveDocument();
        },

        addColumnToRow: function(pageIndex, rowIndex) {
          if (!this.doc.pages[pageIndex].rows) return;
          var row = this.doc.pages[pageIndex].rows[rowIndex];
          if ((row.columns || 1) < 12) {
            row.columns = (row.columns || 1) + 1;
            this.saveDocument();
          }
        },

        startDrag: function(event, type) {
          event.dataTransfer.setData('type', type);
          event.dataTransfer.effectAllowed = 'copy';
        },

        handleDrop: function(event, pageIndex, rowIndex, colIndex) {
          this.isDragging = false;
          var type = event.dataTransfer.getData('type');
          
          if (type === 'text') {
            if (!this.doc.pages[pageIndex].rows[rowIndex].elements) {
              this.doc.pages[pageIndex].rows[rowIndex].elements = [];
            }
            
            this.doc.pages[pageIndex].rows[rowIndex].elements.push({
              id: Date.now(),
              type: 'text',
              content: 'Nouveau texte',
              column: colIndex
            });
            this.saveDocument();
          }
        },

        updateElementContent: function(event, pageIndex, rowIndex, elementId) {
          var content = event.target.innerText;
          var row = this.doc.pages[pageIndex].rows[rowIndex];
          var element = row.elements.find(e => e.id === elementId);
          if (element) {
            element.content = content;
            this.saveDocument();
          }
        },

        duplicatePage: function(index) {
          var pageToDuplicate = JSON.parse(JSON.stringify(this.doc.pages[index]));
          pageToDuplicate.order = this.doc.pages.length;
          this.doc.pages.splice(index + 1, 0, pageToDuplicate);
          this.selectedPageIndex = index + 1;
          this.saveDocument();
        },

        deletePage: function(index) {
          if (this.doc.pages.length <= 1) {
            alert('Vous devez avoir au moins une page');
            return;
          }
          
          if (confirm('Supprimer la page ' + (index + 1) + ' ?')) {
            this.doc.pages.splice(index, 1);
            if (this.selectedPageIndex >= this.doc.pages.length) {
              this.selectedPageIndex = this.doc.pages.length - 1;
            }
            this.saveDocument();
          }
        },

        selectPage: function(index) {
          this.selectedPageIndex = index;
        },

        syncPageContent: function(event, pageIndex) {
          // Sync content when user leaves the page
          var element = event.target;
          this.doc.pages[pageIndex].content = element.innerHTML;
        },

        handlePageInput: function(event, pageIndex) {
          var element = event.target;
          var content = element.innerHTML;
          
          // Save content to page data
          this.doc.pages[pageIndex].content = content;
          
          // Check for overflow (content too big -> push to next page)
          this.checkOverflow(element, pageIndex);
          
          // Check for underflow (space available -> pull from next page)
          this.checkUnderflow(element, pageIndex);
          
          this.saveDocument();
        },

        handlePaste: function(event, pageIndex) {
          event.preventDefault();
          var self = this;
          
          // Get pasted text
          var pastedText = (event.clipboardData || window.clipboardData).getData('text/html');
          if (!pastedText) {
            pastedText = (event.clipboardData || window.clipboardData).getData('text/plain');
            pastedText = pastedText.replace(/\n/g, '<br>');
          } else {
            // Clean Word HTML - remove excessive spacing
            pastedText = this.cleanWordHtml(pastedText);
          }
          
          // Insert at cursor position
          document.execCommand('insertHTML', false, pastedText);
          
          // Get the element and check for overflow
          var element = event.target;
          this.doc.pages[pageIndex].content = element.innerHTML;
          
          // Use setTimeout to allow DOM to update
          setTimeout(function() {
            self.checkOverflow(element, pageIndex);
            self.saveDocument();
          }, 100);
        },

        cleanWordHtml: function(html) {
          // Create a temporary div to parse HTML
          var temp = document.createElement('div');
          
          // Pre-cleaning
          html = html.replace(/<!--\[if\s+!vml\]-->([\s\S]*?)<!--\[endif\]-->/gi, '$1');
          html = html.replace(/<!\[if\s+!vml\]>([\s\S]*?)<!\[endif\]>/gi, '$1');
          html = html.replace(/<!--\[if\s+vml\]>([\s\S]*?)<!\[endif\]-->/gi, '');
          html = html.replace(/<!\[if\s+vml\]>([\s\S]*?)<!\[endif\]>/gi, '');
          html = html.replace(/<!--\[if\s+gte\s+vml\s+1\]>([\s\S]*?)<!\[endif\]-->/gi, '');
          
          temp.innerHTML = html;
          
          function unwrap(el) {
             var parent = el.parentNode;
             while (el.firstChild) parent.insertBefore(el.firstChild, el);
             parent.removeChild(el);
          }

          // 1. General Gentle Clean (Preserves formatting for normal text)
          var elementsToClean = temp.querySelectorAll('*');
          elementsToClean.forEach(function(el) {
            el.removeAttribute('class');
            el.removeAttribute('lang');
            
            var tagName = el.tagName;
            // Skip tables/lists here, we handle them aggressively below
            if (['TABLE','THEAD','TBODY','TFOOT','TR','TH','TD','UL','OL','LI'].includes(tagName)) return;

            var style = el.getAttribute('style');
            if (style) {
              style = style.replace(/mso-[^;]+;?/gi, '');
              style = style.replace(/position:[^;]+;?/gi, '');
              style = style.replace(/margin[^;]*;?/gi, '');
              style = style.replace(/padding[^;]*;?/gi, '');
              el.setAttribute('style', style);
            }
            
            if (tagName === 'IMG') {
               el.style.maxWidth = '100%';
               el.style.height = 'auto'; 
               el.removeAttribute('width');
               el.removeAttribute('height');
               el.removeAttribute('v:shapes');
            }
          });
          
          // 2. DEEP CLEAN & BEAUTIFY: Tables and Lists
          // User wants to strip ALL original styles inside tables/lists and apply a "Beautiful" look.
          
          // Tables
          var tables = temp.querySelectorAll('table');
          tables.forEach(function(table) {
             // 2a. Nuke styles from Table and ALL descendants
             table.removeAttribute('style');
             table.removeAttribute('border');
             table.removeAttribute('cellspacing');
             table.removeAttribute('cellpadding');
             table.removeAttribute('width');
             
             var descendants = table.querySelectorAll('*');
             descendants.forEach(function(d) {
                 d.removeAttribute('style'); // Removes text color, font, bg, everything.
                 d.removeAttribute('class');
                 d.removeAttribute('width');
                 d.removeAttribute('height');
                 d.removeAttribute('bgcolor');
                 d.removeAttribute('align');
                 d.removeAttribute('valign');
             });
             
             // 2b. Apply "Beautiful Table" Inline Styles
             // Container
             table.style.width = '100%';
             table.style.borderCollapse = 'collapse';
             table.style.marginBottom = '1em';
             table.style.marginTop = '0.5em';
             table.style.fontFamily = 'inherit'; 
             table.style.fontSize = '0.9em'; // Slightly smaller font for data
             table.style.border = '1px solid #e5e7eb'; 
             
             // Headers
             var ths = table.querySelectorAll('th');
             ths.forEach(function(th) {
                th.style.backgroundColor = '#f9fafb'; 
                th.style.color = '#111827'; 
                th.style.fontWeight = '600';
                th.style.textAlign = 'left';
                th.style.padding = '8px 12px'; // Reduced padding
                th.style.borderBottom = '1px solid #d1d5db';
             });
             
             // Cells
             var tds = table.querySelectorAll('td');
             tds.forEach(function(td) {
                td.style.padding = '6px 12px'; // Compact padding
                td.style.borderBottom = '1px solid #e5e7eb'; 
                td.style.color = '#374151'; 
                td.style.verticalAlign = 'top';
                
                // Fix: Remove default margins from P tags inside cells to prevent huge rows
                var paragraphs = td.querySelectorAll('p');
                paragraphs.forEach(function(p) {
                    p.style.margin = '0';
                    p.style.lineHeight = '1.4';
                });
             });
          });

          // Lists
          var lists = temp.querySelectorAll('ul, ol');
          lists.forEach(function(list) {
             // 2c. Nuke styles from List and ALL descendants
             list.removeAttribute('style');
             
             var descendants = list.querySelectorAll('*');
             descendants.forEach(function(d) {
                 d.removeAttribute('style');
                 d.removeAttribute('class');
             });
             
             // 2d. Apply "Beautiful List" Styles
             list.style.paddingLeft = '1.5em';
             list.style.marginBottom = '1em';
             list.style.color = '#374151';
             
             if (list.tagName === 'UL') list.style.listStyleType = 'disc';
             if (list.tagName === 'OL') list.style.listStyleType = 'decimal';
             
             var lis = list.querySelectorAll('li');
             lis.forEach(function(li) {
                li.style.marginBottom = '0.25em'; // Reduced spacing
                li.style.lineHeight = '1.5';
             });
          });
          
          // Final string cleanup
          var result = temp.innerHTML;
          result = result.replace(/[\r\n]+/g, ' ');
          result = result.replace(/<o:p><\/o:p>/gi, '');
          result = result.replace(/<!--[\s\S]*?-->/gi, ''); 
          result = result.replace(/<span[^>]*>\s*<\/span>/gi, '');
          result = result.replace(/<br\s*\/?>\s*(?!<br)/gi, ' ');
          result = result.replace(/\s{2,}/g, ' ');
          
          return result;
        },

        checkOverflow: function(element, pageIndex) {
          var self = this;
          
          // Check if content overflows
          if (element.scrollHeight > element.clientHeight) {
            // Content overflows - need to move excess to next page
            var overflowContent = this.extractOverflow(element);
            
            if (overflowContent) {
              // Create next page if it doesn't exist
              var nextPageIndex = pageIndex + 1;
              var isNewPage = false;
              
              if (nextPageIndex >= this.doc.pages.length) {
                this.doc.pages.push({
                  content: '',
                  elements: [],
                   background: { color: '#ffffff' },
                  order: this.doc.pages.length
                });
                isNewPage = true;
              }
              
              // Prepend overflow to next page
              // Use a temp timeout to let data update before reading back? 
              // No, we can just update the data object directly.
              var nextPageData = this.doc.pages[nextPageIndex];
              var oldContent = nextPageData.content || '';
              nextPageData.content = overflowContent + oldContent;
              
              // Update current page content
              this.doc.pages[pageIndex].content = element.innerHTML;
              
              // Wait for DOM to assume new pages exist
              var attemptCount = 0;
              var maxAttempts = 20; // Try for ~1 second (20 * 50ms)
              
              var continuePagination = function() {
                 var nextPageElement = document.querySelector('[data-page-index="' + nextPageIndex + '"]');
                 if (nextPageElement) {
                   // Ensure content is synced in DOM if it wasn't a fresh init
                   if (!isNewPage) {
                      nextPageElement.innerHTML = self.doc.pages[nextPageIndex].content;
                   }
                   // Force layout reflow
                   var h = nextPageElement.offsetHeight;
                   
                   // Continue the chain
                   self.checkOverflow(nextPageElement, nextPageIndex);
                 } else {
                   attemptCount++;
                   if (attemptCount < maxAttempts) {
                     setTimeout(continuePagination, 50);
                   } else {
                     console.error('Pagination aborted: Could not find page ' + nextPageIndex + ' after creation.');
                   }
                 }
              };
              
              // Start checking for next page
              this.$nextTick(function() {
                 continuePagination();
              });
            }
          }
        },

        checkUnderflow: function(element, pageIndex) {
          var self = this;
          
          // Only check if there's a next page with content
          if (pageIndex + 1 >= this.doc.pages.length) {
            return;
          }
          
          var nextPageContent = this.doc.pages[pageIndex + 1].content;
          if (!nextPageContent || !nextPageContent.trim()) {
            return;
          }
          
          // Get next page element
          var nextPageElement = document.querySelector('[data-page-index="' + (pageIndex + 1) + '"]');
          if (!nextPageElement) {
            return;
          }
          
          // Try to pull first element from next page
          var pulled = this.tryPullFromNextPage(element, nextPageElement, pageIndex);
          
          if (pulled) {
            // Update data
            this.doc.pages[pageIndex].content = element.innerHTML;
            this.doc.pages[pageIndex + 1].content = nextPageElement.innerHTML;
            
            // Check if next page became empty
            this.$nextTick(function() {
              var nextContent = self.doc.pages[pageIndex + 1];
              if (nextContent && (!nextContent.content || !nextContent.content.trim())) {
                self.doc.pages.splice(pageIndex + 1, 1);
                // After removing page, check if current page can still pull more
                self.checkUnderflow(element, pageIndex);
              } else {
                // Try to pull more to current page
                self.checkUnderflow(element, pageIndex);
                
                // CHAIN: Also check if next page can now pull from page after it
                self.$nextTick(function() {
                  if (pageIndex + 1 < self.doc.pages.length) {
                    var updatedNextElement = document.querySelector('[data-page-index="' + (pageIndex + 1) + '"]');
                    if (updatedNextElement) {
                      self.checkUnderflow(updatedNextElement, pageIndex + 1);
                    }
                  }
                });
              }
            });
          }
        },

        tryPullFromNextPage: function(currentElement, nextElement, pageIndex) {
          // Get first child node from next page
          var firstChild = nextElement.firstChild;
          if (!firstChild) {
            return false;
          }
          
          // Clone it for testing
          var testNode;
          if (firstChild.nodeType === Node.ELEMENT_NODE) {
            testNode = firstChild.cloneNode(true);
          } else if (firstChild.nodeType === Node.TEXT_NODE) {
            testNode = document.createTextNode(firstChild.textContent);
          } else {
            return false;
          }
          
          // Add to current page temporarily
          currentElement.appendChild(testNode);
          
          // Check if it still fits (no overflow)
          var fits = currentElement.scrollHeight <= currentElement.clientHeight;
          
          if (fits) {
            // It fits! Now actually remove from next page
            nextElement.removeChild(firstChild);
            return true;
          } else {
            // Doesn't fit, remove test node
            currentElement.removeChild(testNode);
            return false;
          }
        },

        extractOverflow: function(element) {
          // Use a robust iterative approach with recursive splitting for large nodes
          var removedNodes = [];
          var maxIterations = 2000; // Increased safety limit for fine splitting
          var iterations = 0;
          
          // Helper to check overflow
          var hasOverflow = function() {
            return element.scrollHeight > element.clientHeight;
          };

          if (!hasOverflow()) {
            return '';
          }
          
          // Helper to split a node (text or element) if it's too big
          var splitNode = function(node) {
            // Cannot split empty nodes or small text
            if (!node) return null;
            
            if (node.nodeType === Node.TEXT_NODE) {
              var text = node.textContent;
              if (text.length <= 1) return null; // Can't split single char
              
              var mid = Math.floor(text.length / 2);
              var rightText = text.substring(mid);
              var leftText = text.substring(0, mid);
              
              node.textContent = leftText;
              var newRightNode = document.createTextNode(rightText);
              
              if (node.parentNode) {
                node.parentNode.insertBefore(newRightNode, node.nextSibling);
              }
              return newRightNode;
            } 
            else if (node.nodeType === Node.ELEMENT_NODE) {
              var children = Array.from(node.childNodes);
              if (children.length > 0) {
                return children[children.length - 1];
              }
              return null;
            }
            return null;
          };

          // Iteratively remove/split nodes from the end until no overflow
          while (hasOverflow() && iterations < maxIterations) {
            var lastChild = element.lastChild;
            
            if (!lastChild) {
              break; 
            }
            
            // Try removing the last child entirely first
            element.removeChild(lastChild);
            
            // Critical Check: Did we empty the page?
            var pageIsEmpty = element.childNodes.length === 0 || (element.textContent.trim() === '' && element.querySelectorAll('img, table, div').length === 0);
            
            if (pageIsEmpty && !hasOverflow()) { 
               // logic: removing the last child resolved overflow, BUT page is now empty.
               // This means that 'lastChild' ALONE was too big for the page.
               
               // We must put it back and try to split it.
               element.appendChild(lastChild);
               
               // Try to split this lastChild
               var didSplitSwapped = false;

               if (lastChild.nodeType === Node.TEXT_NODE) {
                  var rightPart = splitNode(lastChild);
                  if (rightPart) {
                    element.removeChild(rightPart);
                    removedNodes.unshift(rightPart);
                    didSplitSwapped = true;
                  } 
               } else if (lastChild.nodeType === Node.ELEMENT_NODE) {
                  // If it has children, dive in.
                  if (lastChild.childNodes.length > 0) {
                     // We recursively extract from the child
                     var extractedFromChild = this.extractOverflow(lastChild);
                     
                     if (extractedFromChild) {
                        // We successfully extracted part of the child. 
                        // The extracted part needs to be added to removedNodes.
                        // However, removedNodes expects DOM nodes, extractOverflow returns HTML string.
                        // We need to wrap this HTML string back into a container to be consistent?
                        // Or just parse it?
                        
                        var tempDiv = document.createElement('div');
                        tempDiv.innerHTML = extractedFromChild;
                        // Move all tempDiv children to removedNodes (in reverse order because unshift)
                        // Actually we want to preserve order.
                        // The 'extractedFromChild' is what GOES to the next page.
                        
                        // BUT: We simply cannot easily mix "HTML String" return with "DOM Nodes" array logic here 
                        // without restructuring.
                        
                        // SIMPLIFICATION:
                        // Move the LAST grandchild out.
                         var grandChild = lastChild.lastChild;
                         if (grandChild) {
                           lastChild.removeChild(grandChild);
                           
                           // We need to create a clone wrapper for the grandchild on the next page
                           var wrapper = lastChild.cloneNode(false); // shallow clone
                           wrapper.removeAttribute('id'); // prevent ID conflicts
                           wrapper.appendChild(grandChild);
                           
                           removedNodes.unshift(wrapper);
                           didSplitSwapped = true;
                         }
                     }
                  }
               }

               if (!didSplitSwapped) {
                   // COULD NOT SPLIT.
                   // This is the "Infinite Loop Killer" logic.
                   // The element is too big, alone on the page, and unsplittable (e.g. big image).
                   // WE MUST STOP MOVING IT.
                   // We leave it on this page (it will overflow visibly, but won't loop).
                   // We verify if we have anything ELSE in removedNodes to return?
                   // No, we just break.
                   break;
               }
            } else {
               // Normal case: removing it fixed overflow (or it still overflows but page isn't empty yet).
               // Just keep it moved.
               removedNodes.unshift(lastChild);
            }
            
            iterations++;
          }
          
          // Reconstruct HTML from removedNodes
          var overflowHtml = '';
          removedNodes.forEach(function(node) {
            if (node.nodeType === Node.ELEMENT_NODE) {
              overflowHtml += node.outerHTML;
            } else if (node.nodeType === Node.TEXT_NODE) {
              overflowHtml += node.textContent ? node.textContent.replace(/\n/g, '<br>') : '';
            }
          });
          
          return overflowHtml;
        },

        saveDocument: function() {
          clearTimeout(this.saveTimeout);
          var self = this;
          this.saveTimeout = setTimeout(function() {
            var method = self.doc._id ? 'PUT' : 'POST';
            var url = self.doc._id 
              ? '/account/' + accountNumber + '/documents/api/' + self.doc._id
              : '/account/' + accountNumber + '/documents/api';
            
            console.log('Saving document...', { method: method, url: url, docId: self.doc._id });

            fetch(url, {
              method: method,
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(self.doc)
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
              console.log('Save response:', data);
              if (data.document) {
                if (!self.doc._id) {
                  if (data.document._id) {
                      self.doc._id = data.document._id;
                      var newUrl = '/account/' + accountNumber + '/documents/' + data.document._id + '/edit';
                      console.log('Updating URL to:', newUrl);
                      window.history.replaceState({}, '', newUrl);
                  } else {
                      console.error('CRITICAL: Server returned document without _id!', data.document);
                  }
                }
                self.lastSaved = new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
              } else {
                  console.warn('Response missing document property:', data);
              }
            })
            .catch(function(error) {
              console.error('Error saving document:', error);
            });
          }, 1000);
        },

        printDocument: function() {
           var self = this;
           var btn = this.$event.target.closest('button');
           var originalText = btn.innerHTML;
           
           // Show loading state
           btn.innerHTML = '<iconify-icon icon="svg-spinners:ring-resize" class="mr-1"></iconify-icon> Génération...';
           btn.disabled = true;

           // clone the pages container to send only relevant HTML
           // FIX: Use robust ID selector
           var container = document.getElementById('pages-container');
           var htmlContent = container ? container.innerHTML : '';
           
           if (!htmlContent) {
               alert('Erreur: Impossible de récupérer le contenu du document');
               btn.innerHTML = originalText;
               btn.disabled = false;
               return;
           }

           // Remove Alpine attributes and edit-specific artifacts to clean up the HTML before sending
           var tempDiv = document.createElement('div');
           tempDiv.innerHTML = htmlContent;
           
           // Clean up: Remove edit buttons, empty state placeholders
           tempDiv.querySelectorAll('button, .group\\/el > div[contenteditable]').forEach(el => {
                if (el.tagName === 'BUTTON') el.remove();
                // We keep contenteditable divs but strip the attribute? 
                // Puppeteer handles them fine visually.
           });

           fetch('/account/' + accountNumber + '/documents/api/' + this.doc._id + '/pdf', {
               method: 'POST',
               headers: { 'Content-Type': 'application/json' },
               body: JSON.stringify({ html: tempDiv.innerHTML })
           })
           .then(res => {
               if (!res.ok) {
                    return res.text().then(text => { throw new Error(text) });
               }
               return res.blob();
           })
           .then(blob => {
               var url = window.URL.createObjectURL(blob);
               var a = document.createElement('a');
               a.href = url;
               a.download = self.doc.name + '.pdf';
               document.body.appendChild(a);
               a.click();
               a.remove();
           })
           .catch(err => {
               console.error(err);
               alert('Erreur PDF: ' + err.message);
           })
           .finally(() => {
               btn.innerHTML = originalText;
               btn.disabled = false;
           });
        }
      };
    });
  });
</script>

<style>
  /* Print Styles for PDF Generation */
  @media print {
    @page { 
      margin: 0; 
      size: auto;
    }
    
    body {
      background: white;
      margin: 0;
      padding: 0;
      overflow: visible !important;
    }

    /* Hide UI Elements */
    header, nav, aside, 
    .bg-white.dark\:bg-gray-900.border-b, /* Top Header */
    .w-16.bg-white, /* Left Toolbar */
    .w-80.bg-white, /* Right Sidebar */
    .btn, button, input, select,
    [x-show="editorMode === 'layout'"],
    [x-show="editorMode === 'designer'"] {
      display: none !important;
    }

    /* Target the Main Content Area */
    .flex-1.flex.overflow-hidden {
      overflow: visible !important;
      height: auto !important;
      display: block !important;
    }
    
    .overflow-auto {
      overflow: visible !important;
    }

    /* Target Pages */
    .bg-white.shadow-2xl {
      box-shadow: none !important;
      margin: 0 auto !important;
      border: none !important;
      page-break-after: always;
      position: relative !important;
      left: 0 !important;
      top: 0 !important;
