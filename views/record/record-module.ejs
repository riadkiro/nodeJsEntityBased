                    </div>
                    <div class="ov-drive-name">Ordonnance.pdf</div>
                    <div class="ov-drive-meta">120 KB · 01/04</div>
                </div>
            </div>
        </div>

        <!-- ═══ Dynamic Tables (Lignes) ═══ -->
        <div class="ov-card ov-card-lines ov-full">
            <div class="ov-card-header">
                <iconify-icon icon="solar:bill-list-bold-duotone" width="18" style="color:#6366f1"></iconify-icon>
                <span>Tableaux dynamiques</span>
                <a href="<%= _recBase %>/edit" class="ov-card-link">Modifier →</a>
            </div>

            <!-- Tab bar -->
            <div class="ov-lines-tabs">
                <button type="button" class="ov-lines-tab active">
                    <span class="ov-lines-dot" style="background:#4361ee"></span>
