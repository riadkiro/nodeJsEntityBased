<!-- Entity Form Builder (multi-form mode) -->
<div x-data="formBuilder()" class="flex flex-col" style="height: calc(100vh - 80px);">

  <!-- Header Bar -->
  <div class="bg-white dark:bg-gray-800 border-b dark:border-gray-800 shadow-sm">
    <div class="h-12 flex items-center justify-between px-4">
      <div class="flex items-center gap-3">
        <a :href="'/account/' + accountNumber + '/entity/' + entityId + '/forms'" class="w-8 h-8 rounded-md flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors" title="Retour aux formulaires">
          <iconify-icon icon="solar:arrow-left-line-duotone" width="20"></iconify-icon>
        </a>
        <div class="flex items-center gap-2">
          <iconify-icon :icon="entityMeta.icon || 'solar:box-bold-duotone'" width="20" :style="entityMeta.color ? 'color:' + entityMeta.color : ''"></iconify-icon>
          <h1 class="font-bold text-base" x-text="formName"></h1>
          <span class="text-xs text-gray-400">— <span x-text="entityMeta.name"></span></span>
        </div>
        <!-- Edit/Preview Toggle -->
        <div class="flex items-center ml-4 bg-gray-100 dark:bg-gray-700 rounded-lg p-0.5">
          <button @click="builderState.mode = 'edit'; isPreview = false" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all"
                  :class="builderState.mode === 'edit' ? 'bg-white dark:bg-gray-600 shadow-sm text-primary' : 'text-gray-500 hover:text-gray-700'">
            <iconify-icon icon="solar:pen-new-square-bold-duotone" width="14"></iconify-icon>
            Éditer
          </button>
          <button @click="builderState.mode = 'preview'; isPreview = true" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all"
                  :class="builderState.mode === 'preview' ? 'bg-white dark:bg-gray-600 shadow-sm text-primary' : 'text-gray-500 hover:text-gray-700'">
            <iconify-icon icon="solar:eye-bold-duotone" width="14"></iconify-icon>
            Aperçu
          </button>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <!-- Status badge -->
        <span x-show="formStatus === 'published'" class="text-[10px] font-bold uppercase tracking-wide text-success bg-success/10 px-2 py-0.5 rounded">Published</span>
        <span x-show="formStatus === 'draft'" class="text-[10px] font-bold uppercase tracking-wide text-gray-400 bg-gray-100 px-2 py-0.5 rounded">Draft</span>
        <!-- Unsaved indicator -->
        <span x-show="isDirty" class="text-xs text-amber-500 flex items-center gap-1">
          <iconify-icon icon="solar:danger-circle-bold" width="14"></iconify-icon>
          Non sauvegardé
        </span>
        <!-- Form name edit -->
        <div class="relative" x-data="{ editing: false }">
          <button @click="editing = !editing" class="btn btn-outline-secondary btn-sm text-xs" title="Renommer">
            <iconify-icon icon="solar:pen-bold" width="12"></iconify-icon>
          </button>
          <div x-show="editing" x-cloak @click.away="editing = false"
               class="absolute right-0 top-full mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-800 rounded-lg shadow-xl z-30 p-3 w-64">
            <label class="text-[10px] font-bold uppercase text-gray-400 block mb-1">Nom du formulaire</label>
            <input type="text" x-model="formName" class="form-input text-sm w-full mb-2" />
            <button @click="editing = false; isDirty = true" class="btn btn-primary btn-sm w-full text-xs">OK</button>
          </div>
        </div>
        <button @click="saveForm()" class="btn btn-primary btn-sm" :disabled="isSaving">
          <iconify-icon icon="solar:diskette-bold" class="mr-1"></iconify-icon>
          <span x-text="isSaving ? 'Sauvegarde...' : 'Sauvegarder'"></span>
        </button>
        <button @click="publishForm()" class="btn btn-success btn-sm" :disabled="isPublishing">
          <iconify-icon icon="solar:check-circle-bold" class="mr-1"></iconify-icon>
          <span x-text="isPublishing ? 'Publication...' : 'Publier'"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main Builder Area -->
  <div class="flex flex-1 overflow-hidden">
    <template x-if="builderState.mode === 'edit'">
      <div class="flex flex-1 overflow-hidden">
        <%- include('components/form-builder-sidebar') %>
        <%- include('components/form-builder-canvas') %>
      </div>
    </template>
    <template x-if="builderState.mode === 'preview'">
      <%- include('components/form-builder-preview') %>
    </template>
  </div>
</div>

<!-- Data Injection -->
<script type="application/json" id="form-builder-data">
<%- JSON.stringify({
  accountNumber: account_number,
  entityId: entity._id,
  formId: form ? form._id : null,
  formName: formName || 'Nouveau formulaire',
  formStatus: formStatus || 'draft',
  entityMeta: {
    name: entity.name,
    slug: entity.slug,
    description: entity.description || '',
    icon: entity.icon || '',
    color: entity.color || ''
  },
  formLayout: formLayout,
  standardFieldDefs: {
    title: { key: 'title', label: 'Titre', icon: 'solar:text-bold', inputType: 'text' },
    description: { key: 'description', label: 'Description', icon: 'solar:document-text-bold-duotone', inputType: 'textarea' },
    slug: { key: 'slug', label: 'Slug', icon: 'solar:link-bold', inputType: 'text' },
    date: { key: 'date', label: 'Date', icon: 'solar:calendar-bold-duotone', inputType: 'date' },
    icon: { key: 'icon', label: 'Icône', icon: 'solar:star-bold-duotone', inputType: 'text' },
    image: { key: 'image', label: 'Image', icon: 'solar:gallery-bold-duotone', inputType: 'file' },
    attachments: { key: 'attachments', label: 'Pièces jointes', icon: 'solar:paperclip-bold', inputType: 'file' }
  },
  enabledStandardFields: entity.enabledStandardFields || [],
  customFields: (fields || []).map(f => ({
    _id: f._id.toString(),
    name: f.name,
    label: f.label,
    type: f.type,
    inputType: f.inputType || f.type || 'text',
    htmlTemplate: f.htmlTemplate || '',
    ui: f.ui || {},
    options: f.options || []
  })),
  relations: (entity.relations || []).map(r => ({
    key: r.key,
    label: r.label,
    inverseLabel: r.inverseLabel,
    cardinality: r.cardinality,
    inputMode: r.inputMode,
    targetEntity: r.targetEntity ? {
      _id: (r.targetEntity._id || r.targetEntity).toString(),
      name: r.targetEntity.name || '',
      icon: r.targetEntity.icon || '',
      color: r.targetEntity.color || ''
    } : null
  })),
  classifications: (allClassifications || []).map(c => ({
    _id: c._id.toString(),
    name: c.name,
    options: (c.options || []).map(o => ({ label: o.label || o.name || o, color: o.color || '' }))
  })),
  entityClassificationIds: (entity.classifications || []).map(id => id.toString()),
  statusClassificationId: entity.statusClassification ? entity.statusClassification.toString() : ''
}).replace(/</g, '\\u003C') %>
</script>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('formBuilder', () => {
    const data = JSON.parse(document.getElementById('form-builder-data').textContent);
    
    // Normalize formLayout
    let formLayout = data.formLayout;
    if (!formLayout || !formLayout.version) {
      formLayout = { version: 1, rows: [] };
      if (Array.isArray(data.formLayout) && data.formLayout.length > 0) {
        if (data.formLayout[0] && data.formLayout[0].columns) {
          formLayout.rows = data.formLayout;
        } else {
          const row = { id: 'row_migrated', columns: [{ width: 12, fields: [] }] };
          data.formLayout.forEach(item => {
            row.columns[0].fields.push({
              id: item.id || 'f_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
              type: 'custom',
              fieldId: item.fieldId,
              label: '',
              required: false,
              placeholder: '',
              helpText: ''
            });
          });
          formLayout.rows = [row];
        }
      }
    }

    const genId = () => 'f_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7);

    return {
      // State
      accountNumber: data.accountNumber,
      entityId: data.entityId,
      formId: data.formId,
      formName: data.formName,
      formStatus: data.formStatus,
      entityMeta: data.entityMeta,
      formLayout: formLayout,
      standardFieldDefs: data.standardFieldDefs,
      enabledStandardFields: data.enabledStandardFields,
      availableCustomFields: data.customFields,
      entityRelations: data.relations,
      entityClassifications: data.classifications.filter(c => 
        data.entityClassificationIds.includes(c._id) || data.statusClassificationId === c._id
      ),
      isDirty: false,
      isSaving: false,
      isPreview: false,
      isPublishing: false,
      resizing: null,

      // Builder State (cockpit builder pattern)
      builderState: {
        mode: 'edit',
        selectedFieldId: null,
        hoveredRowId: null,
        drawerMode: 'fields',
        sidebarOpen: true,
        activeTab: 'default'
      },

      init() {
        this.$watch('formLayout', () => { this.isDirty = true; }, { deep: true });
      },

      // ========== SIDEBAR HELPERS ==========

      getAvailableStandardFields() {
        return this.enabledStandardFields
          .map(key => this.standardFieldDefs[key])
          .filter(Boolean);
      },

      isFieldOnCanvas(type, fieldId) {
        for (const row of this.formLayout.rows) {
          for (const col of row.columns) {
            for (const field of col.fields) {
              if (field.type === type && field.fieldId === String(fieldId)) {
                return true;
              }
            }
          }
        }
        return false;
      },

      // ========== ROW MANAGEMENT (cockpit builder pattern) ==========

      addRow(cols, insertAtIndex = null) {
        const row = {
          id: genId(),
          columns: Array.from({ length: cols }, () => ({
            width: Math.floor(12 / cols),
            fields: []
          }))
        };
        if (row.columns.length > 0) {
          const remainder = 12 - row.columns.reduce((s, c) => s + c.width, 0);
          if (remainder > 0) row.columns[row.columns.length - 1].width += remainder;
        }
        if (insertAtIndex !== null && insertAtIndex >= -1) {
          this.formLayout.rows.splice(insertAtIndex + 1, 0, row);
        } else {
          this.formLayout.rows.push(row);
        }
      },

      setRowLayout(rowId, widths) {
        const row = this.formLayout.rows.find(r => r.id === rowId);
        if (!row) return;
        
        // Collect all existing fields from all columns
        const allFields = [];
        row.columns.forEach(col => {
          col.fields.forEach(f => allFields.push({ ...f }));
        });

        // Create new columns with specified widths
        const newColumns = widths.map(w => ({ width: w, fields: [] }));
        
        // Distribute existing fields across new columns
        allFields.forEach((field, i) => {
          const colIdx = i % newColumns.length;
          newColumns[colIdx].fields.push(field);
        });

        row.columns = newColumns;
        this.isDirty = true;
      },

      addRowCustom(widths) {
        const columns = widths.map(w => ({ width: w, fields: [] }));
        const row = { id: genId(), columns };
        this.formLayout.rows.push(row);
        this.isDirty = true;
      },

      moveRow(index, direction) {
        const newIndex = index + direction;
        if (newIndex < 0 || newIndex >= this.formLayout.rows.length) return;
        const rows = this.formLayout.rows;
        [rows[index], rows[newIndex]] = [rows[newIndex], rows[index]];
      },

      duplicateRow(index) {
        const original = this.formLayout.rows[index];
        const clone = JSON.parse(JSON.stringify(original));
        clone.id = genId();
        clone.columns.forEach(col => {
          col.fields.forEach(f => { f.id = genId(); });
        });
        this.formLayout.rows.splice(index + 1, 0, clone);
      },

      deleteRow(index) {
        this.formLayout.rows.splice(index, 1);
      },

      // ========== FIELD MANAGEMENT ==========

      selectField(fieldId) {
        if (this.builderState.selectedFieldId === fieldId) {
          this.builderState.selectedFieldId = null;
          if (this.builderState.drawerMode === 'field-settings') {
            this.builderState.drawerMode = 'fields';
          }
        } else {
          this.builderState.selectedFieldId = fieldId;
          this.builderState.drawerMode = 'field-settings';
          this.builderState.sidebarOpen = true;
        }
      },

      openFieldSettings(fieldId) {
        this.builderState.selectedFieldId = fieldId;
        this.builderState.drawerMode = 'field-settings';
        this.builderState.sidebarOpen = true;
      },

      getSelectedField() {
        if (!this.builderState.selectedFieldId) return null;
        for (const row of this.formLayout.rows) {
          for (const col of row.columns) {
            for (const field of col.fields) {
              if (field.id === this.builderState.selectedFieldId) return field;
            }
          }
        }
        return null;
      },

      getFieldMeta(field) {
        if (!field) return null;
        if (field.type === 'standard') return this.standardFieldDefs[field.fieldId];
        if (field.type === 'custom') return this.availableCustomFields.find(f => f._id === field.fieldId);
        if (field.type === 'relation') return this.entityRelations.find(r => r.key === field.fieldId);
        if (field.type === 'classification') return this.entityClassifications.find(c => c._id === field.fieldId);
        return null;
      },

      updateFieldProperty(fieldId, key, value) {
        for (const row of this.formLayout.rows) {
          for (const col of row.columns) {
            for (const field of col.fields) {
              if (field.id === fieldId) {
                field[key] = value;
                this.isDirty = true;
                return;
              }
            }
          }
        }
      },

      removeField(rowIndex, colIndex, fieldIndex) {
        this.formLayout.rows[rowIndex].columns[colIndex].fields.splice(fieldIndex, 1);
        if (this.builderState.selectedFieldId) {
          this.builderState.selectedFieldId = null;
          if (this.builderState.drawerMode === 'field-settings') {
            this.builderState.drawerMode = 'fields';
          }
        }
      },

      removeFieldById(fieldId) {
        for (const row of this.formLayout.rows) {
          for (const col of row.columns) {
            const idx = col.fields.findIndex(f => f.id === fieldId);
            if (idx !== -1) {
              col.fields.splice(idx, 1);
              return;
            }
          }
        }
      },

      duplicateFieldInPlace(rowIndex, colIndex, fieldIndex) {
        const original = this.formLayout.rows[rowIndex].columns[colIndex].fields[fieldIndex];
        if (!original) return;
        // Only duplicate if it's not a unique-per-canvas field
        if (this.isFieldOnCanvas(original.type, original.fieldId)) {
          // For unique fields, don't duplicate — show warning
          if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'info', title: 'Champ unique', text: 'Ce champ est déjà présent sur le formulaire.', timer: 2000, showConfirmButton: false, toast: true, position: 'top-end' });
          }
          return;
        }
        const clone = JSON.parse(JSON.stringify(original));
        clone.id = genId();
        this.formLayout.rows[rowIndex].columns[colIndex].fields.splice(fieldIndex + 1, 0, clone);
      },

      // ========== AUTO-LAYOUT ==========

      autoLayout(numCols) {
        const allFields = [];
        this.formLayout.rows.forEach(row => {
          row.columns.forEach(col => {
            col.fields.forEach(f => allFields.push({ ...f }));
          });
        });
        this.enabledStandardFields.forEach(key => {
          if (!allFields.find(f => f.type === 'standard' && f.fieldId === key)) {
            allFields.push({ id: genId(), type: 'standard', fieldId: key, label: '', required: false, placeholder: '', helpText: '' });
          }
        });
        this.availableCustomFields.forEach(cf => {
          if (!allFields.find(f => f.type === 'custom' && f.fieldId === cf._id)) {
            allFields.push({ id: genId(), type: 'custom', fieldId: cf._id, label: '', required: false, placeholder: '', helpText: '' });
          }
        });
        this.entityRelations.forEach(rel => {
          if (!allFields.find(f => f.type === 'relation' && f.fieldId === rel.key)) {
            allFields.push({ id: genId(), type: 'relation', fieldId: rel.key, label: '', required: false, placeholder: '', helpText: '' });
          }
        });

        const rows = [];
        const colWidth = Math.floor(12 / numCols);
        const remainder = 12 - (colWidth * numCols);
        for (let i = 0; i < allFields.length; i += numCols) {
          const columns = [];
          for (let c = 0; c < numCols; c++) {
            const field = allFields[i + c];
            columns.push({
              width: colWidth + (c === 0 ? remainder : 0),
              fields: field ? [field] : []
            });
          }
          rows.push({ id: genId() + '_' + i, columns });
        }
        this.formLayout.rows = rows;
        this.isDirty = true;
      },

      // ========== DRAG & DROP FROM SIDEBAR ==========

      onSidebarDragStart(event, type, fieldId, label, icon) {
        if (this.isFieldOnCanvas(type, fieldId)) {
          event.preventDefault();
          return;
        }
        event.dataTransfer.setData('application/json', JSON.stringify({ type, fieldId, label, icon }));
        event.dataTransfer.effectAllowed = 'copy';
      },

      showDropIndicator(event, rowIndex, colIndex) {
        const dropZone = event.currentTarget;
        const sortableContainer = dropZone.querySelector('[data-sortable-column]');
        if (!sortableContainer) return;
        
        // Supprimer l'ancien indicateur
        dropZone.querySelectorAll('.fb-drop-indicator').forEach(el => el.remove());
        
        const fieldItems = sortableContainer.querySelectorAll('.fb-field-item');
        const dropY = event.clientY;
        
        // Créer l'indicateur
        const indicator = document.createElement('div');
        indicator.className = 'fb-drop-indicator';
        
        // Trouver la position d'insertion
        let inserted = false;
        for (let i = 0; i < fieldItems.length; i++) {
          const rect = fieldItems[i].getBoundingClientRect();
          const midY = rect.top + rect.height / 2;
          if (dropY < midY) {
            fieldItems[i].parentNode.insertBefore(indicator, fieldItems[i]);
            inserted = true;
            break;
          }
        }
        if (!inserted) {
          sortableContainer.appendChild(indicator);
        }
      },
      
      hideDropIndicator(el) {
        el.querySelectorAll('.fb-drop-indicator').forEach(ind => ind.remove());
      },

      handleCanvasDrop(event, rowIndex, colIndex) {
        const item = event.dataTransfer && event.dataTransfer.getData('application/json');
        
        let fieldType, fieldId, fieldLabel, fieldIcon;
        
        if (item) {
          try {
            const parsed = JSON.parse(item);
            fieldType = parsed.type;
            fieldId = parsed.fieldId;
            fieldLabel = parsed.label;
            fieldIcon = parsed.icon;
          } catch(e) {}
        }
        
        if (!fieldType) {
          const draggedEl = event.target.closest('[data-field-type]') || event.target;
          fieldType = draggedEl?.dataset?.fieldType;
          fieldId = draggedEl?.dataset?.fieldId;
          fieldLabel = draggedEl?.dataset?.fieldLabel;
          fieldIcon = draggedEl?.dataset?.fieldIcon;
        }
        
        if (!fieldType || !fieldId) return;
        
        if (this.isFieldOnCanvas(fieldType, fieldId)) {
          if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'warning', title: 'Champ déjà présent', text: 'Ce champ est déjà sur le formulaire.', timer: 2000, showConfirmButton: false, toast: true, position: 'top-end' });
          }
          return;
        }
        
        const newField = {
          id: genId(),
          type: fieldType,
          fieldId: fieldId,
          label: fieldLabel || '',
          required: false,
          placeholder: '',
          helpText: ''
        };
        
        // Calculer la position d'insertion basée sur clientY
        const col = this.formLayout.rows[rowIndex].columns[colIndex];
        const dropY = event.clientY;
        
        // Trouver le container sortable de cette colonne
        const dropZone = event.currentTarget;
        const sortableContainer = dropZone.querySelector('[data-sortable-column]');
        
        let insertIndex = col.fields.length; // Par défaut, à la fin
        
        if (sortableContainer) {
          const fieldItems = sortableContainer.querySelectorAll('.fb-field-item');
          for (let i = 0; i < fieldItems.length; i++) {
            const rect = fieldItems[i].getBoundingClientRect();
            const midY = rect.top + rect.height / 2;
            if (dropY < midY) {
              insertIndex = i;
              break;
            }
          }
        }
        
        col.fields.splice(insertIndex, 0, newField);
      },

      // ========== FIELD RENDERING ==========

      renderFieldPreview(field) {
        const { type, fieldId } = field;

        if (type === 'standard') {
          const def = this.standardFieldDefs[fieldId];
          if (!def) return this.renderMissingField(fieldId, 'standard');
          const label = def.label;
          const icon = def.icon || 'solar:text-bold';
          if (fieldId === 'title') {
            return `<div>
              <label class="flex items-center gap-1"><iconify-icon icon="${icon}" width="12" class="text-primary"></iconify-icon>${label}</label>
              <input type="text" class="form-input" disabled placeholder="${label}" />
            </div>`;
          }
          if (fieldId === 'description') {
            return `<div>
              <label class="flex items-center gap-1"><iconify-icon icon="${icon}" width="12" class="text-warning"></iconify-icon>${label}</label>
              <textarea class="form-textarea" disabled placeholder="${label}"></textarea>
            </div>`;
          }
          return `<div>
            <label class="flex items-center gap-1"><iconify-icon icon="${icon}" width="12"></iconify-icon>${label}</label>
            <input type="${def.inputType || 'text'}" class="form-input" disabled placeholder="${label}" />
          </div>`;
        }

        if (type === 'custom') {
          const cf = this.availableCustomFields.find(f => f._id === fieldId);
          if (!cf) return this.renderMissingField(fieldId, 'custom');
          const label = field.label || cf.label || cf.name;
          const icon = cf.ui?.icon || 'solar:widget-bold-duotone';
          if (cf.htmlTemplate) {
            const rendered = cf.htmlTemplate
              .replace(/\{\{\s*label\s*\}\}/g, label)
              .replace(/\{\{\s*name\s*\}\}/g, cf.name || '')
              .replace(/\{\{\s*placeholder\s*\}\}/g, field.placeholder || label)
              .replace(/\{\{\s*required\s*\}\}/g, field.required ? 'required' : '');
            return rendered;
          }
          return `<div>
            <label class="flex items-center gap-1"><iconify-icon icon="${icon}" width="12" class="text-info"></iconify-icon>${label}</label>
            <input type="text" class="form-input" disabled placeholder="${field.placeholder || label}" />
          </div>`;
        }

        if (type === 'relation') {
          const rel = this.entityRelations.find(r => r.key === fieldId);
          if (!rel) return this.renderMissingField(fieldId, 'relation');
          const label = field.label || rel.label || 'Relation';
          const icon = rel.targetEntity?.icon || 'solar:link-round-bold-duotone';
          const color = rel.targetEntity?.color || '#4361ee';
          const cardinality = rel.cardinality === 'one-to-one' ? '1:1' : rel.cardinality === 'one-to-many' ? '1:N' : 'N:N';
          const inputIcon = rel.inputMode === 'select' ? 'solar:alt-arrow-down-bold' : 'solar:magnifer-bold';
          return `<div>
            <label class="flex items-center gap-1.5">
              <iconify-icon icon="${icon}" width="12" style="color:${color}"></iconify-icon>
              ${label}
              <span class="ml-auto text-[9px] font-normal text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded">${cardinality}</span>
            </label>
            <div class="h-[38px] flex items-center px-3 bg-gray-50 border border-gray-100 rounded-lg text-xs text-gray-400" style="border-color:${color}20">
              <iconify-icon icon="${inputIcon}" width="14" class="mr-2" style="color:${color}"></iconify-icon>
              Rechercher ${rel.targetEntity?.name || ''}...
            </div>
          </div>`;
        }

        if (type === 'classification') {
          const cls = this.entityClassifications.find(c => c._id === fieldId);
          if (!cls) return this.renderMissingField(fieldId, 'classification');
          const label = field.label || cls.name;
          return `<div>
            <label class="flex items-center gap-1"><iconify-icon icon="solar:tag-bold-duotone" width="12" class="text-success"></iconify-icon>${label}</label>
            <div class="h-[38px] flex items-center px-3 bg-gray-50 border border-gray-100 rounded-lg text-xs text-gray-400">
              <iconify-icon icon="solar:alt-arrow-down-bold" width="14" class="mr-2"></iconify-icon>
              Sélectionner...
            </div>
          </div>`;
        }

        return this.renderMissingField(fieldId, type);
      },

      renderMissingField(fieldId, type) {
        return `<div class="flex items-center gap-2 p-2 bg-red-50 border border-red-200 rounded-lg text-xs text-red-500">
          <iconify-icon icon="solar:danger-triangle-bold" width="16"></iconify-icon>
          <span>Champ introuvable (${type}: ${fieldId})</span>
        </div>`;
      },

      // ========== PREVIEW FIELD RENDERING ==========

      renderPreviewField(field) {
        const { type, fieldId } = field;

        if (type === 'standard') {
          const def = this.standardFieldDefs[fieldId];
          if (!def) return '';
          const label = def.label;
          const req = field.required ? '<span class="text-danger ml-0.5">*</span>' : '';
          if (fieldId === 'title') {
            return `<div><label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label><input type="text" class="form-input w-full" placeholder="Entrez le titre" /></div>`;
          }
          if (fieldId === 'description') {
            return `<div><label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label><textarea class="form-textarea w-full" rows="3" placeholder="Entrez la description"></textarea></div>`;
          }
          return `<div><label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label><input type="${def.inputType || 'text'}" class="form-input w-full" placeholder="${label}" /></div>`;
        }

        if (type === 'custom') {
          const cf = this.availableCustomFields.find(f => f._id === fieldId);
          if (!cf) return this.renderMissingField(fieldId, 'custom');
          const label = field.label || cf.label || cf.name;
          const req = field.required ? '<span class="text-danger ml-0.5">*</span>' : '';
          const inputType = cf.inputType || cf.type || 'text';
          if (inputType === 'textarea' || inputType === 'richtext') {
            return `<div><label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label><textarea class="form-textarea w-full" rows="3" placeholder="${label}"></textarea></div>`;
          }
          if (inputType === 'select' && cf.options?.length) {
            const opts = cf.options.map(o => `<option>${o.label || o}</option>`).join('');
            return `<div><label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label><select class="form-select w-full"><option value="">-- Choisir --</option>${opts}</select></div>`;
          }
          return `<div><label class="text-xs font-semibold text-gray-600 mb-1 block">${label}${req}</label><input type="${inputType}" class="form-input w-full" placeholder="${label}" /></div>`;
        }

        if (type === 'relation') {
          const rel = this.entityRelations.find(r => r.key === fieldId);
          if (!rel) return this.renderMissingField(fieldId, 'relation');
          const label = field.label || rel.label || 'Relation';
          const color = rel.targetEntity?.color || '#4361ee';
          const icon = rel.targetEntity?.icon || 'solar:link-round-bold-duotone';
          return `<div>
            <label class="text-xs font-semibold text-gray-600 mb-1 flex items-center gap-1.5"><iconify-icon icon="${icon}" width="14" style="color:${color}"></iconify-icon>${label}</label>
            <div class="form-input w-full flex items-center gap-2 text-gray-400 text-sm" style="border-color:${color}30"><iconify-icon icon="solar:magnifer-bold" width="14" style="color:${color}"></iconify-icon>Rechercher ${rel.targetEntity?.name || ''}...</div>
          </div>`;
        }

        if (type === 'classification') {
          const cls = this.entityClassifications.find(c => c._id === fieldId);
          if (!cls) return this.renderMissingField(fieldId, 'classification');
          const label = field.label || cls.name;
          return `<div>
            <label class="text-xs font-semibold text-gray-600 mb-1 flex items-center gap-1.5"><iconify-icon icon="solar:tag-bold-duotone" width="14" class="text-success"></iconify-icon>${label}</label>
            <select class="form-select w-full"><option value="">-- Sélectionner --</option>${(cls.options || []).map(o => `<option>${o.label}</option>`).join('')}</select>
          </div>`;
        }

        return this.renderMissingField(fieldId, type);
      },

      // ========== SORTABLE (Total DOM Sync pattern) ==========

      initSortableColumn(el, rowId, colIndex) {
        const self = this;

        Sortable.create(el, {
          group: { name: 'form-fields', pull: true, put: true },
          animation: 150,
          ghostClass: 'fb-sortable-ghost',
          dragClass: 'fb-sortable-drag',
          handle: '.fb-field-item',
          draggable: '.fb-field-item',
          swapThreshold: 0.65,
          onAdd(evt) {
            // Handle cloned items from sidebar
            const item = evt.item;
            const fieldType = item.dataset.fieldType;
            const fieldId = item.dataset.fieldId;
            const fieldLabel = item.dataset.fieldLabel || '';
            const fieldIcon = item.dataset.fieldIcon || '';
            const insertIdx = evt.newIndex;
            
            // Toujours supprimer le clone DOM — Alpine gère le rendu
            item.remove();
            
            if (!fieldType || !fieldId) return;
            
            // Vérifier si déjà sur le canvas
            if (self.isFieldOnCanvas(fieldType, fieldId)) {
              if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'warning', title: 'Champ déjà présent', text: 'Ce champ est déjà sur le formulaire.', timer: 2000, showConfirmButton: false, toast: true, position: 'top-end' });
              }
              return;
            }
            
            // Trouver la colonne cible
            const row = self.formLayout.rows.find(r => r.id === rowId);
            if (!row) return;
            const col = row.columns[colIndex];
            if (!col) return;
            
            // Créer le nouveau field
            const newField = {
              id: genId(),
              type: fieldType,
              fieldId: fieldId,
              label: fieldLabel,
              required: false,
              placeholder: '',
              helpText: ''
            };
            
            col.fields.splice(insertIdx, 0, newField);
            self.isDirty = true;
          },
          onEnd(evt) {
            // === 1. Capturer les références ===
            const fieldId = evt.item.dataset.fieldId;
            console.log('[DnD] onEnd fired', { fieldId, oldIndex: evt.oldIndex, newIndex: evt.newIndex });
            console.log('[DnD] from:', evt.from.dataset.rowId, 'col', evt.from.dataset.colIndex);
            console.log('[DnD] to:', evt.to.dataset.rowId, 'col', evt.to.dataset.colIndex);
            if (!fieldId) { console.log('[DnD] No fieldId, abort'); return; }
            
            const fromRowId = evt.from.dataset.rowId;
            const fromColIdx = parseInt(evt.from.dataset.colIndex);
            const toRowId = evt.to.dataset.rowId;
            const toColIdx = parseInt(evt.to.dataset.colIndex);
            const newIdx = evt.newIndex;
            
            if (fromRowId === toRowId && fromColIdx === toColIdx && evt.oldIndex === newIdx) {
              console.log('[DnD] No change, skip');
              return;
            }
            
            // === 2. Trouver le field par ID ===
            const fromRow = self.formLayout.rows.find(r => r.id === fromRowId);
            const toRow = self.formLayout.rows.find(r => r.id === toRowId);
            console.log('[DnD] fromRow found:', !!fromRow, 'toRow found:', !!toRow);
            if (!fromRow || !toRow) return;
            
            const fromCol = fromRow.columns[fromColIdx];
            const toCol = toRow.columns[toColIdx];
            console.log('[DnD] fromCol found:', !!fromCol, 'fields:', fromCol?.fields?.length);
            console.log('[DnD] toCol found:', !!toCol, 'fields:', toCol?.fields?.length);
            if (!fromCol || !toCol) return;
            
            const fieldIndex = fromCol.fields.findIndex(f => f.id === fieldId);
            console.log('[DnD] fieldIndex in source:', fieldIndex);
            if (fieldIndex === -1) return;
            
            const [movedField] = fromCol.fields.splice(fieldIndex, 1);
            
            // === 3. ANNULER le move DOM de Sortable ===
            if (evt.from !== evt.to) {
              evt.item.remove();
              evt.from.appendChild(evt.item);
            } else {
              const items = Array.from(evt.from.querySelectorAll('.fb-field-item'));
              const refItem = items[evt.oldIndex] || null;
              if (refItem) {
                evt.from.insertBefore(evt.item, refItem);
              }
            }
            
            // === 4. Insérer dans la colonne cible ===
            console.log('[DnD] Inserting at index', newIdx, 'into toCol with', toCol.fields.length, 'fields');
            toCol.fields.splice(newIdx, 0, movedField);
            console.log('[DnD] Done! fromCol now:', fromCol.fields.length, 'toCol now:', toCol.fields.length);
            
            self.isDirty = true;
          }
        });
      },

      // Legacy stubs
      initSortables() {},
      initRowSortable() {},

      // ========== COLUMN RESIZE ==========

      startResize(event, rowIndex, colIndex) {
        event.preventDefault();
        const row = this.formLayout.rows[rowIndex];
        const rowEl = event.target.closest('[data-row-id]');
        if (!rowEl) return;
        const gridEl = rowEl.querySelector('.grid');
        if (!gridEl) return;
        const gridWidth = gridEl.getBoundingClientRect().width;
        const startX = event.clientX;
        const leftCol = row.columns[colIndex];
        const rightCol = row.columns[colIndex + 1];
        const startLeftW = leftCol.width;
        const startRightW = rightCol.width;
        const unitWidth = gridWidth / row.columns.reduce((s, c) => s + c.width, 0);

        this.resizing = { rowIndex, colIndex };

        const onMove = (e) => {
          const deltaX = e.clientX - startX;
          const deltaUnits = Math.round(deltaX / unitWidth);
          const newLeft = Math.max(2, Math.min(startLeftW + startRightW - 2, startLeftW + deltaUnits));
          const newRight = startLeftW + startRightW - newLeft;
          leftCol.width = newLeft;
          rightCol.width = newRight;
        };
        const onUp = () => {
          this.resizing = null;
          this.isDirty = true;
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
        };
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      },

      // ========== SAVE ==========

      async saveForm() {
        this.isSaving = true;
        try {
          let url, body;
          
          if (this.formId) {
            url = `/account/${this.accountNumber}/entity/${this.entityId}/forms/api/update/${this.formId}`;
            body = { name: this.formName, layout: this.formLayout };
          } else {
            url = `/account/${this.accountNumber}/entity/${this.entityId}/forms/api/save`;
            body = { name: this.formName, layout: this.formLayout };
          }

          const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          });
          
          if (res.ok) {
            const result = await res.json();
            
            if (!this.formId && result.form && result.form._id) {
              this.formId = result.form._id;
              history.replaceState(null, '', `/account/${this.accountNumber}/entity/${this.entityId}/forms/${this.formId}/edit`);
            }

            this.isDirty = false;
            Swal.fire({
              icon: 'success',
              title: 'Formulaire sauvegardé',
              showConfirmButton: false,
              timer: 1000,
              toast: true,
              position: 'top-end'
            });
          } else {
            throw new Error('Save failed');
          }
        } catch (e) {
          Swal.fire({ icon: 'error', title: 'Erreur', text: e.message });
        } finally {
          this.isSaving = false;
        }
      },

      // ========== PUBLISH ==========

      async publishForm() {
        await this.saveForm();
        if (this.isDirty) return;
        if (!this.formId) return;

        this.isPublishing = true;
        try {
          const res = await fetch(`/account/${this.accountNumber}/entity/${this.entityId}/forms/api/publish/${this.formId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ layout: this.formLayout })
          });
          
          if (res.ok) {
            this.formStatus = 'published';
            Swal.fire({
              icon: 'success',
              title: 'Formulaire publié !',
              text: 'Ce formulaire est maintenant disponible pour la création de records.',
              showConfirmButton: false,
              timer: 1500,
              toast: true,
              position: 'top-end'
            });
          } else {
            throw new Error('Publish failed');
          }
        } catch (e) {
          Swal.fire({ icon: 'error', title: 'Erreur de publication', text: e.message });
        } finally {
          this.isPublishing = false;
        }
      }
    };
  });
});
</script>
