<%# ═══════════════════════════════════════════════════════════════════
    Tableau Dynamique Panel — Mission 10
    Dynamic line table for records (invoices, prescriptions, etc.)
    ═══════════════════════════════════════════════════════════════════ %>

<style>
    /* ── Lines Panel Styles ───────────────────────────────── */
    .lines-panel-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    .lines-panel-table th {
        background: #f8f9fa;
        padding: 6px 8px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        border-bottom: 2px solid #e5e7eb;
        text-align: left;
        white-space: nowrap;
        user-select: none;
    }
    .dark .lines-panel-table th {
        background: #1b2e4b;
        color: #888ea8;
        border-color: #253b5c;
    }
    .lines-panel-table td {
        padding: 4px 6px;
        border-bottom: 1px solid #f0f0f0;
        vertical-align: middle;
    }
    .dark .lines-panel-table td {
        border-color: #1b2e4b;
    }
    .lines-panel-table tbody tr:hover {
        background: rgba(67, 97, 238, 0.03);
    }
    .dark .lines-panel-table tbody tr:hover {
        background: rgba(67, 97, 238, 0.06);
    }
    .lines-panel-table .lp-input {
        width: 100%;
        border: 1px solid transparent;
        border-radius: 6px;
        padding: 5px 8px;
        font-size: 12px;
        background: transparent;
        transition: all 0.15s;
        color: inherit;
    }
    .lines-panel-table .lp-input:hover {
        border-color: #e5e7eb;
        background: #fafbfc;
    }
    .dark .lines-panel-table .lp-input:hover {
        border-color: #253b5c;
        background: #0e1726;
    }
    .lines-panel-table .lp-input:focus {
        outline: none;
        border-color: #4361ee;
        background: #fff;
        box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.1);
    }
    .dark .lines-panel-table .lp-input:focus {
        background: #0e1726;
    }
    .lines-panel-table select.lp-input {
        cursor: pointer;
        padding-right: 20px;
    }
    /* Formula / computed cells */
    .lp-computed {
        font-weight: 600;
        color: #4361ee;
        font-size: 12px;
        text-align: right;
        padding: 5px 8px;
    }
    .dark .lp-computed {
        color: #6993ff;
    }
    /* Drag handle */
    .lp-drag-handle {
        cursor: grab;
        color: #d1d5db;
        transition: color 0.15s;
        padding: 2px;
    }
    .lp-drag-handle:active { cursor: grabbing; }
    .lp-drag-handle:hover { color: #6b7280; }
    .dark .lp-drag-handle { color: #3b4a5e; }
    .dark .lp-drag-handle:hover { color: #888ea8; }
    /* Row action buttons */
    .lp-row-actions {
        display: flex; gap: 2px; align-items: center;
        opacity: 0; transition: opacity 0.15s;
    }
    .lines-panel-table tbody tr:hover .lp-row-actions { opacity: 1; }
    .lp-row-btn {
        padding: 3px; border-radius: 4px; border: none;
        background: transparent; cursor: pointer; line-height: 1;
        transition: background 0.12s, color 0.12s;
    }
    .lp-row-btn.edit { color: #6b7280; }
    .lp-row-btn.edit:hover { color: #4361ee; background: rgba(67, 97, 238, 0.08); }
    .dark .lp-row-btn.edit { color: #888ea8; }
    .dark .lp-row-btn.edit:hover { color: #6993ff; background: rgba(67, 97, 238, 0.15); }
    .lp-row-btn.delete { color: #ef4444; }
    .lp-row-btn.delete:hover { background: rgba(239, 68, 68, 0.08); }
    /* Relation search dropdown */
    .lp-relation-wrap { position: relative; }
    .lp-relation-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 9999;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        max-height: 180px;
        overflow-y: auto;
        margin-top: 2px;
    }
    .dark .lp-relation-dropdown {
        background: #0e1726;
        border-color: #253b5c;
    }
    .lp-relation-dropdown .lp-rel-item {
        padding: 6px 10px;
        font-size: 12px;
        cursor: pointer;
        transition: background 0.1s;
    }
    .lp-relation-dropdown .lp-rel-item:hover {
        background: rgba(67, 97, 238, 0.08);
    }
    /* Totals row */
    .lp-totals-bar {
        display: flex;
        justify-content: flex-end;
        gap: 24px;
        padding: 10px 12px;
        background: #f8f9fa;
        border-top: 2px solid #e5e7eb;
        border-radius: 0 0 8px 8px;
        font-size: 12px;
    }
    .dark .lp-totals-bar {
        background: #1b2e4b;
        border-color: #253b5c;
    }
    .lp-totals-bar .lp-total-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .lp-totals-bar .lp-total-label {
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        font-size: 10px;
        letter-spacing: 0.05em;
    }
    .dark .lp-totals-bar .lp-total-label { color: #888ea8; }
    .lp-totals-bar .lp-total-value {
        font-weight: 700;
        font-size: 14px;
        color: #1f2937;
    }
    .dark .lp-totals-bar .lp-total-value { color: #e0e6ed; }
    /* Width classes */
    .lp-w-xs { min-width: 50px; max-width: 70px; }
    .lp-w-s  { min-width: 70px; max-width: 100px; }
    .lp-w-m  { min-width: 120px; }
    .lp-w-l  { min-width: 180px; }
    .lp-w-xl { min-width: 240px; }
    /* Schema selector */
    .lp-schema-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid #e5e7eb;
        color: #6b7280;
        background: #fff;
        transition: all 0.15s;
    }
    .dark .lp-schema-pill {
        border-color: #253b5c;
        background: #0e1726;
        color: #888ea8;
    }
    .lp-schema-pill:hover, .lp-schema-pill.active {
        border-color: #4361ee;
        color: #4361ee;
        background: rgba(67, 97, 238, 0.06);
    }
    .lp-schema-pill.active {
        background: rgba(67, 97, 238, 0.1);
    }
    /* Multiselect tags */
    .lp-ms-tag {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 1px 6px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 600;
        background: rgba(67, 97, 238, 0.1);
        color: #4361ee;
        margin: 1px;
    }
    .lp-ms-tag .lp-ms-tag-x {
        cursor: pointer;
        font-size: 12px;
        line-height: 1;
        opacity: 0.6;
    }
    .lp-ms-tag .lp-ms-tag-x:hover { opacity: 1; }
    /* Add row button area */
    .lp-add-row-area {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        border-top: 1px dashed #e5e7eb;
        cursor: pointer;
        color: #9ca3af;
        font-size: 12px;
        transition: all 0.15s;
        gap: 6px;
    }
    .dark .lp-add-row-area { border-color: #1b2e4b; color: #4a5568; }
    .lp-add-row-area:hover {
        background: rgba(67, 97, 238, 0.04);
        color: #4361ee;
    }
    /* Sortable ghost */
    .lines-panel-table .sortable-ghost { opacity: 0.3; }
    .lines-panel-table .sortable-chosen { background: rgba(67, 97, 238, 0.05); }

    /* ── Add Lines Modal ─────────────────────────────── */
    .lp-modal-overlay {
        position: fixed; inset: 0; z-index: 9999;
        background: rgba(0,0,0,0.45);
        display: flex; align-items: center; justify-content: center;
        animation: lp-fade-in 0.15s ease;
    }
    @keyframes lp-fade-in { from { opacity: 0; } to { opacity: 1; } }
    .lp-modal {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        width: 680px;
        max-width: 95vw;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        animation: lp-slide-up 0.2s ease;
        overflow: hidden;
    }
    .dark .lp-modal { background: #0e1726; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
    @keyframes lp-slide-up { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .lp-modal-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 20px; border-bottom: 1px solid #e5e7eb;
    }
    .dark .lp-modal-header { border-color: #253b5c; }
    .lp-modal-header h3 {
        font-size: 15px; font-weight: 700; color: #1f2937; margin: 0;
        display: flex; align-items: center; gap: 8px;
    }
    .dark .lp-modal-header h3 { color: #e0e6ed; }
    .lp-modal-close {
        width: 28px; height: 28px; border-radius: 8px; border: none;
        background: transparent; cursor: pointer; color: #9ca3af;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s;
    }
    .lp-modal-close:hover { background: #f3f4f6; color: #374151; }
    .dark .lp-modal-close:hover { background: #1b2e4b; color: #e0e6ed; }
    .lp-modal-search {
        padding: 12px 20px; border-bottom: 1px solid #e5e7eb;
    }
    .dark .lp-modal-search { border-color: #253b5c; }
    .lp-modal-search-input {
        width: 100%; padding: 10px 12px 10px 40px !important; border-radius: 10px;
        border: 1.5px solid #e5e7eb; font-size: 13px; background: #f8f9fa;
        transition: all 0.15s; color: inherit;
    }
    .dark .lp-modal-search-input { background: #1b2e4b; border-color: #253b5c; color: #e0e6ed; }
    .lp-modal-search-input:focus {
        outline: none; border-color: #4361ee; background: #fff;
        box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
    }
    .dark .lp-modal-search-input:focus { background: #0e1726; }
    .lp-modal-search-wrap {
        position: relative;
    }
    .lp-modal-search-wrap .lp-search-icon {
        position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
        color: #9ca3af; pointer-events: none; z-index: 1;
        display: flex; align-items: center; justify-content: center;
    }
    /* Manual add section */
    .lp-manual-add {
        padding: 8px 20px 12px; border-bottom: 1px solid #e5e7eb;
    }
    .dark .lp-manual-add { border-color: #253b5c; }
    .lp-manual-add-label {
        font-size: 11px; color: #6b7280; margin-bottom: 6px; display: flex; align-items: center; gap: 4px;
    }
    .dark .lp-manual-add-label { color: #9ca3af; }
    .lp-manual-add-row {
        display: flex; gap: 6px; position: relative;
    }
    .lp-manual-add-input {
        flex: 1; padding: 8px 12px; border-radius: 8px;
        border: 1.5px solid #e5e7eb; font-size: 13px; background: #fff;
        transition: all 0.15s; color: inherit;
    }
    .dark .lp-manual-add-input { background: #1b2e4b; border-color: #253b5c; color: #e0e6ed; }
    .lp-manual-add-input:focus {
        outline: none; border-color: #4361ee; background: #fff;
        box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
    }
    .dark .lp-manual-add-input:focus { background: #0e1726; }
    .lp-manual-add-btn {
        width: 36px; height: 36px; border-radius: 8px; border: none;
        background: #4361ee; color: #fff; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s; flex-shrink: 0;
    }
    .lp-manual-add-btn:hover { background: #3651d4; transform: scale(1.05); }
    .lp-manual-add-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
    .lp-manual-autocomplete {
        position: absolute; top: 100%; left: 0; right: 42px; z-index: 10;
        background: #fff; border: 1px solid #e5e7eb; border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1); max-height: 180px; overflow-y: auto;
        margin-top: 4px;
    }
    .dark .lp-manual-autocomplete { background: #0e1726; border-color: #253b5c; }
    .lp-manual-autocomplete-item {
        padding: 8px 12px; font-size: 12px; cursor: pointer;
        border-bottom: 1px solid #f3f4f6; transition: background 0.1s;
        display: flex; align-items: center; gap: 8px;
    }
    .dark .lp-manual-autocomplete-item { border-color: #1b2e4b; }
    .lp-manual-autocomplete-item:hover { background: rgba(67, 97, 238, 0.06); }
    .lp-manual-autocomplete-item:last-child { border-bottom: none; }
    .lp-manual-autocomplete-item .lp-ac-title {
        font-weight: 500; color: #1f2937;
    }
    .dark .lp-manual-autocomplete-item .lp-ac-title { color: #e0e6ed; }
    .lp-manual-autocomplete-item .lp-ac-desc {
        font-size: 11px; color: #9ca3af;
    }
    .lp-modal-body {
        flex: 1; overflow-y: auto; padding: 0;
        min-height: 200px;
    }
    .lp-modal-empty {
        padding: 40px 20px; text-align: center; color: #9ca3af;
    }
    .lp-modal-empty iconify-icon { display: block; margin: 0 auto 8px; opacity: 0.5; }
    .lp-catalog-item {
        display: flex; align-items: flex-start; gap: 10px;
        padding: 10px 20px;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.1s;
        cursor: pointer;
    }
    .dark .lp-catalog-item { border-color: #1b2e4b; }
    .lp-catalog-item:hover { background: rgba(67, 97, 238, 0.03); }
    .lp-catalog-item.selected { background: rgba(67, 97, 238, 0.06); }
    .dark .lp-catalog-item.selected { background: rgba(67, 97, 238, 0.12); }
    .lp-catalog-check {
        width: 18px; height: 18px; border-radius: 5px;
        border: 2px solid #d1d5db; background: #fff;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s; flex-shrink: 0; margin-top: 2px;
    }
    .dark .lp-catalog-check { border-color: #3b4a5e; background: #1b2e4b; }
    .lp-catalog-item.selected .lp-catalog-check {
        background: #4361ee; border-color: #4361ee;
    }
    .lp-catalog-info { flex: 1; min-width: 0; }
    .lp-catalog-title {
        font-size: 13px; font-weight: 600; color: #1f2937;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .dark .lp-catalog-title { color: #e0e6ed; }
    .lp-catalog-sub {
        font-size: 11px; color: #9ca3af; margin-top: 2px;
    }
    /* Selected item config form */
    .lp-config-fields {
        display: flex; flex-direction: column; gap: 6px; margin-top: 8px;
        padding: 8px 10px; background: rgba(67, 97, 238, 0.03);
        border-radius: 8px; border: 1px solid rgba(67, 97, 238, 0.08);
    }
    .dark .lp-config-fields {
        background: rgba(67, 97, 238, 0.05);
        border-color: rgba(67, 97, 238, 0.1);
    }
    .lp-config-field {
        display: flex; align-items: flex-start; gap: 8px;
    }
    .lp-config-field label {
        font-size: 10px; font-weight: 600; color: #6b7280;
        text-transform: uppercase; letter-spacing: 0.03em;
        white-space: nowrap; min-width: 55px; padding-top: 4px;
    }
    .dark .lp-config-field label { color: #888ea8; }
    .lp-config-field input, .lp-config-field select {
        border: 1px solid #e5e7eb; border-radius: 6px;
        padding: 4px 6px; font-size: 12px; background: #fff;
        color: inherit; min-width: 50px;
    }
    .dark .lp-config-field input, .dark .lp-config-field select {
        background: #0e1726; border-color: #253b5c; color: #e0e6ed;
    }
    .lp-config-field input:focus, .lp-config-field select:focus {
        outline: none; border-color: #4361ee;
    }
    .lp-config-field input[type="number"] { width: 60px; text-align: right; }
    .lp-modal-footer {
        padding: 12px 20px; border-top: 1px solid #e5e7eb;
        display: flex; align-items: center; justify-content: space-between;
    }
    .dark .lp-modal-footer { border-color: #253b5c; }
    .lp-modal-footer .lp-sel-count {
        font-size: 12px; color: #6b7280; font-weight: 600;
    }
    .dark .lp-modal-footer .lp-sel-count { color: #888ea8; }
    .lp-modal-footer .lp-btn-add {
        padding: 8px 24px; border-radius: 10px; border: none;
        background: #4361ee; color: #fff; font-size: 13px;
        font-weight: 600; cursor: pointer; transition: all 0.15s;
        display: flex; align-items: center; gap: 6px;
    }
    .lp-modal-footer .lp-btn-add:hover { background: #3651d4; }
    .lp-modal-footer .lp-btn-add:disabled {
        opacity: 0.4; cursor: not-allowed;
    }
    .lp-modal-footer .lp-btn-cancel {
        padding: 8px 16px; border-radius: 10px;
        border: 1px solid #e5e7eb; background: transparent;
        color: #6b7280; font-size: 13px; font-weight: 500;
        cursor: pointer; transition: all 0.15s;
    }
    .dark .lp-modal-footer .lp-btn-cancel { border-color: #253b5c; color: #888ea8; }
    .lp-modal-footer .lp-btn-cancel:hover { background: #f3f4f6; }
    .dark .lp-modal-footer .lp-btn-cancel:hover { background: #1b2e4b; }

    /* Multiselect toggle pills (add modal) */
    .lp-multi-pills {
        display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px;
    }
    .lp-pill {
        padding: 3px 10px; border-radius: 20px; border: 1.5px solid #e5e7eb;
        background: transparent; font-size: 11px; font-weight: 500;
        color: #6b7280; cursor: pointer; transition: all 0.15s;
        white-space: nowrap; line-height: 1.4;
    }
    .dark .lp-pill { border-color: #253b5c; color: #888ea8; }
    .lp-pill:hover { border-color: #4361ee; color: #4361ee; }
    .lp-pill.active {
        background: rgba(67, 97, 238, 0.12); border-color: #4361ee;
        color: #4361ee; font-weight: 600;
    }
    .dark .lp-pill.active {
        background: rgba(67, 97, 238, 0.2); border-color: #6993ff; color: #6993ff;
    }

    /* ── Inline multiselect tag-picker ── */
    .lp-ms-wrap {
        position: relative;
        min-width: 100px;
    }
    .lp-ms-trigger {
        display: flex;
        flex-wrap: wrap;
        gap: 3px;
        padding: 3px 6px;
        min-height: 28px;
        border: 1px solid transparent;
        border-radius: 6px;
        cursor: pointer;
        transition: border-color 0.15s;
        align-items: center;
    }
    .lp-ms-trigger:hover {
        border-color: #d1d5db;
    }
    .dark .lp-ms-trigger:hover {
        border-color: #334155;
    }
    .lp-ms-placeholder {
        font-size: 11px;
        color: #9ca3af;
        font-style: italic;
    }
    .lp-ms-dropdown {
        position: fixed;
        min-width: 200px;
        max-width: 280px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.06);
        z-index: 9999;
        overflow: hidden;
    }
    .dark .lp-ms-dropdown {
        background: #0e1726;
        border-color: #334155;
    }

    /* ═══════════════════════════════════════════════════════════
       DataGrid Mode: FORM (timeseries cards)
       ═══════════════════════════════════════════════════════════ */
    .dg-form-entries {
        display: flex; flex-direction: column; gap: 8px;
        padding: 10px 12px;
    }
    .dg-form-entry {
        border: 1px solid #e5e7eb; border-radius: 10px;
        background: #fff; padding: 10px 14px;
        transition: all 0.15s; position: relative;
    }
    .dark .dg-form-entry { background: #0e1726; border-color: #253b5c; }
    .dg-form-entry:hover { border-color: #d1d5db; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
    .dark .dg-form-entry:hover { border-color: #3b4a5e; }
    .dg-form-entry-date {
        font-size: 11px; font-weight: 700; color: #4361ee;
        display: flex; align-items: center; gap: 6px;
        margin-bottom: 8px;
    }
    .dg-form-entry-grid {
        display: grid; gap: 6px 12px;
    }
    .dg-form-entry-field {
        display: flex; flex-direction: column; gap: 2px;
    }
    .dg-form-entry-field label {
        font-size: 10px; font-weight: 600; color: #6b7280;
        text-transform: uppercase; letter-spacing: 0.03em;
    }
    .dark .dg-form-entry-field label { color: #888ea8; }
    .dg-form-entry-field .dg-value {
        font-size: 13px; font-weight: 500; color: #1f2937;
        display: flex; align-items: center; gap: 4px;
    }
    .dark .dg-form-entry-field .dg-value { color: #e0e6ed; }
    .dg-form-entry-actions {
        position: absolute; top: 8px; right: 8px;
        display: flex; gap: 2px; opacity: 0; transition: opacity 0.15s;
    }
    .dg-form-entry:hover .dg-form-entry-actions { opacity: 1; }

    /* Normal range indicators */
    .dg-indicator { font-size: 11px; font-weight: 700; }
    .dg-indicator.normal { color: #22c55e; }
    .dg-indicator.high { color: #ef4444; }
    .dg-indicator.low { color: #f59e0b; }

    /* Form add panel (inline form for new entry) */
    .dg-form-add {
        border: 2px dashed #e5e7eb; border-radius: 12px;
        padding: 14px; margin: 8px 12px 12px;
        background: #fafbfc; transition: all 0.15s;
        overflow: visible;
        position: relative;
        z-index: 10;
    }
    .dark .dg-form-add { background: #1b2e4b; border-color: #253b5c; }
    .dg-form-add-grid {
        display: grid; gap: 10px 14px;
    }
    .dg-form-add .lp-input { height: 34px; font-size: 13px; }

    /* ═══════════════════════════════════════════════════════════
       DataGrid Mode: TABLE (inline spreadsheet)
       ═══════════════════════════════════════════════════════════ */
    .dg-table-cell-edit {
        position: relative;
    }
    .dg-table-cell-edit .lp-input {
        border-color: transparent !important; background: transparent !important;
        padding: 5px 6px;
    }
    .dg-table-cell-edit .lp-input:focus {
        border-color: #4361ee !important;
        background: #fff !important;
        box-shadow: 0 0 0 2px rgba(67,97,238,0.12);
    }
    .dark .dg-table-cell-edit .lp-input:focus {
        background: #0e1726 !important;
    }

    /* ═══════════════════════════════════════════════════════════
       DataGrid: Analytics Bar & Views
       ═══════════════════════════════════════════════════════════ */
    .dg-analytics-bar {
        display: flex; align-items: center; gap: 4px;
        padding: 4px 8px; background: #f8f9fa;
        border-bottom: 1px solid #e5e7eb;
    }
    .dark .dg-analytics-bar { background: #1b2e4b; border-color: #253b5c; }
    .dg-analytics-tab {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 10px; border-radius: 6px;
        font-size: 11px; font-weight: 500; color: #6b7280;
        cursor: pointer; border: none; background: transparent;
        transition: all 0.15s;
    }
    .dark .dg-analytics-tab { color: #888ea8; }
    .dg-analytics-tab:hover { background: rgba(67,97,238,0.06); color: #4361ee; }
    .dg-analytics-tab.active { background: rgba(67,97,238,0.1); color: #4361ee; font-weight: 600; }

    /* Stat cards */
    .dg-stat-cards {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 8px; padding: 12px;
    }
    .dg-stat-card {
        border: 1px solid #e5e7eb; border-radius: 10px;
        padding: 12px; background: #fff;
        display: flex; flex-direction: column; gap: 4px;
    }
    .dark .dg-stat-card { background: #0e1726; border-color: #253b5c; }
    .dg-stat-card-label {
        font-size: 10px; font-weight: 600; color: #9ca3af;
        text-transform: uppercase; letter-spacing: 0.05em;
    }
    .dg-stat-card-value {
        font-size: 20px; font-weight: 700; color: #1f2937;
        display: flex; align-items: baseline; gap: 4px;
    }
    .dark .dg-stat-card-value { color: #e0e6ed; }
    .dg-stat-card-unit {
        font-size: 11px; font-weight: 500; color: #9ca3af;
    }
    .dg-stat-card-delta {
        font-size: 11px; font-weight: 600;
        display: flex; align-items: center; gap: 2px;
    }
    .dg-stat-card-delta.positive { color: #22c55e; }
    .dg-stat-card-delta.negative { color: #ef4444; }

    /* Template picker */
    .dg-template-picker {
        padding: 16px; text-align: center;
    }
    .dg-template-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 8px; margin-top: 12px; text-align: left;
    }
    .dg-template-card {
        border: 1.5px solid #e5e7eb; border-radius: 10px;
        padding: 12px; cursor: pointer; transition: all 0.2s;
        display: flex; flex-direction: column; gap: 4px;
    }
    .dark .dg-template-card { border-color: #253b5c; }
    .dg-template-card:hover {
        border-color: #4361ee; transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(67,97,238,0.12);
    }
    .dg-template-card-icon {
        font-size: 22px; margin-bottom: 2px;
    }
    .dg-template-card-name {
        font-size: 13px; font-weight: 600; color: #1f2937;
    }
    .dark .dg-template-card-name { color: #e0e6ed; }
    .dg-template-card-desc {
        font-size: 11px; color: #9ca3af;
    }
    .dg-template-card-count {
        font-size: 10px; color: #4361ee; font-weight: 600;
    }

    /* Timeline view */
    .dg-timeline {
        padding: 12px; position: relative;
    }
    .dg-timeline::before {
        content: '';
        position: absolute; left: 24px; top: 12px; bottom: 12px;
        width: 2px; background: #e5e7eb;
    }
    .dark .dg-timeline::before { background: #253b5c; }
    .dg-timeline-item {
        display: flex; gap: 12px; margin-bottom: 12px;
        position: relative;
    }
    .dg-timeline-dot {
        width: 12px; height: 12px; border-radius: 50%;
        background: #4361ee; border: 2px solid #fff;
        flex-shrink: 0; margin-top: 4px; z-index: 1;
    }
    .dark .dg-timeline-dot { border-color: #0e1726; }
    .dg-timeline-content {
        flex: 1; border: 1px solid #e5e7eb; border-radius: 10px;
        padding: 10px 14px; background: #fff;
    }
    .dark .dg-timeline-content { background: #0e1726; border-color: #253b5c; }

    /* ═══════════════════════════════════════════════════════════
       Lines Toolbar (presets, history, create-doc)
       ═══════════════════════════════════════════════════════════ */
    .lp-toolbar {
        display: flex; align-items: center; gap: 2px;
        padding: 3px 8px;
        border-bottom: 1px solid #f0f0f0;
        background: transparent;
    }
    .dark .lp-toolbar { border-color: #1b2e4b; }
    .lp-toolbar-btn {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 3px 8px; border-radius: 6px;
        font-size: 10px; font-weight: 500; color: #6b7280;
        cursor: pointer; border: none; background: transparent;
        transition: all 0.15s; white-space: nowrap;
        position: relative;
    }
    .dark .lp-toolbar-btn { color: #888ea8; }
    .lp-toolbar-btn:hover { background: rgba(67,97,238,0.06); color: #4361ee; }
    .lp-toolbar-btn.active { background: rgba(67,97,238,0.1); color: #4361ee; font-weight: 600; }
    .lp-toolbar-sep {
        width: 1px; height: 16px; background: #e5e7eb; margin: 0 2px;
    }
    .dark .lp-toolbar-sep { background: #253b5c; }

    /* Preset dropdown panel */
    .lp-preset-dropdown {
        position: absolute; top: 100%; left: 0; z-index: 100;
        min-width: 280px; max-width: 360px;
        background: #fff; border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.06);
        margin-top: 4px; padding: 4px 0;
        overflow: hidden;
    }
    .dark .lp-preset-dropdown { background: #0e1726; border-color: #253b5c; box-shadow: 0 12px 40px rgba(0,0,0,0.4); }
    .lp-preset-section-label {
        padding: 6px 12px 2px; font-size: 9px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.08em;
        color: #9ca3af;
    }
    .dark .lp-preset-section-label { color: #4a5568; }
    .lp-preset-item {
        display: flex; align-items: center; gap: 8px;
        padding: 7px 12px; cursor: pointer;
        transition: background 0.1s; font-size: 12px;
    }
    .lp-preset-item:hover { background: rgba(67,97,238,0.06); }
    .dark .lp-preset-item:hover { background: rgba(67,97,238,0.1); }
    .lp-preset-item-icon {
        width: 26px; height: 26px; border-radius: 6px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; font-size: 14px;
    }
    .lp-preset-item-info { flex: 1; min-width: 0; }
    .lp-preset-item-name {
        font-weight: 600; color: #1f2937;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .dark .lp-preset-item-name { color: #e0e6ed; }
    .lp-preset-item-meta {
        font-size: 10px; color: #9ca3af; display: flex; align-items: center; gap: 4px;
    }
    .lp-preset-item-badge {
        font-size: 9px; font-weight: 700; padding: 1px 5px; border-radius: 10px;
        background: rgba(67,97,238,0.1); color: #4361ee;
    }
    .lp-preset-item-delete {
        opacity: 0; padding: 2px; border-radius: 4px; border: none;
        background: transparent; cursor: pointer; color: #ef4444;
        transition: all 0.12s;
    }
    .lp-preset-item:hover .lp-preset-item-delete { opacity: 1; }
    .lp-preset-item-delete:hover { background: rgba(239,68,68,0.1); }
    .lp-preset-divider {
        height: 1px; background: #f0f0f0; margin: 4px 0;
    }
    .dark .lp-preset-divider { background: #1b2e4b; }
    .lp-preset-empty {
        padding: 16px 12px; text-align: center;
        font-size: 11px; color: #9ca3af;
    }
    .lp-preset-add-btn {
        display: flex; align-items: center; gap: 6px;
        padding: 8px 12px; cursor: pointer; font-size: 11px;
        font-weight: 600; color: #4361ee;
        border-top: 1px solid #f0f0f0;
        transition: background 0.1s;
    }
    .dark .lp-preset-add-btn { border-color: #1b2e4b; color: #6993ff; }
    .lp-preset-add-btn:hover { background: rgba(67,97,238,0.04); }

    /* Save Preset Modal extras */
    .lp-save-scope-option {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 14px; border-radius: 10px; cursor: pointer;
        border: 1.5px solid #e5e7eb; transition: all 0.15s;
    }
    .dark .lp-save-scope-option { border-color: #253b5c; }
    .lp-save-scope-option:hover { border-color: #d1d5db; }
    .dark .lp-save-scope-option:hover { border-color: #3b4a5e; }
    .lp-save-scope-option.active {
        border-color: #4361ee; background: rgba(67,97,238,0.04);
    }
    .lp-save-scope-option .lp-scope-radio {
        width: 16px; height: 16px; border-radius: 50%;
        border: 2px solid #d1d5db; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s;
    }
    .dark .lp-save-scope-option .lp-scope-radio { border-color: #3b4a5e; }
    .lp-save-scope-option.active .lp-scope-radio {
        border-color: #4361ee;
    }
    .lp-save-scope-option.active .lp-scope-radio::after {
        content: ''; width: 8px; height: 8px; border-radius: 50%;
        background: #4361ee;
    }
    .lp-save-scope-info { flex: 1; }
    .lp-save-scope-title {
        font-size: 12px; font-weight: 600; color: #1f2937;
    }
    .dark .lp-save-scope-title { color: #e0e6ed; }
    .lp-save-scope-desc {
        font-size: 10px; color: #9ca3af; margin-top: 2px;
    }
    .lp-save-preview {
        border: 1px solid #e5e7eb; border-radius: 8px;
        overflow: hidden; margin-top: 12px;
    }
    .dark .lp-save-preview { border-color: #253b5c; }
    .lp-save-preview-header {
        padding: 6px 10px; background: #f8f9fa;
        font-size: 10px; font-weight: 600; color: #6b7280;
        text-transform: uppercase; letter-spacing: 0.05em;
        display: flex; align-items: center; gap: 4px;
    }
    .dark .lp-save-preview-header { background: #1b2e4b; color: #888ea8; }
    .lp-save-preview-item {
        padding: 5px 10px; font-size: 11px; color: #374151;
        border-top: 1px solid #f3f4f6;
        display: flex; align-items: center; gap: 6px;
    }
    .dark .lp-save-preview-item { color: #e0e6ed; border-color: #1b2e4b; }
    .lp-save-preview-item:first-child { border-top: none; }
</style>

<script type="application/json" id="linesPanel-relations">
<%- JSON.stringify({
    recordRelations: (locals.record && record._denorm && record._denorm.relations) || [],
    entityRelations: (locals.entity && entity.relations || []).map(r => ({ key: r.key, label: r.label, targetEntity: r.targetEntity, cardinality: r.cardinality }))
}) %>
</script>
<div data-id="lines"
    x-data="linesPanel({
        recordId: '<%= locals.record && record._id ? record._id : '' %>',
        accountNumber: '<%= account_number %>',
        entityId: '<%= locals.entity ? entity._id : '' %>'
    })"
>
    <!-- Loading state -->
    <template x-if="loading">
        <div class="panel !p-0 overflow-hidden">
            <div class="px-4 py-8 text-center">
                <iconify-icon icon="svg-spinners:ring-resize" width="24" class="text-primary"></iconify-icon>
                <p class="text-xs text-gray-400 mt-2">Chargement des tableaux dynamiques...</p>
            </div>
        </div>
    </template>

    <!-- No schemas available -->
    <template x-if="!loading && schemas.length === 0">
        <div class="panel !p-0 overflow-hidden">
            <div class="px-4 py-6 text-center">
                <iconify-icon icon="solar:document-text-linear" width="28" class="text-gray-300 dark:text-gray-600 mb-2"></iconify-icon>
                <p class="text-xs text-gray-400">Aucun tableau dynamique disponible pour cette entité</p>
            </div>
        </div>
    </template>

    <!-- Single panel with tabs when multiple schemas -->
    <template x-if="!loading && schemas.length > 0">
        <div class="panel !p-0" :style="relationSearch.open ? 'overflow: visible' : ''">
            <!-- Tab bar (shown only when multiple schemas) -->
            <div x-show="schemas.length > 1"
                 class="flex items-center gap-1 px-3 py-1.5 border-b border-gray-100 dark:border-gray-800 overflow-x-auto" style="scrollbar-width: none;">
                <template x-for="schema in schemas" :key="schema._id">
                    <button type="button"
                        class="lp-schema-pill"
                        :class="{ 'active': activeSchemaId === schema._id }"
                        @click="activeSchemaId = schema._id">
                        <iconify-icon :icon="getSchemaInputMode(schema) === 'form' ? 'solar:heart-pulse-bold-duotone' : getSchemaInputMode(schema) === 'table' ? 'solar:notebook-bold-duotone' : 'solar:document-text-bold-duotone'" width="12"></iconify-icon>
                        <span x-text="schema.label || schema.name"></span>
                        <span x-show="getSchemaLines(schema._id).length > 0" class="text-[9px] bg-success/10 text-success min-w-[14px] h-3.5 rounded-full flex items-center justify-center font-bold px-1" x-text="getSchemaLines(schema._id).length"></span>
                    </button>
                </template>
            </div>

            <!-- Schema content (one at a time) -->
            <template x-for="schema in schemas" :key="schema._id">
                <div x-show="activeSchemaId === schema._id">
                    <!-- Schema Panel Header (single schema only — tab bar replaces this when multi) -->
                    <div x-show="schemas.length === 1"
                         class="flex items-center justify-between px-3 py-2 cursor-pointer hover:bg-gray-50/50 dark:hover:bg-gray-800/30 transition-colors"
                         @click="toggleSchemaOpen(schema._id)">
                        <div class="flex items-center gap-1.5">
                            <iconify-icon :icon="getSchemaInputMode(schema) === 'form' ? 'solar:heart-pulse-bold-duotone' : getSchemaInputMode(schema) === 'table' ? 'solar:notebook-bold-duotone' : 'solar:document-text-bold-duotone'" width="14" class="text-success"></iconify-icon>
                            <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400" x-text="schema.name"></span>
                            <span x-show="getSchemaLines(schema._id).length > 0" class="text-[9px] bg-success/10 text-success min-w-[16px] h-4 rounded-full flex items-center justify-center font-bold px-1" x-text="getSchemaLines(schema._id).length"></span>
                        </div>
                        <div class="flex items-center gap-1">
                            <!-- Template picker button (shown when templates available) -->
                            <button x-show="getTemplatesForSchema(schema._id).length > 0"
                                    @click.stop="activeSchemaId = schema._id; templatePicker[schema._id] = !templatePicker[schema._id]"
                                    class="dg-analytics-tab" :class="{ 'active': templatePicker[schema._id] }"
                                    style="padding: 2px 6px; font-size: 10px;" title="Modèles">
                                <iconify-icon icon="solar:clipboard-list-bold-duotone" width="12"></iconify-icon>
                                <span x-text="getTemplatesForSchema(schema._id).length" class="text-[9px]"></span>
                            </button>
                            <iconify-icon icon="solar:alt-arrow-down-bold" width="12" :class="isSchemaOpen(schema._id) ? '' : '-rotate-90'" class="transition-transform text-gray-300"></iconify-icon>
                        </div>
                    </div>

                    <!-- Schema Body (always open when multi-tab, toggle when single) -->
                    <div x-show="schemas.length > 1 || isSchemaOpen(schema._id)" x-collapse
                         @click="activeSchemaId = schema._id"
                         @focusin="activeSchemaId = schema._id">

                <!-- ═══ Toolbar Mini (presets, actions) ═══ -->
                <div class="lp-toolbar">
                    <!-- Presets button with dropdown -->
                    <div style="position: relative;">
                        <button type="button" class="lp-toolbar-btn"
                                :class="{ 'active': presetDropdown[schema._id] }"
                                @click.stop="activeSchemaId = schema._id; togglePresetDropdown(schema._id)">
                            <iconify-icon icon="solar:clipboard-check-bold-duotone" width="13"></iconify-icon>
                            Presets
                            <span x-show="getTemplatesForSchema(schema._id).length > 0"
                                  class="lp-preset-item-badge" x-text="getTemplatesForSchema(schema._id).length"></span>
                        </button>
                        <!-- Preset Dropdown -->
                        <template x-if="presetDropdown[schema._id]">
                            <div>
                                <div style="position: fixed; inset: 0; z-index: 99;"
                                     @click.stop="presetDropdown[schema._id] = false"></div>
                                <div class="lp-preset-dropdown" @click.stop>
                                    <!-- Record-specific presets -->
                                    <template x-if="getRecordPresets(schema._id).length > 0">
                                        <div>
                                            <div class="lp-preset-section-label">
                                                <iconify-icon icon="solar:user-bold-duotone" width="10"></iconify-icon>
                                                <span x-text="linkedRecords.length > 0 ? (linkedRecords[0].relationLabel + ' : ' + linkedRecords[0].recordTitle) : 'Pour ce record'"></span>
                                            </div>
                                            <template x-for="preset in getRecordPresets(schema._id)" :key="preset._id">
                                                <div class="lp-preset-item" @click="applyTemplate(preset); presetDropdown[schema._id] = false">
                                                    <div class="lp-preset-item-icon" :style="'background:' + (preset.color || '#4361ee') + '15; color:' + (preset.color || '#4361ee')">
                                                        <iconify-icon :icon="preset.icon || 'solar:clipboard-check-bold-duotone'" width="14"></iconify-icon>
                                                    </div>
                                                    <div class="lp-preset-item-info">
                                                        <div class="lp-preset-item-name" x-text="preset.name"></div>
                                                        <div class="lp-preset-item-meta">
                                                            <span class="lp-preset-item-badge" x-text="(preset.presetRows || []).length + ' lignes'"></span>
                                                        </div>
                                                    </div>
                                                    <button class="lp-preset-item-delete" @click.stop="deletePreset(preset._id)" title="Supprimer">
                                                        <iconify-icon icon="solar:trash-bin-trash-bold-duotone" width="14"></iconify-icon>
                                                    </button>
                                                </div>
                                            </template>
                                            <div class="lp-preset-divider"></div>
                                        </div>
                                    </template>
                                    <!-- Global presets -->
                                    <div class="lp-preset-section-label">
                                        <iconify-icon icon="solar:global-bold-duotone" width="10"></iconify-icon>
                                        Presets globaux
                                    </div>
                                    <template x-if="getGlobalPresets(schema._id).length === 0">
                                        <div class="lp-preset-empty">
                                            <iconify-icon icon="solar:clipboard-list-broken" width="20" style="opacity: 0.4; display: block; margin: 0 auto 4px;"></iconify-icon>
                                            Aucun preset disponible
                                        </div>
                                    </template>
                                    <template x-for="preset in getGlobalPresets(schema._id)" :key="preset._id">
                                        <div class="lp-preset-item" @click="applyTemplate(preset); presetDropdown[schema._id] = false">
                                            <div class="lp-preset-item-icon" :style="'background:' + (preset.color || '#4361ee') + '15; color:' + (preset.color || '#4361ee')">
                                                <iconify-icon :icon="preset.icon || 'solar:clipboard-list-bold-duotone'" width="14"></iconify-icon>
                                            </div>
                                            <div class="lp-preset-item-info">
                                                <div class="lp-preset-item-name" x-text="preset.name"></div>
                                                <div class="lp-preset-item-meta">
                                                    <span class="lp-preset-item-badge" x-text="(preset.presetRows || []).length + ' lignes'"></span>
                                                    <span x-show="preset.description" x-text="preset.description" style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"></span>
                                                </div>
                                            </div>
                                            <button class="lp-preset-item-delete" @click.stop="deletePreset(preset._id)" title="Supprimer">
                                                <iconify-icon icon="solar:trash-bin-trash-bold-duotone" width="14"></iconify-icon>
                                            </button>
                                        </div>
                                    </template>
                                    <!-- Save current as preset -->
                                    <div class="lp-preset-add-btn"
                                         @click="presetDropdown[schema._id] = false; openSavePresetModal(schema._id)">
                                        <iconify-icon icon="solar:add-circle-bold-duotone" width="14"></iconify-icon>
                                        Sauvegarder comme preset
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>

                    <div class="lp-toolbar-sep"></div>

                    <!-- Save preset shortcut -->
                    <button type="button" class="lp-toolbar-btn"
                            x-show="getSchemaLines(schema._id).length > 0"
                            @click.stop="activeSchemaId = schema._id; openSavePresetModal(schema._id)">
                        <iconify-icon icon="solar:diskette-bold-duotone" width="13"></iconify-icon>
                        Sauvegarder
                    </button>

                    <!-- Template picker (existing feature, moved to toolbar) -->
                    <button type="button" class="lp-toolbar-btn"
                            x-show="getTemplatesForSchema(schema._id).length > 0"
                            :class="{ 'active': templatePicker[schema._id] }"
                            @click.stop="activeSchemaId = schema._id; templatePicker[schema._id] = !templatePicker[schema._id]">
                        <iconify-icon icon="solar:notes-bold-duotone" width="13"></iconify-icon>
                        Modèles
                    </button>
                </div>
                <!-- ═══ Analytics Toggle Bar (for schemas with analytics) ═══ -->
                <div x-show="schema.analyticsConfig && schema.analyticsConfig.enabled"
                     class="dg-analytics-bar">
                    <button class="dg-analytics-tab"
                            :class="{ 'active': !analyticsView[schema._id] || analyticsView[schema._id] === 'data' }"
                            @click.stop="setAnalyticsView(schema._id, 'data')">
                        <iconify-icon icon="solar:document-text-bold" width="13"></iconify-icon>
                        Données
                    </button>
                    <template x-for="av in (schema.analyticsConfig?.views || [])" :key="av.id">
                        <button class="dg-analytics-tab"
                                :class="{ 'active': analyticsView[schema._id] === av.id }"
                                @click.stop="setAnalyticsView(schema._id, av.id)">
                            <iconify-icon :icon="av.icon || 'solar:chart-bold'" width="13"></iconify-icon>
                            <span x-text="av.label"></span>
                        </button>
                    </template>
                </div>

                <!-- ═══ Template Picker Dropdown ═══ -->
                <div x-show="templatePicker[schema._id]" x-collapse class="dg-template-picker" style="border-bottom: 1px solid #e5e7eb;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                        <span class="text-xs font-bold text-gray-600 dark:text-gray-300 flex items-center gap-1.5">
                            <iconify-icon icon="solar:clipboard-list-bold-duotone" width="14" class="text-primary"></iconify-icon>
                            Modèles disponibles
                        </span>
                        <button class="lp-row-btn edit" @click="templatePicker[schema._id] = false">
                            <iconify-icon icon="tabler:x" width="14"></iconify-icon>
                        </button>
                    </div>
                    <div class="dg-template-grid">
                        <template x-for="tpl in getTemplatesForSchema(schema._id)" :key="tpl._id">
                            <div class="dg-template-card" @click="applyTemplate(tpl); templatePicker[schema._id] = false">
                                <div class="dg-template-card-icon" x-text="tpl.icon ? '' : '📋'">
                                    <iconify-icon x-show="tpl.icon" :icon="tpl.icon" width="22" :style="'color:' + (tpl.color || '#4361ee')"></iconify-icon>
                                </div>
                                <div class="dg-template-card-name" x-text="tpl.name"></div>
                                <div class="dg-template-card-desc" x-text="tpl.description"></div>
                                <div class="dg-template-card-count">
                                    <iconify-icon icon="tabler:rows" width="10"></iconify-icon>
                                    <span x-text="(tpl.presetRows || []).length + ' lignes'"></span>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- ═══ Empty state with template suggestions ═══ -->
                <div x-show="getSchemaLines(schema._id).length === 0 && !templatePicker[schema._id] && getTemplatesForSchema(schema._id).length > 0 && (!analyticsView[schema._id] || analyticsView[schema._id] === 'data')"
                     class="px-4 py-6 text-center">
                    <iconify-icon icon="solar:clipboard-list-bold-duotone" width="28" class="text-gray-300 dark:text-gray-600 mb-2"></iconify-icon>
                    <p class="text-xs text-gray-400 mb-3">Aucune donnée. Commencez avec un modèle :</p>
                    <div style="display: flex; flex-wrap: wrap; gap: 6px; justify-content: center;">
                        <template x-for="tpl in getTemplatesForSchema(schema._id).slice(0, 3)" :key="tpl._id">
                            <button class="dg-analytics-tab" style="padding: 4px 10px;" @click="applyTemplate(tpl)">
                                <iconify-icon x-show="tpl.icon" :icon="tpl.icon" width="13" :style="'color:' + (tpl.color || '#4361ee')"></iconify-icon>
                                <span x-text="tpl.name" style="font-size: 11px;"></span>
                            </button>
                        </template>
                    </div>
                </div>

                <!-- ═══ Analytics: Stat Cards View ═══ -->
                <template x-if="analyticsView[schema._id] && analyticsView[schema._id] !== 'data'">
                    <div>
                        <!-- Find the active analytics view config -->
                        <template x-if="getAnalyticsViewConfig(schema, analyticsView[schema._id])?.type === 'stat'">
                            <div class="dg-stat-cards">
                                <template x-for="card in (getAnalyticsViewConfig(schema, analyticsView[schema._id])?.config?.cards || [])" :key="card.column">
                                    <div class="dg-stat-card">
                                        <div class="dg-stat-card-label" x-text="card.label"></div>
                                        <div class="dg-stat-card-value">
                                            <span x-text="computeStat(schema._id, card.column, card.aggregation)"></span>
                                            <span class="dg-stat-card-unit" x-text="card.unit || ''"></span>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </template>

                        <!-- Timeline analytics view -->
                        <template x-if="getAnalyticsViewConfig(schema, analyticsView[schema._id])?.type === 'timeline'">
                            <div class="dg-timeline">
                                <template x-for="(line, idx) in getSchemaLines(schema._id)" :key="line._tempId || line._id || idx">
                                    <div class="dg-timeline-item">
                                        <div class="dg-timeline-dot"></div>
                                        <div class="dg-timeline-content">
                                            <div class="dg-form-entry-date">
                                                <iconify-icon icon="solar:calendar-bold" width="12"></iconify-icon>
                                                <span x-text="formatEntryDate(line, schema)"></span>
                                            </div>
                                            <div class="dg-form-entry-grid" style="grid-template-columns: repeat(3, 1fr);">
                                                <template x-for="col in getVisibleColumnsForSchema(schema).filter(c => c.type !== 'date')" :key="col.key">
                                                    <div class="dg-form-entry-field">
                                                        <label x-text="col.label"></label>
                                                        <div class="dg-value">
                                                            <span x-text="formatCellValue(line.values[col.key], col)"></span>
                                                            <span x-html="getNormalRangeIndicator(line.values[col.key], col)"></span>
                                                        </div>
                                                    </div>
                                                </template>
                                            </div>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </template>
                    </div>
                </template>

                <!-- ═══ DATA VIEW (shown when analytics is on 'data' or no analytics) ═══ -->
                <div x-show="!analyticsView[schema._id] || analyticsView[schema._id] === 'data'">

                <!-- Line Type selector (if schema has multiple line types) — catalog/table only -->
                <div x-show="(getSchemaInputMode(schema) === 'catalog') && schema.lineTypes && schema.lineTypes.length > 1"
                    class="px-3 py-1.5 flex items-center gap-2 border-b border-gray-100 dark:border-gray-800">
                    <span class="text-[10px] font-semibold text-gray-400 uppercase">Type:</span>
                    <select class="lp-input !w-auto !text-[11px] !py-1 !px-2 !border-gray-200 dark:!border-gray-700"
                        @change="setSchemaLineType(schema._id, $event.target.value)"
                        :value="getSchemaLineType(schema._id)">
                        <template x-for="lt in schema.lineTypes" :key="lt">
                            <option :value="lt" x-text="lt"></option>
                        </template>
                    </select>
                </div>

                <!-- Table (catalog & table modes only, hidden for form mode) -->
                <div x-show="getSchemaInputMode(schema) !== 'form'"
                     :class="relationSearch.open ? '' : 'overflow-x-auto'"
                     :style="relationSearch.open ? 'overflow: visible' : ''">
                    <table class="lines-panel-table">
                        <thead>
                            <tr>
                                <th style="width: 28px;"></th>
                                <th style="width: 24px;">#</th>
                                <template x-if="getRelationColForSchema(schema)">
                                    <th class="lp-w-m" x-text="getRelationColForSchema(schema)?.label || 'Article'"></th>
                                </template>
                                <template x-for="col in getVisibleColumnsForSchema(schema).filter(c => c.type !== 'relation')" :key="col.key">
                                    <th :class="'lp-w-' + (col.width || 'M').toLowerCase()" x-text="col.label"></th>
                                </template>
                                <th style="width: 56px;"></th>
                            </tr>
                        </thead>
                        <tbody :data-schema-id="schema._id">
                            <template x-for="(line, lineIdx) in getSchemaLines(schema._id)" :key="line._tempId || line._id || lineIdx">
                                <tr>
                                    <!-- Drag handle -->
                                    <td>
                                        <span class="lp-drag-handle">
                                            <iconify-icon icon="tabler:grip-vertical" width="14"></iconify-icon>
                                        </span>
                                    </td>
                                    <!-- Row number -->
                                    <td class="text-[11px] text-gray-400" x-text="lineIdx + 1"></td>
                                    <!-- Relation name (always visible) -->
                                    <template x-if="getRelationCol()">
                                        <td class="lp-w-m">
                                            <div class="lp-relation-wrap">
                                                <input type="text" class="lp-input"
                                                    :value="getRelationLabel(line)"
                                                    @focus="openRelationSearch(lineIdx, getRelationCol().key)"
                                                    @input="searchRelation(lineIdx, getRelationCol().key, $event.target.value)"
                                                    @blur="setTimeout(() => closeRelationSearch(), 200)"
                                                    @keydown.escape="closeRelationSearch()"
                                                    :placeholder="'🔍 ' + (getRelationCol()?.label || 'Article')" />
                                                <!-- Dropdown -->
                                                <div x-show="relationSearch.lineIdx === lineIdx && relationSearch.colKey === getRelationCol().key && relationSearch.open"
                                                    class="lp-relation-dropdown"
                                                    @click.outside="closeRelationSearch()">
                                                    <template x-if="relationSearch.loading">
                                                        <div class="px-3 py-2 text-xs text-gray-400 text-center">
                                                            <iconify-icon icon="svg-spinners:ring-resize" width="14"></iconify-icon>
                                                        </div>
                                                    </template>
                                                    <template x-if="!relationSearch.loading && relationSearch.results.length === 0">
                                                        <div class="px-3 py-2 text-xs text-gray-400 text-center">Aucun résultat</div>
                                                    </template>
                                                    <template x-for="item in relationSearch.results" :key="item._id">
                                                        <div class="lp-rel-item"
                                                            @click="selectRelation(lineIdx, getRelationCol(), item)">
                                                            <span x-text="item.label || item.title"></span>
                                                        </div>
                                                    </template>
                                                </div>
                                            </div>
                                        </td>
                                    </template>
                                    <!-- Dynamic columns (excluding relation) -->
                                    <template x-for="col in getVisibleColumnsForLine(line).filter(c => c.type !== 'relation')" :key="col.key">
                                        <td :class="'lp-w-' + (col.width || 'M').toLowerCase()">
                                            <!-- Text -->
                                            <template x-if="col.type === 'text'">
                                                <input type="text" class="lp-input"
                                                    :value="line.values[col.key] || ''"
                                                    @input="line.values[col.key] = $event.target.value; debouncedSave()"
                                                    :placeholder="col.label" />
                                            </template>

                                            <!-- Textarea -->
                                            <template x-if="col.type === 'textarea'">
                                                <input type="text" class="lp-input"
                                                    :value="line.values[col.key] || ''"
                                                    @input="line.values[col.key] = $event.target.value; debouncedSave()"
                                                    :placeholder="col.label" />
                                            </template>

                                            <!-- Number -->
                                            <template x-if="col.type === 'number'">
                                                <input type="number" class="lp-input text-right"
                                                    :value="line.values[col.key] || ''"
                                                    @input="line.values[col.key] = parseFloat($event.target.value) || 0; recomputeLine(line); debouncedSave()"
                                                    step="any" />
                                            </template>

                                            <!-- Money -->
                                            <template x-if="col.type === 'money'">
                                                <input type="number" class="lp-input text-right"
                                                    :value="line.values[col.key] || ''"
                                                    @input="line.values[col.key] = parseFloat($event.target.value) || 0; recomputeLine(line); debouncedSave()"
                                                    step="0.01" />
                                            </template>

                                            <!-- Date -->
                                            <template x-if="col.type === 'date'">
                                                <input type="date" class="lp-input"
                                                    :value="line.values[col.key] || ''"
                                                    @input="line.values[col.key] = $event.target.value; debouncedSave()" />
                                            </template>

                                            <!-- Select -->
                                            <template x-if="col.type === 'select'">
                                                <select class="lp-input"
                                                    :value="line.values[col.key] || ''"
                                                    @change="line.values[col.key] = $event.target.value; debouncedSave()">
                                                    <option value="">—</option>
                                                    <template x-for="opt in getSelectOptions(col, line)" :key="opt.value">
                                                        <option :value="opt.value" x-text="opt.label" :selected="line.values[col.key] === opt.value"></option>
                                                    </template>
                                                </select>
                                            </template>

                                            <!-- Multiselect (inline tag-picker dropdown) -->
                                            <template x-if="col.type === 'multiselect'">
                                                <div class="lp-ms-wrap">
                                                    <!-- Selected tags display (trigger) -->
                                                    <div class="lp-ms-trigger"
                                                         @click.stop="activeSchemaId = schema._id; openMultiselectDropdown(lineIdx, col.key, $event)">
                                                        <template x-if="(line.values[col.key] || []).length === 0">
                                                            <span class="lp-ms-placeholder">Sélectionner...</span>
                                                        </template>
                                                        <template x-for="selVal in (line.values[col.key] || [])" :key="selVal">
                                                            <span class="tp-tag"
                                                                  :style="'background:' + getMultiselectOptStyle(col, selVal).bg + '; color:' + getMultiselectOptStyle(col, selVal).text"
                                                                  x-text="getMultiselectOptLabel(col, selVal)">
                                                            </span>
                                                        </template>
                                                    </div>
                                                    <!-- Backdrop + Dropdown (only rendered for the active one) -->
                                                    <template x-if="msDropdown.lineIdx === lineIdx && msDropdown.colKey === col.key && msDropdown.open">
                                                        <div>
                                                            <!-- Invisible backdrop to close on click -->
                                                            <div style="position: fixed; inset: 0; z-index: 9998;"
                                                                 @click.stop="closeMultiselectDropdown()"></div>
                                                            <!-- Dropdown panel -->
                                                            <div class="lp-ms-dropdown"
                                                                 :style="'top:' + (msDropdown.pos?.top || 0) + 'px; left:' + (msDropdown.pos?.left || 0) + 'px'">
                                                                <div class="tp-search-wrap">
                                                                    <input type="text" class="tp-search-input"
                                                                           placeholder="Rechercher..."
                                                                           :value="msDropdown.query"
                                                                           @input="msDropdown.query = $event.target.value" />
                                                                </div>
                                                                <div class="tp-divider"></div>
                                                                <div class="tp-options">
                                                                    <template x-for="opt in filterMsOptions(col)" :key="opt.value">
                                                                        <div class="tp-option"
                                                                             @click.stop="toggleMultiselectValue(line, col.key, opt.value)">
                                                                            <div class="tp-option-icon"
                                                                                 :style="(line.values[col.key] || []).includes(opt.value)
                                                                                     ? 'background:' + getMultiselectOptStyle(col, opt.value).bg + '; border: 2px solid ' + getMultiselectOptStyle(col, opt.value).bg
                                                                                     : 'background: #fff; border: 2px solid #d1d5db'">
                                                                                <iconify-icon x-show="(line.values[col.key] || []).includes(opt.value)"
                                                                                              icon="tabler:check" width="12"
                                                                                              :style="'color:' + getMultiselectOptStyle(col, opt.value).text"></iconify-icon>
                                                                            </div>
                                                                            <span class="tp-option-label" x-text="opt.label"></span>
                                                                        </div>
                                                                    </template>
                                                                </div>
                                                                <div class="tp-divider"></div>
                                                                <div style="padding:4px 8px;">
                                                                    <input type="text" class="lp-input" style="font-size:11px; padding:4px 8px; width:100%;"
                                                                           placeholder="+ Nouvelle option…"
                                                                           @keydown.enter.stop="addInlineOption(col, $event.target.value); $event.target.value = ''"
                                                                           @click.stop />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </template>
                                                </div>
                                            </template>

                                            <!-- Duration -->
                                            <template x-if="col.type === 'duration'">
                                                <div class="flex gap-1 items-center">
                                                    <input type="number" class="lp-input text-right !w-14"
                                                        :value="line.values[col.key]?.value || ''"
                                                        @input="if(!line.values[col.key]) line.values[col.key] = {}; line.values[col.key].value = parseFloat($event.target.value) || 0; debouncedSave()"
                                                        min="0" step="1" />
                                                    <select class="lp-input !w-16 !text-[10px]"
                                                        :value="line.values[col.key]?.unit || (col.config?.units?.[0] || 'day')"
                                                        @change="if(!line.values[col.key]) line.values[col.key] = {}; line.values[col.key].unit = $event.target.value; debouncedSave()">
                                                        <template x-for="u in (col.config?.units || ['day','week','month'])" :key="u">
                                                            <option :value="u" x-text="durationLabel(u)"></option>
                                                        </template>
                                                    </select>
                                                </div>
                                            </template>

                                            <!-- Dosage -->
                                            <template x-if="col.type === 'dosage'">
                                                <div class="flex gap-1 items-center">
                                                    <input type="number" class="lp-input text-right !w-14"
                                                        :value="line.values[col.key]?.value || ''"
                                                        @input="if(!line.values[col.key]) line.values[col.key] = {}; line.values[col.key].value = parseFloat($event.target.value) || 0; debouncedSave()"
                                                        min="0" step="any" />
                                                    <select class="lp-input !w-16 !text-[10px]"
                                                        :value="line.values[col.key]?.unit || (col.config?.units?.[0] || 'mg')"
                                                        @change="if(!line.values[col.key]) line.values[col.key] = {}; line.values[col.key].unit = $event.target.value; debouncedSave()">
                                                        <template x-for="u in (col.config?.units || ['mg','ml','g','cp'])" :key="u">
                                                            <option :value="u" x-text="u"></option>
                                                        </template>
                                                    </select>
                                                </div>
                                            </template>

                                            <!-- Relation (autocomplete search) -->
                                            <template x-if="col.type === 'relation'">
                                                <div class="lp-relation-wrap">
                                                    <input type="text" class="lp-input"
                                                        :value="line.values[col.key + '_label'] || ''"
                                                        @focus="openRelationSearch(lineIdx, col.key)"
                                                        @input="searchRelation(lineIdx, col.key, $event.target.value)"
                                                        @blur="setTimeout(() => closeRelationSearch(), 200)"
                                                        @keydown.escape="closeRelationSearch()"
                                                        :placeholder="'🔍 ' + col.label" />
                                                    <!-- Dropdown -->
                                                    <div x-show="relationSearch.lineIdx === lineIdx && relationSearch.colKey === col.key && relationSearch.open"
                                                        class="lp-relation-dropdown"
                                                        @click.outside="closeRelationSearch()">
                                                        <template x-if="relationSearch.loading">
                                                            <div class="px-3 py-2 text-xs text-gray-400 text-center">
                                                                <iconify-icon icon="svg-spinners:ring-resize" width="14"></iconify-icon>
                                                            </div>
                                                        </template>
                                                        <template x-if="!relationSearch.loading && relationSearch.results.length === 0">
                                                            <div class="px-3 py-2 text-xs text-gray-400 text-center">Aucun résultat</div>
                                                        </template>
                                                        <template x-for="item in relationSearch.results" :key="item._id">
                                                            <div class="lp-rel-item"
                                                                @click="selectRelation(lineIdx, col, item)">
                                                                <span x-text="item.label || item.title"></span>
                                                            </div>
                                                        </template>
                                                    </div>
                                                </div>
                                            </template>

                                            <!-- Formula (computed, read-only) -->
                                            <template x-if="col.type === 'formula'">
                                                <div class="lp-computed" x-text="formatComputed(line, col)"></div>
                                            </template>
                                        </td>
                                    </template>
                                    <!-- Actions (edit + delete) -->
                                    <td>
                                        <div class="lp-row-actions">
                                            <button type="button" class="lp-row-btn edit" @click="activeSchemaId = schema._id; openEditLine(lineIdx)" title="Modifier">
                                                <iconify-icon icon="tabler:pencil" width="14"></iconify-icon>
                                            </button>
                                            <button type="button" class="lp-row-btn delete" @click="activeSchemaId = schema._id; removeLine(lineIdx)" title="Supprimer">
                                                <iconify-icon icon="tabler:trash" width="14"></iconify-icon>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>

                <!-- Add row — catalog & table modes -->
                <div x-show="getSchemaInputMode(schema) === 'catalog' || getSchemaInputMode(schema) === 'table'"
                     class="lp-add-row-area" style="display: flex; gap: 0;">
                    <div x-show="getSchemaInputMode(schema) === 'catalog'"
                         style="flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px;"
                         @click.stop="activateAndOpenModal(schema._id)">
                        <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                        <span>Ajouter des lignes</span>
                    </div>
                    <div style="border-left: 1px solid #e5e7eb; padding: 0 10px; display: flex; align-items: center; flex: 1; justify-content: center; gap: 6px;"
                         :style="getSchemaInputMode(schema) === 'table' ? 'border-left:none' : ''"
                         class="dark:!border-gray-700"
                         @click.stop="addLineToSchema(schema._id)" title="Ajouter une ligne vide">
                        <iconify-icon icon="tabler:row-insert-bottom" width="14"></iconify-icon>
                        <span x-show="getSchemaInputMode(schema) === 'table'">Ajouter une ligne</span>
                    </div>
                </div>

                <!-- ═══ FORM MODE: Card entries + inline add form ═══ -->
                <template x-if="getSchemaInputMode(schema) === 'form'">
                    <div>
                        <!-- Existing entries as cards (chronological) -->
                        <div class="dg-form-entries" x-show="getSchemaLines(schema._id).length > 0">
                            <template x-for="(line, lineIdx) in getSchemaLines(schema._id)" :key="line._tempId || line._id || lineIdx">
                                <div class="dg-form-entry">
                                    <!-- Date header -->
                                    <div class="dg-form-entry-date">
                                        <iconify-icon icon="solar:calendar-bold" width="12"></iconify-icon>
                                        <span x-text="formatEntryDate(line, schema)"></span>
                                    </div>
                                    <!-- Fields grid -->
                                    <div class="dg-form-entry-grid"
                                         :style="'grid-template-columns: repeat(' + getFormColumns(schema) + ', 1fr)'">
                                        <template x-for="col in getVisibleColumnsForSchema(schema).filter(c => c.type !== 'date')" :key="col.key">
                                            <div class="dg-form-entry-field">
                                                <label x-text="col.label"></label>
                                                <div class="dg-value">
                                                    <template x-if="col.type === 'relation'">
                                                        <span x-text="formatRelationValue(line, col)"></span>
                                                    </template>
                                                    <template x-if="col.type !== 'relation'">
                                                        <span x-text="formatCellValue(line.values[col.key], col)"></span>
                                                    </template>
                                                    <span x-html="getNormalRangeIndicator(line.values[col.key], col)"></span>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                    <!-- Actions (edit/delete) -->
                                    <div class="dg-form-entry-actions">
                                        <button type="button" class="lp-row-btn edit" @click="activeSchemaId = schema._id; openEditLine(lineIdx, schema._id)" title="Modifier">
                                            <iconify-icon icon="tabler:pencil" width="14"></iconify-icon>
                                        </button>
                                        <button type="button" class="lp-row-btn delete" @click="activeSchemaId = schema._id; removeLine(lineIdx)" title="Supprimer">
                                            <iconify-icon icon="tabler:trash" width="14"></iconify-icon>
                                        </button>
                                    </div>
                                </div>
                            </template>
                        </div>

                        <!-- Inline add form -->
                        <div x-show="formAddOpen[schema._id]" class="dg-form-add">
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-xs font-bold text-gray-600 dark:text-gray-300 flex items-center gap-1">
                                    <iconify-icon icon="solar:add-circle-bold" width="14" class="text-primary"></iconify-icon>
                                    Nouvelle mesure
                                </span>
                                <button type="button" class="lp-row-btn edit" @click="formAddOpen[schema._id] = false">
                                    <iconify-icon icon="tabler:x" width="14"></iconify-icon>
                                </button>
                            </div>
                            <div class="dg-form-add-grid"
                                 :style="'grid-template-columns: repeat(' + getFormColumns(schema) + ', 1fr)'">
                                <template x-for="col in getVisibleColumnsForSchema(schema)" :key="col.key">
                                    <div class="dg-form-entry-field">
                                        <label x-text="col.label"></label>
                                        <!-- Date -->
                                        <template x-if="col.type === 'date'">
                                            <input type="date" class="lp-input"
                                                   x-model="formAddValues[schema._id + '_' + col.key]" />
                                        </template>
                                        <!-- Number -->
