    .tqv-empty { text-align:center; padding:30px 10px; color:#bfc9d4; font-size:12px; }
    .tqv-link { display:inline-flex; align-items:center; gap:6px; margin-top:16px; padding:6px 14px; border-radius:8px; border:1px solid #e0e6ed; background:#fff; color:#4361ee; font-size:12px; font-weight:600; cursor:pointer; transition:all .15s; text-decoration:none; }
