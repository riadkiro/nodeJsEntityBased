<div x-data="pageBuilder()">
  
  <!-- Header Bar -->
  <div class="mb-4 bg-white dark:bg-gray-800 border dark:border-gray-700 shadow-sm rounded-lg">
    <div class="h-14 flex items-center justify-between px-6">
      <div class="flex items-center gap-4">
        <h1 class="text-lg font-semibold" x-text="pageConfig.name"></h1>
        <div class="flex gap-2">
          <button 
            :class="builderState.mode === 'edit' && 'bg-primary text-white'"
            @click="builderState.mode = 'edit'"
            class="px-3 py-1 rounded text-sm transition-colors hover:bg-primary/10">
            Edit
          </button>
          <button 
            :class="builderState.mode === 'preview' && 'bg-primary text-white'"
            @click="builderState.mode = 'preview'"
            class="px-3 py-1 rounded text-sm transition-colors hover:bg-primary/10">
            Preview
          </button>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-xs text-gray-500" x-show="lastSaved">
          Last saved: <span x-text="lastSaved"></span>
        </span>
        <button @click="saveConfig()" class="btn btn-primary btn-sm">
          <iconify-icon icon="solar:diskette-bold" class="mr-1"></iconify-icon>
          Save
        </button>
        <button @click="publishConfig()" class="btn btn-success btn-sm">
          Publish
        </button>
      </div>
    </div>
  </div>

  <!-- Main Builder Area with Left Sidebar -->
  <div class="relative flex gap-4" style="height: calc(100vh - 250px);">
    
    <!-- Icon Sidebar (Always Visible) -->
    <%- include('partials/builder-sidebar') %>

    <!-- Blocks Sidebar (Slides from Complete Left) -->
    <div 
      x-show="builderState.drawerMode === 'blocks'"
      x-transition:enter="transform transition ease-out duration-500"
      x-transition:enter-start="-translate-x-full opacity-0"
      x-transition:enter-end="translate-x-0 opacity-100"
      x-transition:leave="transform transition ease-in duration-500"
      x-transition:leave-start="translate-x-0 opacity-100"
      x-transition:leave-end="-translate-x-full opacity-0"
      class="fixed top-0 left-0 z-50 w-[248px] h-screen bg-white dark:bg-gray-800 border-r dark:border-gray-700 shadow-xl overflow-y-auto">
      
      <!-- Single Header -->
      <div class="bg-white dark:bg-gray-800 border-b dark:border-gray-700 p-4 flex items-center justify-between">
        <h3 class="text-lg font-semibold">Add Blocks</h3>
        <button @click="builderState.drawerMode = null" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
          <iconify-icon icon="solar:close-circle-bold" width="24"></iconify-icon>
        </button>
      </div>

      <!-- Blocks Grid (Direct, no wrapper) -->
      <div class="p-4">
        <p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-semibold mb-3">Drag blocks to canvas</p>
        
        <div 
          class="grid grid-cols-2 gap-2"
          x-init="
            Sortable.create($el, {
              group: { name: 'blocks', pull: 'clone', put: false },
              animation: 150,
              sort: false
            })
          ">
          <!-- Panel Block -->
          <div 
            data-block-type="panel"
            class="p-3 border-2 border-dashed border-gray-300 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
            <iconify-icon icon="solar:widget-5-bold-duotone" width="32" class="text-primary"></iconify-icon>
            <span class="text-xs font-medium">Panel</span>
          </div>

          <!-- Text Block -->
          <div 
            data-block-type="text"
            class="p-3 border-2 border-dashed border-gray-300 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
            <iconify-icon icon="solar:text-bold-duotone" width="32" class="text-success"></iconify-icon>
            <span class="text-xs font-medium">Text</span>
          </div>

          <!-- KPI Card Block -->
          <div 
            data-block-type="kpi-card"
            class="p-3 border-2 border-dashed border-gray-300 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
            <iconify-icon icon="solar:presentation-graph-bold-duotone" width="32" class="text-warning"></iconify-icon>
            <span class="text-xs font-medium">KPI Card</span>
          </div>

          <!-- Statistics Block -->
          <div 
            data-block-type="statistics"
            class="p-3 border-2 border-dashed border-gray-300 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
            <iconify-icon icon="solar:chart-bold-duotone" width="32" class="text-info"></iconify-icon>
            <span class="text-xs font-medium">Statistics</span>
          </div>

          <!-- Expense Tracker Block -->
          <div 
            data-block-type="expense-tracker"
            class="p-3 border-2 border-dashed border-gray-300 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
            <iconify-icon icon="solar:wallet-money-bold-duotone" width="32" class="text-danger"></iconify-icon>
            <span class="text-xs font-medium">Expenses</span>
          </div>

          <!-- Progress List Block -->
          <div 
            data-block-type="progress-list"
            class="p-3 border-2 border-dashed border-gray-300 rounded-lg flex flex-col items-center gap-2 cursor-move hover:border-primary hover:bg-primary/5 transition-colors">
            <iconify-icon icon="solar:chart-2-bold-duotone" width="32" class="text-secondary"></iconify-icon>
            <span class="text-xs font-medium">Progress List</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Canvas Area (Full Width) -->
    <%- include('partials/builder-canvas') %>
  </div>
</div>

<script type="application/json" id="page-config-data">
<%- JSON.stringify({
  accountNumber: account_number,
  configId: typeof pageConfig !== 'undefined' ? pageConfig._id : null,
  isNew: typeof pageConfig === 'undefined',
  config: typeof pageConfig !== 'undefined' ? pageConfig : {
    name: 'New Page',
    type: 'dashboard',
    schemaVersion: '1.0',
    theme: {
      spacing: 'normal',
      radius: 'md',
      fontScale: 1,
      accentColor: '#4361ee'
    },
    dataPlan: {
      prefetch: [],
      lazy: [],
      cacheTTL: 300
    },
    header: {
      title: '',
      breadcrumb: true,
      actions: []
    },
    tabs: [],
    layout: { 
      default: [{
        id: 'row_default_1',
        columns: [{ width: 12, blocks: [] }]
      }]
    },
    blocks: {},
    actions: {}
  }
}).replace(/</g, '\\u003C') %>
</script>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('pageBuilder', () => {
    const data = JSON.parse(document.getElementById('page-config-data').textContent);
    
    return {
      accountNumber: data.accountNumber,
      configId: data.configId,
      pageConfig: data.config,
      lastSaved: null,
      
      builderState: {
        mode: 'edit',
        selectedBlockId: null,
        selectedRowId: null,
        hoveredBlockId: null,
        hoveredRowId: null,
        drawerMode: null,
        drawerContext: null,
        isDragging: false,
        dragSource: null,
        clipboard: null,
        undoStack: [],
        redoStack: [],
        activeTab: 'default'
      },
      
      init() {
        console.log('PageBuilder initialized', this.pageConfig);
      },
      
      openDrawer(mode, context = null) {
        this.builderState.drawerMode = mode;
        this.builderState.drawerContext = context;
      },
      
      closeDrawer() {
        this.builderState.drawerMode = null;
        this.builderState.drawerContext = null;
      },
      
      selectBlock(blockId) {
        this.builderState.selectedBlockId = blockId;
        this.builderState.selectedRowId = null;
      },
      
      selectRow(rowId) {
        this.builderState.selectedRowId = rowId;
        this.builderState.selectedBlockId = null;
      },
      
      addRow() {
        const tabId = this.builderState.activeTab;
        if (!this.pageConfig.layout[tabId]) {
          this.pageConfig.layout[tabId] = [];
        }
        
        const rowId = 'row_' + Date.now();
        this.pageConfig.layout[tabId].push({
          id: rowId,
          columns: [{ width: 12, blocks: [] }]
        });
      },
      
      duplicateRow(rowId) {
        const tabId = this.builderState.activeTab;
        const rows = this.pageConfig.layout[tabId];
        const index = rows.findIndex(r => r.id === rowId);
        
        if (index !== -1) {
          const newRow = JSON.parse(JSON.stringify(rows[index]));
          newRow.id = 'row_' + Date.now();
          rows.splice(index + 1, 0, newRow);
        }
      },
      
      deleteRow(rowId) {
        const tabId = this.builderState.activeTab;
        const rows = this.pageConfig.layout[tabId];
        const index = rows.findIndex(r => r.id === rowId);
        
        if (index !== -1) {
          rows.splice(index, 1);
        }
      },
      
      setRowLayout(rowId, numColumns) {
        const tabId = this.builderState.activeTab;
        const row = this.pageConfig.layout[tabId].find(r => r.id === rowId);
        
        if (!row) return;
        
        // Calculate column widths for equal distribution
        const columnWidth = Math.floor(12 / numColumns);
        const remainder = 12 % numColumns;
        
        // Preserve existing blocks if possible
        const existingBlocks = row.columns.flatMap(col => col.blocks);
        
        // Create new columns
        const newColumns = [];
        for (let i = 0; i < numColumns; i++) {
          newColumns.push({
            width: columnWidth + (i < remainder ? 1 : 0),
            blocks: existingBlocks[i] ? [existingBlocks[i]] : []
          });
        }
        
        row.columns = newColumns;
      },
      
      addColumnToRow(rowId) {
        const tabId = this.builderState.activeTab;
        const row = this.pageConfig.layout[tabId].find(r => r.id === rowId);
        
        if (!row) return;
        
        // Check max 12 columns (total width)
        const totalWidth = row.columns.reduce((sum, col) => sum + col.width, 0);
        if (totalWidth >= 12) {
          this.showToast('Maximum 12 columns reached', 'info');
          return;
        }
        
        // Add new column with width 1
        row.columns.push({
          width: 1,
          blocks: []
        });
      },
      
      toggleEqualHeight(rowId) {
        const tabId = this.builderState.activeTab;
        const row = this.pageConfig.layout[tabId].find(r => r.id === rowId);
        
        if (!row) return;
        
        row.equalHeight = !row.equalHeight;
      },
      
      initSortableColumn(el, rowId, columnIndex) {
        const self = this;
        
        Sortable.create(el, {
          group: 'blocks',
          animation: 150,
          ghostClass: 'opacity-50',
          onAdd(evt) {
            // Get block type from cloned element
            const blockType = evt.item.dataset.blockType;
            
            if (blockType) {
              // Remove the cloned DOM element
              evt.item.remove();
              
              // Add block to config
              self.addBlock(blockType, rowId, columnIndex);
            }
          },
          onEnd(evt) {
            const tabId = self.builderState.activeTab;
            const rows = self.pageConfig.layout[tabId];
            
            // If dragging from palette (no blockId), ignore - already handled in onAdd
            if (!evt.item.dataset.blockId) return;
            
            // Rebuild all columns from DOM state
            // This ensures we capture any cross-column moves
            rows.forEach(row => {
              row.columns.forEach((col, colIdx) => {
                // Find the Sortable container for this column
                // We'll use a data attribute approach
                const containers = document.querySelectorAll('[data-sortable-column]');
                containers.forEach(container => {
                  const containerRowId = container.getAttribute('data-row-id');
                  const containerColIdx = parseInt(container.getAttribute('data-col-index'));
                  
                  if (containerRowId === row.id && containerColIdx === colIdx) {
                    // Read blocks from DOM
                    const blockElements = Array.from(container.children);
                    const newOrder = blockElements
                      .filter(child => child.dataset.blockId)
                      .map(child => child.dataset.blockId);
                    
                    row.columns[colIdx].blocks = newOrder;
                  }
                });
              });
            });
          }
        });
      },
      
      addBlock(blockType, rowId, columnIndex) {
        const blockId = blockType + '_' + Date.now();
        
        // Create block definition
        this.pageConfig.blocks[blockId] = {
          type: blockType,
          meta: {
            category: 'default',
            locked: false
          },
          title: blockType.charAt(0).toUpperCase() + blockType.slice(1),
          ...this.getBlockDefaults(blockType)
        };
        
        // Add to column
        const tabId = this.builderState.activeTab;
        const row = this.pageConfig.layout[tabId].find(r => r.id === rowId);
        if (row && row.columns[columnIndex]) {
          row.columns[columnIndex].blocks.push(blockId);
        }
        
        // Auto-select
        this.selectBlock(blockId);
      },
      
      getBlockDefaults(type) {
        const defaults = {
          panel: { collapsible: false, icon: '' },
          text: { content: 'Double-click to edit' },
          'kpi-card': { label: 'KPI', valueField: '', color: 'primary' },
          statistics: { 
            title: 'Statistics',
            stats: [
              { label: 'Total Visits', value: '423,964' },
              { label: 'Paid Visits', value: '7,929' }
            ]
          },
          'expense-tracker': {
            title: 'Expenses',
            value: 45141,
            currency: '$',
            period: 'this week',
            progress: 65,
            trend: 'up'
          },
          'progress-list': {
            title: 'Visitors by Browser',
            items: [
              { label: 'Chrome', value: 65, color: 'primary', icon: 'chrome' },
              { label: 'Safari', value: 40, color: 'danger', icon: 'safari' },
              { label: 'Others', value: 25, color: 'warning', icon: 'global' }
            ]
          }
        };
        return defaults[type] || {};
      },
      
      async saveConfig() {
        try {
          const url = this.configId 
            ? `/account/${this.accountNumber}/page-builder/api/page-configs/${this.configId}`
            : `/account/${this.accountNumber}/page-builder/api/page-configs`;
          
          const method = this.configId ? 'PUT' : 'POST';
          
          const response = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.pageConfig)
          });
          
          if (response.ok) {
            const saved = await response.json();
            this.configId = saved._id;
            this.lastSaved = new Date().toLocaleTimeString();
            
            // Toast notification
            this.showToast('Configuration saved!', 'success');
          }
        } catch (error) {
          console.error('Save error:', error);
          this.showToast('Failed to save', 'error');
        }
      },
      
      async publishConfig() {
        if (!this.configId) {
          await this.saveConfig();
        }
        
        try {
          const response = await fetch(`/account/${this.accountNumber}/page-builder/api/page-configs/${this.configId}/publish`, {
            method: 'PATCH'
          });
          
          if (response.ok) {
            this.pageConfig.status = 'published';
            this.showToast('Page published!', 'success');
          }
        } catch (error) {
          console.error('Publish error:', error);
          this.showToast('Failed to publish', 'error');
        }
      },
      
      showToast(message, type = 'info') {
        const toast = document.createElement('div');
        toast.className = `fixed bottom-4 right-4 px-4 py-2 rounded shadow-lg z-50 ${
          type === 'success' ? 'bg-success text-white' : 
          type === 'error' ? 'bg-danger text-white' : 'bg-gray-800 text-white'
        }`;
        toast.textContent = message;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
      },
      
      renderBlock(blockId) {
        const block = this.pageConfig.blocks[blockId];
        if (!block) return '';
        
        switch (block.type) {
          case 'panel':
            return `
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5 border border-gray-200 dark:border-gray-700">
                <div class="mb-5 flex items-center justify-between">
                  <h5 class="text-lg font-semibold text-gray-900 dark:text-white" contenteditable="${this.builderState.mode === 'edit'}">${block.title || 'Panel Title'}</h5>
                </div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Panel content...</div>
              </div>
            `;
          
          case 'text':
            return `
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5 border border-gray-200 dark:border-gray-700">
                <div contenteditable="${this.builderState.mode === 'edit'}" class="prose max-w-none text-gray-700 dark:text-gray-300">
                  ${block.content || 'Double-click to edit text...'}
                </div>
              </div>
            `;
          
          case 'kpi-card':
            return `
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5 border border-gray-200 dark:border-gray-700 h-full">
                <div class="mb-1 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">${block.label || 'KPI'}</div>
                <div class="text-3xl font-bold text-primary mb-2">0</div>
                <div class="text-xs text-success">↑ 12%</div>
              </div>
            `;
          
          case 'statistics':
            return `
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5 border border-gray-200 dark:border-gray-700 h-full">
                <div class="mb-5 flex items-center justify-between">
                  <h5 class="text-lg font-semibold text-gray-900 dark:text-white" contenteditable="${this.builderState.mode === 'edit'}">${block.title || 'Statistics'}</h5>
                  <div x-data="dropdown" @click.outside="open = false" class="dropdown">
                    <a href="javascript:;" @click="toggle">
                      <svg class="h-5 w-5 text-gray-600 hover:text-primary dark:text-gray-400" viewBox="0 0 24 24" fill="none">
                        <circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
                        <circle opacity="0.5" cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
                        <circle cx="19" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
                      </svg>
                    </a>
                    <ul x-cloak x-show="open" x-transition class="ltr:right-0 rtl:left-0">
                      <li><a href="javascript:;" @click="toggle">This Week</a></li>
                      <li><a href="javascript:;" @click="toggle">Last Week</a></li>
                      <li><a href="javascript:;" @click="toggle">This Month</a></li>
                      <li><a href="javascript:;" @click="toggle">Last Month</a></li>
                    </ul>
                  </div>
                </div>
                <div class="grid gap-6 text-sm font-bold sm:grid-cols-2">
                  <div>
                    <div class="text-gray-600 dark:text-gray-400 font-normal mb-1">Total Visits</div>
                    <div class="text-2xl font-bold text-pink-500">423,964</div>
                  </div>
                  <div>
                    <div class="text-gray-600 dark:text-gray-400 font-normal mb-1">Paid Visits</div>
                    <div class="text-2xl font-bold text-pink-500">7,929</div>
                  </div>
                </div>
              </div>
            `;
          
          default:
            return `<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5 border border-gray-200 dark:border-gray-700">Unknown block type: ${block.type}</div>`;
        }
      }
    };
  });
});
</script>
