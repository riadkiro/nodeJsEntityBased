<div x-data="recordList">
  <div class="space-y-6">
    <div class="panel">
      <div class="flex items-center justify-between mb-5">
        <h5 class="text-lg font-semibold dark:text-white-light">
          <%= entity.name %> - Liste des records
        </h5>
        <a href="/account/<%= account_number %>/record/<%= entity.slug %>/add" class="btn btn-primary">Ajouter un
          record</a>
      </div>
      <div class="relative">
        <table id="recordTable" class="whitespace-nowrap"></table>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("alpine:init", () => {
    Alpine.data("recordList", () => ({
      datatable: null,

      init() {
        const headers = [
          <% if (entity.enabledStandardFields && entity.enabledStandardFields.includes('title')) { %>
          "Titre",
          <% } %>
          <% entity.customFields.forEach(field => { %>
            "<%= field.label %>",
          <% }) %>
          "Créé le",
          "Actions"
        ];

        const dataRows = [
          <% records.forEach(record => { %>
          [
              <% if (entity.enabledStandardFields && entity.enabledStandardFields.includes('title')) { %>
            `<%= record.title || '' %>`,
              <% } %>
              <% entity.customFields.forEach(field => { %>
                <% 
                   // Access field._id directly as we are within the forEach loop in an EJS script block
                   const customField = record.customFields.find(cf => 
                     cf.field_id && (cf.field_id._id || cf.field_id).toString() === field._id.toString()
                   );
                   const val = customField ? customField.value : '';
                %>
                `<%= val %>`,
              <% }) %>
            `<%= new Date(record.createdAt).toLocaleDateString() %>`,
            `<div class="flex items-center gap-2">
                <a href="/account/<%= account_number %>/record/<%= entity.slug %>/edit/<%= record._id %>" class="btn btn-sm btn-outline-info">Modifier</a>
                <a href="/account/<%= account_number %>/record/<%= entity.slug %>/delete/<%= record._id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Confirmer la suppression ?')">Supprimer</a>
              </div>`
            ],
          <% }) %>
        ];

    this.datatable = new simpleDatatables.DataTable("#recordTable", {
      data: {
        headings: headers,
        data: dataRows,
      },
      perPage: 10,
      perPageSelect: [10, 20, 30, 50, 100],
      firstLast: true,
      labels: {
        perPage: "{select}",
      },
      layout: {
        top: "{search}",
        bottom: "{info}{select}{pager}",
      },
    });
  },
    }));
  });
</script>

<script src="/themes/default/assets/js/simple-datatables.js"></script>