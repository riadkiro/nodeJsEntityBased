          <h2
            class="-mx-4 mb-1 flex items-center justify-between bg-white-light/30 py-3 px-2 font-extrabold uppercase dark:bg-dark dark:bg-opacity-[0.08]">
            <div class="flex items-center gap-2">
              <iconify-icon icon="solar:share-circle-bold-duotone" width="18" height="18"></iconify-icon>
              <span x-text="'Spaces (' + realSpacesCount + ')'">Spaces</span>
            </div>
            <div class="flex items-center gap-1 pr-2">
              <iconify-icon icon="solar:add-square-bold" width="18" height="18"
                class="cursor-pointer text-primary hover:scale-110 transition-transform"
                @click="createSpace()"></iconify-icon>
            </div>
          </h2>

          <ul class="sortable-root" data-parent-type="root">
            <template x-for="item in hierarchy" :key="item.id">
              <li class="menu nav-item mb-2" :data-id="item.id" data-type="space">
                <div class="nav-link group flex items-center justify-between"
                  :class="{'active' : isExpanded(item.id)}">
                  <div x-data="{ hovered: false }" 
                    class="flex items-center mx-2 cursor-pointer flex-1"
                    @mouseenter="hovered = true" @mouseleave="hovered = false"
                    @click="toggle(item.id)"
                    @contextmenu.prevent="openEditMenu($event, 'space', item)">
                    <iconify-icon :icon="getIcon(item, item.children && item.children.length > 0, isExpanded(item.id), hovered)" 
                      class="ml-1" width="18" height="18" :style="item.color ? 'color: ' + item.color : ''"></iconify-icon>

                    <template x-if="editingId !== item.id">
                      <span
                        class="text-black ltr:pl-2 rtl:pr-2 dark:text-[#506690] dark:group-hover:text-white-dark transition-all"
                        x-text="item.name"></span>
                    </template>
                    <template x-if="editingId === item.id">
                      <input x-ref="editInput" type="text"
                        class="form-input py-0 px-2 h-6 text-sm ml-1 bg-transparent border-primary w-full"
                        x-model="editingName" @keyup.enter="saveRename(item)" @blur="saveRename(item)"
                        x-init="$nextTick(() => $el.focus())">
                    </template>
                  </div>

                  <div class="flex items-center gap-2 pr-4 opacity-0 group-hover:opacity-100 transition-opacity">
                    <iconify-icon icon="solar:add-square-linear" width="16" height="16"
                      class="cursor-pointer hover:text-primary"
                      @click.stop="openCreateMenu($event, item)"></iconify-icon>
                    <iconify-icon icon="solar:menu-dots-bold-duotone" width="16" height="16"
                      class="cursor-pointer hover:text-primary"
                      @click.stop="openEditMenu($event, 'space', item)"></iconify-icon>
                    <div class="rtl:rotate-180 transition-transform"
                      :class="{'!rotate-90' : isExpanded(item.id)}"
                      x-show="item.children && item.children.length > 0">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M9 5L15 12L9 19" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </div>
                  </div>
                </div>

                <ul x-cloak x-show="isExpanded(item.id)" x-collapse class="sub-menu text-gray-500 mx-4 mb-2">
                  <template x-for="child in item.children" :key="child.id">
                    <li x-data="{ hovered: false }" class="relative" :data-id="child.id" :data-type="child.type">
                      <div
                        class="flex items-center hover:bg-gray-100 dark:text-[#888ea8] dark:hover:bg-gray-900 rounded transition-colors group/sub"
                        @mouseenter="hovered = true" @mouseleave="hovered = false"
                        @contextmenu.prevent="openEditMenu($event, child.type, child, item)">
                        <iconify-icon :icon="getIcon(child, child.children && child.children.length > 0, isExpanded(child.id), hovered)"
                          class="ml-2 cursor-pointer" width="16" height="16"
                          :style="child.color ? 'color: ' + child.color : ''"
                          @click.stop="if(['folder', 'environment'].includes(child.type)) { toggle(child.id); }"></iconify-icon>

                        <div class="flex-1 min-w-0">
                          <template x-if="editingId !== child.id">
                            <a :href="child.link || '#'" class="block ml-1 truncate transition-colors"
                              :class="isItemActive(child.link) ? '!text-primary font-bold' : ''"
                              @click="if(['folder', 'environment'].includes(child.type)) { $event.preventDefault(); toggle(child.id); }">
                              <span x-text="child.name"></span>
                            </a>
                          </template>
                          <template x-if="editingId === child.id">
                            <input x-ref="editInput" type="text"
                              class="form-input py-0 px-2 h-6 text-sm ml-1 bg-transparent border-primary w-full"
                              x-model="editingName" @keyup.enter="saveRename(child)" @blur="saveRename(child)"
                              x-init="$nextTick(() => $el.focus())">
                          </template>
                        </div>

                        <div class="flex items-center gap-1 pr-4 transition-opacity"
                          :class="hovered ? 'opacity-100' : 'opacity-0'">
                          <template x-if="child.type !== 'entity'">
                            <iconify-icon icon="solar:add-square-linear" width="14" height="14"
                              class="cursor-pointer hover:text-primary"
                              @click.stop="openCreateMenu($event, child)"></iconify-icon>
                          </template>
                          <iconify-icon icon="solar:menu-dots-bold-duotone" width="14" height="14"
                            class="cursor-pointer hover:text-primary"
                            @click.stop="openEditMenu($event, child.type, child, item)"></iconify-icon>
                        </div>

                      </div>

                      <!-- Nested children for Folders/Environments -->
                      <ul x-show="['folder', 'environment'].includes(child.type) && isExpanded(child.id)" x-collapse
                        class="sub-menu text-gray-500 ltr:ml-4 rtl:mr-4 border-l dark:border-gray-800 ml-4">
                        <template x-for="subChild in child.children" :key="subChild.id">
                          <li x-data="{ hovered: false }"
                            x-init="if (subChild.children && subChild.children.some(c => isItemActive(c.link))) toggleExpand(subChild.id, true)"
                            class="relative block" :data-id="subChild.id" :data-type="subChild.type">
                            <div class="flex items-center hover:bg-gray-100 rounded transition-colors group/sub2"
                              :class="{'bg-gray-100': isExpanded(subChild.id)}"
                              @mouseenter="hovered = true" @mouseleave="hovered = false"
                              @contextmenu.prevent="openEditMenu($event, subChild.type, subChild, child)">
                              <iconify-icon :icon="getIcon(subChild, subChild.children && subChild.children.length > 0, isExpanded(subChild.id), hovered)"
                                class="ml-2 cursor-pointer" width="16" height="16"
                                :style="subChild.color ? 'color: ' + subChild.color : ''"
                                @click.stop="if(['folder', 'environment'].includes(subChild.type)) { toggleExpand(subChild.id); }"></iconify-icon>
                              <div class="flex-1 truncate min-w-0">
                                <template x-if="editingId !== subChild.id">
                                  <a :href="subChild.link || '#'" class="ml-1 text-sm transition-colors block py-1"
                                    :class="isItemActive(subChild.link) ? '!text-primary font-bold' : ''"
                                    @click="if(['folder', 'environment'].includes(subChild.type)) { $event.preventDefault(); toggleExpand(subChild.id); }"
                                    x-text="subChild.name"></a>
                                </template>
                                <template x-if="editingId === subChild.id">
                                  <input x-ref="editInput" type="text"
                                    class="form-input py-0 px-2 h-6 text-sm ml-1 bg-transparent border-primary w-full"
                                    x-model="editingName" @keyup.enter="saveRename(subChild)" @blur="saveRename(subChild)"
                                    x-init="$nextTick(() => $el.focus())">
                                </template>
                              </div>
                              <div class="flex items-center gap-1 pr-4 transition-opacity"
                                :class="hovered ? 'opacity-100' : 'opacity-0'">
                                <template x-if="['folder', 'environment'].includes(subChild.type)">
                                  <iconify-icon icon="solar:add-square-linear" width="14" height="14"
                                    class="cursor-pointer hover:text-primary"
                                    @click.stop="openCreateMenu($event, subChild)"></iconify-icon>
                                </template>
                                <iconify-icon icon="solar:menu-dots-bold-duotone" width="14" height="14"
                                  class="cursor-pointer hover:text-primary"
                                  @click.stop="openEditMenu($event, subChild.type, subChild, child)"></iconify-icon>
                              </div>


                            </div>

                            <ul x-show="['folder', 'environment'].includes(subChild.type) && isExpanded(subChild.id)" x-collapse
                              class="sub-menu text-gray-500 ltr:ml-4 rtl:mr-4 border-l dark:border-gray-800 ml-4">
                              <template x-for="subSubChild in subChild.children" :key="subSubChild.id">
                                <li x-data="{ hovered: false }"
                                  class="flex items-center hover:bg-gray-100 rounded transition-colors group/sub3"
                                  @mouseenter="hovered = true" @mouseleave="hovered = false"
                                  @contextmenu.prevent="openEditMenu($event, subSubChild.type, subSubChild, subChild)"
                                  :data-id="subSubChild.id" :data-type="subSubChild.type">
                                  <iconify-icon :icon="getIcon(subSubChild)" class="ml-2" width="16"
                                    height="16" :style="subSubChild.color ? 'color: ' + subSubChild.color : ''"></iconify-icon>
                                  <div class="flex-1 truncate">
                                    <template x-if="editingId !== subSubChild.id">
                                      <a :href="subSubChild.link || '#'" class="ml-1 text-sm transition-colors block py-1"
                                        :class="isItemActive(subSubChild.link) ? '!text-primary font-bold' : ''"
                                        x-text="subSubChild.name"></a>
                                    </template>
                                    <template x-if="editingId === subSubChild.id">
                                      <input x-ref="editInput" type="text"
                                        class="form-input py-0 px-2 h-6 text-sm ml-1 bg-transparent border-primary w-full"
                                        x-model="editingName" @keyup.enter="saveRename(subSubChild)"
                                        @blur="saveRename(subSubChild)" x-init="$nextTick(() => $el.focus())">
                                    </template>
                                  </div>
                                  <div class="flex items-center gap-1 pr-4 transition-opacity"
                                    :class="hovered ? 'opacity-100' : 'opacity-0'">
                                    <iconify-icon icon="solar:menu-dots-bold-duotone" width="14" height="14"
                                      class="cursor-pointer hover:text-primary"
                                      @click.stop="openEditMenu($event, subSubChild.type, subSubChild, subChild)"></iconify-icon>
                                  </div>
                                </li>
                              </template>
                              <li x-show="!subChild.children || subChild.children.length === 0" class="flex items-center hover:bg-gray-100 rounded transition-colors dark:hover:bg-gray-900 cursor-pointer" @click.stop="openCreateMenu($event, subChild)">
                                  <iconify-icon icon="solar:add-square-linear" class="ml-2 text-primary" width="16" height="16"></iconify-icon>
                                  <span class="ml-2 text-sm text-primary py-1">Ajouter</span>
                              </li>
                            </ul>
                          </li>
                        </template>
                        <li x-show="!child.children || child.children.length === 0" class="flex items-center hover:bg-gray-100 rounded transition-colors dark:hover:bg-gray-900 cursor-pointer" @click.stop="openCreateMenu($event, child)">
                            <iconify-icon icon="solar:add-square-linear" class="ml-2 text-primary" width="16" height="16"></iconify-icon>
                            <span class="ml-2 text-sm text-primary py-1">Ajouter</span>
                        </li>
                      </ul>

                    </li>
                  </template>
                </ul>
              </li>
            </template>
          </ul>
