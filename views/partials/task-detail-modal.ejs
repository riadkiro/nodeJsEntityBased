<!-- Shared Task Detail Modal — reusable across hub + record pages -->

<style>
/* ═══ Task Detail Modal — aligned with record tasks surface ═══ */
.tdm-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.34);backdrop-filter:blur(4px);z-index:998;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .22s}
.tdm-backdrop.open{opacity:1;pointer-events:auto}
.tdm-modal{width:min(1220px,calc(100vw - 42px));height:min(780px,calc(100vh - 42px));background:#fff;border-radius:16px;box-shadow:0 28px 90px rgba(15,23,42,.20);display:flex;flex-direction:column;transform:scale(.96) translateY(10px);transition:transform .28s cubic-bezier(.2,.8,.2,1);overflow:hidden;color:#0e1726}
.tdm-backdrop.open .tdm-modal{transform:scale(1) translateY(0)}
.tdm-shell{display:flex;flex-direction:column;height:100%;min-height:0}
.tdm-head{height:64px;display:flex;align-items:center;gap:11px;padding:0 26px;border-bottom:1px solid #f1f3f5;flex:0 0 auto}
.tdm-head-icon{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#6366f118,#6366f108);color:#6366f1;flex:0 0 auto}
.tdm-head-label{color:#7c89a6;font-size:12.5px;font-weight:700;line-height:1.3;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tdm-close{width:32px;height:32px;border:0;border-radius:9px;background:#f8fafc;color:#94a3b8;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .14s}
.tdm-close:hover{background:#eef2f7;color:#64748b}
.tdm-body{flex:1;min-height:0;display:grid;grid-template-columns:minmax(340px,1.08fr) minmax(285px,.74fr) minmax(330px,.9fr);overflow:hidden}
.tdm-main{padding:28px 32px;overflow-y:auto;border-right:1px solid #f1f3f5}
.tdm-props{padding:26px 20px;overflow-y:auto;border-right:1px solid #f1f3f5}
.tdm-conv{display:flex;flex-direction:column;min-width:0;min-height:0;height:100%;overflow:hidden;background:#fafbfc}
.tdm-title-input{width:100%;border:0;border-bottom:2px solid transparent;outline:0;background:transparent;font-family:inherit;font-size:20px;font-weight:600;line-height:1.3;color:#0e1726;padding:0 0 15px;transition:border-color .16s}
.tdm-title-input:focus{border-bottom-color:#4361ee}
.tdm-section-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:20px 0 8px}
.tdm-section-label{margin:0;color:#94a3b8;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.45px;line-height:1.2}
.tdm-desc{min-height:205px;width:100%;border:1.5px solid #e8ecf1;border-radius:10px;background:#fafbfc;color:#0e1726;font-size:13px;font-weight:500;line-height:1.6;padding:12px 14px;resize:vertical;font-family:inherit;outline:none;transition:all .16s}
.tdm-desc:focus{border-color:#4361ee;background:#fff;box-shadow:0 0 0 3px #4361ee10}
.tdm-desc::placeholder,.tdm-msg-input::placeholder,.tdm-option-search::placeholder,.tdm-prop-input::placeholder,.tdm-invite-input::placeholder{color:#bfc9d4}
.tdm-mini-btn{height:28px;border:1px solid #e0e7ff;background:#fff;color:#4f46e5;border-radius:8px;padding:0 10px;font-family:inherit;font-size:11.5px;font-weight:700;display:inline-flex;align-items:center;gap:6px;cursor:pointer;transition:all .14s}
.tdm-mini-btn:hover{background:#eef2ff;border-color:#c7d2fe}
.tdm-attachments{margin-top:4px}
.tdm-attachment-drop{border:1.5px dashed #dbe4f0;border-radius:11px;background:#fbfcff;min-height:74px;padding:10px;display:flex;flex-direction:column;gap:7px;transition:all .14s}
.tdm-attachment-drop:hover{border-color:#c7d2fe;background:#f8faff}
.tdm-attachment-empty{min-height:52px;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:12px;font-weight:500;text-align:center}
.tdm-attachment-item{min-height:38px;display:flex;align-items:center;gap:9px;border:1px solid #eef2f7;border-radius:9px;background:#fff;padding:7px 8px;color:#334155;text-decoration:none}
.tdm-attachment-icon{width:26px;height:26px;border-radius:8px;background:#eef2ff;color:#4f46e5;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.tdm-attachment-meta{min-width:0;flex:1}
.tdm-attachment-name{display:block;color:#1e293b;font-size:12.3px;font-weight:600;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tdm-attachment-size{display:block;margin-top:2px;color:#94a3b8;font-size:10.5px;font-weight:600;line-height:1.2}
.tdm-attachment-remove{width:26px;height:26px;border:0;border-radius:7px;background:transparent;color:#cbd5e1;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .14s}
.tdm-attachment-remove:hover{background:#fef2f2;color:#ef4444}
.tdm-prop{display:flex;align-items:center;gap:10px;min-height:46px;padding:8px 0;border-bottom:1px solid #f8f9fa}
.tdm-prop:last-child{border-bottom:none}
.tdm-prop-icon{width:16px;color:#bfc9d4;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.tdm-prop-label{min-width:78px;color:#94a3b8;font-size:11.5px;font-weight:600;line-height:1.2}
.tdm-prop-value{flex:1;min-width:0;display:flex;align-items:center;justify-content:flex-end;gap:6px;position:relative}
.tdm-prop-text{color:#0e1726;font-size:13px;font-weight:600;line-height:1.25;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tdm-prop-input{width:100%;height:32px;border:1.5px solid transparent;border-radius:8px;background:#f8fafc;color:#0e1726;font-family:inherit;font-size:13px;font-weight:500;padding:0 9px;outline:none;transition:all .15s}
.tdm-prop-input:focus{border-color:#4361ee;background:#fff}
.tdm-pill{min-height:28px;border:0;border-radius:7px;padding:5px 10px;display:inline-flex;align-items:center;gap:6px;font-family:inherit;font-size:12px;font-weight:600;line-height:1.2;cursor:pointer;transition:filter .14s;max-width:100%}
.tdm-pill:hover{filter:brightness(.96)}
.tdm-pill-dot{width:7px;height:7px;border-radius:999px;flex:0 0 auto}
.tdm-toggle{position:relative;width:36px;height:20px;border-radius:999px;background:#e2e8f0;cursor:pointer;transition:background .18s;border:none;padding:0;flex:0 0 auto}
.tdm-toggle.active{background:#10b981}
.tdm-toggle::after{content:'';position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;transition:transform .18s;box-shadow:0 1px 3px rgba(0,0,0,.15)}
.tdm-toggle.active::after{transform:translateX(16px)}
.tdm-prop-datetime{display:flex;align-items:center;gap:6px;min-width:0;width:100%;justify-content:flex-end}
.tdm-prop-date,.tdm-prop-time{height:32px;border:1.5px solid transparent;border-radius:8px;background:#f8fafc;color:#0e1726;font-family:inherit;font-size:13px;font-weight:500;padding:0 8px;outline:none;cursor:pointer;transition:all .15s}
.tdm-prop-date{min-width:132px;max-width:145px}
.tdm-prop-time{width:76px}
.tdm-prop-date:focus,.tdm-prop-time:focus{border-color:#4361ee;background:#fff}
.tdm-prop-time:disabled{opacity:.45;cursor:not-allowed}
.tdm-option-popover{position:absolute;top:calc(100% + 8px);right:0;width:292px;background:#fff;border:1px solid #e8ecf1;border-radius:12px;box-shadow:0 16px 44px rgba(15,23,42,.14);padding:10px;z-index:70}
.tdm-option-search{width:100%;height:34px;border:1.5px solid #e8ecf1;border-radius:9px;background:#fff;color:#0e1726;font-family:inherit;font-size:12.5px;font-weight:500;padding:0 10px;outline:0;margin-bottom:7px}
.tdm-option-search:focus{border-color:#4361ee;box-shadow:0 0 0 3px #4361ee10}
.tdm-option-list{display:flex;flex-direction:column;gap:2px;max-height:190px;overflow-y:auto;padding-right:2px}
.tdm-option-row{height:34px;border:0;background:transparent;border-radius:8px;padding:0 7px;display:flex;align-items:center;gap:8px;color:#0e1726;font-family:inherit;font-size:12.5px;font-weight:500;cursor:pointer;text-align:left}
.tdm-option-row:hover,.tdm-option-row.active{background:#f8fafc}
.tdm-option-row-label{min-width:0;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tdm-option-action{width:24px;height:24px;border:0;border-radius:7px;background:transparent;color:#cbd5e1;display:flex;align-items:center;justify-content:center;cursor:pointer}
.tdm-option-action:hover{background:#eef2ff;color:#4f46e5}
.tdm-option-create{width:100%;height:34px;border:1px dashed #c7d2fe;background:#f8faff;color:#4f46e5;border-radius:9px;margin-top:7px;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer}
.tdm-option-editor{margin-top:9px;padding-top:9px;border-top:1px solid #eef2f7}
.tdm-option-editor-title{color:#94a3b8;font-size:10.5px;font-weight:750;text-transform:uppercase;letter-spacing:.4px;margin-bottom:7px}
.tdm-option-editor-input{width:100%;height:32px;border:1.5px solid #e8ecf1;border-radius:8px;background:#fff;color:#0e1726;font-family:inherit;font-size:12.5px;font-weight:500;padding:0 9px;outline:0}
.tdm-option-editor-input:focus{border-color:#4361ee;box-shadow:0 0 0 3px #4361ee10}
.tdm-color-grid{display:flex;flex-wrap:wrap;gap:6px;margin:9px 0}
.tdm-color-swatch{width:22px;height:22px;border-radius:6px;border:2px solid transparent;cursor:pointer;transition:all .1s}
.tdm-color-swatch:hover,.tdm-color-swatch.active{border-color:#0e1726;transform:scale(1.08)}
.tdm-option-editor-actions{display:flex;align-items:center;gap:7px}
.tdm-option-editor-actions button{height:30px;border-radius:8px;border:0;font-family:inherit;font-size:11.5px;font-weight:700;cursor:pointer;padding:0 10px}
.tdm-option-save{background:#4361ee;color:#fff}
.tdm-option-cancel{background:#f1f5f9;color:#64748b}
.tdm-option-delete{margin-left:auto;background:#fef2f2;color:#ef4444}
.tdm-assign-btn{width:100%;min-height:32px;border:0;border-radius:8px;background:#f8fafc;color:#0e1726;font-family:inherit;font-size:12px;font-weight:600;line-height:1.2;padding:6px 9px;display:flex;align-items:center;justify-content:space-between;gap:8px;cursor:pointer;text-align:left;transition:all .15s}
.tdm-assign-btn:hover,.tdm-assign-btn.active{background:#eef2ff;color:#4361ee}
.tdm-assign-label{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tdm-assign-popover{position:absolute;top:calc(100% + 8px);right:0;width:300px;background:#fff;border:1px solid #e8ecf1;border-radius:12px;box-shadow:0 16px 44px rgba(15,23,42,.14);padding:10px;z-index:72}
.tdm-assign-list{display:flex;flex-direction:column;gap:3px;max-height:190px;overflow-y:auto}
.tdm-assign-row{min-height:36px;border:0;border-radius:9px;background:transparent;padding:5px 7px;display:grid;grid-template-columns:26px minmax(0,1fr) auto;align-items:center;gap:8px;font-family:inherit;text-align:left;color:#0e1726;cursor:pointer}
.tdm-assign-row:hover,.tdm-assign-row.active{background:#f8fafc}
.tdm-assign-avatar{width:26px;height:26px;border-radius:9px;background:#eef2ff;color:#4361ee;display:grid;place-items:center;font-size:11px;font-weight:800;overflow:hidden}
.tdm-assign-avatar img{width:100%;height:100%;object-fit:cover}
.tdm-assign-name{display:block;font-size:12px;font-weight:700;line-height:1.2;color:#0e1726;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tdm-assign-email{display:block;margin-top:1px;font-size:10.5px;font-weight:600;line-height:1.2;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tdm-assign-empty{padding:10px;border:1px dashed #dbe4f0;border-radius:10px;background:#fbfcff;color:#94a3b8;font-size:12px;font-weight:600;line-height:1.45;text-align:center}
.tdm-invite-box{margin-top:9px;padding-top:9px;border-top:1px solid #eef2f7;display:flex;flex-direction:column;gap:7px}
.tdm-invite-label{font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:.35px;color:#94a3b8}
.tdm-invite-row{display:flex;gap:6px}
.tdm-invite-input{min-width:0;flex:1;height:32px;border:1.5px solid #e8ecf1;border-radius:8px;background:#fff;color:#0e1726;font-family:inherit;font-size:12px;font-weight:500;padding:0 9px;outline:0}
.tdm-invite-input:focus{border-color:#4361ee;box-shadow:0 0 0 3px #4361ee10}
.tdm-invite-btn{height:32px;border:0;border-radius:8px;background:#4361ee;color:#fff;font-family:inherit;font-size:11.5px;font-weight:800;padding:0 10px;cursor:pointer}
.tdm-invite-btn:disabled{opacity:.55;cursor:not-allowed}
.tdm-clear-assign{border-top:1px solid #eef2f7;margin-top:7px;padding-top:7px}
.tdm-clear-assign button{width:100%;height:32px;border:0;border-radius:8px;background:#fff;color:#64748b;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;text-align:left;padding:0 8px}
.tdm-clear-assign button:hover{background:#f8fafc;color:#ef4444}
.tdm-conv-head{height:50px;display:flex;align-items:center;gap:8px;padding:0 18px;border-bottom:1px solid #f1f3f5;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;flex:0 0 auto}
.tdm-conv-head iconify-icon{color:#4361ee}
.tdm-conv-feed{flex:1;min-height:0;max-height:100%;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;padding:14px 12px;display:flex;flex-direction:column;gap:7px}
.tdm-conv-feed::-webkit-scrollbar{width:7px}
.tdm-conv-feed::-webkit-scrollbar-track{background:transparent}
.tdm-conv-feed::-webkit-scrollbar-thumb{background:#dbe4f0;border-radius:999px}
.tdm-conv-feed:hover::-webkit-scrollbar-thumb{background:#cbd5e1}
.tdm-conv-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:#bfc9d4;font-size:12px;font-weight:500;text-align:center;padding:20px}
.tdm-conv-entry{align-self:flex-start;max-width:92%;padding:7px 10px;border-radius:12px;background:#fff;border:1px solid #e8ecf1}
.tdm-conv-activity{align-self:center;text-align:center;background:#f8fafc;border-color:#eef2f7;color:#94a3b8}
.tdm-conv-user{color:#64748b;font-size:10.5px;font-weight:700;line-height:1.3}
.tdm-conv-text{color:#334155;font-size:12.5px;font-weight:500;line-height:1.5;white-space:pre-wrap;word-break:break-word}
.tdm-conv-date{color:#bfc9d4;font-size:9.5px;font-weight:600;margin-top:3px}
.tdm-activity-val{display:inline-flex;align-items:center;gap:4px;border-radius:5px;padding:1px 6px;font-size:9.5px;font-weight:700}
.tdm-msg-wrap{padding:10px 12px;border-top:1px solid #f1f3f5;flex:0 0 auto}
.tdm-msg-input{width:100%;min-height:44px;max-height:98px;border:1.5px solid #e8ecf1;border-radius:10px;color:#0e1726;font-family:inherit;font-size:12px;font-weight:500;line-height:1.5;padding:9px 12px;outline:none;background:#fff;resize:none;transition:all .15s}
.tdm-msg-input:focus{border-color:#4361ee;box-shadow:0 0 0 3px #4361ee10}
.tdm-foot{height:58px;border-top:1px solid #f1f3f5;display:flex;align-items:center;justify-content:space-between;padding:0 24px;flex:0 0 auto}
.tdm-foot-created,.tdm-foot-esc{color:#bfc9d4;font-size:11px;font-weight:600}
.tdm-delete{height:36px;border:1.5px solid #fecaca;background:#fff;color:#ef4444;border-radius:9px;padding:0 14px;font-family:inherit;font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:6px;cursor:pointer;transition:all .14s}
.tdm-delete:hover{background:#fef2f2;border-color:#ef4444}
.tdm-hidden-input{display:none}

.dark .tdm-modal{background:#0e1726;color:#e0e6ed;box-shadow:0 32px 90px rgba(0,0,0,.45)}
.dark .tdm-head,.dark .tdm-main,.dark .tdm-props,.dark .tdm-conv,.dark .tdm-conv-head,.dark .tdm-msg-wrap,.dark .tdm-foot{border-color:#253b5c}
.dark .tdm-conv,.dark .tdm-attachment-drop{background:#0b1320}
.dark .tdm-title-input,.dark .tdm-desc,.dark .tdm-msg-input,.dark .tdm-prop-input,.dark .tdm-prop-date,.dark .tdm-prop-time,.dark .tdm-option-popover,.dark .tdm-option-search,.dark .tdm-option-editor-input,.dark .tdm-assign-popover,.dark .tdm-invite-input{background:#111f35;border-color:#253b5c;color:#e0e6ed}
.dark .tdm-option-row{color:#e0e6ed}
.dark .tdm-option-row:hover,.dark .tdm-option-row.active,.dark .tdm-assign-row:hover,.dark .tdm-assign-row.active{background:#1b2e4b}
.dark .tdm-attachment-item,.dark .tdm-conv-entry{background:#111f35;border-color:#253b5c}
.dark .tdm-attachment-name,.dark .tdm-prop-text,.dark .tdm-conv-text,.dark .tdm-assign-name{color:#e0e6ed}
.dark .tdm-close{background:#17233a;color:#8ea0bd}
.dark .tdm-close:hover{background:#253b5c;color:#e0e6ed}

@media(max-width:1040px){
    .tdm-modal{width:96vw;height:94vh}
    .tdm-body{grid-template-columns:1fr;overflow:auto}
    .tdm-main,.tdm-props{border-right:0;border-bottom:1px solid #f1f3f5;overflow:visible}
    .tdm-conv{min-height:360px}
}
@media(max-width:640px){
    .tdm-modal{width:100vw;height:100vh;border-radius:0}
    .tdm-head{padding:0 16px}
    .tdm-main,.tdm-props{padding:20px 16px}
    .tdm-prop{align-items:flex-start}
    .tdm-prop-value{justify-content:flex-start}
    .tdm-prop-datetime{justify-content:flex-start;flex-wrap:wrap}
	    .tdm-option-popover,.tdm-assign-popover{right:auto;left:0;width:min(292px,calc(100vw - 32px))}
}
</style>

<!-- ═══ Modal HTML ═══ -->
<div x-data x-show="$store.taskModal.task" x-cloak>
    <div class="tdm-backdrop" :class="{'open': $store.taskModal.task}" @click.self="$store.taskModal.close()">
        <div class="tdm-modal" @keydown.escape.window="$store.taskModal.close()" @click="$store.taskModal.closeMenus()">
            <template x-if="$store.taskModal.task">
                <div class="tdm-shell">
                    <div class="tdm-head">
                        <span class="tdm-head-icon">
                            <iconify-icon :icon="$store.taskModal.task.listIcon || 'solar:checklist-bold-duotone'" width="16"></iconify-icon>
                        </span>
                        <span class="tdm-head-label" x-text="$store.taskModal.task.listLabel || 'Liste des tâches'"></span>
                        <button class="tdm-close" type="button" @click="$store.taskModal.close()"><iconify-icon icon="solar:close-circle-linear" width="18"></iconify-icon></button>
                    </div>

                    <div class="tdm-body">
                        <div class="tdm-main">
                            <input type="text" class="tdm-title-input" placeholder="Titre de la tâche..." x-model="$store.taskModal.task.title" @change="$store.taskModal.updateField('title', $store.taskModal.task.title)">

                            <div class="tdm-section-row">
                                <div class="tdm-section-label">Description</div>
                            </div>
                            <textarea class="tdm-desc" placeholder="Ajouter une description détaillée..." x-model="$store.taskModal.task.description" @change="$store.taskModal.updateField('description', $store.taskModal.task.description)"></textarea>

                            <div class="tdm-attachments">
                                <div class="tdm-section-row">
                                    <div class="tdm-section-label">Pièces jointes</div>
                                    <button class="tdm-mini-btn" type="button" @click.stop="$refs.taskAttachmentInput.click()" :disabled="$store.taskModal.uploadBusy">
                                        <iconify-icon icon="solar:paperclip-rounded-linear" width="14"></iconify-icon>
                                        Ajouter
                                    </button>
                                </div>
                                <input class="tdm-hidden-input" x-ref="taskAttachmentInput" type="file" multiple @change="$store.taskModal.uploadAttachments($event.target.files); $event.target.value = ''">
                                <div class="tdm-attachment-drop" @dragover.prevent @drop.prevent="$store.taskModal.uploadAttachments($event.dataTransfer.files)">
                                    <template x-if="!($store.taskModal.task.attachments || []).length">
                                        <div class="tdm-attachment-empty" x-text="$store.taskModal.uploadBusy ? 'Ajout en cours...' : 'Déposez des fichiers ici ou utilisez Ajouter'"></div>
                                    </template>
                                    <template x-for="attachment in ($store.taskModal.task.attachments || [])" :key="attachment._id || attachment.filename">
                                        <div class="tdm-attachment-item">
                                            <span class="tdm-attachment-icon">
                                                <iconify-icon :icon="$store.taskModal.attachmentIcon(attachment)" width="15"></iconify-icon>
                                            </span>
                                            <a class="tdm-attachment-meta" :href="$store.taskModal.attachmentUrl(attachment)" target="_blank" rel="noopener" @click.stop>
                                                <span class="tdm-attachment-name" x-text="attachment.originalName || attachment.filename || 'Fichier'"></span>
                                                <span class="tdm-attachment-size" x-text="$store.taskModal.formatBytes(attachment.size)"></span>
                                            </a>
                                            <button class="tdm-attachment-remove" type="button" title="Retirer" @click.stop="$store.taskModal.deleteAttachment(attachment)">
                                                <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="14"></iconify-icon>
                                            </button>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </div>

                        <div class="tdm-props">
                            <div class="tdm-prop">
                                <span class="tdm-prop-icon"><iconify-icon icon="solar:check-circle-linear" width="15"></iconify-icon></span>
                                <span class="tdm-prop-label">Statut</span>
                                <div class="tdm-prop-value" @click.stop>
                                    <button type="button" class="tdm-pill"
                                            :style="$store.taskModal.pillStyle('status', $store.taskModal.task.status)"
                                            @click="$store.taskModal.toggleOptionMenu('status')">
                                        <span class="tdm-pill-dot" :style="'background:' + $store.taskModal.optionColor('status', $store.taskModal.task.status)"></span>
                                        <span x-text="$store.taskModal.task.status || 'À faire'"></span>
                                    </button>
                                    <div class="tdm-option-popover" x-show="$store.taskModal.optionMenu === 'status'" x-cloak @click.stop>
                                        <input class="tdm-option-search" type="text" placeholder="Rechercher ou créer..." x-model="$store.taskModal.optionSearch.status">
                                        <div class="tdm-option-list">
                                            <template x-for="option in $store.taskModal.filteredOptions('status')" :key="option.label">
                                                <button type="button" class="tdm-option-row" :class="{'active': option.label === $store.taskModal.task.status}" @click="$store.taskModal.selectOption('status', option)">
                                                    <span class="tdm-pill-dot" :style="'background:' + option.color"></span>
                                                    <span class="tdm-option-row-label" x-text="option.label"></span>
                                                    <span class="tdm-option-action" @click.stop="$store.taskModal.openOptionEditor('status', option)">
                                                        <iconify-icon icon="solar:menu-dots-bold" width="14"></iconify-icon>
                                                    </span>
                                                </button>
                                            </template>
                                        </div>
                                        <template x-if="$store.taskModal.canCreateOption('status')">
                                            <button type="button" class="tdm-option-create" @click="$store.taskModal.createOption('status')" x-text="'Créer “' + $store.taskModal.optionSearch.status.trim() + '”'"></button>
                                        </template>
                                        <template x-if="$store.taskModal.optionEditor && $store.taskModal.optionEditor.kind === 'status'">
                                            <div class="tdm-option-editor">
                                                <div class="tdm-option-editor-title">Modifier le statut</div>
                                                <input class="tdm-option-editor-input" type="text" x-model="$store.taskModal.optionEditor.label">
                                                <div class="tdm-color-grid">
                                                    <template x-for="color in $store.taskModal.colorPalette" :key="color">
                                                        <button type="button" class="tdm-color-swatch" :class="{'active': $store.taskModal.optionEditor.color === color}" :style="'background:' + color" @click="$store.taskModal.optionEditor.color = color"></button>
                                                    </template>
                                                </div>
                                                <div class="tdm-option-editor-actions">
                                                    <button type="button" class="tdm-option-save" @click="$store.taskModal.saveOptionEditor()">Enregistrer</button>
                                                    <button type="button" class="tdm-option-cancel" @click="$store.taskModal.optionEditor = null">Annuler</button>
                                                    <button type="button" class="tdm-option-delete" @click="$store.taskModal.deleteEditedOption()">Supprimer</button>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </div>
                            </div>

                            <div class="tdm-prop">
                                <span class="tdm-prop-icon"><iconify-icon icon="solar:flag-linear" width="15"></iconify-icon></span>
                                <span class="tdm-prop-label">Priorité</span>
                                <div class="tdm-prop-value" @click.stop>
                                    <button type="button" class="tdm-pill"
                                            :style="$store.taskModal.pillStyle('priority', $store.taskModal.task.priority)"
                                            @click="$store.taskModal.toggleOptionMenu('priority')">
                                        <span class="tdm-pill-dot" :style="'background:' + $store.taskModal.optionColor('priority', $store.taskModal.task.priority)"></span>
                                        <span x-text="$store.taskModal.task.priority || 'Aucune'"></span>
                                    </button>
                                    <div class="tdm-option-popover" x-show="$store.taskModal.optionMenu === 'priority'" x-cloak @click.stop>
                                        <input class="tdm-option-search" type="text" placeholder="Rechercher ou créer..." x-model="$store.taskModal.optionSearch.priority">
                                        <div class="tdm-option-list">
                                            <template x-for="option in $store.taskModal.filteredOptions('priority')" :key="option.label">
                                                <button type="button" class="tdm-option-row" :class="{'active': option.label === $store.taskModal.task.priority}" @click="$store.taskModal.selectOption('priority', option)">
                                                    <span class="tdm-pill-dot" :style="'background:' + option.color"></span>
                                                    <span class="tdm-option-row-label" x-text="option.label"></span>
                                                    <span class="tdm-option-action" @click.stop="$store.taskModal.openOptionEditor('priority', option)">
                                                        <iconify-icon icon="solar:menu-dots-bold" width="14"></iconify-icon>
                                                    </span>
                                                </button>
                                            </template>
                                        </div>
                                        <template x-if="$store.taskModal.canCreateOption('priority')">
                                            <button type="button" class="tdm-option-create" @click="$store.taskModal.createOption('priority')" x-text="'Créer “' + $store.taskModal.optionSearch.priority.trim() + '”'"></button>
                                        </template>
                                        <template x-if="$store.taskModal.optionEditor && $store.taskModal.optionEditor.kind === 'priority'">
                                            <div class="tdm-option-editor">
                                                <div class="tdm-option-editor-title">Modifier la priorité</div>
                                                <input class="tdm-option-editor-input" type="text" x-model="$store.taskModal.optionEditor.label">
                                                <div class="tdm-color-grid">
                                                    <template x-for="color in $store.taskModal.colorPalette" :key="color">
                                                        <button type="button" class="tdm-color-swatch" :class="{'active': $store.taskModal.optionEditor.color === color}" :style="'background:' + color" @click="$store.taskModal.optionEditor.color = color"></button>
                                                    </template>
                                                </div>
                                                <div class="tdm-option-editor-actions">
                                                    <button type="button" class="tdm-option-save" @click="$store.taskModal.saveOptionEditor()">Enregistrer</button>
                                                    <button type="button" class="tdm-option-cancel" @click="$store.taskModal.optionEditor = null">Annuler</button>
                                                    <button type="button" class="tdm-option-delete" @click="$store.taskModal.deleteEditedOption()">Supprimer</button>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </div>
                            </div>

                            <div class="tdm-prop">
                                <span class="tdm-prop-icon"><iconify-icon icon="solar:bolt-bold-duotone" width="15"></iconify-icon></span>
                                <span class="tdm-prop-label">Priorité jour</span>
                                <div class="tdm-prop-value">
                                    <button type="button" class="tdm-toggle" :class="{'active': $store.taskModal.task.isDayPriority}" @click.stop="$store.taskModal.task.isDayPriority = !$store.taskModal.task.isDayPriority; $store.taskModal.updateField('isDayPriority', $store.taskModal.task.isDayPriority)"></button>
                                </div>
                            </div>

	                            <div class="tdm-prop">
	                                <span class="tdm-prop-icon"><iconify-icon icon="solar:user-linear" width="15"></iconify-icon></span>
	                                <span class="tdm-prop-label">Assigner à</span>
	                                <div class="tdm-prop-value" @click.stop>
	                                    <button type="button"
	                                            class="tdm-assign-btn"
	                                            :class="{ 'active': $store.taskModal.assignMenu }"
	                                            @click="$store.taskModal.toggleAssignMenu()">
	                                        <span class="tdm-assign-label" x-text="$store.taskModal.assigneeLabel()"></span>
	                                        <iconify-icon icon="solar:alt-arrow-down-linear" width="13"></iconify-icon>
	                                    </button>
	                                    <div class="tdm-assign-popover" x-show="$store.taskModal.assignMenu" x-transition>
	                                        <template x-if="$store.taskModal.teamLoading">
	                                            <div class="tdm-assign-empty">Chargement de l'équipe...</div>
	                                        </template>
	                                        <template x-if="!$store.taskModal.teamLoading">
	                                            <div>
	                                                <div class="tdm-assign-list">
	                                                    <template x-for="member in $store.taskModal.activeTeamMembers()" :key="member._id || member.email">
	                                                        <button type="button"
	                                                                class="tdm-assign-row"
	                                                                :class="{ 'active': $store.taskModal.isAssignedTo(member) }"
	                                                                @click="$store.taskModal.assignTo(member)">
	                                                            <span class="tdm-assign-avatar">
	                                                                <template x-if="member.avatar"><img :src="member.avatar" alt=""></template>
	                                                                <template x-if="!member.avatar"><span x-text="$store.taskModal.memberInitial(member)"></span></template>
	                                                            </span>
	                                                            <span>
	                                                                <span class="tdm-assign-name" x-text="member.name || member.email || 'Utilisateur'"></span>
	                                                                <span class="tdm-assign-email" x-text="member.email || member.role || ''"></span>
	                                                            </span>
	                                                            <iconify-icon x-show="$store.taskModal.isAssignedTo(member)" icon="solar:check-circle-bold" width="14" style="color:#22c55e"></iconify-icon>
	                                                        </button>
	                                                    </template>
	                                                </div>
	                                                <template x-if="$store.taskModal.activeTeamMembers().length === 0">
	                                                    <div class="tdm-assign-empty">Aucun membre disponible pour cette équipe.</div>
	                                                </template>
	                                                <template x-if="$store.taskModal.activeTeamMembers().length <= 1">
	                                                    <div class="tdm-invite-box">
	                                                        <div class="tdm-invite-label">Inviter des personnes à rejoindre votre team</div>
	                                                        <div class="tdm-invite-row">
	                                                            <input class="tdm-invite-input" type="email" placeholder="email@exemple.com" x-model="$store.taskModal.inviteEmail" @keydown.enter.prevent="$store.taskModal.inviteTeamMember()">
	                                                            <button type="button" class="tdm-invite-btn" :disabled="$store.taskModal.inviteBusy" @click="$store.taskModal.inviteTeamMember()">Inviter</button>
	                                                        </div>
	                                                    </div>
	                                                </template>
	                                                <div class="tdm-clear-assign" x-show="$store.taskModal.task.assignedTo">
	                                                    <button type="button" @click="$store.taskModal.clearAssignee()">Retirer l'assignation</button>
	                                                </div>
	                                            </div>
	                                        </template>
	                                    </div>
	                                </div>
	                            </div>

                            <div class="tdm-prop">
                                <span class="tdm-prop-icon"><iconify-icon icon="solar:calendar-linear" width="15"></iconify-icon></span>
                                <span class="tdm-prop-label">Début</span>
                                <div class="tdm-prop-value">
                                    <span class="tdm-prop-datetime">
                                        <input type="date" class="tdm-prop-date"
                                               :value="$store.taskModal.toDateVal($store.taskModal.task.startDate)"
                                               @change="$store.taskModal.updateTaskDatePart('startDate', 'date', $event.target.value || '')">
                                        <input type="time" class="tdm-prop-time"
                                               :value="$store.taskModal.toTimeVal($store.taskModal.task.startDate)"
                                               :disabled="!$store.taskModal.toDateVal($store.taskModal.task.startDate)"
                                               @change="$store.taskModal.updateTaskDatePart('startDate', 'time', $event.target.value || '')">
                                    </span>
                                </div>
                            </div>

                            <div class="tdm-prop">
                                <span class="tdm-prop-icon"><iconify-icon icon="solar:calendar-mark-linear" width="15"></iconify-icon></span>
                                <span class="tdm-prop-label">Échéance</span>
                                <div class="tdm-prop-value">
                                    <span class="tdm-prop-datetime">
                                        <input type="date" class="tdm-prop-date"
                                               :value="$store.taskModal.toDateVal($store.taskModal.task.dueDate)"
                                               @change="$store.taskModal.updateTaskDatePart('dueDate', 'date', $event.target.value || '')">
                                        <input type="time" class="tdm-prop-time"
                                               :value="$store.taskModal.toTimeVal($store.taskModal.task.dueDate)"
                                               :disabled="!$store.taskModal.toDateVal($store.taskModal.task.dueDate)"
                                               @change="$store.taskModal.updateTaskDatePart('dueDate', 'time', $event.target.value || '')">
                                    </span>
                                </div>
                            </div>

                            <div class="tdm-prop">
                                <span class="tdm-prop-icon"><iconify-icon icon="solar:list-linear" width="15"></iconify-icon></span>
                                <span class="tdm-prop-label">Liste</span>
                                <div class="tdm-prop-value">
                                    <span class="tdm-prop-text" x-text="$store.taskModal.task.listLabel || 'Liste des tâches'"></span>
                                </div>
                            </div>
                        </div>

                        <div class="tdm-conv">
                            <div class="tdm-conv-head">
                                <iconify-icon icon="solar:chat-round-dots-bold-duotone" width="15"></iconify-icon>
                                Conversation
                                <span x-text="'(' + (($store.taskModal.task._comments || []).length) + ')'" style="font-weight:500;text-transform:none;letter-spacing:0;font-size:11px"></span>
                            </div>
	                            <div class="tdm-conv-feed" data-task-conversation-feed>
                                <template x-if="!$store.taskModal.task._comments || !$store.taskModal.task._comments.length">
                                    <div class="tdm-conv-empty">
                                        <iconify-icon icon="solar:chat-round-dots-linear" width="32"></iconify-icon>
                                        <span>Aucun message</span>
                                        <span style="font-size:11px">Échangez avec votre équipe ici</span>
                                    </div>
                                </template>
                                <template x-for="comment in ($store.taskModal.task._comments || [])" :key="comment._id || comment.text || comment.createdAt">
                                    <div class="tdm-conv-entry" :class="{'tdm-conv-activity': comment.type === 'activity'}">
                                        <template x-if="comment.type === 'activity'">
                                            <div>
                                                <span class="tdm-conv-user" x-text="comment.userName || 'Système'"></span>
                                                <span class="tdm-conv-text" x-text="' a changé la ' + $store.taskModal.activityFieldLabel(comment.metadata?.field) + ' : '"></span>
                                                <span class="tdm-activity-val" :style="$store.taskModal.activityValueStyle(comment.metadata?.field, comment.metadata?.oldValue)" x-text="comment.metadata?.oldValue || '—'"></span>
                                                <span style="color:#bfc9d4;font-size:10px"> → </span>
                                                <span class="tdm-activity-val" :style="$store.taskModal.activityValueStyle(comment.metadata?.field, comment.metadata?.newValue)" x-text="comment.metadata?.newValue || '—'"></span>
                                                <div class="tdm-conv-date" x-text="$store.taskModal.formatDate(comment.createdAt)"></div>
                                            </div>
                                        </template>
                                        <template x-if="comment.type !== 'activity'">
                                            <div>
                                                <div class="tdm-conv-user" x-text="comment.userName || 'Système'"></div>
                                                <div class="tdm-conv-text" x-text="comment.text"></div>
                                                <div class="tdm-conv-date" x-text="$store.taskModal.formatDate(comment.createdAt)"></div>
                                            </div>
                                        </template>
                                    </div>
                                </template>
                            </div>
                            <div class="tdm-msg-wrap">
                                <textarea class="tdm-msg-input" rows="2" placeholder="Écrire un message..." @keydown.enter.prevent="$store.taskModal.sendComment($event.target.value); $event.target.value = ''"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="tdm-foot">
                        <button class="tdm-delete" type="button" @click="$store.taskModal.remove()"><iconify-icon icon="solar:trash-bin-minimalistic-linear" width="14"></iconify-icon> Supprimer</button>
                        <span class="tdm-foot-created" x-text="'Créée le ' + $store.taskModal.formatLongDate($store.taskModal.task.createdAt)"></span>
                        <span class="tdm-foot-esc">Esc pour fermer</span>
                    </div>
                </div>
            </template>
        </div>
    </div>
</div>

<script>
document.addEventListener('alpine:init', () => {
    const API = '/account/<%= account_number %>';

    Alpine.store('taskModal', {
        task: null,
        statusOptions: [],
        priorityOptions: [],
        optionMenu: null,
	        optionSearch: { status: '', priority: '' },
	        optionEditor: null,
	        uploadBusy: false,
	        teamMembers: [],
	        teamInvitations: [],
	        teamLoading: false,
	        assignMenu: false,
	        inviteEmail: '',
	        inviteBusy: false,
	        _onUpdate: null,
	        _onDelete: null,
        defaults: {
            statuses: [
                { label: 'À faire', color: '#9ca3af', order: 0 },
                { label: 'En cours', color: '#3b82f6', order: 1 },
                { label: 'En revue', color: '#f59e0b', order: 2 },
                { label: 'Terminé', color: '#22c55e', order: 3 },
                { label: 'Bloqué', color: '#ef4444', order: 4 },
            ],
            priorities: [
                { label: 'Aucune', color: '#cbd5e1', order: 0 },
                { label: 'Basse', color: '#22c55e', order: 1 },
                { label: 'Moyenne', color: '#f59e0b', order: 2 },
                { label: 'Haute', color: '#ef4444', order: 3 },
                { label: 'Urgente', color: '#dc2626', order: 4 },
            ]
        },
        colorPalette: ['#6366f1','#3b82f6','#06b6d4','#10b981','#22c55e','#f59e0b','#f97316','#ef4444','#dc2626','#ec4899','#8b5cf6','#64748b'],

	        async open(taskObj, { onUpdate, onDelete } = {}) {
	            window.dispatchEvent(new CustomEvent('close-home-task-menu'));
	            this.closeMenus();
	            this.statusOptions = this.normalizeOptions(taskObj?.statuses, this.defaults.statuses);
            this.priorityOptions = this.normalizeOptions(taskObj?.priorities, this.defaults.priorities);
            this.task = {
                ...taskObj,
                _comments: [],
                attachments: Array.isArray(taskObj?.attachments) ? taskObj.attachments : [],
                status: taskObj?.status || 'À faire',
                priority: taskObj?.priority || 'Aucune'
            };
	            this._onUpdate = onUpdate || null;
	            this._onDelete = onDelete || null;
	            this.loadTeamMembers();

            if (taskObj?._id) {
                try {
                    const taskRes = await fetch(API + '/api/record-tasks/' + taskObj._id, { credentials: 'include' });
                    const taskData = await taskRes.json().catch(() => ({}));
                    if (taskData.success && taskData.task) {
                        const comments = this.task?._comments || [];
                        this.task = { ...this.task, ...taskData.task, _comments: comments };
                        this.statusOptions = this.normalizeOptions(taskData.task.statuses, this.defaults.statuses);
                        this.priorityOptions = this.normalizeOptions(taskData.task.priorities, this.defaults.priorities);
                    }
                } catch (e) {
                    console.warn('[TaskModal] Task fetch error:', e);
                }

                try {
	                    const res = await fetch(API + '/api/record-tasks/' + taskObj._id + '/comments', { credentials: 'include' });
	                    const data = await res.json();
	                    if (data.success && Array.isArray(data.comments) && this.task) {
	                        this.task._comments = this.sortConversation(data.comments);
	                        this.scrollConversationToRecent();
	                    }
	                } catch (e) {
	                    console.warn('[TaskModal] Comments fetch error:', e);
	                }
	            }
	        },

	        sortConversation(comments = []) {
	            return [...(comments || [])].sort((a, b) => {
	                const ad = new Date(a?.createdAt || 0).getTime() || 0;
	                const bd = new Date(b?.createdAt || 0).getTime() || 0;
	                return ad - bd;
	            });
	        },

	        scrollConversationToRecent({ smooth = false } = {}) {
	            const run = () => {
	                const feed = document.querySelector('.tdm-backdrop.open [data-task-conversation-feed]');
	                if (!feed) return;
	                feed.scrollTo({
	                    top: feed.scrollHeight,
	                    behavior: smooth ? 'smooth' : 'auto'
	                });
	            };
	            if (window.Alpine?.nextTick) {
	                window.Alpine.nextTick(() => requestAnimationFrame(run));
	            } else {
	                requestAnimationFrame(run);
	            }
	        },

	        close() {
	            this.task = null;
	            this.closeMenus();
	            this.uploadBusy = false;
	            this.assignMenu = false;
	            this.inviteEmail = '';
	            this.inviteBusy = false;
	            this._onUpdate = null;
	            this._onDelete = null;
	        },

        normalizeOptions(options, fallback = []) {
            const source = Array.isArray(options) && options.length ? options : fallback;
            return source
                .map((item, index) => ({
                    label: String(item?.label || '').trim(),
                    color: item?.color || (fallback[index]?.color || '#94a3b8'),
                    order: Number.isFinite(Number(item?.order)) ? Number(item.order) : index
                }))
                .filter(item => item.label)
                .sort((a, b) => a.order - b.order);
        },

        optionMeta(kind) {
            return kind === 'priority'
                ? { optionsKey: 'priorityOptions', searchKey: 'priority', field: 'priority', colorField: 'priorityColor', endpoint: 'priorities', payload: 'priorities', fallbackColor: '#cbd5e1' }
                : { optionsKey: 'statusOptions', searchKey: 'status', field: 'status', colorField: 'statusColor', endpoint: 'statuses', payload: 'statuses', fallbackColor: '#9ca3af' };
        },

        optionColor(kind, label) {
            const meta = this.optionMeta(kind);
            const found = (this[meta.optionsKey] || []).find(option => option.label === (label || ''));
            return found?.color || this.task?.[meta.colorField] || meta.fallbackColor;
        },

        pillStyle(kind, label) {
            const color = this.optionColor(kind, label);
            return `background:${color}18;color:${color}`;
        },

        toggleOptionMenu(kind) {
            this.optionMenu = this.optionMenu === kind ? null : kind;
            this.optionEditor = null;
            this.optionSearch[kind] = '';
        },

	        closeMenus() {
	            this.optionMenu = null;
	            this.optionEditor = null;
	            this.assignMenu = false;
	        },

	        toggleAssignMenu() {
	            this.optionMenu = null;
	            this.optionEditor = null;
	            this.assignMenu = !this.assignMenu;
	            if (this.assignMenu && !this.teamLoading && this.teamMembers.length === 0) this.loadTeamMembers();
	        },

	        async loadTeamMembers() {
	            this.teamLoading = true;
	            try {
	                const res = await fetch(API + '/api/team/members', { credentials: 'include' });
	                const data = await res.json().catch(() => ({}));
	                if (!res.ok || data.success === false) throw new Error(data.error || 'Equipe indisponible');
	                this.teamMembers = Array.isArray(data.members) ? data.members.filter(member => member && member.status !== 'removed') : [];
	                this.teamInvitations = Array.isArray(data.invitations) ? data.invitations : [];
	            } catch (e) {
	                console.warn('[TaskModal] Team members error:', e);
	                this.teamMembers = [];
	                this.teamInvitations = [];
	            } finally {
	                this.teamLoading = false;
	            }
	        },

	        activeTeamMembers() {
	            return (this.teamMembers || []).filter(member => member && member.status !== 'removed');
	        },

	        memberInitial(member) {
	            const text = String(member?.name || member?.email || '?').trim();
	            return text ? text.charAt(0).toUpperCase() : '?';
	        },

	        memberAssignValue(member) {
	            return String(member?.name || member?.email || '').trim();
	        },

	        assigneeLabel() {
	            return String(this.task?.assignedTo || '').trim() || 'Non assigné';
	        },

	        isAssignedTo(member) {
	            const current = String(this.task?.assignedTo || '').trim().toLowerCase();
	            if (!current) return false;
	            return [member?.name, member?.email]
	                .filter(Boolean)
	                .some(value => String(value).trim().toLowerCase() === current);
	        },

	        async assignTo(member) {
	            const value = this.memberAssignValue(member);
	            if (!this.task || !value) return;
	            this.assignMenu = false;
	            this.task.assignedTo = value;
	            await this.updateField('assignedTo', value);
	        },

	        async clearAssignee() {
	            if (!this.task) return;
	            this.assignMenu = false;
	            this.task.assignedTo = '';
	            await this.updateField('assignedTo', '');
	        },

	        async inviteTeamMember() {
	            const email = String(this.inviteEmail || '').trim().toLowerCase();
	            if (!email || this.inviteBusy) return;
	            this.inviteBusy = true;
	            try {
	                const res = await fetch(API + '/api/team/invite', {
	                    method: 'POST',
	                    headers: { 'Content-Type': 'application/json' },
	                    credentials: 'include',
	                    body: JSON.stringify({ email, role: 'member' })
	                });
	                const data = await res.json().catch(() => ({}));
	                if (!res.ok || data.success === false) throw new Error(data.error || 'Invitation impossible');
	                this.inviteEmail = '';
	                await this.loadTeamMembers();
	                if (window.showMessage) window.showMessage('Invitation envoyée', 'success');
	            } catch (e) {
	                if (window.showMessage) window.showMessage(e.message || 'Invitation impossible', 'danger');
	            } finally {
	                this.inviteBusy = false;
	            }
	        },

	        filteredOptions(kind) {
            const meta = this.optionMeta(kind);
            const q = String(this.optionSearch[kind] || '').trim().toLowerCase();
            const options = this[meta.optionsKey] || [];
            if (!q) return options;
            return options.filter(option => option.label.toLowerCase().includes(q));
        },

        canCreateOption(kind) {
            const label = String(this.optionSearch[kind] || '').trim();
            if (!label) return false;
            const meta = this.optionMeta(kind);
            return !(this[meta.optionsKey] || []).some(option => option.label.toLowerCase() === label.toLowerCase());
        },

        async selectOption(kind, option) {
            const meta = this.optionMeta(kind);
            if (!this.task || !option?.label) return;
            this.task[meta.field] = option.label;
            this.task[meta.colorField] = option.color || meta.fallbackColor;
            this.closeMenus();
            await this.updateField(meta.field, option.label);
        },

	        async createOption(kind) {
	            const label = String(this.optionSearch[kind] || '').trim();
	            if (!label) return;
	            const meta = this.optionMeta(kind);
	            const next = this.normalizeOptions([
	                ...(this[meta.optionsKey] || []),
	                { label, color: kind === 'priority' ? '#8b5cf6' : '#4361ee', order: (this[meta.optionsKey] || []).length }
	            ], this.defaults[meta.payload]);
	            try {
	                const saved = await this.saveOptions(kind, next);
	                const created = saved.find(option => option.label === label) || next[next.length - 1];
	                await this.selectOption(kind, created);
	            } catch (e) {}
	        },

        openOptionEditor(kind, option) {
            this.optionEditor = {
                kind,
                originalLabel: option.label,
                label: option.label,
                color: option.color || this.optionMeta(kind).fallbackColor
            };
        },

        async saveOptionEditor() {
            if (!this.optionEditor) return;
            const editor = this.optionEditor;
            const meta = this.optionMeta(editor.kind);
            const label = String(editor.label || '').trim();
            if (!label) {
                if (window.showMessage) window.showMessage('Nom requis', 'warning');
                return;
            }
            const options = (this[meta.optionsKey] || []).map((option, index) => {
                if (option.label !== editor.originalLabel) return { ...option, order: index };
                return { label, color: editor.color || meta.fallbackColor, order: index };
            });
            const duplicate = options.some((option, index) => option.label.toLowerCase() === label.toLowerCase() && (this[meta.optionsKey] || [])[index]?.label !== editor.originalLabel);
            if (duplicate) {
                if (window.showMessage) window.showMessage('Cette option existe déjà', 'warning');
                return;
            }
	            let saved = [];
	            try {
	                saved = await this.saveOptions(editor.kind, options, {
	                    renames: editor.originalLabel !== label ? [{ from: editor.originalLabel, to: label }] : []
	                });
	            } catch (e) {
	                return;
	            }
            if (this.task?.[meta.field] === editor.originalLabel || this.task?.[meta.field] === label) {
                const updated = saved.find(option => option.label === label) || { label, color: editor.color };
                this.task[meta.field] = updated.label;
                this.task[meta.colorField] = updated.color || meta.fallbackColor;
                await this.updateField(meta.field, updated.label);
            }
            this.optionEditor = null;
        },

        async deleteEditedOption() {
            if (!this.optionEditor) return;
            const editor = this.optionEditor;
            const meta = this.optionMeta(editor.kind);
            const options = (this[meta.optionsKey] || []).filter(option => option.label !== editor.originalLabel);
            if (!options.length) {
                if (window.showMessage) window.showMessage('Gardez au moins une option', 'warning');
                return;
            }
	            let saved = [];
	            try {
	                saved = await this.saveOptions(editor.kind, options.map((option, index) => ({ ...option, order: index })));
	            } catch (e) {
	                return;
	            }
            if (this.task?.[meta.field] === editor.originalLabel) {
                await this.selectOption(editor.kind, saved[0]);
            }
            this.optionEditor = null;
        },

	        async saveOptions(kind, options, metaPayload = {}) {
	            const meta = this.optionMeta(kind);
	            const cleaned = this.normalizeOptions(options, this.defaults[meta.payload]);
	            const previous = this[meta.optionsKey] || [];
	            this[meta.optionsKey] = cleaned;
	            if (!this.task?.taskListId) return cleaned;
	            try {
                const res = await fetch(API + '/api/task-lists/' + this.task.taskListId + '/' + meta.endpoint, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ [meta.payload]: cleaned, ...metaPayload })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Options non enregistrées');
                this[meta.optionsKey] = this.normalizeOptions(data[meta.payload], cleaned);
                this.task[meta.payload] = this[meta.optionsKey];
                if (this._onUpdate) this._onUpdate(this.task._id, meta.payload, this[meta.optionsKey], this.task);
	                return this[meta.optionsKey];
	            } catch (e) {
	                this[meta.optionsKey] = previous;
	                this.task[meta.payload] = previous;
	                console.error('[TaskModal] Option save error:', e);
	                if (window.showMessage) window.showMessage('Erreur lors de l’enregistrement des options', 'danger');
	                throw e;
	            }
	        },

        async updateField(field, value) {
            if (!this.task?._id) return;
            try {
                const body = {};
                body[field] = value;
                const res = await fetch(API + '/api/record-tasks/' + this.task._id, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(body)
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Mise à jour impossible');
                const updatedTask = data.task ? { ...this.task, ...data.task } : { ...this.task, [field]: value };
                this.task = updatedTask;
                if (Array.isArray(updatedTask.statuses)) this.statusOptions = this.normalizeOptions(updatedTask.statuses, this.defaults.statuses);
                if (Array.isArray(updatedTask.priorities)) this.priorityOptions = this.normalizeOptions(updatedTask.priorities, this.defaults.priorities);
                if (this._onUpdate) this._onUpdate(this.task._id, field, value, updatedTask);
                if (window.showMessage) window.showMessage('Tâche mise à jour', 'success');
            } catch (e) {
                console.error('[TaskModal] Update error:', e);
                if (window.showMessage) window.showMessage('Erreur lors de la mise à jour', 'danger');
            }
        },

        async uploadAttachments(files) {
            const list = Array.from(files || []).filter(Boolean);
            if (!this.task?._id || !list.length || this.uploadBusy) return;
            this.uploadBusy = true;
            try {
                const body = new FormData();
                list.forEach(file => body.append('files', file));
                const res = await fetch(API + '/api/record-tasks/' + this.task._id + '/attachments', {
                    method: 'POST',
                    credentials: 'include',
                    body
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Upload impossible');
                this.task = data.task ? { ...this.task, ...data.task } : { ...this.task, attachments: data.attachments || [] };
                if (this._onUpdate) this._onUpdate(this.task._id, 'attachments', this.task.attachments || [], this.task);
                if (window.showMessage) window.showMessage('Pièce jointe ajoutée', 'success');
            } catch (e) {
                console.error('[TaskModal] Attachment upload error:', e);
                if (window.showMessage) window.showMessage(e.message || 'Erreur lors de l’ajout du fichier', 'danger');
            } finally {
                this.uploadBusy = false;
            }
        },

        async deleteAttachment(attachment) {
            if (!this.task?._id || !attachment?._id) return;
            try {
                const res = await fetch(API + '/api/record-tasks/' + this.task._id + '/attachments/' + attachment._id, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Suppression impossible');
                this.task = data.task ? { ...this.task, ...data.task } : { ...this.task, attachments: data.attachments || [] };
                if (this._onUpdate) this._onUpdate(this.task._id, 'attachments', this.task.attachments || [], this.task);
                if (window.showMessage) window.showMessage('Pièce jointe supprimée', 'success');
            } catch (e) {
                console.error('[TaskModal] Attachment delete error:', e);
                if (window.showMessage) window.showMessage('Erreur lors de la suppression du fichier', 'danger');
            }
        },

        attachmentUrl(attachment) {
            return attachment?.url || (attachment?.filename ? API + '/uploads/attachments/' + attachment.filename : '#');
        },

        attachmentIcon(attachment) {
            const mime = String(attachment?.mimeType || '').toLowerCase();
            if (mime.includes('image')) return 'solar:gallery-linear';
            if (mime.includes('pdf')) return 'solar:file-text-linear';
            if (mime.includes('spreadsheet') || mime.includes('excel') || mime.includes('csv')) return 'solar:document-add-linear';
            if (mime.includes('word') || mime.includes('document')) return 'solar:document-text-linear';
            return 'solar:paperclip-rounded-linear';
        },

        formatBytes(bytes) {
            const size = Number(bytes || 0);
            if (!size) return 'Taille inconnue';
            if (size < 1024) return size + ' o';
            if (size < 1024 * 1024) return (size / 1024).toFixed(size < 10240 ? 1 : 0) + ' Ko';
            return (size / 1024 / 1024).toFixed(size < 10 * 1024 * 1024 ? 1 : 0) + ' Mo';
        },

        async remove() {
            if (!this.task?._id) return;
            if (!confirm('Supprimer cette tâche ?')) return;
            try {
                await fetch(API + '/api/record-tasks/' + this.task._id, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const taskId = this.task._id;
                if (this._onDelete) this._onDelete(taskId);
                this.close();
                if (window.showMessage) window.showMessage('Tâche supprimée', 'success');
            } catch (e) {
                console.error('[TaskModal] Delete error:', e);
                if (window.showMessage) window.showMessage('Erreur lors de la suppression', 'danger');
            }
        },

        async sendComment(text) {
            if (!this.task?._id || !text?.trim()) return;
            try {
                const res = await fetch(API + '/api/record-tasks/' + this.task._id + '/comments', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ text: text.trim() })
                });
	                const data = await res.json();
	                if (data.success && data.comment) {
	                    this.task._comments = this.sortConversation([...(this.task._comments || []), data.comment]);
	                    this.scrollConversationToRecent({ smooth: true });
	                }
	            } catch (e) {
                console.error('[TaskModal] Comment error:', e);
            }
        },

        toDateVal(value) {
            if (!value) return '';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '';
            if (this.dateValueHasExplicitTime(value)) {
                const year = d.getFullYear();
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }
            return d.toISOString().split('T')[0];
        },

        toTimeVal(value) {
            if (!value || !this.dateValueHasExplicitTime(value)) return '';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '';
            return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
        },

        dateValueHasExplicitTime(value) {
            if (!value) return false;
            if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return false;
            return d.getUTCHours() !== 0
                || d.getUTCMinutes() !== 0
                || d.getUTCSeconds() !== 0
                || d.getUTCMilliseconds() !== 0;
        },

        composeDateTime(dateValue, timeValue) {
            const date = String(dateValue || '').trim();
            if (!date) return null;
            const time = String(timeValue || '').trim();
            if (!time) return date;
            const [year, month, day] = date.split('-').map(Number);
            const [hour, minute] = time.split(':').map(Number);
            if (!year || !month || !day || !Number.isFinite(hour) || !Number.isFinite(minute)) return date;
            return new Date(year, month - 1, day, hour, minute, 0, 0).toISOString();
        },

        updateTaskDatePart(field, part, value) {
            if (!this.task || !['startDate', 'dueDate'].includes(field)) return;
            const currentDate = this.toDateVal(this.task[field]);
            const currentTime = this.toTimeVal(this.task[field]);
            const nextDate = part === 'date' ? String(value || '') : currentDate;
            const nextTime = part === 'time' ? String(value || '') : currentTime;
            const nextValue = this.composeDateTime(nextDate, nextTime);
            this.task[field] = nextValue;
            this.updateField(field, nextValue);
        },

        activityFieldLabel(field) {
            if (field === 'priority') return 'priorité';
            if (field === 'status') return 'statut';
            return field || 'valeur';
        },

        activityValueStyle(field, value) {
            const kind = field === 'priority' ? 'priority' : 'status';
            const color = this.optionColor(kind, value);
            return `background:${color}18;color:${color}`;
        },

        formatDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '—';
            const now = new Date();
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const target = new Date(d.getFullYear(), d.getMonth(), d.getDate());
            const diff = Math.round((target - today) / 86400000);
            if (diff === 0) return "Aujourd'hui";
            if (diff === 1) return 'Demain';
            if (diff === -1) return 'Hier';
            if (diff < -1) return 'Il y a ' + Math.abs(diff) + 'j';
            if (diff <= 7) return d.toLocaleDateString('fr-FR', { weekday: 'long' });
            return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: '2-digit' });
        },

        formatLongDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '—';
            return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
        }
    });

    window.addEventListener('open-task-modal', (e) => {
        if (e.detail?.task) {
            Alpine.store('taskModal').open(e.detail.task, {
                onUpdate: e.detail.onUpdate || null,
                onDelete: e.detail.onDelete || null,
            });
        }
    });
});
</script>
