      { id: 2, type: 'danger', icon: '!', title: 'Résultat labo critique reçu', author: 'Système', time: 'il y a 12 min', badge: 'URGENT' },
      { id: 1, type: 'success', icon: '✓', title: 'Fatima a terminé l\'ordonnance', author: 'Système', time: 'il y a 5 min' }
    ],
    
    openPatientDrawer(patient) {
      this.selectedPatient = patient;
      this.patientDrawerOpen = true;
    },
    closePatientDrawer() {
      this.patientDrawerOpen = false;
      setTimeout(() => { this.selectedPatient = null; }, 300);
    },
    
    sendQuickAction(action) {
      const actions = {
        next_patient: 'Patient suivant',
        rdv_3m: 'RDV dans 3 mois',
        rdv_6m: 'RDV dans 6 mois',
        control_15d: 'Contrôle dans 15 jours',
        come_now: 'Viens maintenant !'
      };
      
      const actionTypes = {
        next_patient: 'primary',
        rdv_3m: 'info',
        rdv_6m: 'info',
        control_15d: 'warning',
        come_now: 'danger'
      };
      
      const actionText = actions[action];
      const actionType = actionTypes[action];
      
      // Add to activity feed at bottom (newest last)
      this.activities.push({
        id: Date.now(),
        type: actionType,
        icon: '→',
        title: `Dr a demandé: ${actionText}`,
        author: 'Dr',
        time: 'à l\'instant'
      });
      
      // Auto-scroll to bottom
      this.$nextTick(() => {
        const container = this.$refs.chatMessages;
        if (container) {
          container.scrollTop = container.scrollHeight;
        }
      });
    },
    
    sendMessage() {
      if (!this.comms.newMessage.trim()) return;
      
      const messageText = this.comms.newMessage;
      const recipient = this.comms.recipient;
      
      // Add message to activity log at bottom (newest last)
      this.activities.push({
        id: Date.now(),
        type: 'info',
        icon: '💬',
        title: `${messageText}`,
        author: 'Dr',
        time: 'à l\'instant'
      });
      
      this.comms.newMessage = '';
      
      // Auto-scroll to bottom
      this.$nextTick(() => {
        const container = this.$refs.chatMessages;
        if (container) {
          container.scrollTop = container.scrollHeight;
        }
      });
    },
    
    init() {
      // Wait for ApexCharts to be loaded (loaded with defer)
      const initCharts = () => {
        if (typeof ApexCharts === 'undefined') {
          setTimeout(initCharts, 100);
          return;
        }
        
        const isDark = document.querySelector('.dark') !== null;
      
      // Consultations Chart (blue)
      const consultationsChart = new ApexCharts(this.$refs.consultationsChart, {
        series: [{ data: [12, 18, 14, 16, 12, 15, 11] }],
        chart: { height: 160, type: 'area', fontFamily: 'Nunito, sans-serif', sparkline: { enabled: true } },
        stroke: { curve: 'smooth', width: 2 },
        colors: ['#4361ee'],
        grid: { padding: { top: 5 } },
        yaxis: { show: false },
        tooltip: { x: { show: false }, y: { title: { formatter: () => '' } } },
        fill: isDark ? { type: 'gradient', gradient: { type: 'vertical', shadeIntensity: 1, inverseColors: false, opacityFrom: 0.3, opacityTo: 0.05, stops: [100, 100] } } : {}
      });
      consultationsChart.render();

      // Avg Time Chart (orange)
      const avgTimeChart = new ApexCharts(this.$refs.avgTimeChart, {
        series: [{ data: [15, 18, 16, 14, 19, 17, 15] }],
        chart: { height: 160, type: 'area', fontFamily: 'Nunito, sans-serif', sparkline: { enabled: true } },
        stroke: { curve: 'smooth', width: 2 },
        colors: ['#e2a03f'],
        grid: { padding: { top: 5 } },
        yaxis: { show: false },
        tooltip: { x: { show: false }, y: { title: { formatter: () => '' } } },
        fill: isDark ? { type: 'gradient', gradient: { type: 'vertical', shadeIntensity: 1, inverseColors: false, opacityFrom: 0.3, opacityTo: 0.05, stops: [100, 100] } } : {}
      });
      avgTimeChart.render();

      // Monthly Chart (green)
      const monthlyChart = new ApexCharts(this.$refs.monthlyChart, {
        series: [{ data: [45, 52, 48, 55, 62, 58, 65, 72] }],
        chart: { height: 160, type: 'area', fontFamily: 'Nunito, sans-serif', sparkline: { enabled: true } },
        stroke: { curve: 'smooth', width: 2 },
        colors: ['#00ab55'],
        grid: { padding: { top: 5 } },
        yaxis: { show: false },
        tooltip: { x: { show: false }, y: { title: { formatter: () => '' } } },
        fill: isDark ? { type: 'gradient', gradient: { type: 'vertical', shadeIntensity: 1, inverseColors: false, opacityFrom: 0.3, opacityTo: 0.05, stops: [100, 100] } } : {}
      });
      monthlyChart.render();
      };
      initCharts();
    }
  }));
});
</script>

