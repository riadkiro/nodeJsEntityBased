<!-- ╪══════════════ Unified Widget Picker Modal ══════════════╪ -->
<template x-teleport="body">
    <div data-widget-picker-overlay
         x-show="$store.widgetPicker.open"
         x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
         style="display: none; position: fixed; inset: 0; z-index: 9999; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); background: rgba(0,0,0,0.25);"
         class="flex items-center justify-center"
         @click.self="$store.widgetPicker.close()"
         @keydown.escape.window="$store.widgetPicker.close()"
         x-cloak>

        <div @click.stop
             style="background: white; border-radius: 20px; padding: 0; width: 100%; max-width: 480px; margin: 16px; box-shadow: 0 25px 60px rgba(0,0,0,0.15), 0 4px 16px rgba(0,0,0,0.08); border: 1px solid rgba(0,0,0,0.04); overflow: hidden; display: flex; flex-direction: column; max-height: 90vh;"
             x-show="$store.widgetPicker.open"
             x-transition:enter="transition ease-out duration-250 delay-50"
             x-transition:enter-start="opacity-0 scale-95 translate-y-3" x-transition:enter-end="opacity-100 scale-100 translate-y-0">

            <!-- Modal Header -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid #f3f4f6;">
	                <div style="display: flex; align-items: center; gap: 12px;">
	                    <div style="width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center;"
	                         :style="'background: ' + $store.widgetPicker.headerColor() + '12'">
	                        <iconify-icon :icon="$store.widgetPicker.headerIcon()"
	                                      width="20"
	                                      :style="'color:' + $store.widgetPicker.headerColor()"></iconify-icon>
	                    </div>
	                    <div>
	                        <h3 style="font-size: 16px; font-weight: 700; color: #111827; margin: 0; line-height: 1.3;"
	                            x-text="$store.widgetPicker.headerTitle()"></h3>
	                        <p style="font-size: 12px; color: #9ca3af; margin: 2px 0 0 0;"
	                           x-text="$store.widgetPicker.headerSubtitle()"></p>
	                    </div>
	                </div>
                <button type="button" @click="$store.widgetPicker.close()"
                        style="width: 32px; height: 32px; border-radius: 50%; border: 1px solid #e5e7eb; cursor: pointer; background: white; color: #9ca3af; display: flex; align-items: center; justify-content: center; transition: all 0.15s;"
                        onmouseover="this.style.background='#f9fafb';this.style.color='#6b7280'" onmouseout="this.style.background='white';this.style.color='#9ca3af'">
                    <iconify-icon icon="tabler:x" width="16"></iconify-icon>
                </button>
            </div>

            <!-- Modal Content (Catalog) -->
	            <div x-show="$store.widgetPicker.step === 'catalog'" style="padding: 20px 24px; overflow-y: auto; max-height: 60vh;" class="custom-scrollbar">
	                <template x-if="$store.widgetPicker.target?.type === 'home-overview'">
	                    <div style="display:flex;gap:8px;margin-bottom:14px;">
	                        <button type="button"
	                                @click="$store.widgetPicker.homeCatalogTab = 'all'"
	                                :style="'flex:1;height:36px;border-radius:10px;border:' + ($store.widgetPicker.homeCatalogTab === 'all' ? '1.5px solid #4361ee' : '1px solid #e5e7eb') + ';background:' + ($store.widgetPicker.homeCatalogTab === 'all' ? 'rgba(67,97,238,.08)' : '#fff') + ';color:' + ($store.widgetPicker.homeCatalogTab === 'all' ? '#4361ee' : '#64748b') + ';font-size:12px;font-weight:800;cursor:pointer;'">
	                            Tous les widgets
	                        </button>
	                        <button type="button"
	                                @click="$store.widgetPicker.homeCatalogTab = 'custom'"
	                                :style="'flex:1;height:36px;border-radius:10px;border:' + ($store.widgetPicker.homeCatalogTab === 'custom' ? '1.5px solid #4361ee' : '1px solid #e5e7eb') + ';background:' + ($store.widgetPicker.homeCatalogTab === 'custom' ? 'rgba(67,97,238,.08)' : '#fff') + ';color:' + ($store.widgetPicker.homeCatalogTab === 'custom' ? '#4361ee' : '#64748b') + ';font-size:12px;font-weight:800;cursor:pointer;'">
	                            Mes widgets personnalisés
	                        </button>
	                    </div>
	                </template>
	                <div x-show="$store.widgetPicker.homeCatalogTab === 'all'" class="wp-catalog-grid">
	                    <template x-for="w in $store.widgetPicker.visibleCatalog()" :key="w.type">
                        <button type="button"
                                @click="$store.widgetPicker.selectType(w.type)"
                                style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 16px 8px; border-radius: 14px; border: 1px solid #f3f4f6; background: white; cursor: pointer; transition: all 0.2s;"
                                onmouseover="this.style.borderColor='rgba(67,97,238,0.3)';this.style.background='rgba(67,97,238,0.02)';this.style.transform='translateY(-1px)'"
                                onmouseout="this.style.borderColor='#f3f4f6';this.style.background='white';this.style.transform='translateY(0)'">
                            <div style="width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center;"
                                 :style="'background: ' + w.color + '10'">
                                <iconify-icon :icon="w.icon" width="20" :style="'color: ' + w.color"></iconify-icon>
                            </div>
                            <span style="font-size: 12px; font-weight: 600; color: #374151;" x-text="w.label"></span>
                            <span style="font-size: 10px; color: #9ca3af; line-height: 1.3; text-align: center;" x-text="w.desc"></span>
                        </button>
	                    </template>
	                </div>
	                <div x-show="$store.widgetPicker.homeCatalogTab === 'custom'" style="display:flex;flex-direction:column;gap:9px;">
	                    <template x-for="widget in $store.widgetPicker.homeWidgets" :key="widget.id">
	                        <div style="display:grid;grid-template-columns:38px minmax(0,1fr) auto;gap:10px;align-items:center;padding:10px 12px;border:1px solid #eef2f7;border-radius:13px;background:#fff;">
	                            <span style="width:38px;height:38px;border-radius:11px;display:grid;place-items:center;"
	                                  :style="'background:' + (widget.color || '#4361ee') + '12;color:' + (widget.color || '#4361ee')">
	                                <iconify-icon :icon="widget.icon || $store.widgetPicker.defaultIconForType(widget.type)" width="18"></iconify-icon>
	                            </span>
	                            <span style="min-width:0;">
	                                <strong style="display:block;font-size:12.5px;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" x-text="widget.label || 'Widget'"></strong>
	                                <small style="display:block;margin-top:2px;font-size:10.5px;color:#9ca3af;" x-text="$store.widgetPicker.defaultLabelForType(widget.type) + ' · ' + (widget.usageCount || 0) + ' placé' + ((widget.usageCount || 0) > 1 ? 's' : '')"></small>
	                            </span>
	                            <span style="display:flex;align-items:center;gap:5px;">
	                                <button type="button" title="Insérer"
	                                        @click="$store.widgetPicker.insertSavedHomeWidget(widget.id)"
	                                        style="width:30px;height:30px;border:1px solid #dbe4ff;border-radius:9px;background:#f8fbff;color:#4361ee;display:grid;place-items:center;cursor:pointer;">
	                                    <iconify-icon icon="solar:add-circle-bold" width="15"></iconify-icon>
	                                </button>
	                                <button type="button" title="Modifier"
	                                        @click="$store.widgetPicker.editSavedHomeWidget(widget.id)"
	                                        style="width:30px;height:30px;border:1px solid #e5e7eb;border-radius:9px;background:#fff;color:#64748b;display:grid;place-items:center;cursor:pointer;">
	                                    <iconify-icon icon="solar:pen-new-square-linear" width="15"></iconify-icon>
	                                </button>
	                                <button type="button"
	                                        :title="$store.widgetPicker.pendingHomeWidgetDeleteId === widget.id ? 'Confirmer la suppression' : 'Supprimer'"
	                                        @click="$store.widgetPicker.deleteSavedHomeWidget(widget.id)"
	                                        :style="'width:30px;height:30px;border:1px solid ' + ($store.widgetPicker.pendingHomeWidgetDeleteId === widget.id ? '#ef4444' : '#fee2e2') + ';border-radius:9px;background:' + ($store.widgetPicker.pendingHomeWidgetDeleteId === widget.id ? '#ef4444' : '#fff') + ';color:' + ($store.widgetPicker.pendingHomeWidgetDeleteId === widget.id ? '#fff' : '#ef4444') + ';display:grid;place-items:center;cursor:pointer;'">
	                                    <iconify-icon icon="solar:trash-bin-trash-bold-duotone" width="15"></iconify-icon>
	                                </button>
	                            </span>
	                        </div>
	                    </template>
	                    <template x-if="$store.widgetPicker.homeWidgets.length === 0">
	                        <div style="text-align:center;padding:24px;border:1px dashed #e5e7eb;border-radius:13px;color:#9ca3af;font-size:12px;">Aucun widget personnalisé enregistré</div>
	                    </template>
	                </div>
	            </div>

	            <!-- Modal Content (Home Custom Types) -->
	            <div x-show="$store.widgetPicker.step === 'create-type'" style="padding: 20px 24px; overflow-y: auto; max-height: 60vh;" class="custom-scrollbar">
	                <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px;">
	                    <template x-for="w in $store.widgetPicker.homeCreateCatalog()" :key="w.type">
	                        <button type="button"
	                                @click="$store.widgetPicker.selectType(w.type)"
	                                style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 18px 10px; border-radius: 14px; border: 1px solid #f3f4f6; background: white; cursor: pointer; transition: all 0.2s;"
	                                onmouseover="this.style.borderColor='rgba(67,97,238,0.3)';this.style.background='rgba(67,97,238,0.02)';this.style.transform='translateY(-1px)'"
	                                onmouseout="this.style.borderColor='#f3f4f6';this.style.background='white';this.style.transform='translateY(0)'">
	                            <div style="width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center;"
	                                 :style="'background: ' + w.color + '10'">
	                                <iconify-icon :icon="w.icon" width="21" :style="'color: ' + w.color"></iconify-icon>
	                            </div>
	                            <span style="font-size: 12px; font-weight: 700; color: #374151;" x-text="w.label"></span>
	                            <span style="font-size: 10px; color: #9ca3af; line-height: 1.3; text-align: center;" x-text="w.desc"></span>
	                        </button>
	                    </template>
	                </div>
	            </div>

            <!-- Modal Content (Form) -->
            <div x-show="$store.widgetPicker.step === 'form'" style="padding: 20px 24px; overflow-y: auto; max-height: 60vh;" class="custom-scrollbar">
                <div style="display: flex; flex-direction: column; gap: 20px;">

                    <!-- Common: Title -->
	                    <div>
	                        <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Titre du widget</label>
	                        <input type="text" x-model="$store.widgetPicker.newWidget.label"
                               style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px; font-weight: 600; outline: none; transition: border-color 0.15s; box-sizing: border-box; color: #111827;"
                               onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
	                               placeholder="Ex: Ma Note, Stats...">
	                    </div>

	                    <template x-if="$store.widgetPicker.showHomeWidgetMeta()">
	                        <div
	                             x-data="{
	                                 _iconPicker: null,
	                                 _colorPicker: null,
	                                 _lastIconVal: '',
	                                 _lastColorVal: '',
	                                 initPickers() {
	                                     this.$nextTick(() => {
	                                         const iconMount = this.$refs.wpIconMount;
	                                         const colorMount = this.$refs.wpColorMount;
	                                         if (iconMount && window.IconPicker && !this._iconPicker) {
	                                             this._iconPicker = new IconPicker(iconMount, {
	                                                 name: 'widget-icon',
	                                                 value: $store.widgetPicker.newWidget.icon || '',
	                                                 onSelect: (icon) => { $store.widgetPicker.newWidget.icon = icon; }
	                                             });
	                                             this._lastIconVal = $store.widgetPicker.newWidget.icon || '';
	                                         }
	                                         if (colorMount && window.ColorPicker && !this._colorPicker) {
	                                             this._colorPicker = new ColorPicker(colorMount, {
	                                                 name: 'widget-color',
	                                                 value: $store.widgetPicker.newWidget.color || '',
	                                                 allowCustom: true,
	                                                 allowClear: true,
	                                                 onSelect: (color) => { $store.widgetPicker.newWidget.color = color; }
	                                             });
	                                             this._lastColorVal = $store.widgetPicker.newWidget.color || '';
	                                         }
	                                     });
	                                 },
	                                 destroyPickers() {
	                                     if (this._iconPicker) { this._iconPicker.destroy(); this._iconPicker = null; }
	                                     if (this._colorPicker) { this._colorPicker.destroy(); this._colorPicker = null; }
	                                 }
	                             }"
	                             x-init="initPickers()"
	                             x-effect="
	                                 const curIcon = $store.widgetPicker.newWidget.icon || '';
	                                 const curColor = $store.widgetPicker.newWidget.color || '';
	                                 if (_iconPicker && curIcon !== _lastIconVal) { _iconPicker.setValue(curIcon); _lastIconVal = curIcon; }
	                                 if (_colorPicker && curColor !== _lastColorVal) { _colorPicker.setValue(curColor); _lastColorVal = curColor; }
	                             "
	                             @destroy.window="destroyPickers()">
	                            <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">Icône & Couleur</label>
	                            <div style="display: flex; align-items: center; gap: 8px;">
	                                <div x-ref="wpIconMount"></div>
	                                <div x-ref="wpColorMount"></div>
	                            </div>
	                        </div>
	                    </template>

                    <!-- Dynamic Fields based on type -->

                    <!-- 1. HTML / Rich Text -->
	                    <template x-if="$store.widgetPicker.newWidget.type === 'html'">
	                        <div>
                            <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Contenu HTML</label>
                            <textarea x-model="$store.widgetPicker.newWidget.config.content" rows="6"
                                      style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; font-family: monospace; outline: none; box-sizing: border-box; resize: vertical;"
                                      onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                      placeholder="<p>Bonjour...</p>"></textarea>
                        </div>
	                    </template>

	                    <!-- Home Task List -->
	                    <template x-if="$store.widgetPicker.isTaskListWidgetType()">
	                        <div style="display: flex; flex-direction: column; gap: 10px;">
	                            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
	                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block;">Liste de tâches</label>
	                                <span style="font-size:10px;font-weight:700;color:#9ca3af;" x-text="$store.widgetPicker.filteredTaskLists().length + ' liste' + ($store.widgetPicker.filteredTaskLists().length > 1 ? 's' : '')"></span>
	                            </div>
	                            <div style="position:relative;">
	                                <iconify-icon icon="solar:magnifer-linear" width="15" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#9ca3af;"></iconify-icon>
	                                <input type="search"
	                                       x-model="$store.widgetPicker.taskListQuery"
	                                       placeholder="Rechercher une liste, un record..."
	                                       style="width:100%;height:38px;border:1px solid #e5e7eb;border-radius:10px;padding:0 12px 0 34px;font-size:12px;outline:none;color:#111827;">
	                            </div>
	                            <div style="display: flex; flex-direction: column; gap: 8px;">
	                                <template x-for="list in $store.widgetPicker.filteredTaskLists()" :key="list.id">
	                                    <button type="button"
	                                            @click="$store.widgetPicker.selectTaskList(list.id)"
	                                            :style="'display:grid;grid-template-columns:34px minmax(0,1fr) auto;gap:10px;align-items:center;width:100%;padding:10px 12px;border-radius:12px;border:' + ($store.widgetPicker.newWidget.config.taskListId === list.id ? '1.5px solid #4361ee' : '1px solid #e5e7eb') + ';background:' + ($store.widgetPicker.newWidget.config.taskListId === list.id ? 'rgba(67,97,238,.05)' : '#fff') + ';text-align:left;cursor:pointer;'">
	                                        <span style="width:34px;height:34px;border-radius:10px;display:grid;place-items:center;"
	                                              :style="'background:' + (list.color || '#4361ee') + '12;color:' + (list.color || '#4361ee')">
	                                            <iconify-icon :icon="list.icon || 'solar:checklist-bold-duotone'" width="16"></iconify-icon>
	                                        </span>
	                                        <span style="min-width:0;">
	                                            <strong style="display:block;font-size:12px;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" x-text="list.label"></strong>
	                                            <small style="display:block;font-size:10px;color:#9ca3af;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" x-text="list.recordTitle || list.entityName || 'Compte'"></small>
	                                        </span>
	                                        <span style="font-size:10px;font-weight:700;color:#9ca3af;" x-text="(list.count || 0) + ' tâche' + ((list.count || 0) > 1 ? 's' : '')"></span>
	                                    </button>
	                                </template>
	                            </div>
	                            <template x-if="$store.widgetPicker.filteredTaskLists().length === 0">
	                                <div style="text-align:center;padding:18px;border:1px dashed #e5e7eb;border-radius:12px;color:#9ca3af;font-size:12px;">Aucune liste trouvée</div>
	                            </template>
	                        </div>
	                    </template>

                    <!-- 2. Note -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'note' || $store.widgetPicker.newWidget.type === 'notes'">
                        <div>
                            <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Mémo / Note</label>
                            <textarea x-model="$store.widgetPicker.newWidget.config.content" rows="4"
                                      style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box; resize: vertical;"
                                      onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                      placeholder="Écrire quelque chose..."></textarea>
                        </div>
                    </template>

                    <!-- 3. Link -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'link'">
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">URL de destination</label>
                                <input type="url" x-model="$store.widgetPicker.newWidget.config.url"
                                       style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                       placeholder="https://...">
                            </div>
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Description (facultatif)</label>
                                <input type="text" x-model="$store.widgetPicker.newWidget.config.description"
                                       style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                       placeholder="Bouton vers...">
                            </div>
                            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="checkbox" x-model="$store.widgetPicker.newWidget.config.newTab" class="form-checkbox" style="accent-color: #4361ee;">
                                <span style="font-size: 12px; color: #6b7280;">Ouvrir dans un nouvel onglet</span>
                            </label>
                        </div>
                    </template>

                    <!-- 4. iFrame / Embed -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'iframe'">
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">URL de la page</label>
                                <input type="url" x-model="$store.widgetPicker.newWidget.config.url"
                                       style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                       placeholder="https://...">
                            </div>
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Hauteur (px)</label>
                                <input type="number" x-model="$store.widgetPicker.newWidget.config.height"
                                       style="width: 200px; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'">
                            </div>
                        </div>
                    </template>

                    <!-- 4b. Video -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'video'">
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">URL de la vidéo</label>
                                <input type="url" x-model="$store.widgetPicker.newWidget.config.url"
                                       style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                       placeholder="https://youtube.com/... ou https://.../video.mp4">
                            </div>
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Hauteur (px)</label>
                                <input type="number" x-model="$store.widgetPicker.newWidget.config.height"
                                       style="width: 200px; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'">
                            </div>
                        </div>
                    </template>

                    <!-- 5. Image -->
                    <template x-if="$store.widgetPicker.newWidget.type === 'image'">
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">URL de l'image</label>
                                <input type="url" x-model="$store.widgetPicker.newWidget.config.url"
                                       style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 13px; outline: none; box-sizing: border-box;"
                                       onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                       placeholder="https://...">
                            </div>
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Texte alternatif</label>
                                <input type="text" x-model="$store.widgetPicker.newWidget.config.alt"
