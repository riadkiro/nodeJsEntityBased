        <% if (moduleName === 'drive') { %>
        <div x-data="driveModule" x-cloak style="position:relative;" @dragenter.prevent="onDragEnter($event)" @dragover.prevent @dragleave.prevent="onDragLeave($event)" @drop.prevent="handleDrop($event)">
            <!-- Drag overlay (WhatsApp-style) -->
            <div x-show="isDragging" class="drive-dropzone-overlay" style="display:none;" x-transition.opacity>
                <iconify-icon icon="solar:cloud-upload-bold-duotone" width="48" style="color:#4361ee;"></iconify-icon>
                <p>Déposez vos fichiers ici</p>
                <span x-text="currentFolder ? 'dans ' + currentFolder : 'dans le Drive'"></span>
            </div>
            <!-- Breadcrumb -->
            <div class="drive-breadcrumb">
                <a href="/account/<%= account_number %>/drive" class="drive-breadcrumb-item" style="text-decoration:none;">
                    <iconify-icon icon="solar:cloud-storage-bold-duotone" width="14" style="color:#ec4899"></iconify-icon>
                    Drive
                </a>
                <span class="drive-breadcrumb-sep">
                    <iconify-icon icon="solar:alt-arrow-right-linear" width="12"></iconify-icon>
                </span>
                <a href="/account/<%= account_number %>/drive" class="drive-breadcrumb-item" style="text-decoration:none;">
                    <iconify-icon icon="<%= entity.icon || 'solar:folder-bold-duotone' %>" width="14" style="color:<%= entity.color || '#4361ee' %>"></iconify-icon>
                    <%= entity.name %>
                </a>
                <span class="drive-breadcrumb-sep">
                    <iconify-icon icon="solar:alt-arrow-right-linear" width="12"></iconify-icon>
                </span>
                <button @click="navigateTo('')" class="drive-breadcrumb-item" :class="!currentFolder && !viewingGenerated ? 'drive-breadcrumb-item--active' : ''">
                    <iconify-icon icon="solar:folder-bold-duotone" width="14" style="color:#f59e0b"></iconify-icon>
                    <%= record.title || 'Sans titre' %>
                </button>
                <template x-if="viewingGenerated">
                    <span class="drive-breadcrumb-sep">
                        <iconify-icon icon="solar:alt-arrow-right-linear" width="12"></iconify-icon>
                        <span class="drive-breadcrumb-item drive-breadcrumb-item--active">
                            <iconify-icon icon="solar:star-bold" width="13" style="color:#f59e0b"></iconify-icon>
                            Fichiers générés
                        </span>
                    </span>
                </template>
                <template x-if="currentFolder && !viewingGenerated">
                    <span class="drive-breadcrumb-sep">
                        <iconify-icon icon="solar:alt-arrow-right-linear" width="12"></iconify-icon>
                        <span class="drive-breadcrumb-item drive-breadcrumb-item--active" x-text="currentFolder"></span>
                    </span>
                </template>
            </div>

            <!-- Toolbar -->
            <div class="drive-toolbar">
                <div style="display:flex;gap:8px;">
                    <button @click="showNewFolderInput = !showNewFolderInput; $nextTick(() => $refs.folderInput?.focus())" class="drive-btn-secondary" x-show="!viewingGenerated && !currentFolder">
                        <iconify-icon icon="solar:folder-add-bold" width="15"></iconify-icon>
                        Nouveau dossier
                    </button>
                </div>
                <label class="drive-btn-primary" x-show="!viewingGenerated">
                    <iconify-icon icon="solar:upload-bold" width="15"></iconify-icon>
                    Ajouter
                    <input type="file" multiple @change="handleFileSelect($event)" style="display:none;">
                </label>
            </div>

            <!-- New folder input -->
            <div x-show="showNewFolderInput" x-transition class="drive-new-folder">
                <iconify-icon icon="solar:folder-bold-duotone" width="18" style="color:#4361ee"></iconify-icon>
                <input type="text" x-model="newFolderName" @keydown.enter="createFolder()" @keydown.escape="showNewFolderInput = false; newFolderName = ''"
                    placeholder="Nom du dossier..." class="drive-new-folder-input" x-ref="folderInput">
                <button @click="createFolder()" class="drive-new-folder-btn" :disabled="!newFolderName.trim()">Créer</button>
                <button @click="showNewFolderInput = false; newFolderName = ''" class="drive-new-folder-cancel">
                    <iconify-icon icon="solar:close-circle-linear" width="16"></iconify-icon>
                </button>
            </div>



            <!-- Upload progress -->
            <div x-show="uploading" class="drive-upload-progress">
                <iconify-icon icon="line-md:uploading-loop" width="20" style="color:#4361ee"></iconify-icon>
                <span x-text="'Upload en cours... ' + uploadCount + ' fichier(s)'"></span>
                <div class="drive-progress-bar"><div class="drive-progress-fill" :style="'width:' + uploadProgress + '%'"></div></div>
            </div>

            <!-- Loading -->
            <div x-show="loading" style="text-align:center; padding:40px 0; color:#94a3b8;">
                <iconify-icon icon="line-md:loading-twotone-loop" width="28"></iconify-icon>
            </div>

            <!-- Content -->
            <div x-show="!loading" class="rm-items-list">
                <!-- "Fichiers générés" virtual folder (root only) -->
                <div x-show="!currentFolder && !viewingGenerated && generatedCount > 0"
                     class="rm-item drive-folder-item" @click="viewingGenerated = true" style="cursor:pointer;">
                    <div class="rm-item-icon" style="background:linear-gradient(135deg,#f59e0b15,#f59e0b08)">
                        <iconify-icon icon="solar:star-bold-duotone" width="20" style="color:#f59e0b"></iconify-icon>
                    </div>
                    <div class="rm-item-body">
                        <div class="rm-item-title">Fichiers générés</div>
                        <div class="rm-item-date"><iconify-icon icon="solar:magic-stick-3-bold" width="12" style="color:#f59e0b"></iconify-icon> <span x-text="generatedCount + ' fichier(s)'"></span></div>
                    </div>
                    <span class="rm-item-badge" style="background:#f59e0b15;color:#f59e0b">Auto</span>
                    <span class="rm-item-action" style="color:#94a3b8;"><iconify-icon icon="solar:alt-arrow-right-linear" width="18"></iconify-icon></span>
                </div>

                <!-- Custom folders (root only) -->
                <template x-for="(folder, idx) in displayFolders" :key="folder.name">
                    <div class="rm-item drive-folder-item" @click="navigateTo(folder.name)" style="cursor:pointer;" :style="'animation-delay:' + (idx * 40) + 'ms'"
                         :class="dropTargetFolder === folder.name ? 'drive-folder-item--drop-target' : ''"
                         @dragover.prevent @dragenter.prevent="onFolderDragEnter($event, folder.name)"
                         @dragleave="onFolderDragLeave($event, folder.name)" @drop="onFolderDrop($event, folder.name)">
                        <div class="rm-item-icon" style="background:linear-gradient(135deg,#4361ee15,#4361ee08)">
                            <iconify-icon icon="solar:folder-bold-duotone" width="20" style="color:#4361ee"></iconify-icon>
                        </div>
                        <div class="rm-item-body">
                            <div class="rm-item-title" x-text="folder.name"></div>
                            <div class="rm-item-date"><iconify-icon icon="solar:documents-linear" width="12"></iconify-icon> <span x-text="folder.count + ' fichier(s)'"></span></div>
                        </div>
                        <span class="rm-item-badge" style="background:#4361ee10;color:#4361ee">Dossier</span>
                        <span class="rm-item-action" style="color:#94a3b8;"><iconify-icon icon="solar:alt-arrow-right-linear" width="18"></iconify-icon></span>
                    </div>
                </template>

                <!-- Files -->
                <template x-for="(file, idx) in displayFiles" :key="file._id">
                    <div class="rm-item" :style="'animation-delay:' + ((displayFolders.length + idx) * 40) + 'ms'"
                         :draggable="!file.isGenerated" @dragstart="startDragFile($event, file._id)" @dragend="onDragEnd()">
                        <div class="rm-item-icon" :style="'background:linear-gradient(135deg,' + getCategoryColor(file.category) + '15,' + getCategoryColor(file.category) + '08)'">
                            <iconify-icon :icon="getCategoryIcon(file.category)" width="20" :style="'color:' + getCategoryColor(file.category)"></iconify-icon>
                        </div>
                        <div class="rm-item-body">
                            <div class="rm-item-title" x-text="file.originalName"></div>
                            <div class="rm-item-date">
                                <iconify-icon icon="solar:calendar-linear" width="12"></iconify-icon>
                                <span x-text="formatDate(file.uploadedAt)"></span>
                                <template x-if="file.isGenerated && file.generatedFromName">
                                    <span style="margin-left:4px;color:#f59e0b;">· <span x-text="file.generatedFromName"></span></span>
                                </template>
                            </div>
                        </div>
                        <span class="rm-item-badge" style="background:#6b728015;color:#6b7280" x-text="file.sizeFormatted"></span>
                        <div class="drive-file-actions">
                            <a :href="file.url" download class="rm-item-action" title="Télécharger" style="color:#4361ee;"><iconify-icon icon="solar:download-bold" width="15"></iconify-icon></a>
                            <button @click="deleteFile(file)" class="rm-item-action" title="Supprimer" style="color:#ef4444;" x-show="!file.isGenerated"><iconify-icon icon="solar:trash-bin-2-bold" width="15"></iconify-icon></button>
                        </div>
                    </div>
                </template>

                <!-- Empty states -->
                <div x-show="displayFiles.length === 0 && displayFolders.length === 0 && generatedCount === 0 && !currentFolder && !viewingGenerated" class="drive-empty">
                    <iconify-icon icon="solar:folder-open-bold-duotone" width="48" style="opacity:0.15"></iconify-icon>
                    <p style="font-size:13px; font-weight:600; margin-top:12px;">Aucun fichier</p>
                    <p style="font-size:11px; margin-top:4px; color:#94a3b8;">Utilisez le bouton "Ajouter" pour importer des fichiers</p>
                </div>
                <div x-show="displayFiles.length === 0 && (currentFolder || viewingGenerated)" class="drive-empty">
                    <iconify-icon icon="solar:folder-open-bold-duotone" width="48" style="opacity:0.2"></iconify-icon>
                    <p style="font-size:13px; font-weight:600; margin-top:12px;">Dossier vide</p>
                </div>
            </div>
        </div>
        <% } %>



