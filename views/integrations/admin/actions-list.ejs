<%# Admin - Actions List %>
<div class="panel p-6">
    <div class="flex items-center justify-between mb-6">
        <div>
            <a href="/account/<%= account_number %>/integrations/admin/providers/<%= provider.key %>" class="text-sm text-gray-500 hover:text-primary mb-1 inline-block">
                ← Back to <%= provider.name %>
            </a>
            <h1 class="text-2xl font-semibold dark:text-white">Actions for <%= provider.name %></h1>
        </div>
        <a href="/account/<%= account_number %>/integrations/admin/providers/<%= provider.key %>/actions/new" 
           class="btn btn-primary">
            + New Action
        </a>
    </div>

    <% if (actions && actions.length > 0) { %>
        <table class="table-auto w-full">
            <thead>
                <tr class="text-left border-b border-gray-200 dark:border-gray-800">
                    <th class="pb-3 font-medium dark:text-gray-300">Name</th>
                    <th class="pb-3 font-medium dark:text-gray-300">Key</th>
                    <th class="pb-3 font-medium dark:text-gray-300">Method</th>
                    <th class="pb-3 font-medium dark:text-gray-300">Path</th>
                    <th class="pb-3 font-medium dark:text-gray-300">Status</th>
                    <th class="pb-3"></th>
                </tr>
            </thead>
            <tbody>
                <% actions.forEach(action => { %>
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="py-3 dark:text-white"><%= action.name %></td>
                        <td class="py-3 text-gray-500 dark:text-gray-400 text-sm"><%= action.actionKey %></td>
                        <td class="py-3">
                            <span class="text-xs px-2 py-1 rounded bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300">
                                <%= action.http.method %>
                            </span>
                        </td>
                        <td class="py-3 text-sm font-mono text-gray-600 dark:text-gray-400"><%= action.http.path %></td>
                        <td class="py-3">
                            <span class="text-xs px-2 py-1 rounded <%= action.isPublished ? 'bg-success/20 text-success' : 'bg-gray-100 dark:bg-gray-800 text-gray-500' %>">
                                <%= action.isPublished ? 'Published' : 'Draft' %>
                            </span>
                        </td>
                        <td class="py-3 text-right">
                            <a href="/account/<%= account_number %>/integrations/admin/actions/<%= action._id %>" 
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="text-center py-12">
            <p class="text-gray-500 dark:text-gray-400 mb-4">No actions configured yet.</p>
            <a href="/account/<%= account_number %>/integrations/admin/providers/<%= provider.key %>/actions/new" 
               class="btn btn-primary">
                Create First Action
            </a>
        </div>
    <% } %>
</div>
