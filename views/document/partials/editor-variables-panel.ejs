                    >
                        Format
                    </button>
                    <button 
                        @click="insertVariableToken('doc.createdAt')"
                        draggable="true"
                        @dragstart="$event.dataTransfer.setData('application/json', JSON.stringify({ type: 'variable', path: 'doc.createdAt' })); $event.dataTransfer.effectAllowed = 'copy';"
                        class="px-2 py-0 rounded bg-yellow-100 hover:bg-yellow-200 dark:bg-yellow-900/30 dark:hover:bg-yellow-900/50 text-yellow-800 dark:text-yellow-200 text-xs font-semibold transition-colors cursor-grab active:cursor-grabbing border border-yellow-300 dark:border-yellow-700"
                    >
                        Date de création
                    </button>
                </div>
            </div>
        </div>

        <!-- User Variables (NOW COLLAPSIBLE) -->
        <div class="mb-4">
            <button 
                @click="openSections.user = !openSections.user"
                class="w-full text-left text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2 flex items-center justify-between gap-1 cursor-pointer hover:text-gray-500 dark:hover:text-gray-300 transition-colors"
            >
                <div class="flex items-center gap-1">
                    <iconify-icon icon="solar:user-bold-duotone" width="14"></iconify-icon>
                    Utilisateur
                </div>
                <iconify-icon :icon="openSections.user ? 'solar:alt-arrow-down-bold' : 'solar:alt-arrow-right-bold'" width="12"></iconify-icon>
            </button>
            <div x-show="openSections.user" x-collapse>
                <div class="flex flex-wrap gap-2.5">
                    <button 
                        @click="insertVariableToken('user.name')"
                        draggable="true"
                        @dragstart="$event.dataTransfer.setData('application/json', JSON.stringify({ type: 'variable', path: 'user.name' })); $event.dataTransfer.effectAllowed = 'copy';"
                        class="px-2 py-0 rounded bg-yellow-100 hover:bg-yellow-200 dark:bg-yellow-900/30 dark:hover:bg-yellow-900/50 text-yellow-800 dark:text-yellow-200 text-xs font-semibold transition-colors cursor-grab active:cursor-grabbing border border-yellow-300 dark:border-yellow-700"
                    >
                        Nom
                    </button>
                    <button 
                        @click="insertVariableToken('user.email')"
                        draggable="true"
                        @dragstart="$event.dataTransfer.setData('application/json', JSON.stringify({ type: 'variable', path: 'user.email' })); $event.dataTransfer.effectAllowed = 'copy';"
                        class="px-2 py-0 rounded bg-yellow-100 hover:bg-yellow-200 dark:bg-yellow-900/30 dark:hover:bg-yellow-900/50 text-yellow-800 dark:text-yellow-200 text-xs font-semibold transition-colors cursor-grab active:cursor-grabbing border border-yellow-300 dark:border-yellow-700"
                    >
                        Email
                    </button>
                </div>
            </div>
        </div>


        <!-- Company Variables (NOW COLLAPSIBLE) -->
        <div class="mb-4">
            <button 
                @click="openSections.company = !openSections.company"
                class="w-full text-left text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2 flex items-center justify-between gap-1 cursor-pointer hover:text-gray-500 dark:hover:text-gray-300 transition-colors"
            >
