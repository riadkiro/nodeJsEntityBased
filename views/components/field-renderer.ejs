<% // This component expects 'field' (FieldTemplate object) and 'value' (current value if editing, else null) const
    fieldId=field._id; const fieldType=field.type; const fieldLabel=field.label; const placeholder=field.ui?.placeholder
    || '' ; const nameAttr=`custom[${fieldId}]`; %>

    <div>
        <label for="custom_<%= fieldId %>">
            <%= fieldLabel %>
        </label>
        <% if (fieldType==='string' || fieldType==='text' ) { %>
            <input name="<%= nameAttr %>" type="text" value="<%= value || '' %>" class="form-input"
                placeholder="<%= placeholder %>" />
            <% } else if (fieldType==='number' ) { %>
                <input name="<%= nameAttr %>" type="number" value="<%= value || '' %>" class="form-input"
                    placeholder="<%= placeholder %>" />
                <% } else if (fieldType==='date' ) { %>
                    <input name="<%= nameAttr %>" type="date"
                        value="<%= value ? new Date(value).toISOString().split('T')[0] : '' %>" class="form-input" />
                    <% } else if (fieldType==='boolean' ) { %>
                        <div class="mt-2">
                            <label class="w-12 h-6 relative">
                                <input name="<%= nameAttr %>" type="checkbox" value="true" <%=value ? 'checked' : '' %>
                                class="custom_switch absolute w-full h-full opacity-0 z-10 cursor-pointer peer" />
                                <span
                                    class="bg-[#ebedf2] dark:bg-dark block h-full rounded-full before:absolute before:left-1 before:bg-white dark:before:bg-white-dark dark:peer-checked:before:bg-white before:bottom-1 before:w-4 before:h-4 before:rounded-full peer-checked:before:left-7 peer-checked:bg-primary before:transition-all before:duration-300"></span>
                            </label>
                        </div>
                        <% } else if (fieldType==='select' ) { %>
                            <select name="<%= nameAttr %>" class="form-select text-white-dark text-sm">
                                <% if (field.type_config && field.type_config.options) { %>
                                    <% field.type_config.options.forEach(option=> { %>
                                        <option value="<%= option %>" <%=value===option ? 'selected' : '' %>><%= option
                                                %>
                                        </option>
                                        <% }) %>
                                            <% } %>
                            </select>
                            <% } else if (fieldType==='recurrence' ) { %>
                                <% 
                                const recVal = (typeof value === 'object' && value !== null) ? value : {};
                                const typeConfigOpts = (field.type_config && field.type_config.options) || [];
                                const typeConfigSlots = (field.type_config && field.type_config.slots) || {};
                                const slotNames = [...new Set(typeConfigOpts.map(o => o.slot).filter(Boolean))];
                                %>
                                <div class="space-y-3">
                                <% slotNames.forEach(slotName => { 
                                    const slotOpts = typeConfigOpts.filter(o => o.slot === slotName);
                                    const slotConf = typeConfigSlots[slotName] || {};
                                    const slotVal = recVal[slotName];
                                %>
                                    <div>
                                    <label class="block text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1.5"><%= slotName %></label>
                                    <% const slotUI = slotConf.ui || (slotConf.multiple ? 'checkbox' : 'select'); %>
                                    <% if (slotUI === 'select') { %>
                                        <select name="<%= nameAttr %>[<%= slotName %>]" class="form-select text-sm">
                                            <option value="">-- Choisir --</option>
                                            <% slotOpts.forEach(opt => { %>
                                                <option value="<%= opt.value %>" <%= slotVal === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                                            <% }) %>
                                        </select>
                                    <% } else { %>
                                        <div class="flex flex-wrap gap-2">
                                            <% slotOpts.forEach(opt => { 
                                                const isChecked = Array.isArray(slotVal) ? slotVal.includes(opt.value) : slotVal === opt.value;
                                            %>
                                                <label class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium cursor-pointer border transition-all duration-200 select-none <%= isChecked ? 'bg-primary/10 border-primary/40 text-primary shadow-sm shadow-primary/10 ring-1 ring-primary/20' : 'bg-white dark:bg-gray-800 border-gray-200 dark:border-gray-600 text-gray-500 dark:text-gray-400 hover:border-primary/30 hover:bg-primary/5 hover:text-primary/70 shadow-sm' %>">
                                                    <input type="checkbox" name="<%= nameAttr %>[<%= slotName %>][]" value="<%= opt.value %>" class="hidden" <%= isChecked ? 'checked' : '' %>>
                                                    <% if (isChecked) { %><svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><% } %>
                                                    <span><%= opt.label %></span>
                                                </label>
                                            <% }) %>
                                        </div>
                                    <% } %>
                                    </div>
                                <% }) %>
                                <% if (field.type_config && field.type_config.allowCustomText) { %>
                                    <div>
                                    <label class="block text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1.5">Autre</label>
                                    <input name="<%= nameAttr %>[customText]" type="text" value="<%= recVal.customText || '' %>" class="form-input text-sm" placeholder="Texte libre...">
                                    </div>
                                <% } %>
                                </div>
                            <% } else { %>
                                <input name="<%= nameAttr %>" type="text" value="<%= value || '' %>" class="form-input"
                                    placeholder="<%= placeholder %>" />
                                <% } %>
    </div>