<!-- views/record/partials/record-sidebar.ejs -->
<div class="space-y-4 sticky top-20" x-data="recordSidebar">
    <!-- Action Buttons (WordPress Style) -->
    <div class="panel !p-4">
        <div class="flex items-center gap-2">
            <button type="submit" form="main-record-form"
                class="btn btn-primary flex-1 py-2 flex items-center justify-center gap-2 text-xs">
                <iconify-icon icon="solar:diskette-bold" width="16"></iconify-icon>
                <span>
                    <%= locals.record ? 'Mettre à jour' : 'Enregistrer' %>
                </span>
            </button>
            <a href="/account/<%= account_number %>/record/<%= entity.slug %>/list"
                class="btn btn-outline-danger px-3 py-2 flex items-center justify-center text-xs" title="Annuler">
                <iconify-icon icon="solar:close-circle-bold" width="16"></iconify-icon>
            </a>
        </div>
        <div
            class="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between text-[9px] text-white-dark uppercase font-bold tracking-tighter">
            <span>Dernière modif :</span>
            <span class="text-gray-500 font-extrabold">
                <%= locals.record ? new Date(record.updatedAt).toLocaleDateString() : 'Nouveau' %>
            </span>
        </div>
    </div>

    <!-- Dynamic Classifications (Shared Data) -->
    <% const allEntityClassifications=[]; if (entity.classifications && entity.classifications.length> 0) {
        entity.classifications.forEach(c => {
        allEntityClassifications.push({
        data: c,
        isStatus: false,
        label: c.name,
        icon: 'solar:tag-bold',
        colorClass: 'text-info',
        nameAttr: `classifications[${c._id}]`
        });
        });
        }

        // Tree Helper for Recursive Rendering
        const renderTree = (options, parentId, cls, selectedIds, currentValue) => {
        const children = options.filter(o => {
        const pid = o.parentId ? o.parentId.toString() : '';
        const targetId = parentId ? parentId.toString() : '';
        return pid === targetId;
        }).sort((a, b) => (a.order || 0) - (b.order || 0));
        %>
        <ul class="nested-sortable-list space-y-0.5"
            style="<%= parentId ? 'margin-left: 11px; margin-top: 2px;' : '' %>" data-parent-id="<%= parentId || '' %>">
            <% children.forEach(opt=> { %>
                <li class="sort-item group/item" data-id="<%= opt._id %>">
                    <div class="flex items-center gap-1 h-[20px]">
                        <!-- Drag Handle -->
                        <div
                            class="handle cursor-grab opacity-20 group-hover/item:opacity-100 transition-opacity text-gray-400 p-0.5 -ml-1 flex items-center">
                            <iconify-icon icon="tabler:grip-vertical" width="14"></iconify-icon>
                        </div>

                        <label class="flex items-center gap-2 cursor-pointer mb-0 flex-1 min-w-0">
                            <% if (cls.data.allowMultiple) { %>
                                <input type="checkbox" name="<%= cls.nameAttr %>[]" value="<%= opt._id %>"
                                    class="form-checkbox w-3.5 h-3.5" <%=selectedIds.includes(opt._id.toString())
                                    ? 'checked' : '' %>>
                                <% } else { %>
                                    <input type="radio" name="<%= cls.nameAttr %>" value="<%= opt._id %>"
                                        class="form-radio w-3.5 h-3.5" <%=currentValue===opt._id.toString() ? 'checked'
                                        : '' %>>
                                    <% } %>
                                        <span
                                            class="text-[11px] truncate flex items-center gap-1 <%= (selectedIds.includes(opt._id.toString()) || currentValue === opt._id.toString()) ? 'text-primary font-bold' : 'text-gray-700' %>">
                                            <span class="prefix-arrow text-gray-300 font-normal">└</span>
                                            <%= opt.label %>
                                        </span>
                        </label>
                    </div>
                    <!-- Recursive call - Always render UL for nesting -->
                    <%- renderTree(options, opt._id, cls, selectedIds, currentValue) %>
                </li>
                <% }) %>
        </ul>
        <% }; // Helper for recursive hierarchical display in SELECT (flat with indentation) const
            renderOptionsFlat=(options, parentId=null, depth=0)=> {
            let results = [];
            const filtered = options.filter(o => {
            const pid = o.parentId ? o.parentId.toString() : '';
            const targetId = parentId ? parentId.toString() : '';
            return pid === targetId;
            });

            filtered.forEach(o => {
            const item = o.toObject ? o.toObject() : { ...o };
            results.push({ ...item, depth });
            results = results.concat(renderOptionsFlat(options, item._id, depth + 1));
            });
            return results;
            };
            %>

            <% if (allEntityClassifications.length> 0) { %>
                <div class="panel !p-0 overflow-hidden">
                    <div class="px-4 py-3 border-b border-gray-100 bg-gray-50/30 flex items-center justify-between cursor-pointer hover:bg-gray-50 transition-colors"
                        @click="classificationsOpen = !classificationsOpen">
                        <h6 class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em]">Classification</h6>
                        <iconify-icon icon="solar:alt-arrow-down-bold" :class="classificationsOpen ? 'rotate-180' : ''"
                            class="text-gray-400 transition-transform duration-300" width="14"></iconify-icon>
                    </div>
                    <div x-show="classificationsOpen" x-collapse>
                        <% allEntityClassifications.forEach((cls, clsIdx)=> { %>
                            <div class="p-4 <%= clsIdx > 0 ? 'border-t border-gray-100' : '' %>"
                                x-data="classificationBox('<%= cls.data._id %>', '<%= cls.nameAttr %>', <%= cls.data.allowMultiple %>)">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex items-center gap-2 <%= cls.colorClass %>">
                                        <iconify-icon icon="<%= cls.icon %>" width="16"></iconify-icon>
                                        <h6
                                            class="text-[11px] font-extrabold uppercase tracking-wider mb-0 text-gray-800 dark:text-white-light">
                                            <%= cls.label %>
                                        </h6>
                                        <% if (cls.data.type==='hierarchical' ) { %>
                                            <span
                                                class="text-[8px] bg-gray-100 px-1 rounded text-gray-500 font-bold uppercase">Tree</span>
                                            <% } %>
                                    </div>
                                    <button type="button"
                                        @click="toggleEdit(); $dispatch('toggle-tags-' + '<%= cls.data._id %>')"
                                        class="<%= cls.colorClass %> hover:scale-110 transition-transform">
                                        <iconify-icon
                                            :icon="editing ? 'solar:close-circle-bold' : 'solar:add-circle-bold'"
                                            width="16"></iconify-icon>
                                    </button>
                                </div>

                                <div class="mt-2 text-xs">
                                    <% if (cls.data.type==='hierarchical' ) { %>
                                        <!-- TREE VIEW (Hierarchical Only) -->
                                        <div class="space-y-1.5 overflow-y-auto border border-gray-100 rounded p-2 bg-gray-50/30 custom-scrollbar"
                                            style="max-height: 150px;" id="tree-<%= cls.data._id %>">
                                            <% let selectedIds=[]; let currentValue='' ; if (cls.data.allowMultiple) {
                                                const values=(locals.record && record.classificationValues) ?
                                                record.classificationValues.filter(cv=> cv.classificationId.toString()
                                                ===
                                                cls.data._id.toString()) : [];
                                                selectedIds = values.map(v => v.optionId.toString());
                                                } else {
                                                const valObj = (locals.record && record.classificationValues) ?
                                                record.classificationValues.find(cv => cv.classificationId.toString()
                                                ===
                                                cls.data._id.toString()) : null;
                                                currentValue = valObj ? (valObj.optionId ? valObj.optionId.toString() :
                                                '') :
                                                '';
                                                }
                                                %>
                                                <%- renderTree(cls.data.options, null, cls, selectedIds, currentValue)
                                                    %>

                                                    <% if (cls.data.options.length===0 && !editing) { %>
                                                        <p
                                                            class="no-options-msg text-[10px] text-gray-400 italic text-center py-2">
                                                            Aucune option</p>
                                                        <% } %>
                                        </div>
                                        <!-- QUICK ADD FOR TREE -->
                                        <div x-show="editing" class="mt-2" x-transition>
                                            <div class="relative">
                                                <input type="text" x-model="newLabel" x-ref="input" @keyup.enter="save"
                                                    class="form-input text-xs !h-8 pr-12" placeholder="Nouveau...">
                                                <button type="button" @click="save" :disabled="!newLabel || loading"
                                                    class="absolute right-1 top-1 bottom-1 p-1 text-primary">
                                                    <iconify-icon
                                                        :icon="loading ? 'line-md:loading-twotone-loop' : 'solar:check-read-linear'"
                                                        width="16"></iconify-icon>
                                                </button>
                                            </div>
                                        </div>

                                        <% } else if (cls.data.allowMultiple) { %>
                                            <!-- TAGS SYSTEM (Simple Multiple) -->
                                            <div x-data="classificationTags('<%= cls.data._id %>', '<%= cls.nameAttr %>', <%= JSON.stringify(cls.data.options) %>, <%= JSON.stringify((locals.record && record.classificationValues) ? record.classificationValues.filter(cv => cv.classificationId.toString() === cls.data._id.toString()).map(cv => cv.optionId.toString()) : []) %>)"
                                                @tag-added.window="if($event.detail.clsId === '<%= cls.data._id %>') { options.push($event.detail.option); add($event.detail.option._id); }"
                                                @toggle-tags-<%=cls.data._id %>.window="showAdd = !showAdd; if(showAdd)
                                                $nextTick(() => { if($refs.tagInput) $refs.tagInput.focus() })"
                                                class="relative">
                                                <!-- Selected Tags -->
                                                <div class="flex flex-wrap gap-1 mb-2 overflow-y-auto custom-scrollbar"
                                                    style="max-height: 100px;">
                                                    <template x-for="optId in selectedIds" :key="optId">
                                                        <div
                                                            class="bg-primary/10 text-primary text-[10px] font-bold px-2 py-0.5 rounded flex items-center gap-1 group">
                                                            <span x-text="getLabel(optId)"></span>
                                                            <button type="button" @click="remove(optId)"
                                                                class="hover:text-danger">
                                                                <iconify-icon icon="solar:close-circle-bold"
                                                                    width="12"></iconify-icon>
                                                            </button>
                                                            <input type="hidden" :name="nameAttr + '[]'" :value="optId">
                                                        </div>
                                                    </template>
                                                </div>

                                                <!-- Search / Autocomplete -->
                                                <div class="relative">
                                                    <input type="text" x-model="search" @focus="open = true"
                                                        @click.away="open = false" class="form-input text-xs !h-8"
                                                        placeholder="Chercher ou ajouter...">

                                                    <!-- Dropdown -->
                                                    <div x-show="open && filteredOptions.length > 0"
                                                        class="absolute z-[100] w-full mt-1 bg-white border border-gray-100 shadow-lg rounded-lg max-h-40 overflow-y-auto"
                                                        x-transition>
                                                        <template x-for="opt in filteredOptions" :key="opt._id">
                                                            <button type="button" @click="add(opt._id)"
                                                                class="w-full text-left px-3 py-1.5 text-[11px] hover:bg-gray-50 flex items-center justify-between group">
                                                                <span x-text="opt.label"></span>
                                                                <iconify-icon icon="solar:add-circle-bold" width="14"
                                                                    class="opacity-0 group-hover:opacity-100 text-primary"></iconify-icon>
                                                            </button>
                                                        </template>
                                                        <!-- Quick Add Option if search doesn't match exactly -->
                                                        <template x-if="search && !exactMatch">
                                                            <button type="button" @click="fastAdd"
                                                                class="w-full text-left px-3 py-1.5 text-[11px] bg-primary/5 text-primary italic font-medium hover:bg-primary/10">
                                                                + Ajouter "<span x-text="search"></span>"
                                                            </button>
                                                        </template>
                                                    </div>
                                                </div>

                                                <!-- QUICK ADD FOR TAGS (Local state showAdd) -->
                                                <div x-show="showAdd" class="mt-2" x-transition>
                                                    <div class="relative">
                                                        <input type="text" x-model="localNewLabel" x-ref="tagInput"
                                                            @keyup.enter="localSave()"
                                                            class="form-input text-xs !h-8 pr-12"
                                                            placeholder="Nouveau...">
                                                        <button type="button" @click="localSave()"
                                                            :disabled="!localNewLabel || localLoading"
                                                            class="absolute right-1 top-1 bottom-1 p-1 text-primary">
                                                            <iconify-icon
                                                                :icon="localLoading ? 'line-md:loading-twotone-loop' : 'solar:check-read-linear'"
                                                                width="16"></iconify-icon>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>

                                            <% } else { %>
                                                <!-- SELECT UNIQUE (ORIGINAL DESIGN) -->
                                                <select name="<%= cls.nameAttr %>"
                                                    class="form-select text-xs !h-9 !py-1">
                                                    <option value="">-- Choisir --</option>
                                                    <% const valObj=(locals.record && record.classificationValues) ?
                                                        record.classificationValues.find(cv=>
                                                        cv.classificationId.toString()
                                                        ===
                                                        cls.data._id.toString()) : null;
                                                        const currentValue = valObj ? (valObj.optionId ?
                                                        valObj.optionId.toString()
                                                        : '') :
                                                        '';

                                                        cls.data.options.forEach(opt => { %>
                                                        <option value="<%= opt._id %>" <%=(opt._id &&
                                                            currentValue===opt._id.toString()) ? 'selected' : '' %>>
                                                            <%= opt.label %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                                <!-- QUICK ADD FOR SIMPLE SELECT -->
                                                <div x-show="editing" class="mt-2" x-transition>
                                                    <div class="relative">
                                                        <input type="text" x-model="newLabel" x-ref="input"
                                                            @keyup.enter="save" class="form-input text-xs !h-8 pr-12"
                                                            placeholder="Nouvelle...">
                                                        <button type="button" @click="save"
                                                            :disabled="!newLabel || loading"
                                                            class="absolute right-1 top-1 bottom-1 p-1 text-primary">
                                                            <iconify-icon
                                                                :icon="loading ? 'line-md:loading-twotone-loop' : 'solar:check-read-linear'"
                                                                width="16"></iconify-icon>
                                                        </button>
                                                    </div>
                                                </div>
                                                <% } %>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </div>
                <% } else { %>
                    <div class="panel !p-4 border-dashed border-gray-200 text-center py-4">
                        <p class="text-[10px] text-gray-400 uppercase font-bold">Aucune classification liée</p>
                        <a href="/account/<%= account_number %>/entity/edit/<%= entity._id %>"
                            class="btn btn-xs btn-outline-primary mt-2">Configurer l'entité</a>
                    </div>
                    <% } %>

                        <!-- Publication & Visibilité -->
                        <div class="panel !p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2 text-info">
                                    <iconify-icon icon="solar:eye-bold" width="16"></iconify-icon>
                                    <h6
                                        class="text-[11px] font-extrabold uppercase tracking-wider mb-0 text-gray-800 dark:text-white-light">
                                        Public</h6>
                                </div>
                                <label class="w-12 h-6 relative mb-0">
                                    <input type="checkbox"
                                        class="custom_switch absolute w-full h-full opacity-0 z-10 cursor-pointer peer"
                                        id="published" name="standard[published]" <%=(locals.record &&
                                        (record.published===true || record.published==='on' )) ? 'checked' : '' %>
                                    />
                                    <span
                                        class="bg-[#ebedf2] dark:bg-dark block h-full rounded-full before:absolute before:left-1 before:bg-white dark:before:bg-white-dark dark:peer-checked:before:bg-white before:bottom-1 before:w-4 before:h-4 before:rounded-full peer-checked:before:left-7 peer-checked:bg-primary before:transition-all before:duration-300"></span>
                                </label>
                            </div>
                        </div>

                        <!-- Style & Visuel -->
                        <div class="panel !p-4" x-data="{ openStyle: false }">
                            <div class="flex items-center justify-between cursor-pointer mb-0"
                                @click="openStyle = !openStyle">
                                <div class="flex items-center gap-2 text-warning">
                                    <iconify-icon icon="solar:palette-bold" width="16"></iconify-icon>
                                    <h6
                                        class="text-[11px] font-extrabold uppercase tracking-wider mb-0 text-gray-800 dark:text-white-light">
                                        Visuel</h6>
                                </div>
                                <iconify-icon icon="solar:alt-arrow-down-linear" width="14"
                                    :class="openStyle ? '' : '-rotate-90'" class="transition-transform"></iconify-icon>
                            </div>

                            <div class="space-y-4 mt-4" x-show="openStyle" x-collapse>
                                <div x-data="{ showUpload: <%= (locals.record && record.image) ? 'false' : 'true' %> }">
                                    <label
                                        class="!text-[9px] !mb-1 uppercase font-bold text-gray-400">Couverture</label>
                                    <% if (locals.record && record.image) { %>
                                        <template x-if="!showUpload">
                                            <div class="mb-2 relative group">
                                                <img src="<%= record.image %>"
                                                    class="w-full h-24 object-cover rounded shadow-sm border border-gray-100" />
                                                <div
                                                    class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center rounded">
                                                    <button type="button" @click="showUpload = true"
                                                        class="text-white text-[10px] bg-white/20 px-2 py-1 rounded backdrop-blur-sm">Changer</button>
                                                </div>
                                            </div>
                                        </template>
                                        <% } %>
                                            <template x-if="showUpload">
                                                <input type="file" name="image" class="form-input text-[10px] !p-1 !h-8"
                                                    accept="image/*" />
                                            </template>
                                            <input type="hidden" name="standard[image]"
                                                value="<%= (locals.record && record.image) ? record.image : '' %>">
                                </div>

                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="!text-[9px] !mb-1 uppercase font-bold text-gray-400">Icône</label>
                                        <input name="standard[icon]" type="text"
                                            value="<%= (locals.record && record.icon) ? record.icon : '' %>"
                                            class="form-input text-[10px] !h-8 !px-2" placeholder="solar:star-bold" />
                                    </div>
                                    <div>
                                        <label
                                            class="!text-[9px] !mb-1 uppercase font-bold text-gray-400">Couleur</label>
                                        <input name="standard[color]" type="color"
                                            value="<%= (locals.record && record.color) ? record.color : '#4361ee' %>"
                                            class="form-input h-8 w-full p-1 cursor-pointer" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Dates -->
                        <div class="panel !p-4" x-data="{ openDates: false }">
                            <div class="flex items-center justify-between cursor-pointer"
                                @click="openDates = !openDates">
                                <div class="flex items-center gap-2 text-danger">
                                    <iconify-icon icon="solar:calendar-bold" width="16"></iconify-icon>
                                    <h6
                                        class="text-[11px] font-extrabold uppercase tracking-wider mb-0 text-gray-800 dark:text-white-light">
                                        Dates</h6>
                                </div>
                                <iconify-icon icon="solar:alt-arrow-down-linear" width="14"
                                    :class="openDates ? '' : '-rotate-90'" class="transition-transform"></iconify-icon>
                            </div>

                            <div class="space-y-3 mt-4" x-show="openDates" x-collapse>
                                <div>
                                    <label class="!text-[9px] !mb-1">Début</label>
                                    <input name="standard[date]" type="date"
                                        value="<%= (locals.record && record.date) ? new Date(record.date).toISOString().split('T')[0] : '' %>"
                                        class="form-input text-[10px] !h-8" />
                                </div>
                                <div>
                                    <label class="!text-[9px] !mb-1">Fin</label>
                                    <input name="standard[end_date]" type="date"
                                        value="<%= (locals.record && record.end_date) ? new Date(record.end_date).toISOString().split('T')[0] : '' %>"
                                        class="form-input text-[10px] !h-8" />
                                </div>
                            </div>
                        </div>
</div>

<style>
    .sortable-ghost {
        opacity: 0.3;
        border: 1px dashed #4361ee;
        background: #eef2ff;
    }

    /* Invisible target for empty parent lists - expands on drag */
    .nested-sortable-list {
        min-height: 2px;
        transition: all 0.2s;
    }

    /* While dragging, show empty lists as catch areas */
    .sortable-chosen .nested-sortable-list {
        min-height: 10px;
        background: rgba(67, 97, 238, 0.02);
        margin-bottom: 4px;
        border-radius: 4px;
        transition: all 0.2s;
    }

    /* Dynamic Arrow logic: only show prefix-arrow if the item is nested */
    .prefix-arrow {
        display: none !important;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #e0e6ed;
        border-radius: 10px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #cbd5e1;
    }

    /* For Firefox */
    .custom-scrollbar {
        scrollbar-width: thin;
        scrollbar-color: #e0e6ed transparent;
    }

    .sort-item .sort-item .prefix-arrow {
        display: inline !important;
    }

    /* Outdent/Indent visual cues */
    .sort-item {
        transition: margin-left 0.2s;
    }
</style>

<script>
    document.addEventListener("alpine:init", () => {
        Alpine.data("recordSidebar", () => ({
            classificationsOpen: true,
            init() { }
        }));

        Alpine.data("classificationBox", (clsId, nameAttr, allowMultiple) => ({
            // ... (keep existing code for tree view if needed, but primarily used for simple select now)
            editing: false,
            newLabel: '',
            loading: false,

            toggleEdit() {
                this.editing = !this.editing;
                if (this.editing) {
                    this.$nextTick(() => {
                        if (this.$refs.input) this.$refs.input.focus();
                    });
                }
            },

            async save() {
                if (!this.newLabel) return;
                this.loading = true;
                try {
                    const res = await fetch(`/account/<%= account_number %>/classification/api/fast-add`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ classificationId: clsId, label: this.newLabel })
                    });
                    const data = await res.json();
                    if (data.success) {
                        // For tree view (hierarchical)
                        const tree = document.querySelector(`#tree-${clsId}`);
                        if (tree) {
                            const rootUl = tree.querySelector(':scope > ul');
                            if (rootUl) {
                                const li = document.createElement('li');
                                li.className = 'sort-item group/item';
                                li.dataset.id = data.option._id;
                                li.innerHTML = `
                                    <div class="flex items-center gap-1 h-[20px]">
                                        <div class="handle cursor-grab opacity-20 group-hover/item:opacity-100 transition-opacity text-gray-400 p-0.5 -ml-1 flex items-center">
                                            <iconify-icon icon="tabler:grip-vertical" width="14"></iconify-icon>
                                        </div>
                                        <label class="flex items-center gap-2 cursor-pointer mb-0 flex-1 min-w-0">
                                            <input type="${allowMultiple ? 'checkbox' : 'radio'}" 
                                                   name="${nameAttr}${allowMultiple ? '[]' : ''}" 
                                                   value="${data.option._id}" 
                                                   class="${allowMultiple ? 'form-checkbox' : 'form-radio'} w-3.5 h-3.5"
                                                   checked>
                                            <span class="text-[11px] truncate flex items-center gap-1 text-primary font-bold">
                                                <span class="prefix-arrow text-gray-300 font-normal">└</span>
                                                ${data.option.label}
                                            </span>
                                        </label>
                                    </div>
                                    <ul class="nested-sortable-list space-y-0.5" data-parent-id="${data.option._id}"></ul>
                                `;
                                rootUl.appendChild(li);
                                this.initSortable();
                            }
                        } else {
                            // For simple select
                            const select = document.querySelector(`select[name="${nameAttr}"]`);
                            if (select) {
                                const opt = document.createElement('option');
                                opt.value = data.option._id;
                                opt.textContent = data.option.label;
                                opt.selected = true;
                                select.appendChild(opt);
                                select.dispatchEvent(new Event('change'));
                            }
                        }
                        this.newLabel = '';
                        this.editing = false;
                        // Dispatch event for tags component
                        window.dispatchEvent(new CustomEvent('tag-added', { detail: { clsId: clsId, option: data.option } }));
                    }
                } catch (e) { console.error(e); } finally { this.loading = false; }
            },

            // Tree View Reordering
            init() { this.$nextTick(() => this.initSortable()); },
            initSortable() {
                const containers = document.querySelectorAll(`#tree-${clsId} ul`);
                const self = this;
                containers.forEach(el => {
                    if (el.dataset.sortable) return;
                    el.dataset.sortable = "true";
                    new Sortable(el, {
                        group: `nested-${clsId}`,
                        animation: 150,
                        handle: '.handle',
                        ghostClass: 'sortable-ghost',
                        onStart: () => document.body.classList.add('is-dragging'),
                        onEnd: () => {
                            document.body.classList.remove('is-dragging');
                            self.saveReorder();
                        }
                    });
                });
            },
            async saveReorder() {
                const options = [];
                const tree = document.getElementById(`tree-${clsId}`);
                if (!tree) return;
                const traverse = (container, parentId = null) => {
                    const items = Array.from(container.children).filter(li => li.tagName === 'LI' && li.dataset.id);
                    items.forEach((li, idx) => {
                        options.push({ id: li.dataset.id, parentId: parentId, order: idx });
                        const sub = li.querySelector(':scope > ul');
                        if (sub) traverse(sub, li.dataset.id);
                    });
                };
                const root = tree.querySelector(':scope > ul');
                if (root) traverse(root);
                try {
                    await fetch(`/account/<%= account_number %>/classification/api/reorder`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ classificationId: clsId, options })
                    });
                } catch (e) { console.error("Reorder failed", e); }
            }
        }));

        Alpine.data("classificationTags", (clsId, nameAttr, allOptions, initialSelected) => ({
            nameAttr: nameAttr,
            options: allOptions,
            selectedIds: [], // Initialized in init()
            search: '',
            open: false,
            showAdd: false,
            localNewLabel: '',
            localLoading: false,

            init() {
                // Filter orphan IDs (case where option was deleted but record kept the link)
                this.selectedIds = initialSelected.filter(id =>
                    this.options.some(o => o._id.toString() === id.toString())
                );
            },

            get filteredOptions() {
                if (!this.search) {
                    return this.options.filter(o => !this.selectedIds.includes(o._id.toString()));
                }
                const s = this.search.toLowerCase();
                return this.options.filter(o =>
                    !this.selectedIds.includes(o._id.toString()) &&
                    o.label.toLowerCase().includes(s)
                );
            },

            get exactMatch() {
                const s = this.search.toLowerCase();
                return this.options.some(o => o.label.toLowerCase() === s);
            },

            getLabel(id) {
                const opt = this.options.find(o => o._id.toString() === id.toString());
                return opt ? opt.label : 'Inconnu';
            },

            add(id) {
                if (!this.selectedIds.includes(id.toString())) {
                    this.selectedIds.push(id.toString());
                }
                this.search = '';
                this.open = false;
            },

            remove(id) {
                this.selectedIds = this.selectedIds.filter(i => i !== id.toString());
            },

            async fastAdd() {
                if (!this.search) return;
                try {
                    const res = await fetch(`/account/<%= account_number %>/classification/api/fast-add`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ classificationId: clsId, label: this.search })
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.options.push(data.option);
                        this.add(data.option._id);
                    }
                } catch (e) { console.error(e); }
            },

            async localSave() {
                if (!this.localNewLabel) return;
                this.localLoading = true;
                try {
                    const res = await fetch(`/account/<%= account_number %>/classification/api/fast-add`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ classificationId: clsId, label: this.localNewLabel })
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.options.push(data.option);
                        this.add(data.option._id);
                        this.localNewLabel = '';
                        this.showAdd = false;
                    }
                } catch (e) { console.error(e); } finally { this.localLoading = false; }
            }
        }));
    });
</script>