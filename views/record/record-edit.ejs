                                                            'solar:user-bold-duotone'
                                                        ]" :key="ic">
                                                            <button type="button" @click="cfgBlock.config.icon = ic"
                                                                    :style="'width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.15s;' + ((cfgBlock.config.icon || 'solar:clock-circle-bold-duotone') === ic ? 'background: rgba(128,93,202,0.15); border: 1px solid rgba(128,93,202,0.4); color: #805dca;' : 'background: #f9fafb; border: 1px solid #e5e7eb; color: #9ca3af;')">
                                                                <iconify-icon :icon="ic" width="16"></iconify-icon>
                                                            </button>
                                                        </template>
                                                    </div>
                                                </div>
                                                <!-- Max items -->
                                                                <!-- Sort order -->
                                                                <div>
                                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">
                                                                        <iconify-icon icon="solar:sort-vertical-bold-duotone" width="13" style="color: #2196f3; margin-right: 2px;"></iconify-icon>
                                                                        Ordre de tri
                                                                    </label>
                                                                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px;">
                                                                        <template x-for="so in [{v:'desc',l:'Plus récent',i:'solar:sort-from-top-to-bottom-bold'},{v:'asc',l:'Plus ancien',i:'solar:sort-from-bottom-to-top-bold'}]" :key="so.v">
                                                                            <button type="button" @click="cfgBlock.config.sortOrder = so.v"
                                                                                    :style="'display: flex; align-items: center; justify-content: center; gap: 4px; padding: 8px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; transition: all 0.15s;' + ((cfgBlock.config.sortOrder || 'desc') === so.v ? 'background: rgba(33,150,243,0.1); border: 1px solid rgba(33,150,243,0.3); color: #2196f3;' : 'background: white; border: 1px solid #e5e7eb; color: #6b7280;')">
                                                                                <iconify-icon :icon="so.i" width="14"></iconify-icon>
                                                                                <span x-text="so.l"></span>
                                                                            </button>
                                                                        </template>
                                                                    </div>
                                                                </div>
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Nombre max d'événements</label>
                                                    <select :value="cfgBlock.config.maxItems || 10"
                                                            @change="cfgBlock.config.maxItems = parseInt($el.value)"
                                                            style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; outline: none; background: white; box-sizing: border-box;">
                                                        <option value="5">5 derniers</option>
                                                        <option value="10">10 derniers</option>
                                                        <option value="20">20 derniers</option>
                                                        <option value="50">50 derniers</option>
                                                    </select>
                                                </div>
                                                <!-- Color -->
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Couleur de la timeline</label>
                                                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                                        <template x-for="c in ['#805dca','#4361ee','#00ab55','#e7515a','#e2a03f','#2196f3','#1b2e4b']" :key="c">
                                                            <button type="button" @click="cfgBlock.config.color = c"
                                                                    :style="'width: 28px; height: 28px; border-radius: 8px; border: 2px solid ' + ((cfgBlock.config.color || '#805dca') === c ? c : 'transparent') + '; background: ' + c + '; cursor: pointer; transition: all 0.15s;'"></button>
                                                        </template>
                                                    </div>
                                                </div>
                                            </div>
                                        </template>

                                        <!-- ══════════ FIELDS ══════════ -->
                                        <template x-if="cfgBlock.type === 'fields'">
                                            <div style="display: flex; flex-direction: column; gap: 14px;"
                                                 x-init="if(!cfgBlock.config) cfgBlock.config = {}; if(!cfgBlock.config.selectedFields) cfgBlock.config.selectedFields = []">
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">
                                                        Champs à afficher
                                                        <span style="font-weight: 400; color: #9ca3af;" x-text="'(' + (cfgBlock.config.selectedFields || []).length + ' sélectionnés)'"></span>
                                                    </label>
                                                    <div style="max-height: 240px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 8px; padding: 4px;">
                                                        <!-- Standard fields -->
                                                        <template x-for="sf in [{id:'title',label:'Titre',icon:'solar:text-bold'},{id:'date',label:'Date',icon:'solar:calendar-bold'},{id:'description',label:'Description',icon:'solar:document-text-bold'}]" :key="sf.id">
                                                            <label :style="'display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 6px; cursor: pointer; transition: background 0.1s;' + ((cfgBlock.config.selectedFields || []).includes(sf.id) ? 'background: rgba(67,97,238,0.05);' : '')"
                                                                   onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background=''">
                                                                <input type="checkbox"
                                                                       :checked="(cfgBlock.config.selectedFields || []).includes(sf.id)"
                                                                       @change="if (!cfgBlock.config.selectedFields) cfgBlock.config.selectedFields = [];
                                                                                const idx = cfgBlock.config.selectedFields.indexOf(sf.id);
                                                                                if (idx > -1) cfgBlock.config.selectedFields.splice(idx, 1);
                                                                                else cfgBlock.config.selectedFields.push(sf.id);"
                                                                       style="width: 14px; height: 14px; accent-color: #4361ee; flex-shrink: 0;">
                                                                <iconify-icon :icon="sf.icon" width="14" style="color: #9ca3af; flex-shrink: 0;"></iconify-icon>
                                                                <span style="font-size: 12px; color: #374151;" x-text="sf.label"></span>
                                                                <span style="font-size: 10px; color: #9ca3af; margin-left: auto;">Standard</span>
                                                            </label>
                                                        </template>
                                                        <div style="height: 1px; background: #f3f4f6; margin: 4px 0;"></div>
                                                        <!-- Custom fields (EJS-rendered) -->
                                                        <% (entity.customFields || []).filter(function(f) { return f; }).forEach(function(f) { var fId = (f._id || '').toString(); var fLabel = f.label || f.name || ''; var fType = f.type || 'text'; var fIcon = (f.ui && f.ui.icon) || 'solar:document-text-linear'; %>
                                                            <label :style="'display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 6px; cursor: pointer; transition: background 0.1s;' + ((cfgBlock.config.selectedFields || []).includes('<%= fId %>') ? 'background: rgba(67,97,238,0.05);' : '')"
                                                                   onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background=''">
                                                                <input type="checkbox"
                                                                       :checked="(cfgBlock.config.selectedFields || []).includes('<%= fId %>')"
                                                                       @change="if (!cfgBlock.config.selectedFields) cfgBlock.config.selectedFields = [];
                                                                                const idx = cfgBlock.config.selectedFields.indexOf('<%= fId %>');
                                                                                if (idx > -1) cfgBlock.config.selectedFields.splice(idx, 1);
                                                                                else cfgBlock.config.selectedFields.push('<%= fId %>');"
                                                                       style="width: 14px; height: 14px; accent-color: #4361ee; flex-shrink: 0;">
                                                                <iconify-icon icon="<%= fIcon %>" width="14" style="color: #9ca3af; flex-shrink: 0;"></iconify-icon>
                                                                <span style="font-size: 12px; color: #374151;"><%= fLabel %></span>
                                                                <span style="font-size: 10px; color: #9ca3af; margin-left: auto;"><%= fType %></span>
                                                            </label>
                                                        <% }); %>
                                                    </div>
                                                </div>
                                                <!-- Display mode -->
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Mode d'affichage</label>
                                                    <div style="display: flex; gap: 6px;">
                                                        <template x-for="mode in [{v:'list',l:'Liste',i:'solar:list-bold'},{v:'grid',l:'Grille',i:'solar:widget-bold'},{v:'compact',l:'Compact',i:'solar:minimize-square-bold'}]" :key="mode.v">
                                                            <button type="button" @click="cfgBlock.config.displayMode = mode.v"
                                                                    :style="'display: flex; align-items: center; gap: 4px; padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: 500; cursor: pointer; transition: all 0.15s;' + ((cfgBlock.config.displayMode || 'list') === mode.v ? 'background: rgba(67,97,238,0.1); border: 1px solid rgba(67,97,238,0.3); color: #4361ee;' : 'background: white; border: 1px solid #e5e7eb; color: #6b7280;')">
                                                                <iconify-icon :icon="mode.i" width="14"></iconify-icon>
                                                                <span x-text="mode.l"></span>
                                                            </button>
                                                        </template>
                                                    </div>
                                                </div>
                                            </div>
                                        </template>

                                        <!-- ══════════ CARDS ══════════ -->
                                        <template x-if="cfgBlock.type === 'cards'">
                                            <div style="display: flex; flex-direction: column; gap: 14px;"
                                                 x-init="if(!cfgBlock.config) cfgBlock.config = {}">
                                                <!-- Relation source -->
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Source (relation)</label>
                                                    <div style="display: flex; flex-direction: column; gap: 6px;">
                                                        <% (entity.relations || []).forEach(function(r) { var rKey = r.key || ''; var rLabel = r.label || ''; var rTargetName = (r.targetEntity && r.targetEntity.name) || ''; var rTargetIcon = (r.targetEntity && r.targetEntity.icon) || 'solar:box-bold-duotone'; var rTargetColor = (r.targetEntity && r.targetEntity.color) || '#4361ee'; var rTargetId = (r.targetEntity && r.targetEntity._id ? r.targetEntity._id.toString() : ''); var rCardinality = r.cardinality || 'many'; %>
                                                            <button type="button" @click="cfgBlock.config.relationKey = '<%= rKey %>'; cfgBlock.config.targetEntityId = '<%= rTargetId %>'; cfgBlock.config.targetEntityName = '<%= rTargetName %>'"
                                                                    :style="'display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 8px; cursor: pointer; text-align: left; width: 100%; transition: all 0.15s;' + ((cfgBlock.config.relationKey || '') === '<%= rKey %>' ? 'background: rgba(67,97,238,0.08); border: 1px solid rgba(67,97,238,0.3);' : 'background: white; border: 1px solid #e5e7eb;')">
                                                                <div style="width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; background: <%= rTargetColor %>15; flex-shrink: 0;">
                                                                    <iconify-icon icon="<%= rTargetIcon %>" width="14" style="color: <%= rTargetColor %>;"></iconify-icon>
                                                                </div>
                                                                <div>
                                                                    <div style="font-size: 12px; font-weight: 600; color: #374151;"><%= rLabel || rTargetName %></div>
                                                                    <div style="font-size: 10px; color: #9ca3af;"><%= rTargetName %> (<%= rCardinality %>)</div>
                                                                </div>
                                                                <template x-if="(cfgBlock.config.relationKey || '') === '<%= rKey %>'">
                                                                    <iconify-icon icon="solar:check-circle-bold" width="16" style="color: #4361ee; margin-left: auto;"></iconify-icon>
                                                                </template>
                                                            </button>
                                                        <% }); %>
                                                    </div>
                                                </div>
                                                <!-- Max cards -->
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Nombre max de cartes</label>
                                                    <select :value="cfgBlock.config.maxCards || 5"
                                                            @change="cfgBlock.config.maxCards = parseInt($el.value)"
                                                            style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; outline: none; background: white; box-sizing: border-box;">
                                                        <option value="3">3 cartes</option>
                                                        <option value="5">5 cartes</option>
                                                        <option value="10">10 cartes</option>
                                                        <option value="20">20 cartes</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </template>

                                        <!-- ══════════ EMBED / IFRAME ══════════ -->
                                        <template x-if="cfgBlock.type === 'iframe'">
                                            <div style="display: flex; flex-direction: column; gap: 14px;"
                                                 x-init="if(!cfgBlock.config) cfgBlock.config = {}">
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">URL à embarquer</label>
                                                    <input type="url" :value="cfgBlock.config.url || ''"
                                                           @input="cfgBlock.config.url = $el.value"
                                                           style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; outline: none; transition: border-color 0.15s; box-sizing: border-box;"
                                                           onfocus="this.style.borderColor='#4361ee'" onblur="this.style.borderColor='#e5e7eb'"
                                                           placeholder="https://example.com">
                                                </div>
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Hauteur (px)</label>
                                                    <input type="number" :value="cfgBlock.config.height || 300"
                                                           @input="cfgBlock.config.height = parseInt($el.value) || 300"
                                                           style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; outline: none; box-sizing: border-box;"
                                                           min="100" max="1000" step="50">
                                                </div>
                                                <div style="padding: 10px; background: #fef3c7; border-radius: 8px; border: 1px solid #fde68a;">
                                                    <div style="display: flex; align-items: center; gap: 6px;">
                                                        <iconify-icon icon="solar:danger-triangle-bold" width="14" style="color: #d97706;"></iconify-icon>
                                                        <span style="font-size: 11px; font-weight: 600; color: #92400e;">Sécurité</span>
                                                    </div>
                                                    <p style="font-size: 11px; color: #78716c; margin: 4px 0 0 0; line-height: 1.4;">Seuls les sites autorisant l'intégration iframe fonctionneront. Certains sites bloquent l'intégration pour des raisons de sécurité.</p>
                                                </div>
                                            </div>
                                        </template>
                                    </div>

                                    
                                    <!-- ═══ Saved Filters (for chart/timeline) ═══ -->
                                    <template x-if="cfgBlock && (cfgBlock.type === 'chart' || cfgBlock.type === 'timeline') && cfgBlock.config && cfgBlock.config.advancedFilters && cfgBlock.config.advancedFilters.filter(f => f.field && f.operator).length > 0">
                                        <div style="padding: 10px 20px; border-top: 1px solid #f3f4f6;"
                                             x-data="{
                                                 sfName: '',
                                                 sfExpanded: false,
                                                 getSavedFilters() {
                                                     const layout = customTabLayouts[ctConfigModal.tabKey];
                                                     return (layout && layout.savedFilters) ? Object.entries(layout.savedFilters) : [];
                                                 },
                                                 saveFilter() {
                                                     if (!this.sfName.trim()) return;
                                                     const layout = customTabLayouts[ctConfigModal.tabKey];
                                                     if (!layout) return;
                                                     if (!layout.savedFilters) layout.savedFilters = {};
                                                     const id = 'sf_' + Date.now();
                                                     layout.savedFilters[id] = {
                                                         name: this.sfName.trim(),
                                                         filters: JSON.parse(JSON.stringify(cfgBlock.config.advancedFilters.filter(f => f.field && f.operator))),
                                                         logic: cfgBlock.config.advancedFiltersLogic || 'and',
                                                         createdAt: new Date().toISOString()
                                                     };
                                                     this.sfName = '';
                                                     ctSaveLayout(ctConfigModal.tabKey);
                                                 },
                                                 loadFilter(id) {
                                                     const layout = customTabLayouts[ctConfigModal.tabKey];
                                                     if (!layout || !layout.savedFilters || !layout.savedFilters[id]) return;
                                                     const sf = layout.savedFilters[id];
                                                     cfgBlock.config.advancedFilters = JSON.parse(JSON.stringify(sf.filters));
                                                     cfgBlock.config.advancedFiltersLogic = sf.logic || 'and';
                                                     cfgBlock.config.savedFilterId = id;
                                                 },
                                                 deleteFilter(id) {
                                                     const layout = customTabLayouts[ctConfigModal.tabKey];
                                                     if (!layout || !layout.savedFilters) return;
                                                     delete layout.savedFilters[id];
                                                     if (cfgBlock.config.savedFilterId === id) cfgBlock.config.savedFilterId = '';
                                                     ctSaveLayout(ctConfigModal.tabKey);
                                                 }
                                             }">
                                            <button type="button" @click="sfExpanded = !sfExpanded"
                                                    style="display: flex; align-items: center; gap: 6px; width: 100%; padding: 0; border: none; background: none; cursor: pointer; color: #6b7280; font-size: 11px; font-weight: 600;">
                                                <iconify-icon icon="solar:bookmark-bold-duotone" width="14" style="color: #e2a03f;"></iconify-icon>
                                                Filtres sauvegardés
                                                <iconify-icon :icon="sfExpanded ? 'tabler:chevron-up' : 'tabler:chevron-down'" width="14" style="margin-left: auto;"></iconify-icon>
                                            </button>
                                            <template x-if="sfExpanded">
                                                <div style="margin-top: 8px;">
                                                    <div style="display: flex; gap: 4px; margin-bottom: 8px;">
                                                        <input type="text" x-model="sfName" placeholder="Nom du filtre..."
                                                               style="flex: 1; padding: 5px 8px; border: 1px solid #e5e7eb; border-radius: 5px; font-size: 11px; outline: none; box-sizing: border-box;"
                                                               @keydown.enter.prevent="saveFilter()">
                                                        <button type="button" @click="saveFilter()"
                                                                :disabled="!sfName.trim()"
                                                                :style="'padding: 5px 10px; border-radius: 5px; border: none; font-size: 11px; font-weight: 600; cursor: pointer;' + (sfName.trim() ? 'background: #e2a03f; color: white;' : 'background: #f3f4f6; color: #9ca3af; cursor: default;')">
                                                            <iconify-icon icon="solar:bookmark-bold" width="12" style="vertical-align: -1px;"></iconify-icon>
                                                            Sauvegarder
                                                        </button>
                                                    </div>
                                                    <template x-for="[sfId, sf] in getSavedFilters()" :key="sfId">
                                                        <div style="display: flex; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 6px; margin-bottom: 4px;"
                                                             :style="cfgBlock.config.savedFilterId === sfId ? 'background: rgba(226,160,63,0.08); border: 1px solid rgba(226,160,63,0.2);' : 'background: #f9fafb; border: 1px solid #f3f4f6;'">
                                                            <iconify-icon icon="solar:bookmark-bold-duotone" width="12" style="color: #e2a03f; flex-shrink: 0;"></iconify-icon>
                                                            <span style="font-size: 11px; font-weight: 500; color: #374151; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" x-text="sf.name"></span>
                                                            <span style="font-size: 9px; color: #9ca3af; flex-shrink: 0;" x-text="sf.filters.length + ' filtre(s)'"></span>
                                                            <button type="button" @click="loadFilter(sfId)"
                                                                    style="padding: 2px 6px; border-radius: 4px; border: none; background: rgba(67,97,238,0.1); color: #4361ee; font-size: 10px; font-weight: 600; cursor: pointer;">
                                                                Charger
                                                            </button>
                                                            <button type="button" @click="deleteFilter(sfId)"
                                                                    style="width: 18px; height: 18px; border-radius: 50%; border: none; background: rgba(231,81,90,0.08); color: #e7515a; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                                                <iconify-icon icon="tabler:x" width="10"></iconify-icon>
                                                            </button>
                                                        </div>
                                                    </template>
                                                    <template x-if="getSavedFilters().length === 0">
                                                        <div style="text-align: center; padding: 8px; color: #9ca3af; font-size: 10px;">
                                                            Aucun filtre sauvegardé
                                                        </div>
                                                    </template>
                                                </div>
                                            </template>
                                        </div>
                                    </template>

                                    <!-- Footer -->
                                    <div style="display: flex; justify-content: flex-end; gap: 8px; padding: 14px 20px; border-top: 1px solid #f3f4f6;">
                                        <button type="button" @click="ctConfigModal.open = false"
                                                style="padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 500; border: 1px solid #e5e7eb; background: white; color: #374151; cursor: pointer;"
                                                onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='white'">
                                            Annuler
                                        </button>
                                        <button type="button"
                                                @click="ctSaveLayout(ctConfigModal.tabKey); ctConfigModal.open = false"
                                                style="padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; border: none; background: var(--primary-color, #4361ee); color: white; cursor: pointer;"
                                                onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                                            <iconify-icon icon="solar:check-circle-bold" width="14" style="vertical-align: -2px; margin-right: 4px;"></iconify-icon>
                                            Enregistrer
                                        </button>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════ QUICK CREATE MODAL ═══════════════════ -->
            <div x-show="qcOpen" x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                 class="fixed inset-0 z-[999] flex items-center justify-center"
                 style="display: none; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"
                 @click.self="closeQuickCreate()" @keydown.escape.window="closeQuickCreate()">
                <div x-show="qcOpen"
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0 scale-95 translate-y-4" x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                     x-transition:leave="transition ease-in duration-200"
                     x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95 translate-y-4"
                     class="bg-white dark:bg-[#0e1726] rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden border border-gray-100 dark:border-gray-800"
                     @click.stop>

                    <!-- Modal Header -->
                    <div class="flex items-center justify-between px-6 py-4 border-b dark:border-gray-800"
                         :style="'background: linear-gradient(135deg, ' + (qcTab?.color || '#4361ee') + '08, ' + (qcTab?.color || '#4361ee') + '03)'">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center"
                                 :style="'background:' + (qcTab?.color || '#4361ee') + '15'">
                                <iconify-icon :icon="qcTab?.icon || 'solar:widget-bold-duotone'" width="18"
                                              :style="'color:' + (qcTab?.color || '#4361ee')"></iconify-icon>
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-gray-800 dark:text-gray-200" x-text="'Nouveau ' + (qcTab?.label || '')"></h3>
                                <p class="text-[10px] text-gray-400 dark:text-gray-500">
                                    Création rapide · lié à <strong><%= record.title || 'cet enregistrement' %></strong>
                                </p>
                            </div>
                        </div>
                        <button type="button" @click="closeQuickCreate()"
                                class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all">
                            <iconify-icon icon="tabler:x" width="18"></iconify-icon>
                        </button>
                    </div>

                    <!-- Modal Body -->
                    <div class="px-6 py-5 space-y-4">
                        <!-- Loading entity fields -->
                        <template x-if="qcLoading">
                            <div class="flex items-center justify-center py-6">
                                <iconify-icon icon="svg-spinners:ring-resize" width="24" class="text-primary"></iconify-icon>
                            </div>
                        </template>

                        <!-- Form -->
                            <template x-if="!qcLoading">
                            <div class="space-y-3">
                                <!-- Title: Manual or Auto-generated -->
                                <template x-if="!qcAutoTitle">
                                    <div>
                                        <label class="flex items-center gap-1.5 text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">
                                            <iconify-icon icon="solar:text-bold-duotone" width="13" class="text-warning"></iconify-icon>
                                            Titre<span class="text-danger">*</span>
                                        </label>
                                        <input type="text" x-ref="qcTitleInput" x-model="qcTitle"
                                               class="form-input w-full font-medium dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-200"
                                               :placeholder="'Nom du ' + (qcTab?.label || 'record')" />
                                    </div>
                                </template>
                                <template x-if="qcAutoTitle">
                                    <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                                        <iconify-icon icon="solar:magic-stick-3-bold-duotone" width="16" class="text-warning shrink-0"></iconify-icon>
                                        <div class="flex-1 min-w-0">
                                            <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Titre auto-généré</div>
                                            <div class="text-sm font-semibold text-gray-700 dark:text-gray-200 truncate"
                                                 x-text="computeQcTitle() || 'Remplissez les champs...'"
                                                 :class="!computeQcTitle() && 'text-gray-400 italic'"></div>
                                        </div>
                                    </div>
                                </template>

                                <!-- Dynamic fields -->
                                <template x-for="field in qcFields" :key="field.id">
                                    <div>
                                        <label class="flex items-center gap-1.5 text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">
                                            <iconify-icon :icon="field.icon || 'solar:widget-linear'" width="13" class="text-info"></iconify-icon>
                                            <span x-text="field.label || field.name"></span>
                                        </label>
                                        <template x-if="field.type === 'date'">
                                            <input type="date" x-model="qcCustom[field.id]"
                                                   class="form-input w-full text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300">
                                        </template>
                                        <template x-if="field.type === 'datetime-local'">
                                            <input type="datetime-local" x-model="qcCustom[field.id]"
                                                   class="form-input w-full text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300">
                                        </template>
                                        <template x-if="field.type === 'number'">
                                            <input type="number" x-model="qcCustom[field.id]"
                                                   class="form-input w-full text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                   :placeholder="field.label || field.name">
                                        </template>
                                        <template x-if="field.type === 'textarea' || field.type === 'richtext'">
                                            <textarea x-model="qcCustom[field.id]" rows="2"
                                                      class="form-textarea w-full text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                      :placeholder="field.label || field.name"></textarea>
                                        </template>
                                        <template x-if="field.type !== 'date' && field.type !== 'datetime-local' && field.type !== 'number' && field.type !== 'textarea' && field.type !== 'richtext'">
                                            <input type="text" x-model="qcCustom[field.id]"
                                                   class="form-input w-full text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                   :placeholder="field.label || field.name">
                                        </template>
                                    </div>
                                </template>

                                <!-- Classifications (status, tags) -->
                                <template x-for="classif in qcClassifications" :key="classif.id">
                                    <div>
                                        <label class="flex items-center gap-1.5 text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1.5">
                                            <iconify-icon :icon="classif.isStatus ? 'solar:flag-bold-duotone' : 'solar:tag-bold-duotone'" width="13" class="text-secondary"></iconify-icon>
                                            <span x-text="classif.name"></span>
                                        </label>
                                        <div class="flex flex-wrap gap-1.5">
                                            <template x-for="opt in classif.options" :key="opt.id">
                                                <button type="button"
                                                        @click="toggleClassifOption(classif, opt)"
                                                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold border transition-all cursor-pointer"
                                                        :class="isClassifSelected(classif.id, opt.id)
                                                            ? 'text-white shadow-sm'
                                                            : 'bg-gray-50 dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:border-gray-300 dark:hover:border-gray-600'"
                                                        :style="isClassifSelected(classif.id, opt.id)
                                                            ? 'background:' + opt.color + '; border-color:' + opt.color
                                                            : ''">
                                                    <span style="width:6px;height:6px;border-radius:50%;display:inline-block;"
                                                          :style="'background:' + opt.color"></span>
                                                    <span x-text="opt.label"></span>
                                                </button>
                                            </template>
                                        </div>
                                    </div>
                                </template>

                                <!-- Linked record field (read-only) -->
                                <div>
                                    <label class="flex items-center gap-1.5 text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">
                                        <iconify-icon icon="solar:link-round-bold-duotone" width="13" class="text-blue-500"></iconify-icon>
                                        <span><%= entity.nameSingular || entity.name %></span>
                                    </label>
                                    <div class="form-input w-full text-sm bg-gray-50 dark:bg-gray-800/50 border-gray-200 dark:border-gray-700 text-gray-400 dark:text-gray-500 cursor-not-allowed flex items-center gap-2">
                                        <iconify-icon icon="<%= entity.icon || 'solar:widget-bold-duotone' %>" width="14" style="color: <%= entity.color || '#4361ee' %>"></iconify-icon>
                                        <span><%= record.computedTitle || record.title || 'cet enregistrement' %></span>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>

                    <!-- Modal Footer -->
                    <div class="flex items-center justify-between px-6 py-4 border-t dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/20">
                        <a :href="'/account/<%= account_number %>/record/' + (qcTab?.entitySlug || '') + '/add'"
                           target="_blank"
                           class="flex items-center gap-1.5 text-[11px] text-gray-400 hover:text-primary transition-colors">
                            <iconify-icon icon="solar:arrow-right-up-linear" width="13"></iconify-icon>
                            Ouvrir la page complète
                        </a>
                        <div class="flex items-center gap-2">
                            <button type="button" @click="closeQuickCreate()"
                                    class="px-4 py-2 text-xs font-semibold text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-all">
                                Annuler
                            </button>
                            <button type="button" @click="submitQuickCreate()"
                                    :disabled="qcSaving || (!qcAutoTitle && !qcTitle.trim()) || (qcAutoTitle && !computeQcTitle())"
                                    class="flex items-center gap-1.5 px-5 py-2 rounded-lg text-xs font-bold text-white bg-primary hover:bg-primary/90 shadow-md hover:shadow-lg hover:shadow-primary/20 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                    :class="qcSaving ? 'cursor-wait' : ''">
                                <iconify-icon :icon="qcSaving ? 'svg-spinners:ring-resize' : 'tabler:check'" width="14"></iconify-icon>
                                <span x-text="qcSaving ? 'Création...' : 'Créer'"></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══ Custom Tab Modal ═══ -->
            <div x-show="ctOpen" x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                 class="fixed inset-0 z-[999] flex items-center justify-center bg-black/30 dark:bg-black/50"
                 style="backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);"
                 @click.self="closeCustomTabModal()"
                 x-cloak>
                <div class="bg-white dark:bg-[#0e1726] rounded-xl w-full max-w-sm mx-4"
                     style="box-shadow: 0 8px 32px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.08); border: 1px solid rgba(0,0,0,0.06);"
                     @click.stop
                     x-show="ctOpen"
                     x-transition:enter="transition ease-out duration-200 delay-50"
                     x-transition:enter-start="opacity-0 scale-95 translate-y-2"
                     x-transition:enter-end="opacity-100 scale-100 translate-y-0">
                    <!-- Header -->
                    <div class="flex items-center justify-between px-5 py-3.5 border-b dark:border-gray-800">
                        <div class="flex items-center gap-2">
                            <iconify-icon icon="solar:folder-favourite-bookmark-bold-duotone" width="18" class="text-primary"></iconify-icon>
                            <h3 class="font-semibold text-sm dark:text-gray-200">Nouvel onglet personnalisé</h3>
                        </div>
                        <button type="button" @click="closeCustomTabModal()"
                                class="w-7 h-7 rounded-lg flex items-center justify-center text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all">
                            <iconify-icon icon="tabler:x" width="16"></iconify-icon>
                        </button>
                    </div>

                    <!-- Body -->
                    <div class="px-5 py-4 space-y-4">
                        <!-- Icon Picker (inline) -->
                        <div>
                            <label class="block text-[11px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-2">Icône</label>
                            <div class="flex items-center gap-2">
                                <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center ring-1 ring-primary/20">
                                    <iconify-icon :icon="ctIcon" width="18" class="text-primary"></iconify-icon>
                                </div>
                                <button type="button" @click="ctIconPickerOpen = !ctIconPickerOpen"
                                        class="flex items-center justify-center w-8 h-8 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-primary hover:bg-primary/5 transition-all text-gray-500 hover:text-primary active:scale-95 bg-white dark:bg-[#1b2e4b]"
                                        title="Choisir une icône">
                                    <iconify-icon icon="tabler:palette" width="16"></iconify-icon>
                                </button>
                            </div>
                            <!-- Inline Icon Grid (slides down inside modal) -->
                            <div x-show="ctIconPickerOpen" x-transition:enter="transition ease-out duration-200"
                                 x-transition:enter-start="opacity-0 -translate-y-1" x-transition:enter-end="opacity-100 translate-y-0"
                                 x-transition:leave="transition ease-in duration-150"
                                 x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0 -translate-y-1"
                                 class="mt-3 p-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-100 dark:border-gray-700 shadow-lg shadow-gray-200/60 dark:shadow-black/30"
                                 x-cloak>
                                <div style="display: grid !important; grid-template-columns: repeat(7, 1fr) !important; gap: 6px !important;">
                                    <template x-for="icon in ctIconOptions" :key="icon">
                                        <button type="button" @click="ctIcon = icon; ctIconPickerOpen = false"
                                                class="flex items-center justify-center rounded-lg transition-all text-gray-400 hover:text-primary"
                                                :class="ctIcon === icon ? 'bg-primary/15 text-primary ring-1 ring-primary/30' : 'hover:bg-gray-100 dark:hover:bg-gray-700'"
                                                :title="icon"
                                                style="width: 36px; height: 36px;">
                                            <iconify-icon :icon="icon" width="18"></iconify-icon>
                                        </button>
                                    </template>
                                </div>
                            </div>
                        </div>

                        <!-- Tab Name -->
                        <div>
                            <label class="block text-[11px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-2" for="ct-name-input">Nom de l'onglet</label>
                            <input type="text" id="ct-name-input" x-model="ctName"
                                   @keyup.enter="submitCustomTab()"
                                   class="form-input w-full text-sm dark:bg-[#1b2e4b] dark:border-gray-800 dark:text-gray-200"
                                   placeholder="Ex: Notes, Documents, Suivi...">
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="flex items-center justify-end gap-2 px-5 py-3.5 border-t dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/20 rounded-b-xl">
                        <button type="button" @click="closeCustomTabModal()"
                                class="px-4 py-2 text-xs font-semibold text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-all">
                            Annuler
                        </button>
                        <button type="button" @click="submitCustomTab()"
                                :disabled="!ctName.trim()"
                                class="flex items-center gap-1.5 px-5 py-2 rounded-lg text-xs font-bold text-white bg-primary hover:bg-primary/90 shadow-md hover:shadow-lg hover:shadow-primary/20 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                            <iconify-icon icon="tabler:check" width="14"></iconify-icon>
                            <span>Créer</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script>
        function recordTabs() {
            const accountNumber = '<%= account_number %>';
            const recordId = '<%= record._id %>';
            const entityId = '<%= entity._id %>';
            const entitySlug = '<%= entity.slug %>';
            const viewId = 'record_tabs_' + entityId;
            const initialMeta = <%- JSON.stringify(locals.relationTabsMeta || []) %>;

            // Entity metadata for widget config
            const ctEntityFields = <%- JSON.stringify(
                (entity.customFields || []).filter(f => f != null).map(f => ({
                    _id: (f._id || '').toString(),
                    label: f.label || f.name || '',
                    name: f.name || '',
                    type: f.type || 'string',
                    inputType: f.inputType || '',
                    icon: (f.ui && f.ui.icon) || ''
                }))
            ) %>;
            const ctEntityRelations = <%- JSON.stringify(
                (entity.relations || []).map(r => ({
                    key: r.key || '',
                    label: r.label || '',
                    targetName: (r.targetEntity && r.targetEntity.name) || '',
                    targetSlug: (r.targetEntity && r.targetEntity.slug) || '',
                    targetIcon: (r.targetEntity && r.targetEntity.icon) || '',
                    targetColor: (r.targetEntity && r.targetEntity.color) || '#4361ee',
                    targetId: (r.targetEntity && r.targetEntity._id ? r.targetEntity._id.toString() : ''),
                    cardinality: r.cardinality || 'one-to-many'
                }))
            ) %>;
            const ctEntityInfo = {
                name: '<%= entity.name || "" %>',
                slug: '<%= entity.slug || "" %>',
                icon: '<%= entity.icon || "solar:box-bold-duotone" %>',
                color: '<%= entity.color || "#4361ee" %>'
            };
            const ctGridSchemas = <%- JSON.stringify(
                (locals.gridSchemas || []).filter(gs => gs && gs.schema).map(gs => ({
                    id: (gs.schemaId || gs.schema._id || '').toString(),
                    name: gs.schema.name || gs.label || '',
                    slug: gs.schema.slug || '',
                    columns: (gs.schema.columns || []).filter(c => c).map(c => ({
                        key: c.key || '',
                        label: c.label || '',
                        type: c.type || 'text',
                        unit: (c.config && c.config.unit) || '',
                        normalRange: (c.config && c.config.normalRange) || null
                    }))
                }))
            ) %>;

            return {
                allTabs: [],
                customTabs: [],  // Custom tabs created by user
                activeTab: '__self__',  // Self tab is active by default (synced to $store.recordTabs)
                tabLoading: false,
                tabRecords: [],
                tabCache: {},
                showConfig: false,
                _sortableInstance: null,
                _tabBarSortable: null,

                // Custom tab content (per-tab notes) — legacy, kept for migration
                customTabContents: {},  // { tabKey: '<html content>' }
                _contentSaveTimer: null,
                _contentSaving: false,

                // Per-tab field assignment — legacy, kept for migration
                fieldAssignments: {},   // { 'standard_title': 'custom_notes_123', ... }
                fieldPickerOpen: false, // whether the field picker dropdown is open
                fieldPickerTab: null,   // which custom tab the picker is for

                // Per-tab layout mode — legacy  
                tabLayouts: {},         // { 'custom_123': 'side-fields-notes', ... }

                // ═══ Layout Builder State ═══
                customTabLayouts: {},   // { tabKey: { rows: [...], blocks: {...} } }
                ctEditMode: false,     // toggle between edit (builder) and view (display) mode
                ctWidgetPickerOpen: false,
                ctWidgetPickerTarget: null, // { tabKey, rowId, colId }
                ctConfigModal: { open: false, tabKey: null, blockId: null }, // per-widget config modal
                _ctSortables: {},       // { 'rows': Sortable, 'col_xxx': Sortable, ... }
                ctWidgetCatalog: [
                    { type: 'notes',    label: 'Notes',      icon: 'solar:document-text-bold-duotone', color: '#4361ee', bg: 'rgba(67,97,238,0.1)',  desc: 'Texte enrichi' },
                    { type: 'tasks',    label: 'Tâches',     icon: 'solar:checklist-bold-duotone',     color: '#00ab55', bg: 'rgba(0,171,85,0.1)',   desc: 'Checklist' },
                    { type: 'timeline', label: 'Timeline',   icon: 'solar:clock-circle-bold-duotone',  color: '#805dca', bg: 'rgba(128,93,202,0.1)', desc: 'Historique' },
                    { type: 'kpi',      label: 'KPI',        icon: 'solar:graph-up-bold-duotone',      color: '#e7515a', bg: 'rgba(231,81,90,0.1)',  desc: 'Indicateur' },
                    { type: 'chart',    label: 'Graphique',  icon: 'solar:chart-bold-duotone',         color: '#e2a03f', bg: 'rgba(226,160,63,0.1)', desc: 'Visualisation' },
                    { type: 'fields',   label: 'Champs',     icon: 'solar:layers-bold-duotone',        color: '#2196f3', bg: 'rgba(33,150,243,0.1)', desc: 'Champs entity' },
                    { type: 'cards',    label: 'Cartes',     icon: 'solar:card-bold-duotone',          color: '#e2a03f', bg: 'rgba(226,160,63,0.1)', desc: 'Records liés' },
                    { type: 'iframe',   label: 'Embed',      icon: 'solar:code-bold-duotone',          color: '#00ab55', bg: 'rgba(0,171,85,0.1)',   desc: 'Contenu externe' },
                ],
                ctResizeState: { active: false, tabKey: null, rowId: null, colIndex: null, startX: 0, startWidths: [] },

                // Custom Tab Modal state
                ctOpen: false,
                ctName: '',
                ctIcon: 'solar:widget-bold-duotone',
                ctIconPickerOpen: false,
                ctIconOptions: [
                    'solar:widget-bold-duotone', 'solar:document-text-bold-duotone', 'solar:notes-bold-duotone',
                    'solar:clipboard-list-bold-duotone', 'solar:stethoscope-bold-duotone', 'solar:heart-pulse-bold-duotone',
                    'solar:pill-bold-duotone', 'solar:test-tube-bold-duotone', 'solar:shield-check-bold-duotone',
                    'solar:calendar-bold-duotone', 'solar:user-bold-duotone', 'solar:users-group-rounded-bold-duotone',
                    'solar:chat-round-dots-bold-duotone', 'solar:phone-bold-duotone', 'solar:mailbox-bold-duotone',
                    'solar:folder-bold-duotone', 'solar:file-text-bold-duotone', 'solar:chart-bold-duotone',
                    'solar:star-bold-duotone', 'solar:flag-bold-duotone', 'solar:map-point-bold-duotone',
                    'solar:clock-circle-bold-duotone', 'solar:camera-bold-duotone', 'solar:gallery-bold-duotone',
                    'solar:link-bold-duotone', 'solar:settings-bold-duotone', 'solar:tag-bold-duotone',
                    'solar:bookmark-bold-duotone', 'solar:dollar-bold-duotone', 'solar:delivery-bold-duotone',
                    'solar:home-bold-duotone', 'solar:database-bold-duotone', 'solar:code-bold-duotone',
                    'solar:lock-bold-duotone', 'solar:eye-bold-duotone'
                ],

                // Quick Create Modal state
                qcOpen: false,
                qcTab: null,
                qcLoading: false,
                qcSaving: false,
                qcTitle: '',
                qcFields: [],
                qcClassifications: [],
                qcCustom: {},
                qcClassifValues: {},  // { classifId: optionId } or { classifId: [optionId, ...] }
                qcEntityRelations: [], // relation definitions from target entity
                qcTitleTokens: [],    // referenceTitleTokens from target entity
                qcAutoTitle: false,   // true when title should be auto-generated

                get visibleTabs() {
                    return this.allTabs.filter(t => t.visible !== false);
                },

                get activeTabMeta() {
                    if (this.activeTab === '__self__') return null;
                    return this.allTabs.find(t => t.key === this.activeTab) || null;
                },

                // Determine if "+" create is allowed on this tab
                canAddOnTab(tab) {
                    if (!tab) return false;
                    const card = tab.cardinality || 'one-to-many';
                    const count = tab._count || 0;

                    if (tab.direction === 'direct') {
                        // Direct one-to-one: only if no record linked
                        if (card === 'one-to-one') return count === 0;
                        // Direct many-to-one: this record points to ONE target (e.g. Consultation → 1 Patient)
                        if (card === 'many-to-one') return count === 0;
                        // Direct one-to-many/many-to-many: always OK
                        return true;
                    }
                    if (tab.direction === 'inverse') {
                        // Inverse of one-to-many = many-to-one → the other entity stores the foreign key
                        // Each new record of the other entity can point back to us → always OK
                        if (card === 'many-to-one') return true;
                        // Inverse of many-to-one = one-to-many → multiple records can reference us → always OK
                        if (card === 'one-to-many') return true;
                        // Inverse of many-to-many → always OK
                        if (card === 'many-to-many') return true;
                        // Inverse of one-to-one → only if count is 0
                        if (card === 'one-to-one') return count === 0;
                    }
                    return true;
                },

                // Custom Tab Modal
                openCustomTabModal() {
                    this.ctName = '';
                    this.ctIcon = 'solar:widget-bold-duotone';
                    this.ctIconPickerOpen = false;
                    this.ctOpen = true;
                    this.$nextTick(() => {
                        const input = document.getElementById('ct-name-input');
                        if (input) input.focus();
                    });
                },

                closeCustomTabModal() {
                    this.ctOpen = false;
                    this.ctName = '';
                },

                submitCustomTab() {
                    const name = this.ctName.trim();
                    if (!name) return;

                    // Prevent duplicate custom tab names
                    const duplicate = this.allTabs.find(t => t.isCustom && t.label.toLowerCase() === name.toLowerCase());
                    if (duplicate) {
                        this._showToast('Un onglet avec ce nom existe déjà', 'error');
                        return;
                    }

                    const tabKey = 'custom_' + Date.now();
                    const newTab = {
                        key: tabKey,
                        label: name,
                        icon: this.ctIcon || 'solar:widget-bold-duotone',
                        color: '#4361ee',
                        visible: true,
                        _count: 0,
                        direction: 'custom',
                        isCustom: true
                    };

                    this.allTabs.push(newTab);
                    this.customTabs.push(newTab);
                    this.closeCustomTabModal();
                    this.selectTab(tabKey);
                    this._savePrefs();
                },

                removeCustomTab(key) {
                    this.allTabs = this.allTabs.filter(t => t.key !== key);
                    this.customTabs = this.customTabs.filter(t => t.key !== key);
                    if (this.activeTab === key) {
                        this.activeTab = '__self__';
                        Alpine.store('recordTabs').activeTab = '__self__';
                        this.tabRecords = [];
                    }
                    this._savePrefs();
                },

                async init() {
                    // Load saved preferences from account-level API
                    let savedTabPrefs = null;
                    let savedCustomTabs = null;
                    let savedTabOrder = null;
                    try {
                        const res = await fetch(`/account/${accountNumber}/api/account/view-preferences/${viewId}`, { credentials: 'include' });
                        const data = await res.json();
                        savedTabPrefs = data?.preferences?.relationTabs || null;
                        savedCustomTabs = data?.preferences?.customTabs || null;
                        savedTabOrder = data?.preferences?.tabOrder || null;
                        // Load field assignments
                        if (data?.preferences?.fieldAssignments) {
                            this.fieldAssignments = data.preferences.fieldAssignments;
                            this.$store.recordTabs.fieldAssignments = { ...this.fieldAssignments };
                        }
                        // Load per-tab layouts
                        if (data?.preferences?.tabLayouts) {
                            this.tabLayouts = data.preferences.tabLayouts;
                        }
                        // Load layout builder data
                        if (data?.preferences?.customTabLayouts) {
                            this.customTabLayouts = data.preferences.customTabLayouts;
                        }
                    } catch (e) { /* ignore */ }

                    // Fallback: try user-level preferences (backward compatibility)
                    if (!savedTabPrefs) {
                        try {
                            const res = await fetch(`/account/${accountNumber}/api/user/view-preferences/record-edit-${entityId}`, { credentials: 'include' });
                            const data = await res.json();
                            savedTabPrefs = data?.preferences?.relationTabs || null;
                        } catch (e) { /* ignore */ }
                    }

                    // Build relation tabs from initialMeta + saved prefs
                    let relationTabs = [];
                    if (savedTabPrefs && Array.isArray(savedTabPrefs)) {
                        const metaMap = {};
                        initialMeta.forEach(m => { metaMap[m.key] = { ...m, _count: m.count || 0, visible: true }; });
                        const merged = [];
                        savedTabPrefs.forEach(sp => {
                            if (metaMap[sp.key]) {
                                merged.push({ ...metaMap[sp.key], visible: sp.visible !== false });
                                delete metaMap[sp.key];
                            }
                        });
                        Object.values(metaMap).forEach(m => merged.push(m));
                        relationTabs = merged;
                    } else {
                        relationTabs = initialMeta.map(m => ({ ...m, _count: m.count || 0, visible: true }));
                    }

                    // Load custom tabs
                    let customTabsList = [];
                    if (savedCustomTabs && Array.isArray(savedCustomTabs)) {
                        customTabsList = savedCustomTabs.map(ct => ({
                            ...ct,
                            _count: 0,
                            direction: 'custom',
                            isCustom: true,
                            visible: ct.visible !== false
                        }));
                        // Load saved content for each custom tab
                        savedCustomTabs.forEach(ct => {
                            if (ct.content) {
                                this.customTabContents[ct.key] = ct.content;
                            }
                        });
                    }
                    this.customTabs = customTabsList;

                    // Combine and apply saved order
                    const allCombined = [...relationTabs, ...customTabsList];
                    if (savedTabOrder && Array.isArray(savedTabOrder) && savedTabOrder.length > 0) {
                        const tabMap = {};
                        allCombined.forEach(t => { tabMap[t.key] = t; });
                        const ordered = [];
                        savedTabOrder.forEach(key => {
                            if (tabMap[key]) {
                                ordered.push(tabMap[key]);
                                delete tabMap[key];
                            }
                        });
                        // Append any new tabs not in saved order
                        Object.values(tabMap).forEach(t => ordered.push(t));
                        this.allTabs = ordered;
                    } else {
                        this.allTabs = allCombined;
                    }

                    // Init SortableJS for config panel
                    this.$nextTick(() => {
                        this.$watch('showConfig', (val) => {
                            if (val) {
                                this.$nextTick(() => this._initSortable());
                            }
                        });
                        // Init SortableJS for tab bar drag & drop
                        this._initTabBarSortable();
                    });

                    // Expose for relation fields panel quick create
                    window.relationTabsApp = this;

                    // Sync activeTab changes to Alpine store so panelLayout can react
                    this.$watch('activeTab', (val) => {
                        Alpine.store('recordTabs').activeTab = val;
                        // When switching to a custom tab, relocate its assigned fields
                        if (val && val.startsWith('custom_')) {
                            this._relocateAssignedFieldsForTab(val);
                        }
                    });
                },

                _initSortable() {
                    const el = document.getElementById('unified-tabs-sortable');
                    if (!el || this._sortableInstance) return;
                    if (typeof Sortable === 'undefined') return;

                    this._sortableInstance = new Sortable(el, {
                        handle: '.drag-handle',
                        animation: 200,
                        ghostClass: 'opacity-30',
                        onStart: () => {
                            this._preDragOrder = this.allTabs.map(t => t.key);
                        },
                        onEnd: (evt) => {
                            const { oldDraggableIndex, newDraggableIndex } = evt;
                            if (oldDraggableIndex === newDraggableIndex) return;

                            // Compute new order from pre-drag snapshot
                            const order = [...this._preDragOrder];
                            const [moved] = order.splice(oldDraggableIndex, 1);
                            order.splice(newDraggableIndex, 0, moved);
                            const tabMap = {};
                            this.allTabs.forEach(t => { tabMap[t.key] = t; });
                            const newTabs = order.map(key => tabMap[key]).filter(Boolean);

                            // Destroy Sortable FIRST to release DOM references
                            this._sortableInstance.destroy();
                            this._sortableInstance = null;

                            // FLUSH: clear array to force Alpine to destroy all x-for DOM nodes
                            this.allTabs = [];
                            // REBUILD: on next tick, set new order so Alpine rebuilds fresh DOM
                            this.$nextTick(() => {
                                this.allTabs = newTabs;
                                this.$nextTick(() => this._initSortable());
                                this._savePrefs();
                            });
                        }
                    });
                },

                async selectTab(key) {
                    if (key === '__self__') {
                        this.activeTab = '__self__';
                        this.tabRecords = [];
                        return;
                    }

                    if (this.activeTab === key) {
                        // Toggle: clicking same tab goes back to self
                        this.activeTab = '__self__';
                        this.tabRecords = [];
                        return;
                    }

                    this.activeTab = key;

                    // Custom tabs don't have entity data to fetch
                    const tabMeta = this.allTabs.find(t => t.key === key);
                    if (tabMeta && tabMeta.isCustom) {
                        this.tabRecords = [];
                        this.tabLoading = false;
                        return;
                    }

                    // Check cache
                    if (this.tabCache[key]) {
                        this.tabRecords = this.tabCache[key];
                        return;
                    }

                    // Fetch from API
                    this.tabLoading = true;
                    this.tabRecords = [];
                    try {
                        const res = await fetch(`/account/${accountNumber}/api/record/${recordId}/relation-records/${key}`, { credentials: 'include' });
                        const data = await res.json();
                        this.tabRecords = data.records || [];
                        this.tabCache[key] = this.tabRecords;

                        // Update count
                        const tab = this.allTabs.find(t => t.key === key);
                        if (tab) tab._count = this.tabRecords.length;
                    } catch (e) {
                        console.error('Error fetching relation records:', e);
                    } finally {
                        this.tabLoading = false;
                    }
                },

                // ═══ Quick Create Modal ═══
                async openQuickCreate(tab) {
                    if (!tab) return;
                    this.qcTab = tab;
                    this.qcTitle = '';
                    this.qcCustom = {};
                    this.qcClassifValues = {};
                    this.qcFields = [];
                    this.qcClassifications = [];
                    this.qcEntityRelations = [];
                    this.qcOpen = true;
                    this.qcLoading = true;

                    // Focus title input after transition
                    this.$nextTick(() => {
                        setTimeout(() => {
                            if (this.$refs.qcTitleInput) this.$refs.qcTitleInput.focus();
                        }, 150);
                    });

                    // Fetch entity fields for the form (with quickForm filter)
                    try {
                        const res = await fetch(`/account/${accountNumber}/api/hierarchy/entity/${tab.entityId}/fields?quickForm=1`, { credentials: 'include' });
                        const data = await res.json();
                        if (data.success && data.entity) {
                            let fields = data.entity.fields || [];

                            // If no fields marked with showOnQuickForm, fallback to first 6
                            if (fields.length === 0) {
                                const allRes = await fetch(`/account/${accountNumber}/api/hierarchy/entity/${tab.entityId}/fields`, { credentials: 'include' });
                                const allData = await allRes.json();
                                if (allData.success && allData.entity?.fields) {
                                    fields = allData.entity.fields.slice(0, 6);
                                }
                            }

                            this.qcFields = fields.map(f => ({
                                id: f.id,
                                name: f.name,
                                label: f.label || f.name?.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
                                type: f.type || 'text',
                                icon: f.icon || 'solar:widget-linear'
                            }));

                            // Classifications
                            this.qcClassifications = data.entity.classifications || [];

                            // Relations info for many-to-many handling
                            this.qcEntityRelations = data.entity.relations || [];

                            // Reference title tokens for auto-generating title
                            const tokens = data.entity.referenceTitleTokens || [{ t: 'field', id: 'title' }];
                            this.qcTitleTokens = tokens;
                            // Auto-title is active when the entity uses tokens that are NOT just 'title'
                            const hasNonTitleField = tokens.some(t => t.t === 'field' && t.id && t.id !== 'title');
                            const hasTitleField = tokens.some(t => t.t === 'field' && t.id === 'title');
                            this.qcAutoTitle = hasNonTitleField && !hasTitleField;
                        }
                    } catch (e) {
                        console.error('Error fetching entity fields:', e);
                    } finally {
                        this.qcLoading = false;
                    }
                },

                closeQuickCreate() {
                    this.qcOpen = false;
                    this.qcTab = null;
                    this.qcTitle = '';
                    this.qcFields = [];
                    this.qcClassifications = [];
                    this.qcCustom = {};
                    this.qcClassifValues = {};
                    this.qcEntityRelations = [];
                    this.qcTitleTokens = [];
                    this.qcAutoTitle = false;
                },

                // Classification option toggle
                toggleClassifOption(classif, opt) {
                    if (classif.allowMultiple) {
                        const arr = this.qcClassifValues[classif.id] || [];
                        const idx = arr.indexOf(opt.id);
                        if (idx >= 0) arr.splice(idx, 1);
                        else arr.push(opt.id);
                        this.qcClassifValues[classif.id] = [...arr];
                    } else {
                        // Single select: toggle on/off
                        this.qcClassifValues[classif.id] = this.qcClassifValues[classif.id] === opt.id ? null : opt.id;
                    }
                },

                isClassifSelected(classifId, optId) {
                    const val = this.qcClassifValues[classifId];
                    if (Array.isArray(val)) return val.includes(optId);
                    return val === optId;
                },

                // Compute title from referenceTitleTokens using current field values
                computeQcTitle() {
                    if (!this.qcTitleTokens || this.qcTitleTokens.length === 0) return '';
                    const parts = this.qcTitleTokens.map(token => {
                        if (token.t === 'text') return token.v || '';
                        if (token.t === 'field') {
                            // Standard fields
                            if (token.id === 'title') return this.qcTitle || '';
                            if (token.id === 'date') {
                                return new Date().toISOString().split('T')[0];
                            }
                            // Custom fields — match by field_id
                            const val = this.qcCustom[token.id];
                            if (val) return val;
                            // Check if it's a date field and format nicely
                            const field = this.qcFields.find(f => f.id === token.id);
                            if (field && (field.type === 'date' || field.type === 'datetime-local') && val) {
                                return val.substring(0, 10);
                            }
                            return '';
                        }
                        return '';
                    });
                    return parts.join('').trim();
                },

                async submitQuickCreate() {
                    // Compute title: auto-generated or manual
                    const finalTitle = this.qcAutoTitle ? this.computeQcTitle() : this.qcTitle.trim();
                    if (!finalTitle || this.qcSaving) return;

                    this.qcSaving = true;
                    const tab = this.qcTab;

                    try {
                        // Build custom fields payload (including relation back to this record)
                        const customFields = { ...this.qcCustom };

                        // Auto-link: set the relation field pointing back to this record
                        // For inverse relations: the target entity has a relation with sourceRelationKey pointing to our entity
                        if (tab.direction === 'inverse' && tab.sourceRelationKey) {
                            customFields[tab.sourceRelationKey] = recordId;
                        }

                        // For direct relations: find the matching relation on the target entity that points back
                        // Also handles many-to-many: we need to update the current record's relation too
                        let directRelationKey = null;
                        if (tab.direction === 'direct') {
                            directRelationKey = tab.key;
                            // Also check if the target entity has a reverse relation to auto-link
                            const reverseRel = this.qcEntityRelations.find(r => r.targetEntity === entityId);
                            if (reverseRel) {
                                customFields[reverseRel.key] = recordId;
                            }
                        }

                        // Build classification values
                        const classificationValues = [];
                        for (const classif of this.qcClassifications) {
                            const val = this.qcClassifValues[classif.id];
                            if (!val) continue;
                            const optIds = Array.isArray(val) ? val : [val];
                            for (const optId of optIds) {
                                const opt = classif.options.find(o => o.id === optId);
                                if (opt) {
                                    classificationValues.push({
                                        classificationId: classif.id,
                                        optionId: optId,
                                        label: opt.label,
                                        color: opt.color
                                    });
                                }
                            }
                        }

                        const payload = {
                            title: finalTitle,
                            entityId: tab.entityId,
                            customFields,
                            classificationValues
                        };

                        const res = await fetch(`/account/${accountNumber}/record/${tab.entitySlug}/save`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify(payload)
                        });

                        const data = await res.json();
                        if (data.success && data._id) {
                            // For direct relations (especially many-to-many):
                            // Update the CURRENT record's relation array to include the new record
                            if (directRelationKey) {
                                try {
                                    await fetch(`/account/${accountNumber}/record/${entitySlug}/${recordId}/update-relation`, {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        credentials: 'include',
                                        body: JSON.stringify({
                                            relationKey: directRelationKey,
                                            targetRecordId: data._id,
                                            action: 'add'
                                        })
                                    });
                                } catch (e) {
                                    console.warn('Could not update source relation:', e);
                                }
                            }

                            // Success! Close modal and refresh the tab
                            this.closeQuickCreate();

                            // Clear cache for this tab so it refetches
                            delete this.tabCache[tab.key];

                            // If this tab is currently active, refresh it
                            if (this.activeTab === tab.key) {
                                await this.selectTab('__self__'); // Reset first
                                await this.selectTab(tab.key);   // Re-fetch
                            } else {
                                // Switch to the tab to see the new record
                                await this.selectTab(tab.key);
                            }

                            // Show success feedback
                            this._showToast('Enregistrement créé avec succès !', 'success');
                        } else {
                            this._showToast('Erreur lors de la création', 'error');
                        }
                    } catch (e) {
                        console.error('Error creating record:', e);
                        this._showToast('Erreur de connexion', 'error');
                    } finally {
                        this.qcSaving = false;
                    }
                },

                _showToast(message, type) {
                    // Simple toast notification
                    const toast = document.createElement('div');
                    toast.className = `fixed bottom-6 right-6 z-[9999] flex items-center gap-2 px-4 py-3 rounded-xl shadow-2xl text-sm font-medium transition-all duration-500 ${
                        type === 'success'
                            ? 'bg-emerald-500 text-white'
                            : 'bg-red-500 text-white'
                    }`;
                    toast.innerHTML = `
                        <iconify-icon icon="${type === 'success' ? 'tabler:check' : 'tabler:x'}" width="16"></iconify-icon>
                        <span>${message}</span>
                    `;
                    toast.style.transform = 'translateY(20px)';
                    toast.style.opacity = '0';
                    document.body.appendChild(toast);
                    requestAnimationFrame(() => {
                        toast.style.transform = 'translateY(0)';
                        toast.style.opacity = '1';
                    });
                    setTimeout(() => {
                        toast.style.transform = 'translateY(20px)';
                        toast.style.opacity = '0';
                        setTimeout(() => toast.remove(), 500);
                    }, 3000);
                },

                toggleTabVisibility(key, visible) {
                    const tab = this.allTabs.find(t => t.key === key);
                    if (tab) {
                        tab.visible = visible;
                        if (!visible && this.activeTab === key) {
                            this.activeTab = '__self__';
                            this.tabRecords = [];
                        }
                    }
                    this._savePrefs();
                },

                resetConfig() {
                    // Reset relation tabs to defaults but PRESERVE custom tabs
                    const resetRelations = initialMeta.map(m => ({ ...m, _count: m.count || 0, visible: true }));
                    const existingCustom = this.allTabs.filter(t => t.isCustom);
                    this.allTabs = [...resetRelations, ...existingCustom];
                    this._savePrefs();
                    if (this._sortableInstance) {
                        this._sortableInstance.destroy();
                        this._sortableInstance = null;
                    }
                    this.$nextTick(() => this._initSortable());
                },

                // Init SortableJS on the tab bar buttons for direct drag reorder
                _initTabBarSortable() {
                    const scrollContainer = document.getElementById('unified-tabs-scroll');
                    if (!scrollContainer || this._tabBarSortable) return;
                    if (typeof Sortable === 'undefined') return;

                    this._tabBarSortable = new Sortable(scrollContainer, {
                        animation: 200,
                        ghostClass: 'opacity-30',
                        draggable: '.relation-tab-draggable',
                        filter: '.no-drag',
                        preventOnFilter: false,
                        onStart: () => {
                            // Snapshot visible tab keys BEFORE any DOM mutation
                            this._preDragVisibleKeys = this.allTabs
                                .filter(t => t.visible !== false)
                                .map(t => t.key);
                        },
                        onEnd: (evt) => {
                            const { oldDraggableIndex, newDraggableIndex } = evt;
                            if (oldDraggableIndex === newDraggableIndex) return;

                            // Use pre-drag snapshot to identify which tabs moved
                            const visibleKeys = [...this._preDragVisibleKeys];
                            const fromKey = visibleKeys[oldDraggableIndex];
                            const toKey = visibleKeys[newDraggableIndex];
                            if (!fromKey || !toKey) return;

                            // Find positions in the FULL allTabs array (includes hidden tabs)
                            const fromIdx = this.allTabs.findIndex(t => t.key === fromKey);
                            const toIdx = this.allTabs.findIndex(t => t.key === toKey);
                            if (fromIdx === -1 || toIdx === -1) return;

                            // Compute new order
                            const newTabs = [...this.allTabs];
                            const [moved] = newTabs.splice(fromIdx, 1);
                            newTabs.splice(toIdx, 0, moved);

                            // Destroy Sortable FIRST to release DOM references
                            this._tabBarSortable.destroy();
                            this._tabBarSortable = null;

                            // FLUSH: clear array to force Alpine to destroy all x-for DOM nodes
                            this.allTabs = [];
                            // REBUILD: on next tick, set new order so Alpine rebuilds fresh DOM
                            this.$nextTick(() => {
                                this.allTabs = newTabs;
                                this.$nextTick(() => this._initTabBarSortable());
                                this._savePrefs();
                            });
                        }
                    });
                },

                // ═══ Custom Tab Content (Notes Editor) ═══
                _loadTabContent(tabKey) {
                    if (!tabKey || !tabKey.startsWith('custom_')) return;
                    this.$nextTick(() => {
                        const editor = document.getElementById('custom-tab-editor-' + tabKey);
                        if (!editor) return;
                        const saved = this.customTabContents[tabKey] || '';
                        if (editor.innerHTML !== saved) {
                            editor.innerHTML = saved;
                        }
                        // Show placeholder styling if empty
                        if (!saved) {
                            editor.setAttribute('data-placeholder', 'Écrivez vos notes ici...');
                        }
                    });
                },

                _onCustomTabInput() {
                    const tabKey = this.activeTab;
                    if (!tabKey || !tabKey.startsWith('custom_')) return;
                    const editor = document.getElementById('custom-tab-editor-' + tabKey);
                    if (!editor) return;

                    // Sync DOM → state
                    this.customTabContents[tabKey] = editor.innerHTML;

                    // Debounced save (1 second after last keystroke)
                    if (this._contentSaveTimer) clearTimeout(this._contentSaveTimer);
                    this._contentSaveTimer = setTimeout(() => {
                        this._saveCustomTabContent();
                    }, 1000);
                },

                async _saveCustomTabContent() {
                    this._contentSaving = true;
                    try {
                        await this._savePrefs();
                    } finally {
                        this._contentSaving = false;
                    }
                },

                _execCmd(cmd) {
                    document.execCommand(cmd, false, null);
                    // Re-focus editor
                    const editor = document.getElementById('custom-tab-editor-' + this.activeTab);
                    if (editor) editor.focus();
                },

                _onCustomTabPaste(event) {
                    const html = event.clipboardData?.getData('text/html');
                    const text = event.clipboardData?.getData('text/plain') || '';
                    if (html) {
                        // Clean paste: strip dangerous tags but keep basic formatting
                        const temp = document.createElement('div');
                        temp.innerHTML = html;
                        // Remove scripts, styles, meta
                        temp.querySelectorAll('script,style,meta,link').forEach(el => el.remove());
                        document.execCommand('insertHTML', false, temp.innerHTML);
                    } else {
                        document.execCommand('insertText', false, text);
                    }
                    this._onCustomTabInput();
                },

                // ═══ Per-Tab Field Assignment ═══
                getAvailableFields() {
                    const allFields = [];
                    const seen = new Set();
                    
                    // Method 1: Scan DOM for record-field-wrapper elements (both EJS and legacy)
                    document.querySelectorAll('.record-field-wrapper[data-field-id]').forEach(el => {
                        const fid = el.dataset.fieldId;
                        if (seen.has(fid) || this.fieldAssignments[fid]) return;
                        seen.add(fid);
                        allFields.push({ 
                            id: fid, 
                            label: el.dataset.fieldLabel || fid, 
                            type: el.dataset.fieldType || 'custom' 
                        });
                    });
                    
                    // Method 2: Read from legacy builder's fieldsById (for fields not yet rendered)
                    if (window.recordFormApp?.fieldsById) {
                        Object.entries(window.recordFormApp.fieldsById).forEach(([fieldId, field]) => {
                            if (field.type === 'relation') return; // Relations have their own panel
                            const fid = (field.type || 'custom') + '_' + fieldId;
                            if (seen.has(fid) || this.fieldAssignments[fid]) return;
                            seen.add(fid);
                            allFields.push({
                                id: fid,
                                label: field.label || field.name || fieldId,
                                type: field.type || 'custom'
                            });
                        });
                    }
                    
                    return allFields;
                },

                getFieldsForTab(tabKey) {
                    return Object.entries(this.fieldAssignments)
                        .filter(([_, tk]) => tk === tabKey)
                        .map(([fid, _]) => {
                            // Try to get label from DOM
                            const el = document.querySelector(`.record-field-wrapper[data-field-id="${fid}"]`);
                            if (el) {
                                return { id: fid, label: el.dataset.fieldLabel || fid, type: el.dataset.fieldType || 'custom' };
                            }
                            // Try from legacy builder
                            const parts = fid.split('_');
                            const type = parts[0];
                            const rawId = parts.slice(1).join('_');
                            if (window.recordFormApp?.fieldsById?.[rawId]) {
                                const field = window.recordFormApp.fieldsById[rawId];
                                return { id: fid, label: field.label || field.name || rawId, type };
                            }
                            return { id: fid, label: fid, type: 'custom' };
                        });
                },

                assignFieldToTab(fieldId, tabKey) {
                    this.fieldAssignments[fieldId] = tabKey;
                    this.$store.recordTabs.fieldAssignments = { ...this.fieldAssignments };
                    this.fieldPickerOpen = false;
                    this._refreshFieldsDisplay();
                    this._savePrefs();
                },

                unassignField(fieldId) {
                    delete this.fieldAssignments[fieldId];
                    this.$store.recordTabs.fieldAssignments = { ...this.fieldAssignments };
                    this._refreshFieldsDisplay();
                    this._savePrefs();
                },

                _refreshFieldsDisplay() {
                    // For legacy builder: trigger rebuildCanvas to re-render with updated visibility
                    if (window.recordFormApp?.rebuildCanvas) {
                        window.recordFormApp.rebuildCanvas();
                    }
                    // For EJS layout: fields use x-show which auto-updates via the store
                    // Relocate fields for the active custom tab
                    if (this.activeTab?.startsWith('custom_')) {
                        this.$nextTick(() => this._relocateAssignedFieldsForTab(this.activeTab));
                    }
                },

                _relocateField(fieldId, tabKey) {
                    // Not used anymore for legacy builder — fields are re-rendered in custom tab container
                },

                _returnFieldToForm(fieldId) {
                    // Not used anymore — rebuildCanvas handles re-showing fields
                },

                _relocateAssignedFieldsForTab(tabKey) {
                    this.$nextTick(() => {
                        const container = document.getElementById('custom-tab-fields-' + tabKey);
                        if (!container) return;
                        
                        // Get fields assigned to this tab
                        const assignedFields = Object.entries(this.fieldAssignments)
                            .filter(([_, tk]) => tk === tabKey)
                            .map(([fid, _]) => fid);
                        
                        // Always clear container first to prevent duplication
                        container.innerHTML = '';
                        
                        if (assignedFields.length === 0) return;
                        
                        // Render assigned fields in the container
                        let html = '';
                        assignedFields.forEach(fid => {
                            const parts = fid.split('_');
                            const type = parts[0];
                            const rawId = parts.slice(1).join('_');
                            
                            // Try legacy builder: render the field using renderField
                            if (window.recordFormApp?.fieldsById?.[rawId]) {
                                const field = window.recordFormApp.fieldsById[rawId];
                                const layoutItem = window.recordFormApp.layout?.find(item => item.fieldId === rawId);
                                if (layoutItem) {
                                    const fieldHtml = window.recordFormApp.renderField(field, layoutItem.id);
                                    html += `<div class="mb-3 assigned-field-clone" data-source-field-id="${fid}">${fieldHtml}</div>`;
                                    return;
                                }
                            }
                            
                            // Try EJS fields: find the wrapper in the form and clone it
                            const formField = document.querySelector(`#panels-main-zone .record-field-wrapper[data-field-id="${fid}"]`);
                            if (formField) {
                                const clone = formField.cloneNode(true);
                                clone.style.display = '';
                                clone.removeAttribute('x-show');
                                clone.classList.add('assigned-field-clone');
                                clone.dataset.sourceFieldId = fid;
                                container.appendChild(clone);
                            }
                        });
                        
                        // Set the HTML for legacy builder fields
                        if (html) {
                            container.insertAdjacentHTML('beforeend', html);
                            // Re-init Alpine for dynamic elements (like tag pickers)
                            container.querySelectorAll('[x-data]').forEach(el => {
                                if (!el._x_dataStack) {
                                    Alpine.initTree(el);
                                }
                            });
                        }
                    });
                },

                // ═══ Per-Tab Layout ═══
                getTabLayout(tabKey) {
                    return this.tabLayouts[tabKey] || 'stacked';
                },

                setTabLayout(tabKey, layout) {
                    this.tabLayouts[tabKey] = layout;
                    this._savePrefs();
                },

                async _savePrefs() {
                    const relationPrefs = this.allTabs
                        .filter(t => !t.isCustom)
                        .map(t => ({ key: t.key, visible: t.visible !== false }));
                    const customPrefs = this.allTabs
                        .filter(t => t.isCustom)
                        .map(t => ({
                            key: t.key,
                            label: t.label,
                            icon: t.icon,
                            color: t.color || '#4361ee',
                            visible: t.visible !== false,
                            content: this.customTabContents[t.key] || ''
                        }));
                    const tabOrder = this.allTabs.map(t => t.key);
                    try {
                        await fetch(`/account/${accountNumber}/api/account/view-preferences`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                viewId,
                                preferences: {
                                    relationTabs: relationPrefs,
                                    customTabs: customPrefs,
                                    tabOrder,
                                    fieldAssignments: this.fieldAssignments,
                                    tabLayouts: this.tabLayouts,
                                    customTabLayouts: this.customTabLayouts
                                }
                            })
                        });
                    } catch (e) {
                        console.error('Error saving relation tabs prefs:', e);
                    }
                },

                // ═══════════════════ LAYOUT BUILDER METHODS ═══════════════════

                _ensureTabLayout(tabKey) {
                    if (!this.customTabLayouts[tabKey]) {
                        this.customTabLayouts[tabKey] = { rows: [], blocks: {} };
                    }
                    const layout = this.customTabLayouts[tabKey];
                    if (layout.rows) {
                        layout.rows.forEach(row => {
                            if (row.columns) {
                                row.columns.forEach(col => {
                                    if (!col.blockIds) {
                                        col.blockIds = col.blockId ? [col.blockId] : [];
                                        delete col.blockId;
                                    }
                                });
                            }
                        });
                    }
                    return layout;
                },

                _genId(prefix) {
                    return prefix + '_' + Date.now().toString(36) + Math.random().toString(36).substr(2, 5);
                },

                getTabRows(tabKey) {
                    const layout = this.customTabLayouts[tabKey];
                    return layout ? layout.rows : [];
                },

                getTabBlock(tabKey, blockId) {
                    const layout = this.customTabLayouts[tabKey];
                    return layout && layout.blocks ? layout.blocks[blockId] : null;
                },

                ctAddRow(tabKey) {
                    const layout = this._ensureTabLayout(tabKey);
                    const colId = this._genId('col');
                    layout.rows.push({
                        id: this._genId('row'),
                        columns: [{ id: colId, width: 12, blockIds: [] }]
                    });
                    this.ctSaveLayout(tabKey);
                },

                ctDeleteRow(tabKey, rowId) {
                    const layout = this._ensureTabLayout(tabKey);
                    const rowIdx = layout.rows.findIndex(r => r.id === rowId);
                    if (rowIdx === -1) return;
                    // Clean up blocks in this row
                    const row = layout.rows[rowIdx];
                    row.columns.forEach(col => {
                        (col.blockIds || []).forEach(bid => {
                            if (layout.blocks[bid]) delete layout.blocks[bid];
                        });
                    });
                    layout.rows.splice(rowIdx, 1);
                    this.ctSaveLayout(tabKey);
                },

                ctMoveRow(tabKey, rowId, direction) {
                    const layout = this._ensureTabLayout(tabKey);
                    const idx = layout.rows.findIndex(r => r.id === rowId);
                    const newIdx = idx + direction;
                    if (newIdx < 0 || newIdx >= layout.rows.length) return;
                    const [moved] = layout.rows.splice(idx, 1);
                    layout.rows.splice(newIdx, 0, moved);
                    this.ctSaveLayout(tabKey);
                },

                // ═══ SortableJS Drag & Drop ═══
                ctInitSortables() {
                    this.ctDestroySortables();
                    const tabKey = this.activeTab;
                    if (!tabKey) return;
                    const self = this;

                    // 1. Row Sortable — reorder entire rows
                    this.$nextTick(() => {
                        const rowsContainer = document.getElementById('ct-rows-' + tabKey);
                        if (!rowsContainer) return;

                        self._ctSortables['rows'] = Sortable.create(rowsContainer, {
                            animation: 180,
                            ghostClass: 'ct-sortable-ghost',
                            chosenClass: 'ct-sortable-chosen',
                            dragClass: 'ct-sortable-drag',
                            handle: '.ct-row-drag-handle',
                            draggable: '.ct-row-item',
                            swapThreshold: 0.65,
                            onEnd(evt) {
                                const rowId = evt.item.dataset.rowId;
                                if (!rowId || evt.oldIndex === evt.newIndex) return;
                                const layout = self._ensureTabLayout(tabKey);
                                const fromIdx = layout.rows.findIndex(r => r.id === rowId);
                                if (fromIdx === -1) return;
                                // Revert DOM — Alpine manages DOM via x-for
                                const items = Array.from(rowsContainer.querySelectorAll(':scope > .ct-row-item'));
                                const ref = items[evt.oldIndex] || null;
                                if (ref) rowsContainer.insertBefore(evt.item, ref);
                                else rowsContainer.appendChild(evt.item);
                                // Splice data
                                const [moved] = layout.rows.splice(fromIdx, 1);
                                layout.rows.splice(evt.newIndex, 0, moved);
                                self.ctSaveLayout(tabKey);
                            }
                        });

                        // 2. Widget Sortable — drag widgets between columns (cross-row)
                        const colEls = rowsContainer.querySelectorAll('.ct-col-sortable');
                        colEls.forEach(colEl => {
                            const colId = colEl.dataset.colId;
                            const rowId = colEl.dataset.rowId;
                            if (!colId) return;

                            self._ctSortables['col_' + colId] = Sortable.create(colEl, {
                                group: { name: 'ct-widgets', pull: true, put: true },
                                animation: 150,
                                ghostClass: 'ct-widget-ghost',
                                draggable: '.ct-widget-item',
                                swapThreshold: 0.65,
                                onEnd(evt) {
                                    const blockId = evt.item.dataset.blockId;
                                    const fromRowId = evt.from.dataset.rowId;
                                    const fromColId = evt.from.dataset.colId;
                                    const toRowId = evt.to.dataset.rowId;
                                    const toColId = evt.to.dataset.colId;
                                    if (!blockId || !fromColId || !toColId) return;
                                    if (fromColId === toColId) return; // same column, no move needed

                                    const layout = self._ensureTabLayout(tabKey);
                                    // Find source column
                                    let srcCol = null;
                                    layout.rows.forEach(r => r.columns.forEach(c => {
                                        if (c.id === fromColId) srcCol = c;
                                    }));
                                    // Find target column
                                    let tgtCol = null;
                                    layout.rows.forEach(r => r.columns.forEach(c => {
                                        if (c.id === toColId) tgtCol = c;
                                    }));
                                    if (!srcCol || !tgtCol) return;

                                    // Revert DOM — Alpine manages it
                                    evt.item.remove();
                                    evt.from.appendChild(evt.item);

                                    // Move block from source to target array
                                    if (!srcCol.blockIds) srcCol.blockIds = [];
                                    if (!tgtCol.blockIds) tgtCol.blockIds = [];
                                    const bidIdx = srcCol.blockIds.indexOf(blockId);
                                    if (bidIdx > -1) srcCol.blockIds.splice(bidIdx, 1);
                                    tgtCol.blockIds.splice(evt.newIndex, 0, blockId);
                                    self.ctSaveLayout(tabKey);
                                }
                            });
                        });
                    });
                },

                ctDestroySortables() {
                    Object.keys(this._ctSortables).forEach(key => {
                        if (this._ctSortables[key] && typeof this._ctSortables[key].destroy === 'function') {
                            this._ctSortables[key].destroy();
                        }
                    });
                    this._ctSortables = {};
                },

                ctSetRowLayout(tabKey, rowId, colCount) {
                    const layout = this._ensureTabLayout(tabKey);
                    const row = layout.rows.find(r => r.id === rowId);
                    if (!row) return;
                    
                    // Preserve existing blocks from all columns
                    const existingBlocks = [];
                    row.columns.forEach(c => {
                        (c.blockIds || []).forEach(bid => existingBlocks.push(bid));
                    });
                    
                    // Calculate widths (12-unit grid)
                    const colWidth = Math.floor(12 / colCount);
                    const remainder = 12 % colCount;
                    
                    // Build new columns with widths
                    const newCols = [];
                    for (let i = 0; i < colCount; i++) {
                        newCols.push({
                            id: this._genId('col'),
                            width: colWidth + (i < remainder ? 1 : 0),
                            blockIds: existingBlocks[i] ? [existingBlocks[i]] : []
                        });
                    }
                    
                    // Clean up orphaned blocks (blocks that were in columns beyond colCount)
                    existingBlocks.slice(colCount).forEach(bId => {
                        if (layout.blocks[bId]) delete layout.blocks[bId];
                    });
                    
                    row.columns = newCols;
                    this.ctSaveLayout(tabKey);
                },

                ctDeleteColumn(tabKey, rowId, colId) {
                    const layout = this._ensureTabLayout(tabKey);
                    const row = layout.rows.find(r => r.id === rowId);
                    if (!row) return;
                    
                    if (row.columns.length <= 1) {
                        this.ctDeleteRow(tabKey, rowId);
                        return;
                    }
                    
                    const colIdx = row.columns.findIndex(c => c.id === colId);
                    if (colIdx === -1) return;
                    const col = row.columns[colIdx];
                    const freedWidth = col.width || Math.floor(12 / row.columns.length);
                    
                    if (col.blockIds && col.blockIds.length) {
                        col.blockIds.forEach(bid => {
                            if (layout.blocks[bid]) delete layout.blocks[bid];
                        });
                    }
                    row.columns.splice(colIdx, 1);
                    
                    // Redistribute freed width
                    const extraPerCol = Math.floor(freedWidth / row.columns.length);
                    let rem = freedWidth % row.columns.length;
                    row.columns.forEach((c, i) => {
                        c.width = (c.width || 1) + extraPerCol + (i < rem ? 1 : 0);
                    });
                    
                    this.ctSaveLayout(tabKey);
                },

                ctRemoveBlock(tabKey, rowId, colId, blockId) {
                    const layout = this._ensureTabLayout(tabKey);
                    const row = layout.rows.find(r => r.id === rowId);
                    if (!row) return;
                    const col = row.columns.find(c => c.id === colId);
                    if (!col || !col.blockIds) return;
                    const bidIdx = col.blockIds.indexOf(blockId);
                    if (bidIdx === -1) return;
                    if (layout.blocks[blockId]) {
                        delete layout.blocks[blockId];
                    }
                    col.blockIds.splice(bidIdx, 1);
                    this.ctSaveLayout(tabKey);
                },

                ctInsertWidget(widgetType) {
                    const target = this.ctWidgetPickerTarget;
                    if (!target) return;
                    
                    const layout = this._ensureTabLayout(target.tabKey);
                    const row = layout.rows.find(r => r.id === target.rowId);
                    if (!row) return;
                    const col = row.columns.find(c => c.id === target.colId);
                    if (!col) return;
                    
                    const blockId = this._genId('block');
                    const defaultTitles = {
                        notes: 'Notes', tasks: 'Tâches', timeline: 'Timeline',
                        kpi: 'KPI', chart: 'Graphique', fields: 'Champs',
                        cards: 'Cartes', iframe: 'Embed'
                    };
                    
                    const block = {
                        type: widgetType,
                        title: defaultTitles[widgetType] || widgetType,
                    };
                    
                    if (widgetType === 'notes') block.content = '';
                    if (widgetType === 'tasks') block.tasks = [];
                    if (widgetType === 'fields') block.fields = [];
                    
                    layout.blocks[blockId] = block;
                    if (!col.blockIds) col.blockIds = [];
                    col.blockIds.push(blockId);
                    
                    this.ctWidgetPickerOpen = false;
                    this.ctWidgetPickerTarget = null;
                    this.ctSaveLayout(target.tabKey);
                },

                ctAddTask(tabKey, blockId, text) {
                    if (!text || !text.trim()) return;
                    const layout = this._ensureTabLayout(tabKey);
                    const block = layout.blocks[blockId];
                    if (!block || block.type !== 'tasks') return;
                    if (!block.tasks) block.tasks = [];
                    block.tasks.push({ text: text.trim(), done: false });
                    this.ctSaveLayout(tabKey);
                },

                ctOnBlockInput(tabKey, blockId) {
                    const layout = this._ensureTabLayout(tabKey);
                    const block = layout.blocks[blockId];
                    if (!block || block.type !== 'notes') return;
                    
                    const editor = document.getElementById('ct-editor-' + blockId);
                    if (!editor) return;
                    block.content = editor.innerHTML;
                    
                    // Debounced save
                    if (this._contentSaveTimer) clearTimeout(this._contentSaveTimer);
                    this._contentSaveTimer = setTimeout(() => {
                        this.ctSaveLayout(tabKey);
                    }, 1000);
                },

                ctLoadBlockContent(tabKey, blockId) {
                    if (!tabKey || !blockId) return;
                    this.$nextTick(() => {
                        const layout = this.customTabLayouts[tabKey];
                        if (!layout || !layout.blocks[blockId]) return;
                        const block = layout.blocks[blockId];
                        if (block.type !== 'notes') return;
                        
                        const editor = document.getElementById('ct-editor-' + blockId);
                        if (!editor) return;
                        const saved = block.content || '';
                        if (editor.innerHTML !== saved) {
                            editor.innerHTML = saved;
                        }
                    });
                },

                // ═══ Column Resize (cockpit builder pattern) ═══

                ctStartResize(tabKey, rowId, colIndex, event) {
                    event.preventDefault();
                    const layout = this.customTabLayouts[tabKey];
                    if (!layout) return;
                    const row = layout.rows.find(r => r.id === rowId);
                    if (!row) return;

                    this.ctResizeState = {
                        active: true,
                        tabKey: tabKey,
                        rowId: rowId,
                        colIndex: colIndex,
                        startX: event.clientX,
                        startWidths: row.columns.map(c => c.width)
                    };

                    // Add document-level listeners
                    document.addEventListener('mousemove', this._ctDoResize = (e) => this.ctDoResize(e));
                    document.addEventListener('mouseup', this._ctEndResize = () => this.ctEndResize());
                    document.body.style.cursor = 'col-resize';
                    document.body.style.userSelect = 'none';
                },

                ctDoResize(event) {
                    if (!this.ctResizeState.active) return;

                    const { tabKey, rowId, colIndex, startX, startWidths } = this.ctResizeState;
                    const layout = this.customTabLayouts[tabKey];
                    if (!layout) return;
                    const row = layout.rows.find(r => r.id === rowId);
                    if (!row) return;

                    // Get the grid container width
                    const gridContainer = document.querySelector('[style*="grid-template-columns: repeat(12"]');
                    if (!gridContainer) return;

                    const gridWidth = gridContainer.offsetWidth;
                    const colUnitWidth = gridWidth / 12; // Width of one grid unit

                    // Calculate delta in grid units
                    const deltaX = event.clientX - startX;
                    const deltaUnits = Math.round(deltaX / colUnitWidth);

                    if (deltaUnits === 0) return;

                    const leftWidth = startWidths[colIndex];
                    const isLastColumn = colIndex === row.columns.length - 1;

                    if (isLastColumn) {
                        // Last column: shrinking creates a new empty column
                        let newLeftWidth = leftWidth + deltaUnits;

                        // Enforce min width of 1
                        if (newLeftWidth < 1) newLeftWidth = 1;

                        // Calculate remaining space
                        const totalUsed = row.columns.reduce((sum, col, idx) =>
                            sum + (idx === colIndex ? newLeftWidth : col.width), 0);
                        const remaining = 12 - totalUsed;

                        if (remaining > 0) {
                            // Create or update the new column
                            if (row.columns.length === startWidths.length) {
                                // Add new empty column
                                row.columns.push({ id: this._genId('col'), width: remaining, blockIds: [] });
                                startWidths.push(0); // Track the new column
                            } else {
                                // Update existing new column width
                                row.columns[colIndex + 1].width = remaining;
                            }
                            row.columns[colIndex].width = newLeftWidth;
                        } else if (remaining <= 0) {
                            // Remove the new column if no space
                            if (row.columns.length > startWidths.length) {
                                row.columns.pop();
                            }
                            row.columns[colIndex].width = leftWidth; // Reset to original
                        }
                    } else {
                        // Normal resize between two columns
                        const rightWidth = startWidths[colIndex + 1];

                        let newLeftWidth = leftWidth + deltaUnits;
                        let newRightWidth = rightWidth - deltaUnits;

                        // Enforce min width of 1 for each column
                        if (newLeftWidth < 1) {
                            newLeftWidth = 1;
                            newRightWidth = leftWidth + rightWidth - 1;
                        }
                        if (newRightWidth < 1) {
                            newRightWidth = 1;
                            newLeftWidth = leftWidth + rightWidth - 1;
                        }

                        // Apply new widths
                        row.columns[colIndex].width = newLeftWidth;
                        row.columns[colIndex + 1].width = newRightWidth;
                    }
                },

                ctEndResize() {
                    if (this.ctResizeState.active) {
                        this.ctSaveLayout(this.ctResizeState.tabKey);
                    }
                    this.ctResizeState.active = false;
                    document.removeEventListener('mousemove', this._ctDoResize);
                    document.removeEventListener('mouseup', this._ctEndResize);
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                },

                ctSaveLayout(tabKey) {
                    // Debounced save via _savePrefs
                    this._savePrefs();
                }
            };
        }
        </script>
        <style>
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        /* Custom tab editor placeholder */
        .custom-tab-editor-area:empty::before {
            content: attr(data-placeholder);
            color: #9ca3af;
            pointer-events: none;
            font-style: italic;
        }
        .dark .custom-tab-editor-area:empty::before {
            color: #6b7280;
        }
        .custom-tab-content {
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            overflow: hidden;
            background: white;
        }
        .dark .custom-tab-content {
            border-color: #374151;
            background: #111827;
        }
        /* SortableJS — Row drag states */
        .ct-sortable-ghost {
            opacity: 0.15;
            border: 2px dashed #4361ee !important;
            border-radius: 12px;
            background: rgba(67, 97, 238, 0.04) !important;
        }
        .ct-sortable-chosen {
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.15);
            border-radius: 12px;
        }
        .ct-sortable-drag {
            opacity: 0.9;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
            border-radius: 12px;
        }
        /* SortableJS — Widget drag states */
        .ct-widget-ghost {
            opacity: 0.2;
            border: 2px dashed #805dca !important;
            border-radius: 12px;
        }
        .ct-row-drag-handle:active { cursor: grabbing; }
        @keyframes spin { to { transform: rotate(360deg); } }
        </style>


        <div class="record-layout-container" x-data="panelLayout()" id="panels-container"
            x-show="$store.recordTabs.activeTab === '__self__'"
            :style="'grid-template-columns: repeat(12, 1fr)'">
            
            <!-- â•â•â• Main Form Content (Column 0) â•â•â• -->
            <div class="record-layout-col relative" 
                :style="'grid-column: span ' + columns[0].width"
                id="panels-main-zone">

                <!-- Resize Handle on right edge -->
                <div class="record-layout-resize-handle"
                    @mousedown.prevent="startResize(0, $event)">
                    <iconify-icon icon="solar:alt-arrow-left-bold" width="10"></iconify-icon>
                    <iconify-icon icon="solar:alt-arrow-right-bold" width="10" style="margin-left: -3px;"></iconify-icon>
                </div>

                <div class="space-y-4" :style="designMode ? 'min-height: 80px' : ''">
                <!-- Empty state for main column (shown in design mode when all panels dragged out) -->
                <template x-if="designMode">
                    <div class="record-layout-empty-zone" id="main-empty-indicator"
                        style="display: none; min-height: 80px; border: 2px dashed #e2e8f0; border-radius: 8px; padding: 24px 12px; text-align: center; color: #94a3b8; font-size: 12px;">
                        <iconify-icon icon="solar:widget-add-bold-duotone" width="24" style="opacity: 0.5;"></iconify-icon>
                        <div style="margin-top: 4px;">Glissez un panel ici</div>
                    </div>
                </template>
                <div class="panel-sortable-item" data-panel-id="attributs">
                    <template x-if="designMode">
                        <div class="panel-drag-handle">
                            <iconify-icon icon="tabler:grip-horizontal" width="16"></iconify-icon>
                            <span><%= entity.nameSingular || entity.name %></span>
                        </div>
                    </template>
                <div class="panel">
                    <div class="space-y-8">

                    <% if (locals.entityFormLayout && locals.entityFormLayout.rows) { %>
                        <!-- ========== ENTITY FORM LAYOUT (Row/Column Grid) ========== -->
                        <div>
                            <div class="space-y-4">
                                <% entityFormLayout.rows.forEach(function(row, rowIndex) { %>
                                    <div class="flex flex-wrap -mx-2">
                                        <% row.columns.forEach(function(col, colIndex) { %>
                                            <div class="px-2 mb-3" style="width: <%= (col.width / 12 * 100).toFixed(4) %>%">
                                                <% (col.fields || []).forEach(function(field) { %>
                                                <% var _fid = field.type + '_' + field.fieldId; %>
                                                <% var _flabel = ''; if (field.type === 'standard' && locals.entityFormFieldDefs && locals.entityFormFieldDefs.standard[field.fieldId]) { _flabel = locals.entityFormFieldDefs.standard[field.fieldId].label || field.fieldId; } else if (field.type === 'custom' && locals.entityFormFieldDefs && locals.entityFormFieldDefs.custom[field.fieldId]) { _flabel = locals.entityFormFieldDefs.custom[field.fieldId].label || locals.entityFormFieldDefs.custom[field.fieldId].name || field.fieldId; } else if (field.type === 'relation' && locals.entityFormFieldDefs && locals.entityFormFieldDefs.relation[field.fieldId]) { _flabel = locals.entityFormFieldDefs.relation[field.fieldId].label || field.fieldId; } else if (field.type === 'classification' && locals.entityFormFieldDefs && locals.entityFormFieldDefs.classification[field.fieldId]) { _flabel = locals.entityFormFieldDefs.classification[field.fieldId].label || field.fieldId; } else { _flabel = field.label || field.fieldId; } %>
                                                <div class="record-field-wrapper" data-field-id="<%= _fid %>" data-field-label="<%= _flabel %>" data-field-type="<%= field.type %>" x-show="!($store.recordTabs.fieldAssignments && $store.recordTabs.fieldAssignments['<%= _fid %>'])">
                                                    <% if (field.type === 'standard') { %>
                                                        <% var def = locals.entityFormFieldDefs && locals.entityFormFieldDefs.standard[field.fieldId]; %>
                                                        <% if (def) { %>
                                                            <% if (field.fieldId === 'title') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300" style="display:flex;align-items:center;gap:4px">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <input name="<%= def.inputName %>" type="text" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= record.title || '' %>"
                                                                        placeholder="<%= field.placeholder || def.label %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                </div>
                                                            <% } else if (def.inputType === 'textarea') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300" style="display:flex;align-items:center;gap:4px">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <textarea name="<%= def.inputName %>" class="form-textarea dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" rows="4"
                                                                        placeholder="<%= field.placeholder || def.label %>"
                                                                        <%= field.required ? 'required' : '' %>><%= record[field.fieldId] || '' %></textarea>
                                                                </div>
                                                            <% } else if (def.inputType === 'file') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300" style="display:flex;align-items:center;gap:4px">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                    </label>
                                                                    <% if (record[field.fieldId]) { %>
                                                                        <div class="text-xs text-gray-500 mb-1">Fichier actuel : <span class="text-primary"><%= record[field.fieldId] %></span></div>
                                                                    <% } %>
                                                                    <input name="<%= def.inputName %>" type="file" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" />
                                                                </div>
                                                            <% } else if (def.inputType === 'date') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300" style="display:flex;align-items:center;gap:4px">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <input name="<%= def.inputName %>" type="date" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= record[field.fieldId] ? new Date(record[field.fieldId]).toISOString().split('T')[0] : '' %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                </div>
                                                            <% } else { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300" style="display:flex;align-items:center;gap:4px">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <input name="<%= def.inputName %>" type="<%= def.inputType || 'text' %>" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= record[field.fieldId] || '' %>"
                                                                        placeholder="<%= field.placeholder || def.label %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                </div>
                                                            <% } %>
                                                        <% } %>

                                                    <% } else if (field.type === 'custom') { %>
                                                        <% var cf = locals.entityFormFieldDefs && locals.entityFormFieldDefs.custom[field.fieldId]; %>
                                                        <% var cfVal = locals.recordValues && locals.recordValues[field.fieldId]; %>
                                                        <% if (cf && cf.htmlTemplate) { %>
                                                            <div class="mb-3">
                                                                <%- cf.htmlTemplate
                                                                    .replace(/\{\{\s*label\s*\}\}/g, field.label || cf.label || cf.name)
                                                                    .replace(/\{\{\s*name\s*\}\}/g, cf.name || '')
                                                                    .replace(/\{\{\s*placeholder\s*\}\}/g, field.placeholder || cf.label || cf.name)
                                                                    .replace(/\{\{\s*required\s*\}\}/g, field.required ? 'required' : '') %>
                                                            </div>
                                                        <% } else if (cf && cf.category === 'computed') { %>
                                                            <%
                                                              var cvKey = cf._id || field.fieldId;
                                                              var cvData = (typeof computedFieldValues !== 'undefined' && computedFieldValues) ? computedFieldValues[cvKey] : null;
                                                              var cvDisplay = (cf.render && cf.render.display && cf.render.display.table) || (cf.formula && cf.formula.fromFunction === 'rating' ? 'stars' : cf.formula && cf.formula.fromFunction === 'age' ? 'badge' : cf.formula && (cf.formula.fromFunction === 'tva' || cf.formula.fromFunction === 'total_ttc') ? 'currency' : cf.formula && cf.formula.fromFunction === 'duration' ? 'duration' : 'text');
                                                            %>
                                                            <div class="mb-3">
                                                                <label class="flex items-center mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300" style="display:flex;align-items:center;gap:4px">
                                                                    <iconify-icon icon="<%= (cf.ui && cf.ui.icon) || 'solar:calculator-bold-duotone' %>" width="14" style="color: <%= cf.color || '#f59e0b' %>;"></iconify-icon>
                                                                    <%= field.label || cf.label || cf.name %>
                                                                    <span class="text-[9px] font-medium text-gray-400 bg-gray-100 dark:bg-gray-700 dark:text-gray-500 px-1.5 py-0.5 rounded-full ml-1">calculé</span>
                                                                </label>
                                                                <div class="mt-1 px-3 py-2 bg-gray-50 dark:bg-[#121e32] rounded-lg border border-gray-100 dark:border-gray-800">
                                                                    <%- include('../components/computed-field-renderer', { computedValue: cvData, displayType: cvDisplay, field: cf }) %>
                                                                </div>
                                                            </div>
                                                        <% } else if (cf) { %>
                                                            <div class="mb-3">
                                                                <label class="flex items-center mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300" style="display:flex;align-items:center;gap:4px">
                                                                    <iconify-icon icon="<%= (cf.ui && cf.ui.icon) || 'solar:widget-bold-duotone' %>" width="14" class="text-info"></iconify-icon>
                                                                    <%= field.label || cf.label || cf.name %>
                                                                    <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                </label>
                                                                <% if (cf.inputType === 'textarea' || cf.inputType === 'richtext') { %>
                                                                    <% var cfRows = (cf.ui && cf.ui.rows) ? parseInt(cf.ui.rows) : 3; %>
                                                                    <% if (cfRows <= 1) { %>
                                                                        <input type="text" name="custom[<%= cf._id %>]" class="form-input"
                                                                            placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                            value="<%= cfVal || '' %>"
                                                                            <%= field.required ? 'required' : '' %> />
                                                                    <% } else { %>
                                                                        <textarea name="custom[<%= cf._id %>]" class="form-textarea" rows="<%= cfRows %>"
                                                                            placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                            <%= field.required ? 'required' : '' %>><%= cfVal || '' %></textarea>
                                                                    <% } %>
                                                                <% } else if (cf.inputType === 'select' && cf.options && cf.options.length) { %>
                                                                    <% if (cf.multiple) { %>
                                                                        <% var selectedArr = Array.isArray(cfVal) ? cfVal : (cfVal ? [cfVal] : []); %>
                                                                        <div class="flex flex-wrap gap-2" x-data='{
                                                                            selected: <%- JSON.stringify(selectedArr) %>,
                                                                            toggle(val) {
                                                                                const idx = this.selected.indexOf(val);
                                                                                if (idx === -1) this.selected.push(val);
                                                                                else this.selected.splice(idx, 1);
                                                                            },
                                                                            isSelected(val) { return this.selected.includes(val); }
                                                                        }'>
                                                                            <% cf.options.forEach(function(opt) { %>
                                                                                <label class="group inline-flex items-center gap-1.5 px-2 py-0 rounded text-xs font-medium cursor-pointer border transition-all duration-200 select-none"
                                                                                       :class="isSelected('<%= opt.value %>') ? 'bg-primary/10 border-primary text-primary' : 'bg-white dark:bg-[#1b2e4b] border-gray-200 dark:border-gray-800 text-gray-500 dark:text-gray-400 hover:border-primary/30 hover:bg-primary/5 hover:text-primary/70'">
                                                                                    <input type="checkbox" name="custom[<%= cf._id %>][]" value="<%= opt.value %>" class="hidden"
                                                                                           :checked="isSelected('<%= opt.value %>')"
                                                                                           @change="toggle('<%= opt.value %>')">
                                                                                    <svg x-show="isSelected('<%= opt.value %>')" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                                                                    <span><%= opt.label || opt.value %></span>
                                                                                </label>
                                                                            <% }); %>
                                                                        </div>
                                                                    <% } else { %>
                                                                        <select name="custom[<%= cf._id %>]" class="form-select" <%= field.required ? 'required' : '' %>>
                                                                            <option value="">-- Choisir --</option>
                                                                            <% cf.options.forEach(function(o) { %>
                                                                                <option value="<%= o.value || o %>" <%= (cfVal == (o.value || o)) ? 'selected' : '' %>><%= o.label || o %></option>
                                                                            <% }); %>
                                                                        </select>
                                                                    <% } %>
                                                                <% } else if (cf.inputType === 'checkbox') { %>
                                                                    <div class="flex items-center gap-2 py-2">
                                                                        <input name="custom[<%= cf._id %>]" type="checkbox" class="form-checkbox"
                                                                            <%= (cfVal === true || cfVal === 'on' || cfVal === 'true') ? 'checked' : '' %> />
                                                                    </div>
                                                                <% } else if (cf.type === 'recurrence') { %>
                                                                    <% var recVal = (cfVal && typeof cfVal === 'object') ? cfVal : {}; %>
                                                                    <script type="application/json" id="rec-config-<%= cf._id %>"><%- JSON.stringify({ options: cf.type_config.options || [], slots: cf.type_config.slots || {}, allowCustomText: cf.type_config.allowCustomText || false }) %></script>
                                                                    <div x-data="recurrenceField({
                                                                        fieldId: '<%= cf._id %>',
                                                                        configElementId: 'rec-config-<%= cf._id %>',
                                                                        initialValue: <%- JSON.stringify(recVal) %>
                                                                    })" class="space-y-3">
                                                                         <template x-for="slotName in slotNames" :key="slotName">
                                                                             <div>
                                                                                 <label class="block text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1.5" x-text="slotName"></label>
                                                                                 <template x-if="getSlotUI(slotName) === 'select'">
                                                                                     <select class="form-select text-sm" @change="setSlotValue(slotName, $event.target.value)">
                                                                                         <option value="">-- Choisir --</option>
                                                                                         <template x-for="opt in getSlotOptions(slotName)" :key="opt.value">
                                                                                             <option :value="opt.value" x-text="opt.label" :selected="currentValue[slotName] === opt.value"></option>
                                                                                         </template>
                                                                                     </select>
                                                                                 </template>
                                                                                 <template x-if="getSlotUI(slotName) === 'checkbox'">
                                                                                     <div class="flex flex-wrap gap-2">
                                                                                         <template x-for="opt in getSlotOptions(slotName)" :key="opt.value">
                                                                                             <label class="group inline-flex items-center gap-1.5 px-2 py-0 rounded text-xs font-medium cursor-pointer border transition-all duration-200 select-none"
                                                                                                    :class="isSlotSelected(slotName, opt.value) ? 'bg-primary/10 border-primary text-primary' : 'bg-white dark:bg-[#1b2e4b] border-gray-200 dark:border-gray-800 text-gray-500 dark:text-gray-400 hover:border-primary/30 hover:bg-primary/5 hover:text-primary/70'">
                                                                                                 <input type="checkbox" class="hidden" :value="opt.value" :checked="isSlotSelected(slotName, opt.value)" @change="toggleSlotValue(slotName, opt.value)">
                                                                                                 <svg x-show="isSlotSelected(slotName, opt.value)" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                                                                                 <span x-text="opt.label"></span>
                                                                                             </label>
                                                                                         </template>
                                                                                     </div>
                                                                                 </template>
                                                                             </div>
                                                                         </template>
                                                                         <template x-if="allowCustomText">
                                                                             <div>
                                                                                 <label class="block text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1.5">Autre</label>
                                                                                 <input type="text" class="form-input text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" x-model="currentValue.customText" @input="serialize()" placeholder="Texte libre...">
                                                                            </div>
                                                                        </template>
                                                                        <input type="hidden" name="custom[<%= cf._id %>]" :value="serialized">
                                                                    </div>
                                                                <% } else if (cf.inputType === 'datetime-local' || (cf.type === 'date' && cf.type_config && cf.type_config.includeTime)) { %>
                                                                    <% var dtVal = ''; if (cfVal) { try { var _d = new Date(cfVal); if (!isNaN(_d)) dtVal = _d.getFullYear() + '-' + String(_d.getMonth()+1).padStart(2,'0') + '-' + String(_d.getDate()).padStart(2,'0') + 'T' + String(_d.getHours()).padStart(2,'0') + ':' + String(_d.getMinutes()).padStart(2,'0'); } catch(e){} } %>
                                                                    <input name="custom[<%= cf._id %>]" type="datetime-local" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= dtVal %>"
                                                                        placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                <% } else if (cf.inputType === 'date' || (cf.type === 'date' && !(cf.type_config && cf.type_config.includeTime))) { %>
                                                                    <% var dateVal = ''; if (cfVal) { try { var _d2 = new Date(cfVal); if (!isNaN(_d2)) dateVal = _d2.toISOString().split('T')[0]; } catch(e){} } %>
                                                                    <input name="custom[<%= cf._id %>]" type="date" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= dateVal %>"
                                                                        placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                <% } else { %>
                                                                    <input name="custom[<%= cf._id %>]" type="<%= cf.inputType || 'text' %>" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= cfVal || '' %>"
                                                                        placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                <% } %>
                                                            </div>
                                                        <% } %>

                                                    <% } else if (field.type === 'relation') { %>
                                                        <% var rel = locals.entityFormFieldDefs && locals.entityFormFieldDefs.relation[field.fieldId]; %>
                                                        <% var relVal = locals.recordValues && locals.recordValues[field.fieldId]; %>
                                                        <% if (rel) { %>
                                                            <% if (rel.inputMode === 'modal-picker') { %>
                                                            <!-- ========== MODAL PICKER MODE ========== -->
                                                            <div class="mb-3">
                                                                <% var mpIcon = (rel.targetEntity && rel.targetEntity.icon) || 'solar:link-round-bold-duotone'; %>
                                                                <% var mpColor = (rel.targetEntity && rel.targetEntity.color) || '#4361ee'; %>
                                                                <% var mpName = (rel.targetEntity && rel.targetEntity.name) || ''; %>
                                                                <% var mpEntityId = (rel.targetEntity && rel.targetEntity._id) || ''; %>
                                                                <div x-data="modalPickerField({
                                                                    fieldId: '<%= rel.key %>',
                                                                    refEntity: '<%= mpEntityId %>',
                                                                    refEntityName: '<%= mpName %>',
                                                                    refEntityIcon: '<%= mpIcon %>',
                                                                    refEntityColor: '<%= mpColor %>',
                                                                    multiple: <%= (rel.cardinality === 'one-to-many' || rel.cardinality === 'many-to-many') ? 'true' : 'false' %>,
                                                                    initialValue: <%- JSON.stringify(relVal || null).replace(/"/g, '&quot;') %>
                                                                })" data-display-fields='<%- JSON.stringify(rel.displayFields || []) %>' class="relative">
                                                                    <label class="flex items-center mb-1 dark:text-gray-300" style="display:flex;align-items:center;gap:4px">
                                                                        <iconify-icon icon="<%= mpIcon %>" width="14"
                                                                            style="color: <%= mpColor %>"></iconify-icon>
                                                                        <%= field.label || rel.label || 'Relation' %>
                                                                    </label>

                                                                    <!-- Trigger Button -->
                                                                    <button type="button" @click="openModal()"
                                                                        class="w-full flex items-center justify-between px-3 py-2 border border-gray-300 dark:border-gray-800 rounded-md hover:border-primary/50 transition-colors text-sm bg-white dark:bg-[#1b2e4b]">
                                                                        <span class="flex items-center gap-2 min-w-0" :class="!multiple && selectedItems.length > 0 ? 'text-gray-800 dark:text-gray-200' : 'text-gray-500 dark:text-gray-400'">
                                                                            <iconify-icon icon="solar:magnifer-bold-duotone" width="16" class="shrink-0" x-show="multiple || selectedItems.length === 0"></iconify-icon>
                                                                            <iconify-icon :icon="refEntityIcon" width="16" :style="'color:' + refEntityColor" class="shrink-0" x-show="!multiple && selectedItems.length > 0" x-cloak></iconify-icon>
                                                                            <span class="truncate" x-text="!multiple && selectedItems.length > 0 ? selectedItems[0].label : (multiple && selectedItems.length > 0 ? selectedItems.length + ' sélectionné(s)' : 'Rechercher <%= mpName %>...')"></span>
                                                                        </span>
                                                                        <span class="flex items-center gap-1 shrink-0">
                                                                            <span role="button" x-show="!multiple && selectedItems.length > 0" x-cloak @click.stop="removeItem(selectedItems[0]?.id)" class="w-5 h-5 rounded-full flex items-center justify-center text-gray-400 hover:text-danger hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors cursor-pointer">
                                                                                <iconify-icon icon="tabler:x" width="12"></iconify-icon>
                                                                            </span>
                                                                            <iconify-icon icon="tabler:external-link" width="14" class="text-gray-400"></iconify-icon>
                                                                        </span>
                                                                    </button>

                                                                    <!-- Selected Items Tags (multi only) -->
                                                                    <div class="flex flex-wrap gap-1 mt-2" x-show="multiple && selectedItems.length > 0">
                                                                        <template x-for="item in selectedItems" :key="item.id">
                                                                            <span class="inline-flex items-center gap-1 px-1.5 h-6 bg-primary/10 text-primary rounded text-xs border border-primary/20">
                                                                                <span x-text="item.label"></span>
                                                                                <button type="button" @click="removeItem(item.id)" class="hover:text-danger flex items-center transition-colors">
                                                                                    <iconify-icon icon="tabler:x" width="11"></iconify-icon>
                                                                                </button>
                                                                            </span>
                                                                        </template>
                                                                    </div>

                                                                    <!-- Hidden inputs -->
                                                                    <template x-if="multiple">
                                                                        <div>
                                                                            <template x-for="item in selectedItems" :key="item.id">
                                                                                <input type="hidden" :name="'custom[' + fieldId + '][]'" :value="item.id">
                                                                            </template>
                                                                        </div>
                                                                    </template>
                                                                    <template x-if="!multiple">
                                                                        <input type="hidden" :name="'custom[' + fieldId + ']'" :value="selectedItems[0]?.id || ''">
                                                                    </template>

                                                                    <!-- Modal Overlay -->
                                                                    <div x-ref="modalOverlay"
                                                                         style="display: none; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"
                                                                         class="fixed inset-0 z-[999] flex items-center justify-center bg-black/30"
                                                                         @click.self="closeModal()">
                                                                            <div class="bg-white dark:bg-[#0e1726] rounded-xl shadow-2xl w-full max-w-3xl mx-4 flex flex-col"
                                                                                 style="max-height: 80vh;" @click.stop>
                                                                                <div class="flex items-center justify-between px-5 py-3 border-b dark:border-gray-800">
                                                                                    <div class="flex items-center gap-2">
                                                                                        <iconify-icon :icon="refEntityIcon" width="18" :style="'color:' + refEntityColor"></iconify-icon>
                                                                                        <h3 class="font-semibold text-sm dark:text-gray-200" x-text="'Sélectionner ' + refEntityName"></h3>
                                                                                        <span class="text-xs text-gray-400 bg-gray-100 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 rounded-full" x-text="modalTotal + ' résultats'"></span>
                                                                                    </div>
                                                                                    <button type="button" @click="closeModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
                                                                                        <iconify-icon icon="tabler:x" width="20"></iconify-icon>
                                                                                    </button>
                                                                                </div>
                                                                                <div class="px-5 py-3 border-b dark:border-gray-800">
                                                                                    <div class="relative">
                                                                                        <iconify-icon icon="solar:magnifer-bold-duotone" width="16" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></iconify-icon>
                                                                                        <input type="text" class="form-input pl-9 text-sm dark:bg-[#1b2e4b] dark:border-gray-800 dark:text-gray-200 dark:placeholder-gray-500" placeholder="Rechercher..."
                                                                                               x-model="modalSearch" @input.debounce.300ms="fetchModalResults(true)" x-ref="modalSearchInput" />
                                                                                    </div>
                                                                                </div>
                                                                                <div class="flex-1 overflow-y-auto">
                                                                                    <template x-if="modalLoading && modalPage === 1">
                                                                                        <div class="flex items-center justify-center py-12">
                                                                                            <iconify-icon icon="svg-spinners:ring-resize" width="28" class="text-primary"></iconify-icon>
                                                                                        </div>
                                                                                    </template>
                                                                                    <template x-if="!(modalLoading && modalPage === 1)">
                                                                                        <div>
                                                                                            <template x-if="modalResults.length === 0 && !modalLoading">
                                                                                                <div class="flex flex-col items-center justify-center py-12 text-gray-400 dark:text-gray-500">
                                                                                                    <iconify-icon icon="solar:box-minimalistic-bold-duotone" width="40" class="mb-2"></iconify-icon>
                                                                                                    <span class="text-sm">Aucun résultat trouvé</span>
                                                                                                </div>
                                                                                            </template>
                                                                                            <div class="divide-y dark:divide-gray-800">
                                                                                                <template x-for="result in modalResults" :key="result.id">
                                                                                                    <div @click="toggleModalSelect(result)"
                                                                                                         class="flex items-center gap-3 px-5 py-2.5 cursor-pointer transition-colors"
                                                                                                         :class="isSelected(result.id) ? 'bg-primary/5' : 'hover:bg-gray-50 dark:hover:bg-white/5'">
                                                                                                        <div class="flex-shrink-0">
                                                                                                            <template x-if="multiple">
                                                                                                                <div class="w-4 h-4 rounded border-2 flex items-center justify-center transition-colors"
                                                                                                                     :class="isSelected(result.id) ? 'bg-primary border-primary' : 'border-gray-300 dark:border-gray-600'">
                                                                                                                    <iconify-icon x-show="isSelected(result.id)" icon="tabler:check" width="11" class="text-white"></iconify-icon>
                                                                                                                </div>
                                                                                                            </template>
                                                                                                            <template x-if="!multiple">
                                                                                                                <div class="w-4 h-4 rounded-full border-2 flex items-center justify-center transition-colors"
                                                                                                                     :class="isSelected(result.id) ? 'border-primary' : 'border-gray-300 dark:border-gray-600'">
                                                                                                                    <div x-show="isSelected(result.id)" class="w-2 h-2 rounded-full bg-primary"></div>
                                                                                                                </div>
