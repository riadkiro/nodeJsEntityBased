<!-- views/record/partials/view-table.ejs -->
<div class="flex flex-col h-[calc(100vh_-_120px)]">
    <ul class="mb-4 flex space-x-2 rtl:space-x-reverse flex-shrink-0">
        <li>
            <a href="/account/<%= account_number %>/dashboard" class="text-primary hover:underline">Dashboard</a>
        </li>
        <li class="before:content-['/'] ltr:before:mr-1 rtl:before:ml-1">
            <span><%= entity.name %></span>
        </li>
    </ul>
    <div x-data="chat" class="flex-1 min-h-0 overflow-hidden">
        <div class="relative flex h-full gap-5 overflow-hidden">
        <!-- Sidebar contacts -->
        <div class="panel z-10 hidden w-full max-w-xs flex-none space-y-4 overflow-hidden p-4 xl:block h-full"
            :class="isShowChatMenu && '!block absolute'">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="flex items-center text-center">
                        <div>
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                <path
                                    d="M20.3116 12.6473L20.8293 10.7154C21.4335 8.46034 21.7356 7.3328 21.5081 6.35703C21.3285 5.58657 20.9244 4.88668 20.347 4.34587C19.6157 3.66095 18.4881 3.35883 16.2331 2.75458C13.978 2.15033 12.8504 1.84821 11.8747 2.07573C11.1042 2.25537 10.4043 2.65945 9.86351 3.23687C9.27709 3.86298 8.97128 4.77957 8.51621 6.44561C8.43979 6.7254 8.35915 7.02633 8.27227 7.35057L8.27222 7.35077L7.75458 9.28263C7.15033 11.5377 6.84821 12.6652 7.07573 13.641C7.25537 14.4115 7.65945 15.1114 8.23687 15.6522C8.96815 16.3371 10.0957 16.6392 12.3508 17.2435L12.3508 17.2435C14.3834 17.7881 15.4999 18.0873 16.415 17.9744C16.5152 17.9621 16.6129 17.9448 16.7092 17.9223C17.4796 17.7427 18.1795 17.3386 18.7203 16.7612C19.4052 16.0299 19.7074 14.9024 20.3116 12.6473Z"
                                    stroke="currentColor" stroke-width="1.5"></path>
                                <path opacity="0.5"
                                    d="M16.415 17.9741C16.2065 18.6126 15.8399 19.1902 15.347 19.6519C14.6157 20.3368 13.4881 20.6389 11.2331 21.2432C8.97798 21.8474 7.85044 22.1495 6.87466 21.922C6.10421 21.7424 5.40432 21.3383 4.86351 20.7609C4.17859 20.0296 3.87647 18.9021 3.27222 16.647L2.75458 14.7151C2.15033 12.46 1.84821 11.3325 2.07573 10.3567C2.25537 9.58627 2.65945 8.88638 3.23687 8.34557C3.96815 7.66065 5.09569 7.35853 7.35077 6.75428C7.77741 6.63996 8.16368 6.53646 8.51621 6.44531"
                                    stroke="currentColor" stroke-width="1.5"></path>
                                <path d="M11.7769 10L16.6065 11.2941" stroke="currentColor" stroke-width="1.5"
                                    stroke-linecap="round"></path>
                                <path opacity="0.5" d="M11 12.8975L13.8978 13.6739" stroke="currentColor"
                                    stroke-width="1.5" stroke-linecap="round"></path>
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold ltr:ml-3 rtl:mr-3"><%= entity.name %></h3>
                    </div>
                </div>
                <div x-data="dropdown" @click.outside="open = false" class="dropdown">
                    <button type="button"
                        class="flex h-8 w-8 items-center justify-center rounded-full bg-[#f4f4f4] hover:bg-primary-light dark:bg-[#1b2e4b]"
                        @click="toggle">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                            xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70">
                            <circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                            <circle opacity="0.5" cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5">
                            </circle>
                            <circle cx="19" cy="12" r="2" stroke="currentColor" stroke-width="1.5"></circle>
                        </svg>
                    </button>
                    <ul x-show="open" x-transition x-transition.duration.300ms
                        class="whitespace-nowrap ltr:right-0 rtl:left-0">
                        <li>
                            <a href="javascript:;" @click="toggle">
                                <iconify-icon icon="solar:settings-bold-duotone"
                                    class="h-4.5 w-4.5 shrink-0 ltr:mr-1 rtl:ml-1"></iconify-icon>
                                Paramètres
                            </a>
                        </li>
                        <li>
                            <a href="javascript:;" @click="toggle">
                                <iconify-icon icon="solar:question-circle-bold-duotone"
                                    class="h-4.5 w-4.5 shrink-0 ltr:mr-1 rtl:ml-1"></iconify-icon>
                                Aide
                            </a>
                        </li>
                        <li>
                            <a href="javascript:;" @click="toggle">
                                <iconify-icon icon="solar:logout-2-bold-duotone"
                                    class="h-4.5 w-4.5 shrink-0 ltr:mr-1 rtl:ml-1"></iconify-icon>
                                Retour
                            </a>
                        </li>
                    </ul>
                </div>
            </div>


            <div class="h-px w-full border-b border-[#e0e6ed] dark:border-[#1b2e4b]"></div>
            <div class="!mt-0">
                <div class="flex h-full flex-col pb-16">


                    <div class="perfect-scrollbar relative -mr-3.5 h-full grow pr-3.5 ps">
                        <div class="space-y-1">
                            <button type="button"
                                class="flex h-10 w-full items-center justify-between rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]"
                                :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': selectedTab === 'all' }"
                                @click="tabChanged('all')">
                                <div class="flex items-center">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                        xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                        <path
                                            d="M18.18 8.03933L18.6435 7.57589C19.4113 6.80804 20.6563 6.80804 21.4241 7.57589C22.192 8.34374 22.192 9.58868 21.4241 10.3565L20.9607 10.82M18.18 8.03933C18.18 8.03933 18.238 9.02414 19.1069 9.89309C19.9759 10.762 20.9607 10.82 20.9607 10.82M18.18 8.03933L13.9194 12.2999C13.6308 12.5885 13.4865 12.7328 13.3624 12.8919C13.2161 13.0796 13.0906 13.2827 12.9882 13.4975C12.9014 13.6797 12.8368 13.8732 12.7078 14.2604L12.2946 15.5L12.1609 15.901M20.9607 10.82L16.7001 15.0806C16.4115 15.3692 16.2672 15.5135 16.1081 15.6376C15.9204 15.7839 15.7173 15.9094 15.5025 16.0118C15.3203 16.0986 15.1268 16.1632 14.7396 16.2922L13.5 16.7054L13.099 16.8391M13.099 16.8391L12.6979 16.9728C12.5074 17.0363 12.2973 16.9867 12.1553 16.8447C12.0133 16.7027 11.9637 16.4926 12.0272 16.3021L12.1609 15.901M13.099 16.8391L12.1609 15.901"
                                            stroke="currentColor" stroke-width="1.5"></path>
                                        <path d="M8 13H10.5" stroke="currentColor" stroke-width="1.5"
                                            stroke-linecap="round"></path>
                                        <path d="M8 9H14.5" stroke="currentColor" stroke-width="1.5"
                                            stroke-linecap="round"></path>
                                        <path d="M8 17H9.5" stroke="currentColor" stroke-width="1.5"
                                            stroke-linecap="round"></path>
                                        <path opacity="0.5"
                                            d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z"
                                            stroke="currentColor" stroke-width="1.5"></path>
                                    </svg>
                                    <div class="ltr:ml-3 rtl:mr-3">Toutes les <%= entity.namePlural || entity.name %></div>
                                </div>
                            </button>
                            <button type="button"
                                class="flex h-10 w-full items-center justify-between rounded-md p-2 font-medium hover:bg-white-dark/10 hover:text-primary dark:hover:bg-[#181F32] dark:hover:text-primary"
                                :class="{ 'bg-gray-100 dark:text-primary text-primary dark:bg-[#181F32]': selectedTab === 'fav' }"
                                @click="tabChanged('fav')">
                                <div class="flex items-center">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                        xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                        <path
                                            d="M9.15316 5.40838C10.4198 3.13613 11.0531 2 12 2C12.9469 2 13.5802 3.13612 14.8468 5.40837L15.1745 5.99623C15.5345 6.64193 15.7144 6.96479 15.9951 7.17781C16.2757 7.39083 16.6251 7.4699 17.3241 7.62805L17.9605 7.77203C20.4201 8.32856 21.65 8.60682 21.9426 9.54773C22.2352 10.4886 21.3968 11.4691 19.7199 13.4299L19.2861 13.9372C18.8096 14.4944 18.5713 14.773 18.4641 15.1177C18.357 15.4624 18.393 15.8341 18.465 16.5776L18.5306 17.2544C18.7841 19.8706 18.9109 21.1787 18.1449 21.7602C17.3788 22.3417 16.2273 21.8115 13.9243 20.7512L13.3285 20.4768C12.6741 20.1755 12.3469 20.0248 12 20.0248C11.6531 20.0248 11.3259 20.1755 10.6715 20.4768L10.0757 20.7512C7.77268 21.8115 6.62118 22.3417 5.85515 21.7602C5.08912 21.1787 5.21588 19.8706 5.4694 17.2544L5.53498 16.5776C5.60703 15.8341 5.64305 15.4624 5.53586 15.1177C5.42868 14.773 5.19043 14.4944 4.71392 13.9372L4.2801 13.4299C2.60325 11.4691 1.76482 10.4886 2.05742 9.54773C2.35002 8.60682 3.57986 8.32856 6.03954 7.77203L6.67589 7.62805C7.37485 7.4699 7.72433 7.39083 8.00494 7.17781C8.28555 6.96479 8.46553 6.64194 8.82547 5.99623L9.15316 5.40838Z"
                                            stroke="currentColor" stroke-width="1.5"></path>
                                    </svg>
                                    <div class="ltr:ml-3 rtl:mr-3">Favourites</div>
                                </div>
                            </button>
                            <div class="h-px w-full border-b border-[#e0e6ed] dark:border-[#1b2e4b]"></div>
                            <div class="px-1 py-3 text-white-dark">Tags</div>
                            <div class="flex flex-wrap gap-1">
                                <button type="button"
                                    class="badge badge-outline-primary mb-0 py-0 px-2 uppercase cursor-pointer transition-all"
                                    :class="selectedTab === 'personal' ? 'bg-primary/10' : 'hover:bg-primary/5'"
                                    @click="tabChanged('personal')">
                                    Personal
                                </button>

                                <button type="button"
                                    class="badge badge-outline-warning mb-0 py-0 px-2 uppercase cursor-pointer transition-all"
                                    :class="selectedTab === 'work' ? 'bg-warning/10' : 'hover:bg-warning/5'"
                                    @click="tabChanged('work')">
                                    Work
                                </button>

                                <button type="button"
                                    class="badge badge-outline-info mb-0 py-0 px-2 uppercase cursor-pointer transition-all"
                                    :class="selectedTab === 'social' ? 'bg-info/10' : 'hover:bg-info/5'"
                                    @click="tabChanged('social')">
                                    Social
                                </button>

                                <button type="button"
                                    class="badge badge-outline-danger mb-0 py-0 px-2 uppercase cursor-pointer transition-all"
                                    :class="selectedTab === 'important' ? 'bg-danger/10' : 'hover:bg-danger/5'"
                                    @click="tabChanged('important')">
                                    Important
                                </button>
                            </div>
                        </div>
                        <div class="ps__rail-x" style="left: 0px; bottom: 0px;">
                            <div class="ps__thumb-x" tabindex="0" style="left: 0px; width: 0px;"></div>
                        </div>
                        <div class="ps__rail-y" style="top: 0px; right: 0px;">
                            <div class="ps__thumb-y" tabindex="0" style="top: 0px; height: 0px;"></div>
                        </div>
                    </div>
                </div>
                <div class="absolute bottom-0 w-full p-4 ltr:left-0 rtl:right-0">
                    <a href="/account/<%= account_number %>/record/<%= entity.slug %>/create" class="btn btn-primary w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                            stroke-linejoin="round" class="h-5 w-5 ltr:mr-2 rtl:ml-2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Ajouter
                    </a>
                </div>
            </div>
        </div>
        <div class="absolute z-[5] hidden h-full w-full rounded-md bg-black/60"
            :class="isShowChatMenu && '!block xl:!hidden'" @click="isShowChatMenu = !isShowChatMenu"></div>
        <!-- Main panel with datatable -->
        <div class="panel relative flex-1 p-4 flex flex-col overflow-hidden h-full" x-data="recordTable">
            <style>
                /* Force simple-datatables wrapper to match demo structure */
                #recordTableMain-wrapper.dataTable-wrapper {
                    flex: 1 !important;
                    display: flex !important;
                    flex-direction: column !important;
                    overflow: hidden !important;
                    height: 100% !important;
                }
                #recordTableMain-wrapper .dataTable-top {
                    flex-shrink: 0;
                    margin-bottom: 0.75rem;
                    display: flex;
                    justify-content: flex-start;
                }
                #recordTableMain-wrapper .dataTable-search {
                    max-width: 300px;
                }
                #recordTableMain-wrapper .dataTable-container {
                    flex: 1 !important;
                    overflow: auto !important;
                }
                #recordTableMain-wrapper .dataTable-bottom {
                    flex-shrink: 0;
                    margin-top: 0.75rem;
                    padding-top: 0.75rem;
                    border-top: 1px solid #e0e6ed;
                }
                .dark #recordTableMain-wrapper .dataTable-bottom {
                    border-top-color: #1b2e4b;
                }
                /* Reduce footer size */
                #recordTableMain-wrapper .dataTable-bottom .dataTable-info {
                    font-size: 0.75rem;
                }
                #recordTableMain-wrapper .dataTable-bottom .dataTable-pagination a {
                    height: 1.75rem;
                    width: 1.75rem;
                    font-size: 0.75rem;
                }
                #recordTableMain-wrapper .dataTable-bottom .dataTable-selector {
                    padding: 0.25rem 0.5rem;
                    font-size: 0.75rem;
                }
                
                /* First column (Titre) needs more space */
                #recordTableMain th:first-child,
                #recordTableMain td:first-child {
                    min-width: 220px;
                }

                
                /* Config dropdown styles */
                .table-config-dropdown {
                    position: absolute;
                    right: 0;
                    top: 100%;
                    margin-top: 0.5rem;
                    background: white;
                    border: 1px solid #e0e6ed;
                    border-radius: 0.5rem;
                    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
                    width: 280px;
                    max-height: 400px;
                    overflow-y: auto;
                    z-index: 50;
                    display: none;
                }
                .dark .table-config-dropdown {
                    background: #0e1726;
                    border-color: #1b2e4b;
                }
                .table-config-dropdown.show {
                    display: block;
                }
            </style>
            
            <table id="recordTableMain" class="whitespace-nowrap w-full"></table>
            
            <!-- Expandable Control Toolbar -->
            <div class="config-toolbar" style="position: absolute; top: 16px; right: 16px; z-index: 10;">
                <div class="flex flex-row-reverse items-center bg-white dark:bg-[#0e1726] rounded-md shadow-sm border border-gray-200 dark:border-gray-800">
                    
                    <!-- Main Settings Toggle Button (stays on right) -->
                    <button type="button" 
                            @click="showToolbar = !showToolbar; if(!showToolbar) activePanel = null"
                            :class="showToolbar ? 'text-primary' : 'text-gray-400 hover:text-primary'"
                            class="p-2 transition-colors flex items-center justify-center"
                            title="Paramètres d'affichage">
                        <iconify-icon icon="solar:settings-line-duotone" width="20"></iconify-icon>
                    </button>
                    
                    <!-- Tool buttons that appear to the left when open -->
                    <div class="toolbar-tools flex flex-row-reverse items-center overflow-hidden transition-all duration-300"
                         :style="showToolbar ? 'max-width: 150px; opacity: 1;' : 'max-width: 0; opacity: 0;'">
                        
                        <!-- Separator -->
                        <div class="w-px h-5 bg-gray-200 dark:bg-gray-700 mx-0.5"></div>
                        
                        <!-- Spacing Control with dropdown like reference -->
                        <div class="relative">
                            <button type="button" 
                                    @click="activePanel = activePanel === 'spacing' ? null : 'spacing'"
                                    :class="activePanel === 'spacing' ? 'text-primary' : 'text-gray-400 hover:text-primary'"
                                    class="p-2 transition-colors flex items-center justify-center"
                                    title="Espacement">
                                <iconify-icon icon="solar:sort-vertical-line-duotone" width="20"></iconify-icon>
                            </button>
                            <!-- Spacing Panel like reference image -->
                            <div x-show="activePanel === 'spacing'" 
                                 x-transition
                                 @click.outside="activePanel = null"
                                 class="absolute right-0 top-full mt-2 bg-white dark:bg-[#0e1726] border border-gray-200 dark:border-gray-800 rounded-lg shadow-lg p-4 w-56 z-50">
                                
                                <!-- Row Height -->
                                <div class="mb-4">
                                    <div class="flex justify-between items-center mb-2">
                                        <span class="text-sm text-gray-600 dark:text-gray-400">Hauteur des lignes</span>
                                        <span class="text-sm font-medium text-gray-800 dark:text-gray-200" x-text="rowSpacing"></span>
                                    </div>
                                    <input type="range" 
                                           min="0" max="16" step="2"
                                           x-model="rowSpacing"
                                           @input="applyRowSpacing()"
                                           class="w-full accent-primary">
                                </div>
                                
                                <!-- Cell Padding -->
                                <div>
                                    <div class="flex justify-between items-center mb-2">
                                        <span class="text-sm text-gray-600 dark:text-gray-400">Interligne</span>
                                        <span class="text-sm font-medium text-gray-800 dark:text-gray-200" x-text="cellPadding"></span>
                                    </div>
                                    <input type="range" 
                                           min="4" max="20" step="2"
                                           x-model="cellPadding"
                                           @input="applyCellPadding()"
                                           class="w-full accent-primary">
                                </div>
                            </div>
                        </div>
                        
                        <!-- Columns Control -->
                        <div class="relative">
                            <button type="button" 
                                    @click="activePanel = activePanel === 'columns' ? null : 'columns'"
                                    :class="activePanel === 'columns' ? 'text-primary' : 'text-gray-400 hover:text-primary'"
                                    class="p-2 transition-colors flex items-center justify-center"
                                    title="Colonnes">
                                <iconify-icon icon="solar:check-square-line-duotone" width="20"></iconify-icon>
                            </button>
                            <!-- Columns Panel -->
                            <div x-show="activePanel === 'columns'" 
                                 x-transition
                                 @click.outside="activePanel = null"
                                 class="absolute right-0 top-full mt-2 bg-white dark:bg-[#0e1726] border border-gray-200 dark:border-gray-800 rounded-lg shadow-lg p-3 w-56 z-50">
                                <div class="text-xs font-semibold mb-2 text-gray-600 dark:text-gray-400">Colonnes visibles</div>
                                <template x-for="(col, index) in columns" :key="index">
                                    <label class="flex items-center gap-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 px-2 py-1 rounded text-sm">
                                        <input type="checkbox" 
                                               :checked="!col.hidden"
                                               @change="toggleColumn(index)"
                                               class="form-checkbox text-primary w-4 h-4">
                                        <span class="text-sm dark:text-gray-300" x-text="col.name"></span>
                                    </label>
                                </template>
                                
                                <div class="border-t border-gray-200 dark:border-gray-800 my-3"></div>
                                
                                <div class="text-xs font-semibold mb-2 text-gray-600 dark:text-gray-400">Par page</div>
                                <div class="flex flex-wrap gap-1">
                                    <template x-for="option in [10, 20, 30, 50, 100]" :key="option">
                                        <button type="button"
                                                @click="perPageValue = option; updatePerPage()"
                                                :class="perPageValue === option ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300'"
                                                class="px-2 py-0 text-xs rounded hover:opacity-80">
                                            <span x-text="option"></span>
                                        </button>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<% 
// ===== Build dynamic columns =====
const columnNames = ['Titre'];

// Relation columns (from entity.relations)
const entityRelations = entity.relations || [];
entityRelations.forEach(rel => {
    columnNames.push(rel.label || rel.key);
});

// Custom field columns
entity.customFields.forEach(field => {
    columnNames.push(field.label);
});

// Classification columns (from entity.classifications)
const entityClassifications = (entity.classifications || []).filter(c => c && c.name);
entityClassifications.forEach(classif => {
    columnNames.push(classif.name);
});

columnNames.push("Créé le");
columnNames.push("Actions");

// ===== Build data rows =====
const dataRows = records.map(record => {
    const row = [];
    
    // --- Title column (uses computedTitle) ---
    const refTitle = record.referenceTitle || record.computedTitle || record.title || 'Sans titre';
    const initial = refTitle.charAt(0).toUpperCase();
    const imageUrl = record.image || null;
    const detailUrl = '/account/' + account_number + '/record/' + entity.slug + '/' + record._id + '/edit';
    
    let refHtml = '';
    if (imageUrl) {
        refHtml = `<a href="${detailUrl}" class="flex items-center gap-3 hover:text-primary">
            <img src="${imageUrl}" alt="${refTitle}" class="w-8 h-8 rounded-full object-cover">
            <span class="font-medium">${refTitle}</span>
        </a>`;
    } else {
        const colors = ['bg-primary', 'bg-info', 'bg-success', 'bg-warning', 'bg-danger', 'bg-secondary'];
        const colorIndex = initial.charCodeAt(0) % colors.length;
        const bgColor = colors[colorIndex];
        refHtml = `<a href="${detailUrl}" class="flex items-center gap-3 hover:text-primary">
            <div class="w-8 h-8 rounded-full ${bgColor} flex items-center justify-center text-white font-semibold text-sm">${initial}</div>
            <span class="font-medium">${refTitle}</span>
        </a>`;
    }
    row.push(refHtml);
    
    // --- Relation columns ---
    const denormRelations = (record._denorm && record._denorm.relations) || [];
    entityRelations.forEach(rel => {
        const denormRel = denormRelations.find(dr => dr.relationKey === rel.key);
        if (denormRel && denormRel.records && denormRel.records.length > 0) {
            const links = denormRel.records.map(r => {
                const href = '/account/' + account_number + '/record/' + (r.entitySlug || '') + '/' + r._id;
                return `<a href="${href}" class="text-primary hover:underline">${r.title || 'Sans titre'}</a>`;
            });
            row.push(links.join(', '));
        } else {
            // Fallback: try raw relation value
            const rawRel = (record.relations || []).find(r => r.relationKey === rel.key);
            row.push(rawRel && rawRel.value ? '—' : '');
        }
    });
    
    // --- Custom field columns ---
    entity.customFields.forEach(field => {
        const customField = record.customFields.find(cf =>
            cf.field_id && (cf.field_id._id || cf.field_id).toString() === field._id.toString()
        );
        row.push(customField ? customField.value : '');
    });
    
    // --- Classification columns (with colored badges) ---
    entityClassifications.forEach(classif => {
        const classifId = classif._id.toString();
        const cv = (record.classificationValues || []).find(
            c => c.classificationId && c.classificationId.toString() === classifId
        );
        if (cv && cv.label) {
            const color = cv.color || '#888';
            row.push(`<span class="badge whitespace-nowrap" style="background-color: ${color}15; color: ${color}; border: 1px solid ${color}30;">${cv.label}</span>`);
        } else if (cv && cv.value) {
            // Fallback for old records without denormalized label
            row.push(`<span class="badge badge-outline-primary">${cv.value}</span>`);
        } else {
            row.push('');
        }
    });
    
    row.push(new Date(record.createdAt).toLocaleDateString());
    
    const actionsHtml = `<div class="flex items-center gap-2">
        <a href="/account/${account_number}/record/${entity.slug}/${record._id}"
            class="btn btn-sm btn-outline-primary p-1" title="Voir">
            <iconify-icon icon="solar:eye-bold-duotone" width="16"></iconify-icon>
        </a>
        <a href="/account/${account_number}/record/${entity.slug}/edit/${record._id}"
            class="btn btn-sm btn-outline-info p-1" title="Modifier">
            <iconify-icon icon="solar:pen-bold-duotone" width="16"></iconify-icon>
        </a>
        <a href="/account/${account_number}/record/${entity.slug}/delete/${record._id}"
            class="btn btn-sm btn-outline-danger p-1" title="Supprimer" onclick="return confirm('Confirmer la suppression ?')">
            <iconify-icon icon="solar:trash-bin-trash-bold-duotone" width="16"></iconify-icon>
        </a>
    </div>`;
    row.push(actionsHtml);
    return row;
});
%>

    <script id="table-columns-data" type="application/json"><%- JSON.stringify(columnNames) %></script>
    <script id="table-rows-data" type="application/json"><%- JSON.stringify(dataRows) %></script>
    <script id="table-preferences-data" type="application/json"><%- JSON.stringify(preferences || {}) %></script>

    <script>
        document.addEventListener("alpine:init", () => {
            Alpine.data("chat", () => ({
                isShowChatMenu: false,
                selectedTab: 'all',
                
                tabChanged(tab) {
                    this.selectedTab = tab;
                },
            }));
            
            Alpine.data("recordTable", () => ({
                datatable: null,
                columns: [],
                preferenceKey: 'record_table_cols_<%= entity._id %>',
                showConfig: false,
                showToolbar: false,
                activePanel: null,
                rowSpacing: 4,
                cellPadding: 8,
                perPageValue: 10,

                init() {
                    try {
                        const colNames = JSON.parse(document.getElementById('table-columns-data').textContent);
                        const dataRows = JSON.parse(document.getElementById('table-rows-data').textContent);
                        const serverPreferences = JSON.parse(document.getElementById('table-preferences-data').textContent);
                        const savedCols = serverPreferences[this.preferenceKey];

                        this.columns = (colNames || []).map((colName, index) => {
                            let hidden = false;
                            if (savedCols && Array.isArray(savedCols)) {
                                const found = savedCols.find(c => c.name === colName);
                                if (found && found.hidden) hidden = true;
                            }
                            return { name: colName, hidden: hidden };
                        });

                        this.datatable = new simpleDatatables.DataTable("#recordTableMain", {
                            data: { headings: colNames, data: dataRows },
                            perPage: 10,
                            perPageSelect: [10, 20, 30, 50, 100],
                            labels: {
                                placeholder: "Rechercher...",
                                perPage: "{select}",
                                noRows: "Aucune entrée trouvée",
                                info: "Affichage de {start} à {end} sur {rows}",
                            },
                            layout: { top: "{search}", bottom: "{info}{select}{pager}" },
                        });

                        this.applyVisibility();
                    } catch (e) {
                        console.error("[Table View] Initialization Error:", e);
                    }
                },

                toggleColumn(index) {
                    this.columns[index].hidden = !this.columns[index].hidden;
                    this.applyVisibility();
                    this.savePreferences();
                },

                applyVisibility() {
                    if (!this.datatable) return;
                    const hiddenIndices = [];
                    const visibleIndices = [];
                    this.columns.forEach((col, idx) => {
                        if (col.hidden) hiddenIndices.push(idx);
                        else visibleIndices.push(idx);
                    });
                    if (hiddenIndices.length > 0) this.datatable.columns().hide(hiddenIndices);
                    if (visibleIndices.length > 0) this.datatable.columns().show(visibleIndices);
                },

                updatePerPage() {
                    if (this.datatable) {
                        this.datatable.setPerPage(this.perPageValue);
                    }
                },

                applyRowSpacing() {
                    const rows = document.querySelectorAll('#recordTableMain tbody tr');
                    rows.forEach(row => {
                        row.style.height = `${32 + this.rowSpacing * 2}px`;
                    });
                },

                applyCellPadding() {
                    const cells = document.querySelectorAll('#recordTableMain tbody td');
                    cells.forEach(cell => {
                        cell.style.paddingTop = `${this.cellPadding}px`;
                        cell.style.paddingBottom = `${this.cellPadding}px`;
                    });
                },

                savePreferences() {
                    const payload = { key: this.preferenceKey, value: this.columns };
                    fetch(`/account/<%= account_number %>/api/user/preferences`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                }
            }));
        });
    </script>
    <script src="/themes/default/assets/js/simple-datatables.js"></script>