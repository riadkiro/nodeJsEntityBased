<%- include('../components/tag-picker') %>
<div x-data="recordForm()" class="space-y-4">
    <form action="/account/<%= account_number %>/record/<%= entity.slug %>/update/<%= record._id %>" method="POST"
        enctype="multipart/form-data" id="main-record-form">

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• HERO IDENTITY BAR (Mission 1) â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <%
            const _hc = entity.headerConfig || {};

            // â”€â”€ Resolve classifications for header display â”€â”€
            const _statusCls = entity.statusClassification;
            let _statusLabel = '', _statusColor = '#94a3b8';
            const _clsTags = [];
            const _shownCls = _hc.shownClassifications || [];

            if (record.classificationValues && record.classificationValues.length > 0) {
                record.classificationValues.forEach(cv => {
                    if (_statusCls && _statusCls._id && cv.classificationId &&
                        cv.classificationId.toString() === _statusCls._id.toString()) {
                        const opt = _statusCls.options.find(o => o._id?.toString() === cv.optionId?.toString());
                        if (opt) { _statusLabel = opt.label; _statusColor = opt.color || '#94a3b8'; }
                    }
                    (entity.classifications || []).forEach(cls => {
                        if (cls._id && cv.classificationId &&
                            cv.classificationId.toString() === cls._id.toString() &&
                            (!_statusCls || !_statusCls._id || cls._id.toString() !== _statusCls._id.toString())) {
                            if (_shownCls.length === 0 || _shownCls.includes(cls._id.toString())) {
                                const opt = cls.options.find(o => o._id?.toString() === cv.optionId?.toString());
                                if (opt) _clsTags.push({ label: opt.label, color: opt.color || '#4361ee' });
                            }
                        }
                    });
                });
            }

            // â”€â”€ Duration since creation â”€â”€
            let _durationStr = '';
            if (_hc.showDuration) {
                const _createdAt = record.createdAt ? new Date(record.createdAt) : null;
                const _now = new Date();
                if (_createdAt) {
                    const diffMs = _now - _createdAt;
                    const diffMin = Math.floor(diffMs / 60000);
                    if (diffMin < 60) _durationStr = diffMin + ' min';
                    else if (diffMin < 1440) _durationStr = Math.floor(diffMin / 60) + 'h ' + (diffMin % 60) + 'min';
                    else _durationStr = Math.floor(diffMin / 1440) + 'j';
                }
            }

            // â”€â”€ Avatar resolution â”€â”€
            const _showIcon = _hc.showIcon !== false;
            const _avSrc = _hc.avatarSource || {};
            let _avatarImage = '';
            if (_showIcon) {
                if (_avSrc.type === 'record-image') {
                    _avatarImage = record.image || '';
                } else if (_avSrc.type === 'relation-image' && locals.headerRelatedRecord) {
                    _avatarImage = locals.headerRelatedRecord.image || '';
                } else if (_avSrc.type === 'field') {
                    const avField = (record.customFields || []).find(cf => {
                        const fid = (cf.field_id?._id || cf.field_id || '').toString();
                        return fid === _avSrc.fieldId;
                    });
                    _avatarImage = avField?.value || '';
                }
            }
            // Icon/color for avatar fallback (use related entity if relation-image)
            const _hrm = locals.headerRelatedMeta || {};
            let _avatarIcon = entity.icon || 'solar:user-bold-duotone';
            let _avatarColor = entity.color || '#4361ee';
            if (_avSrc.type === 'relation-image' && _hrm.relatedEntityIcon) {
                _avatarIcon = _hrm.relatedEntityIcon;
                _avatarColor = _hrm.relatedEntityColor || '#4361ee';
            }

            // â”€â”€ Title resolution (new: titleSource) â”€â”€
            const _showTitle = _hc.showTitle !== false;
            const _titleSrc = _hc.titleSource || {};
            let _heroTitle = record.title || 'Sans titre';
            if (_titleSrc.type === 'relation' && _titleSrc.relationKey && locals.headerRelatedRecord) {
                _heroTitle = locals.headerRelatedRecord.title || _heroTitle;
            } else if (_titleSrc.type !== 'entity' && locals.headerRelatedRecord && locals.headerRelatedRecord.title &&
                       _hc.subtitleRelation && _hc.subtitleRelation.relationKey) {
                _heroTitle = locals.headerRelatedRecord.title;
            }

            // â”€â”€ Subtitle from related record (legacy) â”€â”€
            const _sr = _hc.subtitleRelation || {};
            let _subtitleParts = [];
            if (locals.headerRelatedRecord && _sr.displayFields && _sr.displayFields.length > 0) {
                const hRec = locals.headerRelatedRecord;
                _sr.displayFields.forEach(dfId => {
                    if (dfId === 'title') { if (hRec.title) _subtitleParts.push(hRec.title); return; }
                    const cv = (hRec.customFields || []).find(cf => {
                        const fid = (cf.field_id?._id || cf.field_id || '').toString();
                        return fid === dfId;
                    });
                    if (cv && cv.value) _subtitleParts.push(cv.value);
                });
            }

            // â”€â”€ Hero fields (icon + truncated value, supports entitySource) â”€â”€
            const _heroFieldConfigs = _hc.heroFields || [];
            const _heroFieldValues = [];
            _heroFieldConfigs.forEach(hf => {
                const src = hf.entitySource || 'self';
                const sourceRec = src === 'self' ? record : (locals.headerRelatedRecord || null);
                if (!sourceRec) return;
                const cf = (sourceRec.customFields || []).find(c => {
                    const fid = (c.field_id?._id || c.field_id || '').toString();
                    return fid === hf.fieldId;
                });
                if (cf && cf.value) {
                    const fieldDef = cf.field_id || {};
                    let val = typeof cf.value === 'string' ? cf.value : JSON.stringify(cf.value);
                    const maxChars = hf.maxChars || 20;
                    if (val.length > maxChars) val = val.substring(0, maxChars) + 'â€¦';
                    _heroFieldValues.push({
                        icon: (fieldDef.ui && fieldDef.ui.icon) || 'solar:document-text-linear',
                        value: val
                    });
                }
            });

            // â”€â”€ Meta fields (legacy) â”€â”€
            const _metaFields = (_hc.metaFields || []);
            const _metaBadges = [];
            _metaFields.forEach(mf => {
                if (mf.type === 'computed') {
                    const cv = (typeof computedFieldValues !== 'undefined' ? computedFieldValues : {})[mf.fieldId];
                    if (cv) _metaBadges.push({ label: cv.formatted || cv.value, display: mf.display || 'text' });
                } else if (mf.type === 'field') {
                    const val = (record.customFields || []).find(cf => {
                        const fid = (cf.field_id?._id || cf.field_id || '').toString();
                        return fid === mf.fieldId;
                    });
                    if (val && val.value) _metaBadges.push({ label: val.value, display: mf.display || 'text' });
                }
            });
        %>
        <div class="flex items-center justify-between px-5 py-3 bg-white dark:bg-[#1b2e4b] rounded-xl border border-gray-100 dark:border-gray-800 shadow-sm mb-4"
            x-data="headerBar()">
            <!-- Left: Avatar + Identity -->
            <div class="flex items-center gap-3.5 min-w-0">
                <!-- Avatar -->
                <% if (_showIcon) { %>
                <% if (_avatarImage) { %>
                <img src="<%= _avatarImage %>" alt="" class="w-11 h-11 rounded-full object-cover ring-2 ring-white dark:ring-gray-800 shadow-sm">
                <% } else { %>
                <div class="w-11 h-11 rounded-full flex items-center justify-center text-lg font-bold shadow-sm"
                     style="background: <%= _avatarColor %>15; color: <%= _avatarColor %>">
                    <iconify-icon icon="<%= _avatarIcon %>" width="22"></iconify-icon>
                </div>
                <% } %>
                <% } %>

                <!-- Name + Meta line -->
                <div class="min-w-0">
                    <% if (_showTitle) { %>
                    <h1 class="text-base font-bold text-gray-800 dark:text-white truncate max-w-[350px] leading-tight">
                        <%= _heroTitle %>
                    </h1>
                    <% } %>
                    <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                        <% if (_subtitleParts.length > 0) { %>
                        <span class="text-xs text-gray-500 dark:text-gray-400 font-medium flex items-center gap-1">
                            <iconify-icon icon="solar:user-rounded-linear" width="12" class="text-gray-400"></iconify-icon>
                            <%= _subtitleParts.join(' · ') %>
                        </span>
                        <span class="w-px h-3 bg-gray-200 dark:bg-gray-700"></span>
                        <% } %>
                        <% if (_hc.showClassifications !== false) { %>
                        <% if (_statusLabel) { %>
                        <span class="inline-flex items-center gap-1 text-xs font-semibold" style="color: <%= _statusColor %>">
                            <span class="w-2 h-2 rounded-full" style="background: <%= _statusColor %>"></span>
                            <%= _statusLabel %>
                        </span>
                        <% } %>
                        <% _clsTags.forEach(tag => { %>
                        <span class="inline-flex items-center gap-1 text-xs font-semibold" style="color: <%= tag.color %>">
                            <span class="w-1.5 h-1.5 rounded-full" style="background: <%= tag.color %>"></span>
                            <%= tag.label %>
                        </span>
                        <% }); %>
                        <% } %>
                        <% _heroFieldValues.forEach(hfv => { %>
                        <span class="hb-field-chip">
                            <iconify-icon icon="<%= hfv.icon %>" width="12"></iconify-icon>
                            <%= hfv.value %>
                        </span>
                        <% }); %>
                        <% _metaBadges.forEach(mb => { %>
                        <span class="inline-flex items-center gap-1 text-xs font-medium px-1.5 py-0.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
                            <%= mb.label %>
                        </span>
                        <% }); %>
                        <% if (_durationStr) { %>
                        <span class="text-[11px] text-gray-400 dark:text-gray-500 flex items-center gap-1">
                            <iconify-icon icon="solar:clock-circle-linear" width="12"></iconify-icon>
                            <%= _durationStr %>
                        </span>
                        <% } %>
                    </div>
                </div>
            </div>

            <% if (locals.headerRelatedMeta && locals.headerRelatedRecord) { %>
            <!-- Unified quick access icons: attachments | separator | relations | separator | save -->
            <%
                const _hrm = locals.headerRelatedMeta;
                const _shownRels = _hc.shownRelations || [];
                const _shownRels2 = _shownRels;
                const _hasAttachments = _hrm.attachmentCount > 0 && _hc.showAttachments !== false;

                // Collect all relations: indirect (via patient) + direct + inverse
                // Deduplicate by target entity slug to avoid same entity showing twice
                const _allRelIcons = [];
                const _seenSlugs = new Set();

                // 1) Indirect relations via patient (priority)
                (_hrm.indirectRelations || []).filter(ir => _shownRels.includes(ir.key)).forEach(ir => {
                    const slug = ir.slug || ir.key;
                    if (!_seenSlugs.has(slug)) {
                        _seenSlugs.add(slug);
                        _allRelIcons.push({
                            key: ir.key, label: ir.label, icon: ir.icon, color: ir.color,
                            count: ir.count, slug: ir.slug,
                            records: ir.records || [], type: 'indirect'
                        });
                    }
                });

                // 2) Direct relations
                (entity.relations || []).filter(r => _shownRels.includes(r.key)).forEach(dRel => {
                    const _dTgt = dRel.targetEntity || {};
                    const slug = _dTgt.slug || dRel.key;
                    if (!_seenSlugs.has(slug)) {
                        _seenSlugs.add(slug);
                        const _dTab = (locals.relationTabsMeta || []).find(t => t.key === dRel.key);
                        _allRelIcons.push({
                            key: dRel.key, label: dRel.label || _dTgt.name || 'Relation',
                            icon: _dTgt.icon || 'solar:link-round-bold-duotone',
                            color: _dTgt.color || '#4361ee',
                            count: _dTab ? _dTab.count : 0, slug: _dTgt.slug || '',
                            records: (locals.relatedRecordsData || {})[dRel.key] || [],
                            type: 'direct'
                        });
                    }
                });

                // 3) Inverse relations
                (locals.inverseRelations || []).filter(invR => _shownRels.includes(invR.key)).forEach(invR => {
                    const _iTgt = invR.targetEntity || {};
                    const slug = _iTgt.slug || invR.key;
                    if (!_seenSlugs.has(slug)) {
                        _seenSlugs.add(slug);
                        const _iTab = (locals.relationTabsMeta || []).find(t => t.key === invR.key);
                        _allRelIcons.push({
                            key: invR.key, label: invR.label || _iTgt.name || 'Relation',
                            icon: _iTgt.icon || 'solar:link-round-bold-duotone',
                            color: _iTgt.color || '#4361ee',
                            count: _iTab ? _iTab.count : 0, slug: _iTgt.slug || '',
                            records: (locals.relatedRecordsData || {})[invR.key] || [],
                            type: 'inverse'
                        });
                    }
                });

                const _hasAnyRel = _allRelIcons.length > 0;
            %>
            <% if (_hasAttachments || _hasAnyRel) { %>
            <div class="hb-quick-icons" x-data="{ openDropdown: null }">
                <!-- Attachments icon -->
                <% if (_hasAttachments) { %>
                <div class="hb-icon-item" @click.outside="openDropdown = openDropdown === 'attach' ? null : openDropdown">
                    <div class="hb-icon-btn" @click="openDropdown = openDropdown === 'attach' ? null : 'attach'"
                         title="Pièces jointes (<%= _hrm.attachmentCount %>)">
                        <iconify-icon icon="solar:paperclip-bold-duotone" width="15" style="color:#f59e0b;flex-shrink:0"></iconify-icon>
                        <span class="hb-expand-label" style="color:#f59e0b">Documents</span>
                        <span class="hb-badge" style="background:#f59e0b"><%= _hrm.attachmentCount %></span>
                    </div>
                    <div class="hb-dropdown" x-show="openDropdown === 'attach'" x-transition x-cloak>
                        <div class="hb-dropdown-header">
                            <iconify-icon icon="solar:paperclip-bold-duotone" width="14" style="color:#f59e0b"></iconify-icon>
                            <span>Pièces jointes · <%= locals.headerRelatedRecord.title %></span>
                        </div>
                        <div class="hb-dropdown-list">
                            <% (locals.headerRelatedRecord.attachments || []).forEach(att => { %>
                            <a href="/account/<%= account_number %>/uploads/<%= att.filename %>" target="_blank" class="hb-dropdown-item">
                                <iconify-icon icon="<%= att.category === 'pdf' ? 'solar:file-text-bold-duotone' : att.category === 'image' ? 'solar:gallery-bold-duotone' : att.category === 'word' ? 'solar:document-text-bold-duotone' : 'solar:file-bold-duotone' %>" width="16"
                                    style="color:<%= att.category === 'pdf' ? '#ef4444' : att.category === 'image' ? '#3b82f6' : att.category === 'word' ? '#2563eb' : '#6b7280' %>"></iconify-icon>
                                <span class="hb-dropdown-item-text"><%= att.originalName %></span>
                                <span class="hb-dropdown-item-meta"><%= att.category %></span>
                            </a>
                            <% }); %>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- Separator between attachments and relations -->
                <% if (_hasAttachments && _hasAnyRel) { %>
                <span class="hb-separator"></span>
                <% } %>

                <!-- All relation icons (deduplicated) -->
                <% _allRelIcons.forEach(rel => { %>
                <div class="hb-icon-item" @click.outside="openDropdown = openDropdown === '<%= rel.key %>' ? null : openDropdown">
                    <div class="hb-icon-btn" @click="openDropdown = openDropdown === '<%= rel.key %>' ? null : '<%= rel.key %>'"
                         title="<%= rel.label %> (<%= rel.count %>)">
                        <iconify-icon icon="<%= rel.icon %>" width="15" style="color:<%= rel.color %>;flex-shrink:0"></iconify-icon>
                        <span class="hb-expand-label" style="color:<%= rel.color %>"><%= rel.label %></span>
                        <% if (rel.count > 0) { %>
                        <span class="hb-badge" style="background:<%= rel.color %>"><%= rel.count %></span>
                        <% } %>
                    </div>
                    <div class="hb-dropdown" x-show="openDropdown === '<%= rel.key %>'" x-transition x-cloak>
                        <div class="hb-dropdown-header">
                            <iconify-icon icon="<%= rel.icon %>" width="14" style="color:<%= rel.color %>"></iconify-icon>
                            <span><%= rel.label %></span>
                            <span class="hb-dropdown-count"><%= rel.count %></span>
                        </div>
                        <% if (rel.records.length > 0) { %>
                        <div class="hb-dropdown-list">
                            <% rel.records.slice(0, 5).forEach(rec => { %>
                            <a href="/account/<%= account_number %>/record/<%= rel.slug %>/<%= rec._id %>/edit" class="hb-dropdown-item">
                                <iconify-icon icon="<%= rel.icon %>" width="14" style="color:<%= rel.color %>"></iconify-icon>
                                <span class="hb-dropdown-item-text"><%= rec.title || 'Sans titre' %></span>
                            </a>
                            <% }); %>
                        </div>
                        <% } else { %>
                        <div class="hb-dropdown-empty">
                            <iconify-icon icon="solar:magnifer-linear" width="16" style="color:#9ca3af"></iconify-icon>
                            <span>Aucun enregistrement</span>
                        </div>
                        <% } %>
                        <% if (rel.slug) { %>
                        <a href="/account/<%= account_number %>/record/<%= rel.slug %>" class="hb-dropdown-footer">
                            Voir tout →
                        </a>
                        <% } %>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } %>
            <% } %>



            <!-- Right: Quick action buttons + More menu -->
            <div class="flex items-center gap-2">
                <!-- Separator before save group -->
                <span class="hb-separator"></span>

                <!-- Hidden standard fields for form submission -->
                <input type="hidden" name="standard[published]" value="<%= record.published ? 'on' : '' %>">

                <!-- Quick Action Buttons (from document templates if available) -->
                <% if (locals.documentTemplates && documentTemplates.length > 0) { %>
                    <% documentTemplates.slice(0, 3).forEach(tpl => { %>
                    <a href="/account/<%= account_number %>/document/generate/<%= tpl._id %>?recordId=<%= record._id %>"
                       class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-gray-200 dark:border-gray-700 text-xs font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:border-gray-300 transition-all"
                       title="<%= tpl.name %>">
                        <iconify-icon icon="<%= tpl.icon || 'solar:document-bold-duotone' %>" width="14" style="color: <%= tpl.color || '#4361ee' %>"></iconify-icon>
                        <span><%= tpl.name %></span>
                    </a>
                    <% }); %>
                <% } %>

                <!-- Save Button (always visible) -->
                <button type="submit" form="main-record-form"
                    class="flex items-center gap-1.5 px-4 py-2 rounded-lg bg-primary text-white text-xs font-bold hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20 transition-all"
                    x-data="{ submitting: false }" @submit.window="submitting = true"
                    :disabled="submitting"
                    :class="submitting ? 'opacity-60 cursor-wait' : ''">
                    <iconify-icon :icon="submitting ? 'line-md:loading-twotone-loop' : 'solar:diskette-bold'" width="14"></iconify-icon>
                    <span x-text="submitting ? 'Envoi...' : 'Enregistrer'">Enregistrer</span>
                </button>

                <!-- 3-dot More Menu -->
                <div class="relative">
                    <button type="button" @click="showMoreMenu = !showMoreMenu"
                        class="flex items-center justify-center w-9 h-9 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-400 hover:text-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-all">
                        <iconify-icon icon="solar:menu-dots-bold" width="18"></iconify-icon>
                    </button>
                    <!-- More menu dropdown -->
                    <div x-show="showMoreMenu" x-transition @click.outside="showMoreMenu = false"
                        class="absolute right-0 top-full mt-2 bg-white dark:bg-[#1b2e4b] rounded-xl shadow-xl border border-gray-100 dark:border-gray-700 py-1.5 w-[200px] z-50">
                        <!-- Save -->
                        <button type="submit" form="main-record-form"
                            class="w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors"
                            x-data="{ submitting: false }" @submit.window="submitting = true">
                            <iconify-icon icon="solar:diskette-bold" width="15" class="text-primary"></iconify-icon>
                            <span x-text="submitting ? 'Envoi...' : 'Enregistrer'">Enregistrer</span>
                        </button>
                        <!-- Layout mode -->
                        <button type="button" @click="designMode = !designMode; showMoreMenu = false"
                            class="w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                            <iconify-icon icon="tabler:layout-dashboard" width="15" class="text-gray-400"></iconify-icon>
                            <span>Mode mise en page</span>
                        </button>
                        <!-- Header Config -->
                        <button type="button" @click="$dispatch('open-header-config'); showMoreMenu = false"
                            class="w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                            <iconify-icon icon="solar:widget-6-bold-duotone" width="15" class="text-purple-400"></iconify-icon>
                            <span>Configurer l'en-tÃªte</span>
                        </button>
                        <div class="h-px bg-gray-100 dark:bg-gray-700 my-1"></div>
                        <!-- Delete -->
                        <button type="button" @click="showDeleteConfirm = true; showMoreMenu = false"
                            class="w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors">
                            <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="15"></iconify-icon>
                            <span>Supprimer</span>
                        </button>
                </div>
            </div>
            </div>
            <!-- Delete confirmation overlay -->
            <div x-show="showDeleteConfirm" x-transition
                 class="fixed inset-0 bg-black/20 backdrop-blur-sm z-[100] flex items-center justify-center" @click.self="showDeleteConfirm = false">
                <div class="bg-white dark:bg-[#1b2e4b] rounded-2xl shadow-2xl border border-gray-100 dark:border-gray-700 p-6 w-[320px]">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-full bg-red-50 dark:bg-red-500/10 flex items-center justify-center">
                            <iconify-icon icon="solar:trash-bin-minimalistic-bold" width="20" class="text-red-500"></iconify-icon>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-gray-800 dark:text-white">Supprimer cet enregistrement ?</h3>
                            <p class="text-xs text-gray-400 mt-0.5">Cette action est irrÃ©versible.</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" @click="showDeleteConfirm = false"
                            class="flex-1 px-4 py-2 text-xs font-semibold text-gray-500 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 transition-all">
                            Annuler
                        </button>
                        <a href="/account/<%= account_number %>/record/<%= entity.slug %>/delete/<%= record._id %>"
                            class="flex-1 px-4 py-2 text-xs font-bold text-white bg-red-500 rounded-lg hover:bg-red-600 text-center transition-all">
                            Supprimer
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• RELATION TABS BAR â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <% if (locals.relationTabsMeta && locals.relationTabsMeta.length > 0) { %>
        <div x-data="relationTabs()" class="mb-4" style="display:none">
            <!-- Tab Bar -->
            <div class="flex items-center bg-white dark:bg-[#1b2e4b] rounded-xl border border-gray-100 dark:border-gray-800 shadow-sm overflow-hidden">
                <!-- Scrollable Tabs Container -->
                <div class="flex-1 flex items-center gap-0.5 overflow-x-auto hide-scrollbar px-1.5 py-1.5" id="relation-tabs-scroll">
                    <!-- Self Tab (entity itself) â€” always first -->
                    <button type="button"
                            @click="selectTab('__self__')"
