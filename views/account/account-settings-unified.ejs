<div class="animate__animated p-6" :class="[$store.app.animation]">
    <ul class="flex space-x-2 rtl:space-x-reverse">
        <li>
            <a href="/account/<%= account_number %>/dashboard" class="text-primary hover:underline">Dashboard</a>
        </li>
        <li class="before:content-['/'] ltr:before:mr-1 rtl:before:ml-1">
            <span>Paramètres</span>
        </li>
    </ul>

    <div class="pt-5" x-data="settingsPage()">
        <!-- Tab Navigation -->
        <div class="mb-6 flex items-center gap-1 overflow-x-auto overflow-y-hidden border-b border-gray-200 dark:border-[#1b2e4b]">
            <button @click="activeTab = 'general'"
                class="px-4 py-2.5 text-sm font-semibold transition-all border-b-2 -mb-[1px] flex shrink-0 items-center gap-2"
                :class="activeTab === 'general' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'">
                <iconify-icon icon="solar:settings-bold-duotone" width="18"></iconify-icon>
                Général
            </button>
            <button @click="activeTab = 'security'"
                class="px-4 py-2.5 text-sm font-semibold transition-all border-b-2 -mb-[1px] flex shrink-0 items-center gap-2"
                :class="activeTab === 'security' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'">
                <iconify-icon icon="solar:shield-keyhole-bold-duotone" width="18"></iconify-icon>
                Sécurité
            </button>
            <% if (isAdmin) { %>
            <button @click="activeTab = 'members'"
                class="px-4 py-2.5 text-sm font-semibold transition-all border-b-2 -mb-[1px] flex shrink-0 items-center gap-2"
                :class="activeTab === 'members' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'">
                <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="18"></iconify-icon>
                Membres
                <span class="px-1.5 py-0.5 rounded-md text-[10px] font-bold bg-primary/10 text-primary"><%= members.length %></span>
            </button>
            <% } %>
            <% if (isAdmin) { %>
            <button @click="activeTab = 'billing'"
                class="px-4 py-2.5 text-sm font-semibold transition-all border-b-2 -mb-[1px] flex shrink-0 items-center gap-2"
                :class="activeTab === 'billing' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'">
                <iconify-icon icon="solar:card-bold-duotone" width="18"></iconify-icon>
                Facturation
            </button>
            <% } %>
            <% if (isAdmin) { %>
            <button @click="activeTab = 'advanced'"
                class="px-4 py-2.5 text-sm font-semibold transition-all border-b-2 -mb-[1px] flex shrink-0 items-center gap-2"
                :class="activeTab === 'advanced' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'">
                <iconify-icon icon="solar:tuning-2-bold-duotone" width="18"></iconify-icon>
                Avancé
            </button>
            <% } %>
        </div>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- TAB: Général -->
        <!-- ═══════════════════════════════════════════════ -->
        <div x-show="activeTab === 'general'" x-transition>
            <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                <!-- Account Info Form -->
                <div class="panel">
                    <div class="mb-5">
                        <h6 class="text-lg font-bold dark:text-white-light">Informations du compte</h6>
                        <p class="text-sm text-gray-500 mt-1">Modifiez les informations de votre espace de travail</p>
                    </div>
                    <form @submit.prevent="saveAccountInfo">
                        <div class="mb-5">
                            <label for="accountName" class="block text-sm font-medium mb-2">Nom du compte</label>
                            <input id="accountName" type="text" x-model="accountName" class="form-input" placeholder="Entrez le nom du compte" />
                        </div>
                        <div class="mb-5">
                            <label class="block text-sm font-medium mb-2">Icône du compte</label>
                            <div class="flex items-center gap-4">
                                <div class="p-3 bg-primary/10 text-primary rounded-lg">
                                    <iconify-icon :icon="accountIcon" width="32" height="32"></iconify-icon>
                                </div>
                                <div class="flex-1">
                                    <div class="flex flex-wrap gap-2 mb-2">
                                        <template x-for="icon in popularIcons" :key="icon">
                                            <button type="button" class="p-2 rounded-lg border transition-all"
                                                :class="accountIcon === icon ? 'border-primary bg-primary/10' : 'border-gray-200 dark:border-gray-800 hover:border-primary'"
                                                @click="accountIcon = icon">
                                                <iconify-icon :icon="icon" width="20" height="20"></iconify-icon>
                                            </button>
                                        </template>
                                    </div>
                                    <input type="text" x-model="accountIcon" class="form-input text-sm" placeholder="solar:home-bold" />
                                </div>
                            </div>
                        </div>
                        <div class="mb-5">
                            <label class="block text-sm font-medium mb-2">Numéro de compte</label>
                            <div class="flex items-center gap-2">
                                <input type="text" value="<%= account_number %>" class="form-input bg-gray-100 dark:bg-gray-800" disabled />
                                <button type="button" class="btn btn-outline-secondary btn-sm" @click="copyAccountNumber">
                                    <iconify-icon icon="solar:copy-linear" width="16"></iconify-icon>
                                </button>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="submit" class="btn btn-primary" :disabled="isSaving">
                                <span x-show="isSaving" class="animate-spin border-2 border-white border-l-transparent rounded-full w-4 h-4 inline-block mr-2"></span>
                                <span x-text="isSaving ? 'Enregistrement...' : 'Enregistrer'"></span>
                            </button>
                            <span x-show="saveSuccess" x-transition class="text-success text-sm">
                                <iconify-icon icon="solar:check-circle-bold" class="align-middle"></iconify-icon>
                                Enregistré
                            </span>
                        </div>
                    </form>
                </div>

                <!-- Stats -->
                <div class="panel">
                    <div class="mb-5">
                        <h6 class="text-lg font-bold dark:text-white-light">Statistiques</h6>
                        <p class="text-sm text-gray-500 mt-1">Aperçu de votre espace</p>
                    </div>
                    <div class="space-y-4">
                        <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
                            <div class="flex items-center gap-3">
                                <div class="p-2 bg-primary/20 text-primary rounded-lg">
                                    <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="24"></iconify-icon>
                                </div>
                                <div>
                                    <div class="text-sm text-gray-500">Membres actifs</div>
                                    <div class="text-lg font-semibold"><%= members.length %></div>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
                            <div class="flex items-center gap-3">
                                <div class="p-2 bg-warning/20 text-warning rounded-lg">
                                    <iconify-icon icon="solar:letter-bold-duotone" width="24"></iconify-icon>
                                </div>
                                <div>
                                    <div class="text-sm text-gray-500">Invitations en attente</div>
                                    <div class="text-lg font-semibold"><%= pendingInvites.length %></div>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
                            <div class="flex items-center gap-3">
                                <div class="p-2 bg-info/20 text-info rounded-lg">
                                    <iconify-icon icon="solar:calendar-bold-duotone" width="24"></iconify-icon>
                                </div>
                                <div>
                                    <div class="text-sm text-gray-500">Date de création</div>
                                    <div class="text-lg font-semibold"><%= account && account.created_on ? new Date(account.created_on).toLocaleDateString('fr-FR') : '—' %></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- TAB: Sécurité -->
        <!-- ═══════════════════════════════════════════════ -->
        <div x-show="activeTab === 'security'" x-transition x-init="initSecurity()">
            <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
                <!-- PIN Code Section (REAL) -->
                <div class="panel">
                    <div class="mb-5 flex items-start justify-between">
                        <div>
                            <h6 class="text-lg font-bold dark:text-white-light flex items-center gap-2">
                                <iconify-icon icon="solar:dialpad-bold-duotone" width="20" class="text-primary"></iconify-icon>
                                Code PIN personnel
                            </h6>
                            <p class="text-sm text-gray-500 mt-1">Verrouillez l'accès à certaines données (ex: Notes sécurisées)</p>
                        </div>
                        <template x-if="pinEnabled">
                            <span class="badge bg-success/10 text-success text-xs flex items-center gap-1">
                                <iconify-icon icon="solar:check-circle-bold" width="14"></iconify-icon> Actif
                            </span>
                        </template>
                        <template x-if="!pinEnabled">
                            <span class="badge bg-gray-100 text-gray-500 text-xs flex items-center gap-1">
                                <iconify-icon icon="solar:minus-circle-bold" width="14"></iconify-icon> Inactif
                            </span>
                        </template>
                    </div>

                    <div class="p-4 bg-primary/5 border border-primary/20 rounded-xl mb-5">
                        <div class="flex gap-3">
                            <iconify-icon icon="solar:info-circle-bold-duotone" width="24" class="text-primary shrink-0"></iconify-icon>
                            <p class="text-sm text-primary">Le code PIN est lié à votre compte utilisateur. Il vous permet de protéger l'accès à des informations sensibles au sein des espaces partagés.</p>
                        </div>
                    </div>

                    <form @submit.prevent="savePin">
                        <template x-if="pinEnabled">
                            <div class="mb-4">
                                <label class="block text-sm font-semibold mb-2">PIN actuel <span class="text-danger">*</span></label>
                                <input type="password" x-model="currentPin" maxlength="4" pattern="[0-9]{4}" placeholder="••••" class="form-input text-center tracking-widest text-lg font-mono w-24" required />
                            </div>
                        </template>
                        <div class="mb-4">
                            <label class="block text-sm font-semibold mb-2">
                                <span x-text="pinEnabled ? 'Nouveau PIN (4 chiffres)' : 'Créer un PIN (4 chiffres)'"></span>
                                <span class="text-danger">*</span>
                            </label>
                            <div class="flex gap-4">
                                <div>
                                    <input type="password" x-model="newPin" maxlength="4" pattern="[0-9]{4}" placeholder="••••" class="form-input text-center tracking-widest text-lg font-mono w-24" required />
                                    <div class="text-xs text-gray-400 mt-1">Saisie</div>
                                </div>
                                <div>
                                    <input type="password" x-model="confirmPin" maxlength="4" pattern="[0-9]{4}" placeholder="••••" class="form-input text-center tracking-widest text-lg font-mono w-24" required />
                                    <div class="text-xs text-gray-400 mt-1">Confirmation</div>
                                </div>
                            </div>
                            <template x-if="pinError">
                                <p class="text-danger text-sm mt-2 flex items-center gap-1">
                                    <iconify-icon icon="solar:danger-circle-bold" width="16"></iconify-icon>
                                    <span x-text="pinError"></span>
                                </p>
                            </template>
                        </div>
                        <div class="flex gap-2">
                            <button type="submit" class="btn btn-primary" :disabled="isPinSaving">
                                <span x-show="isPinSaving" class="animate-spin border-2 border-white border-l-transparent rounded-full w-4 h-4 inline-block mr-2"></span>
                                <span x-text="pinEnabled ? 'Modifier le PIN' : 'Définir le PIN'"></span>
                            </button>
                            <template x-if="pinEnabled">
                                <button type="button" @click="deletePin" class="btn btn-outline-danger" :disabled="isPinSaving">
                                    Désactiver
                                </button>
                            </template>
                        </div>
                    </form>
                </div>

                <!-- 2FA & Sessions Section (DEMO) -->
                <div class="space-y-6">
                    <div class="panel relative overflow-hidden">
                        <div class="absolute top-0 right-0 p-3">
                            <span class="badge bg-warning/10 text-warning text-xs font-bold px-2 py-1">Bientôt disponible</span>
                        </div>
                        <h6 class="text-lg font-bold dark:text-white-light flex items-center gap-2 mb-4 opacity-50">
                            <iconify-icon icon="solar:lock-password-bold-duotone" width="20" class="text-gray-500"></iconify-icon>
                            Authentification à deux facteurs (2FA)
                        </h6>
                        <p class="text-sm text-gray-500 mb-4 opacity-50">Sécurisez votre compte en ajoutant une couche de sécurité supplémentaire (Google Authenticator, SMS).</p>
                        <button class="btn btn-outline-secondary" disabled>Configurer 2FA</button>
                    </div>

                    <div class="panel">
                        <h6 class="text-lg font-bold dark:text-white-light flex items-center gap-2 mb-4">
                            <iconify-icon icon="solar:devices-bold-duotone" width="20" class="text-info"></iconify-icon>
                            Sessions actives
                        </h6>
                        <div class="space-y-4">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-success/10 flex items-center justify-center text-success">
                                        <iconify-icon icon="solar:laptop-minimalistic-bold-duotone" width="20"></iconify-icon>
                                    </div>
                                    <div>
                                        <div class="text-sm font-semibold dark:text-white-light">Windows 11 · Chrome</div>
                                        <div class="text-xs text-gray-500">Rabat, Maroc · Actuellement active</div>
                                    </div>
                                </div>
                                <span class="badge bg-success">Cet appareil</span>
                            </div>
                            <div class="flex items-center justify-between opacity-60">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-gray-500">
                                        <iconify-icon icon="solar:smartphone-bold-duotone" width="20"></iconify-icon>
                                    </div>
                                    <div>
                                        <div class="text-sm font-semibold dark:text-white-light">iPhone 14 Pro · Safari</div>
                                        <div class="text-xs text-gray-500">Casablanca, Maroc · Il y a 2 jours</div>
                                    </div>
                                </div>
                                <button class="text-danger hover:underline text-xs">Déconnecter</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Access Logs Demo -->
            <div class="panel mt-6">
                <h6 class="text-lg font-bold dark:text-white-light flex items-center gap-2 mb-4">
                    <iconify-icon icon="solar:history-bold-duotone" width="20" class="text-gray-500"></iconify-icon>
                    Journaux d'accès récents
                </h6>
                <div class="table-responsive">
                    <table class="text-sm">
                        <thead>
                            <tr>
                                <th>Événement</th>
                                <th>Date & Heure</th>
                                <th>IP & Localisation</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="font-semibold">Connexion réussie</td>
                                <td>Aujourd'hui, 09:30</td>
                                <td>196.100.12.34 (Rabat, MA)</td>
                                <td><span class="badge bg-success/10 text-success">Succès</span></td>
                            </tr>
                            <tr>
                                <td class="font-semibold">Déverrouillage note sécurisée</td>
                                <td>Hier, 14:45</td>
                                <td>196.100.12.34 (Rabat, MA)</td>
                                <td><span class="badge bg-success/10 text-success">Succès</span></td>
                            </tr>
                            <tr>
                                <td class="font-semibold">Tentative PIN échouée</td>
                                <td>Hier, 14:42</td>
                                <td>196.100.12.34 (Rabat, MA)</td>
                                <td><span class="badge bg-danger/10 text-danger">Échec</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- TAB: Membres (admin only) -->
        <!-- ═══════════════════════════════════════════════ -->
        <% if (isAdmin) { %>
        <div x-show="activeTab === 'members'" x-transition>
            <!-- Invite Button -->
            <div class="flex items-center justify-between mb-5">
                <div>
                    <h5 class="text-lg font-bold dark:text-white-light">Gestion des membres</h5>
                    <p class="text-sm text-gray-500 mt-0.5"><%= account.name %> · <%= members.length %> membre(s)</p>
                </div>
                <button onclick="document.getElementById('inviteModal').showModal()" class="btn btn-primary">
                    <iconify-icon icon="solar:user-plus-bold" width="16" class="mr-1.5"></iconify-icon>
                    Inviter un membre
                </button>
            </div>

            <!-- Members Table -->
            <div class="panel !p-0 overflow-hidden">
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Membre</th>
                                <th>Rôle</th>
                                <th>Plan</th>
                                <th>Dernière connexion</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% members.forEach(m => { %>
                            <tr>
                                <td>
                                    <div class="flex items-center gap-3">
                                        <% if (m.avatar) { %>
                                            <img src="<%= m.avatar %>" class="w-9 h-9 rounded-lg object-cover" alt="" />
                                        <% } else { %>
                                            <div class="w-9 h-9 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">
                                                <%= m.name ? m.name.charAt(0).toUpperCase() : '?' %>
                                            </div>
                                        <% } %>
                                        <div>
                                            <div class="font-semibold dark:text-white-light"><%= m.name || '—' %></div>
                                            <div class="text-xs text-gray-500"><%= m.email %></div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <% if (m.workspaceRole === 'owner') { %>
                                        <span class="badge bg-purple-100 text-purple-600">
                                            <iconify-icon icon="solar:crown-bold" width="12" class="mr-1"></iconify-icon>
                                            Propriétaire
                                        </span>
                                    <% } else if (m.workspaceRole === 'admin') { %>
                                        <span class="badge bg-info-light text-info">Admin</span>
                                    <% } else if (m.workspaceRole === 'manager') { %>
                                        <span class="badge bg-warning-light text-warning">Manager</span>
                                    <% } else if (m.workspaceRole === 'external') { %>
                                        <span class="badge bg-secondary-light text-secondary">Externe</span>
                                    <% } else if (m.workspaceRole === 'guest') { %>
                                        <span class="badge bg-dark-light text-dark">Invité</span>
                                    <% } else { %>
                                        <span class="badge bg-primary-light text-primary">Membre</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400"><%= (m.membership?.plan || 'free').toUpperCase() %></span>
                                </td>
                                <td class="text-xs text-gray-500">
                                    <% if (m.lastLogin) { %>
                                        <%= new Date(m.lastLogin).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                                    <% } else { %>
                                        —
                                    <% } %>
                                </td>
                                <td>
                                    <div class="flex items-center justify-center gap-2">
                                        <% if (m.workspaceRole === 'owner') { %>
                                            <span class="text-xs text-gray-400 italic">propriétaire</span>
                                        <% } else if (String(m._id) === String(user._id)) { %>
                                            <span class="text-xs text-gray-400 italic">vous</span>
                                        <% } else if (userRole === 'owner') { %>
                                            <%/* Owner can do everything */%>
                                            <select onchange="changeMemberRole('<%= m._id %>', this.value)" class="form-select form-select-sm w-auto text-xs">
                                                <option value="admin" <%= m.workspaceRole === 'admin' ? 'selected' : '' %>>Admin</option>
                                                <option value="manager" <%= m.workspaceRole === 'manager' ? 'selected' : '' %>>Manager</option>
                                                <option value="member" <%= m.workspaceRole === 'member' ? 'selected' : '' %>>Membre</option>
                                                <option value="external" <%= m.workspaceRole === 'external' ? 'selected' : '' %>>Externe</option>
                                                <option value="guest" <%= m.workspaceRole === 'guest' ? 'selected' : '' %>>Invité</option>
                                            </select>
                                            <button onclick="removeMember('<%= m._id %>', '<%= (m.name || m.email).replace(/'/g, "\\'") %>')" class="btn btn-sm btn-outline-danger !p-1.5" title="Retirer">
                                                <iconify-icon icon="solar:user-minus-bold" width="16"></iconify-icon>
                                            </button>
                                        <% } else if (userRole === 'admin' && m.workspaceRole === 'member') { %>
                                            <%/* Admin can only manage members (not other admins) */%>
                                            <button onclick="removeMember('<%= m._id %>', '<%= (m.name || m.email).replace(/'/g, "\\'") %>')" class="btn btn-sm btn-outline-danger !p-1.5" title="Retirer">
                                                <iconify-icon icon="solar:user-minus-bold" width="16"></iconify-icon>
                                            </button>
                                        <% } else if (userRole === 'admin' && m.workspaceRole === 'admin') { %>
                                            <span class="text-xs text-gray-400 italic">admin</span>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                            <% if (members.length === 0) { %>
                            <tr><td colspan="5" class="text-center py-8 text-gray-400">Aucun membre</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pending Invitations -->
            <% if (pendingInvites.length > 0) { %>
            <div class="mt-6">
                <h6 class="text-sm font-bold mb-3 flex items-center gap-2 dark:text-white-light">
                    <iconify-icon icon="solar:letter-bold-duotone" width="16" class="text-warning"></iconify-icon>
                    Invitations en attente (<%= pendingInvites.length %>)
                </h6>
                <div class="panel !p-0 overflow-hidden">
                    <% pendingInvites.forEach(inv => { %>
                    <div class="flex items-center justify-between p-4 border-b border-gray-100 dark:border-[#1b2e4b] last:border-0">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-warning/10 flex items-center justify-center">
                                <iconify-icon icon="solar:letter-bold" width="16" class="text-warning"></iconify-icon>
                            </div>
                            <div>
                                <div class="text-sm font-semibold dark:text-white-light"><%= inv.email %></div>
                                <div class="text-xs text-gray-400">
                                    Invité en tant que <%= inv.role %>
                                    <% if (inv.expiresAt) { %> · expire le <%= new Date(inv.expiresAt).toLocaleDateString('fr-FR') %><% } %>
                                </div>
                            </div>
                        </div>
                        <button onclick="cancelInvite('<%= inv.email %>')" class="btn btn-sm btn-outline-danger">Annuler</button>
                    </div>
                    <% }); %>
                </div>
            </div>
            <% } %>
        </div>
        <% } %>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- TAB: Facturation & Plan -->
        <!-- ═══════════════════════════════════════════════ -->
