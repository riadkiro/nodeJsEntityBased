                                </div>
                                <div class="flex items-center gap-1">
                                    <div class="flex items-center justify-center h-4">
                                        <iconify-icon icon="solar:alt-arrow-down-bold"
                                            :class="relationsFieldsOpen ? 'rotate-180' : ''"
                                            class="text-gray-400 transition-transform duration-300 block"
                                            width="14"></iconify-icon>
                                    </div>
                                </div>
                            </div>
                            <div x-show="relationsFieldsOpen" x-collapse>
                                <template x-for="relField in getRelationFields()" :key="relField.item.id">
