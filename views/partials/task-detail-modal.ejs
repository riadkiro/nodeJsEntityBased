	        normalizeSubtasks(subtasks = []) {
	            return (Array.isArray(subtasks) ? subtasks : [])
	                .map((subtask, index) => ({
	                    _id: subtask?._id || '',
	                    title: String(subtask?.title || subtask || '').trim(),
	                    done: subtask?.done === true,
	                    order: Number.isFinite(Number(subtask?.order)) ? Number(subtask.order) : index,
	                    completedAt: subtask?.completedAt || null,
	                    createdAt: subtask?.createdAt || new Date().toISOString()
	                }))
	                .filter(subtask => subtask.title)
	                .sort((a, b) => a.order - b.order)
	                .map((subtask, index) => ({ ...subtask, order: index }));
	        },

	        subtasks() {
	            if (!this.task) return [];
	            this.task.subtasks = this.normalizeSubtasks(this.task.subtasks || []);
	            return this.task.subtasks;
