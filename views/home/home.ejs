	            'ai-feed': { type: 'ai-feed', label: 'Feed intelligent IA', icon: 'solar:magic-stick-3-bold-duotone', color: '#7c3aed', config: { limit: 4 } },
	            'weekly-timeline': { type: 'weekly-timeline', label: 'Timeline', icon: 'solar:calendar-date-bold-duotone', color: '#805dca', config: { limit: 7 } },
	            'quick-links': { type: 'quick-links', label: 'Raccourcis', icon: 'solar:bolt-circle-bold-duotone', color: '#8b5cf6', config: { showTasks: true, showNotes: true, showDocuments: true } },
	            'recent-records': { type: 'recent-records', label: 'Activité récente', icon: 'solar:history-bold-duotone', color: '#f59e0b', config: { limit: 5, showLink: true } }
	        },

        async init() {
            this.rows = JSON.parse(JSON.stringify(this._defaultRows));
            this._loadLayout();
            this._fetchData();
            window.addEventListener('mousemove', (e) => this._onResizeMove(e));
            window.addEventListener('mouseup', () => this._onResizeEnd());
            window.addEventListener('pointermove', (e) => this._onResizeMove(e));
            window.addEventListener('pointerup', () => this._onResizeEnd());
	            this._homeWidgetListener = (e) => this.insertWidgetFromPicker(e.detail || {});
	            window.addEventListener('insert-home-overview-widget', this._homeWidgetListener);
	            window.addEventListener('update-home-overview-widget', (e) => this._updateWidgetFromPicker(e.detail || {}));
	            window.addEventListener('delete-home-overview-custom-widget', (e) => this.deleteCustomWidgetFromPicker(e.detail || {}));
	            window.addEventListener('close-home-task-menu', () => this.closeHomeTaskMenu());
	            // Re-init sortables when data finishes loading and layout mode is active
	            this.$watch('loadingData', (loading) => {
                if (!loading && this.layoutMode) {
                    this.$nextTick(() => this._startObserver());
                }
            });
        },

        async _fetchData() {
            try {
                const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
                const timezoneQuery = timezone ? `?tz=${encodeURIComponent(timezone)}` : '';
                const res = await fetch(`/account/${_accountNumber}/api/home-overview${timezoneQuery}`, { credentials: 'include' });
	                const data = await res.json();
	                if (data.success) {
		                    this.todayTasks = data.todayTasks || [];
		                    this.completedTodayData = data.completedToday || [];
		                    this.allTasks = data.tasks || [];
		                    this.tasksByRecord = data.tasksByRecord || [];
		                    this.homeTaskLists = (data.taskLists || []).map(list => this.normalizeHomeTaskList(list));
		                    this.defaultWidgets = data.defaultWidgets || {};
		                    this.recentRecords = data.recentRecords || [];
	                    this.upcomingEvents = data.upcomingEvents || [];
	                    this.importantDates = data.importantDates || [];
	                    this.applyHomeData(data.homeData || {});
                    this.stats = data.stats || {};
                }
            } catch (e) {
                console.error('[HomeHub] fetch error', e);
            } finally {
                this.loadingData = false;
            }
        },

        async refreshHomeOverview() {
            await this._fetchData();
        },

        applyHomeData(homeData = {}) {
            if (Array.isArray(homeData.goals)) this.goals = homeData.goals;
            if (Array.isArray(homeData.financeRows)) this.financeRows = homeData.financeRows;
            if (Array.isArray(homeData.shoppingItems)) this.shoppingItems = homeData.shoppingItems;
        },

        homeDataPayload() {
            return {
                goals: this.goals,
                financeRows: this.financeRows,
                shoppingItems: this.shoppingItems
            };
        },

        scheduleHomeDataSave() {
            if (this._homeDataTimer) clearTimeout(this._homeDataTimer);
            this._homeDataTimer = setTimeout(() => this.saveHomeData(), 250);
        },

        async saveHomeData() {
            this._homeDataSaving = true;
            try {
                const res = await fetch(`/account/${_accountNumber}/api/home-overview/widgets`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ homeData: this.homeDataPayload() })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Sauvegarde impossible');
                this.applyHomeData(data.homeData || {});
            } catch (e) {
                console.error('[HomeHub] save home data error', e);
                window.showMessage && window.showMessage(e.message || 'Sauvegarde impossible', 'danger');
            } finally {
                this._homeDataSaving = false;
            }
        },

	        normalizeHomeTask(task = {}) {
	            const id = String(task._id || task.id || '');
	            return {
	                ...task,
	                id,
	                _id: id,
	                title: String(task.title || '').trim() || 'Sans titre',
	                status: task.status || 'À faire',
	                statusColor: task.statusColor || '#9ca3af',
	                priority: task.priority || 'Aucune',
	                priorityColor: task.priorityColor || this.homeTaskPriorityColor(task.priority),
	                taskListId: String(task.taskListId || task.listId || ''),
	                order: Number.isFinite(Number(task.order)) ? Number(task.order) : 0,
	                createdAt: task.createdAt || null,
	                updatedAt: task.updatedAt || null,
		                completedAt: task.completedAt || null,
		                isDayPriority: !!task.isDayPriority,
		                assignedTo: task.assignedTo || '',
		                attachments: Array.isArray(task.attachments) ? task.attachments : []
		            };
		        },

	        normalizeHomeTaskList(list = {}) {
	            const id = String(list.id || list._id || '');
	            return {
	                ...list,
	                id,
	                _id: id,
	                label: String(list.label || 'Liste de tâches').trim(),
		                color: list.color || '#10b981',
		                icon: list.icon || 'solar:checklist-bold-duotone',
		                link: list.link || `/account/${_accountNumber}/tasks`,
		                statuses: Array.isArray(list.statuses) ? list.statuses : [],
		                priorities: Array.isArray(list.priorities) ? list.priorities : [],
		                tasks: Array.isArray(list.tasks) ? list.tasks.map(task => this.normalizeHomeTask({ ...task, taskListId: id })) : [],
		                count: Number(list.count || 0),
	                doneCount: Number(list.doneCount || 0)
	            };
	        },

	        homeTaskListIdForWidget(wid) {
	            if (wid === 'shopping-list') return String(this.customWidgetConfig(wid).taskListId || this.defaultWidgets.shoppingListId || '');
	            return String(this.customWidgetConfig(wid).taskListId || this.customWidgetConfig(wid).listId || '');
	        },

	        homeTaskListForWidget(wid) {
	            const listId = this.homeTaskListIdForWidget(wid);
	            return (this.homeTaskLists || []).find(list => list.id === listId) || null;
	        },

	        homeTaskWidgetItems(wid) {
	            const list = this.homeTaskListForWidget(wid);
	            if (!list) return [];
	            const cfg = this.customWidgetConfig(wid);
	            const showCompleted = cfg.showCompleted !== false;
	            const limit = Math.max(1, Math.min(40, Number(cfg.limit || 8)));
	            return (list.tasks || [])
	                .filter(task => showCompleted || task.status !== 'Terminé')
	                .slice(0, limit);
	        },

	        homeTaskWidgetOpenCount(wid) {
	            const list = this.homeTaskListForWidget(wid);
	            if (!list) return 0;
	            return (list.tasks || []).filter(task => task.status !== 'Terminé').length;
	        },

	        homeTaskWidgetLink(wid) {
	            const list = this.homeTaskListForWidget(wid);
	            return list?.link || `/account/${_accountNumber}/tasks`;
	        },

	        refreshHomeTaskListCounts(list) {
	            if (!list) return;
	            list.count = (list.tasks || []).length;
	            list.doneCount = (list.tasks || []).filter(task => task.status === 'Terminé').length;
	        },

	        newTaskTitleFor(wid) {
	            const value = this.newTaskTitles?.[wid];
	            if (value === undefined || value === null || value === 'undefined') return '';
	            return String(value);
	        },

	        setNewTaskTitle(wid, value) {
	            this.newTaskTitles = {
	                ...(this.newTaskTitles || {}),
	                [wid]: String(value || '')
	            };
	        },

	        homeTaskRenderKey(wid) {
	            return Number(this.homeTaskRenderVersions?.[wid] || 0);
	        },

	        bumpHomeTaskRender(wid) {
	            this.homeTaskRenderVersions = {
	                ...(this.homeTaskRenderVersions || {}),
	                [wid]: this.homeTaskRenderKey(wid) + 1
	            };
	        },

	        savedHomeTaskWidgetConfig(wid) {
	            if (this.isCustomWidget(wid)) return this.getCustomWidget(wid).config || {};
	            return (this.widgetSettings && this.widgetSettings[wid] && this.widgetSettings[wid].config) || {};
	        },

	        setHomeTaskWidgetConfigOption(wid, key, value, save = true) {
	            if (!wid || !key) return;
	            if (this.isCustomWidget(wid)) {
	                const existing = this.getCustomWidget(wid);
	                this.customWidgets = {
	                    ...(this.customWidgets || {}),
	                    [wid]: {
	                        ...existing,
	                        config: {
	                            ...(existing.config || {}),
	                            [key]: value
	                        }
	                    }
	                };
	            } else {
	                const meta = this.getWidgetSettings(wid);
	                const saved = (this.widgetSettings && this.widgetSettings[wid]) || {};
	                this.widgetSettings = {
	                    ...(this.widgetSettings || {}),
	                    [wid]: {
	                        type: saved.type || meta.type || wid,
	                        label: saved.label || meta.label || this.widgetTitle(wid),
	                        icon: saved.icon || meta.icon || this.widgetIcon(wid),
	                        color: saved.color || meta.color || this.widgetColor(wid),
	                        config: {
	                            ...(meta.config || {}),
	                            ...(saved.config || {}),
	                            [key]: value
	                        }
	                    }
	                };
	            }
	            if (save) this._saveLayout();
	        },

		        homeTaskWidgetType(wid) {
		            return this.isCustomWidget(wid) ? this.getCustomWidget(wid).type : (this.getWidgetSettings(wid).type || wid);
		        },

		        homeTaskDisplayOption(wid, key, fallback = true) {
		            const cfg = this.customWidgetConfig(wid);
		            if (Object.prototype.hasOwnProperty.call(cfg, key)) return cfg[key] !== false;
		            const savedCfg = this.savedHomeTaskWidgetConfig(wid);
		            if (Object.prototype.hasOwnProperty.call(savedCfg, key)) return savedCfg[key] !== false;
		            return fallback !== false;
		        },

		        homeTaskPriorityEnabled(wid) {
		            return this.homeTaskDisplayOption(wid, 'showPriority', ['priority-day', 'today-tasks', 'tasks', 'shopping-list', 'task-list'].includes(this.homeTaskWidgetType(wid)));
		        },

		        homeTaskAttachmentsEnabled(wid) {
		            return this.homeTaskDisplayOption(wid, 'showAttachments', ['priority-day', 'today-tasks', 'tasks', 'shopping-list', 'task-list'].includes(this.homeTaskWidgetType(wid)));
		        },

		        homeTaskRecordEnabled(wid) {
		            return this.homeTaskDisplayOption(wid, 'showRecord', !['shopping-list'].includes(String(wid)));
		        },

		        homeTaskListEnabled(wid) {
		            return this.homeTaskDisplayOption(wid, 'showList', ['priority-day', 'today-tasks', 'tasks', 'shopping-list', 'task-list'].includes(this.homeTaskWidgetType(wid)));
		        },

		        homeTaskAccentStyleEnabled(wid) {
		            return this.homeTaskDisplayOption(wid, 'accentStyle', false);
		        },

		        taskHasAttachments(task = {}) {
		            return Array.isArray(task.attachments) && task.attachments.length > 0;
		        },

		        taskHasReminder(task = {}) {
		            const raw = task?.reminder?.scheduledAt;
		            if (!raw) return false;
		            const date = new Date(raw);
		            return !Number.isNaN(date.getTime());
		        },

		        taskReminderLabel(task = {}) {
		            if (!this.taskHasReminder(task)) return 'Rappel';
		            const date = new Date(task.reminder.scheduledAt);
		            return 'Rappel ' + date.toLocaleString('fr-FR', {
		                day: '2-digit',
		                month: 'short',
		                hour: '2-digit',
		                minute: '2-digit'
		            }).replace('.', '');
		        },

		        homeTaskRowMetaEnabled(wid, task = {}) {
		            return this.homeTaskPriorityEnabled(wid);
		        },

		        homeTaskPriorityVisible(wid, task = {}) {
	            if (!this.homeTaskPriorityEnabled(wid)) return false;
	            const label = this.homeTaskPriorityLabel(task.priority);
	            return !!label && label !== 'Aucune';
	        },

	        homeTaskPriorityLabel(priority) {
	            return String(priority || 'Aucune').trim() || 'Aucune';
	        },

	        normalizeHomeTaskOptions(options = [], fallback = this.homeTaskPriorityChoices) {
	            const source = Array.isArray(options) && options.length ? options : fallback;
	            const seen = new Set();
	            return source
	                .map((option, index) => ({
	                    label: this.homeTaskPriorityLabel(option?.label || option),
	                    color: option?.color || fallback[index]?.color || '#94a3b8',
	                    order: Number.isFinite(Number(option?.order)) ? Number(option.order) : index
	                }))
	                .filter(option => {
	                    if (!option.label || seen.has(option.label.toLowerCase())) return false;
	                    seen.add(option.label.toLowerCase());
	                    return true;
	                })
	                .sort((a, b) => a.order - b.order);
	        },

	        homeTaskPriorityOptionsForList(list = null) {
	            const options = this.normalizeHomeTaskOptions(list?.priorities, this.homeTaskPriorityChoices);
	            if (!options.some(option => option.label === 'Aucune')) {
	                return [{ label: 'Aucune', color: '#94a3b8', order: -1 }, ...options];
	            }
	            return options;
	        },

	        homeTaskPriorityMenuOptions() {
	            const ctx = this.homeTaskMenu || {};
	            const found = this.findHomeTask(ctx.taskId);
	            const list = found?.list || this.homeTaskListForWidget(ctx.wid);
	            return this.homeTaskPriorityOptionsForList(list);
	        },

	        homeTaskPriorityColor(priority, task = null) {
	            if (task?.priorityColor) return task.priorityColor;
	            const label = this.homeTaskPriorityLabel(priority);
	            const found = (this.homeTaskPriorityOptionsForList(this.findHomeTask(this.homeTaskId(task || {}))?.list) || [])
	                .find(item => item.label === label);
	            return found?.color || '#94a3b8';
	        },

	        homeTaskId(task = {}) {
	            return String(task._id || task.id || '');
	        },

	        findHomeTask(taskId) {
	            const id = String(taskId || '');
	            if (!id) return null;
	            for (const list of this.homeTaskLists || []) {
	                const task = (list.tasks || []).find(item => this.homeTaskId(item) === id);
	                if (task) return { list, task };
	            }
	            // Also search hub-level task arrays
		            const hubTask = (this.todayTasks || []).find(t => this.homeTaskId(t) === id)
		                || (this.allTasks || []).find(t => this.homeTaskId(t) === id);
		            if (hubTask) {
		                const listId = String(hubTask.taskListId || hubTask.listId || '');
		                const list = (this.homeTaskLists || []).find(item => String(item.id || item._id || '') === listId) || null;
		                return { list, task: hubTask };
		            }
		            return null;
		        },

	        patchHomeTaskEverywhere(taskId, patch = {}) {
	            const id = String(taskId || '');
	            if (!id) return;
	            ['allTasks', 'todayTasks'].forEach(key => {
	                this[key] = (this[key] || []).map(task => {
	                    if (this.homeTaskId(task) !== id) return task;
	                    return this.normalizeHomeTask({ ...task, ...patch });
	                });
	            });
	            this.completedTodayData = (this.completedTodayData || []).map(task => {
	                if (this.homeTaskId(task) !== id) return task;
	                return this.normalizeHomeTask({ ...task, ...patch });
	            });
	            this.homeTaskLists = (this.homeTaskLists || []).map(list => {
	                let touched = false;
	                const tasks = (list.tasks || []).map(task => {
	                    if (this.homeTaskId(task) !== id) return task;
	                    touched = true;
	                    return this.normalizeHomeTask({ ...task, ...patch, taskListId: task.taskListId || list.id });
	                });
	                if (!touched) return list;
	                const nextList = { ...list, tasks };
	                this.refreshHomeTaskListCounts(nextList);
	                return nextList;
	            });
	            this.bumpImpactedHomeTaskWidgets();
	        },

	        syncCompletedTodayData(taskId, task = null) {
	            const id = String(taskId || '');
	            if (!id) return;
	            const source = task || this.findHomeTask(id)?.task || null;
	            if (source?.status === 'Terminé') {
	                const completedAt = source.completedAt || new Date().toISOString();
	                const normalized = this.normalizeHomeTask({ ...source, completedAt });
	                this.completedTodayData = [
	                    ...(this.completedTodayData || []).filter(item => this.homeTaskId(item) !== id),
	                    normalized
	                ];
	            } else {
	                this.completedTodayData = (this.completedTodayData || []).filter(item => this.homeTaskId(item) !== id);
	            }
	        },

	        bumpImpactedHomeTaskWidgets() {
	            const ids = new Set(['priority-day', 'today-tasks', 'tasks', 'shopping-list']);
	            Object.entries(this.customWidgets || {}).forEach(([id, widget]) => {
	                if (['task-list', 'tasks', 'shopping-list'].includes(String(widget?.type || ''))) ids.add(id);
	            });
	            ids.forEach(id => this.bumpHomeTaskRender(id));
	        },

	        removeHomeTaskEverywhere(taskId) {
	            const id = String(taskId || '');
	            if (!id) return;
	            this.allTasks = (this.allTasks || []).filter(task => this.homeTaskId(task) !== id);
	            this.todayTasks = (this.todayTasks || []).filter(task => this.homeTaskId(task) !== id);
	            this.completedTodayData = (this.completedTodayData || []).filter(task => this.homeTaskId(task) !== id);
	            this.homeTaskLists = (this.homeTaskLists || []).map(list => {
	                const nextTasks = (list.tasks || []).filter(task => this.homeTaskId(task) !== id);
	                if (nextTasks.length === (list.tasks || []).length) return list;
	                const nextList = { ...list, tasks: nextTasks };
	                this.refreshHomeTaskListCounts(nextList);
	                return nextList;
	            });
	            this.bumpImpactedHomeTaskWidgets();
	        },

	        replaceHomeTaskList(listId, patch = {}) {
	            const id = String(listId || '');
	            if (!id) return;
	            this.homeTaskLists = (this.homeTaskLists || []).map(list => {
	                if (String(list.id || list._id || '') !== id) return list;
	                return { ...list, ...patch };
	            });
	        },

	        closeHomeTaskMenu() {
	            this.homeTaskMenu = null;
	        },

	        openHomeTaskMenu(event, wid, task, options = {}) {
	            if (!task || !this.homeTaskId(task)) return;
	            const width = 240;
	            const height = options.priorityOnly ? 126 : 260;
	            const source = event?.currentTarget || event?.target;
	            const rect = source?.getBoundingClientRect?.();
	            const rawX = event?.clientX || (rect ? rect.right : 0);
	            const rawY = event?.clientY || (rect ? rect.bottom : 0);
	            const x = Math.max(8, Math.min(rawX, window.innerWidth - width - 8));
	            const y = Math.max(8, Math.min(rawY, window.innerHeight - height - 8));
	            this.homeTaskMenu = { x, y, wid, taskId: this.homeTaskId(task), priorityOnly: options.priorityOnly === true };
	        },

	        openHomeTaskPriorityMenu(event, wid, task) {
	            this.openHomeTaskMenu(event, wid, task, { priorityOnly: true });
	        },

	        editHomeTaskFromMenu() {
	            const ctx = this.homeTaskMenu;
	            const found = this.findHomeTask(ctx?.taskId);
	            if (!ctx || !found) return;
	            this.closeHomeTaskMenu();
	            this.openHomeTaskModal(ctx.wid, found.task);
	        },

	        openHomeTaskModal(wid, task) {
	            if (!task || !task._id) return;
	            this.closeHomeTaskMenu();
	            const list = this.homeTaskListForWidget(wid);
	            const taskObj = {
	                ...task,
	                _id: task._id || task.id,
	                listLabel: task.listLabel || list?.label || task.recordTitle || 'Tâches du jour',
	                listIcon: task.listIcon || list?.icon || this.widgetIcon(wid, 'solar:checklist-bold-duotone')
	            };
	            Alpine.store('taskModal').open(taskObj, {
		                onUpdate: (taskId, field, value, updatedTask = null) => {
			                    const id = String(taskId || '');
			                    const found = this.findHomeTask(id);
			                    if (!id || !found) return;
			                    if (['priorities', 'statuses'].includes(field)) {
			                        if (updatedTask) {
			                            this.patchHomeTaskEverywhere(id, this.normalizeHomeTask({ ...found.task, ...updatedTask }));
			                        }
			                        this.refreshHomeOverview();
			                        return;
			                    }
			                    const patch = this.normalizeHomeTask({
		                        ...found.task,
		                        ...(updatedTask || {}),
		                        [field]: value
		                    });
		                    if (field === 'status') {
		                        const statusColors = {
		                            'À faire': '#9ca3af',
		                            'En cours': '#3b82f6',
		                            'En revue': '#f59e0b',
		                            'Terminé': '#22c55e',
		                            'Bloqué': '#ef4444'
		                        };
		                        patch.status = value || patch.status;
		                        patch.statusColor = updatedTask?.statusColor || statusColors[patch.status] || '#9ca3af';
		                        patch.completedAt = patch.status === 'Terminé' ? (patch.completedAt || new Date().toISOString()) : null;
		                    }
			                    if (field === 'priority') {
			                        patch.priority = this.homeTaskPriorityLabel(value);
			                        patch.priorityColor = updatedTask?.priorityColor || this.homeTaskPriorityColor(patch.priority, patch);
			                    }
		                    if (field === 'isDayPriority') {
		                        patch.isDayPriority = value === true;
		                    }
		                    this.patchHomeTaskEverywhere(id, patch);
		                    const syncedTask = this.findHomeTask(id)?.task || patch;
		                    if (syncedTask.isDayPriority && !(this.todayTasks || []).some(item => this.homeTaskId(item) === id)) {
		                        this.todayTasks = [...(this.todayTasks || []), this.normalizeHomeTask(syncedTask)];
		                    }
		                    if (field === 'status') this.syncCompletedTodayData(id, syncedTask);
		                    if (field === 'isDayPriority') {
		                        if (!patch.isDayPriority && !syncedTask.listIsToday) {
		                            this.todayTasks = (this.todayTasks || []).filter(item => this.homeTaskId(item) !== id);
		                        }
		                    }
		                    this.bumpImpactedHomeTaskWidgets();
		                },
	                onDelete: () => {
	                    this.refreshHomeOverview();
	                }
	            });
	        },


	        async deleteHomeTaskFromMenu() {
	            const ctx = this.homeTaskMenu;
	            const found = this.findHomeTask(ctx?.taskId);
	            this.closeHomeTaskMenu();
	            if (!ctx || !found) return;
	            await this.deleteHomeTaskItem(ctx.wid, found.task);
	        },

	        async setHomeTaskPriorityFromMenu(priority) {
	            const ctx = this.homeTaskMenu;
	            const found = this.findHomeTask(ctx?.taskId);
	            if (!ctx || !found) return;
	            const label = this.homeTaskPriorityLabel(priority?.label || priority);
	            this.closeHomeTaskMenu();
	            this.setHomeTaskWidgetConfigOption(ctx.wid, 'showPriority', true, false);
	            await this.updateHomeTaskItem(ctx.wid, found.task, { priority: label });
	            this.bumpHomeTaskRender(ctx.wid);
	            this._saveLayout();
	        },

	        isTaskDayPriority(taskId) {
	            if (!taskId) return false;
	            const found = this.findHomeTask(taskId);
	            return !!found?.task?.isDayPriority;
	        },

	        async addToDayPriorityFromMenu() {
	            const ctx = this.homeTaskMenu;
	            const found = this.findHomeTask(ctx?.taskId);
	            if (!ctx || !found) return;
	            this.closeHomeTaskMenu();
	            await this.updateHomeTaskItem(ctx.wid, found.task, { isDayPriority: true });
	            // Also add to todayTasks for immediate UI
	            const id = this.homeTaskId(found.task);
	            if (!this.todayTasks.find(t => (t._id || t.id) === id)) {
	                this.todayTasks = [...this.todayTasks, found.task];
	            }
	            this.bumpHomeTaskRender('priority-day');
	            this.bumpHomeTaskRender('today-tasks');
	        },

	        async removeFromDayPriorityFromMenu() {
	            const ctx = this.homeTaskMenu;
	            const found = this.findHomeTask(ctx?.taskId);
	            if (!ctx || !found) return;
	            this.closeHomeTaskMenu();
	            await this.updateHomeTaskItem(ctx.wid, found.task, { isDayPriority: false });
	            this.bumpHomeTaskRender('priority-day');
	            this.bumpHomeTaskRender('today-tasks');
	        },

	        async toggleDayPriorityFromMenu() {
	            const ctx = this.homeTaskMenu;
	            const found = this.findHomeTask(ctx?.taskId);
	            if (!ctx || !found) return;
	            const nextValue = !found.task?.isDayPriority;
	            this.closeHomeTaskMenu();
	            const updated = await this.updateHomeTaskItem(ctx.wid, found.task, { isDayPriority: nextValue });
	            if (!updated) return;
	            const id = this.homeTaskId(found.task);
	            if (nextValue && !this.todayTasks.find(t => this.homeTaskId(t) === id)) {
	                this.todayTasks = [...(this.todayTasks || []), this.normalizeHomeTask(found.task)];
	            }
	            if (!nextValue && !found.task?.listIsToday) {
	                this.todayTasks = (this.todayTasks || []).filter(t => this.homeTaskId(t) !== id);
	            }
	            this.bumpImpactedHomeTaskWidgets();
	        },

	        startEditHomeTask(wid, task) {
	            const id = this.homeTaskId(task);
	            if (!id) return;
	            this.closeHomeTaskMenu();
	            this.editingHomeTaskId = id;
	            this.editingHomeTaskWidgetId = wid;
	            this.editingHomeTaskTitle = task.title || '';
	            this.$nextTick(() => {
	                const input = Array.from(this.$el?.querySelectorAll?.('.dx-task-edit') || [])
	                    .find(el => String(el.dataset.taskId || '') === id);
	                if (input) {
	                    input.focus();
	                    input.select();
	                }
	            });
	        },

	        cancelEditHomeTask() {
	            this.editingHomeTaskId = '';
	            this.editingHomeTaskWidgetId = '';
	            this.editingHomeTaskTitle = '';
	        },

	        async saveEditHomeTask(wid, task) {
	            const id = this.homeTaskId(task);
	            if (!id || this.editingHomeTaskId !== id) return;
	            const title = String(this.editingHomeTaskTitle || '').trim();
	            if (!title) {
	                this.cancelEditHomeTask();
	                return;
	            }
	            if (title === task.title) {
	                this.cancelEditHomeTask();
	                return;
	            }
	            this.cancelEditHomeTask();
	            await this.updateHomeTaskItem(wid, task, { title });
	        },

	        async updateHomeTaskItem(wid, task, updates = {}) {
	            const id = this.homeTaskId(task);
	            if (!id || !updates || typeof updates !== 'object') return false;
	            const previous = { ...task };
	            Object.assign(task, updates);
		            if (updates.priority !== undefined) {
		                task.priority = this.homeTaskPriorityLabel(updates.priority);
		                task.priorityColor = this.homeTaskPriorityColor(task.priority, task);
		            }
	            try {
	                const res = await fetch(`/account/${_accountNumber}/api/record-tasks/${id}`, {
	                    method: 'PUT',
	                    headers: { 'Content-Type': 'application/json' },
	                    credentials: 'include',
	                    body: JSON.stringify(updates)
	                });
	                const data = await res.json().catch(() => ({}));
	                if (!res.ok || data.success === false || !data.task) throw new Error(data.error || 'Modification impossible');
	                const normalized = this.normalizeHomeTask({ ...data.task, taskListId: data.task.taskListId || task.taskListId });
	                Object.assign(task, normalized);
	                this.patchHomeTaskEverywhere(id, normalized);
	                const list = this.homeTaskListForWidget(wid) || this.findHomeTask(id)?.list;
	                this.refreshHomeTaskListCounts(list);
	                return true;
	            } catch (e) {
	                Object.assign(task, previous);
	                window.showMessage && window.showMessage(e.message || 'Modification impossible', 'danger');
	                return false;
	            }
	        },

	        async deleteHomeTaskItem(wid, task) {
	            const id = this.homeTaskId(task);
	            if (!id) return;
	            const found = this.findHomeTask(id);
	            const list = found?.list || this.homeTaskListForWidget(wid);
	            const previousAllTasks = [...(this.allTasks || [])];
	            const previousTodayTasks = [...(this.todayTasks || [])];
	            let previousListTasks = null;
	            if (list) {
	                previousListTasks = [...(list.tasks || [])];
	                list.tasks = previousListTasks.filter(item => this.homeTaskId(item) !== id);
	                this.refreshHomeTaskListCounts(list);
	            }
	            this.removeHomeTaskEverywhere(id);
	            this.bumpHomeTaskRender(wid);
	            try {
	                const res = await fetch(`/account/${_accountNumber}/api/record-tasks/${id}`, {
	                    method: 'DELETE',
	                    credentials: 'include'
	                });
	                const data = await res.json().catch(() => ({}));
	                if (!res.ok || data.success === false) throw new Error(data.error || 'Suppression impossible');
	                this.$nextTick(() => this.refreshHomeTaskSortables());
	            } catch (e) {
	                if (list && previousListTasks) {
	                    list.tasks = previousListTasks;
	                    this.refreshHomeTaskListCounts(list);
	                }
	                this.allTasks = previousAllTasks;
	                this.todayTasks = previousTodayTasks;
	                this.bumpHomeTaskRender(wid);
	                window.showMessage && window.showMessage(e.message || 'Suppression impossible', 'danger');
	            }
	        },

	        initHomeTaskSortable(el, wid) {
	            if (!el || typeof Sortable === 'undefined') return;
	            if (el._homeTaskSortable) {
	                try { el._homeTaskSortable.destroy(); } catch (e) {}
	            }
	            el._homeTaskSortable = Sortable.create(el, {
	                animation: 150,
	                handle: '.dx-task-drag',
	                draggable: '.dx-task-row',
	                ghostClass: 'dx-task-ghost',
		                filter: '.dx-check, .dx-task-priority, .dx-task-attachment-badge, .dx-task-subtitle-attachment, .dx-task-menu-btn, .dx-task-edit, .dx-inline-add, .dx-shopping-foot, .ov-custom-empty',
	                preventOnFilter: false,
	                onEnd: (evt) => this.reorderHomeTaskWidgetFromDom(evt, wid)
	            });
	            this._taskSortables.set(el, el._homeTaskSortable);
	        },

	        refreshHomeTaskSortables() {
	            this.$nextTick(() => {
	                this.$el?.querySelectorAll?.('.dx-shopping-list[data-task-widget-id]').forEach(el => {
	                    this.initHomeTaskSortable(el, el.dataset.taskWidgetId);
	                });
	            });
	        },

	        syncHomeTaskDomOrder(wid, tasks = []) {
	            const containers = this.$el?.querySelectorAll?.(`.dx-shopping-list[data-task-widget-id="${wid}"]`) || [];
	            containers.forEach(container => {
	                const rowsById = new Map(
	                    Array.from(container.querySelectorAll(':scope > .dx-task-row'))
	                        .map(row => [String(row.dataset.taskId || ''), row])
	                        .filter(([id]) => id)
	                );
	                const anchor = container.querySelector(':scope > .dx-inline-add')
	                    || container.querySelector(':scope > .dx-shopping-foot')
	                    || null;
	                tasks.forEach(task => {
	                    const row = rowsById.get(this.homeTaskId(task));
	                    if (row) container.insertBefore(row, anchor);
	                });
	            });
	        },

        revertHomeTaskSortableDom(evt) {
            const container = evt?.from;
            const item = evt?.item;
            if (!container || !item) return;
            const siblings = Array.from(container.querySelectorAll(':scope > .dx-task-row'))
	                .filter(row => row !== item);
	            const oldIndex = Number.isInteger(evt.oldDraggableIndex) ? evt.oldDraggableIndex : evt.oldIndex;
                const ref = Number.isInteger(oldIndex) ? (siblings[oldIndex] || null) : null;
                container.insertBefore(item, ref);
            },

        reorderHomeTaskCollection(source = [], orderedIds = [], orderedTasksById = new Map(), orderMap = new Map()) {
            const sourceTasks = Array.isArray(source) ? source : [];
            if (!sourceTasks.length || !orderedIds.length) return sourceTasks;
            const sourceById = new Map();
            sourceTasks.forEach(task => {
                const id = this.homeTaskId(task);
                if (id && !sourceById.has(id)) sourceById.set(id, task);
            });
            const seenIds = new Set();
            const normalizedOrderedIds = [];
            orderedIds.forEach(rawId => {
                const id = String(rawId || '');
                const replacement = sourceById.get(id);
                if (!id || seenIds.has(id) || !replacement) return;
                seenIds.add(id);
                if (orderedTasksById.get(id) === undefined) {
                    orderedTasksById.set(id, replacement);
                }
                normalizedOrderedIds.push(id);
            });
            if (!normalizedOrderedIds.length) return sourceTasks;
            const orderedTaskIds = new Set(normalizedOrderedIds);

            let cursor = 0;
            return sourceTasks.map(task => {
                const id = this.homeTaskId(task);
                if (!orderedTaskIds.has(id)) return task;
                const nextId = normalizedOrderedIds[cursor++] || id;
                const replacement = orderedTasksById.get(nextId);
                if (!replacement) return task;
                const nextOrder = orderMap && orderMap.has(nextId) ? orderMap.get(nextId) : cursor - 1;
                return this.normalizeHomeTask({ ...task, ...replacement, order: nextOrder });
            });
        },

        async reorderDayTaskWidget(orderedIds, wid) {
            const taskSources = [
                ...(this.todayTasks || []),
                ...(this.allTasks || []),
                ...(this.completedTodayData || []),
                ...((this.homeTaskLists || []).flatMap(list => list.tasks || []))
            ];
            const sourceById = new Map();
            taskSources.forEach(task => {
                const id = this.homeTaskId(task);
                if (id && !sourceById.has(id)) sourceById.set(id, task);
            });
            const orderedTasks = orderedIds.map(id => sourceById.get(id)).filter(Boolean);
            const normalizedOrderedIds = orderedTasks.map(task => this.homeTaskId(task));
            if (!normalizedOrderedIds.length) return;

            const previousAllTasks = [...(this.allTasks || [])];
            const previousTodayTasks = [...(this.todayTasks || [])];
            const previousCompletedTodayData = [...(this.completedTodayData || [])];
            const previousHomeTaskLists = (this.homeTaskLists || []).map(list => ({
                ...list,
                tasks: [...(list.tasks || [])]
            }));
            const orderedTasksById = new Map(orderedTasks.map(task => [this.homeTaskId(task), task]));
            const orderMap = new Map(normalizedOrderedIds.map((id, index) => [id, index]));

            this.todayTasks = this.reorderHomeTaskCollection(this.todayTasks, normalizedOrderedIds, orderedTasksById, orderMap);
            this.allTasks = this.reorderHomeTaskCollection(this.allTasks, normalizedOrderedIds, orderedTasksById, orderMap);
            this.completedTodayData = this.reorderHomeTaskCollection(this.completedTodayData, normalizedOrderedIds, orderedTasksById, orderMap);
            this.homeTaskLists = (this.homeTaskLists || []).map(list => {
                const tasks = this.reorderHomeTaskCollection(list.tasks, normalizedOrderedIds, orderedTasksById, orderMap);
                if (tasks === list.tasks) return list;
                const nextList = { ...list, tasks };
                this.refreshHomeTaskListCounts(nextList);
                return nextList;
            });
	            this.bumpHomeTaskRender(wid);
	            this.$nextTick(() => {
	                this.syncHomeTaskDomOrder(wid, orderedTasks);
	                this.refreshHomeTaskSortables();
	            });

	            try {
                const res = await fetch(`/account/${_accountNumber}/api/tasks-hub/reorder`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ taskIds: normalizedOrderedIds })
                });
	                const data = await res.json().catch(() => ({}));
	                if (!res.ok || data.success === false) throw new Error(data.error || 'Réorganisation impossible');
	            } catch (e) {
	                this.allTasks = previousAllTasks;
	                this.todayTasks = previousTodayTasks;
	                this.completedTodayData = previousCompletedTodayData;
	                this.homeTaskLists = previousHomeTaskLists;
	                this.bumpHomeTaskRender(wid);
	                this.$nextTick(() => {
	                    this.syncHomeTaskDomOrder(wid, orderedTasks);
	                    this.refreshHomeTaskSortables();
	                });
	                window.showMessage && window.showMessage(e.message || 'Réorganisation impossible', 'danger');
	            }
	        },

	        async reorderHomeTaskWidgetFromDom(evt, wid) {
	            const el = evt?.to || evt?.from;
	            const list = this.homeTaskListForWidget(wid);
            if (!el) return;
            const movedId = String(evt?.item?.dataset?.taskId || '');
            const orderedIds = Array.from(el.querySelectorAll(':scope > .dx-task-row'))
                .map(row => String(row.dataset.taskId || ''))
                .filter(Boolean);
            this.revertHomeTaskSortableDom(evt);
            if (!movedId || orderedIds.length < 2) return;
            if (!list?.id) {
                await this.reorderDayTaskWidget(orderedIds, wid);
                return;
            }
            const byId = new Map((list.tasks || []).map(task => [this.homeTaskId(task), task]));
            const orderedTasksById = new Map(orderedIds.map(id => [id, byId.get(id)]).filter(([, task]) => !!task));
            const orderMap = new Map(orderedIds.map((id, index) => [id, index]));
            const previousTasks = [...(list.tasks || [])];
            const nextTasks = this.reorderHomeTaskCollection(previousTasks, orderedIds, orderedTasksById, orderMap);
            list.tasks = nextTasks;
            this.replaceHomeTaskList(list.id, { tasks: nextTasks });
            this.bumpHomeTaskRender(wid);
	            this.$nextTick(() => {
	                this.syncHomeTaskDomOrder(wid, nextTasks);
	                this.refreshHomeTaskSortables();
	            });
	            try {
	                const res = await fetch(`/account/${_accountNumber}/api/task-lists/${list.id}/reorder`, {
	                    method: 'POST',
	                    headers: { 'Content-Type': 'application/json' },
	                    credentials: 'include',
	                    body: JSON.stringify({ taskIds: nextTasks.map(task => this.homeTaskId(task)).filter(Boolean) })
	                });
	                const data = await res.json().catch(() => ({}));
	                if (!res.ok || data.success === false) throw new Error(data.error || 'Réorganisation impossible');
	            } catch (e) {
	                list.tasks = previousTasks;
	                this.replaceHomeTaskList(list.id, { tasks: previousTasks });
	                this.bumpHomeTaskRender(wid);
	                this.$nextTick(() => {
	                    this.syncHomeTaskDomOrder(wid, previousTasks);
	                    this.refreshHomeTaskSortables();
	                });
	                window.showMessage && window.showMessage(e.message || 'Réorganisation impossible', 'danger');
	            }
	        },

	        async toggleHomeTaskItem(wid, task) {
	            const id = this.homeTaskId(task);
	            if (!id) return;
	            const list = this.homeTaskListForWidget(wid);
	            const previousStatus = task.status;
	            const previousColor = task.statusColor;
	            const previousCompletedAt = task.completedAt;
	            const nextStatus = previousStatus === 'Terminé' ? 'À faire' : 'Terminé';
	            task.status = nextStatus;
	            task.statusColor = nextStatus === 'Terminé' ? '#22c55e' : '#9ca3af';
	            task.completedAt = nextStatus === 'Terminé' ? new Date().toISOString() : null;
	            this.patchHomeTaskEverywhere(id, { status: task.status, statusColor: task.statusColor, completedAt: task.completedAt });
	            if (task.isDayPriority && !(this.todayTasks || []).some(item => this.homeTaskId(item) === id)) {
	                this.todayTasks = [...(this.todayTasks || []), this.normalizeHomeTask(task)];
	            }
	            this.syncCompletedTodayData(id, task);
	            this.refreshHomeTaskListCounts(list);
	            try {
	                const res = await fetch(`/account/${_accountNumber}/api/record-tasks/${id}/status`, {
	                    method: 'POST',
	                    headers: { 'Content-Type': 'application/json' },
	                    credentials: 'include',
	                    body: JSON.stringify({ status: nextStatus })
	                });
	                const data = await res.json().catch(() => ({}));
		                if (!res.ok || data.success === false) throw new Error(data.error || 'Mise à jour impossible');
		                task.status = data.status || nextStatus;
		                task.statusColor = data.statusColor || task.statusColor;
		                task.completedAt = task.status === 'Terminé' ? (data.completedAt || task.completedAt || new Date().toISOString()) : null;
		                this.patchHomeTaskEverywhere(id, { status: task.status, statusColor: task.statusColor, completedAt: task.completedAt });
		                if (task.isDayPriority && !(this.todayTasks || []).some(item => this.homeTaskId(item) === id)) {
		                    this.todayTasks = [...(this.todayTasks || []), this.normalizeHomeTask(task)];
		                }
		                this.syncCompletedTodayData(id, task);
	                this.refreshHomeTaskListCounts(list);
	            } catch (e) {
	                task.status = previousStatus;
	                task.statusColor = previousColor;
	                task.completedAt = previousCompletedAt;
	                this.patchHomeTaskEverywhere(id, { status: previousStatus, statusColor: previousColor, completedAt: previousCompletedAt });
	                this.syncCompletedTodayData(id, task);
	                this.refreshHomeTaskListCounts(list);
	                window.showMessage && window.showMessage(e.message || 'Mise à jour impossible', 'danger');
	            }
	        },

	        async addHomeTaskItem(wid) {
