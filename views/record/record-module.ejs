                        </div>
                        <div class="rm-item-body">
                            <div class="rm-item-title" x-text="doc.originalName || doc.generatedFromName || 'Document'"></div>
                            <div class="rm-item-date">
                                <iconify-icon icon="solar:calendar-linear" width="12"></iconify-icon>
                                <span x-text="formatDate(doc.uploadedAt)"></span>
                                <span x-show="doc.generatedFromName" style="margin-left:6px; color:#94a3b8;">·</span>
                                <span x-show="doc.generatedFromName" x-text="doc.generatedFromName" style="color:#f59e0b; font-weight:500;"></span>
                            </div>
                        </div>
                        <span class="rm-item-badge" style="background:#10b98115;color:#10b981">Généré</span>
                        <a :href="'/account/' + _accountNumber + '/uploads/attachments/' + doc.filename" 
