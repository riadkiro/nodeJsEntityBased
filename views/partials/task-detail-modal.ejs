	        },

	        optionMeta(kind) {
	            if (kind === 'tag') {
	                return { optionsKey: 'tagOptions', searchKey: 'tag', field: 'tags', endpoint: 'tags', payload: 'tags', fallbackColor: '#6366f1', multi: true };
	            }
	            return kind === 'priority'
	                ? { optionsKey: 'priorityOptions', searchKey: 'priority', field: 'priority', colorField: 'priorityColor', endpoint: 'priorities', payload: 'priorities', fallbackColor: '#cbd5e1' }
	                : { optionsKey: 'statusOptions', searchKey: 'status', field: 'status', colorField: 'statusColor', endpoint: 'statuses', payload: 'statuses', fallbackColor: '#9ca3af' };
