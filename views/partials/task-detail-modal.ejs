	            return window.DexRichTextEditor ? window.DexRichTextEditor.plainToHtml(value) : this.escapeHtml(value);
	        },

	        normalizeDescriptionHtml(value = '') {
	            return window.DexRichTextEditor ? window.DexRichTextEditor.normalizeHtml(value) : this.plainDescriptionToHtml(value);
