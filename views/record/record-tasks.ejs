<div class="animate__animated p-6" :class="[$store.app.animation]">
    <!-- DataGrid React Island for Tasks -->
    <div 
        data-island="data-grid"
        data-account-number="<%= account_number %>"
        data-grid-id="tasks-list"
        data-data-url="/account/<%= account_number %>/api/datagrid/tasks"
        data-title="Tâches"
        data-icon="solar:checklist-minimalistic-bold-duotone"
        data-add-url="/account/<%= account_number %>/record/taches/add"
        data-add-label="Nouvelle tâche"
        data-density="comfortable"
        data-page-size="25"
        style="min-height: 500px;"
    ></div>
    <script src="/dist/dataGrid.js" type="module"></script>
</div>
