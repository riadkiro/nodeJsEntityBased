          <!-- POPUP MENU -->
          <div x-show="$store.sidebar.showMenu" @click.outside="$store.sidebar.showMenu = false" x-transition
            @click.stop style="min-width: 298px; margin-left: 298px; top: 56px; height: 100%"
            class="sidebar bg-white dark:bg-[#0e1726] px-2 fixed mt-2 w-60 z-[100] col-span-1 shadow-[5px_0_25px_0_rgba(94,92,154,0.1)] transition-all duration-300 border-l dark:border-gray-800">

            <!-- Mode MAIN -->
            <template x-if="menuMode === 'main'">
              <div>
                <h2
                  class="-mx-2 mb-1 flex items-center bg-white-light/30 py-3 px-2 font-extrabold uppercase dark:bg-dark dark:bg-opacity-[0.08]">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:add-square-linear" class="ml-2" width="18" height="18"></iconify-icon>
                    <span>Créer</span>
                  </div>
                </h2>
                <ul class="space-y-1 text-sm text-gray-800 pt-2 dark:text-gray-200">
                  <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                    @click="createItem('folder')">
                    <div class="flex items-center gap-2">
                      <iconify-icon icon="solar:folder-2-bold-duotone" class="ml-2" width="18"
                        height="18"></iconify-icon>
                      <span>Dossier</span>
                    </div>
                  </li>
                  <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                    @click="createItem('environment')">
                    <div class="flex items-center gap-2">
                      <iconify-icon icon="solar:layers-minimalistic-line-duotone" class="ml-2" width="18"
                        height="18"></iconify-icon>
                      <span>Environnement</span>
                    </div>
                  </li>

                  <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                    @click="menuMode = 'data'">
                    <div class="flex items-center justify-between w-full">
                      <div class="flex items-center gap-2">
                        <iconify-icon icon="solar:database-bold" class="ml-2" width="18" height="18"></iconify-icon>
                        <span>Collection</span>
                      </div>
                      <iconify-icon icon="solar:alt-arrow-right-linear" width="16"></iconify-icon>
                    </div>
                  </li>

                  <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                    @click="menuMode = 'data'; pendingViewType = 'list'">
                    <div class="flex items-center justify-between w-full">
                      <div class="flex items-center gap-2">
                        <iconify-icon icon="solar:list-bold" class="ml-2" width="18" height="18"></iconify-icon>
                        <span>Liste</span>
                      </div>
                      <iconify-icon icon="solar:alt-arrow-right-linear" width="16"></iconify-icon>
                    </div>
                  </li>

                  <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                    @click="menuMode = 'data'; pendingViewType = 'kanban'">
                    <div class="flex items-center justify-between w-full">
                      <div class="flex items-center gap-2">
                        <iconify-icon icon="solar:filter-bold-duotone" class="ml-2" width="18"
                          height="18"></iconify-icon>
                        <span>Kanban</span>
                      </div>
                      <iconify-icon icon="solar:alt-arrow-right-linear" width="16"></iconify-icon>
                    </div>
                  </li>

                  <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                    @click="menuMode = 'data'; pendingViewType = 'checklist'">
                    <div class="flex items-center justify-between w-full">
                      <div class="flex items-center gap-2">
                        <iconify-icon icon="solar:checklist-bold" class="ml-2" width="18" height="18"></iconify-icon>
                        <span>Checklist</span>
                      </div>
                      <iconify-icon icon="solar:alt-arrow-right-linear" width="16"></iconify-icon>
                    </div>
                  </li>

                  <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors">
                    <div class="flex items-center gap-2">
                      <iconify-icon icon="solar:pie-chart-3-line-duotone" class="ml-2" width="18"
                        height="18"></iconify-icon>
                      <span>Tableau de bord</span>
                    </div>
                  </li>
                </ul>
              </div>
            </template>

            <!-- Mode DATA -->
            <template x-if="menuMode === 'data'">
              <div>
                <h2
                  class="-mx-2 mb-1 flex items-center bg-white-light/30 py-3 px-1 font-extrabold uppercase dark:bg-dark dark:bg-opacity-[0.08]">
                  <button @click="menuMode = 'main'" class="mr-2 hover:text-primary transition-colors">
                    <iconify-icon icon="solar:alt-arrow-left-linear" width="18" class="mt-1"></iconify-icon>
                  </button>
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:database-bold" width="18" height="18"></iconify-icon>
                    <span>Données</span>
                  </div>
                </h2>

                <div class="py-2 space-y-3">
                  <!-- Créer nouvelle -->
                  <button @click="createItem('entity')" class="btn btn-primary btn-sm w-full gap-2">
                    <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
                    Créer nouvelle
                  </button>

                  <!-- Séparateur -->
                  <div class="flex items-center gap-2 text-xs text-gray-400 py-1">
                    <div class="h-px bg-gray-200 flex-1"></div>
                    <span>OU CHOISIR EXISTANTE</span>
                    <div class="h-px bg-gray-200 flex-1"></div>
                  </div>

                  <!-- Recherche -->
                  <div class="relative">
                    <input type="text" x-model="entitySearch" placeholder="Rechercher..."
                      class="form-input text-xs pr-8 py-1.5 focus:border-primary w-full bg-white dark:bg-transparent">
                    <iconify-icon icon="solar:magnifer-linear" class="absolute right-2 top-1.5 text-gray-400"
                      width="16"></iconify-icon>
                  </div>

                  <!-- Liste -->
                  <ul class="space-y-1 overflow-y-auto max-h-[60vh] custom-scrollbar text-xs">
                    <template x-for="entity in filteredEntities()" :key="entity.id">
                      <li
                        class="flex items-center justify-between p-2 hover:bg-primary/5 rounded group cursor-pointer border border-transparent hover:border-primary/20 transition-all font-nunito"
                        @click="linkExistingEntity(entity)">
                        <div class="flex items-center gap-2">
                          <iconify-icon icon="solar:database-line-duotone" class="text-primary"
                            width="16"></iconify-icon>
                          <span x-text="entity.name" class="font-medium"></span>
                        </div>
                        <iconify-icon icon="solar:link-bold-duotone"
                          class="opacity-0 group-hover:opacity-100 text-primary transition-opacity"
                          width="16"></iconify-icon>
                      </li>
                    </template>
                    <template x-if="filteredEntities().length === 0">
                      <li class="text-center py-4 text-gray-400 italic">Aucune entité trouvée</li>
                    </template>
                  </ul>
                </div>
              </div>
            </template>
          </div>

          <!-- POPUP MENU Edit -->
          <div x-show="$store.sidebar.showEditMenu" @click.outside="$store.sidebar.showEditMenu = false" x-transition
            @click.stop style="min-width: 298px; margin-left: 298px; top: 56px; height: 100%"
            class="sidebar bg-white dark:bg-[#0e1726] px-2 fixed mt-2 w-60 z-[100] col-span-1 shadow-[5px_0_25px_0_rgba(94,92,154,0.1)] transition-all duration-300 border-l dark:border-gray-800">
            <h2
              class="-mx-2 mb-1 flex items-center bg-white-light/30 py-3 px-2 font-extrabold uppercase dark:bg-dark dark:bg-opacity-[0.08]">
              <div class="flex items-center gap-2">
                <iconify-icon icon="solar:tuning-3-linear" class="ml-2" width="18" height="18"></iconify-icon>
                <span x-text="$store.sidebar.contextItem?.name"></span>
              </div>
            </h2>
            <ul class="space-y-1 text-sm text-gray-800 pt-2 dark:text-gray-200">
              <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                @click="openCreateMenu($event, $store.sidebar.contextItem)">
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:add-square-bold-duotone" class="ml-2" width="18" height="18"></iconify-icon>
                  <span>Créer</span>
                </div>
              </li>
              <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                @click="startRename($store.sidebar.contextItem)">
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:pen-bold-duotone" class="ml-2" width="18" height="18"></iconify-icon>
                  <span>Renommer</span>
                </div>
              </li>

              <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                @click="openIconEditor($store.sidebar.contextItem)">
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:star-bold-duotone" class="ml-2" width="18" height="18"></iconify-icon>
                  <span>Changer l'icône</span>
                </div>
              </li>

              <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors">
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:share-bold-duotone" class="ml-2" width="18" height="18"></iconify-icon>
                  <span>Partager</span>
                </div>
              </li>

              <li x-show="$store.sidebar.contextItem?.type === 'entity'"
                class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                @click="openViewConfig()">
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:settings-bold-duotone" class="ml-2" width="18" height="18"></iconify-icon>
                  <span>Configuration</span>
                </div>
              </li>

              <li class="hover:bg-red-500/10 text-red-500 px-1 py-2 rounded cursor-pointer transition-colors"
                @click="deleteItem()">
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:trash-bin-trash-bold-duotone" class="ml-2" width="18"
                    height="18"></iconify-icon>
                  <span>Supprimer</span>
                </div>
              </li>
            </ul>
          </div>
