<div x-data="globalDrive()" x-init="init()">
  <%- include("../nav/nav-breadcrumb") %>
  <div class="pt-5">

    <!-- Header -->
    <div class="mb-5 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10">
          <iconify-icon icon="solar:cloud-storage-bold-duotone" width="24" class="text-primary"></iconify-icon>
        </div>
        <div>
          <h5 class="text-lg font-semibold dark:text-white-light">Drive</h5>
          <p class="text-xs text-gray-500 dark:text-gray-400" x-text="stats.totalFiles + ' fichiers • ' + stats.totalSizeFormatted"></p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <div class="relative">
          <input type="text" x-model="search" @input.debounce.400ms="fetchData()" placeholder="Rechercher un fichier..."
            class="form-input w-64 pr-10 text-sm dark:bg-[#1b2e4b] dark:border-[#1b2e4b] focus:border-primary" />
          <iconify-icon icon="solar:magnifer-linear" width="16" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400"></iconify-icon>
        </div>
        <select x-model="categoryFilter" @change="fetchData()" class="form-select text-sm w-40 dark:bg-[#1b2e4b] dark:border-[#1b2e4b]">
          <option value="">Tous les types</option>
          <option value="image">Images</option>
          <option value="pdf">PDF</option>
          <option value="word">Word</option>
          <option value="excel">Excel</option>
          <option value="video">Vidéo</option>
          <option value="audio">Audio</option>
          <option value="other">Autres</option>
        </select>
      </div>
    </div>

    <!-- Breadcrumb Bar (Windows-style path) -->
    <div class="panel mb-5 px-4 py-2.5 flex items-center gap-1.5 text-sm overflow-x-auto" style="min-height: 42px;">
      <button @click="navigateTo('root')" class="flex items-center gap-1.5 px-2 py-1 rounded-md transition-colors"
        :class="level === 'root' ? 'bg-primary/10 text-primary font-semibold' : 'hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-400'">
        <iconify-icon icon="solar:cloud-storage-bold-duotone" width="16" class="text-primary"></iconify-icon>
        <span>Drive</span>
      </button>

      <template x-if="currentEntity">
        <div class="flex items-center gap-1.5">
          <iconify-icon icon="solar:alt-arrow-right-linear" width="14" class="text-gray-300 dark:text-gray-600"></iconify-icon>
          <button @click="navigateTo('entity')" class="flex items-center gap-1.5 px-2 py-1 rounded-md transition-colors"
            :class="level === 'entity' ? 'bg-primary/10 text-primary font-semibold' : 'hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-400'">
            <iconify-icon :icon="currentEntity.entityIcon" width="15" :style="'color:' + currentEntity.entityColor"></iconify-icon>
            <span x-text="currentEntity.entityName"></span>
          </button>
        </div>
      </template>

      <template x-if="currentRecord">
        <div class="flex items-center gap-1.5">
          <iconify-icon icon="solar:alt-arrow-right-linear" width="14" class="text-gray-300 dark:text-gray-600"></iconify-icon>
          <button @click="navigateTo('record')" class="flex items-center gap-1.5 px-2 py-1 rounded-md transition-colors"
            :class="level === 'record' ? 'bg-primary/10 text-primary font-semibold' : 'hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-400'">
            <iconify-icon icon="solar:folder-bold-duotone" width="15" class="text-amber-500"></iconify-icon>
            <span x-text="currentRecord.recordTitle"></span>
          </button>
        </div>
      </template>

      <template x-if="currentFolder !== null">
        <div class="flex items-center gap-1.5">
          <iconify-icon icon="solar:alt-arrow-right-linear" width="14" class="text-gray-300 dark:text-gray-600"></iconify-icon>
          <span class="flex items-center gap-1.5 px-2 py-1 rounded-md bg-primary/10 text-primary font-semibold">
            <iconify-icon icon="solar:folder-bold-duotone" width="15" class="text-amber-500"></iconify-icon>
            <span x-text="currentFolder || 'Fichiers'"></span>
          </span>
        </div>
      </template>

      <!-- Back button -->
      <button x-show="level !== 'root'" @click="goBack()"
        class="ml-auto shrink-0 flex items-center gap-1 px-3 py-1 rounded-md text-xs text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-primary transition-colors">
        <iconify-icon icon="solar:arrow-left-linear" width="14"></iconify-icon>
        Retour
      </button>
    </div>

    <!-- Loading -->
    <div x-show="loading" class="flex items-center justify-center py-20">
      <div class="animate-spin w-8 h-8 border-4 border-primary border-t-transparent rounded-full"></div>
    </div>

    <!-- Empty State -->
    <div x-show="!loading && displayItems.length === 0" class="panel py-20 text-center">
      <iconify-icon icon="solar:cloud-bold-duotone" width="64" class="text-gray-300 dark:text-gray-600 mx-auto"></iconify-icon>
      <p class="mt-4 text-lg font-semibold text-gray-400" x-text="level === 'root' ? 'Aucun fichier trouvé' : 'Ce dossier est vide'"></p>
      <p class="text-sm text-gray-400 mt-1" x-text="level === 'root' ? 'Les fichiers attachés à vos fiches apparaîtront ici' : 'Aucun élément dans ce dossier'"></p>
    </div>

    <!-- FOLDER / FILE GRID (Windows Explorer style) -->
    <div x-show="!loading && displayItems.length > 0" class="grid gap-3 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-7 2xl:grid-cols-8">

      <template x-for="item in displayItems" :key="item.id">
        <div>

        <!-- === FOLDER ITEM === -->
        <div x-show="item.type === 'folder'" @dblclick="openFolder(item)"
          class="group flex flex-col items-center gap-2 p-4 rounded-xl cursor-pointer select-none transition-all duration-150 border-2 border-transparent hover:bg-primary/5 hover:border-primary/20 active:scale-95"
          :class="selectedItem === item.id ? 'bg-primary/10 border-primary/30' : ''"
          @click="selectedItem = item.id">

          <!-- Folder Icon -->
          <div class="relative w-16 h-14 flex items-center justify-center">
            <!-- Folder shape -->
            <svg viewBox="0 0 80 64" class="w-full h-full drop-shadow-sm" fill="none">
              <path d="M4 12C4 8.68629 6.68629 6 10 6H28L34 0H70C73.3137 0 76 2.68629 76 6V12H4Z" :fill="item.color + '40'" />
              <rect x="0" y="10" width="80" height="54" rx="6" :fill="item.color + '25'" :stroke="item.color + '50'" stroke-width="1.5" />
            </svg>
            <!-- Entity/Record icon overlay -->
            <div class="absolute inset-0 flex items-center justify-center pt-3">
              <iconify-icon :icon="item.icon" width="24" :style="'color:' + item.color" class="drop-shadow-sm"></iconify-icon>
            </div>
            <!-- Count badge -->
            <span class="absolute -top-1 -right-1 min-w-[18px] h-[18px] flex items-center justify-center rounded-full text-[9px] font-bold text-white px-1"
              :style="'background:' + item.color" x-text="item.count"></span>
          </div>

          <!-- Label -->
          <div class="text-center w-full px-1">
            <p class="text-xs font-medium text-gray-800 dark:text-gray-200 truncate leading-tight" x-text="item.label"></p>
            <p class="text-[10px] text-gray-400 dark:text-gray-500 mt-0.5" x-text="item.sublabel"></p>
          </div>
        </div>

        <!-- === FILE ITEM === -->
        <div x-show="item.type === 'file'" @dblclick="openPreview(item.file)"
          class="group flex flex-col items-center gap-2 p-3 rounded-xl cursor-pointer select-none transition-all duration-150 border-2 border-transparent hover:bg-gray-50 dark:hover:bg-gray-800/50 hover:border-gray-200 dark:hover:border-gray-700 active:scale-95"
          :class="selectedItem === item.id ? 'bg-primary/10 border-primary/30' : ''"
          @click="selectedItem = item.id">

          <!-- File Thumbnail -->
          <div class="relative w-16 h-16 rounded-lg overflow-hidden flex items-center justify-center bg-gray-50 dark:bg-[#0e1726]">
            <template x-if="item.file?.category === 'image'">
              <img :src="item.file.url" :alt="item.label" class="w-full h-full object-cover rounded-lg">
            </template>
            <template x-if="item.file?.category !== 'image'">
              <iconify-icon :icon="getFileIcon(item.file?.category)" width="28" :style="'color:' + getFileColor(item.file?.category)"></iconify-icon>
            </template>
            <!-- Generated badge -->
            <template x-if="item.file?.isGenerated">
              <span class="absolute top-0.5 left-0.5 px-1 py-px rounded text-[7px] font-bold bg-emerald-500/90 text-white leading-tight">GEN</span>
            </template>
          </div>

          <!-- File Info -->
          <div class="text-center w-full px-0.5">
            <p class="text-[11px] font-medium text-gray-700 dark:text-gray-300 leading-tight line-clamp-2" x-text="item.label" style="word-break: break-all;"></p>
            <p class="text-[9px] text-gray-400 mt-0.5" x-text="item.sublabel"></p>
          </div>
        </div>

        </div>
      </template>
    </div>

    <!-- Status bar -->
    <div x-show="!loading && displayItems.length > 0" class="mt-4 px-2 flex items-center justify-between text-[11px] text-gray-400 dark:text-gray-500">
      <span x-text="getStatusText()"></span>
      <span x-show="level === 'root'" x-text="stats.totalSizeFormatted + ' utilisé'"></span>
    </div>

  </div>

  <!-- Preview Modal -->
  <div x-show="previewFile" x-transition.opacity class="fixed inset-0 z-[1000] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4" x-cloak @keydown.escape.window="previewFile = null">
    <div class="bg-white dark:bg-[#1b2e4b] rounded-2xl shadow-2xl w-full max-w-3xl max-h-[85vh] overflow-hidden" @click.outside="previewFile = null"
      x-transition:enter="transition ease-out duration-200" x-transition:enter-start="scale-95 opacity-0" x-transition:enter-end="scale-100 opacity-100">
      <!-- Modal Header -->
      <div class="flex items-center justify-between px-5 py-3 border-b dark:border-gray-800">
        <div class="flex items-center gap-3 min-w-0">
          <iconify-icon :icon="previewFile ? getFileIcon(previewFile.category) : ''" width="20" :style="previewFile ? 'color:' + getFileColor(previewFile.category) : ''"></iconify-icon>
          <div class="min-w-0">
            <h6 class="font-semibold text-sm truncate dark:text-white" x-text="previewFile?.originalName"></h6>
            <p class="text-[10px] text-gray-400" x-text="previewFile ? (previewFile.sizeFormatted + ' • ' + previewFile.entityName + ' · ' + previewFile.recordTitle) : ''"></p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a :href="previewFile?.url" download class="btn btn-sm btn-outline-primary gap-1">
            <iconify-icon icon="solar:download-minimalistic-bold" width="14"></iconify-icon> Télécharger
          </a>
          <a :href="'/account/<%= account_number %>/record/' + previewFile?.entitySlug + '/' + previewFile?.recordId + '/drive'" class="btn btn-sm btn-outline-secondary gap-1" title="Voir la fiche">
            <iconify-icon icon="solar:arrow-right-up-linear" width="14"></iconify-icon> Fiche
          </a>
          <button @click="previewFile = null" class="p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
            <iconify-icon icon="solar:close-circle-bold" width="22"></iconify-icon>
          </button>
        </div>
      </div>
      <!-- Modal Content -->
      <div class="p-5 flex items-center justify-center overflow-auto" style="max-height: calc(85vh - 60px);">
        <template x-if="previewFile?.category === 'image'">
          <img :src="previewFile?.url" class="max-w-full max-h-[70vh] rounded-lg shadow-lg" :alt="previewFile?.originalName">
        </template>
        <template x-if="previewFile?.category === 'pdf'">
          <iframe :src="previewFile?.url" class="w-full rounded-lg" style="height:70vh;"></iframe>
        </template>
        <template x-if="previewFile?.category === 'video'">
          <video :src="previewFile?.url" controls class="max-w-full max-h-[70vh] rounded-lg"></video>
        </template>
        <template x-if="previewFile?.category === 'audio'">
          <audio :src="previewFile?.url" controls class="w-full"></audio>
        </template>
        <template x-if="previewFile && !['image','pdf','video','audio'].includes(previewFile?.category)">
          <div class="text-center py-10">
            <iconify-icon :icon="getFileIcon(previewFile?.category)" width="64" :style="'color:' + getFileColor(previewFile?.category)" class="mx-auto"></iconify-icon>
            <p class="mt-4 text-gray-500" x-text="previewFile?.originalName"></p>
            <a :href="previewFile?.url" download class="btn btn-primary mt-4 gap-2">
              <iconify-icon icon="solar:download-minimalistic-bold" width="16"></iconify-icon> Télécharger le fichier
            </a>
          </div>
        </template>
      </div>
    </div>
  </div>
</div>

<script>
function globalDrive() {
  const accountNum = '<%= account_number %>';
  return {
    loading: true,
    search: '',
    categoryFilter: '',
    entities: [],
    stats: { totalFiles: 0, totalSizeFormatted: '0 o', categoryCounts: {} },

    // Navigation state
    level: 'root',         // 'root' | 'entity' | 'record' | 'folder'
    currentEntity: null,
    currentRecord: null,
    currentFolder: null,
    selectedItem: null,
    displayItems: [],
    previewFile: null,

    async init() {
      await this.fetchData();
    },

    async fetchData() {
      this.loading = true;
      try {
        const params = new URLSearchParams();
        if (this.search) params.set('search', this.search);
        if (this.categoryFilter) params.set('category', this.categoryFilter);
        const res = await fetch(`/account/${accountNum}/api/drive?${params}`, { credentials: 'include' });
        const data = await res.json();
        if (data.success) {
          this.entities = data.entities;
          this.stats = data.stats;
          this.buildDisplayItems();
        }
      } catch (err) {
        console.error('[Drive] fetch error:', err);
      }
      this.loading = false;
    },

    // ═══ Build display items based on current navigation level ═══
    buildDisplayItems() {
      this.selectedItem = null;
      const items = [];

      if (this.level === 'root') {
        // Show entities as folders
        this.entities.forEach(entity => {
          items.push({
            id: 'e-' + entity.entityId,
            type: 'folder',
            icon: entity.entityIcon,
            color: entity.entityColor,
            label: entity.entityName,
            sublabel: entity.fileCount + ' fichier' + (entity.fileCount > 1 ? 's' : '') + ' • ' + entity.records.length + ' fiche' + (entity.records.length > 1 ? 's' : ''),
            count: entity.records.length,
            data: entity
          });
        });

      } else if (this.level === 'entity' && this.currentEntity) {
        // Show records as folders
        this.currentEntity.records.forEach(record => {
          items.push({
            id: 'r-' + record.recordId,
            type: 'folder',
            icon: this.currentEntity.entityIcon,
            color: this.currentEntity.entityColor,
            label: record.recordTitle,
            sublabel: record.fileCount + ' fichier' + (record.fileCount > 1 ? 's' : ''),
            count: record.fileCount,
            data: record
          });
        });

      } else if (this.level === 'record' && this.currentRecord) {
        // Show folders as folder items + root files as file items
        // First: sub-folders
        this.currentRecord.folders.forEach(folder => {
          items.push({
            id: 'f-' + folder.name,
            type: 'folder',
            icon: 'solar:folder-bold-duotone',
            color: '#f59e0b',
            label: folder.name,
            sublabel: folder.fileCount + ' fichier' + (folder.fileCount > 1 ? 's' : ''),
            count: folder.fileCount,
            data: folder
          });
        });
        // Then: root files
        this.currentRecord.rootFiles.forEach(file => {
          items.push({
            id: 'file-' + file._id,
            type: 'file',
            label: file.originalName,
            sublabel: file.sizeFormatted,
            file: file
          });
        });

      } else if (this.level === 'folder' && this.currentFolder !== null) {
        // Show files inside a specific folder
        const record = this.currentRecord;
        const folder = record.folders.find(f => f.name === this.currentFolder);
        if (folder) {
          folder.files.forEach(file => {
            items.push({
              id: 'file-' + file._id,
              type: 'file',
              label: file.originalName,
              sublabel: file.sizeFormatted,
              file: file
            });
          });
        }
      }

      this.displayItems = items;
    },

    // ═══ Navigation ═══
    openFolder(item) {
      if (this.level === 'root') {
        this.currentEntity = item.data;
        this.currentRecord = null;
        this.currentFolder = null;
        this.level = 'entity';
      } else if (this.level === 'entity') {
        this.currentRecord = item.data;
        this.currentFolder = null;
        this.level = 'record';
      } else if (this.level === 'record') {
        this.currentFolder = item.data.name;
        this.level = 'folder';
      }
      this.buildDisplayItems();
    },

    navigateTo(targetLevel) {
      if (targetLevel === 'root') {
        this.currentEntity = null;
        this.currentRecord = null;
        this.currentFolder = null;
        this.level = 'root';
      } else if (targetLevel === 'entity') {
        this.currentRecord = null;
        this.currentFolder = null;
        this.level = 'entity';
      } else if (targetLevel === 'record') {
        this.currentFolder = null;
        this.level = 'record';
      }
      this.buildDisplayItems();
    },

    goBack() {
      if (this.level === 'folder') this.navigateTo('record');
      else if (this.level === 'record') this.navigateTo('entity');
      else if (this.level === 'entity') this.navigateTo('root');
    },

    openPreview(file) {
      this.previewFile = file;
    },

    getStatusText() {
      const folders = this.displayItems.filter(i => i.type === 'folder').length;
      const files = this.displayItems.filter(i => i.type === 'file').length;
      const parts = [];
      if (folders > 0) parts.push(folders + ' dossier' + (folders > 1 ? 's' : ''));
      if (files > 0) parts.push(files + ' fichier' + (files > 1 ? 's' : ''));
      return parts.join(' • ') || '';
    },

    getFileIcon(cat) {
      const map = { image: 'solar:gallery-bold-duotone', pdf: 'solar:document-text-bold-duotone', word: 'solar:file-text-bold-duotone', excel: 'solar:chart-square-bold-duotone', video: 'solar:videocamera-record-bold-duotone', audio: 'solar:music-notes-bold-duotone' };
      return map[cat] || 'solar:file-bold-duotone';
    },
    getFileColor(cat) {
      const map = { image: '#4361ee', pdf: '#e7515a', word: '#2196f3', excel: '#00ab55', video: '#e2a03f', audio: '#805dca' };
      return map[cat] || '#888ea8';
    }
  };
}
</script>
