        font-weight: 800 !important;
        color: #4b5563 !important;
        margin-bottom: 4px !important;
        text-transform: uppercase !important;
        letter-spacing: 0.05em !important;
    }

    .form-input,
    input:not([type="checkbox"]):not([type="radio"]):not([type="file"]),
    select,
    .form-select {
        font-size: 13px !important;
        padding: 8px 12px !important;
        background-color: #f9fafb !important;
        border: 1px solid #f3f4f6 !important;
        border-radius: 8px !important;
        color: #111827 !important;
        width: 100% !important;
        height: 38px !important;
        margin: 0 !important;
        transition: all 0.2s;
    }

    .dark .form-input,
    .dark input:not([type="checkbox"]):not([type="radio"]):not([type="file"]),
    .dark select,
    .dark .form-select {
        background-color: #121e32 !important;
        border-color: #17263c !important;
        color: #e0e6ed !important;
    }

    .form-input:focus,
    select:focus {
        border-color: #4361ee !important;
        background-color: #fff !important;
        box-shadow: 0 0 0 1px rgba(67, 97, 238, 0.1) !important;
    }

    .dark .form-input:focus,
    .dark select:focus {
        border-color: #22bce9 !important;
        background-color: #1b2e4b !important;
        box-shadow: 0 0 0 1px rgba(34, 188, 233, 0.1) !important;
    }

    textarea,
    .form-textarea {
        font-size: 13px !important;
        padding: 8px 12px !important;
        background-color: #f9fafb !important;
        border: 1px solid #f3f4f6 !important;
        border-radius: 8px !important;
        color: #111827 !important;
        width: 100% !important;
        min-height: 100px !important;
        margin: 0 !important;
        resize: vertical !important;
    }

    textarea[name="standard[description]"] {
        background-color: #f9fafb !important;
        border: 1px solid #f3f4f6 !important;
        border-radius: 8px !important;
    }

    .dark textarea,
    .dark .form-textarea {
        background-color: #121e32 !important;
        border-color: #17263c !important;
        color: #e0e6ed !important;
    }

    /* Reset for file inputs - Match Entity Builder */
    input[type="file"] {
        padding: 0 !important;
        height: auto !important;
        min-height: 38px !important;
        cursor: pointer !important;
    }

    /* Reset for checkboxes and radios - Match Entity Builder */
    input[type="checkbox"],
    input[type="radio"] {
        width: auto !important;
        height: auto !important;
        min-height: 16px !important;
        min-width: 16px !important;
        cursor: pointer !important;
        margin-right: 8px !important;
    }

    /* Force button height and center label - Fixed Shift */
    .builder-preview button {
        height: 38px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        margin: 0 !important;
        /* padding: 0 20px !important; */
        line-height: 1 !important;
        text-transform: none !important;
        width: 12px;
    }

    .builder-preview button * {
        margin: 0 !important;
        padding: 0 !important;
        pointer-events: none !important;
    }

    /* Force tightening on ANY template injected tags */
    .builder-preview *:not(input[type="file"]):not(label):not(button) {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    .sortable-ghost {
        opacity: 0.05;
        background: #4361ee !important;
        border-radius: 12px;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('success') === 'true') {
            const toast = window.Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                showCloseButton: true,
                customClass: {
                    popup: 'color-success'
                },
                target: document.getElementById('main-record-form')
            });
            toast.fire({
                title: 'Enregistrement effectué',
                icon: 'success',
                padding: '10px 20px'
            });
            // Clean URL
            const url = new URL(window.location);
            url.searchParams.delete('success');
            window.history.replaceState({}, '', url);
        }
    });
</script>