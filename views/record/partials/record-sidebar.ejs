    <div class="space-y-3 sticky top-20" x-data="recordSidebar" id="sidebar-inner-sortable">
        <% ['classifications', 'attachments', 'smartdoc', 'lines', 'relations'].forEach(function(sectionId) { %>
            <% if (sectionId==='classifications' ) { %>
                        <!-- Dynamic Classifications (Shared Data) -->
                        <div class="panel-sortable-item" data-panel-id="classifications">
                            <template x-if="designMode">
                                <div class="panel-drag-handle">
                                    <iconify-icon icon="tabler:grip-horizontal" width="16"></iconify-icon>
                                    <span>Classification</span>
                                </div>
                            </template>
                        <div class="panel !p-0 group/panel relative z-10" data-id="classifications">
                            <% const allEntityClassifications=[];
                                // Include statusClassification first (if populated)
                                if (entity.statusClassification && entity.statusClassification._id) {
                                allEntityClassifications.push({
                                data: entity.statusClassification,
                                isStatus: true,
                                label: entity.statusClassification.name,
                                icon: 'solar:flag-bold',
                                colorClass: 'text-warning',
                                nameAttr: `classifications[${entity.statusClassification._id}]`
                                });
                                }
                                // Then include additional classifications
                                if (entity.classifications &&
                                entity.classifications.length> 0) {
                                entity.classifications.forEach(c => {
                                // Avoid duplicating if statusClassification is also in classifications array
                                if (entity.statusClassification && c._id && entity.statusClassification._id && c._id.toString() === entity.statusClassification._id.toString()) return;
                                allEntityClassifications.push({
                                data: c,
                                isStatus: false,
                                label: c.name,
                                icon: 'solar:tag-bold',
                                colorClass: 'text-info',
                                nameAttr: `classifications[${c._id}]`
                                });
                                });
                                }

                                // Tree Helper for Recursive Rendering
                                const renderTree = (options, parentId, cls, selectedIds, currentValue) => {
                                const children = options.filter(o => {
                                const pid = o.parentId ? o.parentId.toString() : '';
                                const targetId = parentId ? parentId.toString() : '';
                                return pid === targetId;
                                }).sort((a, b) => (a.order || 0) - (b.order || 0));
                                %>
                                <ul class="nested-sortable-list space-y-0.5"
                                    style="<%= parentId ? 'margin-left: 11px; margin-top: 2px;' : '' %>"
                                    data-parent-id="<%= parentId || '' %>">
                                    <% children.forEach(opt=> { %>
                                        <li class="sort-item group/item" data-id="<%= opt._id %>">
                                            <div class="flex items-center gap-1 h-[20px]">
                                                <!-- Drag Handle -->
                                                <div
                                                    class="handle cursor-grab opacity-20 group-hover/item:opacity-100 transition-opacity text-gray-400 p-0.5 -ml-1 flex items-center">
                                                    <iconify-icon icon="tabler:grip-vertical" width="14"></iconify-icon>
                                                </div>

                                                <label
                                                    class="flex items-center gap-2 cursor-pointer mb-0 flex-1 min-w-0">
                                                    <% if (cls.data.allowMultiple) { %>
                                                        <input type="checkbox" name="<%= cls.nameAttr %>[]"
                                                            value="<%= opt._id %>" class="form-checkbox w-3.5 h-3.5"
                                                            <%=selectedIds.includes(opt._id.toString()) ? 'checked' : ''
                                                            %>>
                                                        <% } else { %>
                                                            <input type="radio" name="<%= cls.nameAttr %>"
                                                                value="<%= opt._id %>" class="form-radio w-3.5 h-3.5"
                                                                <%=currentValue===opt._id.toString() ? 'checked' : ''
                                                                %>>
                                                            <% } %>
                                                                <span
                                                                    class="text-[11px] truncate flex items-center gap-1 <%= (selectedIds.includes(opt._id.toString()) || currentValue === opt._id.toString()) ? 'text-primary font-bold' : 'text-gray-700' %>">
                                                                    <span
                                                                        class="prefix-arrow text-gray-300 font-normal">└</span>
                                                                    <%= opt.label %>
                                                                </span>
                                                </label>
                                            </div>
                                            <!-- Recursive call - Always render UL for nesting -->
                                            <%- renderTree(options, opt._id, cls, selectedIds, currentValue) %>
                                        </li>
                                        <% }) %>
                                </ul>
                                <% }; // Helper for recursive hierarchical display in SELECT (flat with indentation)
                                    const renderOptionsFlat=(options, parentId=null, depth=0)=> {
                                    let results = [];
                                    const filtered = options.filter(o => {
                                    const pid = o.parentId ? o.parentId.toString() : '';
                                    const targetId = parentId ? parentId.toString() : '';
                                    return pid === targetId;
                                    });

                                    filtered.forEach(o => {
                                    const item = o.toObject ? o.toObject() : { ...o };
                                    results.push({ ...item, depth });
                                    results = results.concat(renderOptionsFlat(options, item._id, depth + 1));
                                    });
                                    return results;
                                    };
                                    %>

                                    <% if (allEntityClassifications.length> 0) { %>
                                        <div class="">
                                            <% const
                                                sidebarSectionClassifications=locals.user?.preferences?.sidebar_section_classifications
                                                !==false; %>
                                                <div class="py-3 bg-gray-50/30 flex items-center justify-between cursor-pointer hover:bg-gray-50 transition-colors"
                                                    @click="classificationsOpen = !classificationsOpen; $dispatch('save-pref', { key: 'sidebar_section_classifications', value: classificationsOpen })">
                                                    <div class="flex items-center gap-2 text-primary">
                                                        <iconify-icon icon="solar:tag-bold" width="16"></iconify-icon>
                                                        <h6
                                                            class="text-[11px] font-extrabold uppercase tracking-wider mb-0 text-gray-800 dark:text-white-light">
                                                            Classification</h6>
                                                    </div>
                                                    <div class="flex items-center gap-1">
                                                        <div
                                                            class="drag-handle-panel flex items-center justify-center text-gray-400 hover:text-primary cursor-grab transition-colors h-4">
                                                            <iconify-icon icon="tabler:grip-horizontal"
                                                                width="16"></iconify-icon>
                                                        </div>
                                                        <div class="flex items-center justify-center h-4">
                                                            <iconify-icon icon="solar:alt-arrow-down-bold"
                                                                :class="classificationsOpen ? 'rotate-180' : ''"
                                                                class="text-gray-400 transition-transform duration-300 block"
                                                                width="14"></iconify-icon>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div x-show="classificationsOpen" x-collapse
                                                    x-init="classificationsOpen = <%= sidebarSectionClassifications %>">
                                                    <% allEntityClassifications.forEach((cls, clsIdx)=> { %>
                                                        <% const
                                                            classificationOpen=locals.user?.preferences?.[`sidebar_classification_${cls.data._id}`]
                                                            !==false; %>
                                                            <div class="px-4 py-2 <%= clsIdx > 0 ? 'border-t border-gray-100' : '' %>"
                                                                x-data="classificationBox('<%= cls.data._id %>', '<%= cls.nameAttr %>', <%= cls.data.allowMultiple %>, <%= classificationOpen %>)">
                                                                <div class="flex items-center justify-between mb-3 group cursor-pointer select-none"
                                                                    @click="toggleList()">
                                                                    <div class="flex items-center gap-2">
                                                                        <h6
                                                                            class="text-[12px] font-bold text-gray-500 tracking-tight m-0">
                                                                            <%= cls.label %>
                                                                        </h6>
                                                                        <% if (cls.data.type==='hierarchical' ) { %>
                                                                            <span
                                                                                class="text-[8px] bg-gray-100 px-1 rounded text-gray-400 font-bold uppercase">Tree</span>
                                                                            <% } %>
                                                                    </div>
                                                                    <div
                                                                        class="flex items-center gap-0 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                                                        <!-- Toggle Button (Left) -->
                                                                        <button type="button"
                                                                            @click.stop="isOpen = !isOpen"
                                                                            class="w-6 h-6 flex items-center justify-center rounded-md hover:bg-gray-100 transition-all text-gray-400"
                                                                            :class="!isOpen ? '-rotate-90' : ''">
                                                                            <iconify-icon
                                                                                icon="solar:alt-arrow-down-linear"
                                                                                width="14"></iconify-icon>
                                                                        </button>

                                                                        <!-- Options Button (Middle) -->
                                                                        <button type="button" @click.stop=""
                                                                            class="w-4 h-6 flex items-center justify-center rounded-md hover:bg-gray-100 transition-all text-gray-400 hover:text-gray-600"
                                                                            title="Options">
                                                                            <iconify-icon icon="solar:menu-dots-bold"
                                                                                width="14"
                                                                                class="rotate-90"></iconify-icon>
                                                                        </button>

                                                                        <!-- Add Option Button (Right) -->
                                                                        <button type="button"
                                                                            @click.stop="isOpen = true; toggleEdit(); $dispatch('toggle-tags', { id: '<%= cls.data._id %>' })"
                                                                            class="w-6 h-6 flex items-center justify-center rounded-md hover:bg-gray-100 transition-all text-gray-400 hover:text-primary"
                                                                            title="Ajouter">
                                                                            <iconify-icon
                                                                                :icon="editing? 'solar:close-circle-linear' : 'solar:add-circle-linear'"
                                                                                width="16"></iconify-icon>
                                                                        </button>
                                                                    </div>
                                                                </div>

                                                                <div class="mt-2 text-xs" x-show="isOpen" x-collapse>
                                                                    <% if (cls.data.type==='hierarchical' ) { %>
                                                                        <!-- TREE VIEW (Hierarchical Only) -->
                                                                        <div class="space-y-1.5 overflow-y-auto border border-gray-100 rounded p-2 bg-gray-50/30 custom-scrollbar"
                                                                            style="max-height: 150px;"
                                                                            id="tree-<%= cls.data._id %>">
                                                                            <% let selectedIds=[]; let currentValue='' ;
                                                                                if (cls.data.allowMultiple) { const
                                                                                values=(locals.record &&
                                                                                record.classificationValues) ?
                                                                                record.classificationValues.filter(cv=>
                                                                                cv.classificationId.toString()
                                                                                ===
                                                                                cls.data._id.toString()) : [];
                                                                                selectedIds = values.map(v =>
                                                                                v.optionId.toString());
                                                                                } else {
                                                                                const valObj = (locals.record &&
                                                                                record.classificationValues) ?
                                                                                record.classificationValues.find(cv =>
                                                                                cv.classificationId.toString()
                                                                                ===
                                                                                cls.data._id.toString()) : null;
                                                                                currentValue = valObj ? (valObj.optionId
                                                                                ?
                                                                                valObj.optionId.toString() :
                                                                                '') :
                                                                                '';
                                                                                }
                                                                                %>
                                                                                <%- renderTree(cls.data.options, null,
                                                                                    cls, selectedIds, currentValue) %>

                                                                                    <% if (cls.data.options.length===0
                                                                                        && !editing) { %>
                                                                                        <p
                                                                                            class="no-options-msg text-[10px] text-gray-400 italic text-center py-2">
                                                                                            Aucune option</p>
                                                                                        <% } %>
                                                                        </div>
                                                                        <!-- QUICK ADD FOR TREE -->
                                                                        <div x-show="editing" class="mt-2" x-transition>
                                                                            <div class="relative">
                                                                                <input type="text" x-model="newLabel"
                                                                                    x-ref="input" @keyup.enter="save"
                                                                                    class="form-input text-xs !h-8 pr-12"
                                                                                    placeholder="Nouveau...">
                                                                                <button type="button" @click="save"
                                                                                    :disabled="!newLabel || loading"
                                                                                    class="absolute right-1 top-1 bottom-1 p-1 text-primary">
                                                                                    <iconify-icon
                                                                                        :icon="loading ? 'line-md:loading-twotone-loop' : 'solar:check-read-linear'"
                                                                                        width="16"></iconify-icon>
                                                                                </button>
                                                                            </div>
                                                                        </div>

                                                                        <% } else if (cls.data.allowMultiple) { %>
                                                                            <!-- TAGS SYSTEM (Simple Multiple) -->
                                                                            <div x-data="classificationTags('<%= cls.data._id %>', '<%= cls.nameAttr %>', <%= JSON.stringify(cls.data.options) %>, <%= JSON.stringify((locals.record && record.classificationValues) ? record.classificationValues.filter(cv => cv.classificationId.toString() === cls.data._id.toString()).map(cv => cv.optionId.toString()) : []) %>)"
                                                                                @tag-added.window="if($event.detail.clsId === '<%= cls.data._id %>') { options.push($event.detail.option); add($event.detail.option._id); }"
                                                                                @toggle-tags.window="if($event.detail.id === '<%= cls.data._id %>') { showAdd = !showAdd; if(showAdd) $nextTick(() => { if($refs.tagInput) $refs.tagInput.focus() }) }"
                                                                                class="relative">
                                                                                <!-- Selected Tags -->
                                                                                <div class="flex flex-wrap gap-1 mb-2 overflow-y-auto custom-scrollbar"
                                                                                    style="max-height: 100px;">
                                                                                    <template
                                                                                        x-for="optId in selectedIds"
                                                                                        :key="optId">
                                                                                        <div
                                                                                            class="bg-primary/10 text-primary text-[10px] font-bold px-2 py-0.5 rounded flex items-center gap-1 group">
                                                                                            <span
                                                                                                x-text="getLabel(optId)"></span>
                                                                                            <button type="button"
                                                                                                @click="remove(optId)"
                                                                                                class="hover:text-danger">
                                                                                                <iconify-icon
                                                                                                    icon="solar:close-circle-bold"
                                                                                                    width="12"></iconify-icon>
                                                                                            </button>
                                                                                            <input type="hidden"
                                                                                                :name="nameAttr + '[]'"
                                                                                                :value="optId">
                                                                                        </div>
                                                                                    </template>
                                                                                </div>

                                                                                <!-- Search / Autocomplete -->
                                                                                <div class="relative">
                                                                                    <input type="text" x-model="search"
                                                                                        @focus="open = true"
                                                                                        @click.away="open = false"
                                                                                        class="form-input text-xs !h-8"
                                                                                        placeholder="Chercher ou ajouter...">

                                                                                    <!-- Dropdown -->
                                                                                    <div x-show="open && filteredOptions.length > 0"
                                                                                        class="absolute z-[100] w-full mt-1 bg-white border border-gray-100 shadow-lg rounded-lg max-h-40 overflow-y-auto"
                                                                                        x-transition>
                                                                                        <template
                                                                                            x-for="opt in filteredOptions"
                                                                                            :key="opt._id">
                                                                                            <button type="button"
                                                                                                @click="add(opt._id)"
                                                                                                class="w-full text-left px-3 py-1.5 text-[11px] hover:bg-gray-50 flex items-center justify-between group">
                                                                                                <span
                                                                                                    x-text="opt.label"></span>
                                                                                                <iconify-icon
                                                                                                    icon="solar:add-circle-bold"
                                                                                                    width="14"
                                                                                                    class="opacity-0 group-hover:opacity-100 text-primary"></iconify-icon>
                                                                                            </button>
                                                                                        </template>
                                                                                        <!-- Quick Add Option if search doesn't match exactly -->
                                                                                        <template
                                                                                            x-if="search && !exactMatch">
                                                                                            <button type="button"
                                                                                                @click="fastAdd"
                                                                                                class="w-full text-left px-3 py-1.5 text-[11px] bg-primary/5 text-primary italic font-medium hover:bg-primary/10">
                                                                                                + Ajouter "<span
                                                                                                    x-text="search"></span>"
                                                                                            </button>
                                                                                        </template>
                                                                                    </div>
                                                                                </div>

                                                                                <!-- QUICK ADD FOR TAGS (Local state showAdd) -->
                                                                                <div x-show="showAdd" class="mt-2"
                                                                                    x-transition>
                                                                                    <div class="relative">
                                                                                        <input type="text"
                                                                                            x-model="localNewLabel"
                                                                                            x-ref="tagInput"
                                                                                            @keyup.enter="localSave()"
                                                                                            class="form-input text-xs !h-8 pr-12"
                                                                                            placeholder="Nouveau...">
                                                                                        <button type="button"
                                                                                            @click="localSave()"
                                                                                            :disabled="!localNewLabel || localLoading"
                                                                                            class="absolute right-1 top-1 bottom-1 p-1 text-primary">
                                                                                            <iconify-icon
                                                                                                :icon="localLoading ? 'line-md:loading-twotone-loop' : 'solar:check-read-linear'"
                                                                                                width="16"></iconify-icon>
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                            <% } else { %>
                                                                                <!-- SELECT UNIQUE (ORIGINAL DESIGN) -->
                                                                                <select name="<%= cls.nameAttr %>"
                                                                                    class="form-select text-xs !h-9 !py-1">
                                                                                    <option value="">-- Choisir --
                                                                                    </option>
                                                                                    <% const valObj=(locals.record &&
                                                                                        record.classificationValues) ?
                                                                                        record.classificationValues.find(cv=>
                                                                                        cv.classificationId.toString()
                                                                                        ===
                                                                                        cls.data._id.toString()) : null;
                                                                                        const currentValue = valObj ?
                                                                                        (valObj.optionId ?
                                                                                        valObj.optionId.toString()
                                                                                        : '') :
                                                                                        '';

                                                                                        cls.data.options.forEach(opt =>
                                                                                        { %>
                                                                                        <option value="<%= opt._id %>"
                                                                                            <%=(opt._id &&
                                                                                            currentValue===opt._id.toString())
                                                                                            ? 'selected' : '' %>>
                                                                                            <%= opt.label %>
                                                                                        </option>
                                                                                        <% }) %>
                                                                                </select>
                                                                                <!-- QUICK ADD FOR SIMPLE SELECT -->
                                                                                <div x-show="editing" class="mt-2"
                                                                                    x-transition>
                                                                                    <div class="relative">
                                                                                        <input type="text"
                                                                                            x-model="newLabel"
                                                                                            x-ref="input"
                                                                                            @keyup.enter="save"
                                                                                            class="form-input text-xs !h-8 pr-12"
                                                                                            placeholder="Nouvelle...">
                                                                                        <button type="button"
                                                                                            @click="save"
                                                                                            :disabled="!newLabel || loading"
                                                                                            class="absolute right-1 top-1 bottom-1 p-1 text-primary">
                                                                                            <iconify-icon
                                                                                                :icon="loading ? 'line-md:loading-twotone-loop' : 'solar:check-read-linear'"
                                                                                                width="16"></iconify-icon>
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                                <% } %>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                </div>
                                        </div>
                                        <% } else { %>
                                            <div class="panel !p-4 border-dashed border-gray-200 text-center py-4">
                                                <p class="text-[10px] text-gray-400 uppercase font-bold">Aucune
                                                    classification liée</p>
                                                <a href="/account/<%= account_number %>/entity/edit/<%= entity._id %>"
                                                    class="btn btn-xs btn-outline-primary mt-2">Configurer l'entité</a>
                                            </div>
                                            <% } %>
                        </div>
                        </div><!-- end panel-sortable-item classifications -->
                        <% } else if (sectionId==='attachments' && locals.entity && entity.enableAttachments) { %>
                            <!-- 📎 Attachments (Standalone Panel) -->
                            <% const sidebarSectionAttachments=locals.user?.preferences?.sidebar_section_attachments!==false; %>
                            <div class="panel-sortable-item" data-panel-id="attachments">
                                <template x-if="designMode">
                                    <div class="panel-drag-handle">
                                        <iconify-icon icon="tabler:grip-horizontal" width="16"></iconify-icon>
                                        <span>Pièces jointes</span>
                                    </div>
                                </template>
                            <div class="panel !p-0 overflow-hidden" data-id="attachments"
                                x-data='attachmentPanel({
                                    recordId: "<%= locals.record && record._id ? record._id : "" %>",
                                    accountNumber: "<%= account_number %>",
                                    initialAttachments: <%- JSON.stringify((locals.record && record.attachments) ? record.attachments.map(a => ({ _id: a._id, filename: a.filename, originalName: a.originalName, mimeType: a.mimeType, size: a.size, category: a.category, isGenerated: a.isGenerated || false, uploadedAt: a.uploadedAt })) : []) %>,
                                    initialOpen: <%= sidebarSectionAttachments %>
                                })'>
                                <!-- Header -->
                                <div class="flex items-center justify-between px-3 py-2 cursor-pointer hover:bg-gray-50/50 dark:hover:bg-gray-800/30 transition-colors"
                                    @click="isOpen = !isOpen; $dispatch('save-pref', { key: 'sidebar_section_attachments', value: isOpen })">
                                    <div class="flex items-center gap-2">
                                        <iconify-icon icon="solar:paperclip-2-bold" width="14" class="text-gray-400"></iconify-icon>
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Pièces jointes</span>
                                        <span x-show="attachments.length > 0" class="text-[9px] bg-primary/10 text-primary w-4 h-4 rounded-full flex items-center justify-center font-bold" x-text="attachments.length"></span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <button type="button" @click.stop="showUploadModal = true" class="w-5 h-5 flex items-center justify-center rounded text-gray-400 hover:text-primary hover:bg-primary/5 transition-all" title="Ajouter">
                                            <iconify-icon icon="solar:add-circle-linear" width="14"></iconify-icon>
                                        </button>
                                        <iconify-icon icon="solar:alt-arrow-down-bold" width="12" :class="isOpen ? '' : '-rotate-90'" class="transition-transform text-gray-300"></iconify-icon>
                                    </div>
                                </div>
                                <input type="file" x-ref="fileInput" multiple class="hidden" @change="handleFiles($event.target.files)"
                                    accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.mp4,.webm,.mp3,.wav,.zip,.rar,.txt,.csv">

                                <div x-show="isOpen" x-collapse>
                                    <!-- Upload progress -->
                                    <template x-if="uploading">
                                        <div class="flex items-center gap-2 px-3 py-2 border-t border-gray-50 dark:border-gray-700/30">
                                            <iconify-icon icon="line-md:loading-twotone-loop" width="13" class="text-primary"></iconify-icon>
                                            <span class="text-[10px] text-primary font-medium">Upload en cours...</span>
                                        </div>
                                    </template>

                                    <!-- File list -->
                                    <div class="max-h-[200px] overflow-y-auto custom-scrollbar" x-show="attachments.length > 0">
                                        <template x-for="att in attachments" :key="att._id">
                                            <div class="group flex items-center gap-2 px-3 py-1.5 border-t border-gray-50 dark:border-gray-700/20 hover:bg-gray-50/50 dark:hover:bg-gray-800/20 transition-colors">
                                                <div class="w-5 h-5 rounded flex items-center justify-center shrink-0 text-white text-[8px]"
                                                    :style="'background:' + getCategoryColor(att.category)">
                                                    <iconify-icon :icon="getCategoryIcon(att.category)" width="11"></iconify-icon>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <a :href="getFileUrl(att)" target="_blank"
                                                        class="text-[10px] font-medium text-gray-600 dark:text-gray-300 hover:text-primary truncate block transition-colors"
                                                        x-text="att.originalName"></a>
                                                    <div class="flex items-center gap-1">
                                                        <span class="text-[8px] text-gray-400" x-text="formatSize(att.size)"></span>
                                                        <template x-if="att.isGenerated">
                                                            <span class="text-[7px] bg-success/10 text-success px-1 rounded font-bold">SmartDoc</span>
                                                        </template>
                                                    </div>
                                                </div>
                                                <button type="button" @click.stop="deleteAttachment(att._id)"
                                                    class="opacity-0 group-hover:opacity-100 w-4 h-4 flex items-center justify-center rounded text-gray-400 hover:text-danger transition-all shrink-0">
                                                    <iconify-icon icon="solar:trash-bin-trash-bold" width="10"></iconify-icon>
                                                </button>
                                            </div>
                                        </template>
                                    </div>

                                    <!-- Empty state (minimalist) -->
                                    <template x-if="attachments.length === 0 && !uploading">
                                        <div class="flex items-center justify-center py-3 border-t border-gray-50 dark:border-gray-700/20">
                                            <button type="button" @click.stop="showUploadModal = true"
                                                class="flex items-center gap-1.5 text-[10px] text-gray-400 hover:text-primary transition-colors">
                                                <iconify-icon icon="solar:add-circle-linear" width="14"></iconify-icon>
                                                <span>Ajouter un fichier</span>
                                            </button>
                                        </div>
                                    </template>

                                    <!-- Upload Modal -->
                                    <template x-teleport="body">
                                        <div x-show="showUploadModal" x-transition:enter="transition ease-out duration-200"
                                            x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
                                            x-transition:leave="transition ease-in duration-150"
                                            x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                                            class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/40 backdrop-blur-sm"
                                            style="display:none;"
                                            @click.self="showUploadModal = false">
                                            <div class="bg-white dark:bg-[#1b2e4b] rounded-2xl shadow-2xl w-[420px] max-w-[90vw] overflow-hidden"
                                                @click.stop>
                                                <!-- Modal Header -->
                                                <div class="flex items-center justify-between px-5 py-3.5 border-b border-gray-100 dark:border-gray-700">
                                                    <div class="flex items-center gap-2.5">
                                                        <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
                                                            <iconify-icon icon="solar:cloud-upload-bold-duotone" width="18" class="text-primary"></iconify-icon>
                                                        </div>
                                                        <div>
                                                            <h4 class="text-sm font-bold text-gray-800 dark:text-white">Ajouter des fichiers</h4>
                                                            <p class="text-[10px] text-gray-400">Glissez-déposez ou sélectionnez des fichiers</p>
                                                        </div>
                                                    </div>
                                                    <button type="button" @click="showUploadModal = false"
                                                        class="w-7 h-7 rounded-lg flex items-center justify-center text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all">
                                                        <iconify-icon icon="solar:close-circle-linear" width="16"></iconify-icon>
                                                    </button>
                                                </div>
                                                <!-- Drop Area -->
                                                <div class="p-5">
                                                    <div class="border-2 border-dashed rounded-xl p-8 text-center transition-all cursor-pointer"
                                                        :class="isDragging ? 'border-primary bg-primary/5' : 'border-gray-200 dark:border-gray-600 hover:border-primary/40 hover:bg-primary/[0.02]'"
                                                        @click="$refs.modalFileInput.click()"
                                                        @dragover.prevent="isDragging = true"
                                                        @dragleave.prevent="isDragging = false"
                                                        @drop.prevent="handleModalDrop($event)">
                                                        <iconify-icon :icon="isDragging ? 'solar:cloud-download-bold-duotone' : 'solar:cloud-upload-bold-duotone'"
                                                            width="40" :class="isDragging ? 'text-primary' : 'text-gray-300'"></iconify-icon>
                                                        <p class="text-sm font-medium mt-2" :class="isDragging ? 'text-primary' : 'text-gray-500 dark:text-gray-400'">
                                                            <span x-text="isDragging ? 'Déposer ici' : 'Glissez vos fichiers ici'"></span>
                                                        </p>
                                                        <p class="text-[10px] text-gray-400 mt-1">ou cliquez pour parcourir</p>
                                                    </div>
                                                    <input type="file" x-ref="modalFileInput" multiple class="hidden"
                                                        @change="handleModalFiles($event.target.files)"
                                                        accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.mp4,.webm,.mp3,.wav,.zip,.rar,.txt,.csv">
                                                    <!-- Upload progress in modal -->
                                                    <template x-if="uploading">
                                                        <div class="flex items-center gap-2 mt-3 p-2 rounded-lg bg-primary/5">
                                                            <iconify-icon icon="line-md:loading-twotone-loop" width="14" class="text-primary"></iconify-icon>
                                                            <span class="text-xs text-primary font-medium">Upload en cours...</span>
                                                        </div>
                                                    </template>
                                                </div>
                                                <!-- Modal Footer -->
                                                <div class="flex items-center justify-between px-5 py-3 border-t border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/30">
                                                    <span class="text-[10px] text-gray-400" x-text="attachments.length + ' fichier(s) joint(s)'"></span>
                                                    <button type="button" @click="showUploadModal = false"
                                                        class="btn btn-sm btn-primary text-[11px] px-4 py-1.5">
                                                        Terminé
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </template>

                                    <!-- Empty state -->
                                    <div x-show="attachments.length === 0 && !uploading && !recordId" class="text-center px-3 py-2 border-t border-gray-50 dark:border-gray-700/20">
                                        <span class="text-[9px] text-gray-400 italic">Aucune pièce jointe</span>
                                    </div>
                                </div>

                            </div>
                            </div><!-- end panel-sortable-item attachments -->
                        <% } else if (sectionId==='smartdoc' && locals.entity && entity.enableAttachments) { %>
                            <!-- ✨ Documents modèles (Standalone Panel) -->
                            <div class="panel-sortable-item" data-panel-id="smartdoc">
                                <template x-if="designMode">
                                    <div class="panel-drag-handle">
                                        <iconify-icon icon="tabler:grip-horizontal" width="16"></iconify-icon>
                                        <span>Documents modèles</span>
                                    </div>
                                </template>
                            <div class="panel !p-0 overflow-hidden" data-id="smartdoc"
                                x-data='smartDocPanel({
                                    recordId: "<%= locals.record && record._id ? record._id : '' %>",
                                    accountNumber: "<%= account_number %>",
                                    entityName: "<%= locals.entity ? entity.name : '' %>"
                                })'>
                                <!-- Header -->
                                <div class="flex items-center justify-between px-3 py-2 cursor-pointer hover:bg-gray-50/50 dark:hover:bg-gray-800/30 transition-colors"
                                    @click="isOpen = !isOpen">
                                    <div class="flex items-center gap-1.5">
                                        <iconify-icon icon="solar:document-medicine-bold-duotone" width="14" class="text-primary"></iconify-icon>
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Documents modèles</span>
                                        <span x-show="smartDocTemplates.length > 0" class="text-[9px] bg-primary/10 text-primary min-w-[16px] h-4 rounded-full flex items-center justify-center font-bold px-1" x-text="smartDocTemplates.length"></span>
                                        <button type="button" @click.stop="showNewDocModal = true" class="w-5 h-5 flex items-center justify-center rounded-full border border-dashed border-gray-300 dark:border-gray-600 text-gray-400 dark:text-gray-500 hover:border-primary hover:text-primary hover:bg-primary/5 transition-all ml-0.5" title="Nouveau document">
                                            <iconify-icon icon="tabler:plus" width="11"></iconify-icon>
                                        </button>
                                    </div>
                                    <iconify-icon icon="solar:alt-arrow-down-bold" width="12" :class="isOpen ? '' : '-rotate-90'" class="transition-transform text-gray-300"></iconify-icon>
                                </div>

                                <div x-show="isOpen" x-collapse>
                                    <template x-if="recordId">
                                        <div class="px-1.5 pb-1.5">
                                            <template x-if="smartDocTemplates.length > 0">
                                                <div>
                                                    <template x-for="tpl in smartDocTemplates" :key="tpl._id">
                                                        <div class="group/sdoc flex items-center gap-2 px-2 py-[5px] rounded-md transition-all hover:bg-gray-50 dark:hover:bg-gray-800/40 cursor-default">
                                                            <!-- Doc icon -->
                                                            <div class="w-[22px] h-[22px] rounded flex items-center justify-center shrink-0"
                                                                :style="'background:' + (tpl.color || '#4361ee') + '18; color:' + (tpl.color || '#4361ee')">
                                                                <iconify-icon :icon="tpl.icon || 'solar:document-text-bold-duotone'" width="12"></iconify-icon>
                                                            </div>
                                                            <!-- Title -->
                                                            <span class="flex-1 min-w-0 text-[11px] font-medium text-gray-600 dark:text-gray-300 truncate" x-text="tpl.name"></span>
                                                            <!-- Generate button (always visible) -->
                                                            <button type="button" @click.stop="generateSmartDoc(tpl)" :disabled="generatingDocId === tpl._id"
                                                                class="shrink-0 w-[22px] h-[22px] flex items-center justify-center rounded transition-all"
                                                                :style="generatingDocId === tpl._id ? 'color:#9ca3af' : 'color:#00ab55; background:rgba(0,171,85,0.08)'"
                                                                @mouseenter="if(generatingDocId !== tpl._id) $el.style.background='rgba(0,171,85,0.16)'"
                                                                @mouseleave="if(generatingDocId !== tpl._id) $el.style.background='rgba(0,171,85,0.08)'"
                                                                title="Générer">
                                                                <iconify-icon :icon="generatingDocId === tpl._id ? 'line-md:loading-twotone-loop' : 'solar:play-bold'" width="11"></iconify-icon>
                                                            </button>
                                                            <!-- Edit button (always visible) -->
                                                            <a :href="'/account/<%= account_number %>/documents/' + tpl.documentId + '/edit-react'" target="_blank"
                                                                class="shrink-0 w-[22px] h-[22px] flex items-center justify-center rounded transition-all"
                                                                style="color:#4361ee; background:rgba(67,97,238,0.08)"
                                                                @mouseenter="$el.style.background='rgba(67,97,238,0.16)'"
                                                                @mouseleave="$el.style.background='rgba(67,97,238,0.08)'"
                                                                title="Modifier le modèle"
                                                                x-show="tpl.documentId" @click.stop>
                                                                <iconify-icon icon="solar:pen-new-square-linear" width="11"></iconify-icon>
                                                            </a>
                                                            <!-- Unlink button (always visible) -->
                                                            <button type="button" @click.stop="confirmUnlink(tpl)"
                                                                class="shrink-0 w-[22px] h-[22px] flex items-center justify-center rounded transition-all"
                                                                style="color:#e7515a; background:rgba(231,81,90,0.08)"
                                                                @mouseenter="$el.style.background='rgba(231,81,90,0.16)'"
                                                                @mouseleave="$el.style.background='rgba(231,81,90,0.08)'"
                                                                title="Délier ce document">
                                                                <iconify-icon icon="solar:link-broken-minimalistic-linear" width="11"></iconify-icon>
                                                            </button>
                                                        </div>
                                                    </template>
                                                </div>
                                            </template>
                                            <template x-if="smartDocTemplates.length === 0">
                                                <div class="flex flex-col items-center py-3 gap-1.5">
                                                    <iconify-icon icon="solar:document-add-linear" width="20" class="text-gray-300 dark:text-gray-600"></iconify-icon>
                                                    <p class="text-[9px] text-gray-400">Aucun document modèle</p>
                                                    <button type="button" @click.stop="showNewDocModal = true"
                                                        class="text-[9px] font-semibold text-primary hover:underline transition-all">+ Créer</button>
                                                </div>
                                            </template>
                                        </div>
                                    </template>
                                    <template x-if="!recordId">
                                        <div class="text-center px-3 py-2">
                                            <span class="text-[9px] text-gray-400 italic">Enregistrez d'abord</span>
                                        </div>
                                    </template>
                                </div>

                                    <!-- New Document Choice Modal -->
                                    <template x-teleport="body">
                                        <div x-show="showNewDocModal" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
                                            x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                                            class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/60 backdrop-blur-sm" style="display:none;"
                                            @click.self="showNewDocModal = false">
                                            <div class="bg-white dark:bg-[#1b2e4b] rounded-2xl shadow-2xl w-[400px] max-w-[90vw] overflow-hidden animate__animated animate__fadeInUp animate__faster" @click.stop>
                                                <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center">
                                                            <iconify-icon icon="solar:document-add-bold-duotone" width="20" class="text-primary"></iconify-icon>
                                                        </div>
                                                        <div>
                                                            <h4 class="text-sm font-bold text-gray-800 dark:text-white">Nouveau document</h4>
                                                            <p class="text-[10px] text-gray-400">Choisissez le type de document à créer</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="p-4 space-y-3">
                                                    <!-- Document Simple -->
                                                    <button type="button" @click="createSimpleDoc()" 
                                                        class="w-full flex items-start gap-3 p-3 rounded-xl border border-gray-100 dark:border-gray-700 hover:border-primary/30 hover:bg-primary/[0.02] transition-all text-left group/choice">
                                                        <div class="w-10 h-10 rounded-xl bg-info/10 flex items-center justify-center shrink-0 group-hover/choice:scale-110 transition-transform">
                                                            <iconify-icon icon="solar:document-text-bold-duotone" width="22" class="text-info"></iconify-icon>
                                                        </div>
                                                        <div>
                                                            <span class="text-[12px] font-bold text-gray-700 dark:text-gray-200 block">Document simple</span>
                                                            <span class="text-[10px] text-gray-400 leading-snug block mt-0.5">Créer un document unique lié à cet enregistrement</span>
                                                        </div>
                                                    </button>
                                                    <!-- Document Modèle -->
                                                    <button type="button" @click="openSmartDocEditor()"
                                                        class="w-full flex items-start gap-3 p-3 rounded-xl border border-gray-100 dark:border-gray-700 hover:border-warning/30 hover:bg-warning/[0.02] transition-all text-left group/choice">
                                                        <div class="w-10 h-10 rounded-xl bg-warning/10 flex items-center justify-center shrink-0 group-hover/choice:scale-110 transition-transform">
                                                            <iconify-icon icon="solar:copy-bold-duotone" width="22" class="text-warning"></iconify-icon>
                                                        </div>
                                                        <div>
                                                            <span class="text-[12px] font-bold text-gray-700 dark:text-gray-200 block">Document modèle</span>
                                                            <span class="text-[10px] text-gray-400 leading-snug block mt-0.5">Réutilisable pour d'autres <span class="lowercase"><%= locals.entity ? entity.name : 'enregistrements' %></span> — génère un PDF à chaque utilisation</span>
                                                        </div>
                                                    </button>
                                                </div>
                                                <div class="px-5 py-3 border-t border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/30 flex justify-end">
                                                    <button type="button" @click="showNewDocModal = false" class="btn btn-sm btn-outline-secondary text-[10px] px-4 py-1.5">Annuler</button>
                                                </div>
                                            </div>
                                        </div>
                                    </template>

                                    <!-- Unlink Confirmation Modal -->
                                    <template x-teleport="body">
                                        <div x-show="showUnlinkConfirm" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
                                            x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                                            class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/60 backdrop-blur-sm" style="display:none;"
                                            @click.self="showUnlinkConfirm = false">
                                            <div class="bg-white dark:bg-[#1b2e4b] rounded-2xl shadow-2xl w-[380px] max-w-[90vw] overflow-hidden" @click.stop>
                                                <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-9 h-9 rounded-xl bg-danger/10 flex items-center justify-center">
                                                            <iconify-icon icon="solar:link-broken-minimalistic-bold" width="20" class="text-danger"></iconify-icon>
                                                        </div>
                                                        <div>
                                                            <h4 class="text-sm font-bold text-gray-800 dark:text-white">Délier le document</h4>
                                                            <p class="text-[10px] text-gray-400">Cette action est irréversible</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="px-5 py-4">
                                                    <p class="text-xs text-gray-600 dark:text-gray-300">
                                                        Le document modèle «&nbsp;<strong class="text-gray-800 dark:text-white" x-text="unlinkTarget?.name"></strong>&nbsp;» ne sera plus lié à cette collection.
                                                        Il restera disponible dans vos documents mais ne pourra plus générer de PDF pour cet enregistrement.
                                                    </p>
                                                </div>
                                                <div class="px-5 py-3 border-t border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/30 flex items-center justify-end gap-2">
                                                    <button type="button" @click="showUnlinkConfirm = false" class="btn btn-sm btn-outline-secondary text-[10px] px-3 py-1.5">Annuler</button>
                                                    <button type="button" @click="executeUnlink()" :disabled="unlinking"
                                                        class="btn btn-sm text-[10px] px-4 py-1.5 flex items-center gap-1.5 bg-danger text-white hover:bg-danger/90 transition-all">
                                                        <iconify-icon :icon="unlinking ? 'line-md:loading-twotone-loop' : 'solar:link-broken-minimalistic-bold'" width="13"></iconify-icon>
                                                        <span x-text="unlinking ? 'Suppression...' : 'Délier'"></span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </template>

                                    <!-- SmartDoc Input Modal -->
                                    <template x-if="showSmartDocModal">
                                        <div class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/40 backdrop-blur-sm" @click.self="showSmartDocModal = false">
                                            <div class="bg-white dark:bg-[#1b2e4b] rounded-xl shadow-2xl w-[380px] max-w-[90vw] overflow-hidden animate__animated animate__fadeInUp animate__faster">
                                                <div class="px-5 py-4 border-b dark:border-gray-700 bg-gradient-to-r from-warning/5 to-transparent">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-9 h-9 rounded-lg flex items-center justify-center"
                                                            :style="'background:' + (smartDocModalTemplate?.color || '#e2a03f') + '15; color:' + (smartDocModalTemplate?.color || '#e2a03f')">
                                                            <iconify-icon :icon="smartDocModalTemplate?.icon || 'solar:document-bold-duotone'" width="20"></iconify-icon>
                                                        </div>
                                                        <div>
                                                            <h4 class="text-sm font-bold text-gray-800 dark:text-white" x-text="smartDocModalTemplate?.name"></h4>
                                                            <p class="text-[10px] text-gray-400">Renseignez les informations requises</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="px-5 py-4 space-y-3 max-h-[50vh] overflow-y-auto">
                                                    <template x-for="field in smartDocModalTemplate?.inputFields || []" :key="field._id || field.key">
                                                        <div>
                                                            <label class="text-[11px] font-semibold text-gray-600 dark:text-gray-300 mb-1 block">
                                                                <span x-text="field.label"></span>
                                                                <span x-show="field.required" class="text-danger text-[10px]">*</span>
                                                            </label>
                                                            <template x-if="field.type === 'date'">
                                                                <input type="date" class="form-input text-xs !h-9" :name="field.key" x-model="smartDocModalInputs[field.key]">
                                                            </template>
                                                            <template x-if="field.type === 'number'">
                                                                <input type="number" class="form-input text-xs !h-9" :name="field.key" :placeholder="field.placeholder || ''" x-model="smartDocModalInputs[field.key]">
                                                            </template>
                                                            <template x-if="field.type === 'textarea'">
                                                                <textarea class="form-input text-xs" rows="3" :name="field.key" :placeholder="field.placeholder || ''" x-model="smartDocModalInputs[field.key]"></textarea>
                                                            </template>
                                                            <template x-if="field.type === 'select'">
                                                                <select class="form-input text-xs !h-9" :name="field.key" x-model="smartDocModalInputs[field.key]">
                                                                    <option value="">-- Choisir --</option>
                                                                    <template x-for="opt in field.options || []" :key="opt.value">
                                                                        <option :value="opt.value" x-text="opt.label"></option>
                                                                    </template>
                                                                </select>
                                                            </template>
                                                            <template x-if="!field.type || field.type === 'text'">
                                                                <input type="text" class="form-input text-xs !h-9" :name="field.key" :placeholder="field.placeholder || ''" x-model="smartDocModalInputs[field.key]">
                                                            </template>
                                                        </div>
                                                    </template>
                                                </div>
                                                <div class="px-5 py-3 border-t dark:border-gray-700 flex items-center justify-end gap-2 bg-gray-50/50 dark:bg-gray-800/30">
                                                    <button type="button" @click="showSmartDocModal = false" class="btn btn-sm btn-outline-secondary text-[10px] px-3 py-1.5">Annuler</button>
                                                    <button type="button" @click="confirmSmartDocGeneration()" :disabled="generatingDocId"
                                                        class="btn btn-sm btn-primary text-[10px] px-4 py-1.5 flex items-center gap-1.5">
                                                        <iconify-icon :icon="generatingDocId ? 'line-md:loading-twotone-loop' : 'solar:magic-stick-3-bold'" width="14"></iconify-icon>
                                                        <span x-text="generatingDocId ? 'Génération...' : 'Générer'"></span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </template>

                                    <!-- ✨ SmartDoc Preview Modal -->
                                    <template x-teleport="body">
                                        <div x-show="showSmartDocPreview" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
                                            x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                                            class="fixed inset-0 flex flex-col bg-white" style="display:none; z-index: 99998;">
                                            <!-- Editor Header -->
                                            <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 bg-white" style="min-height: 52px;">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary/20 to-info/20 flex items-center justify-center">
                                                        <iconify-icon icon="solar:pen-new-square-bold-duotone" width="20" class="text-primary"></iconify-icon>
                                                    </div>
                                                    <div>
                                                        <h3 class="text-[13px] font-bold text-gray-800" x-text="previewOutputName || 'Document en cours de génération'"></h3>
                                                        <p class="text-[10px] text-gray-400 flex items-center gap-1">
                                                            <iconify-icon icon="solar:pen-2-bold" width="10" class="text-info"></iconify-icon>
                                                            Modifiez le contenu si nécessaire, puis finalisez pour générer le PDF
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="flex items-center gap-2">
                                                    <button type="button" @click="cancelSmartDocPreview()"
                                                        :disabled="finalizingDraft"
                                                        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-medium text-gray-500 hover:text-danger hover:bg-danger/5 border border-gray-200 transition-all">
                                                        <iconify-icon icon="solar:close-circle-linear" width="14"></iconify-icon>
                                                        Annuler
                                                    </button>
                                                    <button type="button" @click="confirmSmartDocPreview()"
                                                        :disabled="finalizingDraft"
                                                        class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-[11px] font-bold bg-success text-white hover:bg-success/90 transition-all shadow-sm disabled:opacity-50">
                                                        <iconify-icon :icon="finalizingDraft ? 'line-md:loading-twotone-loop' : 'solar:check-circle-bold'" width="14"></iconify-icon>
                                                        <span x-text="finalizingDraft ? 'Génération en cours...' : 'Finaliser et générer le PDF'"></span>
                                                    </button>
                                                </div>
                                            </div>
                                            <!-- Full-screen Editor (React editor in iframe) -->
                                            <div class="flex-1 overflow-hidden">
                                                <iframe id="smartdoc-preview-iframe-sd" class="w-full h-full border-0" allow="clipboard-read; clipboard-write"></iframe>
                                            </div>
                                        </div>
                                    </template>

                                    <!-- ✨ SmartDoc Editor Modal (Full-screen React Island) -->
                                    <template x-teleport="body">
                                        <div x-show="showSmartDocEditor" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
                                            x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                                            class="fixed inset-0 flex flex-col bg-white" style="display:none; z-index: 99999;">
                                            <div class="flex items-center justify-between px-4 py-2 border-b border-gray-200 bg-gray-50" style="min-height: 48px;">
                                                <div class="flex items-center gap-3">
                                                    <iconify-icon icon="solar:magic-stick-3-bold-duotone" width="18" class="text-warning"></iconify-icon>
                                                    <span class="text-sm font-bold text-gray-700">Nouveau SmartDoc</span>
                                                    <span class="text-[10px] text-gray-400">— lié à <strong><%= locals.entity ? entity.name : '' %></strong></span>
                                                </div>
                                                <div class="flex items-center gap-2">
                                                    <span x-show="smartDocTitleError" x-transition
                                                        class="text-[11px] text-danger font-medium flex items-center gap-1" style="display:none;">
                                                        <iconify-icon icon="solar:danger-triangle-bold" width="14"></iconify-icon>
                                                        <span x-text="smartDocTitleError"></span>
                                                    </span>
                                                    <button type="button" @click="finishSmartDocEditor()"
                                                        class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-xs font-bold bg-success text-white hover:bg-success/90 transition-all shadow-sm">
                                                        <iconify-icon icon="solar:check-circle-bold" width="16"></iconify-icon>
                                                        Terminer
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="flex-1 overflow-hidden">
                                                <div id="smartdoc-editor-mount-sd" class="h-full"></div>
                                            </div>
                                        </div>
                                    </template>

                            </div>
                            </div><!-- end panel-sortable-item smartdoc -->

                        <% } else if (sectionId==='relations') { %>
                            <!-- 👤 Relations / Patient (Sidebar Panel) -->
                            <% (entity.relations || []).forEach(function(rel) { %>
                                <% const relRecords = locals.relatedRecordsData && locals.relatedRecordsData[rel.key]; %>
                                <% if (relRecords && relRecords.length > 0) { %>
                                    <% relRecords.forEach(function(relRec) { %>
                                        <% const relIcon = (rel.targetEntity && rel.targetEntity.icon) || 'solar:user-bold-duotone'; %>
                                        <% const relColor = (rel.targetEntity && rel.targetEntity.color) || '#4361ee'; %>
                                        <% const relEntityName = (rel.targetEntity && rel.targetEntity.name) || rel.label || 'Relation'; %>
                                        <% const relEntitySlug = (rel.targetEntity && rel.targetEntity.slug) || ''; %>
                                        <div class="panel-sortable-item" data-panel-id="relation-<%= rel.key %>">
                                            <template x-if="designMode">
                                                <div class="panel-drag-handle">
                                                    <iconify-icon icon="tabler:grip-horizontal" width="16"></iconify-icon>
                                                    <span><%= rel.label || relEntityName %></span>
                                                </div>
                                            </template>
                                        <div class="panel !p-0 overflow-hidden" x-data="{ open: true }">
                                            <div class="flex items-center justify-between px-3 py-2 border-b border-gray-50 dark:border-gray-700/30">
                                                <div class="flex items-center gap-2 cursor-pointer flex-1" @click="open = !open">
                                                    <div class="w-6 h-6 rounded-lg flex items-center justify-center flex-none" style="background: <%= relColor %>15;">
                                                        <iconify-icon icon="<%= relIcon %>" width="12" style="color: <%= relColor %>"></iconify-icon>
                                                    </div>
                                                    <div class="min-w-0">
                                                        <span class="text-[9px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500"><%= rel.label || relEntityName %></span>
                                                        <div class="text-[12px] font-semibold text-gray-700 dark:text-gray-200 -mt-0.5 truncate"><%= relRec.title || 'Sans titre' %></div>
                                                    </div>
                                                </div>
                                                <div class="flex items-center gap-1 flex-none">
                                                    <% if (relEntitySlug) { %>
                                                        <a href="/account/<%= account_number %>/record/<%= relEntitySlug %>/edit/<%= relRec._id %>"
                                                            class="flex items-center justify-center w-5 h-5 rounded-md text-gray-400 hover:text-primary hover:bg-primary/5 transition-all"
                                                            title="Ouvrir" target="_blank">
                                                            <iconify-icon icon="solar:arrow-right-up-linear" width="12"></iconify-icon>
                                                        </a>
                                                    <% } %>
                                                    <button type="button" @click="open = !open"
                                                        class="flex items-center justify-center w-5 h-5 rounded-md text-gray-400 hover:text-gray-600 transition-all">
                                                        <iconify-icon :icon="open ? 'solar:alt-arrow-up-linear' : 'solar:alt-arrow-down-linear'" width="12"></iconify-icon>
                                                    </button>
                                                </div>
                                            </div>
                                            <div x-show="open" x-collapse class="px-3 py-2">
                                                <div class="grid grid-cols-1 gap-y-2">
                                                    <% if (relRec.slug) { %>
                                                        <div>
                                                            <div class="text-[9px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-0.5">Identifiant</div>
                                                            <div class="text-xs text-gray-700 dark:text-gray-300"><%= relRec.slug %></div>
                                                        </div>
                                                    <% } %>
                                                    <% if (relRec.date) { %>
                                                        <div>
                                                            <div class="text-[9px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-0.5">Date</div>
                                                            <div class="text-xs text-gray-700 dark:text-gray-300"><%= new Date(relRec.date).toLocaleDateString('fr-FR') %></div>
                                                        </div>
                                                    <% } %>
                                                    <% (relRec.customFields || []).forEach(function(cf) { %>
                                                        <% if (cf.value && cf.field_id && cf.field_id.label) { %>
                                                            <div>
                                                                <div class="text-[9px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-0.5"><%= cf.field_id.label %></div>
                                                                <div class="text-xs text-gray-700 dark:text-gray-300 line-clamp-2">
                                                                    <% if (typeof cf.value === 'object' && cf.value !== null) { %>
                                                                        <%= JSON.stringify(cf.value) %>
                                                                    <% } else { %>
                                                                        <%= String(cf.value).substring(0, 80) %><%= String(cf.value).length > 80 ? '...' : '' %>
                                                                    <% } %>
                                                                </div>
                                                            </div>
                                                        <% } %>
                                                    <% }) %>
                                                </div>
                                            </div>
                                        </div>
                                        </div><!-- end panel-sortable-item relation -->
                                    <% }) %>
                                <% } %>
                            <% }) %>
                        <% } else if (sectionId==='lines') { %>
                            <!-- 📊 Lines Generator Panel -->
                            <div class="panel-sortable-item" data-panel-id="lines">
                                <template x-if="designMode">
                                    <div class="panel-drag-handle">
                                        <iconify-icon icon="tabler:grip-horizontal" width="16"></iconify-icon>
                                        <span>Lignes</span>
                                    </div>
                                </template>
                                <%- include('record-lines') %>
                            </div><!-- end panel-sortable-item lines -->
                        <% } %>
                    <% }); %>
    </div>

    <style>
        .sortable-ghost {
            opacity: 0.3;
            border: 1px dashed #4361ee;
            background: #eef2ff;
        }

        /* Invisible target for empty parent lists - expands on drag */
        .nested-sortable-list {
            min-height: 2px;
            transition: all 0.2s;
        }

        /* While dragging, show empty lists as catch areas */
        .sortable-chosen .nested-sortable-list {
            min-height: 10px;
            background: rgba(67, 97, 238, 0.02);
            margin-bottom: 4px;
            border-radius: 4px;
            transition: all 0.2s;
        }

        /* Dynamic Arrow logic: only show prefix-arrow if the item is nested */
        .prefix-arrow {
            display: none !important;
        }

        .sort-item .sort-item .prefix-arrow {
            display: inline !important;
        }


        /* Outdent/Indent visual cues */
        .sort-item {
            transition: margin-left 0.2s;
        }
    </style>

    <script>
        document.addEventListener("alpine:init", () => {
            Alpine.data("recordSidebar", () => ({
                classificationsOpen: true,
                init() {
                    // Drag & drop is handled by panelLayout.initPanelSortables() in record-edit.ejs
                    window.addEventListener('save-pref', (e) => {
                        this.savePreference(e.detail.key, e.detail.value);
                    });
                },
                async savePreference(key, value) {
                    try {
                        await fetch('/user/preferences', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ key, value })
                        });
                    } catch (e) { console.error('Failed to save preference', e); }
                }
            }));

            Alpine.data("classificationBox", (clsId, nameAttr, allowMultiple, initialOpen = true) => ({
                editing: false,
                newLabel: '',
                loading: false,
                isOpen: initialOpen,

                toggleList() {
                    this.isOpen = !this.isOpen;
                    window.dispatchEvent(new CustomEvent('save-pref', {
                        detail: { key: `sidebar_classification_${clsId}`, value: this.isOpen }
                    }));
                },

                toggleEdit() {
                    this.editing = !this.editing;
                    if (this.editing) {
                        this.$nextTick(() => {
                            if (this.$refs.input) this.$refs.input.focus();
                        });
                    }
                },

                async save() {
                    if (!this.newLabel) return;
                    this.loading = true;
                    try {
                        const res = await fetch(`/account/<%= account_number %>/classification/api/fast-add`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ classificationId: clsId, label: this.newLabel })
                        });
                        const data = await res.json();
                        if (data.success) {
                            // For tree view (hierarchical)
                            const tree = document.querySelector(`#tree-${clsId}`);
                            if (tree) {
                                const rootUl = tree.querySelector(':scope > ul');
                                if (rootUl) {
                                    const li = document.createElement('li');
                                    li.className = 'sort-item group/item';
                                    li.dataset.id = data.option._id;
                                    li.innerHTML = `
                                    <div class="flex items-center gap-1 h-[20px]">
                                        <div class="handle cursor-grab opacity-20 group-hover/item:opacity-100 transition-opacity text-gray-400 p-0.5 -ml-1 flex items-center">
                                            <iconify-icon icon="tabler:grip-vertical" width="14"></iconify-icon>
                                        </div>
                                        <label class="flex items-center gap-2 cursor-pointer mb-0 flex-1 min-w-0">
                                            <input type="${allowMultiple ? 'checkbox' : 'radio'}" 
                                                   name="${nameAttr}${allowMultiple ? '[]' : ''}" 
                                                   value="${data.option._id}" 
                                                   class="${allowMultiple ? 'form-checkbox' : 'form-radio'} w-3.5 h-3.5"
                                                   checked>
                                            <span class="text-[11px] truncate flex items-center gap-1 text-primary font-bold">
                                                <span class="prefix-arrow text-gray-300 font-normal">└</span>
                                                ${data.option.label}
                                            </span>
                                        </label>
                                    </div>
                                    <ul class="nested-sortable-list space-y-0.5" data-parent-id="${data.option._id}"></ul>
                                `;
                                    rootUl.appendChild(li);
                                    this.initSortable();
                                }
                            } else {
                                // For simple select
                                const select = document.querySelector(`select[name="${nameAttr}"]`);
                                if (select) {
                                    const opt = document.createElement('option');
                                    opt.value = data.option._id;
                                    opt.textContent = data.option.label;
                                    opt.selected = true;
                                    select.appendChild(opt);
                                    select.dispatchEvent(new Event('change'));
                                }
                            }
                            this.newLabel = '';
                            this.editing = false;
                            // Dispatch event for tags component
                            window.dispatchEvent(new CustomEvent('tag-added', { detail: { clsId: clsId, option: data.option } }));
                        }
                    } catch (e) { console.error(e); } finally { this.loading = false; }
                },

                // Tree View Reordering
                init() {
                    this.$nextTick(() => this.initSortable());
                    window.addEventListener('close-edit-' + clsId, () => { this.editing = false; });
                },
                initSortable() {
                    const containers = document.querySelectorAll(`#tree-${clsId} ul`);
                    const self = this;
                    containers.forEach(el => {
                        if (el.dataset.sortable) return;
                        el.dataset.sortable = "true";
                        new Sortable(el, {
                            group: `nested-${clsId}`,
                            animation: 150,
                            handle: '.handle',
                            ghostClass: 'sortable-ghost',
                            onStart: () => document.body.classList.add('is-dragging'),
                            onEnd: () => {
                                document.body.classList.remove('is-dragging');
                                self.saveReorder();
                            }
                        });
                    });
                },
                async saveReorder() {
                    const options = [];
                    const tree = document.getElementById(`tree-${clsId}`);
                    if (!tree) return;
                    const traverse = (container, parentId = null) => {
                        const items = Array.from(container.children).filter(li => li.tagName === 'LI' && li.dataset.id);
                        items.forEach((li, idx) => {
                            options.push({ id: li.dataset.id, parentId: parentId, order: idx });
                            const sub = li.querySelector(':scope > ul');
                            if (sub) traverse(sub, li.dataset.id);
                        });
                    };
                    const root = tree.querySelector(':scope > ul');
                    if (root) traverse(root);
                    try {
                        await fetch(`/account/<%= account_number %>/classification/api/reorder`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ classificationId: clsId, options })
                        });
                    } catch (e) { console.error("Reorder failed", e); }
                }
            }));

            Alpine.data("classificationTags", (clsId, nameAttr, allOptions, initialSelected) => ({
                nameAttr: nameAttr,
                options: allOptions,
                selectedIds: [], // Initialized in init()
                search: '',
                open: false,
                showAdd: false,
                localNewLabel: '',
                localLoading: false,

                init() {
                    // Filter orphan IDs (case where option was deleted but record kept the link)
                    this.selectedIds = initialSelected.filter(id =>
                        this.options.some(o => o._id.toString() === id.toString())
                    );
                },

                get filteredOptions() {
                    if (!this.search) {
                        return this.options.filter(o => !this.selectedIds.includes(o._id.toString()));
                    }
                    const s = this.search.toLowerCase();
                    return this.options.filter(o =>
                        !this.selectedIds.includes(o._id.toString()) &&
                        o.label.toLowerCase().includes(s)
                    );
                },

                get exactMatch() {
                    const s = this.search.toLowerCase();
                    return this.options.some(o => o.label.toLowerCase() === s);
                },

                getLabel(id) {
                    const opt = this.options.find(o => o._id.toString() === id.toString());
                    return opt ? opt.label : 'Inconnu';
                },

                add(id) {
                    if (!this.selectedIds.includes(id.toString())) {
                        this.selectedIds.push(id.toString());
                    }
                    this.search = '';
                    this.open = false;
                },

                remove(id) {
                    this.selectedIds = this.selectedIds.filter(i => i !== id.toString());
                },

                async fastAdd() {
                    if (!this.search) return;
                    try {
                        const res = await fetch(`/account/<%= account_number %>/classification/api/fast-add`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ classificationId: clsId, label: this.search })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.options.push(data.option);
                            this.add(data.option._id);
                        }
                    } catch (e) { console.error(e); }
                },

                async localSave() {
                    if (!this.localNewLabel) return;
                    this.localLoading = true;
                    try {
                        const res = await fetch(`/account/<%= account_number %>/classification/api/fast-add`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ classificationId: clsId, label: this.localNewLabel })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.options.push(data.option);
                            this.add(data.option._id);
                            this.localNewLabel = '';
                            this.showAdd = false;
                            window.dispatchEvent(new CustomEvent('close-edit-' + clsId));
                        }
                    } catch (e) { console.error(e); } finally { this.localLoading = false; }
                }
            }));

            // ========== ATTACHMENT PANEL ==========
            Alpine.data('attachmentPanel', (config) => ({
                recordId: config.recordId,
                accountNumber: config.accountNumber,
                attachments: config.initialAttachments || [],
                isOpen: config.initialOpen !== false,
                isDragging: false,
                uploading: false,
                showUploadModal: false,

                init() {
                    // Listen for SmartDoc-generated attachments
                    window.addEventListener('smartdoc-attachment-created', (e) => {
                        if (e.detail && e.detail.attachment) {
                            this.attachments.push(e.detail.attachment);
                        }
                    });
                },






                handleDrop(e) {
                    this.isDragging = false;
                    const files = e.dataTransfer?.files;
                    if (files && files.length > 0) this.handleFiles(files);
                },

                handleModalDrop(e) {
                    this.isDragging = false;
                    const files = e.dataTransfer?.files;
                    if (files && files.length > 0) this.handleFiles(files);
                },

                handleModalFiles(files) {
                    this.handleFiles(files);
                },

                async handleFiles(files) {
                    if (!files || files.length === 0) return;
                    if (!this.recordId) {
                        alert('Veuillez d\'abord enregistrer le record avant d\'ajouter des pièces jointes.');
                        return;
                    }
                    this.uploading = true;
                    try {
                        const formData = new FormData();
                        for (let i = 0; i < files.length; i++) {
                            formData.append('files', files[i]);
                        }
                        const res = await fetch(`/account/${this.accountNumber}/api/records/${this.recordId}/attachments`, {
                            method: 'POST',
                            credentials: 'include',
                            body: formData
                        });
                        const data = await res.json();
                        if (data.success && data.attachments) {
                            this.attachments.push(...data.attachments);
                        } else {
                            alert(data.error || 'Erreur lors de l\'upload');
                        }
                    } catch (e) {
                        console.error('Upload error:', e);
                        alert('Erreur lors de l\'upload');
                    } finally {
                        this.uploading = false;
                        // Reset file input
                        if (this.$refs.fileInput) this.$refs.fileInput.value = '';
                    }
                },

                async deleteAttachment(attachmentId) {
                    if (!confirm('Supprimer cette pièce jointe ?')) return;
                    try {
                        const res = await fetch(`/account/${this.accountNumber}/api/records/${this.recordId}/attachments/${attachmentId}`, {
                            method: 'DELETE',
                            credentials: 'include'
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.attachments = this.attachments.filter(a => a._id !== attachmentId);
                        }
                    } catch (e) { console.error('Delete error:', e); }
                },

                getFileUrl(att) {
                    return `/uploads/attachments/${this.accountNumber}/${att.filename}`;
                },

                formatSize(bytes) {
                    if (!bytes) return '';
                    if (bytes < 1024) return bytes + ' o';
                    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' Ko';
                    return (bytes / (1024 * 1024)).toFixed(1) + ' Mo';
                },

                getCategoryIcon(cat) {
                    const icons = {
                        image: 'solar:gallery-bold-duotone',
                        pdf: 'solar:file-text-bold-duotone',
                        word: 'solar:document-text-bold-duotone',
                        excel: 'solar:chart-square-bold-duotone',
                        video: 'solar:videocamera-record-bold-duotone',
                        audio: 'solar:music-notes-bold-duotone',
                        other: 'solar:file-bold-duotone'
                    };
                    return icons[cat] || icons.other;
                },

                getCategoryColor(cat) {
                    const colors = {
                        image: '#8b5cf6',
                        pdf: '#ef4444',
                        word: '#3b82f6',
                        excel: '#22c55e',
                        video: '#f97316',
                        audio: '#ec4899',
                        other: '#6b7280'
                    };
                    return colors[cat] || colors.other;
                },



            }));

            // ========== SMARTDOC PANEL (STANDALONE) ==========
            Alpine.data('smartDocPanel', (config) => ({
                recordId: config.recordId,
                accountNumber: config.accountNumber,
                entityName: config.entityName || '',
                isOpen: true,
                smartDocTemplates: [],
                generatingDocId: null,
                showSmartDocModal: false,
                smartDocModalTemplate: null,
                smartDocModalInputs: {},
                showSmartDocEditor: false,
                smartDocTitleError: '',
                showSmartDocPreview: false,
                previewHtml: '',
                previewVariables: [],
                previewAttachment: null,
                previewOutputName: '',
                // Draft-based generation (Mission 9)
                draftDocumentId: null,
                finalizingDraft: false,
                // New doc modal & unlink
                showNewDocModal: false,
                showUnlinkConfirm: false,
                unlinkTarget: null,
                unlinking: false,

                init() {
                    if (this.recordId) {
                        this.loadSmartDocTemplates();
                    }
                },

                async loadSmartDocTemplates() {
                    try {
                        const entityId = '<%= locals.entity ? entity._id : "" %>';
                        if (!entityId) return;
                        const res = await fetch(`/account/${this.accountNumber}/api/smartdoc/templates/${entityId}`, {
                            credentials: 'include'
                        });
                        const data = await res.json();
                        if (data.success && data.templates) {
                            this.smartDocTemplates = data.templates;
                        }
                    } catch (e) { console.error('[SmartDoc] Load templates error:', e); }
                },

                generateSmartDoc(tpl) {
                    if (tpl.inputFields && tpl.inputFields.length > 0) {
                        this.smartDocModalTemplate = tpl;
                        this.smartDocModalInputs = {};
                        for (const field of tpl.inputFields) {
                            if (field.defaultValue !== undefined && field.defaultValue !== null) {
                                this.smartDocModalInputs[field.key] = field.defaultValue;
                            } else {
                                this.smartDocModalInputs[field.key] = '';
                            }
                        }
                        this.showSmartDocModal = true;
                    } else {
                        this._executeGeneration(tpl._id, {});
                    }
                },

                confirmSmartDocGeneration() {
                    if (!this.smartDocModalTemplate) return;
                    const missing = [];
                    for (const field of this.smartDocModalTemplate.inputFields || []) {
                        if (field.required && !this.smartDocModalInputs[field.key]) {
                            missing.push(field.label);
                        }
                    }
                    if (missing.length > 0) {
                        alert('Veuillez remplir : ' + missing.join(', '));
                        return;
                    }
                    this._executeGeneration(
                        this.smartDocModalTemplate._id,
                        { ...this.smartDocModalInputs }
                    );
                    this.showSmartDocModal = false;
                },

                async _executeGeneration(templateId, inputs) {
                    this.generatingDocId = templateId;
                    try {
                        // Create a draft (editable copy with tokens resolved)
                        const res = await fetch(`/account/${this.accountNumber}/api/smartdoc/generate-draft/${templateId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                recordId: this.recordId,
                                inputs
                            })
                        });
                        const data = await res.json();
                        if (data.success && data.draftDocumentId) {
                            this.draftDocumentId = data.draftDocumentId;
                            this.previewOutputName = data.outputName || 'Document';
                            this.previewAttachment = null;
                            this.previewHtml = '';
                            this.previewVariables = [];
                            this.showSmartDocPreview = true;

                            // Open the React editor in the iframe with the draft document
                            this.$nextTick(() => {
                                const iframe = document.getElementById('smartdoc-preview-iframe-sd');
                                if (iframe) {
                                    iframe.src = `/account/${this.accountNumber}/documents/${data.draftDocumentId}/edit-react?minimal=true`;
                                }
                            });
                        } else {
                            alert(data.error || 'Erreur lors de la génération');
                        }
                    } catch (e) {
                        console.error('[SmartDoc] Generation error:', e);
                        alert('Erreur lors de la génération du document');
                    } finally {
                        this.generatingDocId = null;
                    }
                },

                async confirmSmartDocPreview() {
                    if (!this.draftDocumentId) return;
                    this.finalizingDraft = true;
                    try {
                        // Finalize: generate PDF from the (possibly edited) draft
                        const res = await fetch(`/account/${this.accountNumber}/api/smartdoc/finalize-draft/${this.draftDocumentId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                recordId: this.recordId
                            })
                        });
                        const data = await res.json();
                        if (data.success && data.attachment) {
                            // Dispatch event so attachmentPanel can pick it up
                            window.dispatchEvent(new CustomEvent('smartdoc-attachment-created', {
                                detail: { attachment: data.attachment }
                            }));
                            if (window.showMessage) {
                                window.showMessage('Document généré avec succès !', 'success');
                            }
                        } else {
                            alert(data.error || 'Erreur lors de la finalisation');
                        }
                    } catch (e) {
                        console.error('[SmartDoc] Finalize error:', e);
                        alert('Erreur lors de la finalisation du document');
                    } finally {
                        this.finalizingDraft = false;
                        this.showSmartDocPreview = false;
                        this.draftDocumentId = null;
                        this.previewAttachment = null;
                        this.previewHtml = '';
                        this.previewVariables = [];
                        this.previewOutputName = '';
                    }
                },

                async cancelSmartDocPreview() {
                    // Delete the draft document
                    if (this.draftDocumentId) {
                        try {
                            await fetch(`/account/${this.accountNumber}/api/smartdoc/draft/${this.draftDocumentId}`, {
                                method: 'DELETE',
                                credentials: 'include'
                            });
                        } catch (e) {
                            console.error('[SmartDoc] Cancel draft delete error:', e);
                        }
                    }
                    this.showSmartDocPreview = false;
                    this.draftDocumentId = null;
                    this.previewAttachment = null;
                    this.previewHtml = '';
                    this.previewVariables = [];
                    this.previewOutputName = '';
                },

                async openSmartDocEditor() {
                    this.showNewDocModal = false;
                    const entityId = '<%= locals.entity ? entity._id : "" %>';
                    if (!entityId) return;
                    this.smartDocTitleError = '';

                    try {
                        const res = await fetch(`/account/${this.accountNumber}/documents/api`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                name: 'Nouveau SmartDoc',
                                isTemplate: true,
                                entityId: entityId,
                                entityIds: [entityId],
                                status: 'draft',
                                pages: [{ content: '', elements: [], rows: [], mode: 'edition', background: '#ffffff', order: 0 }]
                            })
                        });
                        const data = await res.json();
                        if (!data.success || !data.document) {
                            alert('Erreur lors de la création du document');
                            return;
                        }

                        this.showSmartDocEditor = true;

                        this.$nextTick(() => {
                            const container = document.getElementById('smartdoc-editor-mount-sd');
                            if (!container) return;
                            container.innerHTML = `<iframe src="/account/${this.accountNumber}/documents/${data.document._id}/edit-react?minimal=true" class="w-full h-full border-0" allow="clipboard-read; clipboard-write"></iframe>`;
                        });
                    } catch (e) {
                        console.error('[SmartDoc] Error creating document:', e);
                        alert('Erreur lors de la création du SmartDoc');
                    }
                },

                finishSmartDocEditor() {
                    this.smartDocTitleError = '';
                    const container = document.getElementById('smartdoc-editor-mount-sd');
                    const iframe = container?.querySelector('iframe');
                    if (!iframe) return;

                    try {
                        const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
                        const titleInput = iframeDoc.querySelector('input[type="text"]');
                        const docTitle = titleInput ? titleInput.value.trim() : '';

                        const invalidTitles = ['', 'nouveau smartdoc', 'document sans titre'];
                        if (invalidTitles.includes(docTitle.toLowerCase())) {
                            this.smartDocTitleError = 'Veuillez saisir un titre pour le document';
                            if (titleInput) {
                                if (!iframeDoc.getElementById('smartdoc-shake-style')) {
                                    const style = iframeDoc.createElement('style');
                                    style.id = 'smartdoc-shake-style';
                                    style.textContent = '@keyframes smartdoc-shake { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-6px)} 40%{transform:translateX(6px)} 60%{transform:translateX(-4px)} 80%{transform:translateX(4px)} }';
                                    iframeDoc.head.appendChild(style);
                                }
                                titleInput.focus();
                                titleInput.style.border = '2px solid #e7515a';
                                titleInput.style.borderRadius = '6px';
                                titleInput.style.padding = '2px 8px';
                                titleInput.style.animation = 'smartdoc-shake 0.4s ease-in-out';
                                setTimeout(() => {
                                    titleInput.style.border = '';
                                    titleInput.style.borderRadius = '';
                                    titleInput.style.padding = '';
                                    titleInput.style.animation = '';
                                }, 3000);
                            }
                            setTimeout(() => { this.smartDocTitleError = ''; }, 5000);
                            return;
                        }

                        if (titleInput) {
                            titleInput.dispatchEvent(new Event('input', { bubbles: true }));
                        }

                        setTimeout(() => {
                            if (container) container.innerHTML = '';
                            this.showSmartDocEditor = false;
                            this.smartDocTitleError = '';
                            this.loadSmartDocTemplates();
                            if (window.showMessage) {
                                window.showMessage('SmartDoc "' + docTitle + '" créé avec succès !', 'success');
                            }
                        }, 1000);
                    } catch (e) {
                        console.error('[SmartDoc] Error checking title:', e);
                        if (container) container.innerHTML = '';
                        this.showSmartDocEditor = false;
                        this.loadSmartDocTemplates();
                    }
                },

                groupedPreviewVariables() {
                    const groups = {};
                    for (const v of this.previewVariables) {
                        const g = v.group || 'Autre';
                        if (!groups[g]) groups[g] = [];
                        groups[g].push(v);
                    }
                    return Object.entries(groups).map(([name, items]) => ({ name, items }));
                },

                getGroupIcon(group) {
                    const icons = {
                        'Utilisateur': 'solar:user-bold-duotone',
                        'Système': 'solar:settings-bold-duotone',
                        'Classification': 'solar:tag-bold-duotone',
                        'Relation': 'solar:link-round-bold-duotone',
                        'Saisie': 'solar:pen-bold-duotone',
                        'Champ': 'solar:text-field-bold-duotone',
                        'Autre': 'solar:widget-5-bold-duotone'
                    };
                    return icons[group] || icons['Autre'];
                },

                getGroupColor(group) {
                    const colors = {
                        'Utilisateur': 'text-info',
                        'Système': 'text-secondary',
                        'Classification': 'text-warning',
                        'Relation': 'text-success',
                        'Saisie': 'text-primary',
                        'Champ': 'text-gray-500',
                        'Autre': 'text-gray-400'
                    };
                    return colors[group] || colors['Autre'];
                },

                getGroupBg(group) {
                    const bgs = {
                        'Utilisateur': 'bg-info/10',
                        'Système': 'bg-secondary/10',
                        'Classification': 'bg-warning/10',
                        'Relation': 'bg-success/10',
                        'Saisie': 'bg-primary/10',
                        'Champ': 'bg-gray-100 dark:bg-gray-700',
                        'Autre': 'bg-gray-100 dark:bg-gray-700'
                    };
                    return bgs[group] || bgs['Autre'];
                },

                // ═══ NEW DOC & UNLINK ═══
                async createSimpleDoc() {
                    this.showNewDocModal = false;
                    const entityId = '<%= locals.entity ? entity._id : "" %>';
                    try {
                        const res = await fetch(`/account/${this.accountNumber}/documents/api`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                name: 'Nouveau document',
                                isTemplate: false,
                                entityId: entityId,
                                status: 'draft',
                                pages: [{ content: '', elements: [], rows: [], mode: 'edition', background: '#ffffff', order: 0 }]
                            })
                        });
                        const data = await res.json();
                        if (data.success && data.document) {
                            window.open(`/account/${this.accountNumber}/documents/${data.document._id}/edit-react`, '_blank');
                        } else {
                            alert('Erreur lors de la création du document');
                        }
                    } catch (e) {
                        console.error('[SmartDoc] Create simple doc error:', e);
                        alert('Erreur lors de la création du document');
                    }
                },

                confirmUnlink(tpl) {
                    this.unlinkTarget = tpl;
                    this.showUnlinkConfirm = true;
                },

                async executeUnlink() {
                    if (!this.unlinkTarget || this.unlinking) return;
                    this.unlinking = true;
                    const entityId = '<%= locals.entity ? entity._id : "" %>';
                    try {
                        const res = await fetch(`/account/${this.accountNumber}/api/smartdoc/templates/${this.unlinkTarget._id}/unlink`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ entityId })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.smartDocTemplates = this.smartDocTemplates.filter(t => t._id !== this.unlinkTarget._id);
                            if (window.showMessage) {
                                window.showMessage('Document délié avec succès', 'success');
                            }
                        } else {
                            alert(data.error || 'Erreur lors de la suppression du lien');
                        }
                    } catch (e) {
                        console.error('[SmartDoc] Unlink error:', e);
                        alert('Erreur lors de la suppression du lien');
                    } finally {
                        this.unlinking = false;
                        this.showUnlinkConfirm = false;
                        this.unlinkTarget = null;
                    }
                }
            }));
        });
    </script>