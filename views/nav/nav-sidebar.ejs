              <div x-show="showIconEditModal" x-transition x-transition.duration.300
                class="panel border-0 py-1 px-4 rounded-lg overflow-hidden w-full max-w-sm my-8 bg-white dark:bg-[#1b2e4b]">
                <div class="flex items-center justify-between p-5 font-semibold text-lg dark:text-white">
                  <span>Changer l'icône</span>
                  <button type="button" @click="showIconEditModal = false" class="text-white-dark hover:text-dark">
                    <iconify-icon icon="solar:close-circle-bold" width="24" height="24"></iconify-icon>
                  </button>
                </div>
                <div class="p-5">
                  <form @submit.prevent="submitEditIcon">
                    <div class="relative mb-4">
                      <label class="mb-2 block text-sm font-bold">Choisir une icône</label>

