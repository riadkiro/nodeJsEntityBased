        <!-- 
          STYLE REFERENCE: Doctor Dashboard Waiting Room
          Design Pattern: Compact Timeline with Status Badges
          
          Colors:
          - Background hover: rgba(67, 97, 238, 0.1) for active
          - Border: border-[#e0e6ed] dark:border-[#1b2e4b]
          - Text: text-white-dark for secondary info
          
          Layout:
          - Time on left (w-14, shrink-0)
          - Avatar (h-8 w-8 rounded-full)
          - Status badge INLINE with name (before name)
          - Motif on second line (text-xs)
          - Actions on right (shrink-0)
          
          Animations:
          - subtle-glow: for current patient (opacity 1→0.95)
          - subtle-fade: for next patient (opacity 1→0.92)
        -->
        <style>
          @keyframes subtle-fade {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.92; }
          }
          @keyframes subtle-glow {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.95; }
          }
            [x-cloak] { display: none !important; }
        </style>
