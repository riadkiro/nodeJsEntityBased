<%# Tenant - Integrations List %>
<%
    const mailIntegration = typeof emailIntegration !== 'undefined' && emailIntegration
        ? emailIntegration
        : {
            name: 'E-mails',
            category: 'Communication',
            description: 'Connectez Gmail, Outlook ou toute boite compatible IMAP/SMTP.',
            accountCount: 0,
            isConnected: false,
            href: `/account/${account_number}/mailbox/inbox?connect=1`
        };
%>

<style>
    .integrations-hub {
        --integration-border: #e6eaf1;
        --integration-muted: #7c8aa3;
        max-width: 1180px;
        margin: 0 auto;
    }
    .integration-card {
        display: flex;
        min-height: 190px;
        flex-direction: column;
        padding: 20px;
        border: 1px solid var(--integration-border);
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 4px 18px rgba(39, 50, 82, .035);
        transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
    }
    .integration-card:hover {
        transform: translateY(-2px);
        border-color: #cfc7ff;
        box-shadow: 0 12px 28px rgba(95, 76, 255, .09);
    }
    .integration-logo {
        display: flex;
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1px solid #e9e6ff;
        border-radius: 14px;
        background: #f7f5ff;
    }
    .integration-logo img { width: 34px; height: 34px; object-fit: contain; }
    .integration-logo--mail {
        color: #624bff;
        background: linear-gradient(145deg, #f3f0ff, #faf9ff);
    }
    .integration-description {
        min-height: 40px;
        color: var(--integration-muted);
        font-size: 13px;
        line-height: 1.55;
    }
    .integration-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #68758b;
        font-size: 12px;
        font-weight: 700;
    }
    .integration-status::before {
        width: 7px;
        height: 7px;
        border-radius: 99px;
        background: #b7c0cf;
        content: '';
    }
    .integration-status.is-connected { color: #079669; }
    .integration-status.is-connected::before { background: #18bd84; box-shadow: 0 0 0 3px #dcf8ee; }
    .dark .integrations-hub { --integration-border: #253653; --integration-muted: #9ca9bd; }
    .dark .integration-card { background: #111c2e; box-shadow: none; }
    .dark .integration-logo { border-color: #32415d; background: #17243a; }
</style>

<div class="panel p-6 integrations-hub">
    <div class="mb-7 flex flex-wrap items-center justify-between gap-4">
        <div>
            <div class="mb-2 flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary-light text-primary dark:bg-primary/15">
                    <iconify-icon icon="solar:widget-5-bold-duotone" width="22"></iconify-icon>
                </span>
                <h1 class="text-2xl font-bold dark:text-white">Intégrations</h1>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400">Connectez DexApp à vos outils et centralisez votre travail.</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/account/<%= account_number %>/integrations/admin/providers" class="btn btn-outline-secondary">
                <iconify-icon icon="solar:settings-bold-duotone" width="18" class="ltr:mr-2 rtl:ml-2"></iconify-icon>
                Gérer
            </a>
            <a href="/account/<%= account_number %>/workflows" class="btn btn-primary">
                <iconify-icon icon="solar:bolt-bold-duotone" width="18" class="ltr:mr-2 rtl:ml-2"></iconify-icon>
                Automatisations
            </a>
        </div>
    </div>

    <div class="mb-3 text-xs font-bold uppercase tracking-[.08em] text-gray-400">Services disponibles</div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        <a href="<%= mailIntegration.href %>" class="integration-card">
            <div class="mb-5 flex items-start gap-4">
                <span class="integration-logo integration-logo--mail" aria-hidden="true">
                    <iconify-icon icon="solar:letter-bold-duotone" width="30"></iconify-icon>
                </span>
                <div class="min-w-0 pt-0.5">
                    <h2 class="text-base font-bold text-gray-900 dark:text-white"><%= mailIntegration.name %></h2>
                    <span class="mt-1 inline-flex rounded-full bg-primary-light px-2 py-0.5 text-[10px] font-bold text-primary dark:bg-primary/15"><%= mailIntegration.category %></span>
                </div>
            </div>
            <p class="integration-description"><%= mailIntegration.description %></p>
            <div class="mt-auto flex items-center justify-between gap-3 pt-5">
                <span class="integration-status <%= mailIntegration.isConnected ? 'is-connected' : '' %>">
                    <% if (mailIntegration.isConnected) { %>
                        <%= mailIntegration.accountCount %> compte<%= mailIntegration.accountCount > 1 ? 's' : '' %> connecté<%= mailIntegration.accountCount > 1 ? 's' : '' %>
                    <% } else { %>
                        Non connecté
                    <% } %>
                </span>
                <span class="text-xs font-bold text-primary"><%= mailIntegration.isConnected ? 'Gérer' : 'Connecter' %> →</span>
            </div>
        </a>

        <% (integrations || []).forEach(integration => { %>
            <a href="/account/<%= account_number %>/integrations/<%= integration.key %>" class="integration-card">
                <div class="mb-5 flex items-start gap-4">
                    <span class="integration-logo">
                        <% if (integration.logo) { %>
                            <img src="<%= integration.logo %>" alt="Logo <%= integration.name %>" loading="lazy">
                        <% } else { %>
                            <iconify-icon icon="solar:plug-circle-bold-duotone" width="29" class="text-primary"></iconify-icon>
                        <% } %>
                    </span>
                    <div class="min-w-0 pt-0.5">
                        <h2 class="truncate text-base font-bold text-gray-900 dark:text-white"><%= integration.name %></h2>
                        <span class="mt-1 inline-flex rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-bold capitalize text-gray-500 dark:bg-[#1b2e4b] dark:text-gray-300"><%= integration.category || 'Autre' %></span>
                    </div>
                </div>
                <p class="integration-description">Configurez cette connexion pour l'utiliser dans DexApp et vos automatisations.</p>
                <div class="mt-auto flex items-center justify-between gap-3 pt-5">
                    <span class="integration-status <%= integration.isConnected ? 'is-connected' : '' %>">
                        <% if (integration.isConnected) { %>
                            <%= integration.credentialSource === 'platform' ? 'Offert par DexApp' : 'Connecté' %>
                        <% } else { %>
                            Non connecté
                        <% } %>
                    </span>
                    <span class="text-xs font-bold text-primary">Configurer →</span>
                </div>
            </a>
        <% }) %>
    </div>
</div>
