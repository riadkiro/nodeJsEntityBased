<%# Admin - Providers List %>
<div class="panel p-6">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-semibold dark:text-white">Integration Providers</h1>
        <a href="/account/<%= account_number %>/integrations/admin/providers/new" 
           class="btn btn-primary">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New Provider
        </a>
    </div>

    <% if (providers && providers.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% providers.forEach(provider => { %>
                <a href="/account/<%= account_number %>/integrations/admin/providers/<%= provider.key %>"
                   class="block p-4 border border-gray-200 dark:border-gray-800 rounded-lg hover:border-primary dark:hover:border-primary transition-colors">
                    <div class="flex items-center gap-3 mb-2">
                        <% if (provider.logo) { %>
                            <img src="<%= provider.logo %>" alt="<%= provider.name %>" class="w-10 h-10 rounded">
                        <% } else { %>
                            <div class="w-10 h-10 bg-gray-100 dark:bg-gray-800 rounded flex items-center justify-center">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                </svg>
                            </div>
                        <% } %>
                        <div>
                            <h3 class="font-medium dark:text-white"><%= provider.name %></h3>
                            <p class="text-xs text-gray-500 dark:text-gray-400"><%= provider.key %></p>
                        </div>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs px-2 py-1 rounded bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
                            <%= provider.category || 'other' %>
                        </span>
                        <span class="text-xs px-2 py-1 rounded <%= provider.status === 'published' ? 'bg-success/20 text-success' : 'bg-gray-100 dark:bg-gray-800 text-gray-500' %>">
                            <%= provider.status %>
                        </span>
                    </div>
                </a>
            <% }) %>
        </div>
    <% } else { %>
        <div class="text-center py-12">
            <div class="w-16 h-16 mx-auto mb-4 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center">
                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
            </div>
            <h3 class="text-lg font-medium dark:text-white mb-2">No providers yet</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-4">Create your first integration provider to get started.</p>
            <a href="/account/<%= account_number %>/integrations/admin/providers/new" class="btn btn-primary">
                Create Provider
            </a>
        </div>
    <% } %>
</div>
