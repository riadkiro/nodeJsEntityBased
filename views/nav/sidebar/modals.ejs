          <!-- Icon Edit Modal -->
          <div class="fixed inset-0 bg-[black]/60 z-[999] hidden overflow-y-auto" :class="showIconEditModal && '!block'">
              <div class="flex items-start justify-center min-h-screen px-4" @click.self="showIconEditModal = false">
                  <div x-show="showIconEditModal" x-transition x-transition.duration.300 class="panel border-0 py-1 px-4 rounded-lg overflow-hidden w-full max-w-sm my-8 bg-white dark:bg-[#1b2e4b]">
                      <div class="flex items-center justify-between p-5 font-semibold text-lg dark:text-white">
                          <span>Changer l'icône</span>
                          <button type="button" @click="showIconEditModal = false" class="text-white-dark hover:text-dark">
                              <iconify-icon icon="solar:close-circle-bold" width="24" height="24"></iconify-icon>
                          </button>
                      </div>
                      <div class="p-5">
                          <form @submit.prevent="submitEditIcon">
                              <div class="relative mb-4">
                                  <label class="mb-2 block text-sm font-bold">Choisir une icône</label>
                                  
                                  <!-- Search & Library -->
                                  <div class="relative mb-2 flex gap-2">
                                    <select x-model="selectedLibrary" class="form-select w-1/3 text-xs py-1.5 border-gray-300 dark:border-gray-600 focus:border-primary">
                                        <template x-for="lib in libraries" :key="lib.id">
                                            <option :value="lib.id" x-text="lib.name"></option>
                                        </template>
                                    </select>
                                    <div class="relative w-2/3">
                                        <input type="text" x-model="iconSearch" placeholder="Rechercher..." 
                                            class="form-input w-full text-xs pl-8 py-1.5 border-gray-300 dark:border-gray-600" />
                                        <iconify-icon icon="solar:magnifer-linear" class="absolute left-2.5 top-2 text-gray-400" width="14"></iconify-icon>
                                    </div>
                                  </div>

                                  <!-- Grid -->
                                  <div class="flex flex-wrap gap-1 mb-2 max-h-60 overflow-y-auto custom-scrollbar p-1 border rounded dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50 content-start"
                                      @scroll.debounce="if($el.scrollTop + $el.clientHeight >= $el.scrollHeight - 20) loadMoreIcons()">
                                      <template x-for="icon in icons" :key="icon">
                                          <div class="w-8 h-8 rounded cursor-pointer border border-transparent hover:border-primary/50 hover:bg-white dark:hover:bg-gray-700 transition-all flex items-center justify-center shrink-0"
                                              :class="editingIcon === icon ? '!bg-primary/10 !border-primary text-primary shadow-sm' : 'text-gray-500 dark:text-gray-400'"
                                              @click="editingIcon = icon"
                                              :title="icon">
                                              <iconify-icon :icon="icon" width="20" height="20"></iconify-icon>
                                          </div>
                                      </template>
                                      <template x-if="icons.length === 0 && !isLoadingIcons">
                                        <div class="w-full text-center py-4 text-xs text-gray-400">Aucune icône trouvée</div>
                                      </template>
                                      
                                      <template x-if="isLoadingIcons">
                                         <div class="w-full text-center py-2">
                                             <span class="animate-spin border-2 border-primary border-l-transparent rounded-full w-4 h-4 inline-block"></span>
                                         </div>
                                      </template>
                                      
                                      <div class="w-full text-center pt-2 pb-1" x-show="hasMore && !isLoadingIcons">
                                        <button type="button" @click="loadMoreIcons()" class="text-xs text-primary hover:underline hover:text-primary-focus">
                                            Charger plus...
                                        </button>
                                      </div>
                                  </div>
                                  
                                  <div class="text-xs text-gray-400 mb-2 text-center" x-show="!iconSearch">
                                    <span x-text="icons.length"></span> icônes affichées
                                  </div>
                                  <input type="text" x-model="editingIcon" class="form-input w-full text-xs" placeholder="Nom d'icône personnalisé..." />
                              </div>
                              
                              <!-- Color Picker -->
                              <div class="mb-4">
                                <label class="mb-2 block text-sm font-bold">Couleur</label>
                                <div class="flex flex-wrap gap-2">
                                  <template x-for="color in availableColors" :key="color">
                                    <div class="w-6 h-6 rounded-full cursor-pointer flex items-center justify-center border transition-transform hover:scale-110"
                                      :style="'background-color: ' + color + '; border-color: ' + (editingColor === color ? 'black' : 'transparent')"
                                      @click="editingColor = color">
                                      <iconify-icon icon="solar:check-circle-bold" class="text-white" width="14" x-show="editingColor === color"></iconify-icon>
                                    </div>
                                  </template>
                                  
                                  <!-- Custom Picker -->
                                  <div class="relative w-6 h-6 rounded-full cursor-pointer border border-gray-300 flex items-center justify-center overflow-hidden hover:border-gray-400"
                                       :style="editingColor && !availableColors.includes(editingColor) ? 'background-color: ' + editingColor + '; border-color: ' + editingColor : ''">
                                      <iconify-icon icon="solar:pen-new-square-linear" width="14" class="pointer-events-none"
                                        :class="editingColor && !availableColors.includes(editingColor) ? 'text-white mix-blend-difference' : 'text-gray-500'"></iconify-icon>
                                      <input type="color" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full p-0 border-0" 
                                          x-model="editingColor" title="Couleur personnalisée" />
                                  </div>
                                  <span x-show="editingColor && !availableColors.includes(editingColor)" x-text="editingColor" class="text-[10px] self-center font-mono text-gray-500 uppercase"></span>

                                  <div class="w-6 h-6 rounded-full cursor-pointer flex items-center justify-center border hover:border-gray-400 bg-transparent text-gray-400"
                                     title="Réinitialiser" @click="editingColor = ''" :class="!editingColor && 'border-black'">
                                      <iconify-icon icon="solar:close-circle-linear" width="16"></iconify-icon>
                                  </div>
                                </div>
                              </div>

                              <button type="submit" class="btn btn-primary w-full" :disabled="isSubmitting">
                                  <span x-show="isSubmitting" class="animate-spin border-2 border-white border-l-transparent rounded-full w-5 h-5 ltr:mr-2 rtl:ml-2 inline-block align-middle"></span>
                                  Enregistrer
                              </button>
                          </form>
                      </div>
                  </div>
              </div>
          </div>

          <!-- Creation Modal -->
          <div class="fixed inset-0 bg-[black]/60 z-[999] hidden overflow-y-auto" :class="showCreateModal && '!block'">
              <div class="flex items-start justify-center min-h-screen px-4" @click.self="showCreateModal = false">
                  <div x-show="showCreateModal" x-transition x-transition.duration.300 class="panel border-0 py-1 px-4 rounded-lg overflow-hidden w-full max-w-sm my-8 bg-white dark:bg-[#1b2e4b]">
                      <div class="flex items-center justify-between p-5 font-semibold text-lg dark:text-white">
                          <span x-text="'Nouveau ' + (creationType === 'entity' ? 'Collection' : creationType)"></span>
                          <button type="button" @click="showCreateModal = false" class="text-white-dark hover:text-dark">
                              <iconify-icon icon="solar:close-circle-bold" width="24" height="24"></iconify-icon>
                          </button>
                      </div>
                      <div class="p-5">
                          <form @submit.prevent="submitCreateItem">
                              <div class="relative mb-4">
                                  <label class="mb-2 block text-sm font-bold">Nom</label>
                                  <input type="text" x-model="creationName" x-ref="createInput" placeholder="Entrez le nom..." class="form-input w-full" />
                              </div>
                              <div class="relative mb-4">
                                  <label class="mb-2 block text-sm font-bold">Icône</label>
                                  
                                  <!-- Reuse Picker Logic -->
                                  <div class="relative mb-2 flex gap-2">
                                    <select x-model="selectedLibrary" class="form-select w-1/3 text-xs py-1.5 border-gray-300 dark:border-gray-600 focus:border-primary">
                                        <template x-for="lib in libraries" :key="lib.id">
                                            <option :value="lib.id" x-text="lib.name"></option>
                                        </template>
                                    </select>
                                    <div class="relative w-2/3">
                                        <input type="text" x-model="iconSearch" placeholder="Rechercher..." 
                                            class="form-input w-full text-xs pl-8 py-1.5 border-gray-300 dark:border-gray-600" />
                                        <iconify-icon icon="solar:magnifer-linear" class="absolute left-2.5 top-2 text-gray-400" width="14"></iconify-icon>
                                    </div>
                                  </div>

                                  <div class="flex gap-2 flex-wrap mb-2 max-h-40 overflow-y-auto custom-scrollbar p-1 border rounded"
                                      @scroll.debounce="if($el.scrollTop + $el.clientHeight >= $el.scrollHeight - 20) loadMoreIcons()">
                                      <template x-for="icon in icons" :key="icon">
                                          <div class="p-2 rounded cursor-pointer border hover:border-primary transition-colors"
                                              :class="creationIcon === icon ? 'bg-primary/10 border-primary text-primary' : 'border-transparent bg-gray-50 dark:bg-gray-700'"
                                              @click="creationIcon = icon">
                                              <iconify-icon :icon="icon" width="20" height="20"></iconify-icon>
                                          </div>
                                      </template>
                                      
                                      <template x-if="isLoadingIcons">
                                          <div class="w-full text-center py-2">
                                              <span class="animate-spin border-dark border-l-transparent rounded-full w-4 h-4 inline-block"></span>
                                          </div>
                                      </template>

                                      <div class="w-full text-center pt-2 pb-1" x-show="hasMore && !isLoadingIcons">
                                         <button type="button" @click="loadMoreIcons()" class="text-xs text-primary hover:underline">
                                             Charger plus...
                                         </button>
                                       </div>
                                  </div>
                                  <input type="text" x-model="creationIcon" class="form-input w-full text-xs" placeholder="ou tapez un nom d'icône..." />
                                  
                                  <!-- Color Picker Creation -->
                                  <div class="mt-4">
                                    <label class="mb-2 block text-sm font-bold">Couleur</label>
                                    <div class="flex flex-wrap gap-2">
                                      <template x-for="color in availableColors" :key="color">
                                        <div class="w-6 h-6 rounded-full cursor-pointer flex items-center justify-center border transition-transform hover:scale-110"
                                          :style="'background-color: ' + color + '; border-color: ' + (creationColor === color ? 'black' : 'transparent')"
                                          @click="creationColor = color">
                                          <iconify-icon icon="solar:check-circle-bold" class="text-white" width="14" x-show="creationColor === color"></iconify-icon>
                                        </div>
                                        </div>
                                      </template>
                                      
                                      <!-- Custom Picker -->
                                      <div class="relative w-6 h-6 rounded-full cursor-pointer border border-gray-300 flex items-center justify-center overflow-hidden hover:border-gray-400"
                                           :style="creationColor && !availableColors.includes(creationColor) ? 'background-color: ' + creationColor + '; border-color: ' + creationColor : ''">
                                          <iconify-icon icon="solar:pen-new-square-linear" width="14" class="pointer-events-none"
                                            :class="creationColor && !availableColors.includes(creationColor) ? 'text-white mix-blend-difference' : 'text-gray-500'"></iconify-icon>
                                          <input type="color" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full p-0 border-0" 
                                              x-model="creationColor" title="Couleur personnalisée" />
                                      </div>
                                      <span x-show="creationColor && !availableColors.includes(creationColor)" x-text="creationColor" class="text-[10px] self-center font-mono text-gray-500 uppercase"></span>
                                    </div>
                                  </div>
                              </div>
                              <button type="submit" class="btn btn-primary w-full" :disabled="isSubmitting">
                                  <span x-show="isSubmitting" class="animate-spin border-2 border-white border-l-transparent rounded-full w-5 h-5 ltr:mr-2 rtl:ml-2 inline-block align-middle"></span>
                                  Créer
                              </button>
                          </form>
                      </div>
                  </div>
              </div>
          </div>

          <!-- CONFIG MODAL (Fixed at center) -->
          <div x-show="showViewConfigModal"
            class="fixed inset-0 z-[1000] flex items-center justify-center bg-black/50 p-4" x-cloak>
            <div class="bg-white dark:bg-[#1b2e4b] w-full max-w-xl rounded-xl shadow-2xl overflow-hidden"
              @click.outside="showViewConfigModal = false">
              <div class="p-6 border-b dark:border-gray-800 flex justify-between items-center">
                <h3 class="text-xl font-bold dark:text-white"
                  x-text="'Configurer la vue : ' + (configView ? configView.name : '')"></h3>
                <button @click="showViewConfigModal = false" class="text-gray-400 hover:text-white transition-colors">
                  <iconify-icon icon="solar:close-circle-bold" width="24"></iconify-icon>
                </button>
              </div>

              <div class="p-6 space-y-6 max-h-[70vh] overflow-y-auto custom-scrollbar">
                <!-- View Type Selector -->
                <div class="space-y-2">
                  <label class="block text-sm font-semibold dark:text-gray-300">Type d'affichage</label>
                  <div class="grid grid-cols-4 gap-3">
                    <template x-for="type in ['list', 'kanban', 'checklist', 'table']">
                      <button class="p-3 rounded-lg border-2 flex flex-col items-center gap-2 transition-all"
                        :class="tempViewType === type ? 'border-primary bg-primary/5 text-primary' : 'border-gray-100 dark:border-gray-800 text-gray-500 grayscale hover:grayscale-0 hover:border-primary/50'"
                        @click="tempViewType = type">
                        <iconify-icon :icon="getIcon(type === 'list' || type === 'table' ? 'entity' : type)"
                          width="24"></iconify-icon>
                        <span class="text-[10px] font-bold uppercase" x-text="type"></span>
                      </button>
                    </template>
                  </div>
                </div>

                <!-- Filters Section -->
                <div class="space-y-4 pt-4 border-t dark:border-gray-800">
                  <div class="flex items-center justify-between">
                    <label class="text-sm font-semibold dark:text-gray-300">Filtres dynamiques</label>
                    <button class="btn btn-sm btn-outline-primary" @click="addFilter()">
                      <iconify-icon icon="solar:add-circle-bold" class="mr-1"></iconify-icon> Ajouter un filtre
                    </button>
                  </div>

                  <div class="space-y-3">
                    <template x-for="(filter, index) in tempFilters" :key="index">
                      <div
                        class="flex items-center gap-2 bg-gray-50 dark:bg-black/20 p-3 rounded-lg border dark:border-gray-800">
                        <select x-model="filter.field" class="form-select flex-1 text-xs">
                          <option value="">Choisir un champ...</option>
                          <optgroup label="Standard">
                            <option value="title">Titre</option>
                            <option value="status">Statut</option>
                            <option value="createdAt">Date de création</option>
                          </optgroup>
                          <optgroup label="Personnalisé" x-show="configEntity">
                            <template x-for="f in (configEntity ? configEntity.customFields : [])" :key="f._id">
                              <option :value="f._id" x-text="f.label"></option>
                            </template>
                          </optgroup>
                        </select>
                        <select x-model="filter.operator" class="form-select w-28 text-xs">
                          <option value="equals">=</option>
                          <option value="not_equals">!=</option>
                          <option value="contains">contient</option>
                          <option value="greater_than">&gt;</option>
                          <option value="less_than">&lt;</option>
                        </select>
                        <input type="text" x-model="filter.value" class="form-input flex-1 text-xs"
                          placeholder="Valeur...">
                        <button class="text-red-500 p-1 hover:bg-red-50/10 rounded" @click="removeFilter(index)">
                          <iconify-icon icon="solar:trash-bin-minimalistic-bold" width="18"></iconify-icon>
                        </button>
                      </div>
                    </template>
                    <div x-show="tempFilters.length === 0" class="text-center py-4 text-gray-400 italic text-xs">
                      Aucun filtre actif (affiche tout)
                    </div>
                  </div>
                </div>
              </div>

              <div class="p-6 border-t dark:border-gray-800 bg-gray-50 dark:bg-black/10 flex justify-end gap-3">
                <button class="btn btn-outline-danger" @click="showViewConfigModal = false">Annuler</button>
                <button class="btn btn-primary" @click="saveViewConfig()">Enregistrer les modifications</button>
              </div>
            </div>
          </div>
