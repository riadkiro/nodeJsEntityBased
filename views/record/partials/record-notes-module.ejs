<!-- Record Notes Module — Evernote-like: Left sidebar + Right editor -->
<link rel="stylesheet" href="/css/app/rich-text-editor.css">
<script src="/js/rich-text-editor.js"></script>

<style>
/* ══════════════════════════════════════════════════════════════
   NOTES MODULE — EVERNOTE LAYOUT
   ══════════════════════════════════════════════════════════════ */

/* ── Main Container ── */
.notes-layout {
    display: flex;
    height: calc(100vh - 220px);
    min-height: 420px;
    border: 1px solid #e0e6ed;
    border-radius: 14px;
    overflow: visible;
    background: #fff;
    position: relative;
}

/* ── LEFT SIDEBAR ── */
.notes-sidebar {
    width: 300px;
    min-width: 300px;
    border-right: 1px solid #e0e6ed;
    display: flex;
    flex-direction: column;
    background: #fafbfc;
    border-radius: 14px 0 0 14px;
    overflow: hidden;
}

.notes-sidebar-header {
    padding: 16px 16px 12px;
    border-bottom: 1px solid #e0e6ed;
    flex-shrink: 0;
}

.notes-sidebar-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.notes-sidebar-title h3 {
    font-size: 15px;
    font-weight: 700;
    color: #0e1726;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.notes-sidebar-title .notes-count {
    font-size: 11px;
    font-weight: 600;
    color: #94a3b8;
    background: #f1f5f9;
    padding: 2px 8px;
    border-radius: 10px;
}

.notes-create-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
}

.notes-create-btn:hover {
    box-shadow: 0 4px 14px rgba(139, 92, 246, .35);
    transform: translateY(-1px);
}

.notes-search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1.5px solid #e0e6ed;
    border-radius: 10px;
    padding: 0 12px;
    transition: border-color .2s;
}

.notes-search-wrap:focus-within {
    border-color: #8b5cf6;
    box-shadow: 0 0 0 3px rgba(139, 92, 246, .08);
}

.notes-search-wrap iconify-icon {
    color: #bfc9d4;
    flex-shrink: 0;
}

.notes-search-input {
    flex: 1;
    border: none;
    background: none;
    padding: 9px 0;
    font-size: 12px;
    color: #0e1726;
    outline: none;
    font-family: inherit;
}

.notes-search-input::placeholder {
    color: #cbd5e1;
}

/* ── Note List ── */
.notes-list {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
}

.notes-list::-webkit-scrollbar {
    width: 4px;
}

.notes-list::-webkit-scrollbar-thumb {
    background: #e0e6ed;
    border-radius: 4px;
}

.notes-list::-webkit-scrollbar-thumb:hover {
    background: #bfc9d4;
}

.notes-list-section-title {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .8px;
    color: #94a3b8;
    padding: 10px 10px 6px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.note-list-item {
    display: flex;
    gap: 12px;
    padding: 12px;
    border-radius: 10px;
    cursor: pointer;
    transition: all .15s;
    position: relative;
    border: 1.5px solid transparent;
    margin-bottom: 2px;
}

.note-list-item:hover {
    background: #f1f5f9;
}

.note-list-item.active {
    background: #8b5cf608;
    border-color: #8b5cf640;
}

.note-list-item-color {
    width: 4px;
    min-height: 100%;
    border-radius: 3px;
    flex-shrink: 0;
    align-self: stretch;
}

.note-list-item-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.note-list-item-title {
    font-size: 13px;
    font-weight: 700;
    color: #0e1726;
    display: flex;
    align-items: flex-start;
    gap: 6px;
    line-height: 1.3;
    min-width: 0;
    padding-right: 52px;
    white-space: normal;
}

.note-list-item-title > span {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.note-list-item-title .pin-icon {
    color: #f59e0b;
    flex-shrink: 0;
    margin-top: 2px;
}

.note-list-item-title iconify-icon {
    flex-shrink: 0;
    margin-top: 2px;
}

.note-list-item-preview {
    font-size: 11px;
    color: #94a3b8;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.note-list-item-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: #bfc9d4;
    margin-top: 2px;
}

.note-list-item-meta iconify-icon {
    vertical-align: -1px;
}

.note-list-item-actions {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    gap: 2px;
    opacity: 0;
    transition: opacity .15s;
}

.note-list-item:hover .note-list-item-actions {
    opacity: 1;
}

.note-list-item-actions button {
    width: 24px;
    height: 24px;
    border: none;
    background: #fff;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    transition: all .12s;
    box-shadow: 0 1px 3px rgba(0,0,0,.06);
}

.note-list-item-actions button:hover {
    color: #0e1726;
    background: #f1f5f9;
}

.note-list-item-actions button.delete-btn:hover {
    background: #fef2f2;
    color: #ef4444;
}

/* ── Sidebar Empty ── */
.notes-sidebar-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px 20px;
    color: #94a3b8;
    text-align: center;
}

.notes-sidebar-empty h4 {
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
    margin: 10px 0 4px;
}

.notes-sidebar-empty p {
    font-size: 11px;
    margin: 0;
    line-height: 1.5;
}

/* ── RIGHT EDITOR PANEL ── */
.notes-editor-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: #fff;
    position: relative;
    border-radius: 0 14px 14px 0;
    overflow: visible;
}

/* ── Editor Empty State ── */
.notes-editor-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    gap: 8px;
}

.notes-editor-empty h3 {
    font-size: 16px;
    font-weight: 700;
    color: #64748b;
    margin: 8px 0 0;
}

.notes-editor-empty p {
    font-size: 12px;
    margin: 0;
    max-width: 280px;
    text-align: center;
    line-height: 1.5;
}

/* ── Editor Topbar ── */
.ne-topbar {
    padding: 12px 20px;
    border-bottom: 1px solid #e0e6ed;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    min-height: 52px;
}

.ne-title-input {
    flex: 1;
    border: none;
    background: none;
    font-size: 18px;
    font-weight: 700;
    color: #0e1726;
    outline: none;
    font-family: inherit;
    padding: 0;
}

.ne-title-input::placeholder {
    color: #cbd5e1;
}

.ne-save-status {
    font-size: 10px;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    flex-shrink: 0;
}

.ne-save-status.saving { color: #f59e0b; }
.ne-save-status.saved { color: #10b981; }

.ne-topbar-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
}

.ne-topbar-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: #94a3b8;
    border: none;
    background: none;
    cursor: pointer;
    padding: 5px 8px;
    border-radius: 6px;
    font-family: inherit;
    font-weight: 500;
    transition: all .15s;
}

.ne-topbar-btn:hover {
    background: #f1f5f9;
    color: #0e1726;
}

.ne-topbar-btn.pin-active {
    color: #f59e0b;
}

.ne-topbar-btn.delete-btn:hover {
    background: #fef2f2;
    color: #ef4444;
}

/* ── Toolbar ── */
.ne-toolbar {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 6px 16px;
    border-bottom: 1px solid #f1f3f5;
    flex-wrap: wrap;
    background: #fafbfc;
    flex-shrink: 0;
    position: relative;
    z-index: 100;
}

.ne-toolbar button {
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    transition: all .12s;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
}

.ne-toolbar button:hover {
    background: #e2e8f0;
    color: #0e1726;
}

.ne-toolbar button.active {
    background: #8b5cf615;
    color: #8b5cf6;
}

.ne-toolbar .sep {
    width: 1px;
    height: 20px;
    background: #e0e6ed;
    margin: 0 4px;
}

/* ── Toolbar Dropdowns ── */
.ne-toolbar-dropdown {
    position: relative;
}

.ne-toolbar-dropdown-btn {
    width: auto !important;
    padding: 0 10px !important;
    gap: 4px;
    font-size: 12px !important;
    font-weight: 600 !important;
    white-space: nowrap;
    min-width: 60px;
}

.ne-toolbar-dropdown-btn iconify-icon {
    font-size: 10px;
    opacity: .5;
}

.ne-toolbar-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 4px;
    background: #fff;
    border: 1px solid #e0e6ed;
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0,0,0,.1);
    z-index: 1050;
    min-width: 150px;
    padding: 4px;
    animation: nmSlide .15s ease;
}

.ne-toolbar-dropdown-menu button {
    width: 100% !important;
    height: auto !important;
    padding: 7px 12px !important;
    justify-content: flex-start !important;
    font-weight: 500 !important;
    font-size: 13px !important;
    border-radius: 7px;
    gap: 8px;
}

.ne-toolbar-dropdown-menu button:hover {
    background: #f1f5f9;
}

.ne-toolbar-dropdown-menu button.active {
    background: #8b5cf610;
    color: #8b5cf6;
}

/* ── Link / Image Modal ── */
.ne-inline-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.35);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: nmFadeIn .15s;
}

.ne-inline-modal {
    background: #fff;
    border-radius: 14px;
    width: 400px;
    max-width: 92vw;
    box-shadow: 0 16px 48px rgba(0,0,0,.15);
    animation: nmSlide .2s ease;
}

.ne-inline-modal-header {
    padding: 16px 20px;
    border-bottom: 1px solid #f1f3f5;
    font-size: 14px;
    font-weight: 700;
    color: #0e1726;
    display: flex;
    align-items: center;
    gap: 8px;
}

.ne-inline-modal-body {
    padding: 16px 20px;
}

.ne-inline-modal-body label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    margin-bottom: 6px;
}

.ne-inline-modal-body label + label {
    margin-top: 12px;
}

.ne-inline-modal-body input {
    width: 100%;
    padding: 9px 12px;
    border: 1.5px solid #e0e6ed;
    border-radius: 8px;
    font-size: 13px;
    font-family: inherit;
    color: #0e1726;
    outline: none;
    box-sizing: border-box;
}

.ne-inline-modal-body input:focus {
    border-color: #8b5cf6;
    box-shadow: 0 0 0 3px #8b5cf610;
}

.ne-inline-modal-footer {
    padding: 12px 20px;
    border-top: 1px solid #f1f3f5;
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

.ne-inline-modal-footer button {
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: all .15s;
}

.ne-inline-modal-footer .btn-cancel {
    background: #f1f5f9;
    color: #64748b;
}

.ne-inline-modal-footer .btn-cancel:hover {
    background: #e2e8f0;
}

.ne-inline-modal-footer .btn-insert {
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    color: #fff;
}

.ne-inline-modal-footer .btn-insert:hover {
    box-shadow: 0 4px 12px #8b5cf640;
}

/* ── Image in editor ── */
.ne-content img {
    max-width: 100%;
    border-radius: 8px;
    margin: 8px 0;
    cursor: pointer;
    transition: outline .15s;
}

.ne-content img:hover {
    outline: 2px solid #8b5cf6;
    outline-offset: 2px;
}

.ne-content img.ne-img-selected {
    outline: 2px solid #8b5cf6;
    outline-offset: 2px;
}

/* ── Image Floating Toolbar ── */
.ne-image-toolbar {
    position: absolute;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 2px;
    background: #fff;
    border: 1px solid #e0e6ed;
    border-radius: 10px;
    padding: 4px;
    box-shadow: 0 6px 20px rgba(0,0,0,.12);
    animation: nmSlide .15s ease;
}

.ne-image-toolbar button {
    height: 30px;
    padding: 0 10px;
    border: none;
    background: transparent;
    border-radius: 7px;
    cursor: pointer;
    font-size: 11px;
    font-weight: 600;
    font-family: inherit;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: all .12s;
    white-space: nowrap;
}

.ne-image-toolbar button:hover {
    background: #f1f5f9;
    color: #0e1726;
}

.ne-image-toolbar button.active {
    background: #8b5cf610;
    color: #8b5cf6;
}

.ne-image-toolbar .sep {
    width: 1px;
    height: 18px;
    background: #e0e6ed;
    margin: 0 2px;
}

.ne-image-toolbar .delete-btn {
    color: #ef4444;
}

.ne-image-toolbar .delete-btn:hover {
    background: #fef2f2;
    color: #dc2626;
}

/* ── Drive Grid (in modal) ── */
.ne-drive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    max-height: 320px;
    overflow-y: auto;
    padding: 4px;
}

.ne-drive-item {
    border: 2px solid #e0e6ed;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    transition: all .15s;
    background: #fafbfc;
}

.ne-drive-item:hover {
    border-color: #8b5cf6;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(139,92,246,.15);
}

.ne-drive-item img {
    width: 100%;
    height: 90px;
    object-fit: cover;
    display: block;
}

.ne-drive-item-name {
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 500;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ne-drive-empty {
    text-align: center;
    padding: 32px 16px;
    color: #94a3b8;
}

.ne-drive-empty iconify-icon {
    display: block;
    margin: 0 auto 8px;
    opacity: .3;
}

.ne-content a {
    color: #8b5cf6;
    text-decoration: underline;
    text-underline-offset: 2px;
}

.ne-content a:hover {
    color: #7c3aed;
}

.ne-toolbar-colors {
    display: flex;
    gap: 3px;
    margin-left: 4px;
}

.ne-toolbar-colors span {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    cursor: pointer;
    transition: transform .12s;
    border: 2px solid transparent;
}

.ne-toolbar-colors span:hover {
    transform: scale(1.2);
    border-color: #0e1726;
}

/* ── Content Area ── */
.ne-content {
    flex: 1;
    padding: 24px 28px;
    outline: none;
    font-size: 14px;
    line-height: 1.8;
    color: #0e1726;
    overflow-y: auto;
}

.ne-content:empty::before {
    content: attr(data-placeholder);
    color: #cbd5e1;
    pointer-events: none;
}

.ne-content ul, .ne-content ol {
    padding-left: 24px;
}

.ne-content ul {
    list-style-type: disc;
}

.ne-content ol {
    list-style-type: decimal;
}

.ne-content ul ul { list-style-type: circle; }
.ne-content ul ul ul { list-style-type: square; }
.ne-content ol ol { list-style-type: lower-alpha; }
.ne-content ol ol ol { list-style-type: lower-roman; }

.ne-content li {
    display: list-item;
    margin: 2px 0;
}

.ne-content blockquote {
    border-left: 3px solid #8b5cf6;
    padding-left: 14px;
    margin: 8px 0;
    color: #64748b;
    font-style: italic;
}

.ne-content h1 { font-size: 24px; font-weight: 700; margin: 16px 0 8px; }
.ne-content h2 { font-size: 20px; font-weight: 700; margin: 14px 0 6px; }
.ne-content h3 { font-size: 16px; font-weight: 700; margin: 12px 0 4px; }

/* ── Checklist Items ── */
.note-checklist-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 4px 0;
    line-height: 1.6;
    position: relative;
}

.note-checklist-item input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: #8b5cf6;
    margin-top: 3px;
    flex-shrink: 0;
    cursor: pointer;
}

.note-checklist-item .note-checklist-text {
    flex: 1;
    min-width: 0;
    outline: none;
}

.note-checklist-item .note-checklist-delete {
    width: 18px;
    height: 18px;
    border: none;
    background: transparent;
    color: #cbd5e1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    font-size: 14px;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
    transition: all .15s;
    padding: 0;
}

.note-checklist-item .note-checklist-delete:hover {
    background: #fef2f2;
    color: #ef4444;
}

/* ── Create Modal ── */
.note-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.4);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: nmFadeIn .2s;
}

.note-modal {
    background: #fff;
    border-radius: 16px;
    width: 420px;
    max-width: 92vw;
    box-shadow: 0 20px 60px rgba(0,0,0,.15);
    overflow: hidden;
    animation: nmSlide .25s ease;
}

.note-modal-header {
    padding: 20px 24px;
    border-bottom: 1px solid #f1f3f5;
}

.note-modal-header h3 {
    font-size: 16px;
    font-weight: 700;
    color: #0e1726;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.note-modal-body {
    padding: 20px 24px;
}

.note-modal-body label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    display: block;
    margin-bottom: 6px;
}

.note-modal-body input {
    width: 100%;
    padding: 10px 14px;
    border: 1.5px solid #e0e6ed;
    border-radius: 10px;
    font-size: 13px;
    font-family: inherit;
    color: #0e1726;
    outline: none;
    box-sizing: border-box;
}

.note-modal-body input:focus {
    border-color: #8b5cf6;
    box-shadow: 0 0 0 3px #8b5cf610;
}

.note-colors {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    flex-wrap: wrap;
}

.note-color-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 3px solid transparent;
    cursor: pointer;
    transition: all .15s;
}

.note-color-dot:hover {
    transform: scale(1.15);
}

.note-color-dot.active {
    border-color: #0e1726;
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px currentColor;
}

.note-modal-footer {
    padding: 16px 24px;
    border-top: 1px solid #f1f3f5;
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

.note-modal-footer button {
    padding: 8px 20px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all .15s;
    font-family: inherit;
}

.note-modal-footer .btn-cancel {
    background: #f1f5f9;
    color: #64748b;
}

.note-modal-footer .btn-cancel:hover {
    background: #e2e8f0;
}

.note-modal-footer .btn-create {
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    color: #fff;
    display: flex;
    align-items: center;
    gap: 4px;
}

.note-modal-footer .btn-create:hover {
    box-shadow: 0 4px 12px #8b5cf640;
}

/* ── Animations ── */
@keyframes nmFadeIn { from{opacity:0} to{opacity:1} }
@keyframes nmSlide { from{opacity:0;transform:translateY(-20px)scale(.95)} to{opacity:1;transform:none} }

/* ── Mobile Responsive ── */
@media (max-width: 768px) {
    .notes-layout {
        flex-direction: column;
        height: auto;
        min-height: calc(100vh - 220px);
    }
    .notes-sidebar {
        width: 100%;
        min-width: 100%;
        max-height: 300px;
        border-right: none;
        border-bottom: 1px solid #e0e6ed;
    }
    .notes-sidebar.mobile-hidden {
        display: none;
    }
    .notes-editor-panel {
        min-height: 400px;
    }
    .ne-mobile-back {
        display: flex !important;
    }
}

@media (min-width: 769px) {
    .ne-mobile-back {
        display: none !important;
    }
}

