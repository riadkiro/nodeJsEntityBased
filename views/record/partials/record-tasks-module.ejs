    .dark .tl-kb-empty { color: #506690; }
    .dark .tl-detail { background: #0e1726; }
    .dark .tl-detail-header { border-color: #253b5c; }
    .dark .tl-detail-close { background: #1b2e4b; color: #94a3b8; }
    .dark .tl-detail-main { border-color: #253b5c; }
    .dark .tl-detail-title-input { color: #e0e6ed; }
    .dark .tl-detail-textarea { background: #1b2e4b; border-color: #253b5c; color: #e0e6ed; }
