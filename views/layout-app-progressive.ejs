<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Dexapp - DA Group</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/x-icon" href="favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800&family=Raleway:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600;700;800&family=Lato:wght@400;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" type="text/css" media="screen" href="/themes/default/assets/css/perfect-scrollbar.min.css" />
  <link rel="stylesheet" type="text/css" media="screen" href="/themes/default/assets/css/style.css" />
  <link rel="stylesheet" type="text/css" media="screen" href="/css/app/main.css" />
  <link defer rel="stylesheet" type="text/css" media="screen" href="/themes/default/assets/css/animate.css" />
  <link rel="stylesheet" type="text/css" media="screen" href="/css/picker.css" />
  <script src="/themes/default/assets/js/perfect-scrollbar.min.js"></script>
  <script defer src="/themes/default/assets/js/popper.min.js"></script>
  <script defer src="/themes/default/assets/js/tippy-bundle.umd.min.js"></script>
  <script defer src="/themes/default/assets/js/sweetalert.min.js"></script>
  <script src="https://code.iconify.design/iconify-icon/1.0.8/iconify-icon.min.js"></script>
</head>

<script>
// Server-rendered user theme preference (from DB)
window.__USER_THEME__ = '<%= (typeof user !== "undefined" && user && user.preferences && user.preferences.theme) ? user.preferences.theme : "light" %>';
window.__ACCOUNT_NUMBER__ = '<%= typeof account_number !== "undefined" ? account_number : "" %>';
// Apply immediately to prevent flash-of-wrong-theme
(function(){
  if (window.__USER_THEME__ === 'dark') {
    document.documentElement.classList.add('dark');
  }
})();
</script>

<body x-data="main" class="relative font-nunito text-sm font-normal antialiased"
  :class="[ $store.app.sidebar ? 'toggle-sidebar' : '', $store.app.theme, $store.app.menu, $store.app.layout,$store.app.rtlClass]">
  <!-- sidebar menu overlay -->
  <div x-cloak class="fixed inset-0 z-50 bg-[black]/60 lg:hidden" :class="{'hidden' : !$store.app.sidebar}"
    @click="$store.app.toggleSidebar()"></div>

  <!-- screen loader -->
  <%- include("elements/screen_loader") %>

    <!-- scroll to top button -->
    <%- include("elements/scroll2top") %>

      <!-- theme customizer section -->
      <%- include("elements/customizer") %>

        <div class="main-container min-h-screen text-black dark:text-white-dark" :class="[$store.app.navbar]">
          <!-- sidebar section -->
          <% if (locals.sharedDataRoomMode) { %>
            <%- include("nav/nav-sidebar-shared") %>
          <% } else { %>
            <%- include("nav/nav-sidebar") %>
          <% } %>

            <div class="main-content">
              <!-- header section -->
              <header :class="{'dark' : $store.app.semidark && $store.app.menu === 'horizontal'}">
                <div class="shadow-sm">
                  <!-- top bar menu -->
                  <% if (locals.sharedDataRoomMode) { %>
                    <%- include("nav/nav-topbar-shared") %>
                  <% } else { %>
                    <%- include("nav/nav-topbar") %>
                  <% } %>

                    <!-- horizontal menu -->
                    <% if (!locals.sharedDataRoomMode) { %>
                      <%- include("nav/nav-horizontal") %>
                    <% } %>
                </div>
              </header>
              <!-- end header section -->

              <div class="animate__animated p-6" :class="[$store.app.animation]">
                <!-- start main content section -->
                <%- body %>
                  <!-- end main content section -->

                  <!-- start footer section -->
                  <%- include("footer/footer") %>
                    <!-- end footer section -->
              </div>
            </div>
        </div>
        <!-- RB -->
        <script src="/themes/default/assets/js/alpine-rb-nav-item-menu.js"></script>
        <!-- RB -->
        <!-- Avant le script principal -->
        <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
        <script>
        // Global touch support for SortableJS
        (function() {
          function injectTouchDefaults(opts) {
            opts = opts || {};
            if (opts.delay === undefined) opts.delay = 150;
            if (opts.delayOnTouchOnly === undefined) opts.delayOnTouchOnly = true;
            if (opts.touchStartThreshold === undefined) opts.touchStartThreshold = 5;
            return opts;
          }
          var _origCreate = Sortable.create;
          Sortable.create = function(el, opts) {
            return _origCreate.call(Sortable, el, injectTouchDefaults(opts));
          };
          var _OrigSortable = window.Sortable;
          var PatchedSortable = function(el, opts) {
            return new _OrigSortable(el, injectTouchDefaults(opts));
          };
          Object.keys(_OrigSortable).forEach(function(key) {
            if (key === 'create') {
              PatchedSortable.create = Sortable.create;
            } else {
              PatchedSortable[key] = _OrigSortable[key];
            }
          });
          PatchedSortable.prototype = _OrigSortable.prototype;
          window.Sortable = PatchedSortable;
        })();
        </script>

        <script src="/themes/default/assets/js/alpine-collaspe.min.js"></script>
        <script src="/themes/default/assets/js/alpine-persist.min.js"></script>
        <!-- Picker components (vanilla JS) -->
        <script src="/assets/js/icon-picker.js"></script>
        <script src="/assets/js/color-picker.js"></script>
        <script defer src="/themes/default/assets/js/alpine-ui.min.js"></script>
        <script defer src="/themes/default/assets/js/alpine-focus.min.js"></script>
        <script defer src="/themes/default/assets/js/alpine.min.js"></script>
        <script src="/themes/default/assets/js/custom.js"></script>
        <script defer src="/themes/default/assets/js/apexcharts.js"></script>

        <script>
          document.addEventListener("alpine:init", () => {
            // main section
            Alpine.data("scrollToTop", () => ({
              showTopButton: false,
              init() {
                window.onscroll = () => {
                  this.scrollFunction();
                };
              },

              scrollFunction() {
                if (
                  document.body.scrollTop > 50 ||
                  document.documentElement.scrollTop > 50
                ) {
                  this.showTopButton = true;
                } else {
                  this.showTopButton = false;
                }
              },

              goToTop() {
                document.body.scrollTop = 0;
                document.documentElement.scrollTop = 0;
              },
            }));

            // theme customization
            Alpine.data("customizer", () => ({
              showCustomizer: false,
            }));

            // sidebar section
            Alpine.data("sidebar", () => ({
              init() {
                const selector = document.querySelector(
                  '.sidebar ul a[href="' + window.location.pathname + '"]'
                );
                if (selector) {
                  selector.classList.add("active");
                  const ul = selector.closest("ul.sub-menu");
                  if (ul) {
                    let ele = ul.closest("li.menu").querySelectorAll(".nav-link");
                    if (ele) {
                      ele = ele[0];
                      setTimeout(() => {
                        ele.click();
                      });
                    }
                  }
                }
              },
            }));

            // header section
            Alpine.data("header", () => ({
              init() {
                const selector = document.querySelector(
                  'ul.horizontal-menu a[href="' + window.location.pathname + '"]'
                );
                if (selector) {
                  selector.classList.add("active");
                  const ul = selector.closest("ul.sub-menu");
                  if (ul) {
                    let ele = ul.closest("li.menu").querySelectorAll(".nav-link");
                    if (ele) {
                      ele = ele[0];
                      setTimeout(() => {
                        ele.classList.add("active");
                      });
                    }
                  }
                }
              },

              notifications: [
                {
                  id: 1,
                  profile: "user-profile.jpeg",
                  message:
                    '<strong class="text-sm mr-1">John Doe</strong>invite you to <strong>Prototyping</strong>',
                  time: "45 min ago",
                },
                {
                  id: 2,
                  profile: "profile-34.jpeg",
                  message:
                    '<strong class="text-sm mr-1">Adam Nolan</strong>mentioned you to <strong>UX Basics</strong>',
                  time: "9h Ago",
                },
                {
                  id: 3,
                  profile: "profile-16.jpeg",
                  message:
                    '<strong class="text-sm mr-1">Anna Morgan</strong>Upload a file',
                  time: "9h Ago",
                },
              ],

              messages: [
                {
                  id: 1,
                  image:
                    '<span class="grid place-content-center w-9 h-9 rounded-full bg-success-light dark:bg-success text-success dark:text-success-light"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></span>',
                  title: "Congratulations!",
                  message: "Your OS has been updated.",
                  time: "1hr",
                },
                {
                  id: 2,
                  image:
                    '<span class="grid place-content-center w-9 h-9 rounded-full bg-info-light dark:bg-info text-info dark:text-info-light"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg></span>',
                  title: "Did you know?",
                  message: "You can switch between artboards.",
                  time: "2hr",
                },
                {
                  id: 3,
                  image:
                    '<span class="grid place-content-center w-9 h-9 rounded-full bg-danger-light dark:bg-danger text-danger dark:text-danger-light"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></span>',
                  title: "Something went wrong!",
                  message: "Send Reposrt",
                  time: "2days",
                },
                {
                  id: 4,
                  image:
                    '<span class="grid place-content-center w-9 h-9 rounded-full bg-warning-light dark:bg-warning text-warning dark:text-warning-light"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">    <circle cx="12" cy="12" r="10"></circle>    <line x1="12" y1="8" x2="12" y2="12"></line>    <line x1="12" y1="16" x2="12.01" y2="16"></line></svg></span>',
                  title: "Warning",
                  message: "Your password strength is low.",
                  time: "5days",
                },
              ],

              languages: [
                {
                  id: 1,
                  key: "Chinese",
                  value: "zh",
                },
                {
                  id: 2,
                  key: "Danish",
                  value: "da",
                },
                {
                  id: 3,
                  key: "English",
                  value: "en",
                },
                {
                  id: 4,
                  key: "French",
                  value: "fr",
                },
                {
                  id: 5,
                  key: "German",
                  value: "de",
                },
                {
                  id: 6,
                  key: "Greek",
                  value: "el",
                },
                {
                  id: 7,
                  key: "Hungarian",
                  value: "hu",
                },
                {
                  id: 8,
                  key: "Italian",
                  value: "it",
                },
                {
                  id: 9,
                  key: "Japanese",
                  value: "ja",
                },
                {
                  id: 10,
                  key: "Polish",
                  value: "pl",
                },
                {
                  id: 11,
                  key: "Portuguese",
                  value: "pt",
                },
                {
                  id: 12,
                  key: "Russian",
                  value: "ru",
                },
                {
                  id: 13,
                  key: "Spanish",
                  value: "es",
                },
                {
                  id: 14,
                  key: "Swedish",
                  value: "sv",
                },
                {
                  id: 15,
                  key: "Turkish",
                  value: "tr",
                },
              ],

              removeNotification(value) {
                this.notifications = this.notifications.filter(
                  (d) => d.id !== value
                );
              },

              removeMessage(value) {
                this.messages = this.messages.filter((d) => d.id !== value);
              },
            }));

            // ICON PICKER COMPONENT REGISTRATION
            Alpine.data("iconPicker", (callback, initialValue) => ({
              isOpen: false,
              search: '',
              selectedIcon: (initialValue && initialValue !== 'tempTabIcon') ? initialValue : 'tabler:apps',
              onSelect: callback,
              dropdownStyle: 'display: none;',
              icons: [
                'tabler:home', 'tabler:apps', 'tabler:settings', 'tabler:bell', 'tabler:search', 'tabler:dots',
                'tabler:alert-circle', 'tabler:info-circle', 'tabler:check-circle', 'tabler:shield-check',
                'tabler:user', 'tabler:users', 'tabler:mail', 'tabler:phone', 'tabler:messages',
                'tabler:file', 'tabler:file-text', 'tabler:folder', 'tabler:copy', 'tabler:trash',
                'tabler:wallet', 'tabler:credit-card', 'tabler:shopping-cart', 'tabler:package',
                'tabler:photo', 'tabler:video', 'tabler:music', 'tabler:star', 'tabler:heart',
                'tabler:code', 'tabler:database', 'tabler:server', 'tabler:device-laptop',
                'tabler:map-pin', 'tabler:calendar', 'tabler:clock', 'tabler:flag'
              ],
              init() {
                console.log('[IconPicker] Init', { initialValue });
                if (initialValue === 'tempTabIcon') {
                  this.$watch('$data.tempTabIcon', (val) => { this.selectedIcon = val; });
                  this.selectedIcon = this.$data.tempTabIcon || 'tabler:apps';
                }
              },
              toggle() {
                this.isOpen = !this.isOpen;
                console.log('[IconPicker] Toggle Modal:', this.isOpen);
              },
              select(icon) {
                this.selectedIcon = icon;
                if (typeof this.onSelect === 'function') this.onSelect(icon);
                this.isOpen = false;
              }
            }));
          });
        </script>
        <script src="/js/delete.js"></script>
</body>

</html>
