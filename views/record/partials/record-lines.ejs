                                        @input="getEditLines()[editModal.lineIdx].values[col.key] = parseFloat($event.target.value) || 0; recomputeLine(getEditLines()[editModal.lineIdx])"
                                        step="any" />
                                </template>

                                <!-- Money -->
                                <template x-if="col.type === 'money'">
                                    <input type="number" class="lp-input" style="width: 100%; height: 34px; font-size: 13px;"
                                        :value="getEditLines()[editModal.lineIdx].values[col.key] || ''"
                                        @input="getEditLines()[editModal.lineIdx].values[col.key] = parseFloat($event.target.value) || 0; recomputeLine(getEditLines()[editModal.lineIdx])"
                                        step="0.01" />
