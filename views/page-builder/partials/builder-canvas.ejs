<!-- Styles for Equal Height Panels -->
<style>
  /* When a parent container is flex column, the direct child panel should stretch */
  [style*="flex-direction: column"] > .panel {
    flex: 1;
  }
  
  /* Gap between consecutive blocks in a column (stacked panels) */
  [data-sortable-column] > div + div {
    margin-top: 1.5rem; /* 24px, same as gap-6 */
  }
  
  /* Dark mode: ensure panels are visible against the dark canvas */
  .dark [data-sortable-column] .panel {
    border: 1px solid #374151; /* gray-700 */
  }
</style>

<!-- Canvas Area (WYSIWYG) -->
<div class="flex-1 overflow-auto bg-gray-100 dark:bg-gray-900 p-6" @click="builderState.selectedBlockId = null; if (builderState.drawerMode === 'block-settings') { builderState.drawerMode = 'blocks'; }">
  <div class="max-w-7xl mx-auto">
    
    <!-- Empty State -->
    <template x-if="!pageConfig.layout[builderState.activeTab] || pageConfig.layout[builderState.activeTab].length === 0">
      <div class="flex flex-col items-center justify-center h-96 border-2 border-dashed border-gray-300 dark:border-gray-800 rounded-lg">
        <iconify-icon icon="solar:widget-5-bold-duotone" width="64" class="text-gray-400 mb-4"></iconify-icon>
        <p class="text-gray-500 mb-4">No rows yet. Start building your page!</p>
        <button @click="addRow()" class="btn btn-primary">
          <iconify-icon icon="solar:add-circle-bold" class="mr-1"></iconify-icon>
          Add First Row
        </button>
      </div>
    </template>

    <!-- Rows Container -->
    <div class="space-y-6">
      <template x-for="(row, rowIndex) in pageConfig.layout[builderState.activeTab]" :key="row.id">
        <div 
          class="group relative"
          @mouseenter="builderState.hoveredRowId = row.id"
          @mouseleave="builderState.hoveredRowId = null"
          @click="selectRow(row.id)">
          
          <!-- Row Toolbar (hover) -->
          <div 
            x-data="{ layoutMode: false }"
            x-show="builderState.mode === 'edit' && builderState.hoveredRowId === row.id"
            class="absolute -top-8 left-1/2 -translate-x-1/2 bg-white dark:bg-gray-800 shadow-lg rounded-lg p-1 flex gap-1 z-20">
            
            <!-- Normal mode buttons -->
            <template x-if="!layoutMode">
              <div class="flex gap-1">
                <button 
                  @click.stop="layoutMode = true"
                  title="Column Layout" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                  <iconify-icon icon="solar:widget-5-bold" width="16"></iconify-icon>
                </button>
                <button 
                  @click.stop="duplicateRow(row.id)"
                  title="Duplicate Row" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                  <iconify-icon icon="solar:copy-bold" width="16"></iconify-icon>
                </button>
              </div>
            </template>


            <!-- Row Controls (show on hover) -->
            <div 
              x-show="builderState.mode === 'edit'"
              class="opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex gap-1 items-center">
              <button 
                @click.stop="moveUpRow(row.id)"
                title="Move Up" 
                class="w-7 h-7 flex items-center justify-center rounded hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                <iconify-icon icon="solar:arrow-up-outline" width="16"></iconify-icon>
              </button>
              <button 
                @click.stop="moveDownRow(row.id)"
                title="Move Down" 
                class="w-7 h-7 flex items-center justify-center rounded hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                <iconify-icon icon="solar:arrow-down-outline" width="16"></iconify-icon>
              </button>
              <button 
                @click.stop="deleteRow(row.id)"
                title="Delete Row" 
                class="w-7 h-7 flex items-center justify-center rounded hover:bg-red-100 dark:hover:bg-red-900/20 text-gray-500 hover:text-red-600 dark:text-gray-400 dark:hover:text-red-400">
                <iconify-icon icon="solar:trash-bin-minimalistic-outline" width="16"></iconify-icon>
              </button>
            </div>

            <!-- Layout mode buttons -->
            <template x-if="layoutMode">
              <div class="flex gap-1 items-center">
                <!-- Preset 1 column -->
                <button 
                  @click.stop="setRowLayout(row.id, 1); layoutMode = false"
                  title="1 Column" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-primary/10 hover:text-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="4" y="4" width="16" height="16" rx="2"/>
                  </svg>
                </button>
                
                <!-- Preset 2 columns -->
                <button 
                  @click.stop="setRowLayout(row.id, 2); layoutMode = false"
                  title="2 Columns" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-primary/10 hover:text-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="4" y="4" width="6" height="16" rx="1"/>
                    <rect x="14" y="4" width="6" height="16" rx="1"/>
                  </svg>
                </button>
                
                <!-- Preset 3 columns -->
                <button 
                  @click.stop="setRowLayout(row.id, 3); layoutMode = false"
                  title="3 Columns" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-primary/10 hover:text-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="4" height="16" rx="1"/>
                    <rect x="10" y="4" width="4" height="16" rx="1"/>
                    <rect x="17" y="4" width="4" height="16" rx="1"/>
                  </svg>
                </button>
                
                <!-- Preset 4 columns -->
                <button 
                  @click.stop="setRowLayout(row.id, 4); layoutMode = false"
                  title="4 Columns" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-primary/10 hover:text-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="3" height="16" rx="1"/>
                    <rect x="8.5" y="4" width="3" height="16" rx="1"/>
                    <rect x="14" y="4" width="3" height="16" rx="1"/>
                    <rect x="19.5" y="4" width="3" height="16" rx="1"/>
                  </svg>
                </button>

                <div class="w-px h-6 bg-gray-300 dark:bg-gray-600"></div>

                <!-- Add column -->
                <button 
                  @click.stop="addColumnToRow(row.id)"
                  title="Add Column (max 12)" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-success/10 hover:text-success">
                  <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
                </button>

                <div class="w-px h-6 bg-gray-300 dark:bg-gray-600"></div>

                <!-- Equal Height Toggle -->
                <button 
                  @click.stop="toggleEqualHeight(row.id)"
                  :title="row.equalHeight ? 'Disable Equal Height' : 'Enable Equal Height'" 
                  :class="row.equalHeight ? 'bg-primary text-white' : 'hover:bg-primary/10 hover:text-primary'"
                  class="w-8 h-8 flex items-center justify-center rounded transition-colors">
                  <iconify-icon icon="solar:align-vertical-center-bold" width="16"></iconify-icon>
                </button>

                <!-- Close layout mode -->
                <button 
                  @click.stop="layoutMode = false"
                  title="Close" 
                  class="w-8 h-8 flex items-center justify-center rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                  <iconify-icon icon="solar:close-circle-bold" width="16"></iconify-icon>
                </button>
              </div>
            </template>
          </div>

          <!-- Row Grid -->
          <div 
            x-data="{ rowHover: false }"
            @mouseenter="rowHover = true"
            @mouseleave="rowHover = false"
            :class="[
              'grid gap-6',
              builderState.mode === 'edit' && 'min-h-[100px]',
              row.equalHeight && 'items-stretch'
            ]"
            :style="`grid-template-columns: repeat(12, 1fr)`">
            
            <!-- Columns -->
            <template x-for="(column, colIndex) in row.columns" :key="colIndex">
              <div 
                :style="`grid-column: span ${column.width}`"
                class="relative transition-all duration-200 group/col"
                :class="[
                  builderState.mode === 'edit' && column.blocks.length === 0 && 'border-2 border-dashed border-gray-200 dark:border-gray-800 rounded-lg hover:border-gray-400 dark:hover:border-gray-500',
                  builderState.mode === 'edit' && column.blocks.length === 0 && !row.equalHeight && 'h-[90px]',
                  row.equalHeight && 'flex flex-col h-full'
                ]">
                
                <!-- Resize Handle (visible on row hover) -->
                <div 
                  x-cloak
                  x-show="builderState.mode === 'edit' && rowHover"
                  x-transition:enter="transition ease-out duration-150"
                  x-transition:enter-start="opacity-0"
                  x-transition:enter-end="opacity-100"
                  x-transition:leave="transition ease-in duration-100"
                  x-transition:leave-start="opacity-100"
                  x-transition:leave-end="opacity-0"
                  @mousedown="startResize(row.id, colIndex, $event)"
                  style="position: absolute; right: 0; top: 50%; transform: translate(50%, -50%); cursor: col-resize; z-index: 50; display: flex; align-items: center;"
                  class="text-gray-400 dark:text-gray-500 hover:text-primary">
                  <iconify-icon icon="solar:alt-arrow-left-bold" width="12"></iconify-icon>
                  <iconify-icon icon="solar:alt-arrow-right-bold" width="12" style="margin-left: -4px;"></iconify-icon>
                </div>
                
                
                <!-- Blocks in Column -->
                <div 
                  data-sortable-column
                  :data-row-id="row.id"
                  :data-col-index="colIndex"
                  :class="[
                    column.blocks.length > 0 ? 'min-h-[150px]' : 'h-full',
                    row.equalHeight && 'flex-1 flex flex-col'
                  ]"
                  x-init="initSortableColumn($el, row.id, colIndex)">
                  <template x-for="blockId in column.blocks" :key="blockId">
                    <div 
                      :data-block-id="blockId"
                      @click.stop="selectBlock(blockId)"
                      @mouseenter="builderState.hoveredBlockId = blockId"
                      @mouseleave="builderState.hoveredBlockId = null"
                      class="relative"
                      :class="[
                        builderState.mode === 'edit' && builderState.selectedBlockId === blockId && 'ring-2 ring-primary ring-offset-2',
                        builderState.mode === 'edit' && builderState.hoveredBlockId === blockId && builderState.selectedBlockId !== blockId && 'ring-1 ring-gray-300 dark:ring-gray-600',
                        builderState.mode === 'edit' && 'cursor-pointer transition-all duration-150',
                        row.equalHeight && 'flex-1'
                      ]">
                      
                      <!-- Block Action Popover (on selection) - positioned inside top-right -->
                      <div 
                        x-show="builderState.mode === 'edit' && builderState.selectedBlockId === blockId"
                        x-transition:enter="transition ease-out duration-100"
                        x-transition:enter-start="opacity-0 scale-95"
                        x-transition:enter-end="opacity-100 scale-100"
                        class="absolute top-2 right-2 bg-white dark:bg-gray-800 shadow-xl rounded-lg p-1 flex gap-1 z-50 border border-gray-200 dark:border-gray-800">
                        <!-- Options Button -->
                        <button 
                          @click.stop="openBlockSettings(blockId)"
                          title="Options" 
                          class="w-8 h-8 flex items-center justify-center rounded hover:bg-primary/10 hover:text-primary transition-colors">
                          <iconify-icon icon="solar:settings-bold-duotone" width="18"></iconify-icon>
                        </button>
                        <!-- Duplicate Button -->
                        <button 
                          @click.stop="duplicateBlock(blockId)"
                          title="Dupliquer" 
                          class="w-8 h-8 flex items-center justify-center rounded hover:bg-info/10 hover:text-info transition-colors">
                          <iconify-icon icon="solar:copy-bold-duotone" width="18"></iconify-icon>
                        </button>
                        <!-- Delete Button -->
                        <button 
                          @click.stop="deleteBlock(blockId)"
                          title="Supprimer" 
                          class="w-8 h-8 flex items-center justify-center rounded hover:bg-danger/10 hover:text-danger transition-colors">
                          <iconify-icon icon="solar:trash-bin-trash-bold-duotone" width="18"></iconify-icon>
                        </button>
                      </div>

                      <!-- Block Content (template-based for proper styling) -->
                      <div x-data="{ block: pageConfig.blocks[blockId] }" class="h-full" :style="row.equalHeight && 'display: flex; flex-direction: column;'">
                        
                        <!-- Panel Block -->
                        <template x-if="block && block.type === 'panel'">
                          <div class="panel">
                            <div class="mb-5 flex items-center justify-between">
                              <h5 class="text-lg font-semibold dark:text-white" x-text="block.title || 'Panel Title'"></h5>
                            </div>
                            <div class="text-sm text-gray-500 dark:text-gray-400">Panel content...</div>
                          </div>
                        </template>

                        <!-- Text Block -->
                        <template x-if="block && block.type === 'text'">
                          <div class="panel">
                            <div x-text="block.content || 'Double-click to edit text...'" class="prose max-w-none dark:text-gray-300"></div>
                          </div>
                        </template>

                        <!-- KPI Card Block -->
                        <template x-if="block && block.type === 'kpi-card'">
                          <div class="panel h-full">
                            <div class="mb-1 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase" x-text="block.label || 'KPI'"></div>
                            <div class="text-3xl font-bold text-primary mb-2">0</div>
                            <div class="text-xs text-success">↑ 12%</div>
                          </div>
                        </template>

                        <!-- Statistics Block -->
                        <template x-if="block && block.type === 'statistics'">
                          <div class="panel h-full" x-data="{
                            initCharts() {
                              // Total Visits Chart
                              const totalVisit = new ApexCharts(this.$refs.totalVisit, {
                                series: [{ data: [21, 9, 36, 12, 44, 25, 59, 41, 66, 25] }],
                                chart: {
                                  height: 58,
                                  type: 'line',
                                  fontFamily: 'Nunito, sans-serif',
                                  sparkline: { enabled: true },
                                  dropShadow: {
                                    enabled: true,
                                    blur: 3,
                                    color: '#009688',
                                    opacity: 0.4
                                  }
                                },
                                stroke: { curve: 'smooth', width: 2 },
                                colors: ['#009688'],
                                grid: { padding: { top: 5, bottom: 5, left: 5, right: 5 } },
                                tooltip: { x: { show: false }, y: { title: { formatter: () => '' } } }
                              });
                              totalVisit.render();

                              // Paid Visits Chart
                              const paidVisit = new ApexCharts(this.$refs.paidVisit, {
                                series: [{ data: [22, 19, 30, 47, 32, 44, 34, 55, 41, 69] }],
                                chart: {
                                  height: 58,
                                  type: 'line',
                                  fontFamily: 'Nunito, sans-serif',
                                  sparkline: { enabled: true },
                                  dropShadow: {
                                    enabled: true,
                                    blur: 3,
                                    color: '#e7515a',
                                    opacity: 0.4
                                  }
                                },
                                stroke: { curve: 'smooth', width: 2 },
                                colors: ['#e7515a'],
                                grid: { padding: { top: 5, bottom: 5, left: 5, right: 5 } },
                                tooltip: { x: { show: false }, y: { title: { formatter: () => '' } } }
                              });
                              paidVisit.render();
                            }
                          }" x-init="setTimeout(() => initCharts(), 100)">
                            <div class="mb-5 flex items-center justify-between dark:text-white-light">
                              <h5 class="text-lg font-semibold dark:text-white" x-text="block.title || 'Statistics'"></h5>
                              <div x-data="dropdown" @click.outside="open = false" class="dropdown">
                                <a href="javascript:;" @click="toggle">
                                  <svg class="h-5 w-5 text-black/70 hover:!text-primary dark:text-white/70" viewBox="0 0 24 24" fill="none">
                                    <circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
                                    <circle opacity="0.5" cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
                                    <circle cx="19" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
                                  </svg>
                                </a>
                                <ul x-cloak x-show="open" x-transition class="ltr:right-0 rtl:left-0">
                                  <li><a href="javascript:;" @click="toggle">This Week</a></li>
                                  <li><a href="javascript:;" @click="toggle">Last Week</a></li>
                                  <li><a href="javascript:;" @click="toggle">This Month</a></li>
                                  <li><a href="javascript:;" @click="toggle">Last Month</a></li>
                                </ul>
                              </div>
                            </div>
                            <div class="grid gap-8 text-sm font-bold text-[#515365] sm:grid-cols-2">
                              <div>
                                <div>
                                  <div>Total Visits</div>
                                  <div class="text-lg text-[#f8538d]">423,964</div>
                                </div>
                                <div x-ref="totalVisit"></div>
                              </div>
                              <div>
                                <div>
                                  <div>Paid Visits</div>
                                  <div class="text-lg text-[#f8538d]">7,929</div>
                                </div>
                                <div x-ref="paidVisit"></div>
                              </div>
                            </div>
                          </div>
                        </template>

                        <!-- Expense Tracker Block -->
                        <template x-if="block && block.type === 'expense-tracker'">
                          <div class="panel h-full">
                            <div class="mb-5 flex items-center justify-between dark:text-white-light">
                              <h5 class="text-lg font-semibold dark:text-white" x-text="block.title || 'Expenses'"></h5>
                            </div>
                            <div class="my-10 text-3xl font-bold text-[#e95f2b]">
                              <span x-text="`${block.currency || '$'} ${(block.value || 0).toLocaleString()}`"></span>
                              <span class="text-sm text-black ltr:mr-1 rtl:ml-1 dark:text-white-light" x-text="block.period || 'this week'"></span>
                              <svg class="inline h-5 w-5 text-success" viewBox="0 0 24 24" fill="none">
                                <path opacity="0.5" d="M22 7L14.6203 14.3347C13.6227 15.3263 13.1238 15.822 12.5051 15.822C11.8864 15.8219 11.3876 15.326 10.3902 14.3342L10.1509 14.0962C9.15254 13.1035 8.65338 12.6071 8.03422 12.6074C7.41506 12.6076 6.91626 13.1043 5.91867 14.0977L2 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M22.0001 12.5458V7H16.418" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </div>
                            <div class="flex items-center justify-between">
                              <div class="h-5 w-full overflow-hidden rounded-full bg-dark-light p-1 shadow-3xl dark:bg-dark-light/10 dark:shadow-none">
                                <div class="relative h-full w-full rounded-full bg-gradient-to-r from-[#4361ee] to-[#805dca] before:absolute before:inset-y-0 before:m-auto before:h-2 before:w-2 before:rounded-full before:bg-white ltr:before:right-0.5 rtl:before:left-0.5" :style="`width: ${block.progress || 0}%`"></div>
                              </div>
                              <span class="ltr:ml-5 rtl:mr-5 dark:text-white-light" x-text="`${block.progress || 0}%`"></span>
                            </div>
                          </div>
                        </template>

                        <!-- Progress List Block -->
                        <template x-if="block && block.type === 'progress-list'">
                          <div class="panel h-full" x-data="{
                            getGradient(color) {
                              const gradients = {
                                primary: 'linear-gradient(to right, #009ffd, #2a2a72)',
                                danger: 'linear-gradient(to right, #a71d31, #3f0d12)',
                                warning: 'linear-gradient(to right, #fe5f75, #fc9842)',
                                success: 'linear-gradient(to right, #11998e, #38ef7d)',
                                info: 'linear-gradient(to right, #4361ee, #805dca)',
                                secondary: 'linear-gradient(to right, #667eea, #764ba2)'
                              };
                              return gradients[color] || gradients.primary;
                            },
                            getBgColor(color) {
                              const colors = {
                                primary: '#4361ee',
                                danger: '#e7515a',
                                warning: '#e2a03f',
                                success: '#00ab55',
                                info: '#2196f3',
                                secondary: '#805dca'
                              };
                              return colors[color] || colors.primary;
                            }
                          }">
                            <div class="mb-5 flex items-start justify-between">
                              <h5 class="text-lg font-semibold dark:text-white-light" x-text="block.title || 'Progress List'"></h5>
                            </div>
                            <div class="flex flex-col space-y-5">
                              <template x-for="item in block.items || []" :key="item.label">
                                <div class="flex items-center">
                                  <div class="h-9 w-9">
                                    <div class="flex h-9 w-9 items-center justify-center rounded-xl" 
                                         :style="`background-color: ${getBgColor(item.color)}20; color: ${getBgColor(item.color)}`">
                                      <iconify-icon icon="solar:globe-bold" width="20"></iconify-icon>
                                    </div>
                                  </div>
                                  <div class="w-full flex-initial px-3">
                                    <div class="w-summary-info mb-1 flex justify-between font-semibold text-white-dark">
                                      <h6 x-text="item.label"></h6>
                                      <p class="text-xs ltr:ml-auto rtl:mr-auto" x-text="`${item.value}%`"></p>
                                    </div>
                                    <div>
                                      <div class="h-5 w-full overflow-hidden rounded-full bg-dark-light p-1 shadow-3xl dark:bg-dark-light/10 dark:shadow-none">
                                        <div class="relative h-full rounded-full before:absolute before:inset-y-0 before:m-auto before:h-2 before:w-2 before:rounded-full before:bg-white ltr:before:right-0.5 rtl:before:left-0.5"
                                             :style="`width: ${item.value}%; background: ${getGradient(item.color)}`"></div>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </template>
                            </div>
                          </div>
                        </template>

                        <!-- Work Queue Block (Cockpit) -->
                        <template x-if="block && block.type === 'work-queue'">
                          <div class="panel h-full" :style="block.props?.height ? `min-height: ${block.props.height}px` : ''">
                            <div class="mb-4 flex items-center justify-between">
                              <h5 class="text-lg font-semibold dark:text-white" x-text="block.title || 'Queue'"></h5>
                              <div class="flex gap-1">
                                <span class="badge bg-info/20 text-info rounded-full px-2 text-xs">12 en attente</span>
                              </div>
                            </div>
                            <div class="space-y-2 text-sm">
                              <div class="flex items-center justify-between p-2 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                                <div class="flex items-center gap-2">
                                  <div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center text-xs font-bold">JD</div>
                                  <div>
                                    <div class="font-medium">Jean Dupont</div>
                                    <div class="text-xs text-gray-500">Consultation</div>
                                  </div>
                                </div>
                                <div class="flex gap-1">
                                  <button class="p-1 hover:bg-primary/10 rounded"><iconify-icon icon="solar:phone-bold" width="14"></iconify-icon></button>
                                  <button class="p-1 hover:bg-success/10 rounded text-success"><iconify-icon icon="solar:check-circle-bold" width="14"></iconify-icon></button>
                                </div>
                              </div>
                              <div class="flex items-center justify-between p-2 bg-warning/10 rounded-lg border-l-2 border-warning">
                                <div class="flex items-center gap-2">
                                  <div class="w-8 h-8 rounded-full bg-warning/20 flex items-center justify-center text-xs font-bold">ML</div>
                                  <div>
                                    <div class="font-medium">Marie Leblanc <span class="text-warning text-xs">⚡ Urgent</span></div>
                                    <div class="text-xs text-gray-500">Douleur aiguë</div>
                                  </div>
                                </div>
                                <div class="flex gap-1">
                                  <button class="p-1 hover:bg-primary/10 rounded"><iconify-icon icon="solar:phone-bold" width="14"></iconify-icon></button>
                                </div>
                              </div>
                            </div>
                          </div>
                        </template>

                        <!-- Comms Dock Block (Cockpit) -->
                        <template x-if="block && block.type === 'comms-dock'">
                          <div class="panel h-full flex flex-col" :style="block.props?.height ? `min-height: ${block.props.height}px` : ''">
                            <div class="mb-4 flex items-center justify-between">
                              <h5 class="text-lg font-semibold dark:text-white" x-text="block.title || 'Communications'"></h5>
                            </div>
                            <!-- Quick Actions -->
                            <div class="grid grid-cols-2 gap-2 mb-4">
                              <button class="btn btn-outline-primary btn-sm"><iconify-icon icon="solar:call-medicine-bold" width="14" class="mr-1"></iconify-icon>Suivant</button>
                              <button class="btn btn-outline-info btn-sm"><iconify-icon icon="solar:map-arrow-right-bold" width="14" class="mr-1"></iconify-icon>Viens ici</button>
                              <button class="btn btn-outline-success btn-sm"><iconify-icon icon="solar:document-medicine-bold" width="14" class="mr-1"></iconify-icon>Ordonnance</button>
                              <button class="btn btn-outline-warning btn-sm"><iconify-icon icon="solar:test-tube-bold" width="14" class="mr-1"></iconify-icon>Labo</button>
                            </div>
                            <!-- Messages preview -->
                            <div class="flex-1 overflow-y-auto space-y-2 text-sm bg-gray-50 dark:bg-gray-700/30 rounded-lg p-2">
                              <div class="bg-white dark:bg-gray-800 p-2 rounded text-xs">
                                <div class="font-medium text-gray-500">Secrétaire</div>
                                <div>Le patient Dupont est arrivé</div>
                              </div>
                            </div>
                          </div>
                        </template>

                        <!-- Activity Feed Block (Cockpit) -->
                        <template x-if="block && block.type === 'activity-feed'">
                          <div class="panel h-full" :style="block.props?.height ? `min-height: ${block.props.height}px` : ''">
                            <div class="mb-4 flex items-center justify-between">
                              <h5 class="text-lg font-semibold dark:text-white" x-text="block.title || 'Activités'"></h5>
                            </div>
                            <div class="space-y-3 text-sm">
                              <div class="flex gap-3">
                                <div class="w-6 h-6 rounded-full bg-success/20 flex items-center justify-center shrink-0">
                                  <iconify-icon icon="solar:check-circle-bold" width="12" class="text-success"></iconify-icon>
                                </div>
                                <div>
                                  <div class="font-medium">Consultation terminée</div>
                                  <div class="text-xs text-gray-500">Jean Dupont • il y a 5 min</div>
                                </div>
                              </div>
                              <div class="flex gap-3">
                                <div class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center shrink-0">
                                  <iconify-icon icon="solar:phone-bold" width="12" class="text-primary"></iconify-icon>
                                </div>
                                <div>
                                  <div class="font-medium">Patient appelé</div>
                                  <div class="text-xs text-gray-500">Marie Leblanc • il y a 10 min</div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </template>

                        <!-- Focus Card Block (Cockpit) -->
                        <template x-if="block && block.type === 'focus-card'">
                          <div class="panel h-full" :style="block.props?.height ? `min-height: ${block.props.height}px` : ''">
                            <div class="mb-4 flex items-center justify-between">
                              <h5 class="text-lg font-semibold dark:text-white" x-text="block.title || 'Prochain Patient'"></h5>
                              <span class="badge bg-primary/10 text-primary">En attente</span>
                            </div>
                            <div class="flex items-center gap-4">
                              <div class="w-14 h-14 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xl font-bold">JD</div>
                              <div>
                                <div class="text-xl font-bold dark:text-white">Jean Dupont</div>
                                <div class="text-gray-500 dark:text-gray-400 text-sm">Consultation • Salle 3</div>
                                <div class="text-xs mt-1 text-gray-400">Arrivé il y a 15 min</div>
                              </div>
                            </div>
                            <div class="mt-4 flex gap-2">
                              <button class="btn btn-primary btn-sm flex-1">
                                <iconify-icon icon="solar:phone-bold" width="14" class="mr-1"></iconify-icon>Appeler
                              </button>
                              <button class="btn btn-outline-primary btn-sm flex-1">
                                <iconify-icon icon="solar:document-bold" width="14" class="mr-1"></iconify-icon>Dossier
                              </button>
                            </div>
                          </div>
                        </template>

                        <!-- Urgency Radar Block (Cockpit) -->
                        <template x-if="block && block.type === 'urgency-radar'">
                          <div class="panel h-full border-l-4 border-danger" :style="block.props?.height ? `min-height: ${block.props.height}px` : ''">
                            <div class="mb-4 flex items-center justify-between">
                              <h5 class="text-lg font-semibold dark:text-white flex items-center gap-2">
                                <iconify-icon icon="solar:danger-triangle-bold" class="text-danger"></iconify-icon>
                                <span x-text="block.title || 'Urgences'"></span>
                              </h5>
                              <span class="badge bg-danger text-white rounded-full px-2 text-xs">3</span>
                            </div>
                            <div class="space-y-2 text-sm">
                              <div class="p-2 bg-danger/10 rounded-lg flex items-center justify-between">
                                <div>
                                  <div class="font-medium text-danger">Marie Leblanc</div>
                                  <div class="text-xs text-gray-500">Douleur aiguë • 20 min</div>
                                </div>
                                <button class="btn btn-danger btn-sm">Traiter</button>
                              </div>
                            </div>
                          </div>
                        </template>

                        <!-- KPI Cards Block (Cockpit) -->
                        <template x-if="block && block.type === 'kpi-cards'">
                          <div class="panel h-full" :style="block.props?.height ? `min-height: ${block.props.height}px` : ''">
                            <div class="mb-4">
                              <h5 class="text-lg font-semibold dark:text-white" x-text="block.title || 'Indicateurs'"></h5>
                            </div>
                            <div class="grid grid-cols-4 gap-4">
                              <div class="text-center">
                                <div class="text-2xl font-bold text-primary">24</div>
                                <div class="text-xs text-gray-500">Patients</div>
                              </div>
                              <div class="text-center">
                                <div class="text-2xl font-bold text-success">18</div>
                                <div class="text-xs text-gray-500">Vus</div>
                              </div>
                              <div class="text-center">
                                <div class="text-2xl font-bold text-warning">6</div>
                                <div class="text-xs text-gray-500">Restants</div>
                              </div>
                              <div class="text-center">
                                <div class="text-2xl font-bold text-danger">2</div>
                                <div class="text-xs text-gray-500">Urgents</div>
                              </div>
                            </div>
                          </div>
                        </template>

                        <!-- Action Button Block (Cockpit) -->
                        <template x-if="block && block.type === 'action-button'">
                          <div class="panel h-full flex items-center justify-center" :style="block.props?.height ? `min-height: ${block.props.height}px` : ''">
                            <button 
                              :class="[
                                'btn flex items-center gap-2 transition-all',
                                block.variant === 'outline' ? `btn-outline-${block.color || 'primary'}` : `btn-${block.color || 'primary'}`,
                                block.size === 'lg' ? 'btn-lg text-base px-8 py-3' : block.size === 'sm' ? 'btn-sm text-xs px-3 py-1' : 'px-5 py-2'
                              ]"
                              @click.stop="">
                              <iconify-icon 
                                x-show="block.icon" 
                                :icon="block.icon || 'solar:play-bold'" 
                                :width="block.size === 'lg' ? '20' : block.size === 'sm' ? '14' : '16'">
                              </iconify-icon>
                              <span x-text="block.label || 'Action'"></span>
                            </button>
                          </div>
                        </template>

                        <!-- Unknown Block Type -->
                        <template x-if="block && !['panel', 'text', 'kpi-card', 'statistics', 'expense-tracker', 'progress-list', 'work-queue', 'comms-dock', 'activity-feed', 'focus-card', 'urgency-radar', 'kpi-cards', 'action-button'].includes(block.type)">
                          <div class="panel">
                            <span x-text="'Unknown block type: ' + block.type"></span>
                          </div>
                        </template>

                      </div>
                    </div>
                  </template>
                </div>

                <!-- Drop Placeholder with Add/Delete Buttons (Absolutely positioned when empty) -->
                <div 
                  x-show="builderState.mode === 'edit' && column.blocks.length === 0"
                  class="absolute inset-0 flex items-center justify-center gap-2">
                  <!-- Add Block Button -->
                  <button 
                    @click="openDrawer('blocks')"
                    class="w-10 h-10 rounded-full bg-primary/10 hover:bg-primary/20 transition-all flex items-center justify-center">
                    <iconify-icon icon="solar:add-circle-bold" width="20" class="text-primary"></iconify-icon>
                  </button>
                  <!-- Delete Column/Row Button -->
                  <button 
                    @click.stop="row.columns.length > 1 ? deleteColumn(row.id, colIndex) : deleteRow(row.id)"
                    class="w-8 h-8 rounded-full bg-danger/10 hover:bg-danger/20 transition-all flex items-center justify-center"
                    :title="row.columns.length > 1 ? 'Supprimer cette colonne' : 'Supprimer la ligne'">
                    <iconify-icon icon="solar:trash-bin-trash-bold" width="16" class="text-danger"></iconify-icon>
                  </button>
                </div>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>

    <!-- Add Row Button (bottom of canvas, visible in edit mode) -->
    <div 
      x-show="builderState.mode === 'edit' && pageConfig.layout[builderState.activeTab] && pageConfig.layout[builderState.activeTab].length > 0"
      class="mt-6 flex justify-center">
      <button 
        @click="addRow()" 
        class="flex items-center gap-2 px-4 py-2 text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary border-2 border-dashed border-gray-300 dark:border-gray-600 hover:border-primary dark:hover:border-primary rounded-lg transition-all">
        <iconify-icon icon="solar:add-circle-linear" width="18"></iconify-icon>
        <span>Add Row</span>
      </button>
    </div>

  </div>
</div>
