<!DOCTYPE html>
<html lang="en" dir="ltr">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <title>Choose Account | Cyberbox</title>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/x-icon" href="/favicon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link rel="stylesheet" type="text/css" media="screen" href="/assets/css/perfect-scrollbar.min.css" />
        <link rel="stylesheet" type="text/css" media="screen" href="/assets/css/style.css" />
        <link defer rel="stylesheet" type="text/css" media="screen" href="/assets/css/animate.css" />
        <script src="/assets/js/perfect-scrollbar.min.js"></script>
        <script defer src="/assets/js/popper.min.js"></script>
        <script defer src="/assets/js/tippy-bundle.umd.min.js"></script>
        <script defer src="/assets/js/sweetalert.min.js"></script>
    </head>

    <body
        x-data="main"
        class="relative overflow-x-hidden font-nunito text-sm font-normal antialiased"
        :class="[ $store.app.sidebar ? 'toggle-sidebar' : '', $store.app.theme, $store.app.menu, $store.app.layout,$store.app.rtlClass]"
    >
        <!-- screen loader -->
        <div class="screen_loader animate__animated fixed inset-0 z-[60] grid place-content-center bg-[#fafafa] dark:bg-[#060818]">
            <svg width="64" height="64" viewBox="0 0 135 135" xmlns="http://www.w3.org/2000/svg" fill="#4361ee">
                <path
                    d="M67.447 58c5.523 0 10-4.477 10-10s-4.477-10-10-10-10 4.477-10 10 4.477 10 10 10zm9.448 9.447c0 5.523 4.477 10 10 10 5.522 0 10-4.477 10-10s-4.478-10-10-10c-5.523 0-10 4.477-10 10zm-9.448 9.448c-5.523 0-10 4.477-10 10 0 5.522 4.477 10 10 10s10-4.478 10-10c0-5.523-4.477-10-10-10zM58 67.447c0-5.523-4.477-10-10-10s-10 4.477-10 10 4.477 10 10 10 10-4.477 10-10z"
                >
                    <animateTransform attributeName="transform" type="rotate" from="0 67 67" to="-360 67 67" dur="2.5s" repeatCount="indefinite" />
                </path>
                <path
                    d="M28.19 40.31c6.627 0 12-5.374 12-12 0-6.628-5.373-12-12-12-6.628 0-12 5.372-12 12 0 6.626 5.372 12 12 12zm30.72-19.825c4.686 4.687 12.284 4.687 16.97 0 4.686-4.686 4.686-12.284 0-16.97-4.686-4.687-12.284-4.687-16.97 0-4.687 4.686-4.687 12.284 0 16.97zm35.74 7.705c0 6.627 5.37 12 12 12 6.626 0 12-5.373 12-12 0-6.628-5.374-12-12-12-6.63 0-12 5.372-12 12zm19.822 30.72c-4.686 4.686-4.686 12.284 0 16.97 4.687 4.686 12.285 4.686 16.97 0 4.687-4.686 4.687-12.284 0-16.97-4.685-4.687-12.283-4.687-16.97 0zm-7.704 35.74c-6.627 0-12 5.37-12 12 0 6.626 5.373 12 12 12s12-5.374 12-12c0-6.63-5.373-12-12-12zm-30.72 19.822c-4.686-4.686-12.284-4.686-16.97 0-4.686 4.687-4.686 12.285 0 16.97 4.686 4.687 12.284 4.687 16.97 0 4.687-4.685 4.687-12.283 0-16.97zm-35.74-7.704c0-6.627-5.372-12-12-12-6.626 0-12 5.373-12 12s5.374 12 12 12c6.628 0 12-5.373 12-12zm-19.823-30.72c4.687-4.686 4.687-12.284 0-16.97-4.686-4.686-12.284-4.686-16.97 0-4.687 4.686-4.687 12.284 0 16.97 4.686 4.687 12.284 4.687 16.97 0z"
                >
                    <animateTransform attributeName="transform" type="rotate" from="0 67 67" to="360 67 67" dur="8s" repeatCount="indefinite" />
                </path>
            </svg>
        </div>

        <div class="main-container min-h-screen text-black dark:text-white-dark">
            <!-- start main content section -->
            <div class="flex min-h-screen items-center justify-center bg-[url('../images/map.svg')] bg-cover bg-center dark:bg-[url('../images/map-dark.svg')]">
                <div class="panel m-6 w-full max-w-lg sm:w-[480px]">
                    <h2 class="mb-3 text-2xl font-bold text-center">Your Accounts</h2>
                    <p class="mb-7 text-center">Select an account to continue</p>
                    
                    <div class="grid gap-4">
                        <% if (locals.accounts && accounts.length > 0) { %>
                            <% for (let i = 0; i < accounts.length; i++) { %>
                                <a href="/account/<%= accounts[i].account_number %>/home" 
                                   class="flex items-center p-4 border rounded-xl border-white-light dark:border-[#1b2e4b] hover:border-primary hover:shadow-lg dark:hover:border-primary bg-white dark:bg-[#1b2e4b] transition-all group">
                                    <div class="bg-primary/10 text-primary rounded-full p-3 mr-4 group-hover:bg-primary group-hover:text-white transition-colors">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M22 22L2 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                            <path d="M21 22V13C21 8.82441 21 6.73662 19.8252 5.37526C19.3449 4.81861 18.7303 4.3642 18.0312 4.04905C16.321 3.27815 14.1539 3.91008 9.81977 5.17422C7.30606 5.9074 6.04921 6.27399 5.21639 7.15573C4.87593 7.51614 4.59473 7.92558 4.38573 8.36531C3.87455 9.44093 3.96349 10.7483 4.14138 13.363L4.72917 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                            <path d="M15 22V18C15 16.5858 15 15.8787 14.5607 15.4393C14.1213 15 13.4142 15 12 15C10.5858 15 9.87868 15 9.43934 15.4393C9 15.8787 9 16.5858 9 18V22" stroke="currentColor" stroke-width="1.5"/>
                                            <path d="M13 9H13.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                            <path d="M16 9H16.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                            <path d="M10 9H10.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                            <path d="M13 12H13.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                            <path d="M16 12H16.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                            <path d="M10 12H10.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-lg text-black dark:text-white-light group-hover:text-primary transition-colors"><%= accounts[i].name %></h4>
                                        <p class="text-xs text-gray-500 font-mono">#<%= accounts[i].account_number %></p>
                                    </div>
                                    <div class="ml-auto text-gray-400 group-hover:text-primary transition-colors">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M9 5L15 12L9 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </div>
                                </a>
                            <% } %>
                        <% } else { %>
                            <div class="text-center py-8 text-gray-500">
                                <p>No accounts found.</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Create New Account Button -->
                    <div class="mt-4">
                        <button @click="$refs.createModal.showModal()" 
                                class="flex items-center w-full p-4 border-2 border-dashed rounded-xl border-white-light dark:border-[#1b2e4b] hover:border-primary hover:bg-primary/5 dark:hover:border-primary transition-all group">
                            <div class="bg-success/10 text-success rounded-full p-3 mr-4 group-hover:bg-success group-hover:text-white transition-colors">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-bold text-lg text-black dark:text-white-light group-hover:text-primary transition-colors">Create New Account</h4>
                                <p class="text-xs text-gray-500">Add a new workspace</p>
                            </div>
                        </button>
                    </div>

                    <div class="mt-8 text-center bg-gray-50 dark:bg-[#0e1726]/50 p-4 rounded-xl">
                        <p class="text-sm text-gray-500 mb-2">Want to switch user?</p>
                        <a href="/auth/logout" class="btn btn-outline-danger btn-sm w-full">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mr-2">
                                <path d="M15 12L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M11 8L15 12L11 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M15 4V4.75C15 4.9085 15.0116 5.068 15.0351 5.228C15.0506 5.33405 15.0746 5.48008 15.1102 5.67069C15.2241 6.28189 15.4673 7.02534 15.9392 7.73707C16.9145 9.20811 18.8872 9.99999 22 10V14C18.8872 14 16.9145 14.7919 15.9392 16.2629C15.4673 16.9747 15.2241 17.7181 15.1102 18.3293C15.0746 18.5199 15.0506 18.666 15.0351 18.772C15.0116 18.932 15 19.0915 15 19.25V20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            Log Out
                        </a>
                    </div>
                </div>

                <!-- Create Account Modal -->
                <dialog x-ref="createModal" class="modal rounded-xl bg-white dark:bg-[#0e1726] p-0 backdrop:bg-black/50 max-w-md w-full">
                    <form method="POST" action="/user/accounts/create" class="p-6">
                        <h3 class="text-xl font-bold mb-4 dark:text-white-light">Create New Account</h3>
                        
                        <div class="mb-4">
                            <label for="accountName" class="block text-sm font-semibold mb-2 dark:text-white-light">Account Name *</label>
                            <input type="text" 
                                   id="accountName" 
                                   name="name" 
                                   required
                                   placeholder="My New Workspace"
                                   class="form-input w-full" />
                        </div>

                        <div class="mb-6">
                            <label for="accountIcon" class="block text-sm font-semibold mb-2 dark:text-white-light">Icon (optional)</label>
                            <input type="text" 
                                   id="accountIcon" 
                                   name="icon" 
                                   placeholder="solar:settings-bold-duotone"
                                   class="form-input w-full" />
                            <p class="text-xs text-gray-500 mt-1">Default: solar:settings-bold-duotone</p>
                        </div>

                        <div class="flex gap-3">
                            <button type="button" 
                                    @click="$refs.createModal.close()"
                                    class="btn btn-outline-dark flex-1">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-primary flex-1">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mr-2">
                                    <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                Create Account
                            </button>
                        </div>
                    </form>
                </dialog>
            </div>
            <!-- end main content section -->
        </div>

        <script src="/assets/js/alpine-collaspe.min.js"></script>
        <script src="/assets/js/alpine-persist.min.js"></script>
        <script defer src="/assets/js/alpine-ui.min.js"></script>
        <script defer src="/assets/js/alpine-focus.min.js"></script>
        <script defer src="/assets/js/alpine.min.js"></script>
        <script src="/assets/js/custom.js"></script>
    </body>
</html>
