<div class="home-overview-shell"
     x-data="homeOverviewHub()"
     :class="layoutMode ? 'ov-dm' : ''"
     @click.window="closeHomeTaskMenu(); closeTodayWidgetCalendar()"
     @keydown.escape.window="closeHomeTaskMenu(); closeTodayWidgetCalendar(); cancelEditHomeTask()">
    <div class="home-ov-header">
        <div class="home-ov-title">
            <div>
                <h1>Bonjour, <%= typeof user !== 'undefined' && user && user.name ? user.name.split(' ')[0] : 'Riad' %> 👋</h1>
                <p>Voici ce qui se passe aujourd'hui</p>
            </div>
        </div>
        <div class="home-ov-actions">
            <button type="button" class="home-ov-btn" :class="layoutMode ? 'active' : ''" @click="toggleLayoutMode()">
                <iconify-icon icon="solar:pen-new-square-bold-duotone"></iconify-icon>
                <span x-text="layoutMode ? 'Terminer' : 'Personnaliser'"></span>
            </button>
            <button type="button" class="home-ov-btn" title="Options">
                <iconify-icon icon="tabler:dots" width="16"></iconify-icon>
            </button>
        </div>
    </div>

    <div class="ov-dm-banner">
        <iconify-icon icon="tabler:layout-dashboard" width="16"></iconify-icon>
        <span>Mode configuration — réorganisez les widgets et ajoutez de nouveaux blocs</span>
        <button type="button" @click="toggleLayoutMode(false)" style="margin-left:auto;padding:4px 12px;border-radius:6px;border:1px solid rgba(67,97,238,.2);background:#fff;color:#4361ee;font-size:11px;font-weight:500;cursor:pointer;">Terminer</button>
    </div>

    <div x-show="loadingData" class="home-loading">
        <iconify-icon icon="solar:refresh-circle-bold-duotone" style="animation:spin 1.2s linear infinite;"></iconify-icon>
        Chargement de l'overview…
    </div>

    <div x-ref="ovRowContainer" x-show="!loadingData">
        <template x-for="row in rows" :key="row.id">
            <div class="ov-layout-row" :data-row-id="row.id">
                <div class="ov-row-drag" title="Déplacer la ligne">⠿</div>
                <button type="button" class="ov-row-remove" @click="removeRow(row.id)" title="Supprimer la ligne">✕</button>
                <template x-for="(col, ci) in row.columns" :key="col.id">
                    <div class="ov-layout-col"
                         :class="{ 'ov-layout-col-nested-only': isNestedOnlyColumn(col) }"
                         :style="'width:' + (col.width/12*100) + '%;position:relative;'">
                        <div class="ov-col-toolbar">
                            <button type="button" @click="splitColumn(row.id, col.id)" title="Diviser" x-show="col.width >= 4">⫽</button>
                            <button type="button" @click="removeColumn(row.id, col.id)" title="Supprimer" x-show="row.columns.length > 1" style="color:#ef4444;">✕</button>
                        </div>
                        <template x-if="ci < row.columns.length - 1">
                            <div class="ov-resize-handle" @pointerdown.stop.prevent="_onResizeStart($event, row.id, ci)"></div>
                        </template>

                        <template x-if="!isNestedOnlyColumn(col)">
                            <div class="ov-col-widgets" :data-col-id="col.id">
                                <template x-for="(wid, wi) in (col.widgetIds || [])" :key="wid + ':' + wi">
                                    <div class="ov-widget-wrap" :data-widget-id="wid">
                                        <div class="ov-widget-drag" title="Déplacer">⠿</div>
                                        <button type="button" class="ov-widget-config" @click.stop="openWidgetSettings(wid)" title="Configurer"><iconify-icon icon="solar:settings-linear" width="13"></iconify-icon></button>
                                        <button type="button" class="ov-widget-remove" @click="removeWidget(wid, col.id, wi)" title="Retirer">✕</button>
                                        <%- include('partials/widget-card') %>
                                    </div>
                                </template>
                            </div>
                        </template>

                        <div class="ov-nested-rows" :data-nested-parent-id="col.id" x-show="(col.childRows || []).length">
	                            <template x-for="childRow in (col.childRows || [])" :key="childRow.id">
	                                <div class="ov-layout-row ov-layout-row-nested" :data-row-id="childRow.id" :data-parent-col-id="col.id">
	                                    <div class="ov-nested-row-drag" title="Déplacer la sous-ligne">⠿</div>
	                                    <div class="ov-nested-row-move" aria-label="Réorganiser la sous-ligne">
	                                        <button type="button" @click.stop="moveNestedRow(col.id, childRow.id, -1)" :disabled="(col.childRows || [])[0]?.id === childRow.id" title="Monter">
	                                            <iconify-icon icon="tabler:chevron-up" width="13"></iconify-icon>
	                                        </button>
	                                        <button type="button" @click.stop="moveNestedRow(col.id, childRow.id, 1)" :disabled="(col.childRows || [])[(col.childRows || []).length - 1]?.id === childRow.id" title="Descendre">
	                                            <iconify-icon icon="tabler:chevron-down" width="13"></iconify-icon>
	                                        </button>
	                                    </div>
	                                    <button type="button" class="ov-nested-row-remove" @click="removeNestedRow(col.id, childRow.id)" title="Supprimer la sous-ligne">✕</button>
	                                    <template x-for="(childCol, childCi) in childRow.columns" :key="childCol.id">
                                        <div class="ov-layout-col" :style="'width:' + (childCol.width/12*100) + '%;position:relative;'">
                                            <div class="ov-col-toolbar">
                                                <button type="button" @click="splitColumn(childRow.id, childCol.id)" title="Diviser" x-show="childCol.width >= 4">⫽</button>
                                                <button type="button" @click="removeColumn(childRow.id, childCol.id)" title="Supprimer" x-show="childRow.columns.length > 1" style="color:#ef4444;">✕</button>
                                            </div>
                                            <template x-if="childCi < childRow.columns.length - 1">
                                                <div class="ov-resize-handle" @pointerdown.stop.prevent="_onResizeStart($event, childRow.id, childCi)"></div>
                                            </template>
                                            <div class="ov-col-widgets" :data-col-id="childCol.id">
                                                <template x-for="(wid, wi) in (childCol.widgetIds || [])" :key="wid + ':' + wi">
                                                    <div class="ov-widget-wrap" :data-widget-id="wid">
                                                        <div class="ov-widget-drag" title="Déplacer">⠿</div>
                                                        <button type="button" class="ov-widget-config" @click.stop="openWidgetSettings(wid)" title="Configurer"><iconify-icon icon="solar:settings-linear" width="13"></iconify-icon></button>
                                                        <button type="button" class="ov-widget-remove" @click="removeWidget(wid, childCol.id, wi)" title="Retirer">✕</button>
                                                        <%- include('partials/widget-card') %>
                                                    </div>
                                                </template>
                                                <div class="ov-nested-add-widget" @click="openWidgetPicker(childCol.id)">
                                                    <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                                                    <span>Widget</span>
                                                </div>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            </template>
                        </div>

                        <div class="ov-add-choice">
                            <div class="ov-add-widget-btn" @click="openWidgetPicker(col.id)">
                                <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                                <span>Widget</span>
                            </div>
                            <div class="ov-add-nested-row-btn" @click="addNestedRow(col.id)">
                                <iconify-icon icon="tabler:layout-rows" width="14"></iconify-icon>
                                <span>Ligne</span>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </template>
    </div>

    <div class="ov-add-row-btn" @click="addRow()">
        <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
        <span>Ajouter une ligne</span>
    </div>

    <div class="dx-task-ctx"
         x-show="homeTaskMenu"
         x-cloak
         :style="homeTaskMenu ? 'left:' + homeTaskMenu.x + 'px;top:' + homeTaskMenu.y + 'px' : ''"
         @click.stop>
        <button type="button" x-show="!homeTaskMenu?.priorityOnly" @click="editHomeTaskFromMenu()">
            <iconify-icon icon="solar:pen-2-linear" width="14"></iconify-icon>
            Modifier
        </button>
        <button type="button" class="dx-task-ctx-toggle" x-show="!homeTaskMenu?.priorityOnly" @click="toggleDayPriorityFromMenu()">
            <span class="dx-task-ctx-toggle-main">
                <iconify-icon icon="solar:bolt-bold-duotone" width="14"></iconify-icon>
                <span>À faire aujourd’hui</span>
            </span>
            <span class="dx-task-switch" :class="{ 'is-on': isTaskDayPriority(homeTaskMenu?.taskId) }"></span>
        </button>
        <div class="dx-task-ctx-label">Priorité</div>
        <div class="dx-task-ctx-priorities">
	            <template x-for="priority in homeTaskPriorityMenuOptions()" :key="priority.label">
	                <button type="button"
	                        :style="'--priority-color:' + priority.color"
	                        @click="setHomeTaskPriorityFromMenu(priority)">
                    <iconify-icon icon="solar:flag-linear" width="11"></iconify-icon>
                    <span x-text="priority.label"></span>
                </button>
            </template>
        </div>
        <button type="button" class="danger" x-show="!homeTaskMenu?.priorityOnly" @click="deleteHomeTaskFromMenu()">
            <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="14"></iconify-icon>
            Supprimer
        </button>
    </div>
</div>

<script>
document.addEventListener('alpine:init', () => {
