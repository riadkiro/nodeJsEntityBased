    </style>

    <script>
    document.addEventListener('alpine:init', () => {
        const _baseUrl = window.location.pathname.replace(/\/overview$/, '');
        const _recUrl = '/account/<%= account_number %>/record/<%= entity.slug %>/<%= record._id %>';
        const _recordNotesApi = '/account/<%= account_number %>/api/record/<%= record._id %>/notes';
        const _overviewRecordModuleCanEdit = <%= _canEditCurrentModule ? 'true' : 'false' %>;

        Alpine.data('ovNotesWidget', () => ({
            loading: true,
            saving: false,
            pickerOpen: false,
            notes: [],
            selectedNoteId: '',
            selectedNote: null,
            _prefViewId: 'overview_note_widget_<%= record._id %>',
            _storageKey: 'overview_note_widget_<%= account_number %>_<%= record._id %>',

            async init() {
                await Promise.all([this.loadNotes(), this.loadPreference()]);
                this.applySelection();
            },

            get selectedPreview() {
                if (!this.selectedNote) return '';
                if (this.selectedNote.isProtected && this.selectedNote.contentLocked) {
                    return 'Note sécurisée. Ouvrez-la pour saisir le PIN et consulter le contenu.';
                }
                return this.toPlainText(this.selectedNote.content).slice(0, 220) || 'Note vide';
            },

            get openUrl() {
                const suffix = this.selectedNoteId ? ('?noteId=' + encodeURIComponent(this.selectedNoteId)) : '';
                return `${_recUrl}/notes${suffix}`;
            },

            async loadNotes() {
                this.loading = true;
                try {
                    const res = await fetch(_recordNotesApi, { credentials: 'include' });
                    const data = await res.json();
                    this.notes = data.success ? (data.notes || []) : [];
                } catch (e) {
                    console.error('[OverviewNotes] Load error:', e);
                    this.notes = [];
                } finally {
                    this.loading = false;
                }
            },

            async loadPreference() {
                try {
                    this.selectedNoteId = window.localStorage.getItem(this._storageKey) || '';
                    const res = await fetch(`/account/<%= account_number %>/api/user/view-preferences/${this._prefViewId}`, { credentials: 'include' });
                    const data = await res.json();
                    const prefNoteId = data.success && data.preferences?.noteWidget?.selectedNoteId;
                    if (prefNoteId) this.selectedNoteId = String(prefNoteId);
                } catch (e) {
                    console.warn('[OverviewNotes] Preference load skipped:', e);
                }
            },

            applySelection() {
                const selected = this.notes.find(n => String(n._id) === String(this.selectedNoteId));
                this.selectedNote = selected || this.notes[0] || null;
                this.selectedNoteId = this.selectedNote ? String(this.selectedNote._id) : '';
            },

            selectNote(note) {
                if (!note || !note._id) return;
                this.selectedNote = note;
                this.selectedNoteId = String(note._id);
                this.pickerOpen = false;
                this.savePreference();
            },

            async savePreference() {
                try {
                    window.localStorage.setItem(this._storageKey, this.selectedNoteId || '');
                    await fetch(`/account/<%= account_number %>/api/user/view-preferences`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({
                            viewId: this._prefViewId,
                            preferences: { noteWidget: { selectedNoteId: this.selectedNoteId } }
                        })
                    });
                } catch (e) {
                    console.warn('[OverviewNotes] Preference save skipped:', e);
                }
            },

            notePreview(note) {
                if (!note) return '';
                if (note.isProtected && note.contentLocked) return 'Note sécurisée';
                return this.toPlainText(note.content).slice(0, 90) || 'Note vide';
            },

            toPlainText(html) {
                const raw = String(html || '');
                if (!raw) return '';
                if (!/[<&]/.test(raw)) {
                    return raw
                        .replace(/\r\n?/g, '\n')
                        .replace(/[ \t]+\n/g, '\n')
                        .replace(/\n[ \t]+/g, '\n')
                        .replace(/\n{3,}/g, '\n\n')
                        .trim();
                }

                const box = document.createElement('div');
                box.innerHTML = raw;
                const blockTags = new Set(['address', 'article', 'aside', 'blockquote', 'div', 'dl', 'fieldset', 'figcaption', 'figure', 'footer', 'form', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'header', 'hr', 'li', 'main', 'nav', 'ol', 'p', 'pre', 'section', 'table', 'tr', 'ul']);
                const parts = [];
                const pushBreak = () => {
                    if (!parts.length) return;
                    const last = String(parts[parts.length - 1] || '');
                    if (!last.endsWith('\n')) parts.push('\n');
                };
                const walk = node => {
                    if (node.nodeType === Node.TEXT_NODE) {
                        parts.push(node.nodeValue || '');
                        return;
                    }
                    if (node.nodeType !== Node.ELEMENT_NODE) return;
                    const tag = node.tagName.toLowerCase();
                    if (tag === 'br' || tag === 'hr') {
                        pushBreak();
                        return;
                    }
                    const isBlock = blockTags.has(tag);
                    if (isBlock) pushBreak();
                    if (tag === 'li') parts.push('• ');
                    node.childNodes.forEach(walk);
                    if (isBlock) pushBreak();
                };
                box.childNodes.forEach(walk);
                return parts.join('')
                    .replace(/\u00a0/g, ' ')
                    .replace(/[ \t]+\n/g, '\n')
                    .replace(/\n[ \t]+/g, '\n')
                    .replace(/[ \t]{2,}/g, ' ')
                    .replace(/\n{3,}/g, '\n\n')
                    .trim();
            },

            formatDate(value) {
                if (!value) return '';
                try {
                    return new Date(value).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
                } catch (_) {
                    return '';
                }
            }
        }));

        Alpine.data('ovInlineEdit', () => ({
            editingKey: '',
            saving: false,
            startEdit(key, e) {
                if (!_overviewRecordModuleCanEdit) return;
                if (this.editingKey === key) return;
                // If another field was being edited, auto-save it first
                if (this.editingKey) this._doSave(this.editingKey);
                this.editingKey = key;
                this.$nextTick(() => {
                    const ref = this.$refs['input_' + key];
                    if (ref) ref.focus();
                });
            },
            cancelEdit() { this.editingKey = ''; },
            // Called by @click.outside on each ov-ef
            autoSave(key) {
                if (this.editingKey !== key) return;
                this._doSave(key);
            },
            saveCurrentField() {
                if (!this.editingKey) return;
                this._doSave(this.editingKey);
            },
            _doSave(key) {
                const ref = this.$refs['input_' + key];
                if (!ref) { this.editingKey = ''; return; }
                // For multiselect pills, get the selected array from the inner x-data
                if (ref.hasAttribute && ref.hasAttribute('x-data') && ref._x_dataStack) {
                    const inner = ref._x_dataStack[0];
                    if (inner && inner.selected) {
                        this.saveField(key, inner.selected);
                        return;
                    }
                }
                this.saveField(key, ref.type === 'checkbox' ? ref.checked : ref.value);
            },
            async saveField(key, value) {
                if (!_overviewRecordModuleCanEdit) return;
                if (this.saving) return;
                this.saving = true;
                const editingK = key;
                try {
                    const res = await fetch(_recUrl + '/update-field', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ fieldKey: key, value })
                    });
                    if (res.ok) {
                        // Update DOM in place
                        const fieldEl = document.querySelector('.ov-ef[data-key="' + editingK + '"]');
                        if (fieldEl) {
                            const viewEl = fieldEl.querySelector('.ov-ef-view');
                            if (viewEl) {
                                const isBool = typeof value === 'boolean';
                                const displayVal = Array.isArray(value) ? value.join(', ') : (isBool ? (value ? 'Oui' : 'Non') : (value || ''));
                                if (isBool) {
                                    viewEl.innerHTML = '<span class="ov-bool-pill ' + (value ? 'ov-bool-pill--on' : 'ov-bool-pill--off') + '"><span class="ov-bool-dot" style="background:' + (value ? '#10b981' : '#cbd5e1') + '"></span>' + displayVal + '</span>';
                                } else if (displayVal) {
                                    viewEl.innerHTML = '<span class="ov-ef-val">' + String(displayVal).replace(/</g,'&lt;') + '</span>';
                                } else {
                                    viewEl.innerHTML = '<span class="ov-placeholder">' + (fieldEl.querySelector('.ov-ef-label')?.textContent || 'Valeur') + '</span>';
                                }
                                if (editingK === 'title') {
                                    const heroTitle = document.getElementById('record-hero-title');
                                    if (heroTitle) heroTitle.textContent = displayVal || 'Sans titre';
                                }
                            }
                        }
                        this.editingKey = '';
                    }
                } catch (e) { console.error('[OV save]', e); }
                this.saving = false;
            }
        }));

        // Relation editor sub-component
        Alpine.data('ovRelEditor', (cfg) => ({
            key: cfg.key,
            targetEntityId: cfg.targetEntityId,
            targetEntitySlug: cfg.targetEntitySlug || '',
            isMulti: cfg.isMulti,
            color: cfg.color || '#4361ee',
            tags: [...(cfg.initial || [])],
            searchQ: '',
            results: [],
            showDropdown: false,
            dirty: false,
            _ready: false,
            init() {
                this.$nextTick(() => {
                    const inp = this.$refs.relSearchInput;
                    if (inp) inp.focus();
                    this.search();
                    // Delay _ready to survive the full mousedown→mouseup→click cycle
                    setTimeout(() => { this._ready = true; }, 300);
                });
            },
            async search() {
                if (!this.targetEntityId) return;
                const q = this.searchQ.trim();
                try {
                    let url = '/account/<%= account_number %>/record/api/search?entityId=' + this.targetEntityId + '&limit=5';
                    if (q) url += '&q=' + encodeURIComponent(q);
                    const res = await fetch(url, { credentials: 'include' });
                    const data = await res.json();
                    // Exclude already-selected tags
                    const tagIds = this.tags.map(t => String(t._id));
                    this.results = (data.data || []).filter(r => !tagIds.includes(String(r.id))).map(r => ({
                        _id: r.id,
                        title: r.label || 'Sans titre'
                    }));
                    this.showDropdown = true;
                } catch (e) { console.error('[RelSearch]', e); }
            },
            async addTag(record) {
                if (!this.isMulti) this.tags = [];
                this.tags.push({ _id: record._id, title: record.title });
                this.searchQ = '';
                this.results = [];
                this.showDropdown = false;
                this.dirty = true;
                // Persist immediately - use 'set' for single-value, 'add' for multi
                if (this.isMulti) {
                    await this._persist('add', record._id);
                } else {
                    await this._persistSet([record._id]);
                    this.closeAndSave();
                }
            },
            async removeTag(id) {
                this.tags = this.tags.filter(t => t._id !== id);
                this.dirty = true;
                await this._persist('remove', id);
            },
            async _persist(action, targetId) {
                try {
                    await fetch(_recUrl + '/update-relation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ relationKey: this.key, action, targetId })
                    });
                } catch (e) { console.error('[RelPersist]', e); }
            },
            async _persistSet(ids) {
                try {
                    await fetch(_recUrl + '/update-relation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ relationKey: this.key, action: 'set', targetIds: ids })
                    });
                } catch (e) { console.error('[RelPersist]', e); }
            },
            async createNew() {
                const title = this.searchQ.trim();
                if (!title || !this.targetEntityId) return;
                try {
                    const res = await fetch('/account/<%= account_number %>/record/api/quick-create', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ entityId: this.targetEntityId, title })
                    });
                    const data = await res.json();
                    if (data.success && data.record) {
                        // Add the newly created record as a tag
                        await this.addTag({ _id: data.record._id, title: data.record.title });
                    }
                } catch (e) { console.error('[QuickCreate]', e); }
            },
            closeAndSave() {
                if (!this._ready) return;
                this.results = [];
                this.searchQ = '';
                this.showDropdown = false;
                // Update the view-state DOM
                const parent = this.$el.closest('.ov-ef');
                if (parent) {
                    const viewEl = parent.querySelector('.ov-ef-view');
                    if (viewEl) {
                        if (this.tags.length > 0) {
                            viewEl.innerHTML = '<div class="ov-tags">' + this.tags.map(t =>
                                '<span class="ov-tag" style="background:' + this.color + '10;border-color:' + this.color + '30;color:' + this.color + '">' + t.title.replace(/</g,'&lt;') + '</span>'
                            ).join('') + '</div>';
                        } else {
                            viewEl.innerHTML = '<span class="ov-placeholder">Sélectionner...</span>';
                        }
                    }
                }
                // Close by setting parent editingKey
                const grid = this.$el.closest('[x-data]');
                if (grid && grid._x_dataStack) {
                    const root = grid._x_dataStack.find(d => d.editingKey !== undefined);
                    if (root) root.editingKey = '';
                }
            }
        }));

