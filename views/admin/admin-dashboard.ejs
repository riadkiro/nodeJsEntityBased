<!-- Admin Dashboard -->
<div class="min-h-screen">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                <iconify-icon icon="solar:shield-star-bold-duotone" width="22" class="text-primary"></iconify-icon>
            </div>
            <div>
                <h1 class="text-2xl font-bold dark:text-white">Administration</h1>
                <p class="text-sm text-gray-500">Gérez votre plateforme SaaS</p>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">
        <!-- Total Users -->
        <div class="panel">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-3xl font-bold text-primary"><%= stats.totalUsers %></div>
                    <div class="text-sm text-gray-500 mt-1">Utilisateurs total</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
                    <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="28" class="text-primary"></iconify-icon>
                </div>
            </div>
            <div class="mt-3 flex items-center gap-1">
                <iconify-icon icon="solar:arrow-up-bold" width="14" class="text-success"></iconify-icon>
                <span class="text-xs text-success font-semibold"><%= stats.activeUsers %> actifs</span>
            </div>
        </div>

        <!-- Active Accounts -->
        <div class="panel">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-3xl font-bold text-success"><%= stats.totalAccounts %></div>
                    <div class="text-sm text-gray-500 mt-1">Comptes / Workspaces</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-success/10 flex items-center justify-center">
                    <iconify-icon icon="solar:buildings-2-bold-duotone" width="28" class="text-success"></iconify-icon>
                </div>
            </div>
        </div>

        <!-- Suspended -->
        <div class="panel">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-3xl font-bold text-danger"><%= stats.suspendedUsers %></div>
                    <div class="text-sm text-gray-500 mt-1">Comptes suspendus</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-danger/10 flex items-center justify-center">
                    <iconify-icon icon="solar:shield-warning-bold-duotone" width="28" class="text-danger"></iconify-icon>
                </div>
            </div>
        </div>

        <!-- Plans -->
        <div class="panel">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-3xl font-bold text-warning"><%= stats.planCounts.premium || 0 %></div>
                    <div class="text-sm text-gray-500 mt-1">Abonnements Premium</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-warning/10 flex items-center justify-center">
                    <iconify-icon icon="solar:crown-bold-duotone" width="28" class="text-warning"></iconify-icon>
                </div>
            </div>
            <div class="mt-3 flex items-center gap-3 text-xs">
                <span class="text-gray-500">Free: <b><%= stats.planCounts.free || 0 %></b></span>
                <span class="text-gray-500">Basic: <b><%= stats.planCounts.basic || 0 %></b></span>
                <span class="text-gray-500">Enterprise: <b><%= stats.planCounts.enterprise || 0 %></b></span>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Recent Users -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-5">
        <!-- Quick Actions -->
        <div class="panel">
            <div class="flex items-center justify-between mb-5">
                <h3 class="font-bold text-lg dark:text-white">Actions rapides</h3>
            </div>
            <div class="grid gap-3">
                <a href="/account/<%= account_number %>/admin/users" class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 dark:border-[#1b2e4b] hover:border-primary hover:bg-primary/5 transition-all group">
                    <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
                        <iconify-icon icon="solar:users-group-rounded-bold" width="18" class="text-primary group-hover:text-white"></iconify-icon>
                    </div>
                    <div>
                        <div class="font-semibold text-sm dark:text-white">Gérer les utilisateurs</div>
                        <div class="text-xs text-gray-500">Créer, modifier, suspendre</div>
                    </div>
                </a>
                <a href="/account/<%= account_number %>/admin/accounts" class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 dark:border-[#1b2e4b] hover:border-success hover:bg-success/5 transition-all group">
                    <div class="w-9 h-9 rounded-lg bg-success/10 flex items-center justify-center group-hover:bg-success group-hover:text-white transition-colors">
                        <iconify-icon icon="solar:buildings-2-bold" width="18" class="text-success group-hover:text-white"></iconify-icon>
                    </div>
                    <div>
                        <div class="font-semibold text-sm dark:text-white">Gérer les comptes</div>
                        <div class="text-xs text-gray-500">Workspaces & organizations</div>
                    </div>
                </a>
                <button onclick="document.getElementById('createUserModal').showModal()" class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 dark:border-[#1b2e4b] hover:border-info hover:bg-info/5 transition-all group text-left w-full">
                    <div class="w-9 h-9 rounded-lg bg-info/10 flex items-center justify-center group-hover:bg-info group-hover:text-white transition-colors">
                        <iconify-icon icon="solar:user-plus-bold" width="18" class="text-info group-hover:text-white"></iconify-icon>
                    </div>
                    <div>
                        <div class="font-semibold text-sm dark:text-white">Créer un utilisateur</div>
                        <div class="text-xs text-gray-500">Ajouter manuellement</div>
                    </div>
                </button>
            </div>
        </div>

        <!-- Recent Users -->
        <div class="panel xl:col-span-2">
            <div class="flex items-center justify-between mb-5">
                <h3 class="font-bold text-lg dark:text-white">Dernières inscriptions</h3>
                <a href="/account/<%= account_number %>/admin/users" class="text-primary text-sm hover:underline">Voir tout →</a>
            </div>
            <div class="overflow-x-auto">
                <table class="table-hover">
                    <thead>
                        <tr>
                            <th>Utilisateur</th>
                            <th>Plan</th>
                            <th>Statut</th>
                            <th>Dernière connexion</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentUsers.forEach(function(u) { %>
                        <tr>
                            <td>
                                <div class="flex items-center gap-3">
                                    <% if (u.avatar) { %>
                                        <img src="<%= u.avatar %>" class="w-8 h-8 rounded-full object-cover" alt="" />
                                    <% } else { %>
                                        <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-xs">
                                            <%= u.name ? u.name.charAt(0).toUpperCase() : '?' %>
                                        </div>
                                    <% } %>
                                    <div>
                                        <div class="font-semibold text-sm dark:text-white"><%= u.name || '—' %></div>
                                        <div class="text-xs text-gray-500"><%= u.email %></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <% const planColors = { free: 'bg-gray-100 text-gray-600', basic: 'bg-blue-100 text-blue-600', premium: 'bg-amber-100 text-amber-700', enterprise: 'bg-purple-100 text-purple-600' }; %>
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase <%= planColors[u.membership?.plan] || planColors.free %>">
                                    <%= u.membership?.plan || 'free' %>
                                </span>
                            </td>
                            <td>
                                <% const statusColors = { active: 'bg-success/10 text-success', inactive: 'bg-gray-100 text-gray-500', suspended: 'bg-danger/10 text-danger', pending: 'bg-warning/10 text-warning' }; %>
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold <%= statusColors[u.status] || statusColors.active %>">
                                    <span class="w-1.5 h-1.5 rounded-full <%= u.status === 'active' ? 'bg-success' : u.status === 'suspended' ? 'bg-danger' : 'bg-gray-400' %>"></span>
                                    <%= u.status || 'active' %>
                                </span>
                            </td>
                            <td class="text-xs text-gray-500">
                                <% if (u.lastLogin) { %>
                                    <%= new Date(u.lastLogin).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                <% } else { %>
                                    Jamais
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Plan Distribution Chart-like Display -->
    <div class="panel mt-5">
        <h3 class="font-bold text-lg dark:text-white mb-4">Répartition des abonnements</h3>
        <div class="grid grid-cols-4 gap-3">
            <% const plans = [{name:'Free', key:'free', color:'bg-gray-200', text:'text-gray-700', icon:'solar:star-bold'}, {name:'Basic', key:'basic', color:'bg-blue-500', text:'text-white', icon:'solar:star-shine-bold'}, {name:'Premium', key:'premium', color:'bg-amber-500', text:'text-white', icon:'solar:crown-bold'}, {name:'Enterprise', key:'enterprise', color:'bg-purple-600', text:'text-white', icon:'solar:crown-star-bold'}]; %>
            <% plans.forEach(function(p) { %>
                <div class="relative overflow-hidden rounded-xl p-4 <%= p.color %> <%= p.text %>">
                    <div class="relative z-10">
                        <div class="text-2xl font-bold"><%= stats.planCounts[p.key] || 0 %></div>
                        <div class="text-xs font-semibold opacity-90"><%= p.name %></div>
                    </div>
                    <iconify-icon icon="<%= p.icon %>" width="48" class="absolute -bottom-1 -right-1 opacity-20"></iconify-icon>
                </div>
            <% }); %>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<dialog id="createUserModal" class="modal rounded-xl bg-white dark:bg-[#0e1726] p-0 backdrop:bg-black/50 max-w-lg w-full">
    <div class="p-6" x-data="{ loading: false }">
        <div class="flex items-center justify-between mb-5">
            <h3 class="text-xl font-bold dark:text-white-light">Créer un utilisateur</h3>
            <button onclick="this.closest('dialog').close()" class="text-gray-400 hover:text-gray-600">
                <iconify-icon icon="solar:close-circle-bold" width="24"></iconify-icon>
            </button>
        </div>
        
        <form @submit.prevent="
            loading = true;
            const fd = new FormData($el);
            fetch('/account/<%= account_number %>/admin/api/users/create', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                credentials: 'include',
                body: JSON.stringify(Object.fromEntries(fd))
            })
            .then(r => r.json())
            .then(data => {
                loading = false;
                if (data.success) { location.reload(); }
                else { alert(data.error || 'Error'); }
            })
            .catch(e => { loading = false; alert('Error'); });
        " class="space-y-4">
            <div>
                <label class="block text-sm font-semibold mb-1 dark:text-white-light">Nom complet *</label>
                <input name="name" type="text" required class="form-input" placeholder="John Doe" />
            </div>
            <div>
                <label class="block text-sm font-semibold mb-1 dark:text-white-light">Email *</label>
                <input name="email" type="email" required class="form-input" placeholder="john@example.com" />
            </div>
            <div>
                <label class="block text-sm font-semibold mb-1 dark:text-white-light">Mot de passe *</label>
                <input name="password" type="password" required class="form-input" placeholder="Minimum 6 caractères" minlength="6" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm font-semibold mb-1 dark:text-white-light">Rôle</label>
                    <select name="role" class="form-select">
                        <option value="user">Utilisateur</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1 dark:text-white-light">Plan</label>
                    <select name="plan" class="form-select">
                        <option value="free">Free</option>
                        <option value="basic">Basic</option>
                        <option value="premium">Premium</option>
                        <option value="enterprise">Enterprise</option>
                    </select>
                </div>
            </div>
            <div class="flex gap-3 pt-2">
                <button type="button" onclick="this.closest('dialog').close()" class="btn btn-outline-dark flex-1">Annuler</button>
                <button type="submit" class="btn btn-primary flex-1" :disabled="loading">
                    <template x-if="loading">
                        <iconify-icon icon="eos-icons:loading" width="18" class="mr-2"></iconify-icon>
                    </template>
                    Créer
                </button>
            </div>
        </form>
    </div>
</dialog>
