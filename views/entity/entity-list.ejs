<% const rows = entities.map((e, i) => [
  i + 1,
  e.name,
  e.slug,
  e.description || "",
  e.color || "#ffffff",
  e.icon || "",
  (e.enabledStandardFields || []).join(', '),
  e.createdAt,
  include("../components/btn-entity-actions", { id: e._id, account_number }),
]);
%>

<style>
.field-tag {
  display: inline-flex !important;
  align-items: center;
  gap: 0.25rem;
  padding: 0 0.5rem !important;  /* py-0 px-2 */
  background-color: rgba(var(--warning-rgb, 251 191 36) / 0.2);
  border: 1px solid rgba(var(--warning-rgb, 251 191 36) / 0.4);
  border-radius: 9999px;  /* rounded-full */
  font-size: 0.75rem;
  font-weight: 500;
  color: rgb(var(--warning-rgb, 251 191 36));
  user-select: all;
  cursor: default;
  vertical-align: middle;
  line-height: 1.5 !important;  /* Control line height */
  height: auto !important;  /* Allow py-0 to work */
}

.field-tag:hover {
  background-color: rgba(var(--warning-rgb, 251 191 36) / 0.3);
}

.field-tag-remove {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0.6;
  transition: opacity 0.2s;
  margin-left: 0.125rem;
}

.field-tag-remove:hover {
  opacity: 1;
  color: #ef4444;
}

/* Ensure field-tag inside contenteditable has correct padding */
[contenteditable] .field-tag {
  padding: 0 0.5rem !important;
}
</style>

<script>
  // Global function to remove field tag from contenteditable
  window.removeFieldTag = function(removeBtn) {
    const fieldTag = removeBtn.closest('.field-tag');
    if (fieldTag) {
      const editor = fieldTag.closest('[contenteditable]');
      const tokenIndex = parseInt(fieldTag.getAttribute('data-token-index'));
      
      // Remove the element from DOM
      fieldTag.remove();
      
      // Trigger input event to sync tokens
      if (editor) {
        editor.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
  };

  document.addEventListener("alpine:init", () => {
    Alpine.data("collectionsManager", () => ({
      // DataTable
      columns: [
        { name: "Select", hidden: false },
        { name: "Nom", hidden: false },
        { name: "Slug", hidden: false },
        { name: "Description", hidden: true },
        { name: "Couleur", hidden: true },
        { name: "Icône", hidden: true },
        { name: "Champs standards", hidden: true },
        { name: "Date de création", hidden: true },
        { name: "Actions", hidden: false },
      ],
      hideCols: [0],
      showCols: [1, 2, 3, 4, 5, 6, 7, 8],
      datatable1: null,

      // Modal state
      showCreateModal: false,
      showEditModal: false,
      isSubmitting: false,
      editingId: null,
      
      // Wizard state
      step: 1,
      step2Tab: 'fields',
      fieldSearch: '',
      selectedFields: [],
      systemFields: [],
      openCategories: { popular: true }, // Categories accordion state - popular open by default
      
      // Relations state
      allEntities: [],
      relations: [],
      entityFieldsCache: {},
      
      // Classifications
      allClassifications: [],
      classificationsLoaded: false,
      
      // Accordion state
      showDescSlug: false,
      accordionVisuel: false,
      accordionChamps: false,
      accordionClassifications: false,
      accordionReference: false,
      
      // New collection form
      newCollection: {
        name: '',
        slug: '',
        description: '',
        icon: '',
        color: '',
        image: '',
        active: true,
        referenceField: 'title', // For backward compatibility
        referenceTitleTokens: [{ t: 'field', id: 'title' }], // Token-based format
        standardFields: { 
          title: true, 
          description: true, 
          icon: true,
          attachments: true,
          image: true,
          slug: true,
          date: true
        },
        statusClassificationId: '',
        classifications: []
      },
      
      // UI state
      showDescSlug: false,
      
      // Computed: filtered categories based on search
      get filteredCategories() {
        if (!this.fieldSearch) return this.systemFields;
        const search = this.fieldSearch.toLowerCase();
        return this.systemFields.map(cat => ({
          ...cat,
          fields: cat.fields.filter(f => 
            f.label.toLowerCase().includes(search) || 
            f.name.toLowerCase().includes(search) ||
            (f.description && f.description.toLowerCase().includes(search))
          )
        })).filter(cat => cat.fields.length > 0);
      },
      
      // Helper methods
      isFieldSelected(fieldId) {
        return this.selectedFields.some(f => f._id === fieldId);
      },
      
      toggleField(field) {
        const idx = this.selectedFields.findIndex(f => f._id === field._id);
        if (idx >= 0) {
          this.selectedFields.splice(idx, 1);
        } else {
          this.selectedFields.push(field);
        }
      },
      
      getCategoryIcon(key) {
        const icons = {
          popular: 'solar:star-bold-duotone',
          text: 'solar:text-bold-duotone',
          numeric: 'solar:hashtag-bold-duotone',
          date: 'solar:calendar-bold-duotone',
          choice: 'solar:checklist-bold-duotone',
          relation: 'solar:link-round-bold-duotone',
          media: 'solar:gallery-bold-duotone',
          computed: 'solar:calculator-bold-duotone',
          advanced: 'solar:code-bold-duotone'
        };
        return icons[key] || 'solar:widget-bold-duotone';
      },
      
      getFieldIcon(fieldId) {
        // Check system fields first
        const icons = {
          title: 'solar:text-bold-duotone',
          description: 'solar:document-text-bold-duotone',
          icon: 'solar:star-bold-duotone',
          attachments: 'solar:paperclip-bold-duotone',
          image: 'solar:gallery-bold-duotone',
          slug: 'solar:link-bold-duotone',
          date: 'solar:calendar-bold-duotone'
        };
        
        if (icons[fieldId]) return icons[fieldId];
        
        // Check custom fields
        const customField = this.selectedFields.find(f => f._id === fieldId);
        if (customField) return customField.icon || 'solar:widget-bold-duotone';
        
        return 'solar:widget-bold-duotone';
      },
      
      getFieldLabel(fieldId) {
        // Check system fields first
        const labels = {
          title: 'Titre',
          description: 'Description',
          icon: 'Icône',
          attachments: 'Pièces jointes',
          image: 'Image',
          slug: 'Slug',
          date: 'Date'
        };
        
        if (labels[fieldId]) return labels[fieldId];
        
        // Check custom fields
        const customField = this.selectedFields.find(f => f._id === fieldId);
        if (customField) return customField.label || customField.name || fieldId;
        
        return fieldId;
      },
      
      handleImageUpload(event) {
        const file = event.target.files[0];
        if (file) {
          // Store file for form submit
          this.newCollection.imageFile = file;
          // Create preview URL
          this.newCollection.image = URL.createObjectURL(file);
        }
      },
      
      // Token-based reference title methods
      addFieldToken() {
        const fieldId = this.newCollection.referenceField;
        const editor = this.$refs.formatEditor;
        
        // FIRST: Sync tokens from current DOM state before doing anything
        if (editor) {
          const tokens = [];
          editor.childNodes.forEach(node => {
            if (node.nodeType === Node.ELEMENT_NODE && node.classList.contains('field-tag')) {
              const fid = node.getAttribute('data-field-id');
              tokens.push({ t: 'field', id: fid });
            } else if (node.nodeType === Node.TEXT_NODE && node.textContent.trim()) {
              tokens.push({ t: 'text', v: node.textContent });
            }
          });
          this.newCollection.referenceTitleTokens = tokens;
        }
        
        // Check if there are any existing field tokens
        const hasFieldTokens = this.newCollection.referenceTitleTokens.some(token => token.t === 'field');
        
        // Add space before if there are existing field tokens
        if (hasFieldTokens) {
          this.newCollection.referenceTitleTokens.push({ t: 'text', v: ' ' });
        }
        
        // Add field token
        this.newCollection.referenceTitleTokens.push({ t: 'field', id: fieldId });
        
        // Force re-render of contenteditable
        this.$nextTick(() => {
          if (editor) {
            editor.innerHTML = this.renderTokensAsHTML();
          }
        });
      },
      
      removeToken(index) {
        this.newCollection.referenceTitleTokens.splice(index, 1);
        
        // Clean up orphaned spaces
        const tokens = this.newCollection.referenceTitleTokens;
        for (let i = tokens.length - 1; i >= 0; i--) {
          if (tokens[i].t === 'text' && tokens[i].v === ' ') {
            // Remove space if it's at start, end, or next to another space
            if (i === 0 || i === tokens.length - 1 || 
                (tokens[i-1] && tokens[i-1].t === 'text' && tokens[i-1].v === ' ')) {
              tokens.splice(i, 1);
            }
          }
        }
      },
      
      getFormatString() {
        return this.newCollection.referenceTitleTokens.map(token => {
          if (token.t === 'field') {
            return `{{${token.id}}}`;
          }
          return token.v || '';
        }).join('');
      },
      
      getDerivedFields() {
        return this.newCollection.referenceTitleTokens
          .filter(token => token.t === 'field')
          .map(token => token.id);
      },
      
      // Get fields that are NOT already in the format
      getAvailableFields() {
        const usedFieldIds = this.getDerivedFields();
        const available = [];
        
        // Add title if not used
        if (!usedFieldIds.includes('title')) {
          available.push({ id: 'title', label: 'Titre', icon: 'solar:text-bold-duotone' });
        }
        
        // Add standard fields that are enabled and not used
        const standardFieldOrder = ['description', 'icon', 'attachments', 'image', 'slug', 'date'];
        standardFieldOrder.forEach(field => {
          if (this.newCollection.standardFields[field] && !usedFieldIds.includes(field)) {
            available.push({ id: field, label: this.getFieldLabel(field), icon: this.getFieldIcon(field) });
          }
        });
        
        // Add custom fields that are not used
        this.selectedFields.forEach(field => {
          if (!usedFieldIds.includes(field._id)) {
            available.push({ id: field._id, label: field.label || field.name, icon: this.getFieldIcon(field._id) });
          }
        });
        
        return available;
      },
      
      // Add field to format by clicking on available field tag
      addFieldById(fieldId) {
        const editor = this.showEditModal ? this.$refs.formatEditorEdit : this.$refs.formatEditor;
        
        // Sync tokens from current DOM state
        if (editor) {
          const tokens = [];
          editor.childNodes.forEach(node => {
            if (node.nodeType === Node.ELEMENT_NODE && node.classList.contains('field-tag')) {
              const fid = node.getAttribute('data-field-id');
              tokens.push({ t: 'field', id: fid });
            } else if (node.nodeType === Node.TEXT_NODE && node.textContent.trim()) {
              tokens.push({ t: 'text', v: node.textContent });
            }
          });
          this.newCollection.referenceTitleTokens = tokens;
        }
        
        // Check if there are any existing field tokens
        const hasFieldTokens = this.newCollection.referenceTitleTokens.some(token => token.t === 'field');
        
        // Add space before if there are existing field tokens
        if (hasFieldTokens) {
          this.newCollection.referenceTitleTokens.push({ t: 'text', v: ' ' });
        }
        
        // Add field token
        this.newCollection.referenceTitleTokens.push({ t: 'field', id: fieldId });
        
        // Force re-render of contenteditable
        this.$nextTick(() => {
          if (editor) {
            editor.innerHTML = this.renderTokensAsHTML();
          }
        });
      },
      
      // Parse contenteditable content and update tokens
      syncTokensFromEditor(event) {
        const editor = event.target;
        const tokens = [];
        
        // Iterate through child nodes
        editor.childNodes.forEach(node => {
          if (node.nodeType === Node.ELEMENT_NODE && node.classList.contains('field-tag')) {
            // Field token
            const fieldId = node.getAttribute('data-field-id');
            tokens.push({ t: 'field', id: fieldId });
          } else if (node.nodeType === Node.TEXT_NODE && node.textContent.trim()) {
            // Text token
            tokens.push({ t: 'text', v: node.textContent });
          }
        });
        
        // Allow empty tokens array instead of forcing default to 'title'
        this.newCollection.referenceTitleTokens = tokens;
      },
      
      // Render tokens as contenteditable HTML
      renderTokensAsHTML() {
        return this.newCollection.referenceTitleTokens.map((token, idx) => {
          if (token.t === 'field') {
            const icon = this.getFieldIcon(token.id);
            const label = this.getFieldLabel(token.id);
            return `<span class="field-tag" data-field-id="${token.id}" data-token-index="${idx}" contenteditable="false"><iconify-icon icon="${icon}" width="12"></iconify-icon> ${label}<span class="field-tag-remove" onclick="window.removeFieldTag(this)"><iconify-icon icon="solar:close-circle-bold" width="12"></iconify-icon></span></span>`;
          }
          return token.v || '';
        }).join('');
      },
      
      async loadSystemFields() {
        try {
          const res = await fetch('/account/<%= account_number %>/field-template/api/system');
          if (res.ok) {
            this.systemFields = await res.json();
            console.log('📦 systemFields loaded:', this.systemFields);
            console.log('📦 Total categories:', this.systemFields.length);
            this.systemFields.forEach(cat => console.log(`  - ${cat.label}: ${cat.fields.length} champs`));
          }
        } catch (e) {
          console.error('Failed to load system fields:', e);
        }
      },
      
      async loadClassifications() {
        if (this.classificationsLoaded) return;
        try {
          const res = await fetch('/account/<%= account_number %>/classification/api/list');
          if (res.ok) {
            this.allClassifications = await res.json();
            this.classificationsLoaded = true;
          }
        } catch (e) {
          console.error('Failed to load classifications:', e);
        }
      },
      
      toggleClassification(id) {
        // Don't allow selecting status classification in additional
        if (id === this.newCollection.statusClassificationId) return;
        
        const idx = this.newCollection.classifications.indexOf(id);
        if (idx >= 0) {
          this.newCollection.classifications.splice(idx, 1);
        } else {
          this.newCollection.classifications.push(id);
        }
      },
      
      isClassificationSelected(id) {
        return this.newCollection.classifications.includes(id);
      },
      
      onStatusClassificationChange() {
        // Remove from additional classifications if selected as status
        const statusId = this.newCollection.statusClassificationId;
        if (statusId) {
          const idx = this.newCollection.classifications.indexOf(statusId);
          if (idx >= 0) {
            this.newCollection.classifications.splice(idx, 1);
          }
        }
      },
      
      getClassificationById(id) {
        return this.allClassifications.find(c => c._id === id);
      },

      showHideColumns(col, value) {
        if (value) {
          this.showCols.push(col);
          this.hideCols = this.hideCols.filter((d) => d != col);
        } else {
          this.hideCols.push(col);
          this.showCols = this.showCols.filter((d) => d != col);
        }
        let headers = this.datatable1.columns();
        headers.hide(this.hideCols);
        headers.show(this.showCols);
      },

      resetForm() {
        this.step = 1;
        this.step2Tab = 'fields';
        this.fieldSearch = '';
        this.selectedFields = [];
        this.relations = [];
        this.accordionVisuel = false;
        this.accordionChamps = true;
        this.accordionClassifications = false;
        this.accordionReference = false;
        this.newCollection = {
          name: '',
          slug: '',
          description: '',
          icon: '',
          color: '',
          active: true,
          referenceTitleTokens: [{ t: 'field', id: 'title' }],
          standardFields: { title: true, slug: false, date: false },
          statusClassificationId: '',
          classifications: []
        };
      },
      
      // ===== Relations Methods =====
      _uuidv4() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
          const r = Math.random() * 16 | 0;
          return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
      },
      
      async loadAllEntities() {
        if (this.allEntities.length > 0) return; // cache
        try {
          const res = await fetch('/account/<%= account_number %>/entity/api/list');
          if (res.ok) this.allEntities = await res.json();
        } catch (e) {
          console.error('Failed to load entities:', e);
        }
      },
      
      async loadEntityFields(entityId) {
        if (!entityId) return [];
        if (this.entityFieldsCache[entityId]) return this.entityFieldsCache[entityId];
        try {
          const res = await fetch(`/account/<%= account_number %>/entity/api/${entityId}/fields`);
          if (res.ok) {
            const fields = await res.json();
            this.entityFieldsCache[entityId] = fields;
            return fields;
          }
        } catch (e) {
          console.error('Failed to load entity fields:', e);
        }
        return [];
      },
      
      addRelation() {
        this.relations.push({
          key: this._uuidv4(),
          targetEntity: '',
          label: '',
          inverseLabel: '',
          cardinality: 'one-to-many',
          inputMode: 'autocomplete',
          storage: 'on-source',
          searchFields: [],
          displayFields: [],
          bidirectional: false,
          required: false,
          _targetFields: [] // transient: fields of target entity for UI
        });
      },
      
      removeRelation(index) {
        this.relations.splice(index, 1);
      },
      
      async onRelationEntityChange(relation) {
        // Reset fields when entity changes
        relation.searchFields = [];
        relation.displayFields = [];
        relation._targetFields = [];
        
        if (relation.targetEntity) {
          // Auto-fill label from entity name
          const entity = this.allEntities.find(e => e._id === relation.targetEntity);
          if (entity && !relation.label) {
            relation.label = entity.name;
          }
          // Load fields
          relation._targetFields = await this.loadEntityFields(relation.targetEntity);
        }
      },
      
      toggleSearchField(relation, fieldId) {
        const idx = relation.searchFields.indexOf(fieldId);
        if (idx >= 0) {
          relation.searchFields.splice(idx, 1);
        } else {
          relation.searchFields.push(fieldId);
        }
      },
      
      toggleDisplayField(relation, fieldId) {
        const idx = relation.displayFields.indexOf(fieldId);
        if (idx >= 0) {
          relation.displayFields.splice(idx, 1);
        } else {
          relation.displayFields.push(fieldId);
        }
      },

      getRelationEntity(entityId) {
        return this.allEntities.find(e => e._id === entityId) || null;
      },

      async createCollection() {
        if (!this.newCollection.name) return;
        this.isSubmitting = true;

        if (!this.newCollection.slug) {
          this.newCollection.slug = this.newCollection.name
            .toLowerCase()
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');
        }

        const enabledStandardFields = Object.entries(this.newCollection.standardFields)
          .filter(([k, v]) => v).map(([k]) => k);

        try {
          const res = await fetch('/account/<%= account_number %>/entity/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: this.newCollection.name,
              slug: this.newCollection.slug,
              description: this.newCollection.description,
              icon: this.newCollection.icon,
              color: this.newCollection.color,
              active: this.newCollection.active,
              enabledStandardFields,
              customFields: this.selectedFields.map(f => f._id),
              referenceTitleTokens: this.newCollection.referenceTitleTokens,
              statusClassification: this.newCollection.statusClassificationId || null,
              classifications: this.newCollection.classifications,
              relations: this.relations.filter(r => r.targetEntity).map(({ _targetFields, ...r }) => r)
            })
          });

          if (res.ok) {
            Swal.fire({ icon: 'success', title: 'Collection créée !', timer: 1500, showConfirmButton: false });
            this.showCreateModal = false;
            this.resetForm();
            setTimeout(() => location.reload(), 1000);
          } else {
            throw new Error('Erreur lors de la création');
          }
        } catch (e) {
          Swal.fire({ icon: 'error', title: 'Erreur', text: e.message });
        } finally {
          this.isSubmitting = false;
        }
      },

      async openEditModal(entityId) {
        this.editingId = entityId;
        await this.loadClassifications();
        try {
          const res = await fetch(`/account/<%= account_number %>/entity/api/${entityId}`);
          if (res.ok) {
            const entity = await res.json();
            this.newCollection = {
              name: entity.name || '',
              slug: entity.slug || '',
              description: entity.description || '',
              icon: entity.icon || '',
              color: entity.color || '',
              active: entity.active !== false,
              referenceTitleTokens: entity.referenceTitleTokens || [{ t: 'field', id: 'title' }],
              standardFields: {
                title: (entity.enabledStandardFields || []).includes('title'),
                description: (entity.enabledStandardFields || []).includes('description'),
                icon: (entity.enabledStandardFields || []).includes('icon'),
                attachments: (entity.enabledStandardFields || []).includes('attachments'),
                image: (entity.enabledStandardFields || []).includes('image'),
                slug: (entity.enabledStandardFields || []).includes('slug'),
                date: (entity.enabledStandardFields || []).includes('date')
              },
              statusClassificationId: entity.statusClassification?._id || entity.statusClassification || '',
              classifications: (entity.classifications || []).map(c => c._id || c)
            };
            this.selectedFields = entity.customFields || [];
            
            // Load relations with their target entity fields
            this.relations = (entity.relations || []).map(r => ({
              ...r,
              targetEntity: r.targetEntity?._id || r.targetEntity || '',
              _targetFields: []
            }));
            // Load target fields for each relation
            await this.loadAllEntities();
            for (const rel of this.relations) {
              if (rel.targetEntity) {
                rel._targetFields = await this.loadEntityFields(rel.targetEntity);
              }
            }
            this.step = 1;
            this.showEditModal = true;
          }
        } catch (e) {
          console.error('Failed to load entity:', e);
          Swal.fire({ icon: 'error', title: 'Erreur', text: 'Impossible de charger la collection' });
        }
      },

      async updateCollection() {
        if (!this.newCollection.name || !this.editingId) return;
        this.isSubmitting = true;

        const enabledStandardFields = Object.entries(this.newCollection.standardFields)
          .filter(([k, v]) => v).map(([k]) => k);

        try {
          const res = await fetch(`/account/<%= account_number %>/entity/api/update/${this.editingId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: this.newCollection.name,
              slug: this.newCollection.slug,
              description: this.newCollection.description,
              icon: this.newCollection.icon,
              color: this.newCollection.color,
              active: this.newCollection.active,
              enabledStandardFields,
              customFields: this.selectedFields.map(f => f._id || f),
              referenceTitleTokens: this.newCollection.referenceTitleTokens,
              statusClassification: this.newCollection.statusClassificationId || null,
              classifications: this.newCollection.classifications,
              relations: this.relations.filter(r => r.targetEntity).map(({ _targetFields, ...r }) => r)
            })
          });

          if (res.ok) {
            Swal.fire({ icon: 'success', title: 'Collection mise à jour !', timer: 1500, showConfirmButton: false });
            this.showEditModal = false;
            this.resetForm();
            setTimeout(() => location.reload(), 1000);
          } else {
            throw new Error('Erreur lors de la mise à jour');
          }
        } catch (e) {
          Swal.fire({ icon: 'error', title: 'Erreur', text: e.message });
        } finally {
          this.isSubmitting = false;
        }
      },

      init() {
        const rows = <%- JSON.stringify(rows) %>;
        this.loadSystemFields();
        this.loadClassifications();

        window.addEventListener('open-collection-modal', () => {
          this.loadClassifications();
          this.showCreateModal = true;
        });

        window.addEventListener('open-edit-modal', (e) => {
          this.openEditModal(e.detail);
        });

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('openModal') === 'true') {
          this.showCreateModal = true;
          window.history.replaceState({}, '', window.location.pathname);
        }

        this.datatable1 = new simpleDatatables.DataTable("#myTable1", {
          data: {
            headings: this.columns.map((c) => c.name),
            data: rows,
          },
          perPage: 10,
          perPageSelect: [10, 20, 30, 50, 100],
          columns: [
            {
              select: 0,
              sort: "asc",
              render: (data) =>
                `<input type="checkbox" class="form-checkbox" value="${data}" />`,
            },
            {
              select: 4,
              render: (data) =>
                `<div class="w-6 h-6 rounded-full border" style="background-color:${data};"></div>`,
            },
            {
              select: 7,
              render: (data) => {
                const dt = new Date(data);
                const month = dt.getMonth() + 1 < 10 ? "0" + (dt.getMonth() + 1) : dt.getMonth() + 1;
                const day = dt.getDate() < 10 ? "0" + dt.getDate() : dt.getDate();
                return day + "/" + month + "/" + dt.getFullYear();
              },
            },
            {
              select: 8,
              render: (html) => html,
            },
          ],
          firstLast: true,
          layout: {
            top: "{search}",
            bottom: "{info}{select}{pager}",
          },
        });

        this.datatable1.columns().hide(this.hideCols);
        this.datatable1.columns().show(this.showCols);
      },
    }));
  });
</script>

