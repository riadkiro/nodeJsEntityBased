<!DOCTYPE html>
<html lang="fr" dir="ltr">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <title>Mes espaces | Dexapp</title>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/x-icon" href="/favicon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <link rel="stylesheet" type="text/css" media="screen" href="/assets/css/perfect-scrollbar.min.css" />
        <link rel="stylesheet" type="text/css" media="screen" href="/assets/css/style.css" />
        <link defer rel="stylesheet" type="text/css" media="screen" href="/assets/css/animate.css" />
        <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.7/dist/iconify-icon.min.js"></script>
        <script src="/assets/js/perfect-scrollbar.min.js"></script>
        <script defer src="/assets/js/popper.min.js"></script>
        <script defer src="/assets/js/tippy-bundle.umd.min.js"></script>
    </head>

    <body
        x-data="main"
        class="relative overflow-x-hidden font-nunito text-sm font-normal antialiased"
        :class="[ $store.app.sidebar ? 'toggle-sidebar' : '', $store.app.theme, $store.app.menu, $store.app.layout,$store.app.rtlClass]"
    >
        <div class="screen_loader animate__animated fixed inset-0 z-[60] grid place-content-center bg-[#fafafa] dark:bg-[#060818]">
            <svg width="64" height="64" viewBox="0 0 135 135" xmlns="http://www.w3.org/2000/svg" fill="#4361ee">
                <path d="M67.447 58c5.523 0 10-4.477 10-10s-4.477-10-10-10-10 4.477-10 10 4.477 10 10 10zm9.448 9.447c0 5.523 4.477 10 10 10 5.522 0 10-4.477 10-10s-4.478-10-10-10c-5.523 0-10 4.477-10 10zm-9.448 9.448c-5.523 0-10 4.477-10 10 0 5.522 4.477 10 10 10s10-4.478 10-10c0-5.523-4.477-10-10-10zM58 67.447c0-5.523-4.477-10-10-10s-10 4.477-10 10 4.477 10 10 10 10-4.477 10-10z">
                    <animateTransform attributeName="transform" type="rotate" from="0 67 67" to="-360 67 67" dur="2.5s" repeatCount="indefinite" />
                </path>
                <path d="M28.19 40.31c6.627 0 12-5.374 12-12 0-6.628-5.373-12-12-12-6.628 0-12 5.372-12 12 0 6.626 5.372 12 12 12zm30.72-19.825c4.686 4.687 12.284 4.687 16.97 0 4.686-4.686 4.686-12.284 0-16.97-4.686-4.687-12.284-4.687-16.97 0-4.687 4.686-4.687 12.284 0 16.97zm35.74 7.705c0 6.627 5.37 12 12 12 6.626 0 12-5.373 12-12 0-6.628-5.374-12-12-12-6.63 0-12 5.372-12 12zm19.822 30.72c-4.686 4.686-4.686 12.284 0 16.97 4.687 4.686 12.285 4.686 16.97 0 4.687-4.686 4.687-12.284 0-16.97-4.685-4.687-12.283-4.687-16.97 0zm-7.704 35.74c-6.627 0-12 5.37-12 12 0 6.626 5.373 12 12 12s12-5.374 12-12c0-6.63-5.373-12-12-12zm-30.72 19.822c-4.686-4.686-12.284-4.686-16.97 0-4.686 4.687-4.686 12.285 0 16.97 4.686 4.687 12.284 4.687 16.97 0 4.687-4.685 4.687-12.283 0-16.97zm-35.74-7.704c0-6.627-5.372-12-12-12-6.626 0-12 5.373-12 12s5.374 12 12 12c6.628 0 12-5.373 12-12zm-19.823-30.72c4.687-4.686 4.687-12.284 0-16.97-4.686-4.686-12.284-4.686-16.97 0-4.687 4.686-4.687 12.284 0 16.97 4.686 4.687 12.284 4.687 16.97 0z">
                    <animateTransform attributeName="transform" type="rotate" from="0 67 67" to="360 67 67" dur="8s" repeatCount="indefinite" />
                </path>
            </svg>
        </div>

        <div class="main-container min-h-screen text-black dark:text-white-dark">
            <div class="flex min-h-screen items-center justify-center bg-[url('../images/map.svg')] bg-cover bg-center dark:bg-[url('../images/map-dark.svg')]">
                <div class="panel m-6 w-full max-w-lg sm:w-[480px]">
                    <!-- Icon & Title (same pattern as login) -->
                    <div class="text-center mb-6">
                        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary/10 mb-3">
                            <iconify-icon icon="solar:buildings-2-bold-duotone" width="28" class="text-primary"></iconify-icon>
                        </div>
                        <h2 class="text-2xl font-bold">Vos espaces de travail</h2>
                        <p class="text-gray-500 dark:text-gray-400 mt-1">Sélectionnez un espace pour continuer</p>
                    </div>

                    <!-- User Info Bar -->
                    <div class="flex items-center gap-3 p-3 rounded-lg bg-gray-50 dark:bg-[#1b2e4b] mb-5">
                        <% if (user.avatar) { %>
                            <img src="<%= user.avatar %>" class="w-10 h-10 rounded-full object-cover ring-2 ring-primary/20" alt="" />
                        <% } else { %>
                            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-base">
                                <%= user.name ? user.name.charAt(0).toUpperCase() : '?' %>
                            </div>
                        <% } %>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-semibold text-sm dark:text-white truncate"><%= user.name || user.email %></h3>
                            <p class="text-xs text-gray-400 truncate"><%= user.email %></p>
                        </div>
                        <% const planBadge = { free: 'bg-gray-100 text-gray-600', basic: 'bg-blue-100 text-blue-600', premium: 'bg-amber-100 text-amber-700', enterprise: 'bg-purple-100 text-purple-600' }; %>
                        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase shrink-0 <%= planBadge[user.membership?.plan] || planBadge.free %>">
                            <iconify-icon icon="<%= user.membership?.plan === 'premium' ? 'solar:crown-bold' : user.membership?.plan === 'enterprise' ? 'solar:crown-star-bold' : 'solar:star-bold' %>" width="11" class="mr-0.5"></iconify-icon>
                            <%= user.membership?.plan || 'free' %>
                        </span>
                    </div>


                    <!-- Pending Invitations -->
                    <% if (locals.pendingInvitations && pendingInvitations.length > 0) { %>
                        <div class="mb-5">
                            <div class="flex items-center gap-2 mb-3">
                                <div class="w-6 h-6 rounded-lg bg-warning/10 flex items-center justify-center">
                                    <iconify-icon icon="solar:letter-bold-duotone" width="14" class="text-warning"></iconify-icon>
                                </div>
                                <span class="text-sm font-bold text-gray-700 dark:text-gray-300">Invitations en attente</span>
                                <span class="px-1.5 py-0.5 rounded-md text-[10px] font-bold bg-warning/10 text-warning"><%= pendingInvitations.length %></span>
                            </div>
                            <div class="space-y-2">
                                <% for (let inv of pendingInvitations) { %>
                                    <div class="flex items-center p-3 rounded-xl border-2 border-warning/20 bg-warning/5 gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-warning/10 flex items-center justify-center shrink-0">
                                            <iconify-icon icon="<%= inv.accountIcon %>" width="20" class="text-warning"></iconify-icon>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h4 class="font-bold text-sm text-black dark:text-white-light truncate"><%= inv.accountName %></h4>
                                            <div class="flex items-center gap-2 mt-0.5">
                                                <span class="text-[11px] text-gray-400 font-mono">#<%= inv.accountNumber %></span>
                                                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase
                                                    <%= inv.role === 'admin' ? 'bg-blue-100 text-blue-600' : inv.role === 'manager' ? 'bg-orange-100 text-orange-600' : inv.role === 'viewer' ? 'bg-green-100 text-green-600' : inv.role === 'guest' ? 'bg-purple-100 text-purple-600' : 'bg-gray-100 text-gray-500' %>">
                                                    <%= inv.role === 'admin' ? 'Admin' : inv.role === 'manager' ? 'Manager' : inv.role === 'viewer' ? 'Observateur' : inv.role === 'guest' ? 'Invité' : 'Membre' %>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="flex gap-1.5 shrink-0">
                                            <form method="POST" action="/user/invitations/decline" style="margin:0;">
                                                <input type="hidden" name="token" value="<%= inv.token %>" />
                                                <button type="submit" class="w-8 h-8 rounded-lg border border-gray-200 dark:border-[#253b5c] bg-white dark:bg-[#1b2e4b] flex items-center justify-center text-gray-400 hover:text-danger hover:border-danger transition-all" title="Refuser">
                                                    <iconify-icon icon="solar:close-circle-bold" width="16"></iconify-icon>
                                                </button>
                                            </form>
                                            <form method="POST" action="/user/invitations/accept" style="margin:0;">
                                                <input type="hidden" name="token" value="<%= inv.token %>" />
                                                <button type="submit" class="px-3 h-8 rounded-lg bg-success text-white text-xs font-bold flex items-center gap-1 hover:bg-success/90 transition-all">
                                                    <iconify-icon icon="solar:check-circle-bold" width="14"></iconify-icon>
                                                    Accepter
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } %>

                    <!-- Workspace List -->
                    <div class="space-y-2.5 mb-4">
                        <% if (locals.accounts && accounts.length > 0) { %>
                            <% for (let i = 0; i < accounts.length; i++) { %>
                                <div class="relative group" x-data="{ showLeave: false }">
                                    <a href="/account/<%= accounts[i].account_number %>/home" 
                                       class="flex items-center p-3.5 rounded-lg border border-white-light dark:border-[#1b2e4b] hover:border-primary hover:shadow-md dark:hover:border-primary bg-white dark:bg-[#1b2e4b] transition-all group/card">
                                        <div class="bg-primary/10 text-primary rounded-lg p-2.5 mr-3 group-hover/card:bg-primary group-hover/card:text-white transition-colors">
                                            <iconify-icon icon="<%= accounts[i].icon || 'solar:home-2-bold-duotone' %>" width="20"></iconify-icon>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h4 class="font-bold text-sm text-black dark:text-white-light group-hover/card:text-primary transition-colors truncate"><%= accounts[i].name %></h4>
                                            <div class="flex items-center gap-2 mt-0.5">
                                                <span class="text-[11px] text-gray-400 font-mono">#<%= accounts[i].account_number %></span>
                                                <% if (accounts[i].role) { %>
                                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase
                                                        <%= accounts[i].role === 'owner' ? 'bg-amber-100 text-amber-700' : accounts[i].role === 'admin' ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-500' %>">
                                                        <%= accounts[i].role %>
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="ml-auto text-gray-300 group-hover/card:text-primary transition-colors">
                                            <iconify-icon icon="solar:arrow-right-linear" width="18"></iconify-icon>
                                        </div>
                                    </a>
                                    <% if (accounts[i].role !== 'owner') { %>
                                        <!-- Leave button -->
                                        <button @click.stop="showLeave = !showLeave" class="absolute top-1/2 -translate-y-1/2 right-[-8px] w-6 h-6 rounded-full bg-white dark:bg-[#0e1726] border border-gray-200 dark:border-[#253b5c] shadow-sm flex items-center justify-center text-gray-300 hover:text-danger hover:border-danger transition-all opacity-0 group-hover:opacity-100" title="Quitter cet espace">
                                            <iconify-icon icon="solar:logout-2-bold" width="12"></iconify-icon>
                                        </button>
                                        <!-- Leave confirmation -->
                                        <div x-show="showLeave" x-transition @click.outside="showLeave = false" class="absolute right-0 top-full mt-1 z-10 bg-white dark:bg-[#0e1726] border border-gray-200 dark:border-[#253b5c] rounded-xl p-3 shadow-lg w-64">
                                            <p class="text-xs text-gray-600 dark:text-gray-400 mb-2.5">Voulez-vous vraiment quitter <strong class="text-gray-800 dark:text-white"><%= accounts[i].name %></strong> ?</p>
                                            <div class="flex gap-2">
                                                <button @click="showLeave = false" class="flex-1 px-3 py-1.5 rounded-lg border border-gray-200 dark:border-[#253b5c] text-xs font-semibold text-gray-500 hover:bg-gray-50">Annuler</button>
                                                <form method="POST" action="/user/accounts/leave" style="margin:0;flex:1;">
                                                    <input type="hidden" name="accountNumber" value="<%= accounts[i].account_number %>" />
                                                    <button type="submit" class="w-full px-3 py-1.5 rounded-lg bg-danger text-white text-xs font-bold hover:bg-danger/90 transition-all">Quitter</button>
                                                </form>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            <% } %>
                        <% } else { %>
                            <div class="text-center py-8">
                                <div class="w-14 h-14 rounded-2xl bg-gray-100 dark:bg-[#1b2e4b] flex items-center justify-center mx-auto mb-3">
                                    <iconify-icon icon="solar:buildings-2-bold-duotone" width="28" class="text-gray-400"></iconify-icon>
                                </div>
                                <p class="text-gray-500 mb-1">Aucun espace de travail</p>
                                <p class="text-xs text-gray-400">Créez votre premier workspace</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Create New Workspace Button -->
                    <button @click="$refs.createModal.showModal()" class="btn btn-outline-primary w-full mb-5">
                        <iconify-icon icon="solar:add-circle-bold" width="18" class="mr-2"></iconify-icon>
                        Créer un nouvel espace
                    </button>

                    <!-- Footer -->
                    <div class="pt-4 border-t border-gray-100 dark:border-[#1b2e4b] flex items-center justify-between">
                        <a href="/auth/logout" class="text-xs text-gray-400 hover:text-danger flex items-center gap-1.5 transition-colors">
                            <iconify-icon icon="solar:logout-2-bold" width="14"></iconify-icon>
                            Déconnexion
                        </a>
                        <% if (user.role === 'admin' || user.role === 'superadmin') { %>
                            <% if (accounts && accounts.length > 0) { %>
                                <a href="/account/<%= accounts[0].account_number %>/admin" class="text-xs text-primary hover:underline flex items-center gap-1">
                                    <iconify-icon icon="solar:shield-star-bold" width="14"></iconify-icon>
                                    Admin Panel
                                </a>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Create Account Modal -->
        <dialog x-ref="createModal" class="modal rounded-xl bg-white dark:bg-[#0e1726] p-0 backdrop:bg-black/50 max-w-md w-full">
            <form method="POST" action="/user/accounts/create" class="p-6">
                <div class="flex items-center justify-between mb-5">
                    <h3 class="text-xl font-bold dark:text-white-light">Nouveau workspace</h3>
                    <button type="button" @click="$refs.createModal.close()" class="text-gray-400 hover:text-gray-600">
                        <iconify-icon icon="solar:close-circle-bold" width="24"></iconify-icon>
                    </button>
                </div>
                
                <div class="mb-4">
                    <label for="accountName" class="block text-sm font-semibold mb-2 dark:text-white-light">Nom de l'espace *</label>
                    <input type="text" id="accountName" name="name" required placeholder="Mon workspace" class="form-input w-full" />
                </div>

                <div class="mb-6">
                    <label for="accountIcon" class="block text-sm font-semibold mb-2 dark:text-white-light">Icône</label>
                    <input type="text" id="accountIcon" name="icon" placeholder="solar:home-2-bold-duotone" class="form-input w-full" />
                    <p class="text-xs text-gray-500 mt-1">Icône Solar Iconify (optionnel)</p>
                </div>

                <div class="flex gap-3">
                    <button type="button" @click="$refs.createModal.close()" class="btn btn-outline-dark flex-1">Annuler</button>
                    <button type="submit" class="btn btn-primary flex-1">
                        <iconify-icon icon="solar:add-circle-bold" width="16" class="mr-1.5"></iconify-icon>
                        Créer
                    </button>
                </div>
            </form>
        </dialog>

        <script src="/assets/js/alpine-collaspe.min.js"></script>
        <script src="/assets/js/alpine-persist.min.js"></script>
        <script defer src="/assets/js/alpine-ui.min.js"></script>
        <script defer src="/assets/js/alpine-focus.min.js"></script>
        <script defer src="/assets/js/alpine.min.js"></script>
        <script src="/assets/js/custom.js"></script>
    </body>
</html>
