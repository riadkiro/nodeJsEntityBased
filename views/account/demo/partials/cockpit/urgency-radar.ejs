<!-- Urgency Radar Widget -->
<div class="panel h-full">
  <div class="mb-5 flex items-center justify-between dark:text-white-light">
    <h5 class="text-lg font-semibold">Radar Urgences</h5>
    <span class="relative flex h-3 w-3" x-show="kpis.urgentCount > 0">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-danger opacity-75"></span>
      <span class="relative inline-flex h-3 w-3 rounded-full bg-danger"></span>
    </span>
  </div>
  <div class="space-y-4">
    <!-- Urgent Cases -->
    <div class="flex items-center gap-3 rounded-lg p-3" 
         style="border: 1px solid rgba(231, 81, 90, 0.3); background: rgba(231, 81, 90, 0.1);"
         x-show="kpis.urgentCount > 0">
      <div class="flex h-10 w-10 items-center justify-center rounded-full bg-danger text-white">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      </div>
      <div>
        <div class="font-semibold text-danger"><span x-text="kpis.urgentCount">0</span> Cas Urgent<span x-show="kpis.urgentCount > 1">s</span></div>
        <div class="text-xs text-white-dark">Nécessitent attention immédiate</div>
      </div>
    </div>
    
    <!-- Critical Lab Results -->
    <div class="flex items-center gap-3 rounded-lg p-3" 
         style="border: 1px solid rgba(226, 160, 63, 0.3); background: rgba(226, 160, 63, 0.1);">
      <div class="flex h-10 w-10 items-center justify-center rounded-full bg-warning text-white">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
      </div>
      <div>
        <div class="font-semibold text-warning">1 Résultat Critique</div>
        <div class="text-xs text-white-dark">Labo à consulter</div>
      </div>
    </div>
    
    <!-- Pending Approvals -->
    <div class="flex items-center gap-3 rounded-lg p-3" 
         style="border: 1px solid rgba(33, 150, 243, 0.3); background: rgba(33, 150, 243, 0.1);">
      <div class="flex h-10 w-10 items-center justify-center rounded-full bg-info text-white">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
      <div>
        <div class="font-semibold text-info"><span x-text="requests.length || 0">0</span> Approbation<span x-show="requests.length !== 1">s</span></div>
        <div class="text-xs text-white-dark">En attente de signature</div>
      </div>
    </div>
    
    <!-- All Clear -->
    <div class="flex items-center gap-3 rounded-lg p-3" 
         style="border: 1px solid rgba(0, 171, 85, 0.3); background: rgba(0, 171, 85, 0.1);"
         x-show="kpis.urgentCount === 0 && requests.length === 0">
      <div class="flex h-10 w-10 items-center justify-center rounded-full bg-success text-white">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <div>
        <div class="font-semibold text-success">Tout va bien</div>
        <div class="text-xs text-white-dark">Aucune urgence</div>
      </div>
    </div>
  </div>
</div>
