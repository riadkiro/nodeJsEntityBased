                                                                         : 'background: #fff; border: 2px solid #d1d5db'">
                                                                    <iconify-icon x-show="(getEditLines()[editModal.lineIdx].values[col.key] || []).includes(opt.value)"
                                                                                  icon="tabler:check" width="12"
