  {
    "_id": "6982ca8351a0e3777df62010",
    "actionKey": "chat-completion",
    "providerKey": "openai",
    "__v": 0,
    "createdAt": "2026-02-04T04:26:43.951Z",
    "description": "Generate text using GPT models (GPT-4, GPT-3.5-turbo)",
    "http": {
      "method": "POST",
      "path": "/chat/completions"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "title": "Model",
          "description": "ID of the model to use",
          "enum": [
            "gpt-4",
            "gpt-4-turbo",
            "gpt-4o",
            "gpt-4o-mini",
            "gpt-3.5-turbo"
          ],
          "default": "gpt-4o-mini"
        },
        "messages": {
          "type": "array",
          "title": "Messages",
          "description": "List of messages in the conversation",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string"
              }
            }
          }
        },
        "temperature": {
          "type": "number",
          "title": "Temperature",
          "description": "Creativity level (0-2)",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2
        },
        "max_tokens": {
          "type": "number",
          "title": "Max Tokens",
          "description": "Maximum tokens in response",
          "default": 1000
        }
      },
      "required": [
        "model",
        "messages"
      ]
    },
    "isPublished": true,
    "name": "Chat Completion",
    "requestTemplate": {
      "query": {},
      "headers": {},
      "body": {
        "model": "{{input.model}}",
        "messages": "{{input.messages}}",
        "temperature": "{{input.temperature}}",
        "max_tokens": "{{input.max_tokens}}",
        "response_format": "{{input.response_format}}"
      }
    },
    "responseMapping": {
      "content": "choices[0].message.content",
      "role": "choices[0].message.role",
      "model": "model",
      "usage": "usage",
      "finishReason": "choices[0].finish_reason"
    },
    "testPayload": {
      "model": "gpt-4o-mini",
      "messages": [
        {
          "role": "user",
          "content": "Say hello in French"
        }
      ],
      "max_tokens": 50
    },
    "updatedAt": "2026-02-09T03:53:22.161Z"
  },
