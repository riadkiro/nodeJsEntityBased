    <!-- ═══ FIELD PICKER MODAL ═══ -->
    <div x-data="ficheFieldPicker()" @open-field-picker.window="openModal()">
        <!-- Overlay -->
        <div class="fp-overlay" :class="{'fp-open': isOpen}" @click="closeModal()"></div>
        <!-- Modal -->
        <div class="fp-modal" :class="{'fp-open': isOpen}">
            <!-- Header -->
            <div class="fp-header">
                <template x-if="step === 2">
                    <button type="button" class="fp-back" @click="step = 1; searchQ = ''">
