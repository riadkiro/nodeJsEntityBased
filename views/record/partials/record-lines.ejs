                                <iconify-icon icon="solar:global-bold-duotone" width="18" style="color: #4361ee;"></iconify-icon>
                                <div class="lp-save-scope-info">
                                    <div class="lp-save-scope-title">Preset global</div>
                                    <div class="lp-save-scope-desc">Disponible pour tous les records de ce type</div>
                                </div>
                            </div>
                            <!-- Linked parent option (e.g., "Pour toutes les consultations de Patient: Martin") -->
                            <template x-for="lr in linkedRecords" :key="lr.recordId">
                                <div class="lp-save-scope-option"
                                     :class="{ 'active': savePresetModal.scope === 'linked' && savePresetModal.linkedRecordId === lr.recordId }"
                                     @click="savePresetModal.scope = 'linked'; savePresetModal.linkedRecordId = lr.recordId; savePresetModal.linkedRecordLabel = lr.recordTitle; savePresetModal.linkedRelationLabel = lr.relationLabel">
                                    <div class="lp-scope-radio"></div>
                                    <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="18" style="color: #f59e0b;"></iconify-icon>
                                    <div class="lp-save-scope-info">
                                        <div class="lp-save-scope-title">
                                            <span x-text="lr.relationLabel"></span> : <span x-text="lr.recordTitle" style="color: #4361ee;"></span>
                                        </div>
                                        <div class="lp-save-scope-desc">
                                            Visible dans tous les records liés à <span x-text="lr.recordTitle" style="font-weight: 600;"></span>
                                        </div>
                                    </div>
                                </div>
                            </template>
                            <div class="lp-save-scope-option"
                                 :class="{ 'active': savePresetModal.scope === 'record' }"
                                 @click="savePresetModal.scope = 'record'">
                                <div class="lp-scope-radio"></div>
                                <iconify-icon icon="solar:document-bold-duotone" width="18" style="color: #22c55e;"></iconify-icon>
                                <div class="lp-save-scope-info">
                                    <div class="lp-save-scope-title">Ce record uniquement</div>
                                    <div class="lp-save-scope-desc">Lié à ce record spécifique seulement</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Preview -->
                    <div class="lp-save-preview">
                        <div class="lp-save-preview-header">
                            <iconify-icon icon="solar:eye-bold-duotone" width="12"></iconify-icon>
                            <span x-text="getSchemaLines(savePresetModal.schemaId).length + ' lignes seront sauvegardées'"></span>
                        </div>
                        <template x-for="(line, idx) in getSchemaLines(savePresetModal.schemaId).slice(0, 6)" :key="idx">
                            <div class="lp-save-preview-item">
                                <span style="color: #9ca3af; font-size: 10px; min-width: 14px;" x-text="idx + 1"></span>
                                <span x-text="getLinePreviewLabel(line, savePresetModal.schemaId)"></span>
                            </div>
                        </template>
                        <div x-show="getSchemaLines(savePresetModal.schemaId).length > 6"
                             class="lp-save-preview-item" style="color: #9ca3af; font-style: italic;">
                            <span x-text="'+ ' + (getSchemaLines(savePresetModal.schemaId).length - 6) + ' autres lignes...'"></span>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="lp-modal-footer">
                    <div></div>
                    <div style="display: flex; gap: 8px;">
                        <button class="lp-btn-cancel" @click="savePresetModal.open = false">Annuler</button>
                        <button class="lp-btn-add"
                                :disabled="!savePresetModal.name.trim() || savePresetModal.saving"
                                @click="confirmSavePreset()">
                            <iconify-icon x-show="!savePresetModal.saving" icon="solar:diskette-bold" width="14"></iconify-icon>
                            <iconify-icon x-show="savePresetModal.saving" icon="svg-spinners:ring-resize" width="14"></iconify-icon>
                            <span x-text="savePresetModal.saving ? 'Sauvegarde...' : 'Sauvegarder'"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </template>

</div><!-- end x-data linesPanel -->

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('linesPanel', (config) => ({
        recordId: config.recordId,
        accountNumber: config.accountNumber,
        entityId: config.entityId,
        loading: true,
        saving: false,

        // Linked parent records (e.g., patient linked to consultation)
        linkedRecords: (() => {
            const linked = [];
            try {
                const jsonEl = document.getElementById('linesPanel-relations');
                if (!jsonEl) return linked;
                const data = JSON.parse(jsonEl.textContent || '{}');
                const entityRels = data.entityRelations || [];
                const recordRels = data.recordRelations || [];
                for (const eRel of entityRels) {
                    const rRel = recordRels.find(r => r.relationKey === eRel.key);
                    if (rRel && rRel.records && rRel.records.length > 0) {
                        for (const rec of rRel.records) {
                            linked.push({
                                relationKey: eRel.key,
                                relationLabel: eRel.label || '',
                                recordId: rec._id,
                                recordTitle: rec.title || '',
                                entitySlug: rec.entitySlug || ''
                            });
                        }
                    }
                }
            } catch (e) {
                console.error('[DataGrid] Error parsing relations:', e);
            }
            return linked;
        })(),

        schemas: [],
        activeSchemaId: null,
        linesMap: {},       // { schemaId: lines[] }
        totalsMap: {},      // { schemaId: totals{} }
        openSchemas: {},    // { schemaId: boolean } — which panels are expanded
        lineTypeMap: {},    // { schemaId: string } — selected line type per schema
        savingSchemas: {},  // { schemaId: boolean } — saving indicator per schema

        // Keep backward-compatible getters for modal interactions
        get lines() {
            return this.linesMap[this.activeSchemaId] || [];
        },
        set lines(val) {
            if (this.activeSchemaId) {
                this.linesMap[this.activeSchemaId] = val;
            }
        },
        get totals() {
            return this.totalsMap[this.activeSchemaId] || {};
        },
        set totals(val) {
            if (this.activeSchemaId) {
                this.totalsMap[this.activeSchemaId] = val;
            }
        },
        get newLineType() {
            return this.lineTypeMap[this.activeSchemaId] || 'product';
        },
        set newLineType(val) {
            if (this.activeSchemaId) {
                this.lineTypeMap[this.activeSchemaId] = val;
            }
        },

        // Relation search state
        relationSearch: {
            lineIdx: -1,
            colKey: '',
            open: false,
            loading: false,
            results: [],
            query: '',
            debounceTimer: null
        },

        // Multiselect dropdown state
        msDropdown: {
            lineIdx: -1,
            colKey: '',
            open: false,
            query: '',
            pos: null
        },

        // Add Lines modal state
        addModal: {
            open: false,
            query: '',
            loading: false,
            results: [],
            selected: [],  // { _id, label, customFields, values: {} }
            _searchTimer: null,
            _noTarget: false
        },

        // Manual add state
        manualAdd: {
            input: '',
            suggestions: [],
            open: false,
            _timer: null
        },

        _saveTimers: {},  // per-schema save timers
        editModal: { open: false, lineIdx: -1, schemaId: null },
        editRelOpen: false,
        editRelSearch: '',
        editRelResults: [],
        editRelLoading: false,

        // ═══ DataGrid V2: New mode state ═══
        analyticsView: {},   // { schemaId: 'data' | '<viewId>' } — which analytics view is active
        formAddOpen: {},     // { schemaId: boolean } — whether form add panel is open
        formAddValues: {},   // { 'schemaId_colKey': value } — form add field values
        formRelSearch: {},   // { 'schemaId_colKey': 'search query' } — relation search queries
        formRelResults: {},  // { 'schemaId_colKey': [{id, label}] } — relation search results
        formRelLoading: {},  // { 'schemaId_colKey': boolean } — relation loading state
        formRelOpen: {},     // { 'schemaId_colKey': boolean } — relation dropdown open
        formSelSearch: {},   // { 'schemaId_colKey': 'query' } — select/multiselect search
        formSelOpen: {},     // { 'schemaId_colKey': boolean } — select dropdown open
        gridTemplates: [],   // Available templates for this entity's schemas
        templatePicker: {},  // { schemaId: boolean } — template picker open state
        presetDropdown: {},  // { schemaId: boolean } — preset dropdown open state

        // Save Preset Modal state
        savePresetModal: {
            open: false,
            name: '',
            scope: 'workspace',
            schemaId: null,
            saving: false,
            linkedRecordId: null,
            linkedRecordLabel: '',
            linkedRelationLabel: ''
        },
        get activeSchema() {
            return this.schemas.find(s => s._id === this.activeSchemaId) || null;
        },

        get visibleColumns() {
            if (!this.activeSchema) return [];
            return (this.activeSchema.columns || [])
                .filter(c => c.visible !== false)
                .sort((a, b) => (a.order || 0) - (b.order || 0));
        },

        // ── Per-schema helpers ────────────────────────────────
        getSchemaLines(schemaId) {
            return this.linesMap[schemaId] || [];
        },

        getSchemaTotals(schemaId) {
            return this.totalsMap[schemaId] || {};
        },

        isSchemaOpen(schemaId) {
            return this.openSchemas[schemaId] !== false; // default open
        },

        toggleSchemaOpen(schemaId) {
            this.openSchemas[schemaId] = !this.isSchemaOpen(schemaId);
        },

        getSchemaLineType(schemaId) {
            return this.lineTypeMap[schemaId] || 'product';
        },

        setSchemaLineType(schemaId, value) {
            this.lineTypeMap[schemaId] = value;
        },

        getRelationColForSchema(schema) {
            if (!schema) return null;
            return (schema.columns || []).find(c => c.type === 'relation') || null;
        },

        getVisibleColumnsForSchema(schema) {
            if (!schema) return [];
            return (schema.columns || [])
                .filter(c => c.visible !== false)
                .sort((a, b) => (a.order || 0) - (b.order || 0));
        },

        // Activate a schema and open the add modal
        activateAndOpenModal(schemaId) {
            this.activeSchemaId = schemaId;
            this.openAddModal();
        },

        // Add an empty line directly to a schema (for table mode)
        addLineToSchema(schemaId) {
            this.activeSchemaId = schemaId;
            const schema = this.schemas.find(s => s._id === schemaId);
            if (!schema) { this.addLine(); return; }

            const values = {};
            for (const col of (schema.columns || []).filter(c => c.visible !== false)) {
                if (col.type === 'date' && (schema.dataMode === 'timeseries' || schema.inputMode === 'form')) {
                    values[col.key] = new Date().toISOString().split('T')[0];
                } else {
                    values[col.key] = '';
                }
            }

            const newLine = {
                _tempId: 'temp_' + Date.now(),
                lineType: schema.defaultLineType || 'default',
                values,
                computed: {},
                order: (this.linesMap[schemaId] || []).length
            };

            if (!this.linesMap[schemaId]) this.linesMap[schemaId] = [];
            this.linesMap[schemaId].push(newLine);
            this.debouncedSave();
        },

        async init() {
            if (!this.recordId) {
                this.loading = false;
                return;
            }
            await this.loadSchemas();
        },

        async loadSchemas() {
            try {
                const url = `/account/${this.accountNumber}/api/line-schemas/by-context?entityId=${this.entityId}`;
                const res = await fetch(url, { credentials: 'include' });
                const data = await res.json();
                this.schemas = data.data || [];

                // Initialize per-schema state
                for (const s of this.schemas) {
                    this.linesMap[s._id] = [];
                    this.totalsMap[s._id] = {};
                    this.openSchemas[s._id] = true;
                    this.lineTypeMap[s._id] = s.defaultLineType || s.lineTypes?.[0] || 'product';
                    this.savingSchemas[s._id] = false;
                    // DataGrid V2 state
                    this.analyticsView[s._id] = 'data';
                    this.formAddOpen[s._id] = false;
                    this.templatePicker[s._id] = false;
                    this.presetDropdown[s._id] = false;
                }

                if (this.schemas.length > 0) {
                    this.activeSchemaId = this.schemas[0]._id;
                    await this.loadLines();
                    // Load templates for template picker
                    this.loadTemplates();
                }
            } catch (e) {
                console.error('[LinesPanel] Load schemas error:', e);
            } finally {
                this.loading = false;
            }
        },

        async loadLines() {
            try {
                const res = await fetch(`/account/${this.accountNumber}/api/document-lines/${this.recordId}`, {
                    credentials: 'include'
                });
                const data = await res.json();
                const allLines = (data.data || []).map(l => ({
                    ...l,
                    values: l.values || {},
                    computed: l.computed || {},
                    _tempId: l._id || ('tmp_' + Date.now() + '_' + Math.random())
                }));

                // Distribute lines by schemaId
                for (const s of this.schemas) {
                    this.linesMap[s._id] = allLines.filter(l => 
                        l.schemaId === s._id || 
                        (l.schemaId && l.schemaId.toString() === s._id.toString())
                    );
                }

                // Lines without a schemaId go to the first schema
                const orphanLines = allLines.filter(l => !l.schemaId);
                if (orphanLines.length > 0 && this.schemas.length > 0) {
                    this.linesMap[this.schemas[0]._id] = [
                        ...(this.linesMap[this.schemas[0]._id] || []),
                        ...orphanLines
                    ];
                }

                // Seed 3 empty rows for schemas with no data (table/catalog modes)
                for (const s of this.schemas) {
                    if ((this.linesMap[s._id] || []).length === 0) {
                        const emptyRows = [];
                        for (let i = 0; i < 3; i++) {
                            const values = {};
                            for (const col of (s.columns || []).filter(c => c.visible !== false)) {
                                values[col.key] = '';
                            }
                            emptyRows.push({
                                _tempId: 'empty_' + s._id + '_' + i,
                                lineType: s.defaultLineType || s.lineTypes?.[0] || 'default',
                                values,
                                computed: {},
                                order: i
                            });
                        }
                        this.linesMap[s._id] = emptyRows;
                    }
                }

                // Recompute formulas for each schema (temporarily switch activeSchemaId for context)
                const savedSchemaId = this.activeSchemaId;
                for (const s of this.schemas) {
                    this.activeSchemaId = s._id;
                    (this.linesMap[s._id] || []).forEach(l => this.recomputeLine(l));
                    this.recomputeTotals();
                }

                // Restore active schema (keep current tab, fallback to first)
                const currentIsValid = this.schemas.some(s => s._id === savedSchemaId);
                this.activeSchemaId = currentIsValid ? savedSchemaId : (this.schemas[0]?._id || null);
                this.initSortable();
            } catch (e) {
                console.error('[LinesPanel] Load lines error:', e);
            }
        },

        selectSchema(schemaId) {
            this.activeSchemaId = schemaId;
        },

        // Get the primary relation column (always, ignoring visible/showWhen)
        getRelationCol() {
            if (!this.activeSchema) return null;
            return (this.activeSchema.columns || []).find(c => c.type === 'relation') || null;
        },

        // Get the relation label for a line (checks all relation columns across all schemas)
        getRelationLabel(line) {
            if (!line) return '';
            // First: check the active schema's relation column
            const relCol = this.getRelationCol();
            if (relCol && line.values[relCol.key + '_label']) {
                return line.values[relCol.key + '_label'];
            }
            // Fallback: check ALL schemas for a matching relation key with a label in the line
            for (const schema of this.schemas) {
                for (const col of (schema.columns || [])) {
                    if (col.type === 'relation' && line.values[col.key + '_label']) {
                        return line.values[col.key + '_label'];
                    }
                }
            }
            return '';
        },

        getVisibleColumnsForLine(line) {
            if (!this.activeSchema) return [];
            return (this.activeSchema.columns || [])
                .filter(c => c.visible !== false)
                .filter(c => {
                    // Show if no lineType restriction, or if matches current line's type
                    if (!c.showWhen || !c.showWhen.lineType || c.showWhen.lineType.length === 0) return true;
                    return c.showWhen.lineType.includes(line.lineType);
                })
                .sort((a, b) => (a.order || 0) - (b.order || 0));
        },

        addLine() {
            const schemaLines = this.linesMap[this.activeSchemaId] || [];
            schemaLines.push({
                _tempId: 'tmp_' + Date.now() + '_' + Math.random(),
                schemaId: this.activeSchemaId,
                lineType: this.newLineType,
                values: {},
                computed: {},
                order: schemaLines.length
            });
            this.linesMap[this.activeSchemaId] = [...schemaLines];
            this.debouncedSave();
        },

        // ── Add Lines Modal ──────────────────────────────────
        openAddModal() {
            // Sync lineType with current schema (in case of stale value)
            if (this.activeSchema) {
                const validTypes = this.activeSchema.lineTypes || [];
                if (validTypes.length > 0 && !validTypes.includes(this.newLineType)) {
                    this.newLineType = this.activeSchema.defaultLineType || validTypes[0];
                }
            }

            this.addModal.open = true;
            this.addModal.query = '';
            this.addModal.results = [];
            this.addModal.selected = [];
            this.addModal.loading = false;
            this.addModal._noTarget = false;
            // Reset manual add
            this.manualAdd.input = '';
            this.manualAdd.suggestions = [];
            this.manualAdd.open = false;
            this.$nextTick(() => {
                if (this.$refs.modalSearchInput) {
                    this.$refs.modalSearchInput.focus();
                }
            });
        },

        closeAddModal() {
            this.addModal.open = false;
            this.manualAdd.input = '';
            this.manualAdd.suggestions = [];
            this.manualAdd.open = false;
        },

        searchCatalog() {
            clearTimeout(this.addModal._searchTimer);
            const query = this.addModal.query.trim();
            if (!query) {
                this.addModal.results = [];
                return;
            }
            this.addModal._searchTimer = setTimeout(() => {
                this._doCatalogSearch(query);
            }, 250);
        },

        async _doCatalogSearch(query) {
            // Use schema-level sourceEntityId first, then fallback to relation column config
            const sourceEntity = this.activeSchema?.sourceEntityId;
            const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
            const targetEntity = sourceEntity || relCol?.config?.targetEntity;

            // CRITICAL: respect schema config — don't fallback to current entity
            if (!targetEntity) {
                console.warn('[LinesPanel] No source entity configured in schema');
                this.addModal.results = [];
                this.addModal.loading = false;
                this.addModal._noTarget = true;
                return;
            }
            this.addModal._noTarget = false;

            const searchFields = (relCol?.config?.searchFields || ['title']).join(',');

            this.addModal.loading = true;
            try {
                const url = `/account/${this.accountNumber}/api/catalog-search?entityId=${targetEntity}&q=${encodeURIComponent(query)}&searchFields=${searchFields}`;
                const res = await fetch(url, { credentials: 'include' });
                const data = await res.json();
                this.addModal.results = data.data || [];
            } catch (e) {
                console.error('[LinesPanel] Catalog search error:', e);
                this.addModal.results = [];
            } finally {
                this.addModal.loading = false;
            }
        },

        toggleCatalogItem(item) {
            const idx = this.addModal.selected.findIndex(s => s._id === item._id);
            if (idx >= 0) {
                // Deselect
                this.addModal.selected.splice(idx, 1);
            } else {
                // Select — apply default values from catalog
                const values = {};
                const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
                const cfArray = Array.isArray(item.customFields) ? item.customFields : [];
                if (relCol?.config?.applyDefaults && cfArray.length > 0) {
                    const cfMap = {};
                    cfArray.forEach(cf => {
                        const fieldId = (cf.field_id?._id || cf.field_id)?.toString();
                        if (fieldId) cfMap[fieldId] = cf.value;
                    });
                    for (const [targetKey, sourceExpr] of Object.entries(relCol.config.applyDefaults)) {
                        let val;
                        if (sourceExpr.startsWith('cf.')) {
                            val = cfMap[sourceExpr.substring(3)];
                        } else {
                            val = item[sourceExpr];
                        }
                        if (val !== undefined && val !== null) values[targetKey] = val;
                    }
                }
                // Set default qty to 1
                const qtyCol = (this.activeSchema?.columns || []).find(c => c.key === 'qty');
                if (qtyCol && !values.qty) values.qty = 1;

                this.addModal.selected.push({
                    _id: item._id,
                    label: item.label || item.title,
                    customFields: cfArray,
                    values: values
                });
            }
        },

        getEditableColumns() {
            if (!this.activeSchema) return [];
            return (this.activeSchema.columns || [])
                .filter(c => c.visible !== false && c.type !== 'formula' && c.type !== 'relation')
                .sort((a, b) => (a.order || 0) - (b.order || 0));
        },

        getSelectedItemValue(itemId, colKey) {
            const sel = this.addModal.selected.find(s => s._id === itemId);
            return sel ? sel.values[colKey] : undefined;
        },

        setSelectedItemValue(itemId, colKey, value) {
            const sel = this.addModal.selected.find(s => s._id === itemId);
            if (sel) sel.values[colKey] = value;
        },

        setSelectedItemDuration(itemId, colKey, prop, value) {
            const sel = this.addModal.selected.find(s => s._id === itemId);
            if (!sel) return;
            if (!sel.values[colKey] || typeof sel.values[colKey] !== 'object') {
                sel.values[colKey] = {};
            }
            sel.values[colKey][prop] = value;
        },

        addSelectedItemMultiselect(itemId, colKey, value) {
            if (!value) return;
            const sel = this.addModal.selected.find(s => s._id === itemId);
            if (!sel) return;
            if (!sel.values[colKey]) sel.values[colKey] = [];
            if (!sel.values[colKey].includes(value)) {
                sel.values[colKey].push(value);
            }
        },

        toggleSelectedItemMultiselect(itemId, colKey, value) {
            if (!value) return;
            const sel = this.addModal.selected.find(s => s._id === itemId);
            if (!sel) return;
            if (!sel.values[colKey]) sel.values[colKey] = [];
            const idx = sel.values[colKey].indexOf(value);
            if (idx >= 0) {
                sel.values[colKey].splice(idx, 1);
            } else {
                sel.values[colKey].push(value);
            }
        },

        confirmAddLines() {
            const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
            // Ensure lineType matches current schema (guards against stale value)
            const lineType = this.newLineType || this.activeSchema?.defaultLineType || this.activeSchema?.lineTypes?.[0] || 'product';

            for (const sel of this.addModal.selected) {
                const schemaLines = this.linesMap[this.activeSchemaId] || [];
                const newLine = {
                    _tempId: 'tmp_' + Date.now() + '_' + Math.random(),
                    schemaId: this.activeSchemaId,
                    lineType: lineType,
                    values: { ...sel.values },
                    computed: {},
                    order: schemaLines.length
                };
                // Set relation ID + label
                if (relCol) {
                    newLine.values[relCol.key] = sel._id;
                    newLine.values[relCol.key + '_label'] = sel.label;
                }
                this.recomputeLine(newLine);
                schemaLines.push(newLine);
            }
            this.linesMap[this.activeSchemaId] = [...(this.linesMap[this.activeSchemaId] || [])];

            this.recomputeTotals();
            this.debouncedSave();
            this.closeAddModal();
        },

        // ── Manual Add with autocomplete ──────────────────────
        searchManualAutocomplete() {
            clearTimeout(this.manualAdd._timer);
            const q = this.manualAdd.input.trim();
            if (!q) {
                this.manualAdd.suggestions = [];
                this.manualAdd.open = false;
                return;
            }
            this.manualAdd._timer = setTimeout(async () => {
                try {
                    const sourceEntity = this.activeSchema?.sourceEntityId;
                    const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
                    const targetEntity = sourceEntity || relCol?.config?.targetEntity;
                    if (!targetEntity) {
                        this.manualAdd.suggestions = [];
                        this.manualAdd.open = false;
                        return;
                    }
                    const url = `/account/${this.accountNumber}/api/document-lines/catalog-search?entityId=${targetEntity}&q=${encodeURIComponent(q)}`;
                    const res = await fetch(url, { credentials: 'include' });
                    const data = await res.json();
                    this.manualAdd.suggestions = (data.data || []).slice(0, 8);
                    this.manualAdd.open = this.manualAdd.suggestions.length > 0;
                } catch (e) {
                    console.error('[ManualAdd] autocomplete error:', e);
                    this.manualAdd.suggestions = [];
                    this.manualAdd.open = false;
                }
            }, 300);
        },

        selectManualSuggestion(sug) {
            const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
            const lineType = this.newLineType || this.activeSchema?.defaultLineType || this.activeSchema?.lineTypes?.[0] || 'product';
            const values = {};

            // Map custom fields from the suggestion
            if (sug.customFields && this.activeSchema) {
                for (const cf of sug.customFields) {
                    const matchCol = (this.activeSchema.columns || []).find(c => c.key === cf.key);
                    if (matchCol) {
                        values[cf.key] = cf.value;
                    }
                }
            }
            // Set default qty to 1
            const qtyCol = (this.activeSchema?.columns || []).find(c => c.key === 'qty');
            if (qtyCol && !values.qty) values.qty = 1;

            const schemaLines = this.linesMap[this.activeSchemaId] || [];
            const newLine = {
                _tempId: 'tmp_' + Date.now() + '_' + Math.random(),
                schemaId: this.activeSchemaId,
                lineType,
                values,
                computed: {},
                order: schemaLines.length
            };
            if (relCol) {
                newLine.values[relCol.key] = sug._id;
                newLine.values[relCol.key + '_label'] = sug.label || sug.title;
            }
            this.recomputeLine(newLine);
            schemaLines.push(newLine);
            this.linesMap[this.activeSchemaId] = [...schemaLines];
            this.recomputeTotals();
            this.debouncedSave();

            // Reset manual add
            this.manualAdd.input = '';
            this.manualAdd.suggestions = [];
            this.manualAdd.open = false;
        },

        addManualLine() {
            const label = this.manualAdd.input.trim();
            if (!label) return;

            const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
            const lineType = this.newLineType || this.activeSchema?.defaultLineType || this.activeSchema?.lineTypes?.[0] || 'product';
            const values = {};

            // Try to set the label in the first visible text column
            const firstTextCol = (this.activeSchema?.columns || []).find(c => 
                c.type === 'text' && c.visible !== false && c.type !== 'relation'
            );
            if (firstTextCol) values[firstTextCol.key] = label;
            if (relCol) values[relCol.key + '_label'] = label;

            const qtyCol = (this.activeSchema?.columns || []).find(c => c.key === 'qty');
            if (qtyCol && !values.qty) values.qty = 1;

            const schemaLines = this.linesMap[this.activeSchemaId] || [];
            const newLine = {
                _tempId: 'tmp_' + Date.now() + '_' + Math.random(),
                schemaId: this.activeSchemaId,
                lineType,
                values,
                computed: {},
                order: schemaLines.length
            };
            this.recomputeLine(newLine);
            schemaLines.push(newLine);
            this.linesMap[this.activeSchemaId] = [...schemaLines];
            this.recomputeTotals();
            this.debouncedSave();

            // Reset
            this.manualAdd.input = '';
            this.manualAdd.suggestions = [];
            this.manualAdd.open = false;
        },

        // ── Edit Line Modal ──────────────────────────────────
        getEditLines() {
            // Return the correct lines array for the current edit context
            const schemaId = this.editModal.schemaId || this.activeSchemaId;
            return this.linesMap[schemaId] || this.lines || [];
        },

        openEditLine(lineIdx, schemaId) {
            const sid = schemaId || this.activeSchemaId;
            const lines = this.linesMap[sid] || this.lines || [];
            const line = lines[lineIdx];
            if (!line) return;
            this.editModal.lineIdx = lineIdx;
            this.editModal.schemaId = sid;
            this.editModal.open = true;
        },

        closeEditModal() {
            this.editModal.open = false;
            this.editModal.lineIdx = -1;
            this.editModal.schemaId = null;
            this.editRelOpen = false;
            this.editRelSearch = '';
            this.editRelResults = [];
            this.editRelLoading = false;
        },

        saveEditLine() {
            const lines = this.getEditLines();
            const line = lines[this.editModal.lineIdx];
            if (line) {
                this.recomputeLine(line);
                this.recomputeTotals();
                this.debouncedSave();
            }
            this.closeEditModal();
        },

        async searchEditRelation() {
            const relCol = this.getRelationCol();
            if (!relCol) return;
            const entityId = relCol.config?.targetEntity;
            if (!entityId) { this.editRelResults = []; return; }
            this.editRelLoading = true;
            try {
                let url = `/account/${this.accountNumber}/record/api/search?entityId=${entityId}&page=1&limit=10`;
                if (this.editRelSearch) url += `&q=${encodeURIComponent(this.editRelSearch)}`;
                const res = await fetch(url, { credentials: 'include' });
                const data = await res.json();
                this.editRelResults = data.data || [];
            } catch (e) {
                console.error('Edit relation search failed:', e);
                this.editRelResults = [];
            } finally {
                this.editRelLoading = false;
            }
        },

        removeLine(idx) {
            const schemaLines = this.linesMap[this.activeSchemaId] || [];
            schemaLines.splice(idx, 1);
            this.linesMap[this.activeSchemaId] = [...schemaLines];
            this.recomputeTotals();
            this.debouncedSave();
        },


        // ── Formula evaluation ────────────────────────────
        recomputeLine(line) {
            if (!this.activeSchema) return;
            const formulaCols = (this.activeSchema.columns || []).filter(c => c.type === 'formula');
            const computed = {};
            for (const col of formulaCols) {
                if (col.config?.expression) {
                    const ctx = { ...line.values, ...computed };
                    computed[col.key] = this.evaluateFormula(col.config.expression, ctx);
                }
            }
            line.computed = computed;
            this.recomputeTotals();
        },

        evaluateFormula(expression, context) {
            try {
                const safeExpr = expression.replace(/[a-zA-Z_]\w*/g, (varName) => {
                    if (context.hasOwnProperty(varName)) {
                        const val = parseFloat(context[varName]);
                        return isNaN(val) ? '0' : val.toString();
                    }
                    return '0';
                });
                if (!/^[\d\s.+\-*/()]+$/.test(safeExpr)) return 0;
                return Function('"use strict"; return (' + safeExpr + ')')();
            } catch (e) {
                return 0;
            }
        },

        recomputeTotals() {
            const schema = this.activeSchema;
            if (!schema || !schema.totals) { this.totalsMap[this.activeSchemaId] = {}; return; }

            const schemaLines = this.linesMap[this.activeSchemaId] || [];
            const t = {};
            if (schema.totals.subtotalKey) {
                t.subtotal = schemaLines.reduce((sum, line) => {
                    const val = line.computed?.[schema.totals.subtotalKey] ??
                                line.values?.[schema.totals.subtotalKey] ?? 0;
                    return sum + (parseFloat(val) || 0);
                }, 0);
            }
            if (schema.totals.vatKey) {
                t.vat = schemaLines.reduce((sum, line) => {
                    const val = line.computed?.[schema.totals.vatKey] ??
                                line.values?.[schema.totals.vatKey] ?? 0;
                    return sum + (parseFloat(val) || 0);
                }, 0);
            }
            if (schema.totals.totalFormula) {
                t.total = this.evaluateFormula(schema.totals.totalFormula, t);
            }
            this.totalsMap[this.activeSchemaId] = t;
        },

        formatComputed(line, col) {
            const val = line.computed?.[col.key];
            if (val === undefined || val === null) return '—';
            if (col.type === 'formula' && (col.config?.currency || true)) {
                return this.formatMoney(val);
            }
            return val;
        },

        formatMoney(val) {
            if (val === undefined || val === null) return '—';
            return parseFloat(val).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' €';
        },

        // ── Select / multiselect helpers ───────────────────
        getSelectOptions(col, line) {
            // Hybrid: merge schema options with catalog-fetched options
            const opts = [];
            if (col.config?.options) {
                opts.push(...col.config.options);
            }
            // If line has _catalogOptions for this column, merge them
            if (line._catalogOptions?.[col.key]) {
                for (const co of line._catalogOptions[col.key]) {
                    if (!opts.find(o => o.value === co.value)) {
                        opts.push(co);
                    }
                }
            }
            return opts;
        },

        getOptionLabel(col, value) {
            const opts = col.config?.options || [];
            const found = opts.find(o => o.value === value);
            return found ? found.label : value;
        },

        addMultiselectValue(line, key, value) {
            if (!value) return;
            if (!line.values[key]) line.values[key] = [];
            if (!line.values[key].includes(value)) {
                line.values[key].push(value);
                this.debouncedSave();
            }
        },

        removeMultiselectValue(line, key, idx) {
            if (line.values[key]) {
                line.values[key].splice(idx, 1);
                this.debouncedSave();
            }
        },

        toggleMultiselectValue(line, key, value) {
            if (!value) return;
            if (!line.values[key]) line.values[key] = [];
            const idx = line.values[key].indexOf(value);
            if (idx >= 0) {
                line.values[key].splice(idx, 1);
            } else {
                line.values[key].push(value);
            }
            this.debouncedSave();
        },

        openMultiselectDropdown(lineIdx, colKey, event) {
            if (this.msDropdown.lineIdx === lineIdx && this.msDropdown.colKey === colKey && this.msDropdown.open) {
                this.closeMultiselectDropdown();
                return;
            }
            this.msDropdown.lineIdx = lineIdx;
            this.msDropdown.colKey = colKey;
            this.msDropdown.open = true;
            this.msDropdown.query = '';

            // Calculate fixed position from the trigger
            if (event) {
                const trigger = event.currentTarget || event.target;
                const rect = trigger.getBoundingClientRect();
                this.msDropdown.pos = {
                    top: rect.bottom + 4,
                    left: rect.left
                };
            }
        },

        closeMultiselectDropdown() {
            this.msDropdown.open = false;
            this.msDropdown.lineIdx = -1;
            this.msDropdown.colKey = '';
            this.msDropdown.query = '';
        },

        filterMsOptions(col) {
            const opts = col.config?.options || [];
            const q = (this.msDropdown.query || '').trim().toLowerCase();
            if (!q) return opts;
            return opts.filter(o => o.label.toLowerCase().includes(q));
        },

        getMultiselectOptLabel(col, value) {
            const opts = col.config?.options || [];
            const opt = opts.find(o => o.value === value);
            return opt?.label || value;
        },

        getMultiselectOptStyle(col, value) {
            const opts = col.config?.options || [];
            const opt = opts.find(o => o.value === value);
            if (opt?.bg) return { bg: opt.bg, text: opt.text || '#fff' };
            // Default color based on value hash for consistent coloring
            const colors = [
                { bg: '#dbeafe', text: '#1e40af' },
                { bg: '#dcfce7', text: '#166534' },
                { bg: '#fef3c7', text: '#92400e' },
                { bg: '#fce7f3', text: '#9d174d' },
                { bg: '#e0e7ff', text: '#3730a3' },
                { bg: '#fae8ff', text: '#86198f' },
                { bg: '#ecfdf5', text: '#065f46' },
            ];
            let hash = 0;
            for (let i = 0; i < String(value).length; i++) hash = (hash * 31 + String(value).charCodeAt(i)) % colors.length;
            return colors[Math.abs(hash) % colors.length];
        },



        // ── Duration label ────────────────────────────────
        durationLabel(unit) {
            const map = { day: 'jour(s)', week: 'sem.', month: 'mois', year: 'an(s)' };
            return map[unit] || unit;
        },

        // ── Relation search (autocomplete) ─────────────────
        openRelationSearch(lineIdx, colKey) {
            this.relationSearch.lineIdx = lineIdx;
            this.relationSearch.colKey = colKey;
            this.relationSearch.open = true;
            this.relationSearch.results = [];
            this.relationSearch.query = '';
        },

        closeRelationSearch() {
            this.relationSearch.open = false;
        },

        searchRelation(lineIdx, colKey, query) {
            this.relationSearch.query = query;
            this.relationSearch.lineIdx = lineIdx;
            this.relationSearch.colKey = colKey;
            this.relationSearch.open = true;

            clearTimeout(this.relationSearch.debounceTimer);
            this.relationSearch.debounceTimer = setTimeout(() => {
                this._doRelationSearch(colKey, query);
            }, 250);
        },

        async _doRelationSearch(colKey, query) {
            const col = (this.activeSchema?.columns || []).find(c => c.key === colKey);
            if (!col || !col.config?.targetEntity) return;

            this.relationSearch.loading = true;
            try {
                const searchFields = (col.config.searchFields || ['title']).join(',');
                const url = `/account/${this.accountNumber}/api/catalog-search?entityId=${col.config.targetEntity}&q=${encodeURIComponent(query)}&searchFields=${searchFields}`;
                const res = await fetch(url, { credentials: 'include' });
                const data = await res.json();
                this.relationSearch.results = data.data || [];
            } catch (e) {
                console.error('[LinesPanel] Relation search error:', e);
                this.relationSearch.results = [];
            } finally {
                this.relationSearch.loading = false;
            }
        },

        selectRelation(lineIdx, col, item) {
            const line = this.lines[lineIdx];
            if (!line) return;

            // Set the relation value (ID + label)
            line.values[col.key] = item._id;
            line.values[col.key + '_label'] = item.label || item.title;

            // Apply defaults from the catalog item (hybrid mode)
            if (col.config?.applyDefaults && item.customFields) {
                for (const [targetKey, sourceExpr] of Object.entries(col.config.applyDefaults)) {
                    let val;
                    if (sourceExpr.startsWith('cf.')) {
                        // Custom field reference
                        const cfId = sourceExpr.substring(3);
                        val = item.customFields[cfId];
                    } else {
                        val = item[sourceExpr];
                    }
                    if (val !== undefined && val !== null) {
                        line.values[targetKey] = val;

                        // HYBRID: If this is a select/multiselect column, also inject the
                        // value as an available option so it appears in the dropdown
                        const targetCol = (this.activeSchema?.columns || []).find(c => c.key === targetKey);
                        if (targetCol && (targetCol.type === 'select' || targetCol.type === 'multiselect')) {
                            if (!line._catalogOptions) line._catalogOptions = {};
                            if (!line._catalogOptions[targetKey]) line._catalogOptions[targetKey] = [];
                            if (typeof val === 'string' && !line._catalogOptions[targetKey].find(o => o.value === val)) {
                                line._catalogOptions[targetKey].push({ value: val, label: val });
                            } else if (Array.isArray(val)) {
                                val.forEach(v => {
                                    if (!line._catalogOptions[targetKey].find(o => o.value === v)) {
                                        line._catalogOptions[targetKey].push({ value: v, label: v });
                                    }
                                });
                            }
                        }
                    }
                }
            }

            this.recomputeLine(line);
            this.closeRelationSearch();
            this.debouncedSave();
        },

        // ── Debounced save ──────────────────────────────────
        debouncedSave() {
            const schemaId = this.activeSchemaId;
            if (!schemaId) return;
            clearTimeout(this._saveTimers[schemaId]);
            this._saveTimers[schemaId] = setTimeout(() => this.saveLinesForSchema(schemaId), 800);
        },

        async saveLinesForSchema(schemaId) {
            if (!this.recordId || !schemaId) return;
            this.savingSchemas[schemaId] = true;
            try {
                const schemaLines = this.linesMap[schemaId] || [];
                const payload = {
                    schemaId: schemaId,
                    lines: schemaLines.map((l, i) => ({
                        _id: l._id || undefined,
                        lineType: l.lineType,
                        values: l.values,
                        order: i
                    }))
                };

                const res = await fetch(`/account/${this.accountNumber}/api/document-lines/${this.recordId}/bulk`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.data) {
                    // Update lines with server IDs (for new lines)
                    const prevActive = this.activeSchemaId;
                    this.activeSchemaId = schemaId;
                    this.linesMap[schemaId] = data.data.map(l => ({
                        ...l,
                        values: l.values || {},
                        computed: l.computed || {},
                        _tempId: l._id
                    }));
                    // Recompute locally (formulas)
                    (this.linesMap[schemaId] || []).forEach(l => this.recomputeLine(l));
                    this.activeSchemaId = prevActive;
                }
                if (data.totals) {
                    this.totalsMap[schemaId] = data.totals;
                }
            } catch (e) {
                console.error('[LinesPanel] Save error for schema', schemaId, e);
            } finally {
                this.savingSchemas[schemaId] = false;
            }
        },

        // ═══ DataGrid V2: New Mode Methods ═══════════════════

        // Get schema input mode (defaults to 'catalog' for backward compat)
        getSchemaInputMode(schema) {
            return schema?.inputMode || 'catalog';
        },

        // Analytics view management
        setAnalyticsView(schemaId, viewId) {
            this.analyticsView[schemaId] = viewId;
        },

        getAnalyticsViewConfig(schema, viewId) {
            if (!schema?.analyticsConfig?.views) return null;
            return schema.analyticsConfig.views.find(v => v.id === viewId) || null;
        },

        // Compute statistics for analytics
        computeStat(schemaId, column, aggregation) {
            const lines = this.linesMap[schemaId] || [];
            const values = lines
                .map(l => parseFloat(l.values?.[column]))
                .filter(v => !isNaN(v));

            if (values.length === 0) return '—';

            switch (aggregation) {
                case 'last': return values[0]; // Assuming sorted desc
                case 'first': return values[values.length - 1];
                case 'avg': return (values.reduce((a, b) => a + b, 0) / values.length).toFixed(1);
                case 'min': return Math.min(...values);
                case 'max': return Math.max(...values);
                case 'sum': return values.reduce((a, b) => a + b, 0).toFixed(1);
                case 'count': return values.length;
                case 'delta': {
                    if (values.length < 2) return '—';
                    const delta = values[0] - values[values.length - 1];
                    return (delta >= 0 ? '+' : '') + delta.toFixed(1);
                }
                default: return values[0];
            }
        },

        // Format date for form entries
        formatEntryDate(line, schema) {
            const dateCol = schema?.timeseriesConfig?.dateColumn || 'date';
            const dateVal = line.values?.[dateCol];
            if (!dateVal) return 'Sans date';
            try {
                const d = new Date(dateVal);
                return d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
            } catch {
                return dateVal;
            }
        },

        // Format cell value for display
        formatCellValue(value, col) {
            if (value === undefined || value === null || value === '') return '—';
            if (col.type === 'number' || col.type === 'money') {
                const num = parseFloat(value);
                if (isNaN(num)) return value;
                const unit = col.config?.unit || '';
                return num + (unit ? ' ' + unit : '');
            }
            if (col.type === 'duration' && typeof value === 'object') {
                return (value.value || 0) + ' ' + this.durationLabel(value.unit || 'day');
            }
            if (col.type === 'dosage' && typeof value === 'object') {
                return (value.value || 0) + ' ' + (value.unit || 'mg');
            }
            // Resolve select → show label instead of value
            if (col.type === 'select') {
                const opt = (col.config?.options || []).find(o => o.value === value);
                return opt ? opt.label : value;
            }
            // Resolve multiselect → show labels comma-separated
            if (col.type === 'multiselect' && Array.isArray(value)) {
                return value.map(v => {
                    const opt = (col.config?.options || []).find(o => o.value === v);
                    return opt ? opt.label : v;
                }).join(', ') || '—';
            }
            // Resolve relation → show stored label
            if (col.type === 'relation') {
                // The label is stored under key + '_label' in the line values 
                // but we only get the value here, so check if it looks like an ObjectId
                if (typeof value === 'string' && /^[a-f0-9]{24}$/i.test(value)) {
                    return '🔗 ' + value.slice(-6); // Show abbreviated ID as fallback
                }
                return value;
            }
            return value;
        },

        // Format relation value — tries to use the stored _label from the line values
        formatRelationValue(line, col) {
            const labelKey = col.key + '_label';
            if (line.values?.[labelKey]) return line.values[labelKey];
            const val = line.values?.[col.key];
            if (!val) return '—';
            if (typeof val === 'string' && /^[a-f0-9]{24}$/i.test(val)) return '🔗 ' + val.slice(-6);
            return val;
        },

        // Normal range indicator (✅ ⬆️ ⬇️)
        getNormalRangeIndicator(value, col) {
            if (!col.config?.normalRange || value === undefined || value === null || value === '') return '';
            const num = parseFloat(value);
            if (isNaN(num)) return '';
            const { min, max } = col.config.normalRange;
            if (min !== undefined && num < min) return '<span class="dg-indicator low">⬇️</span>';
            if (max !== undefined && num > max) return '<span class="dg-indicator high">⬆️</span>';
            return '<span class="dg-indicator normal">✅</span>';
        },

        // Get number of form columns based on schema config
        getFormColumns(schema) {
            // Use template formLayout or count non-date visible columns (max 4)
            const visibleCols = (schema.columns || []).filter(c => c.visible !== false && c.type !== 'date');
            return Math.min(visibleCols.length, 4);
        },

        // Open form add panel with auto-date
        openFormAdd(schema) {
            this.formAddOpen[schema._id] = true;
            // Auto-fill date if timeseries
            if (schema.dataMode === 'timeseries' || schema.inputMode === 'form') {
                const dateCol = schema.timeseriesConfig?.dateColumn || 'date';
                const hasDCol = (schema.columns || []).some(c => c.key === dateCol && c.type === 'date');
                if (hasDCol) {
                    this.formAddValues[schema._id + '_' + dateCol] = new Date().toISOString().split('T')[0];
                }
            }
        },

        // Submit form entry (create a new line from form values)
        async submitFormEntry(schema) {
            const values = {};
            for (const col of (schema.columns || []).filter(c => c.visible !== false)) {
                const key = schema._id + '_' + col.key;
                let val = this.formAddValues[key];
                if ((col.type === 'number' || col.type === 'money') && val) {
                    val = parseFloat(val) || 0;
                }
                // Preserve arrays for multiselect (don't convert [] to '')
                if (col.type === 'multiselect') {
                    values[col.key] = Array.isArray(val) ? val : (val ? [val] : []);
                } else if (col.type === 'relation') {
                    // Save both the ID and the label for relations
                    values[col.key] = val || '';
                    const labelKey = key + '_label';
                    if (this.formAddValues[labelKey]) {
                        values[col.key + '_label'] = this.formAddValues[labelKey];
                    }
                } else {
                    values[col.key] = val || '';
                }
            }

            // Add the line
            this.activeSchemaId = schema._id;
            const newLine = {
                _tempId: 'temp_' + Date.now(),
                lineType: schema.defaultLineType || 'default',
                values,
                computed: {},
                order: (this.linesMap[schema._id] || []).length
            };

            // For timeseries, insert in sorted order (desc = newest first)
            if (schema.dataMode === 'timeseries') {
                const dateCol = schema.timeseriesConfig?.dateColumn || 'date';
                const sortDir = schema.timeseriesConfig?.sortDirection || 'desc';
                const lines = [...(this.linesMap[schema._id] || []), newLine];
                lines.sort((a, b) => {
                    const da = new Date(a.values[dateCol] || 0).getTime();
                    const db = new Date(b.values[dateCol] || 0).getTime();
                    return sortDir === 'desc' ? db - da : da - db;
                });
                this.linesMap[schema._id] = lines;
            } else {
                if (!this.linesMap[schema._id]) this.linesMap[schema._id] = [];
                this.linesMap[schema._id].push(newLine);
            }

            // Clear form
            for (const col of (schema.columns || []).filter(c => c.visible !== false)) {
                this.formAddValues[schema._id + '_' + col.key] = '';
                // Also clear relation label and dropdown states
                if (col.type === 'relation') {
                    this.formAddValues[schema._id + '_' + col.key + '_label'] = '';
                }
            }
            this.formAddOpen[schema._id] = false;

            // Save (activeSchemaId was already set above)
            this.debouncedSave();
        },

        // Add inline option to a select/multiselect column (no config needed)
        addInlineOption(col, value) {
            if (!value || !value.trim()) return;
            const val = value.trim();
            const slug = val.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');
            if (!col.config) col.config = {};
            if (!col.config.options) col.config.options = [];
            // Check duplicate
            if (col.config.options.some(o => o.value === slug || o.label.toLowerCase() === val.toLowerCase())) return;
            col.config.options.push({ value: slug, label: val });
            // Also save the column config back to the schema via API
            this.saveInlineOptionToSchema(col);
        },

        // Remove an inline option from a select/multiselect column (2-step: confirm then delete)
        _pendingDeleteOpt: null,
        _pendingDeleteTimer: null,

        removeInlineOption(schema, col, optValue) {
            // Step 1: first click → mark as pending (show confirmation)
            if (this._pendingDeleteOpt !== optValue) {
                this._pendingDeleteOpt = optValue;
                clearTimeout(this._pendingDeleteTimer);
                this._pendingDeleteTimer = setTimeout(() => { this._pendingDeleteOpt = null; }, 3000);
                return;
            }
            // Step 2: second click → actually delete
            clearTimeout(this._pendingDeleteTimer);
            this._pendingDeleteOpt = null;

            if (!col.config?.options) return;
            col.config.options = col.config.options.filter(o => o.value !== optValue);
            // If this option was selected, clear it
            const key = schema._id + '_' + col.key;
            if (col.type === 'multiselect') {
                const arr = this.formAddValues[key] || [];
                this.formAddValues[key] = arr.filter(v => v !== optValue);
            } else if (this.formAddValues[key] === optValue) {
                this.formAddValues[key] = '';
            }
            // Also remove from any existing lines that use this value
            (this.linesMap[schema._id] || []).forEach(line => {
                if (col.type === 'multiselect' && Array.isArray(line.values[col.key])) {
                    line.values[col.key] = line.values[col.key].filter(v => v !== optValue);
                } else if (line.values[col.key] === optValue) {
                    line.values[col.key] = '';
                }
            });
            // Persist to schema
            this.saveInlineOptionToSchema(col);
        },

        // Save updated column options to the schema (async, non-blocking)
        async saveInlineOptionToSchema(col) {
            const schema = this.schemas.find(s => s._id === this.activeSchemaId);
            if (!schema) return;
            const schemaCol = (schema.columns || []).find(c => c.key === col.key);
            if (schemaCol) {
                schemaCol.config = { ...schemaCol.config, options: col.config.options };
            }
            try {
                await fetch(`/account/${this.accountNumber}/api/line-schemas/${schema._id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ columns: schema.columns })
                });
            } catch (e) { console.error('Failed to save inline option:', e); }
        },

        // Toggle multiselect value in form add
        toggleFormAddMultiselect(schemaId, colKey, optValue) {
            if (!optValue) return; // Guard against empty values
            const key = schemaId + '_' + colKey;
            if (!this.formAddValues[key]) this.formAddValues[key] = [];
            const arr = [...this.formAddValues[key]];
            const idx = arr.indexOf(optValue);
            if (idx >= 0) arr.splice(idx, 1);
            else arr.push(optValue);
            this.formAddValues[key] = arr;
        },

        // Search relation records via API (for form add)
        async searchFormRelation(schemaId, col) {
            const key = schemaId + '_' + col.key;
            const query = this.formRelSearch[key] || '';
            const entityId = col.config?.targetEntity;
            if (!entityId) {
                this.formRelResults[key] = [];
                return;
            }
            this.formRelLoading[key] = true;
            try {
                let url = `/account/${this.accountNumber}/record/api/search?entityId=${entityId}&page=1&limit=10`;
                if (query) url += `&q=${encodeURIComponent(query)}`;
                const res = await fetch(url, { credentials: 'include' });
                const data = await res.json();
                this.formRelResults[key] = data.data || [];
            } catch (e) {
                console.error('Relation search failed:', e);
                this.formRelResults[key] = [];
            } finally {
                this.formRelLoading[key] = false;
            }
        },

        // Create new option for select/multiselect (ClickUp-style "+ Créer")
        formSelCreateOption(schema, col) {
            const key = schema._id + '_' + col.key;
            const label = (this.formSelSearch[key] || '').trim();
            if (!label) return;
            const slug = label.toLowerCase().replace(/[^a-z0-9\u00e0-\u00ff]+/g, '_').replace(/^_|_$/g, '');
            if (!col.config) col.config = {};
            if (!col.config.options) col.config.options = [];
            // Check duplicate
            if (col.config.options.some(o => o.value === slug || o.label.toLowerCase() === label.toLowerCase())) return;
            col.config.options.push({ value: slug, label: label });
            // For multiselect, auto-toggle the new option
            if (col.type === 'multiselect') {
                this.toggleFormAddMultiselect(schema._id, col.key, slug);
            }
            // For single select, auto-select the new option
            if (col.type === 'select') {
                this.formAddValues[key] = slug;
                this.formSelOpen[key] = false;
            }
            // Clear search
            this.formSelSearch[key] = '';
            // Save schema options to backend
            this.activeSchemaId = schema._id;
            this.saveInlineOptionToSchema(col);
        },

        // Load templates for schemas (includes record-specific + linked parent presets)
        async loadTemplates() {
            try {
                const schemaIds = this.schemas.map(s => s._id).join(',');
                if (!schemaIds) return;
                let url = `/account/${this.accountNumber}/api/grid-templates?schemaId=${schemaIds}`;
                // Include current record + all linked records (patient, etc.)
                const allRecordIds = [this.recordId];
                for (const lr of this.linkedRecords) {
                    if (lr.recordId && !allRecordIds.includes(lr.recordId)) {
                        allRecordIds.push(lr.recordId);
                    }
                }
                if (allRecordIds.length > 0) {
                    url += `&includeRecord=${allRecordIds.join(',')}`;
                }
                const res = await fetch(url, {
                    credentials: 'include'
                });
                const data = await res.json();
                this.gridTemplates = data.templates || [];
            } catch (e) {
                console.error('[DataGrid] Load templates error:', e);
            }
        },

        // Get templates for a specific schema
        getTemplatesForSchema(schemaId) {
            const sid = schemaId?.toString();
            return this.gridTemplates.filter(t => {
                // Handle populated object or raw ObjectId
                const tSchemaId = (t.schemaId?._id || t.schemaId)?.toString();
                return tSchemaId === sid;
            });
        },

        // Apply a template to the current record
        async applyTemplate(template) {
            try {
                const res = await fetch(
                    `/account/${this.accountNumber}/api/grid-templates/${template._id}/apply/${this.recordId}`,
                    { method: 'POST', credentials: 'include' }
                );
                const data = await res.json();
                if (data.success && data.lines) {
                    // Reload lines for this schema
                    const schemaId = (template.schemaId?._id || template.schemaId)?.toString();
                    if (schemaId) {
                        this.activeSchemaId = schemaId;
                        await this.loadLines();
                    }
                }
            } catch (e) {
                console.error('[DataGrid] Apply template error:', e);
            }
        },

        // ═══ PRESETS SYSTEM ═══════════════════════════════════════════

        // Toggle preset dropdown
        togglePresetDropdown(schemaId) {
            const isOpen = this.presetDropdown[schemaId];
            // Close all dropdowns first
            for (const s of this.schemas) {
                this.presetDropdown[s._id] = false;
            }
            this.presetDropdown[schemaId] = !isOpen;
        },

        // Get record-specific presets for a schema (current record + linked parents)
        getRecordPresets(schemaId) {
            const sid = schemaId?.toString();
            const rid = this.recordId?.toString();
            // Include IDs of current record + all linked parent records
            const allIds = new Set();
            if (rid) allIds.add(rid);
            for (const lr of this.linkedRecords) {
                if (lr.recordId) allIds.add(lr.recordId.toString());
            }
            if (allIds.size === 0) return [];
            return this.gridTemplates.filter(t => {
                const tSchemaId = (t.schemaId?._id || t.schemaId)?.toString();
                const tRecordId = t.recordId?.toString();
                return tSchemaId === sid && tRecordId && allIds.has(tRecordId);
            });
        },

        // Get global/workspace presets for a schema (not record-specific)
        getGlobalPresets(schemaId) {
            const sid = schemaId?.toString();
            return this.gridTemplates.filter(t => {
                const tSchemaId = (t.schemaId?._id || t.schemaId)?.toString();
                return tSchemaId === sid && !t.recordId;
            });
        },

        // Open save preset modal
        openSavePresetModal(schemaId) {
            this.activeSchemaId = schemaId;
            this.savePresetModal = {
                open: true,
                name: '',
                scope: this.linkedRecords.length > 0 ? 'linked' : 'workspace',
                schemaId: schemaId,
                saving: false,
                linkedRecordId: this.linkedRecords.length > 0 ? this.linkedRecords[0].recordId : null,
                linkedRecordLabel: this.linkedRecords.length > 0 ? this.linkedRecords[0].recordTitle : '',
                linkedRelationLabel: this.linkedRecords.length > 0 ? this.linkedRecords[0].relationLabel : ''
            };
            this.$nextTick(() => {
                if (this.$refs.presetNameInput) {
                    this.$refs.presetNameInput.focus();
                }
            });
        },

        // Confirm save preset
        async confirmSavePreset() {
            const { name, scope, schemaId, linkedRecordId, linkedRecordLabel, linkedRelationLabel } = this.savePresetModal;
            if (!name.trim()) return;

            this.savePresetModal.saving = true;
            try {
                // Determine recordId based on scope:
                // - 'workspace': no recordId (global)
                // - 'linked': parent record ID (e.g., patient) → visible on all consultations of this patient
                // - 'record': current record ID → only on this specific record
                let targetRecordId = undefined;
                let targetRecordLabel = '';
                let backendScope = scope === 'linked' ? 'record' : scope;

                if (scope === 'linked' && linkedRecordId) {
                    targetRecordId = linkedRecordId;
                    targetRecordLabel = `${linkedRelationLabel}: ${linkedRecordLabel}`;
                } else if (scope === 'record') {
                    targetRecordId = this.recordId;
                    targetRecordLabel = document.title || '';
                }

                const payload = {
                    name: name.trim(),
                    schemaId,
                    documentId: this.recordId,
                    scope: backendScope,
                    recordId: targetRecordId,
                    recordLabel: targetRecordLabel
                };

                const res = await fetch(`/account/${this.accountNumber}/api/grid-templates/save-from-record`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.success && data.template) {
                    // Add to local templates list
                    this.gridTemplates.push(data.template);
                    this.savePresetModal.open = false;
                    console.log('[Presets] Saved preset:', data.template.name);
                } else {
                    console.error('[Presets] Save error:', data.error);
                    alert('Erreur: ' + (data.error || 'Impossible de sauvegarder'));
                }
            } catch (e) {
                console.error('[Presets] Save error:', e);
                alert('Erreur réseau lors de la sauvegarde');
            } finally {
                this.savePresetModal.saving = false;
            }
        },

        // Delete a preset
        async deletePreset(presetId) {
            if (!confirm('Supprimer ce preset ?')) return;
            try {
                const res = await fetch(`/account/${this.accountNumber}/api/grid-templates/${presetId}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const data = await res.json();
                if (data.success) {
                    // Remove from local list
                    this.gridTemplates = this.gridTemplates.filter(t => t._id !== presetId);
                    console.log('[Presets] Deleted preset:', presetId);
                }
            } catch (e) {
                console.error('[Presets] Delete error:', e);
            }
        },

        // Get a human-readable label for a line (for preview)
        getLinePreviewLabel(line, schemaId) {
            const schema = this.schemas.find(s => s._id === schemaId);
            if (!schema || !line) return '—';

            // Try relation label first
            const relCol = (schema.columns || []).find(c => c.type === 'relation');
            if (relCol && line.values[relCol.key + '_label']) {
                return line.values[relCol.key + '_label'];
            }

            // Try first visible text column
            const textCol = (schema.columns || []).find(c =>
                c.type === 'text' && c.visible !== false
            );
            if (textCol && line.values[textCol.key]) {
                return line.values[textCol.key];
            }

            // Fallback: first non-empty value
            for (const col of (schema.columns || []).filter(c => c.visible !== false)) {
                const val = line.values[col.key];
                if (val && typeof val === 'string' && val.trim()) return val;
                if (val && typeof val === 'number') return `${col.label}: ${val}`;
            }

            return `Ligne ${(line.order || 0) + 1}`;
        },

        // ── Sortable init ───────────────────────────────────
        initSortable() {
            this.$nextTick(() => {
                if (typeof Sortable === 'undefined') return;
                // Init sortable for each schema's tbody
                for (const s of this.schemas) {
                    const tbody = this.$el.querySelector(`tbody[data-schema-id="${s._id}"]`);
                    if (tbody) {
                        Sortable.create(tbody, {
                            handle: '.lp-drag-handle',
                            animation: 150,
                            ghostClass: 'sortable-ghost',
                            chosenClass: 'sortable-chosen',
                            onEnd: (evt) => {
                                const schemaId = s._id;
                                const items = [...(this.linesMap[schemaId] || [])];
                                const [moved] = items.splice(evt.oldIndex, 1);
                                items.splice(evt.newIndex, 0, moved);
                                this.linesMap[schemaId] = items;
                                this.activeSchemaId = schemaId;
                                this.debouncedSave();
                            }
                        });
                    }
                }
            });
        }
    }));
});
</script>
