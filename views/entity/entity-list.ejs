              </button>
              <button type="button" @click="step2Tab = 'relations'; loadAllEntities()" 
                      class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
                      :class="step2Tab === 'relations' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:text-gray-700'">
                <iconify-icon icon="solar:link-round-bold-duotone" width="16" class="mr-1"></iconify-icon>
                Relations
                <span x-show="relations.length > 0" class="ml-1 px-1.5 py-0.5 text-xs bg-primary/20 text-primary rounded-full" x-text="relations.length"></span>
              </button>
            </div>

            <!-- TAB: Champs -->
            <div x-show="step2Tab === 'fields'">
              <!-- Search -->
              <div class="relative mb-4">
                <input type="text" x-model="fieldSearch" placeholder="Rechercher un champ..." class="form-input w-full pl-9 text-sm">
                <iconify-icon icon="solar:magnifer-linear" class="absolute left-3 top-2.5 text-gray-400" width="16"></iconify-icon>
              </div>

              <!-- Champs sélectionnés -->
              <div x-show="selectedFields.length > 0" class="mb-4 p-3 bg-primary/5 rounded-lg border border-primary/20">
                <div class="text-xs font-semibold text-primary mb-2 flex items-center gap-1">
                  <iconify-icon icon="solar:check-circle-bold" width="14"></iconify-icon>
                  <span x-text="selectedFields.length + ' champ(s) sélectionné(s)'"></span>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  <template x-for="(field, idx) in selectedFields" :key="field._id">
                    <div class="inline-flex items-center gap-1 px-2 py-1 bg-white dark:bg-gray-700 rounded-full text-xs border shadow-sm">
                      <iconify-icon :icon="field.icon" width="14" class="text-primary"></iconify-icon>
                      <span x-text="field.label"></span>
                      <button type="button" @click="selectedFields.splice(idx, 1)" class="text-gray-400 hover:text-red-500 ml-0.5">
                        <iconify-icon icon="solar:close-circle-bold" width="14"></iconify-icon>
                      </button>
                    </div>
                  </template>
                </div>
              </div>

              <!-- Catégories de champs -->
              <div class="space-y-2 max-h-80 overflow-y-auto pr-1">
                <template x-for="category in filteredCategories" :key="category.key">
                  <div class="border dark:border-gray-700 rounded-lg overflow-hidden">
                    <button type="button" 
                            @click="openCategories[category.key] = !openCategories[category.key]"
                            class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 font-medium text-sm flex items-center justify-between hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                      <div class="flex items-center gap-2">
                        <iconify-icon :icon="getCategoryIcon(category.key)" width="16" class="text-primary"></iconify-icon>
                        <span x-text="category.label"></span>
                        <span class="text-gray-400 text-xs" x-text="'(' + category.fields.length + ')'"></span>
                      </div>
                      <iconify-icon icon="solar:alt-arrow-down-linear" width="14" 
                                    :class="openCategories[category.key] && 'rotate-180'" 
                                    style="transition: transform 0.2s"></iconify-icon>
                    </button>
                    <div x-show="openCategories[category.key]" x-collapse class="divide-y dark:divide-gray-700">
                      <template x-for="field in category.fields" :key="field._id">
                        <div class="px-3 py-2 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors"
                             :class="isFieldSelected(field._id) && 'bg-primary/5'">
                          <div class="flex items-center gap-2 flex-1 min-w-0">
                            <iconify-icon :icon="field.icon" width="18" class="text-gray-500 shrink-0"></iconify-icon>
                            <div class="min-w-0">
                              <div class="text-sm font-medium truncate" x-text="field.label"></div>
                              <div class="text-xs text-gray-400 truncate" x-text="field.description" x-show="field.description"></div>
                            </div>
                          </div>
                          <button type="button" 
                                  @click="toggleField(field)"
                                  class="shrink-0 px-2 py-1 rounded text-xs font-medium transition-colors"
                                  :class="isFieldSelected(field._id) ? 'bg-red-100 text-red-600 hover:bg-red-200' : 'bg-primary/10 text-primary hover:bg-primary/20'">
                            <span x-text="isFieldSelected(field._id) ? 'Retirer' : 'Ajouter'"></span>
                          </button>
                        </div>
                      </template>
                    </div>
                  </div>
                </template>
                
                <div x-show="filteredCategories.length === 0" class="text-center py-8 text-gray-400">
                  <iconify-icon icon="solar:box-broken" width="40" class="mb-2"></iconify-icon>
                  <p class="text-sm">Aucun champ trouvé</p>
                </div>
              </div>
            </div>

            <!-- TAB: Relations -->
            <div x-show="step2Tab === 'relations'">
              <!-- Relations list -->
              <div class="space-y-3 max-h-[400px] overflow-y-auto pr-1">
                <template x-for="(relation, rIdx) in relations" :key="relation.key">
                  <div class="border dark:border-gray-700 rounded-lg p-3 space-y-3 bg-gray-50/50 dark:bg-gray-800/50">
                    <!-- Header with delete -->
                    <div class="flex items-center justify-between">
                      <span class="text-sm font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                        <iconify-icon icon="solar:link-round-bold-duotone" width="16" class="text-primary"></iconify-icon>
                        <span x-text="relation.label || ('Relation ' + (rIdx + 1))"></span>
                      </span>
                      <button type="button" @click="removeRelation(rIdx)" class="text-gray-400 hover:text-red-500 transition-colors">
                        <iconify-icon icon="solar:trash-bin-trash-bold" width="16"></iconify-icon>
                      </button>
                    </div>

                    <!-- Entity picker -->
                    <div>
                      <label class="text-xs font-medium text-gray-500 mb-1 block">Entité cible</label>
                      <select x-model="relation.targetEntity" @change="onRelationEntityChange(relation)" class="form-select w-full text-sm">
                        <option value="">Sélectionner une entité...</option>
                        <template x-for="ent in allEntities" :key="ent._id">
                          <option :value="ent._id" x-text="ent.name"></option>
                        </template>
                      </select>
                    </div>

                    <!-- Label -->
                    <div class="grid grid-cols-2 gap-2">
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Label</label>
                        <input type="text" x-model="relation.label" placeholder="Ex: Patient" class="form-input w-full text-sm">
                      </div>
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Label inverse</label>
                        <input type="text" x-model="relation.inverseLabel" placeholder="Ex: Consultations" class="form-input w-full text-sm">
                      </div>
                    </div>

                    <!-- Cardinality -->
                    <div>
                      <label class="text-xs font-medium text-gray-500 mb-1 block">Cardinalité</label>
                      <div class="flex gap-1">
                        <template x-for="card in [{v:'one-to-one',l:'1:1'},{v:'one-to-many',l:'1:N'},{v:'many-to-many',l:'N:N'}]" :key="card.v">
                          <button type="button" @click="relation.cardinality = card.v"
                                  class="flex-1 px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors"
                                  :class="relation.cardinality === card.v 
                                    ? 'bg-primary text-white border-primary' 
                                    : 'bg-white dark:bg-gray-700 border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:border-primary/50'">
                            <span x-text="card.l"></span>
                          </button>
                        </template>
                      </div>
                    </div>

                    <!-- Input Mode + Storage -->
                    <div class="grid grid-cols-2 gap-2">
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Mode d'encodage</label>
                        <select x-model="relation.inputMode" class="form-select w-full text-sm">
                          <option value="autocomplete">Autocomplete</option>
                          <option value="select">Select</option>
                          <option value="modal-picker">Modal Picker</option>
                        </select>
                      </div>
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Stockage</label>
                        <select x-model="relation.storage" class="form-select w-full text-sm">
                          <option value="on-source">Sur la source</option>
                          <option value="on-target">Sur la cible</option>
                          <option value="join">Table de jointure</option>
                        </select>
                      </div>
                    </div>

                    <!-- Search fields (shown after entity selected) -->
                    <template x-if="relation._targetFields && relation._targetFields.length > 0">
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Champs de recherche</label>
                        <div class="flex flex-wrap gap-1.5">
                          <template x-for="field in relation._targetFields" :key="'s-'+relation.key+'-'+field.id">
                            <button type="button" @click="toggleSearchField(relation, field.id)"
                                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium border transition-colors"
                                    :class="relation.searchFields.includes(field.id) 
                                      ? 'bg-info/10 border-info/30 text-info' 
                                      : 'bg-gray-100 dark:bg-gray-700 border-gray-300 dark:border-gray-600 text-gray-500 hover:border-info/50'">
                              <iconify-icon :icon="field.icon" width="12"></iconify-icon>
                              <span x-text="field.label"></span>
                            </button>
                          </template>
                        </div>
                      </div>
                    </template>

                    <!-- Display fields -->
                    <template x-if="relation._targetFields && relation._targetFields.length > 0">
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Champs à afficher</label>
                        <div class="flex flex-wrap gap-1.5">
                          <template x-for="field in relation._targetFields" :key="'d-'+relation.key+'-'+field.id">
                            <button type="button" @click="toggleDisplayField(relation, field.id)"
                                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium border transition-colors"
                                    :class="relation.displayFields.includes(field.id) 
                                      ? 'bg-success/10 border-success/30 text-success' 
                                      : 'bg-gray-100 dark:bg-gray-700 border-gray-300 dark:border-gray-600 text-gray-500 hover:border-success/50'">
                              <iconify-icon :icon="field.icon" width="12"></iconify-icon>
                              <span x-text="field.label"></span>
                            </button>
                          </template>
                        </div>
                      </div>
                    </template>

                    <!-- Toggles row -->
                    <div class="flex items-center gap-4 pt-2 border-t dark:border-gray-700">
                      <label class="flex items-center gap-2 cursor-pointer text-xs text-gray-500">
                        <input type="checkbox" x-model="relation.bidirectional" class="form-checkbox rounded text-primary">
                        Bidirectionnelle
                      </label>
                      <label class="flex items-center gap-2 cursor-pointer text-xs text-gray-500">
                        <input type="checkbox" x-model="relation.required" class="form-checkbox rounded text-primary">
                        Requis
                      </label>
                    </div>
                  </div>
                </template>
              </div>

              <!-- Add relation button -->
              <button type="button" @click="addRelation()" 
                      class="w-full mt-3 flex items-center justify-center gap-2 py-2.5 text-sm text-primary hover:text-primary/80 border border-dashed border-primary/30 rounded-lg hover:bg-primary/5 transition-colors">
                <iconify-icon icon="solar:add-circle-linear" width="16"></iconify-icon>
                <span>Ajouter une relation</span>
              </button>

              <!-- Empty state -->
              <div x-show="relations.length === 0" class="text-center py-6 text-gray-400">
                <iconify-icon icon="solar:link-broken-bold-duotone" width="40" class="mb-2"></iconify-icon>
                <p class="text-sm">Aucune relation configurée</p>
                <p class="text-xs mt-1">Cliquez sur le bouton ci-dessus pour lier cette collection à d'autres</p>
              </div>
            </div>

          </div>
        </form>
      </div>

      <!-- Footer - Navigation -->
      <div class="p-5 border-t dark:border-gray-700 flex gap-3 flex-shrink-0">
        <!-- Step 1 -->
        <template x-if="step === 1">
          <button type="button" @click="if(newCollection.name) { loadSystemFields(); step = 2; }" 
                  class="btn btn-primary w-full" :disabled="!newCollection.name">
            Suivant
            <iconify-icon icon="solar:arrow-right-linear" width="18" class="ml-1"></iconify-icon>
          </button>
        </template>
        
        <!-- Step 2 -->
        <template x-if="step === 2">
          <div class="flex gap-3 w-full">
            <button type="button" @click="step = 1" class="btn btn-outline-dark flex-1">
              <iconify-icon icon="solar:arrow-left-linear" width="18" class="mr-1"></iconify-icon>
              Retour
            </button>
            <button type="button" @click="createCollection()" class="btn btn-primary flex-1" :disabled="isSubmitting">
              <span x-show="isSubmitting" class="animate-spin border-2 border-white border-l-transparent rounded-full w-4 h-4 mr-2 inline-block"></span>
              Créer la collection
            </button>
          </div>
        </template>
      </div>
    </div>
  </div>

  <!-- Modal Modifier Collection - Wizard 2 Étapes -->
  <div x-show="showEditModal" x-transition.opacity.duration.300ms 
       x-effect="document.body.classList.toggle('overflow-hidden', showEditModal)"
       class="fixed inset-0 z-[999] flex items-center justify-center bg-black/50 backdrop-blur-sm p-4" 
       @click.self="showEditModal = false" @keydown.escape.window="showEditModal = false">
    <div class="panel border-0 rounded-lg overflow-hidden w-full max-w-lg bg-white dark:bg-[#1b2e4b] shadow-xl flex flex-col" 
         style="max-height: calc(100vh - 2rem);"
         x-show="showEditModal" x-transition.scale.origin.center>
      
      <!-- Header -->
      <div class="flex items-center justify-between p-5 border-b dark:border-gray-700">
        <div class="flex items-center gap-2">
          <iconify-icon icon="solar:pen-new-square-bold-duotone" width="22" class="text-warning"></iconify-icon>
          <span class="font-semibold text-lg dark:text-white">Modifier la collection</span>
          <span class="text-xs text-gray-400 ml-2" x-text="'Étape ' + step + '/2'"></span>
        </div>
        <button type="button" @click="showEditModal = false; resetForm();" class="text-white-dark hover:text-dark">
          <iconify-icon icon="solar:close-circle-bold" width="24" height="24"></iconify-icon>
        </button>
      </div>

      <!-- Body - Scrollable -->
      <div class="px-5 pt-3 pb-5 overflow-y-auto flex-grow">
        <form @submit.prevent="step === 2 ? updateCollection() : null">
          
          <!-- STEP 1: Infos de base -->
          <div x-show="step === 1" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0">
            <!-- Nom -->
            <div class="mb-4">
              <label class="mb-2 block text-sm font-bold">Nom *</label>
              <input type="text" x-model="newCollection.name" placeholder="Ex: Contacts, Projets, Factures..." class="form-input w-full" required>
            </div>

            <!-- Description et Slug - Accordion -->
            <div class="mb-4">
              <button type="button" @click="showDescSlug = !showDescSlug" 
                      class="mb-2 flex items-center justify-between w-full text-sm font-bold">
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:document-text-bold-duotone" width="16" class="text-secondary"></iconify-icon>
                  <span>Description et Slug</span>
                </div>
                <iconify-icon icon="solar:alt-arrow-down-linear" width="14" 
                              :class="showDescSlug && 'rotate-180'" 
                              style="transition: transform 0.2s"></iconify-icon>
              </button>
              <div x-show="showDescSlug" x-collapse class="mt-2 space-y-3">
                <textarea x-model="newCollection.description" rows="2" placeholder="Description de la collection..." class="form-input w-full resize-none text-sm"></textarea>
                <div>
                  <input type="text" x-model="newCollection.slug" placeholder="slug-de-la-collection" class="form-input w-full text-sm bg-gray-50 dark:bg-gray-800" disabled>
                  <p class="text-xs text-gray-400 mt-1">Le slug ne peut pas être modifié</p>
                </div>
              </div>
            </div>

            <!-- Visuel - Accordion -->
            <div class="mb-4">
              <button type="button" @click="accordionVisuel = !accordionVisuel" 
                      class="mb-2 flex items-center justify-between w-full text-sm font-bold">
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:pallete-2-bold-duotone" width="16" class="text-primary"></iconify-icon>
                  <span>Visuel</span>
                </div>
                <iconify-icon icon="solar:alt-arrow-down-linear" width="14" 
                              :class="accordionVisuel && 'rotate-180'" 
                              style="transition: transform 0.2s"></iconify-icon>
              </button>
              <div x-show="accordionVisuel" x-collapse class="mt-2">
                <div class="flex items-center gap-4">
                  <!-- Icône (Vanilla JS Picker) -->
                  <div id="edit-icon-picker"></div>

                  <!-- Couleur (Vanilla JS Picker) -->
                  <div id="edit-color-picker"></div>

                  <!-- Media - Icône simple -->
                  <label class="w-9 h-9 flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors cursor-pointer" title="Ajouter une image">
                    <iconify-icon icon="solar:gallery-bold-duotone" width="22" class="text-gray-400 hover:text-primary"></iconify-icon>
                    <input type="file" accept="image/*" class="hidden" @change="handleImageUpload($event)">
                  </label>
                </div>
              </div>
            </div>

            <!-- Champs - Accordion -->
            <div class="mb-4">
              <button type="button" @click="accordionChamps = !accordionChamps" 
                      class="mb-2 flex items-center justify-between w-full text-sm font-bold">
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:layers-bold-duotone" class="text-warning" width="16"></iconify-icon>
                  <span>Champs</span>
                </div>
                <iconify-icon icon="solar:alt-arrow-down-linear" width="14" 
                              :class="accordionChamps && 'rotate-180'" 
                              style="transition: transform 0.2s"></iconify-icon>
              </button>
              <div x-show="accordionChamps" x-collapse class="space-y-2">
                <!-- Ajouter des champs -->
                <button type="button" @click="loadSystemFields(); step = 2" 
                        class="w-full flex items-center justify-center gap-2 py-2 text-sm text-info hover:text-info/80 border border-dashed border-info/30 rounded-lg hover:bg-info/5 transition-colors">
                  <iconify-icon icon="solar:add-circle-linear" width="16"></iconify-icon>
                  <span>Ajouter des champs</span>
                </button>
                
                <!-- Champs système -->
                <div class="p-3 border border-warning/30 rounded-lg">
                  <div class="text-xs text-warning font-medium mb-2 flex items-center gap-1">
                    <iconify-icon icon="solar:check-circle-bold" width="14"></iconify-icon>
                    <span>Champs par défaut</span>
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    <template x-for="(enabled, field) in newCollection.standardFields" :key="'std-'+field">
                      <button type="button" 
                              @click="newCollection.standardFields[field] = !newCollection.standardFields[field]"
                              class="inline-flex items-center gap-1 px-2 py-0 rounded-full text-xs font-medium border transition-colors"
                              :class="enabled ? 'bg-warning/10 border-warning/30 text-warning' : 'bg-gray-100 dark:bg-gray-800 border-gray-300 dark:border-gray-600 text-gray-400'">
                        <iconify-icon :icon="getFieldIcon(field)" width="12"></iconify-icon>
                        <span x-text="getFieldLabel(field)"></span>
                      </button>
                    </template>
                  </div>
                </div>
                
                <!-- Champs personnalisés -->
                <div class="p-3 border border-warning/30 rounded-lg" x-show="selectedFields.length > 0">
                  <div class="text-xs text-warning font-medium mb-2 flex items-center gap-1">
                    <iconify-icon icon="solar:check-circle-bold" width="14"></iconify-icon>
                    <span x-text="selectedFields.length + ' champ(s) sélectionné(s)'"></span>
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    <template x-for="(field, idx) in selectedFields" :key="field._id || idx">
                      <div class="inline-flex items-center gap-1 px-2 py-0 bg-warning/10 border border-warning/30 rounded-full text-xs font-medium text-warning">
                        <iconify-icon :icon="field.icon || 'solar:widget-bold'" width="12"></iconify-icon>
                        <span x-text="field.label || field.name || 'Champ'"></span>
                        <button type="button" @click="selectedFields.splice(idx, 1)" class="hover:text-red-500">
                          <iconify-icon icon="solar:close-circle-bold" width="12"></iconify-icon>
                        </button>
                      </div>
                    </template>
                  </div>
                </div>

                <!-- Relations (affichées comme champs) -->
                <div class="p-3 border border-primary/30 rounded-lg" x-show="relations.length > 0">
                  <div class="text-xs text-primary font-medium mb-2 flex items-center gap-1">
                    <iconify-icon icon="solar:link-round-bold-duotone" width="14"></iconify-icon>
                    <span x-text="relations.length + ' relation(s)'"></span>
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    <template x-for="rel in relations" :key="'rel-field-'+rel.key">
                      <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium border transition-colors"
                           :style="getRelationEntity(rel.targetEntity)?.color ? 'background-color:' + getRelationEntity(rel.targetEntity).color + '15; border-color:' + getRelationEntity(rel.targetEntity).color + '40; color:' + getRelationEntity(rel.targetEntity).color : ''"
                           :class="!getRelationEntity(rel.targetEntity)?.color && 'bg-primary/10 border-primary/30 text-primary'">
                        <iconify-icon :icon="getRelationEntity(rel.targetEntity)?.icon || 'solar:link-round-bold-duotone'" width="12"></iconify-icon>
                        <span x-text="rel.label || 'Relation'"></span>
                        <span class="opacity-50 text-[10px]" x-text="rel.cardinality === 'one-to-one' ? '1:1' : rel.cardinality === 'one-to-many' ? '1:N' : 'N:N'"></span>
                      </div>
                    </template>
                  </div>
                </div>
              </div>
            </div>

            <!-- Classifications - Accordion -->
            <div class="mb-4">
              <button type="button" @click="accordionClassifications = !accordionClassifications" 
                      class="mb-2 flex items-center justify-between w-full text-sm font-bold">
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:tag-bold-duotone" width="16" class="text-info"></iconify-icon>
                  <span>Classifications</span>
                </div>
                <iconify-icon icon="solar:alt-arrow-down-linear" width="14" 
                              :class="accordionClassifications && 'rotate-180'" 
                              style="transition: transform 0.2s"></iconify-icon>
              </button>
              <div x-show="accordionClassifications" x-collapse class="mt-2 space-y-3">
                <!-- Status Classification (Kanban driver) -->
                <div class="p-3 border border-info/30 rounded-lg">
                  <label class="text-xs text-info font-medium mb-2 block">
                    <iconify-icon icon="solar:diploma-bold-duotone" width="14" class="mr-1"></iconify-icon>
                    Classification de statut (Kanban)
                  </label>
                  <select x-model="newCollection.statusClassificationId" 
                          @change="onStatusClassificationChange()"
                          class="form-select w-full text-sm">
                    <option value="">Aucune</option>
                    <template x-for="cls in allClassifications" :key="cls._id">
                      <option :value="cls._id" x-text="cls.name"></option>
                    </template>
                  </select>
                  <p class="text-xs text-gray-400 mt-1">Utilisée pour le tableau Kanban</p>
                </div>
                
                <!-- Other Classifications (Multi-select) -->
                <div class="p-3 border border-info/30 rounded-lg">
                  <label class="text-xs text-info font-medium mb-2 block">
                    <iconify-icon icon="solar:tag-horizontal-bold-duotone" width="14" class="mr-1"></iconify-icon>
                    Classifications additionnelles
                  </label>
                  <div class="flex flex-wrap gap-1.5" x-show="allClassifications.length > 0">
                    <template x-for="cls in allClassifications" :key="cls._id">
                      <button type="button" 
                              @click="toggleClassification(cls._id)"
                              class="inline-flex items-center gap-1 px-2 py-0 rounded-full text-xs font-medium border transition-colors"
                              :class="isClassificationSelected(cls._id) 
                                ? 'bg-info/10 border-info/30 text-info' 
                                : cls._id === newCollection.statusClassificationId 
                                  ? 'bg-gray-50 dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-gray-300 cursor-not-allowed' 
                                  : 'bg-gray-100 dark:bg-gray-800 border-gray-300 dark:border-gray-600 text-gray-400 hover:border-info/50'"
                              :disabled="cls._id === newCollection.statusClassificationId">
                        <iconify-icon icon="solar:tag-bold-duotone" width="12"></iconify-icon>
                        <span x-text="cls.name"></span>
                      </button>
                    </template>
                  </div>
                  <div x-show="allClassifications.length === 0" class="text-xs text-gray-400">
                    Aucune classification disponible
                  </div>
                </div>
              </div>
            </div>

            <!-- Champ de référence - Accordion -->
            <div class="mb-4">
              <button type="button" @click="accordionReference = !accordionReference" 
                      class="mb-2 flex items-center justify-between w-full text-sm font-bold">
                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:document-text-bold-duotone" width="16" class="text-success"></iconify-icon>
                  <span>Champ de référence</span>
                </div>
                <iconify-icon icon="solar:alt-arrow-down-linear" width="14" 
                              :class="accordionReference && 'rotate-180'" 
                              style="transition: transform 0.2s"></iconify-icon>
              </button>
              <div x-show="accordionReference" x-collapse class="mt-2">
                <p class="text-xs text-gray-400 mb-2">Ce champ sera utilisé comme titre lors des listings, relations, mentions, etc.</p>
                
                <!-- Available fields as clickable tags -->
                <div class="mb-2 flex flex-wrap gap-1.5" x-show="getAvailableFields().length > 0">
                  <span class="text-xs text-gray-500 mr-1">Champs disponibles:</span>
                  <template x-for="field in getAvailableFields()" :key="field.id">
                    <button type="button" @click="addFieldById(field.id)" 
                            class="inline-flex items-center gap-1 px-2 py-0 bg-gray-100 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-full text-xs font-medium text-gray-600 dark:text-gray-300 hover:bg-primary/10 hover:border-primary hover:text-primary transition-colors cursor-pointer">
                      <iconify-icon :icon="field.icon" width="12"></iconify-icon>
                      <span x-text="field.label"></span>
                      <iconify-icon icon="solar:add-circle-bold" width="12" class="opacity-50"></iconify-icon>
                    </button>
                  </template>
                </div>
                
                <!-- Format field (100% width) -->
                <div class="w-full">
                  <div class="form-input w-full text-sm min-h-[38px] p-2 cursor-text focus-within:ring-2 focus-within:ring-primary/50" 
                       contenteditable="true"
                       @input="syncTokensFromEditor($event)"
                       x-init="$el.innerHTML = renderTokensAsHTML()"
                       x-ref="formatEditorEdit">
                  </div>
                  <label class="text-xs text-gray-500 mt-1 block">Format du titre de référence</label>
                </div>
              </div>
            </div>



            <!-- Active Toggle -->
            <div class="flex items-center justify-between pt-3 border-t dark:border-gray-700">
              <span class="text-sm text-gray-500">Collection active</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" x-model="newCollection.active" class="sr-only peer">
                <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-600 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
              </label>
            </div>
          </div>

          <!-- STEP 2: Champs & Relations -->
          <div x-show="step === 2" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0">
            
            <!-- Tabs -->
            <div class="flex border-b dark:border-gray-700 mb-4">
              <button type="button" @click="step2Tab = 'fields'" 
                      class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
                      :class="step2Tab === 'fields' ? 'border-warning text-warning' : 'border-transparent text-gray-500 hover:text-gray-700'">
                <iconify-icon icon="solar:layers-bold-duotone" width="16" class="mr-1"></iconify-icon>
                Champs
              </button>
              <button type="button" @click="step2Tab = 'relations'; loadAllEntities()" 
                      class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
                      :class="step2Tab === 'relations' ? 'border-warning text-warning' : 'border-transparent text-gray-500 hover:text-gray-700'">
                <iconify-icon icon="solar:link-round-bold-duotone" width="16" class="mr-1"></iconify-icon>
                Relations
                <span x-show="relations.length > 0" class="ml-1 px-1.5 py-0.5 text-xs bg-warning/20 text-warning rounded-full" x-text="relations.length"></span>
              </button>
            </div>

            <!-- TAB: Champs -->
            <div x-show="step2Tab === 'fields'">
              <!-- Search -->
              <div class="relative mb-4">
                <input type="text" x-model="fieldSearch" placeholder="Rechercher un champ..." class="form-input w-full pl-9 text-sm">
                <iconify-icon icon="solar:magnifer-linear" class="absolute left-3 top-2.5 text-gray-400" width="16"></iconify-icon>
              </div>

              <!-- Champs sélectionnés -->
              <div x-show="selectedFields.length > 0" class="mb-4 p-3 bg-warning/5 rounded-lg border border-warning/20">
                <div class="text-xs font-semibold text-warning mb-2 flex items-center gap-1">
                  <iconify-icon icon="solar:check-circle-bold" width="14"></iconify-icon>
                  <span x-text="selectedFields.length + ' champ(s) sélectionné(s)'"></span>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  <template x-for="(field, idx) in selectedFields" :key="field._id || idx">
                    <div class="inline-flex items-center gap-1 px-2 py-1 bg-white dark:bg-gray-700 rounded-full text-xs border shadow-sm">
                      <iconify-icon :icon="field.icon || 'solar:widget-bold'" width="14" class="text-warning"></iconify-icon>
                      <span x-text="field.label || field.name || 'Champ'"></span>
                      <button type="button" @click="selectedFields.splice(idx, 1)" class="text-gray-400 hover:text-red-500 ml-0.5">
                        <iconify-icon icon="solar:close-circle-bold" width="14"></iconify-icon>
                      </button>
                    </div>
                  </template>
                </div>
              </div>

              <!-- Catégories de champs -->
              <div class="space-y-2 max-h-80 overflow-y-auto pr-1">
                <template x-for="category in filteredCategories" :key="category.key">
                  <div class="border dark:border-gray-700 rounded-lg overflow-hidden">
                    <button type="button" 
                            @click="openCategories[category.key] = !openCategories[category.key]"
                            class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 font-medium text-sm flex items-center justify-between hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                      <div class="flex items-center gap-2">
                        <iconify-icon :icon="getCategoryIcon(category.key)" width="16" class="text-warning"></iconify-icon>
                        <span x-text="category.label"></span>
                        <span class="text-gray-400 text-xs" x-text="'(' + category.fields.length + ')'"></span>
                      </div>
                      <iconify-icon icon="solar:alt-arrow-down-linear" width="14" 
                                    :class="openCategories[category.key] && 'rotate-180'" 
                                    style="transition: transform 0.2s"></iconify-icon>
                    </button>
                    <div x-show="openCategories[category.key]" x-collapse class="divide-y dark:divide-gray-700">
                      <template x-for="field in category.fields" :key="field._id">
                        <div class="px-3 py-2 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors"
                             :class="isFieldSelected(field._id) && 'bg-warning/5'">
                          <div class="flex items-center gap-2 flex-1 min-w-0">
                            <iconify-icon :icon="field.icon" width="18" class="text-gray-500 shrink-0"></iconify-icon>
                            <div class="min-w-0">
                              <div class="text-sm font-medium truncate" x-text="field.label"></div>
                              <div class="text-xs text-gray-400 truncate" x-text="field.description" x-show="field.description"></div>
                            </div>
                          </div>
                          <button type="button" 
                                  @click="toggleField(field)"
                                  class="shrink-0 px-2 py-1 rounded text-xs font-medium transition-colors"
                                  :class="isFieldSelected(field._id) ? 'bg-red-100 text-red-600 hover:bg-red-200' : 'bg-warning/10 text-warning hover:bg-warning/20'">
                            <span x-text="isFieldSelected(field._id) ? 'Retirer' : 'Ajouter'"></span>
                          </button>
                        </div>
                      </template>
                    </div>
                  </div>
                </template>
                
                <div x-show="filteredCategories.length === 0" class="text-center py-8 text-gray-400">
                  <iconify-icon icon="solar:box-broken" width="40" class="mb-2"></iconify-icon>
                  <p class="text-sm">Aucun champ trouvé</p>
                </div>
              </div>
            </div>

            <!-- TAB: Relations -->
            <div x-show="step2Tab === 'relations'">
              <!-- Relations list -->
              <div class="space-y-3 max-h-[400px] overflow-y-auto pr-1">
                <template x-for="(relation, rIdx) in relations" :key="relation.key">
                  <div class="border dark:border-gray-700 rounded-lg p-3 space-y-3 bg-gray-50/50 dark:bg-gray-800/50">
                    <!-- Header with delete -->
                    <div class="flex items-center justify-between">
                      <span class="text-sm font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                        <iconify-icon icon="solar:link-round-bold-duotone" width="16" class="text-warning"></iconify-icon>
                        <span x-text="relation.label || ('Relation ' + (rIdx + 1))"></span>
                      </span>
                      <button type="button" @click="removeRelation(rIdx)" class="text-gray-400 hover:text-red-500 transition-colors">
                        <iconify-icon icon="solar:trash-bin-trash-bold" width="16"></iconify-icon>
                      </button>
                    </div>

                    <!-- Entity picker -->
                    <div>
                      <label class="text-xs font-medium text-gray-500 mb-1 block">Entité cible</label>
                      <select x-model="relation.targetEntity" @change="onRelationEntityChange(relation)" class="form-select w-full text-sm">
                        <option value="">Sélectionner une entité...</option>
                        <template x-for="ent in allEntities" :key="ent._id">
                          <option :value="ent._id" x-text="ent.name"></option>
                        </template>
                      </select>
                    </div>

                    <!-- Label -->
                    <div class="grid grid-cols-2 gap-2">
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Label</label>
                        <input type="text" x-model="relation.label" placeholder="Ex: Patient" class="form-input w-full text-sm">
                      </div>
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Label inverse</label>
                        <input type="text" x-model="relation.inverseLabel" placeholder="Ex: Consultations" class="form-input w-full text-sm">
                      </div>
                    </div>

                    <!-- Cardinality -->
                    <div>
                      <label class="text-xs font-medium text-gray-500 mb-1 block">Cardinalité</label>
                      <div class="flex gap-1">
                        <template x-for="card in [{v:'one-to-one',l:'1:1'},{v:'one-to-many',l:'1:N'},{v:'many-to-many',l:'N:N'}]" :key="card.v">
                          <button type="button" @click="relation.cardinality = card.v"
                                  class="flex-1 px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors"
                                  :class="relation.cardinality === card.v 
                                    ? 'bg-warning text-white border-warning' 
                                    : 'bg-white dark:bg-gray-700 border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:border-warning/50'">
                            <span x-text="card.l"></span>
                          </button>
                        </template>
                      </div>
                    </div>

                    <!-- Input Mode + Storage -->
                    <div class="grid grid-cols-2 gap-2">
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Mode d'encodage</label>
                        <select x-model="relation.inputMode" class="form-select w-full text-sm">
                          <option value="autocomplete">Autocomplete</option>
                          <option value="select">Select</option>
                          <option value="modal-picker">Modal Picker</option>
                        </select>
                      </div>
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Stockage</label>
                        <select x-model="relation.storage" class="form-select w-full text-sm">
                          <option value="on-source">Sur la source</option>
                          <option value="on-target">Sur la cible</option>
                          <option value="join">Table de jointure</option>
                        </select>
                      </div>
                    </div>

                    <!-- Search fields -->
                    <template x-if="relation._targetFields && relation._targetFields.length > 0">
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Champs de recherche</label>
                        <div class="flex flex-wrap gap-1.5">
                          <template x-for="field in relation._targetFields" :key="'es-'+relation.key+'-'+field.id">
                            <button type="button" @click="toggleSearchField(relation, field.id)"
                                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium border transition-colors"
                                    :class="relation.searchFields.includes(field.id) 
                                      ? 'bg-info/10 border-info/30 text-info' 
                                      : 'bg-gray-100 dark:bg-gray-700 border-gray-300 dark:border-gray-600 text-gray-500 hover:border-info/50'">
                              <iconify-icon :icon="field.icon" width="12"></iconify-icon>
                              <span x-text="field.label"></span>
                            </button>
                          </template>
                        </div>
                      </div>
                    </template>

                    <!-- Display fields -->
                    <template x-if="relation._targetFields && relation._targetFields.length > 0">
                      <div>
                        <label class="text-xs font-medium text-gray-500 mb-1 block">Champs à afficher</label>
                        <div class="flex flex-wrap gap-1.5">
                          <template x-for="field in relation._targetFields" :key="'ed-'+relation.key+'-'+field.id">
                            <button type="button" @click="toggleDisplayField(relation, field.id)"
                                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium border transition-colors"
                                    :class="relation.displayFields.includes(field.id) 
                                      ? 'bg-success/10 border-success/30 text-success' 
                                      : 'bg-gray-100 dark:bg-gray-700 border-gray-300 dark:border-gray-600 text-gray-500 hover:border-success/50'">
                              <iconify-icon :icon="field.icon" width="12"></iconify-icon>
                              <span x-text="field.label"></span>
                            </button>
                          </template>
                        </div>
                      </div>
                    </template>

                    <!-- Toggles row -->
                    <div class="flex items-center gap-4 pt-2 border-t dark:border-gray-700">
                      <label class="flex items-center gap-2 cursor-pointer text-xs text-gray-500">
                        <input type="checkbox" x-model="relation.bidirectional" class="form-checkbox rounded text-warning">
                        Bidirectionnelle
                      </label>
                      <label class="flex items-center gap-2 cursor-pointer text-xs text-gray-500">
                        <input type="checkbox" x-model="relation.required" class="form-checkbox rounded text-warning">
                        Requis
                      </label>
                    </div>
                  </div>
                </template>
              </div>

              <!-- Add relation button -->
              <button type="button" @click="addRelation()" 
                      class="w-full mt-3 flex items-center justify-center gap-2 py-2.5 text-sm text-warning hover:text-warning/80 border border-dashed border-warning/30 rounded-lg hover:bg-warning/5 transition-colors">
                <iconify-icon icon="solar:add-circle-linear" width="16"></iconify-icon>
                <span>Ajouter une relation</span>
              </button>

              <!-- Empty state -->
              <div x-show="relations.length === 0" class="text-center py-6 text-gray-400">
                <iconify-icon icon="solar:link-broken-bold-duotone" width="40" class="mb-2"></iconify-icon>
                <p class="text-sm">Aucune relation configurée</p>
                <p class="text-xs mt-1">Cliquez sur le bouton ci-dessus pour lier cette collection à d'autres</p>
              </div>
            </div>

          </div>
        </form>
      </div>

      <!-- Footer - Navigation -->
      <div class="p-5 border-t dark:border-gray-700 flex gap-3 flex-shrink-0">
        <!-- Step 1 -->
        <template x-if="step === 1">
          <div class="flex gap-3 w-full">
            <button type="button" @click="updateCollection()" class="btn btn-warning flex-1" :disabled="!newCollection.name || isSubmitting">
              <span x-show="isSubmitting" class="animate-spin border-2 border-white border-l-transparent rounded-full w-4 h-4 mr-2 inline-block"></span>
              <iconify-icon icon="solar:diskette-bold" width="18" class="mr-1"></iconify-icon>
              Sauvegarde
            </button>
            <button type="button" @click="if(newCollection.name) { loadSystemFields(); step = 2; }" 
                    class="btn btn-outline-warning flex-1" :disabled="!newCollection.name">
              Champs personnalisés
              <iconify-icon icon="solar:arrow-right-linear" width="18" class="ml-1"></iconify-icon>
            </button>
          </div>
        </template>
        
        <!-- Step 2 -->
        <template x-if="step === 2">
          <div class="flex gap-3 w-full">
            <button type="button" @click="step = 1" class="btn btn-outline-dark flex-1">
              <iconify-icon icon="solar:arrow-left-linear" width="18" class="mr-1"></iconify-icon>
              Retour
            </button>
            <button type="button" @click="updateCollection()" class="btn btn-warning flex-1" :disabled="isSubmitting">
              <span x-show="isSubmitting" class="animate-spin border-2 border-white border-l-transparent rounded-full w-4 h-4 mr-2 inline-block"></span>
              Mettre à jour
            </button>
          </div>
        </template>
      </div>
    </div>
  </div>
</div>

<script src="/themes/default/assets/js/simple-datatables.js"></script>

<script>
// ============================================
// VANILLA JS PICKER INITIALIZATION
// ============================================
(function() {
  'use strict';

  // Store picker instances for cleanup
  let createIconPicker = null;
  let createColorPicker = null;
  let editIconPicker = null;
  let editColorPicker = null;

  // Get Alpine component data
  function getAlpineData() {
    const root = document.querySelector('[x-data="collectionsManager()"]');
    return root ? Alpine.$data(root) : null;
  }

  // Initialize create modal pickers
  function initCreatePickers() {
    const data = getAlpineData();
    if (!data) return;

    const iconContainer = document.getElementById('create-icon-picker');
    const colorContainer = document.getElementById('create-color-picker');

    if (iconContainer && !createIconPicker) {
      createIconPicker = new IconPicker(iconContainer, {
        name: 'icon',
        value: data.newCollection.icon || '',
        onSelect: (icon) => {
          data.newCollection.icon = icon;
        }
      });
    }

    if (colorContainer && !createColorPicker) {
      createColorPicker = new ColorPicker(colorContainer, {
        name: 'color',
        value: data.newCollection.color || '',
        onSelect: (color) => {
          data.newCollection.color = color;
        }
      });
    }
  }

  // Initialize edit modal pickers
  function initEditPickers() {
    const data = getAlpineData();
    if (!data) return;

    const iconContainer = document.getElementById('edit-icon-picker');
    const colorContainer = document.getElementById('edit-color-picker');

    if (iconContainer && !editIconPicker) {
      editIconPicker = new IconPicker(iconContainer, {
        name: 'icon',
        value: data.newCollection.icon || '',
        onSelect: (icon) => {
          data.newCollection.icon = icon;
        }
      });
    }

    if (colorContainer && !editColorPicker) {
      editColorPicker = new ColorPicker(colorContainer, {
        name: 'color',
        value: data.newCollection.color || '',
        onSelect: (color) => {
          data.newCollection.color = color;
        }
      });
    }
  }

  // Destroy create modal pickers
  function destroyCreatePickers() {
    if (createIconPicker) {
      createIconPicker.destroy();
      createIconPicker = null;
    }
    if (createColorPicker) {
      createColorPicker.destroy();
      createColorPicker = null;
    }
  }

  // Destroy edit modal pickers
  function destroyEditPickers() {
    if (editIconPicker) {
      editIconPicker.destroy();
      editIconPicker = null;
    }
    if (editColorPicker) {
      editColorPicker.destroy();
      editColorPicker = null;
    }
  }

  // Update picker values when Alpine data changes
  function updatePickerValues(isEdit = false) {
    const data = getAlpineData();
    if (!data) return;

    if (isEdit) {
      if (editIconPicker) editIconPicker.setValue(data.newCollection.icon || '');
      if (editColorPicker) editColorPicker.setValue(data.newCollection.color || '');
    } else {
      if (createIconPicker) createIconPicker.setValue(data.newCollection.icon || '');
      if (createColorPicker) createColorPicker.setValue(data.newCollection.color || '');
    }
  }

  // Watch for modal open/close via Alpine
  document.addEventListener('alpine:init', () => {
    // After Alpine initializes, set up watchers
    document.addEventListener('alpine:initialized', () => {
      const data = getAlpineData();
      if (!data) return;

      // Use Alpine effect to watch modal state
      Alpine.effect(() => {
        const showCreate = data.showCreateModal;
        const showEdit = data.showEditModal;

        if (showCreate) {
          // Wait for DOM to render
          requestAnimationFrame(() => {
            initCreatePickers();
            updatePickerValues(false);
          });
        } else {
          destroyCreatePickers();
        }

        if (showEdit) {
          // Wait for DOM to render
          requestAnimationFrame(() => {
            initEditPickers();
            updatePickerValues(true);
          });
        } else {
          destroyEditPickers();
        }
      });
    });
  });

  // Fallback: Use MutationObserver if Alpine effect doesn't work
  const observer = new MutationObserver((mutations) => {
    const createModal = document.querySelector('[x-show="showCreateModal"]');
    const editModal = document.querySelector('[x-show="showEditModal"]');

    // Check if create modal is visible
    if (createModal && createModal.style.display !== 'none' && !createIconPicker) {
      setTimeout(() => {
        initCreatePickers();
        updatePickerValues(false);
      }, 100);
    }

    // Check if edit modal is visible
    if (editModal && editModal.style.display !== 'none' && !editIconPicker) {
      setTimeout(() => {
        initEditPickers();
        updatePickerValues(true);
      }, 100);
    }
  });

  // Start observing when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    observer.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['style', 'class']
    });
  });
})();
</script>