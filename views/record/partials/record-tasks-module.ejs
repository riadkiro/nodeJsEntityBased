                                </button>
                                <iconify-icon icon="solar:alt-arrow-down-linear" width="15" class="tl-record-chevron" :class="{'expanded': expandedListIds.includes(list._id)}" @click.stop="toggleExpand(list._id)"></iconify-icon>
                            </div>

