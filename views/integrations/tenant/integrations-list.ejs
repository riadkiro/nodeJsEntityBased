<%# Tenant - Integrations List %>
<div class="panel p-6">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold dark:text-white">Integrations</h1>
            <p class="text-gray-500 dark:text-gray-400 mt-1">Connect your workspace to external services</p>
        </div>
        <a href="/account/<%= account_number %>/workflows" class="btn btn-outline-primary">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            Workflows
        </a>
    </div>

    <% if (integrations && integrations.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% integrations.forEach(integration => { %>
                <a href="/account/<%= account_number %>/integrations/<%= integration.key %>"
                   class="block p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary dark:hover:border-primary transition-colors">
                    <div class="flex items-center gap-3 mb-3">
                        <% if (integration.logo) { %>
                            <img src="<%= integration.logo %>" alt="<%= integration.name %>" class="w-12 h-12 rounded">
                        <% } else { %>
                            <div class="w-12 h-12 bg-gray-100 dark:bg-gray-800 rounded flex items-center justify-center">
                                <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                </svg>
                            </div>
                        <% } %>
                        <div>
                            <h3 class="font-medium dark:text-white"><%= integration.name %></h3>
                            <span class="text-xs px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
                                <%= integration.category || 'Other' %>
                            </span>
                        </div>
                    </div>
                    <div class="flex items-center justify-between">
                        <% if (integration.isConnected) { %>
                            <span class="text-xs px-2 py-1 rounded bg-success/20 text-success flex items-center gap-1">
                                <span class="w-2 h-2 bg-success rounded-full"></span>
                                Connected
                            </span>
                        <% } else { %>
                            <span class="text-xs text-gray-500 dark:text-gray-400">Not connected</span>
                        <% } %>
                        <span class="text-primary text-sm">Configure →</span>
                    </div>
                </a>
            <% }) %>
        </div>
    <% } else { %>
        <div class="text-center py-12">
            <div class="w-16 h-16 mx-auto mb-4 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center">
                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
            </div>
            <h3 class="text-lg font-medium dark:text-white mb-2">No integrations available</h3>
            <p class="text-gray-500 dark:text-gray-400">Contact your administrator to set up integrations.</p>
        </div>
    <% } %>
</div>
