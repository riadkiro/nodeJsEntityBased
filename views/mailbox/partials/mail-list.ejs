<!-- Compact density CSS -->
<style>
    .mail-compact td { padding: 4px 8px !important; font-size: 13px; }
    .mail-compact .form-checkbox { width: 14px; height: 14px; }
</style>

<!-- ========== MAIL LIST VIEW ========== -->
<div x-show="!selectedMail && !isEdit && !showTemplates && !showSignature" class="flex h-full flex-col">
    <!-- Toolbar -->
    <div class="flex flex-wrap-reverse items-center justify-between gap-4 p-4">
        <div class="flex w-full items-center sm:w-auto">
            <div class="ltr:mr-4 rtl:ml-4">
                <input type="checkbox" class="form-checkbox" :checked="isAllChecked()" :value="isAllChecked()" @change="checkAll($event.target.checked)" />
            </div>
            <div class="ltr:mr-4 rtl:ml-4">
                <button type="button" class="flex items-center hover:text-primary" @click="refreshMails()">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                        <path d="M12.0789 3V2.25V3ZM3.67981 11.3333H2.92981H3.67981ZM3.67981 13L3.15157 13.5324C3.44398 13.8225 3.91565 13.8225 4.20805 13.5324L3.67981 13ZM5.88787 11.8657C6.18191 11.574 6.18377 11.0991 5.89203 10.8051C5.60029 10.511 5.12542 10.5092 4.83138 10.8009L5.88787 11.8657ZM2.52824 10.8009C2.2342 10.5092 1.75933 10.511 1.46759 10.8051C1.17585 11.0991 1.17772 11.574 1.47176 11.8657L2.52824 10.8009ZM18.6156 7.39279C18.8325 7.74565 19.2944 7.85585 19.6473 7.63892C20.0001 7.42199 20.1103 6.96007 19.8934 6.60721L18.6156 7.39279ZM12.0789 2.25C7.03155 2.25 2.92981 6.3112 2.92981 11.3333H4.42981C4.42981 7.15072 7.84884 3.75 12.0789 3.75V2.25ZM2.92981 11.3333L2.92981 13H4.42981L4.42981 11.3333H2.92981ZM4.20805 13.5324L5.88787 11.8657L4.83138 10.8009L3.15157 12.4676L4.20805 13.5324ZM4.20805 12.4676L2.52824 10.8009L1.47176 11.8657L3.15157 13.5324L4.20805 12.4676ZM19.8934 6.60721C18.287 3.99427 15.3873 2.25 12.0789 2.25V3.75C14.8484 3.75 17.2727 5.20845 18.6156 7.39279L19.8934 6.60721Z" fill="currentColor" />
                    </svg>
                </button>
            </div>
            <!-- Toolbar Actions (only when not on trash) -->
            <template x-if="selectedTab != 'trash'">
                <ul class="flex grow items-center gap-4 sm:flex-none ltr:sm:mr-4 rtl:sm:ml-4">
                    <!-- Archive -->
                    <li>
                        <button type="button" class="flex items-center hover:text-primary" @click="setArchive" title="Archive">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                <path d="M9 12C9 11.5341 9 11.3011 9.07612 11.1173C9.17761 10.8723 9.37229 10.6776 9.61732 10.5761C9.80109 10.5 10.0341 10.5 10.5 10.5H13.5C13.9659 10.5 14.1989 10.5 14.3827 10.5761C14.6277 10.6776 14.8224 10.8723 14.9239 11.1173C15 11.3011 15 11.5341 15 12C15 12.4659 15 12.6989 14.9239 12.8827C14.8224 13.1277 14.6277 13.3224 14.3827 13.4239C14.1989 13.5 13.9659 13.5 13.5 13.5H10.5C10.0341 13.5 9.80109 13.5 9.61732 13.4239C9.37229 13.3224 9.17761 13.1277 9.07612 12.8827C9 12.6989 9 12.4659 9 12Z" stroke="currentColor" stroke-width="1.5"></path>
                                <path opacity="0.5" d="M20.5 7V13C20.5 16.7712 20.5 18.6569 19.3284 19.8284C18.1569 21 16.2712 21 12.5 21H11.5C7.72876 21 5.84315 21 4.67157 19.8284C3.5 18.6569 3.5 16.7712 3.5 13V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                                <path d="M2 5C2 4.05719 2 3.58579 2.29289 3.29289C2.58579 3 3.05719 3 4 3H20C20.9428 3 21.4142 3 21.7071 3.29289C22 3.58579 22 4.05719 22 5C22 5.94281 22 6.41421 21.7071 6.70711C21.4142 7 20.9428 7 20 7H4C3.05719 7 2.58579 7 2.29289 6.70711C2 6.41421 2 5.94281 2 5Z" stroke="currentColor" stroke-width="1.5"></path>
                            </svg>
                        </button>
                    </li>
                    <!-- Spam -->
                    <li>
                        <button type="button" class="flex items-center hover:text-primary" @click="setSpam" title="Spam">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                <path d="M12 7V13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                                <circle cx="12" cy="16" r="1" fill="currentColor"></circle>
                                <path opacity="0.5" d="M7.84308 3.80211C9.8718 2.6007 10.8862 2 12 2C13.1138 2 14.1282 2.6007 16.1569 3.80211L16.8431 4.20846C18.8718 5.40987 19.8862 6.01057 20.4431 7C21 7.98943 21 9.19084 21 11.5937V12.4063C21 14.8092 21 16.0106 20.4431 17C19.8862 17.9894 18.8718 18.5901 16.8431 19.7915L16.1569 20.1979C14.1282 21.3993 13.1138 22 12 22C10.8862 22 9.8718 21.3993 7.84308 20.1979L7.15692 19.7915C5.1282 18.5901 4.11384 17.9894 3.55692 17C3 16.0106 3 14.8092 3 12.4063V11.5937C3 9.19084 3 7.98943 3.55692 7C4.11384 6.01057 5.1282 5.40987 7.15692 4.20846L7.84308 3.80211Z" stroke="currentColor" stroke-width="1.5"></path>
                            </svg>
                        </button>
                    </li>
                    <!-- Group dropdown -->
                    <li>
                        <div x-data="{ open: false }" @click.outside="open = false" class="dropdown relative">
                            <button type="button" class="flex items-center hover:text-primary" @click="open = !open" title="Group">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" />
                                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" />
                                    <path opacity="0.5" d="M15 9L19 5" stroke="currentColor" stroke-width="1.5" />
                                    <path opacity="0.5" d="M5 19L9 15" stroke="currentColor" stroke-width="1.5" />
                                    <path opacity="0.5" d="M9 9L5 5" stroke="currentColor" stroke-width="1.5" />
                                    <path opacity="0.5" d="M19 19L15 15" stroke="currentColor" stroke-width="1.5" />
                                </svg>
                            </button>
                            <ul x-cloak x-show="open" x-transition x-transition.duration.300ms class="ltr:right-0 rtl:left-0 absolute z-50 mt-1 w-40 rounded-md border border-[#e0e6ed] bg-white py-1 shadow-md dark:border-[#1b2e4b] dark:bg-[#1b2e4b]">
                                <li><button type="button" class="flex w-full items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-[#253b5c]" @click="open = false; setGroup('personal')"><div class="h-2 w-2 rounded-full bg-primary ltr:mr-3 rtl:ml-3"></div>Personal</button></li>
                                <li><button type="button" class="flex w-full items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-[#253b5c]" @click="open = false; setGroup('work')"><div class="h-2 w-2 rounded-full bg-warning ltr:mr-3 rtl:ml-3"></div>Work</button></li>
                                <li><button type="button" class="flex w-full items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-[#253b5c]" @click="open = false; setGroup('social')"><div class="h-2 w-2 rounded-full bg-success ltr:mr-3 rtl:ml-3"></div>Social</button></li>
                                <li><button type="button" class="flex w-full items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-[#253b5c]" @click="open = false; setGroup('private')"><div class="h-2 w-2 rounded-full bg-danger ltr:mr-3 rtl:ml-3"></div>Private</button></li>
                            </ul>
                        </div>
                    </li>
                    <!-- Settings dropdown (Density, Page Size) - Premium Design -->
                    <li>
                        <div x-data="{ open: false }" class="dropdown relative">
                            <button type="button" class="flex items-center hover:text-primary" @click="open = !open" title="Display settings">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5">
                                    <path d="M3 6.5H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                    <path d="M3 12H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                    <path d="M3 17.5H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                    <circle cx="8" cy="6.5" r="2" fill="currentColor" opacity="0.5" />
                                    <circle cx="16" cy="12" r="2" fill="currentColor" opacity="0.5" />
                                    <circle cx="10" cy="17.5" r="2" fill="currentColor" opacity="0.5" />
                                </svg>
                            </button>
                            <!-- Backdrop -->
                            <div x-show="open" x-cloak 
                                x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
                                x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                                class="fixed inset-0 bg-black/20 dark:bg-black/40 z-[998]" @click="open = false"></div>
                            <!-- Panel -->
                            <div x-show="open" x-cloak
                                x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 -translate-y-2 scale-95" x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                                x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 translate-y-0 scale-100" x-transition:leave-end="opacity-0 -translate-y-2 scale-95"
                                class="absolute ltr:right-0 rtl:left-0 z-[999] mt-2 w-[280px] rounded-xl border border-gray-200 bg-white shadow-2xl dark:border-gray-800 dark:bg-[#0e1726] overflow-hidden"
                                @keydown.escape.window="open = false">
                                <!-- Header -->
                                <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50">
                                    <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Paramètres d'affichage</h3>
                                    <button type="button" @click="open = false" class="p-1.5 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                                        <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                    </button>
                                </div>
                                <!-- Content -->
                                <div class="p-4 space-y-5">

                                    <!-- Density -->
                                    <div>
                                        <div class="text-[10px] font-semibold mb-2 text-gray-500 dark:text-gray-500 uppercase tracking-wider">Densité</div>
                                        <div class="flex gap-2">
                                            <button type="button" @click="setDensity('compact')"
                                                class="flex-1 px-3 py-2 text-xs font-medium rounded-lg border transition-all"
                                                :class="mailDensity === 'compact' ? 'border-primary bg-primary/10 text-primary shadow-sm' : 'border-gray-200 dark:border-gray-800 text-gray-700 dark:text-gray-300 hover:border-primary/50 hover:bg-gray-50 dark:hover:bg-gray-800'">
                                                Compact
                                            </button>
                                            <button type="button" @click="setDensity('normal')"
                                                class="flex-1 px-3 py-2 text-xs font-medium rounded-lg border transition-all"
                                                :class="mailDensity === 'normal' ? 'border-primary bg-primary/10 text-primary shadow-sm' : 'border-gray-200 dark:border-gray-800 text-gray-700 dark:text-gray-300 hover:border-primary/50 hover:bg-gray-50 dark:hover:bg-gray-800'">
                                                Normal
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Rows per page -->
                                    <div>
                                        <div class="text-[10px] font-semibold mb-2 text-gray-500 dark:text-gray-500 uppercase tracking-wider">Lignes par page</div>
                                        <div class="flex flex-wrap gap-2">
                                            <template x-for="size in [10, 25, 50]" :key="size">
                                                <button type="button" @click="setPageSize(size)"
                                                    class="px-4 py-2 text-xs font-medium rounded-lg transition-all"
                                                    :class="pager.pageSize === size ? 'bg-primary text-white shadow-md' : 'bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600'"
                                                    x-text="size">
                                                </button>
                                            </template>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                    <!-- More Actions dropdown -->
                    <li>
                        <div x-data="{ open: false }" @click.outside="open = false" class="dropdown relative">
                            <button type="button" class="flex items-center hover:text-primary" @click="open = !open">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 rotate-90 opacity-70">
                                    <circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5" />
                                    <circle opacity="0.5" cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.5" />
                                    <circle cx="19" cy="12" r="2" stroke="currentColor" stroke-width="1.5" />
                                </svg>
                            </button>
                            <ul x-cloak x-show="open" x-transition x-transition.duration.300ms class="whitespace-nowrap ltr:right-0 rtl:left-0 absolute z-50 mt-1 w-44 rounded-md border border-[#e0e6ed] bg-white py-1 shadow-md dark:border-[#1b2e4b] dark:bg-[#1b2e4b]">
                                <li><button type="button" class="flex w-full items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-[#253b5c]" @click="open = false; showSignature = true; isEdit = false; selectedMail = null; showTemplates = false">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="ltr:mr-2 rtl:ml-2"><path d="M12 19H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M16.5 3.50001C16.7626 3.23737 17.0744 3.02902 17.4176 2.88688C17.7608 2.74474 18.1286 2.67157 18.5 2.67157C18.8714 2.67157 19.2392 2.74474 19.5824 2.88688C19.9256 3.02902 20.2374 3.23737 20.5 3.50001C20.7626 3.76265 20.971 4.07446 21.1131 4.41765C21.2553 4.76084 21.3284 5.12862 21.3284 5.50001C21.3284 5.87141 21.2553 6.23919 21.1131 6.58238C20.971 6.92556 20.7626 7.23737 20.5 7.50001L7.5 20.5L2 22L3.5 16.5L16.5 3.50001Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    Signatures</button></li>
                                <li class="border-b border-[#e0e6ed] dark:border-[#1b2e4b] my-1"></li>
                                <li><button type="button" class="flex w-full items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-[#253b5c]" @click="open = false; setAction('read')">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="ltr:mr-2 rtl:ml-2"><path d="M3 18L3 6C3 4.34315 4.34315 3 6 3H18C19.6569 3 21 4.34315 21 6V18C21 19.6569 19.6569 21 18 21H6C4.34315 21 3 19.6569 3 18Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M6 8L8.1589 9.79908C9.99553 11.3296 10.9139 12.0949 12 12.0949C13.0861 12.0949 14.0045 11.3296 15.8411 9.79908L18 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                    Mark as Read</button></li>
                                <li><button type="button" class="flex w-full items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-[#253b5c]" @click="open = false; setAction('unread')">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="ltr:mr-2 rtl:ml-2"><path d="M2 12C2 8.229 2 6.343 3.172 5.172C4.343 4 6.229 4 10 4H14C17.771 4 19.657 4 20.828 5.172C22 6.343 22 8.229 22 12C22 15.771 22 17.657 20.828 18.828C19.657 20 17.771 20 14 20H10C6.229 20 4.343 20 3.172 18.828C2 17.657 2 15.771 2 12Z" stroke="currentColor" stroke-width="1.5"/><path d="M6 8L8.159 9.799C9.996 11.33 10.914 12.095 12 12.095C13.086 12.095 14.005 11.33 15.841 9.799L18 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                    Mark as Unread</button></li>
                                <li><button type="button" class="flex w-full items-center px-4 py-2 hover:bg-gray-100 dark:hover:bg-[#253b5c]" @click="open = false; setAction('trash')">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="ltr:mr-2 rtl:ml-2"><path d="M20.5 6H3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M18.833 8.5L18.374 15.399C18.197 18.054 18.108 19.382 17.243 20.191C16.378 21 15.048 21 12.387 21H11.613C8.953 21 7.622 21 6.757 20.191C5.892 19.382 5.804 18.054 5.627 15.399L5.167 8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                    Trash</button></li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </template>
            <!-- Trash tab: Restore/Delete actions -->
            <template x-if="selectedTab === 'trash'">
                <ul class="flex grow items-center gap-4 sm:flex-none ltr:sm:mr-4 rtl:sm:ml-4">
                    <li><button type="button" class="flex items-center hover:text-primary" @click="setAction('restore')" title="Restore">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5"><path d="M12.0789 3V2.25V3ZM3.67981 11.3333H2.92981H3.67981ZM3.67981 13L3.15157 13.5324C3.44398 13.8225 3.91565 13.8225 4.20805 13.5324L3.67981 13ZM19.8934 6.60721C18.287 3.99427 15.3873 2.25 12.0789 2.25V3.75C14.8484 3.75 17.2727 5.20845 18.6156 7.39279L19.8934 6.60721Z" fill="currentColor" /></svg>
                        Restore</button></li>
                    <li><button type="button" class="flex items-center hover:text-danger" @click="setAction('delete')" title="Permanently Delete">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5"><path d="M20.5 6H3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M18.833 8.5L18.374 15.399C18.197 18.054 18.108 19.382 17.243 20.191C16.378 21 15.048 21 12.387 21H11.613C8.953 21 7.622 21 6.757 20.191C5.892 19.382 5.804 18.054 5.627 15.399L5.167 8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        Delete</button></li>
                </ul>
            </template>
        </div>
        <!-- Search + Pagination -->
        <div class="flex w-full items-center justify-between sm:w-auto">
            <div class="flex items-center ltr:mr-4 rtl:ml-4">
                <button type="button" class="block hover:text-primary ltr:mr-3 rtl:ml-3 xl:hidden" @click="isShowMailMenu = !isShowMailMenu">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6"><path d="M20 7L4 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><path d="M20 12L4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><path d="M20 17L4 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </button>
                <div class="group relative">
                    <input type="search" name="mail-search-filter" class="peer form-input ltr:pr-8 rtl:pl-8" placeholder="Search Mail" x-model="searchText" @keyup="searchMails()" autocomplete="new-password" />
                    <div class="absolute top-1/2 -translate-y-1/2 peer-focus:text-primary ltr:right-[11px] rtl:left-[11px]">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="11.5" cy="11.5" r="9.5" stroke="currentColor" stroke-width="1.5" opacity="0.5" /><path d="M18.5 18.5L22 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                    </div>
                </div>
            </div>
            <div class="flex items-center space-x-1 rtl:space-x-reverse">
                <span class="text-xs text-white-dark" x-text="pager.startIndex + 1 + '-' + (pager.endIndex + 1) + ' of ' + filteredMailList.length"></span>
                <button type="button" class="rounded-md p-1 enabled:hover:bg-primary-light disabled:cursor-not-allowed disabled:opacity-60 dark:enabled:hover:bg-[#191e3a]" :disabled="pager.currentPage === 1" @click="pager.currentPage--; searchMails(false)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 5L9 12L15 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <button type="button" class="rounded-md p-1 enabled:hover:bg-primary-light disabled:cursor-not-allowed disabled:opacity-60 dark:enabled:hover:bg-[#191e3a]" :disabled="pager.currentPage === pager.totalPages" @click="pager.currentPage++; searchMails(false)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 5L15 12L9 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Label Filter Chips (like the Vristo demo image) -->
    <div class="flex flex-wrap items-center gap-3 border-b border-[#e0e6ed] px-4 pb-4 dark:border-[#1b2e4b]">
        <button type="button"
            class="flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold transition-all duration-300"
            :class="activeGroupFilter === 'personal' ? 'border-primary bg-primary text-white shadow-md shadow-primary/30' : 'border-primary/30 text-primary hover:bg-primary/10 dark:border-primary/50'"
            @click="toggleGroupFilter('personal')">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/><path d="M5 20c0-2.761 2.239-5 5-5h4c2.761 0 5 2.239 5 5" stroke="currentColor" stroke-width="2"/></svg>
            Personal
        </button>
        <button type="button"
            class="flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold transition-all duration-300"
            :class="activeGroupFilter === 'work' ? 'border-warning bg-warning text-white shadow-md shadow-warning/30' : 'border-warning/30 text-warning hover:bg-warning/10 dark:border-warning/50'"
            @click="toggleGroupFilter('work')">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="7" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" stroke="currentColor" stroke-width="2"/></svg>
            Work
        </button>
        <button type="button"
            class="flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold transition-all duration-300"
            :class="activeGroupFilter === 'social' ? 'border-success bg-success text-white shadow-md shadow-success/30' : 'border-success/30 text-success hover:bg-success/10 dark:border-success/50'"
            @click="toggleGroupFilter('social')">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="9" cy="7" r="3" stroke="currentColor" stroke-width="2"/><circle cx="15" cy="7" r="3" stroke="currentColor" stroke-width="2"/><path d="M3 19c0-2.761 2.239-5 5-5h2" stroke="currentColor" stroke-width="2"/><path d="M14 14h2c2.761 0 5 2.239 5 5" stroke="currentColor" stroke-width="2"/></svg>
            Social
        </button>
        <button type="button"
            class="flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold transition-all duration-300"
            :class="activeGroupFilter === 'private' ? 'border-danger bg-danger text-white shadow-md shadow-danger/30' : 'border-danger/30 text-danger hover:bg-danger/10 dark:border-danger/50'"
            @click="toggleGroupFilter('private')">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 11V7a4 4 0 118 0v4" stroke="currentColor" stroke-width="2"/></svg>
            Private
        </button>
    </div>

    <!-- Mail Table -->
    <template x-if="pagedMails.length">
        <div class="table-responsive min-h-[300px] grow overflow-y-auto sm:min-h-[400px]">
            <table class="table-hover" :class="{ 'mail-compact': mailDensity === 'compact' }">
                <tbody>
                    <template x-for="mail in pagedMails" :key="mail.id">
                        <tr class="cursor-pointer" :class="{'font-semibold' : mail.isUnread}" @click="selectMail(mail)" :style="mailDensity === 'compact' ? 'height: 36px' : ''">
                            <td>
                                <div class="flex items-center whitespace-nowrap">
                                    <div class="ltr:mr-3 rtl:ml-3">
                                        <input type="checkbox" :id="'chk-' + mail.id" x-model.number="ids" :value="mail.id" @click.stop class="form-checkbox" />
                                    </div>
                                    <div class="ltr:mr-3 rtl:ml-3">
                                        <button type="button" class="flex items-center enabled:hover:text-warning disabled:opacity-60" :class="{ 'text-warning': mail.isStar }" @click.stop="setStar(mail.id)" :disabled="selectedTab === 'trash'">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" :class="{ 'fill-warning': mail.isStar }">
                                                <path d="M9.15316 5.40838C10.4198 3.13613 11.0531 2 12 2C12.9469 2 13.5802 3.13612 14.8468 5.40837L15.1745 5.99623C15.5345 6.64193 15.7144 6.96479 15.9951 7.17781C16.2757 7.39083 16.6251 7.4699 17.3241 7.62805L17.9605 7.77203C20.4201 8.32856 21.65 8.60682 21.9426 9.54773C22.2352 10.4886 21.3968 11.4691 19.7199 13.4299L19.2861 13.9372C18.8096 14.4944 18.5713 14.773 18.4641 15.1177C18.357 15.4624 18.393 15.8341 18.465 16.5776L18.5306 17.2544C18.7841 19.8706 18.9109 21.1787 18.1449 21.7602C17.3788 22.3417 16.2273 21.8115 13.9243 20.7512L13.3285 20.4768C12.6741 20.1755 12.3469 20.0248 12 20.0248C11.6531 20.0248 11.3259 20.1755 10.6715 20.4768L10.0757 20.7512C7.77268 21.8115 6.62118 22.3417 5.85515 21.7602C5.08912 21.1787 5.21588 19.8706 5.4694 17.2544L5.53498 16.5776C5.60703 15.8341 5.64305 15.4624 5.53586 15.1177C5.42868 14.773 5.19043 14.4944 4.71392 13.9372L4.2801 13.4299C2.60325 11.4691 1.76482 10.4886 2.05742 9.54773C2.35002 8.60682 3.57986 8.32856 6.03954 7.77203L6.67589 7.62805C7.37485 7.4699 7.72433 7.39083 8.00494 7.17781C8.28555 6.96479 8.46553 6.64194 8.82547 5.99623L9.15316 5.40838Z" stroke="currentColor" stroke-width="1.5" />
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="ltr:mr-3 rtl:ml-3">
                                        <button type="button" class="flex items-center enabled:hover:text-primary disabled:opacity-60" :class="{ 'text-primary': mail.isImportant }" @click.stop="setImportant(mail.id)" :disabled="selectedTab === 'trash'">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" :class="{ 'fill-primary': mail.isImportant }">
                                                <path d="M21 16.0909V11.0975C21 6.80891 21 4.6646 19.682 3.3323C18.364 2 16.2426 2 12 2C7.75736 2 5.63604 2 4.31802 3.3323C3 4.6646 3 6.80891 3 11.0975V16.0909C3 19.1875 3 20.7358 3.73411 21.4123C4.08421 21.735 4.52615 21.9377 4.99692 21.9915C5.98402 22.1045 7.13673 21.0849 9.44216 19.0458C10.4612 18.1445 10.9708 17.6938 11.5603 17.5751C11.8506 17.5166 12.1494 17.5166 12.4397 17.5751C13.0292 17.6938 13.5388 18.1445 14.5578 19.0458C16.8633 21.0849 18.016 22.1045 19.0031 21.9915C19.4739 21.9377 19.9158 21.735 20.2659 21.4123C21 20.7358 21 19.1875 21 16.0909Z" stroke="currentColor" stroke-width="1.5" />
                                            </svg>
                                        </button>
                                    </div>
                                    <!-- Avatar or initial -->
                                    <div class="ltr:mr-3 rtl:ml-3">
                                        <div class="flex items-center justify-center rounded-full text-sm font-semibold"
                                            :class="[
                                                mail.isStar ? 'bg-warning/20 text-warning' : 'bg-primary/10 text-primary',
                                                mailDensity === 'compact' ? 'h-6 w-6 text-xs' : 'h-8 w-8'
                                            ]">
                                            <span x-text="(mail.firstName ? mail.firstName[0] : '') + (mail.lastName ? mail.lastName[0] : '')"></span>
                                        </div>
                                    </div>
                                    <div class="whitespace-nowrap font-semibold dark:text-gray-300" :class="{ 'text-gray-500 dark:text-gray-500 font-normal': !mail.isUnread }" x-text="mail.firstName ? mail.firstName + ' ' + (mail.lastName || '') : mail.email"></div>
                                </div>
                            </td>
                            <td>
                                <div class="min-w-[300px] overflow-hidden font-medium text-white-dark line-clamp-1">
                                    <span :class="{ 'text-gray-800 dark:text-gray-300 font-semibold': mail.isUnread }">
                                        <span x-text="mail.title"></span> &minus; <span x-text="mail.displayDescription"></span>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="flex items-center whitespace-nowrap">
                                    <!-- Attachment icon (like in the image) -->
                                    <template x-if="mail.attachments && mail.attachments.length">
                                        <div class="ltr:mr-4 rtl:ml-4 flex items-center text-success" title="Has attachments">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M7.918 17.807L16.702 9.023C17.09 8.635 17.09 8.003 16.702 7.615C16.314 7.227 15.682 7.227 15.294 7.615L6.51 16.399C5.34 17.569 5.34 19.453 6.51 20.623C7.68 21.793 9.564 21.793 10.734 20.623L19.518 11.839C21.47 9.887 21.47 6.721 19.518 4.769C17.566 2.817 14.4 2.817 12.448 4.769L3.664 13.553" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </div>
                                    </template>
                                    <!-- Group dot -->
                                    <template x-if="mail.group">
                                        <div class="h-2 w-2 rounded-full ltr:mr-3 rtl:ml-3" :class="{ 'bg-primary': mail.group === 'personal', 'bg-warning': mail.group === 'work', 'bg-success': mail.group === 'social', 'bg-danger': mail.group === 'private' }"></div>
                                    </template>
                                </div>
                            </td>
                            <td class="whitespace-nowrap font-medium ltr:text-right rtl:text-left" x-text="showTime(mail)"></td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </template>
    <!-- Empty State -->
    <template x-if="!pagedMails.length">
        <div class="grid h-full min-h-[300px] place-content-center text-lg font-semibold text-white-dark">No data available</div>
    </template>
</div>
