<div x-data="kanbanBoard">
    <div class="space-y-6">
        <div class="flex items-center justify-between mb-5">
            <h5 class="text-lg font-semibold dark:text-white-light">
                <%= view.name %> (Kanban) - <%= entity.name %>
            </h5>
            <div class="flex items-center gap-3">
                <button class="btn btn-outline-primary btn-sm" @click="openConfig()">
                    <iconify-icon icon="solar:settings-bold" class="mr-1"></iconify-icon> Configurer
                </button>
                <a href="/account/<%= account_number %>/record/<%= entity.slug %>/add" class="btn btn-primary">Ajouter
                    un record</a>
            </div>
        </div>

        <!-- Kanban Wrapper -->
        <div class="flex gap-5 overflow-x-auto pb-4 scrollbar-thin">
            <template x-for="column in columns" :key="column.id">
                <div
                    class="flex-shrink-0 w-80 bg-gray-50 dark:bg-black/20 rounded-lg p-4 h-fit min-h-[500px] border border-gray-200 dark:border-gray-800">
                    <div class="flex items-center justify-between mb-4">
                        <h6 class="font-bold flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full"
                                :style="'background-color:' + (column.color || '#3b82f6')"></span>
                            <span x-text="column.name"></span>
                            <span class="text-xs bg-gray-200 dark:bg-gray-700 px-2 py-0.5 rounded-full text-gray-500"
                                x-text="getRecordsInColumn(column.name).length"></span>
                        </h6>
                    </div>

                    <div class="space-y-3 min-h-[100px]" @dragover.prevent @drop="dropRecord($event, column.name)">
                        <template x-for="record in getRecordsInColumn(column.name)" :key="record.id">
                            <div class="bg-white dark:bg-[#0e1726] p-3 rounded shadow-sm border border-transparent hover:border-primary/30 cursor-grab active:cursor-grabbing group transition-all"
                                draggable="true" @dragstart="dragStart($event, record.id)">
                                <div class="font-semibold text-sm mb-2" x-text="record.title"></div>

                                <!-- Custom fields preview -->
                                <div class="space-y-1">
                                    <template x-for="field in record.previewFields" :key="field.id">
                                        <div class="text-[10px] text-gray-500 flex items-center gap-1">
                                            <span class="font-medium" x-text="field.label + ':'"></span>
                                            <span x-text="field.value"></span>
                                        </div>
                                    </template>
                                </div>

                                <div
                                    class="mt-3 pt-2 border-t border-gray-100 dark:border-gray-800 flex items-center justify-between opacity-0 group-hover:opacity-100 transition-opacity">
                                    <span class="text-[10px] text-gray-400" x-text="record.date"></span>
                                    <a :href="'/account/<%= account_number %>/record/<%= entity.slug %>/edit/' + record.id"
                                        class="text-primary hover:underline text-xs">Modifier</a>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </template>

            <!-- Add Column Placeholder -->
            <button
                class="flex-shrink-0 w-80 border-2 border-dashed border-gray-200 dark:border-gray-800 rounded-lg flex items-center justify-center p-4 text-gray-400 hover:text-primary hover:border-primary transition-all group">
                <div class="flex flex-col items-center gap-2">
                    <iconify-icon icon="solar:add-circle-bold" width="24"></iconify-icon>
                    <span class="text-sm font-medium">Ajouter une étape</span>
                </div>
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("alpine:init", () => {
        Alpine.data("kanbanBoard", () => ({
            records: <% - JSON.stringify(records.map(r => ({
                id: r._id,
                title: r.title || r.slug,
                status: r.status || 'À faire', // Mock status if not present
                date: new Date(r.createdAt).toLocaleDateString(),
                previewFields: r.customFields.slice(0, 2).map(cf => ({
                    label: cf.field_id ? cf.field_id.label : '?',
                    value: cf.value
                }))
            }))) %>,
            columns: [
                { id: 1, name: 'À faire', color: '#64748b' },
                { id: 2, name: 'En cours', color: '#3b82f6' },
                { id: 3, name: 'Terminé', color: '#22c55e' }
            ],

            getRecordsInColumn(columnName) {
                return this.records.filter(r => r.status === columnName);
            },

            dragStart(event, recordId) {
                event.dataTransfer.setData("recordId", recordId);
            },

            dropRecord(event, newStatus) {
                const recordId = event.dataTransfer.getData("recordId");
                const record = this.records.find(r => r.id == recordId);
                if (record && record.status !== newStatus) {
                    record.status = newStatus;
                    // In real implementation, send AJAX to update record status
                    console.log(`Updating record ${recordId} to status ${newStatus}`);
                }
            },

            openConfig() {
                alert("Configuration des colonnes bientôt disponible");
            }
        }));
    });
</script>