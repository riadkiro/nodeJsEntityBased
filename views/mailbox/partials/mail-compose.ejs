<!-- ========== COMPOSE / EDIT VIEW ========== -->
<div x-show="isEdit" class="h-full" style="display: none;">
    <form class="flex h-full min-h-0 flex-col bg-white dark:bg-[#0e1726]" @submit.prevent="saveMail('send', params.id)">
        <div class="flex shrink-0 items-center justify-between border-b border-[#e8ecf3] px-4 py-3 dark:border-[#1b2e4b]">
            <div class="flex min-w-0 items-center gap-3">
                <button type="button" class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-[#e0e6ed] text-[#68758d] hover:border-primary/40 hover:text-primary dark:border-[#1b2e4b]" @click="closeMsgPopUp()" aria-label="Retour">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 5L9 12L15 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="min-w-0">
                    <h4 class="truncate text-base font-bold text-[#172033] dark:text-gray-200" x-text="params.id ? 'Modifier le message' : 'Nouveau message'"></h4>
                    <p class="truncate text-xs text-[#8b97ad]" x-text="activeAccount ? activeAccount.email : params.from"></p>
                </div>
            </div>
            <span x-show="params.id" class="rounded-full bg-warning/10 px-2.5 py-1 text-[11px] font-bold text-warning">Brouillon</span>
        </div>

        <div class="shrink-0 space-y-2.5 border-b border-[#edf0f5] px-4 py-3 dark:border-[#1b2e4b]">
            <div class="grid grid-cols-1 gap-2.5 md:grid-cols-2">
                <label class="flex h-10 items-center rounded-lg border border-[#dfe5ef] bg-white px-3 transition focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/10 dark:border-[#263754] dark:bg-[#111c2f]">
                    <span class="w-9 shrink-0 text-xs font-bold text-[#71809a]">À</span>
                    <input id="to" type="text" class="min-w-0 flex-1 border-0 bg-transparent p-0 text-sm outline-none placeholder:text-[#b2bdcd]" placeholder="destinataire@exemple.com" x-model="params.to" required autocomplete="off" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" />
                </label>
                <label class="flex h-10 items-center rounded-lg border border-[#dfe5ef] bg-white px-3 transition focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/10 dark:border-[#263754] dark:bg-[#111c2f]">
                    <span class="w-9 shrink-0 text-xs font-bold text-[#71809a]">Cc</span>
                    <input id="cc" type="text" class="min-w-0 flex-1 border-0 bg-transparent p-0 text-sm outline-none placeholder:text-[#b2bdcd]" placeholder="Copie (facultatif)" x-model="params.cc" autocomplete="off" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" />
                </label>
            </div>

            <div class="flex items-center gap-2">
                <label class="flex h-10 min-w-0 flex-1 items-center rounded-lg border border-[#dfe5ef] bg-white px-3 transition focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/10 dark:border-[#263754] dark:bg-[#111c2f]">
                    <span class="w-14 shrink-0 text-xs font-bold text-[#71809a]">Objet</span>
                    <input id="title" type="text" class="min-w-0 flex-1 border-0 bg-transparent p-0 text-sm outline-none placeholder:text-[#b2bdcd]" placeholder="Objet du message" x-model="params.title" required autocomplete="off" />
                </label>
                <input x-ref="attachmentInput" type="file" class="hidden" multiple @change="handleFiles($event)" />
                <button type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-[#dfe5ef] text-[#6d7b94] transition hover:border-primary/40 hover:bg-primary/5 hover:text-primary dark:border-[#263754]" @click="$refs.attachmentInput.click()" title="Ajouter une pièce jointe" aria-label="Ajouter une pièce jointe">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M8.5 12.5L14.9 6.1C16.1 4.9 18.1 4.9 19.3 6.1C20.5 7.3 20.5 9.3 19.3 10.5L10.8 19C8.8 21 5.6 21 3.6 19C1.6 17 1.6 13.8 3.6 11.8L12 3.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button type="button" class="flex h-10 shrink-0 items-center gap-1.5 rounded-lg border border-[#dfe5ef] px-3 text-xs font-bold text-[#65738d] transition hover:border-primary/40 hover:bg-primary/5 hover:text-primary dark:border-[#263754]" @click="showComposeOptions = !showComposeOptions" :aria-expanded="showComposeOptions">
                    Plus
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="transition-transform" :class="showComposeOptions ? 'rotate-180' : ''"><path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </div>

            <template x-if="params.attachments && params.attachments.length">
                <div class="flex flex-wrap gap-1.5">
                    <template x-for="(file, i) in params.attachments" :key="file.name + '-' + i">
                        <span class="inline-flex max-w-[260px] items-center gap-1.5 rounded-full border border-primary/15 bg-primary/5 px-2.5 py-1 text-xs text-primary">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M8.5 12.5L14.9 6.1C16.1 4.9 18.1 4.9 19.3 6.1C20.5 7.3 20.5 9.3 19.3 10.5L10.8 19C8.8 21 5.6 21 3.6 19C1.6 17 1.6 13.8 3.6 11.8L12 3.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                            <span class="truncate" x-text="file.name"></span>
                            <span class="text-[10px] text-primary/60" x-text="file.size"></span>
                            <button type="button" class="grid h-4 w-4 place-items-center rounded-full hover:bg-primary/10" @click="params.attachments.splice(i, 1)" aria-label="Retirer">&times;</button>
                        </span>
                    </template>
                </div>
            </template>

            <div x-show="showComposeOptions" x-transition class="grid grid-cols-1 gap-2.5 rounded-lg border border-[#e7ebf2] bg-[#fafbfe] p-2.5 md:grid-cols-2 dark:border-[#263754] dark:bg-[#111c2f]" style="display: none;">
                <label x-show="templates.length > 0" class="flex items-center gap-2">
                    <span class="shrink-0 text-xs font-bold text-[#71809a]">Modèle</span>
                    <select class="form-select h-9 flex-1 py-1.5 text-xs" @change="applyTemplate($event.target.value)">
                        <option value="">Aucun modèle</option>
                        <template x-for="(tpl, idx) in templates" :key="idx"><option :value="idx" x-text="tpl.name"></option></template>
                    </select>
                </label>
                <label x-show="signatures.length > 0" class="flex items-center gap-2">
                    <span class="shrink-0 text-xs font-bold text-[#71809a]">Signature</span>
                    <select class="form-select h-9 flex-1 py-1.5 text-xs" x-model="selectedSignatureIdx" @change="applySignature()">
                        <option value="-1">Aucune signature</option>
                        <template x-for="(sig, idx) in signatures" :key="idx"><option :value="idx" x-text="sig.name"></option></template>
                    </select>
                </label>
            </div>
        </div>

        <div class="mail-compose-editor-shell min-h-0 flex-1 overflow-y-auto px-4 py-3">
            <div id="editor" class="quill-editor h-full min-h-[220px]"></div>
        </div>

        <div class="flex shrink-0 flex-wrap items-center justify-between gap-2 border-t border-[#e8ecf3] px-4 py-3 dark:border-[#1b2e4b]">
            <button type="button" class="btn btn-outline-secondary btn-sm" @click="closeMsgPopUp()">Annuler</button>
            <div class="flex items-center gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm" :disabled="sendingMail" @click="saveMail('draft', params.id)">Enregistrer le brouillon</button>
                <button type="submit" class="btn btn-primary btn-sm gap-2" :disabled="sendingMail">
                    <svg x-show="!sendingMail" width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M17.5 18.5L20.6 9.1C21.9 5.3 22.5 3.5 21.5 2.5C20.5 1.5 18.7 2.1 14.9 3.4L5.6 6.5C3.5 7.2 2.5 7.5 2.1 8.3C1.8 9.1 2.7 10.4 4.3 12L5 12.7C5.3 13 5.4 13.5 5.3 14L5.1 16.9C5.3 18 6 18.7 7.1 18.9L10 18.7C10.5 18.6 11 18.7 11.3 19L12 19.7C13.6 21.3 14.9 22.2 15.7 21.9C16.5 21.5 16.8 20.5 17.5 18.5Z" stroke="currentColor" stroke-width="1.5"/><path d="M6 18L21 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    <svg x-show="sendingMail" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle class="opacity-30" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3"/><path d="M21 12a9 9 0 00-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                    <span x-text="sendingMail ? 'Envoi…' : 'Envoyer'"></span>
                </button>
            </div>
        </div>
    </form>
</div>
