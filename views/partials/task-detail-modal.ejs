<!-- ═══ Modal HTML ═══ -->
<div x-data x-show="$store.taskModal.task" x-cloak>
    <div class="tdm-backdrop" :class="{'open': $store.taskModal.task}" @click.self="$store.taskModal.close()">
	        <div class="tdm-modal" @keydown.escape.window="$store.taskModal.close()" @click="$store.taskModal.closeMenus()">
            <template x-if="$store.taskModal.task">
                <div class="tdm-shell">
                    <div class="tdm-head">
                        <span class="tdm-head-icon">
                            <iconify-icon :icon="$store.taskModal.task.listIcon || 'solar:checklist-bold-duotone'" width="16"></iconify-icon>
                        </span>
                        <span class="tdm-head-label" x-text="$store.taskModal.task.listLabel || 'Liste des tâches'"></span>
                        <button class="tdm-close" type="button" @click="$store.taskModal.close()"><iconify-icon icon="solar:close-circle-linear" width="18"></iconify-icon></button>
                    </div>

                    <div class="tdm-body">
                        <div class="tdm-main">
                            <input type="text" class="tdm-title-input" placeholder="Titre de la tâche..." x-model="$store.taskModal.task.title" @change="$store.taskModal.updateField('title', $store.taskModal.task.title)">

                            <div class="tdm-subtasks">
                                <div class="tdm-section-row">
                                    <div class="tdm-section-label">Sous-tâches</div>
                                    <span class="tdm-foot-created" x-text="$store.taskModal.subtaskProgressLabel()"></span>
                                </div>
                                <form class="tdm-subtask-add" @submit.prevent="$store.taskModal.addSubtask()">
                                    <input class="tdm-subtask-input"
                                           type="text"
                                           placeholder="Ajouter une sous-tâche..."
                                           x-model="$store.taskModal.newSubtaskTitle">
                                    <button class="tdm-subtask-add-btn" type="submit" :disabled="!$store.taskModal.newSubtaskTitle.trim()" title="Ajouter">
                                        <iconify-icon icon="solar:add-circle-bold" width="15"></iconify-icon>
                                    </button>
                                </form>
                                <div class="tdm-subtask-list" x-show="$store.taskModal.subtasks().length > 0">
                                    <template x-for="subtask in $store.taskModal.subtasks()" :key="subtask._id || subtask.order + '-' + subtask.title">
                                        <div class="tdm-subtask-row" :class="{ 'is-done': subtask.done }">
                                            <button type="button"
                                                    class="tdm-subtask-check"
                                                    :class="{ 'is-done': subtask.done }"
                                                    :title="subtask.done ? 'Décocher' : 'Cocher'"
                                                    @click="$store.taskModal.toggleSubtask(subtask)">
                                                <iconify-icon icon="solar:check-read-linear" width="12"></iconify-icon>
                                            </button>
                                            <span class="tdm-subtask-title" x-text="subtask.title"></span>
                                            <button type="button" class="tdm-subtask-remove" title="Supprimer" @click="$store.taskModal.removeSubtask(subtask)">
                                                <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="13"></iconify-icon>
                                            </button>
                                        </div>
                                    </template>
                                </div>
                            </div>

                            <div class="tdm-section-row">
                                <div class="tdm-section-label">Description</div>
                            </div>
                            <div class="tdm-desc-editor dx-rte" @click.stop
                                 x-init="$store.taskModal.initDescriptionEditor($el)"
                                 x-effect="$store.taskModal.syncDescriptionEditor()">
                                <div class="dx-rte-toolbar" data-dx-rte-toolbar></div>
                                <input class="tdm-hidden-input" data-task-description-image type="file" accept="image/*" multiple @change="$store.taskModal.descriptionEditorInstance?.handleImageFiles($event.target.files); $event.target.value = ''">
                                <div class="tdm-desc-area"
                                     data-dx-rte-editor
                                     contenteditable="true"
                                     data-placeholder="Ajouter une description détaillée...">
                                </div>
                                <div class="dx-rte-image-toolbar" data-dx-rte-image-toolbar></div>
                            </div>
                            <div class="tdm-desc-status" x-text="$store.taskModal.descriptionStatus"></div>

                            <div class="tdm-attachments">
                                <div class="tdm-section-row">
                                    <div class="tdm-section-label">Pièces jointes</div>
                                    <button class="tdm-mini-btn" type="button" @click.stop="$refs.taskAttachmentInput.click()" :disabled="$store.taskModal.uploadBusy">
                                        <iconify-icon icon="solar:paperclip-rounded-linear" width="14"></iconify-icon>
                                        Ajouter
                                    </button>
                                </div>
                                <input class="tdm-hidden-input" x-ref="taskAttachmentInput" type="file" multiple @change="$store.taskModal.uploadAttachments($event.target.files); $event.target.value = ''">
                                <div class="tdm-attachment-drop" @dragover.prevent @drop.prevent="$store.taskModal.uploadAttachments($event.dataTransfer.files)">
                                    <template x-if="!($store.taskModal.task.attachments || []).length">
                                        <div class="tdm-attachment-empty" x-text="$store.taskModal.uploadBusy ? 'Ajout en cours...' : 'Déposez des fichiers ici ou utilisez Ajouter'"></div>
                                    </template>
                                    <template x-for="attachment in ($store.taskModal.task.attachments || [])" :key="attachment._id || attachment.filename">
                                        <div class="tdm-attachment-item">
                                            <span class="tdm-attachment-icon">
                                                <iconify-icon :icon="$store.taskModal.attachmentIcon(attachment)" width="15"></iconify-icon>
                                            </span>
	                                            <button class="tdm-attachment-meta tdm-attachment-open" type="button" @click.stop="$store.taskModal.openAttachmentViewer(attachment, $store.taskModal.task.attachments || [])">
	                                                <span class="tdm-attachment-name" x-text="attachment.originalName || attachment.filename || 'Fichier'"></span>
	                                                <span class="tdm-attachment-size" x-text="$store.taskModal.formatBytes(attachment.size)"></span>
	                                            </button>
                                            <button class="tdm-attachment-remove" type="button" title="Retirer" @click.stop="$store.taskModal.deleteAttachment(attachment)">
                                                <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="14"></iconify-icon>
                                            </button>
                                        </div>
                                    </template>
	        </div>
	    </div>
		</div>

                        <div class="tdm-props">
                            <div class="tdm-prop">
                                <span class="tdm-prop-icon"><iconify-icon icon="solar:check-circle-linear" width="15"></iconify-icon></span>
