                  <form @submit.prevent="submitCreateItem">
                    <div class="relative mb-4">
                      <label class="mb-2 block text-sm font-bold">Nom</label>
                      <input type="text" x-model="creationName" x-ref="createInput" placeholder="Entrez le nom..."
                        class="form-input w-full" />
                    </div>
