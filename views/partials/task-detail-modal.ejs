	        async uploadDescriptionImages(files) {
	            const images = Array.from(files || []).filter(file => file && String(file.type || '').startsWith('image/'));
	            if (!this.task?._id || !images.length || this.uploadBusy) return [];
	            const before = new Set((this.task.attachments || []).map(att => att._id || att.filename));
	            const draftDescription = this.descriptionEditorInstance?.getHtml()
	                || this.sanitizeDescriptionHtml(this.descriptionEditor()?.innerHTML || this.task.description || '');
	            this.uploadBusy = true;
	            try {
	                const body = new FormData();
	                images.forEach(file => body.append('files', file, file.name || 'image.png'));
	                const res = await fetch(API + '/api/record-tasks/' + this.task._id + '/attachments', {
	                    method: 'POST',
	                    credentials: 'include',
	                    body
	                });
	                const data = await res.json().catch(() => ({}));
	                if (!res.ok || data.success === false) throw new Error(data.error || 'Upload impossible');
	                this.task = data.task
	                    ? { ...this.task, ...data.task, description: draftDescription }
	                    : { ...this.task, attachments: data.attachments || [], description: draftDescription };
	                if (this._onUpdate) this._onUpdate(this.task._id, 'attachments', this.task.attachments || [], this.task);
	                const inserted = (this.task.attachments || [])
	                    .filter(att => !before.has(att._id || att.filename) && this.isImageAttachment(att));
	                if (window.showMessage) window.showMessage('Image ajoutée', 'success');
	                return inserted.map(att => ({
	                    url: this.attachmentUrl(att),
	                    alt: this.attachmentName(att)
	                }));
	            } catch (e) {
	                console.error('[TaskModal] Description image upload error:', e);
	                if (window.showMessage) window.showMessage(e.message || 'Erreur lors de l’ajout de l’image', 'danger');
	                return [];
	            } finally {
	                this.uploadBusy = false;
	            }
	        },

        async updateField(field, value, options = {}) {
            if (!this.task?._id) return;
            try {
                const body = {};
                body[field] = value;
                const res = await fetch(API + '/api/record-tasks/' + this.task._id, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(body)
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Mise à jour impossible');
                const currentListOptions = this.listOptions || this.task.listOptions || [];
                const updatedTask = data.task ? { ...this.task, ...data.task } : { ...this.task, [field]: value };
	                this.task = updatedTask;
	                if (Array.isArray(updatedTask.statuses)) this.statusOptions = this.normalizeOptions(updatedTask.statuses, this.defaults.statuses);
	                if (Array.isArray(updatedTask.priorities)) this.priorityOptions = this.normalizeOptions(updatedTask.priorities, this.defaults.priorities);
	                if (Array.isArray(updatedTask.tagOptions)) {
	                    this.tagOptions = this.normalizeOptions(updatedTask.tagOptions, []);
	                    this.task.tagOptions = this.tagOptions;
	                }
	                this.listOptions = this.normalizeListOptions(updatedTask.listOptions || currentListOptions);
	                this.task.listOptions = this.listOptions;
	                if (Array.isArray(updatedTask.tags)) this.task.tags = this.normalizeTaskTags(updatedTask.tags, this.tagOptions);
	                if (Array.isArray(updatedTask.subtasks)) this.task.subtasks = this.normalizeSubtasks(updatedTask.subtasks);
	                if (this._onUpdate) this._onUpdate(this.task._id, field, value, updatedTask);
                if (!options.silent && window.showMessage) window.showMessage('Tâche mise à jour', 'success');
                return true;
            } catch (e) {
                console.error('[TaskModal] Update error:', e);
                if (window.showMessage) window.showMessage('Erreur lors de la mise à jour', 'danger');
                return false;
            }
        },

        async uploadAttachments(files) {
            const list = Array.from(files || []).filter(Boolean);
            if (!this.task?._id || !list.length || this.uploadBusy) return;
            this.uploadBusy = true;
            try {
                const body = new FormData();
                list.forEach(file => body.append('files', file));
                const res = await fetch(API + '/api/record-tasks/' + this.task._id + '/attachments', {
                    method: 'POST',
                    credentials: 'include',
                    body
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Upload impossible');
                this.task = data.task ? { ...this.task, ...data.task } : { ...this.task, attachments: data.attachments || [] };
                if (this._onUpdate) this._onUpdate(this.task._id, 'attachments', this.task.attachments || [], this.task);
                if (window.showMessage) window.showMessage('Pièce jointe ajoutée', 'success');
            } catch (e) {
                console.error('[TaskModal] Attachment upload error:', e);
                if (window.showMessage) window.showMessage(e.message || 'Erreur lors de l’ajout du fichier', 'danger');
            } finally {
                this.uploadBusy = false;
            }
        },

        async deleteAttachment(attachment) {
            if (!this.task?._id || !attachment?._id) return;
            try {
                const res = await fetch(API + '/api/record-tasks/' + this.task._id + '/attachments/' + attachment._id, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Suppression impossible');
                this.task = data.task ? { ...this.task, ...data.task } : { ...this.task, attachments: data.attachments || [] };
                if (this._onUpdate) this._onUpdate(this.task._id, 'attachments', this.task.attachments || [], this.task);
                if (window.showMessage) window.showMessage('Pièce jointe supprimée', 'success');
            } catch (e) {
                console.error('[TaskModal] Attachment delete error:', e);
                if (window.showMessage) window.showMessage('Erreur lors de la suppression du fichier', 'danger');
            }
        },

	        attachmentUrl(attachment) {
	            return attachment?.url || (attachment?.filename ? API + '/uploads/attachments/' + attachment.filename : '#');
	        },

	        attachmentDownloadUrl(attachment) {
	            return attachment?.downloadUrl || this.attachmentUrl(attachment);
	        },

	        attachmentName(attachment) {
	            return String(attachment?.originalName || attachment?.filename || 'Fichier');
	        },

	        attachmentExtension(attachment) {
	            const name = this.attachmentName(attachment).split('?')[0].toLowerCase();
	            const index = name.lastIndexOf('.');
	            return index >= 0 ? name.slice(index) : '';
	        },

	        isImageAttachment(attachment) {
	            const mime = String(attachment?.mimeType || '').toLowerCase();
	            const ext = this.attachmentExtension(attachment);
	            return mime.startsWith('image/') && mime !== 'image/svg+xml'
	                || ['.png', '.jpg', '.jpeg', '.gif', '.webp', '.bmp', '.avif'].includes(ext);
	        },

	        attachmentCategory(attachment) {
	            const mime = String(attachment?.mimeType || '').toLowerCase();
	            const ext = this.attachmentExtension(attachment);
	            if (this.isImageAttachment(attachment)) return 'image';
	            if (mime.includes('pdf') || ext === '.pdf') return 'pdf';
	            if (mime.includes('video') || ['.mp4', '.webm', '.mov', '.avi'].includes(ext)) return 'video';
	            if (mime.includes('spreadsheet') || mime.includes('excel') || ['.xls', '.xlsx', '.csv'].includes(ext)) return 'excel';
	            if (mime.includes('word') || mime.includes('document') || ['.doc', '.docx'].includes(ext)) return 'word';
	            return 'other';
	        },

	        viewerFiles(attachments = []) {
	            return (attachments || []).map(attachment => ({
	                url: this.attachmentUrl(attachment),
	                name: this.attachmentName(attachment),
	                category: this.attachmentCategory(attachment)
	            })).filter(file => file.url && file.url !== '#');
	        },

	        openAttachmentViewer(attachment, attachments = []) {
	            const url = this.attachmentUrl(attachment);
	            if (!url || url === '#') return;
	            const name = this.attachmentName(attachment);
	            const category = this.attachmentCategory(attachment);
	            const files = this.viewerFiles(attachments);
	            const idx = files.findIndex(file => file.url === url);
	            if (typeof window.openFileViewer === 'function') {
	                window.openFileViewer(url, name, category, files, idx >= 0 ? idx : null);
	                return;
	            }
	            window.open(this.attachmentDownloadUrl(attachment), '_blank', 'noopener');
	        },

	        attachmentIcon(attachment) {
	            const mime = String(attachment?.mimeType || '').toLowerCase();
	            if (mime.includes('image')) return 'solar:gallery-linear';
	            if (mime.includes('pdf')) return 'solar:file-text-linear';
            if (mime.includes('spreadsheet') || mime.includes('excel') || mime.includes('csv')) return 'solar:document-add-linear';
            if (mime.includes('word') || mime.includes('document')) return 'solar:document-text-linear';
	            return 'solar:paperclip-rounded-linear';
	        },

	        fileIcon(file) {
	            return this.attachmentIcon({ mimeType: file?.type || '', originalName: file?.name || '' });
	        },

        formatBytes(bytes) {
            const size = Number(bytes || 0);
            if (!size) return 'Taille inconnue';
            if (size < 1024) return size + ' o';
            if (size < 1024 * 1024) return (size / 1024).toFixed(size < 10240 ? 1 : 0) + ' Ko';
            return (size / 1024 / 1024).toFixed(size < 10 * 1024 * 1024 ? 1 : 0) + ' Mo';
        },

        async remove() {
            if (!this.task?._id) return;
            if (!confirm('Supprimer cette tâche ?')) return;
            try {
                await fetch(API + '/api/record-tasks/' + this.task._id, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const taskId = this.task._id;
                if (this._onDelete) this._onDelete(taskId);
                this.close();
                if (window.showMessage) window.showMessage('Tâche supprimée', 'success');
            } catch (e) {
                console.error('[TaskModal] Delete error:', e);
                if (window.showMessage) window.showMessage('Erreur lors de la suppression', 'danger');
            }
        },

	        addChatFiles(files) {
	            const list = Array.from(files || []).filter(Boolean);
	            if (!list.length) return;
	            const next = list.slice(0, Math.max(0, 10 - this.chatFiles.length)).map((file) => ({
	                id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
	                file,
	                name: file.name || 'Image collée',
	                size: file.size || 0,
	                type: file.type || '',
	                previewUrl: file.type?.startsWith('image/') ? URL.createObjectURL(file) : ''
	            }));
	            this.chatFiles = [...this.chatFiles, ...next];
	        },

	        removeChatFile(id) {
	            const item = this.chatFiles.find(file => file.id === id);
	            if (item?.previewUrl) URL.revokeObjectURL(item.previewUrl);
	            this.chatFiles = this.chatFiles.filter(file => file.id !== id);
	        },

	        clearChatFiles() {
	            (this.chatFiles || []).forEach(item => {
	                if (item?.previewUrl) URL.revokeObjectURL(item.previewUrl);
	            });
	            this.chatFiles = [];
	        },

	        handleChatPaste(event) {
	            const items = Array.from(event.clipboardData?.items || []);
	            const pasted = items
	                .filter(item => item.kind === 'file')
	                .map(item => item.getAsFile())
	                .filter(file => file && String(file.type || '').startsWith('image/'));
	            const files = pasted.length
	                ? pasted
	                : Array.from(event.clipboardData?.files || []).filter(file => String(file.type || '').startsWith('image/'));
	            if (!files.length) return;
	            event.preventDefault();
	            this.addChatFiles(files);
	        },

	        handleChatDrop(event) {
	            this.addChatFiles(event.dataTransfer?.files || []);
	        },

	        async submitCommentFrom(input) {
	            const sent = await this.sendComment(input?.value || '');
	            if (sent && input) {
	                input.value = '';
	                input.style.height = '';
	            }
	        },

	        async sendComment(text) {
	            const cleanText = String(text || '').trim();
	            const files = (this.chatFiles || []).map(item => item.file).filter(Boolean);
	            if (!this.task?._id || (!cleanText && !files.length) || this.chatSending) return false;
	            this.chatSending = true;
	            try {
	                let payload;
	                const options = {
	                    method: 'POST',
	                    credentials: 'include'
	                };
		                if (files.length) {
		                    payload = new FormData();
		                    payload.append('text', cleanText);
		                    if (this.publishToChat) payload.append('publishToChat', '1');
		                    files.forEach(file => payload.append('files', file, file.name || 'image-collee.png'));
		                    options.body = payload;
		                } else {
		                    options.headers = { 'Content-Type': 'application/json' };
		                    options.body = JSON.stringify({ text: cleanText, publishToChat: this.publishToChat });
		                }
	                const res = await fetch(API + '/api/record-tasks/' + this.task._id + '/comments', options);
		                const data = await res.json().catch(() => ({}));
		                if (!res.ok || data.success === false) throw new Error(data.error || 'Message impossible');
		                if (data.comment) {
		                    this.clearChatFiles();
		                    this.task._comments = this.sortConversation([...(this.task._comments || []), data.comment]);
		                    this.scrollConversationToRecent({ smooth: true });
		                    return true;
		                }
		            } catch (e) {
	                console.error('[TaskModal] Comment error:', e);
	                if (window.showMessage) window.showMessage(e.message || 'Erreur lors de l’envoi du message', 'danger');
	            } finally {
	                this.chatSending = false;
	            }
	            return false;
	        },

        toDateVal(value) {
            if (!value) return '';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '';
            if (this.dateValueHasExplicitTime(value)) {
                const year = d.getFullYear();
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }
            return d.toISOString().split('T')[0];
        },

        toTimeVal(value) {
            if (!value || !this.dateValueHasExplicitTime(value)) return '';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '';
            return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
        },

        dateValueHasExplicitTime(value) {
            if (!value) return false;
            if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return false;
            return d.getUTCHours() !== 0
                || d.getUTCMinutes() !== 0
                || d.getUTCSeconds() !== 0
                || d.getUTCMilliseconds() !== 0;
        },

        composeDateTime(dateValue, timeValue) {
            const date = String(dateValue || '').trim();
            if (!date) return null;
            const time = String(timeValue || '').trim();
            if (!time) return date;
            const [year, month, day] = date.split('-').map(Number);
            const [hour, minute] = time.split(':').map(Number);
            if (!year || !month || !day || !Number.isFinite(hour) || !Number.isFinite(minute)) return date;
            return new Date(year, month - 1, day, hour, minute, 0, 0).toISOString();
        },

        reminderDateFromValue(value) {
            if (!value) return '';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '';
            return [
                d.getFullYear(),
                String(d.getMonth() + 1).padStart(2, '0'),
                String(d.getDate()).padStart(2, '0')
            ].join('-');
        },

        reminderTimeFromValue(value) {
            if (!value) return '';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '';
            return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
        },

        composeReminderDateTime(dateValue, timeValue) {
            const date = String(dateValue || '').trim();
            const time = String(timeValue || '').trim();
            if (!date || !time) return null;
            const [year, month, day] = date.split('-').map(Number);
            const [hour, minute] = time.split(':').map(Number);
            if (!year || !month || !day || !Number.isFinite(hour) || !Number.isFinite(minute)) return null;
            return new Date(year, month - 1, day, hour, minute, 0, 0).toISOString();
        },

        updateTaskDatePart(field, part, value) {
            if (!this.task || !['startDate', 'dueDate'].includes(field)) return;
            const currentDate = this.toDateVal(this.task[field]);
            const currentTime = this.toTimeVal(this.task[field]);
            const nextDate = part === 'date' ? String(value || '') : currentDate;
            const nextTime = part === 'time' ? String(value || '') : currentTime;
            const nextValue = this.composeDateTime(nextDate, nextTime);
            this.task[field] = nextValue;
            this.updateField(field, nextValue);
        },

        updateCompletedAtPart(part, value) {
            if (!this.task || this.task.status !== 'Terminé') return;
            const currentDate = this.toDateVal(this.task.completedAt);
            const currentTime = this.toTimeVal(this.task.completedAt);
            const nextDate = part === 'date' ? String(value || '') : currentDate;
            const nextTime = part === 'time' ? String(value || '') : currentTime;
            const nextValue = this.composeDateTime(nextDate, nextTime);
            this.task.completedAt = nextValue;
            this.updateField('completedAt', nextValue);
        },

        syncReminderDraft({ force = false } = {}) {
            if (!this.task) return;
            if (!force && (this.reminderDraft.dirty || this.reminderSaving)) return;
            const scheduledAt = this.task.reminder?.scheduledAt || '';
            this.reminderDraft = {
                date: this.reminderDateFromValue(scheduledAt),
                time: this.reminderTimeFromValue(scheduledAt),
                dirty: false
            };
        },

        reminderDateVal() {
            return this.reminderDraft.date || '';
        },

        reminderTimeVal() {
            return this.reminderDraft.date ? (this.reminderDraft.time || '') : '';
        },

        reminderTimeZone() {
            try {
                return Intl.DateTimeFormat().resolvedOptions().timeZone || 'Africa/Casablanca';
            } catch (_) {
                return 'Africa/Casablanca';
            }
        },

        setReminderDraftPart(part, value, { dirty = true } = {}) {
            const currentDate = this.reminderDraft.date || '';
            const currentTime = this.reminderDraft.time || '';
            const nextDate = part === 'date' ? String(value || '') : currentDate;
            const nextTime = nextDate ? (part === 'time' ? String(value || '') : currentTime) : '';
            this.reminderDraft = {
                date: nextDate,
                time: nextTime,
                dirty: dirty || this.reminderDraft.dirty
            };
            if (dirty) this._reminderEditSeq += 1;
            return this.reminderDraft;
        },

        async updateReminderPart(part, value) {
            if (!this.task?._id) return;
            const draft = this.setReminderDraftPart(part, value);
            const nextDate = draft.date;
            const nextTime = draft.time;
            if (!nextDate) {
                this.reminderDraft = { date: '', time: '', dirty: !!this.task.reminder };
                if (this.task.reminder) await this.clearReminder();
                return;
            }
            if (!nextTime) return;
            const scheduledAt = this.composeReminderDateTime(nextDate, nextTime);
            if (!scheduledAt) return;
            await this.setReminder(scheduledAt);
        },

        async setReminder(scheduledAt) {
            if (!this.task?._id) return false;
            this._reminderEditSeq += 1;
            const previous = this.task.reminder || null;
            const previousDraft = { ...this.reminderDraft };
            const comments = this.task._comments || [];
            const optimistic = {
                ...(previous || {}),
                targetId: this.task._id,
                title: this.task.title || 'Tache',
                scheduledAt,
                timeZone: this.reminderTimeZone(),
                status: 'scheduled'
            };
            this.reminderSaving = true;
            this.task.reminder = optimistic;
            try {
                const res = await fetch(API + '/api/record-tasks/' + this.task._id + '/reminder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        scheduledAt,
                        timeZone: this.reminderTimeZone()
                    })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Rappel impossible');
                if (data.task) this.task = { ...this.task, ...data.task, _comments: comments };
                else this.task.reminder = data.reminder || optimistic;
                this.reminderSaving = false;
                this.reminderDraft.dirty = false;
                this.syncReminderDraft({ force: true });
                if (this._onUpdate) this._onUpdate(this.task._id, 'reminder', this.task.reminder, this.task);
                if (window.showMessage) window.showMessage('Rappel enregistre', 'success');
                return true;
            } catch (e) {
                this.task.reminder = previous;
                this.reminderSaving = false;
                this.reminderDraft = { ...previousDraft, dirty: true };
                if (window.showMessage) window.showMessage(e.message || 'Erreur lors du rappel', 'danger');
                return false;
            }
        },

        async clearReminder() {
            if (!this.task?._id) return false;
            this._reminderEditSeq += 1;
            const previous = this.task.reminder || null;
            const previousDraft = { ...this.reminderDraft };
            const comments = this.task._comments || [];
            this.reminderSaving = true;
            this.task.reminder = null;
            this.reminderDraft = { date: '', time: '', dirty: true };
            try {
                const res = await fetch(API + '/api/record-tasks/' + this.task._id + '/reminder', {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Suppression impossible');
                if (data.task) this.task = { ...this.task, ...data.task, _comments: comments };
                else this.task.reminder = null;
                this.reminderSaving = false;
                this.reminderDraft = { date: '', time: '', dirty: false };
                if (this._onUpdate) this._onUpdate(this.task._id, 'reminder', null, this.task);
                if (window.showMessage) window.showMessage('Rappel supprime', 'success');
                return true;
            } catch (e) {
                this.task.reminder = previous;
                this.reminderSaving = false;
                this.reminderDraft = previousDraft;
                if (window.showMessage) window.showMessage(e.message || 'Erreur lors de la suppression', 'danger');
                return false;
            }
        },

        activityFieldLabel(field) {
            if (field === 'priority') return 'priorité';
            if (field === 'status') return 'statut';
            return field || 'valeur';
        },

        activityValueStyle(field, value) {
            const kind = field === 'priority' ? 'priority' : 'status';
            const color = this.optionColor(kind, value);
            return `background:${color}18;color:${color}`;
        },

        formatDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '—';
            const now = new Date();
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const target = new Date(d.getFullYear(), d.getMonth(), d.getDate());
            const diff = Math.round((target - today) / 86400000);
            if (diff === 0) return "Aujourd'hui";
            if (diff === 1) return 'Demain';
            if (diff === -1) return 'Hier';
            if (diff < -1) return 'Il y a ' + Math.abs(diff) + 'j';
            if (diff <= 7) return d.toLocaleDateString('fr-FR', { weekday: 'long' });
            return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: '2-digit' });
        },

        formatLongDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '—';
            return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
        }
    });

    window.addEventListener('open-task-modal', (e) => {
        if (e.detail?.task) {
            Alpine.store('taskModal').open(e.detail.task, {
                onUpdate: e.detail.onUpdate || null,
                onDelete: e.detail.onDelete || null,
            });
        }
    });
});
</script>
