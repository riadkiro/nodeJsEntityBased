                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Type d'agrégation</label>
                                                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;">
                                                        <template x-for="agg in [{v:'count',l:'Nombre'},{v:'sum',l:'Somme'},{v:'avg',l:'Moyenne'},{v:'min',l:'Minimum'},{v:'max',l:'Maximum'},{v:'manual',l:'Manuel'}]" :key="agg.v">
                                                            <button type="button" @click="cfgBlock.config.aggregation = agg.v"
                                                                    :style="'padding: 6px; border-radius: 6px; font-size: 11px; font-weight: 500; cursor: pointer; text-align: center; transition: all 0.15s;' + ((cfgBlock.config.aggregation || 'count') === agg.v ? 'background: rgba(67,97,238,0.1); border: 1px solid rgba(67,97,238,0.3); color: #4361ee;' : 'background: white; border: 1px solid #e5e7eb; color: #6b7280;')"
                                                                    x-text="agg.l"></button>
                                                        </template>
                                                    </div>
                                                </div>
                                                <!-- Field (for sum/avg/min/max) -->
                                                <template x-if="cfgBlock.config.aggregation && cfgBlock.config.aggregation !== 'count' && cfgBlock.config.aggregation !== 'manual'">
                                                    <div>
                                                        <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Champ à agréger</label>
                                                        <select :value="cfgBlock.config.field || ''"
                                                                @change="cfgBlock.config.field = $el.value"
                                                                style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; outline: none; background: white; box-sizing: border-box;">
                                                            <option value="">— Choisir un champ —</option>
                                                            <optgroup label="Champs entity">
                                                            <% (entity.customFields || []).filter(function(f) { return f && (['number','currency','decimal'].indexOf(f.type) > -1 || f.inputType === 'number'); }).forEach(function(f) { %>
                                                            <option value="<%= (f._id || '').toString() %>"><%= f.label || f.name || '' %></option>
                                                            <% }); %>
                                                            </optgroup>
                                                            <% (locals.gridSchemas || []).filter(function(gs) { return gs && gs.schema && gs.schema.columns; }).forEach(function(gs) { %>
                                                            <optgroup label="📊 <%= gs.schema.name || '' %>">
                                                            <% gs.schema.columns.filter(function(c) { return c && ['number','money','formula'].indexOf(c.type) > -1; }).forEach(function(c) { %>
                                                            <option value="grid:<%= (gs.schemaId || gs.schema._id || '').toString() %>:<%= c.key %>"><%= c.label || c.key %><%= c.config && c.config.unit ? ' (' + c.config.unit + ')' : '' %></option>
                                                            <% }); %>
                                                            </optgroup>
                                                            <% }); %>
                                                        </select>
                                                    </div>
                                                </template>
                                                <!-- Manual value -->
                                                <template x-if="cfgBlock.config.aggregation === 'manual'">
                                                    <div>
                                                        <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Valeur manuelle</label>
                                                        <input type="number" :value="cfgBlock.config.manualValue || 0"
                                                               @input="cfgBlock.config.manualValue = parseFloat($el.value) || 0"
                                                               style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; outline: none; box-sizing: border-box;">
                                                    </div>
                                                </template>
                                                <!-- Prefix / Suffix -->
                                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                                    <div>
                                                        <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Préfixe</label>
                                                        <input type="text" :value="cfgBlock.config.prefix || ''"
                                                               @input="cfgBlock.config.prefix = $el.value"
                                                               placeholder="ex: $, €"
                                                               style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; outline: none; box-sizing: border-box;">
                                                    </div>
                                                    <div>
                                                        <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Suffixe</label>
                                                        <input type="text" :value="cfgBlock.config.suffix || ''"
                                                               @input="cfgBlock.config.suffix = $el.value"
                                                               placeholder="ex: %, pts"
                                                               style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; outline: none; box-sizing: border-box;">
                                                    </div>
                                                </div>
                                                <!-- Color -->
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Couleur de l'indicateur</label>
                                                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                                        <template x-for="c in ['#4361ee','#00ab55','#e7515a','#e2a03f','#805dca','#2196f3','#1b2e4b']" :key="c">
                                                            <button type="button" @click="cfgBlock.config.color = c"
                                                                    :style="'width: 28px; height: 28px; border-radius: 8px; border: 2px solid ' + ((cfgBlock.config.color || '#4361ee') === c ? c : 'transparent') + '; background: ' + c + '; cursor: pointer; transition: all 0.15s;'"></button>
                                                        </template>
                                                    </div>
                                                </div>
                                            </div>
                                        </template>

                                        <!-- ══════════ CHART ══════════ -->
                                        <template x-if="cfgBlock.type === 'chart'">
                                            <div style="display: flex; flex-direction: column; gap: 14px;"
                                                 x-data="{ 
                                                     _entities: [], _selectedEntity: null, _relRecords: [], _relSearching: false, _relSearchQuery: '',
                                                     async loadEntities() {
                                                         try {
                                                             const resp = await fetch('/account/<%= account_number %>/api/widget/entities', { credentials: 'include' });
                                                             const d = await resp.json();
                                                             this._entities = d.entities || [];
                                                             this.updateSelectedEntity();
                                                         } catch(e) { console.error(e); }
                                                     },
                                                     updateSelectedEntity() {
                                                         const src = this.cfgBlock.config.dataSource || 'entity:<%= entity._id %>';
                                                         const entityId = src.startsWith('entity:') ? src.split(':')[1] : '<%= entity._id %>';
                                                         this._selectedEntity = this._entities.find(e => e._id === entityId) || null;
                                                     },
                                                     async searchRelRecords(relKey) {
                                                         if (!this._selectedEntity || !relKey) return;
                                                         const rel = this._selectedEntity.relations.find(r => r.key === relKey);
                                                         if (!rel || !rel.targetEntity) return;
                                                         this._relSearching = true;
                                                         try {
                                                             const resp = await fetch('/account/<%= account_number %>/record/api/search?entityId=' + rel.targetEntity._id + '&q=' + encodeURIComponent(this._relSearchQuery || '') + '&limit=20', { credentials: 'include' });
                                                             const d = await resp.json();
                                                             this._relRecords = (d.data || d.records || []).map(r => ({ _id: r.id || r._id, title: r.label || r.computedTitle || r.title || 'Sans titre' }));
                                                         } catch(e) { this._relRecords = []; }
                                                         this._relSearching = false;
                                                     }
                                                 }"
                                                 x-init="if(!cfgBlock.config) cfgBlock.config = {}; loadEntities()">
                                                <!-- Chart type -->
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">Type de graphique</label>
                                                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;">
                                                        <template x-for="ct in [{v:'bar',l:'Barres',i:'solar:chart-bold-duotone'},{v:'line',l:'Lignes',i:'solar:graph-up-bold-duotone'},{v:'pie',l:'Camembert',i:'solar:pie-chart-bold-duotone'},{v:'doughnut',l:'Donut',i:'solar:pie-chart-2-bold-duotone'},{v:'area',l:'Aire',i:'solar:chart-2-bold-duotone'},{v:'radar',l:'Radar',i:'solar:radar-bold-duotone'}]" :key="ct.v">
                                                            <button type="button" @click="cfgBlock.config.chartType = ct.v"
                                                                    :style="'display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 10px 6px; border-radius: 8px; cursor: pointer; font-size: 11px; font-weight: 500; transition: all 0.15s;' + ((cfgBlock.config.chartType || 'bar') === ct.v ? 'background: rgba(67,97,238,0.1); border: 1px solid rgba(67,97,238,0.3); color: #4361ee;' : 'background: white; border: 1px solid #e5e7eb; color: #6b7280;')">
                                                                <iconify-icon :icon="ct.i" width="18"></iconify-icon>
                                                                <span x-text="ct.l"></span>
                                                            </button>
                                                        </template>
                                                    </div>
                                                </div>
                                                <!-- ─── Data source (entity) ─── -->
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">
                                                        <iconify-icon icon="solar:database-bold-duotone" width="13" style="color: #4361ee; margin-right: 2px;"></iconify-icon>
                                                        Source de données
                                                    </label>
                                                    <select :value="cfgBlock.config.dataSource || 'entity:<%= entity._id %>'"
                                                            @change="cfgBlock.config.dataSource = $el.value; updateSelectedEntity(); cfgBlock.config.relationFilterKey = ''; cfgBlock.config.relationFilterValue = ''; cfgBlock.config.classificationFilterId = ''; cfgBlock.config.classificationFilterOption = '';"
                                                            style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; outline: none; background: white; box-sizing: border-box;">
                                                        <template x-for="ent in _entities" :key="ent._id">
                                                            <option :value="'entity:' + ent._id" x-text="'📂 ' + ent.name" :selected="(cfgBlock.config.dataSource || 'entity:<%= entity._id %>') === 'entity:' + ent._id"></option>
                                                        </template>
                                                    </select>
                                                </div>

                                                <!-- ─── Period grouping (X axis) ─── -->
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">
                                                        <iconify-icon icon="solar:calendar-bold-duotone" width="13" style="color: #00ab55; margin-right: 2px;"></iconify-icon>
                                                        Période (axe X)
                                                    </label>
                                                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px;">
                                                        <template x-for="p in [{v:'day',l:'Jour'},{v:'week',l:'Semaine'},{v:'month',l:'Mois'},{v:'year',l:'Année'}]" :key="p.v">
                                                            <button type="button" @click="cfgBlock.config.period = p.v"
                                                                    :style="'padding: 7px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; text-align: center; transition: all 0.15s;' + ((cfgBlock.config.period || 'month') === p.v ? 'background: rgba(0,171,85,0.1); border: 1px solid rgba(0,171,85,0.3); color: #00ab55;' : 'background: white; border: 1px solid #e5e7eb; color: #6b7280;')"
                                                                    x-text="p.l"></button>
                                                        </template>
                                                    </div>
                                                </div>

                                                                <!-- ─── Default Range ─── -->
                                                                <div>
                                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">
                                                                        <iconify-icon icon="solar:calendar-search-bold-duotone" width="13" style="color: #e2a03f; margin-right: 2px;"></iconify-icon>
                                                                        Plage par défaut
                                                                    </label>
                                                                    <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px;">
                                                                        <template x-for="dr in [{v:'1m',l:'1 mois'},{v:'3m',l:'3 mois'},{v:'6m',l:'6 mois'},{v:'1y',l:'1 an'},{v:'all',l:'Tout'}]" :key="dr.v">
                                                                            <button type="button" @click="cfgBlock.config.defaultRange = dr.v"
                                                                                    :style="'padding: 6px 4px; border-radius: 6px; font-size: 10px; font-weight: 600; cursor: pointer; text-align: center; transition: all 0.15s;' + ((cfgBlock.config.defaultRange || '6m') === dr.v ? 'background: rgba(226,160,63,0.1); border: 1px solid rgba(226,160,63,0.3); color: #e2a03f;' : 'background: white; border: 1px solid #e5e7eb; color: #6b7280;')"
                                                                                    x-text="dr.l"></button>
                                                                        </template>
                                                                    </div>
                                                                </div>

                                                <!-- ─── Date source ─── -->
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">
                                                        <iconify-icon icon="solar:clock-circle-bold-duotone" width="13" style="color: #805dca; margin-right: 2px;"></iconify-icon>
                                                        Source de la date
                                                    </label>
                                                    <select :value="cfgBlock.config.dateField || 'createdAt'"
                                                            @change="cfgBlock.config.dateField = $el.value"
                                                            style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; outline: none; background: white; box-sizing: border-box;">
                                                        <option value="createdAt">📅 Date de création</option>
                                                        <option value="updatedAt">🔄 Date de modification</option>
                                                        <template x-if="_selectedEntity && _selectedEntity.dateFields.length > 0">
                                                            <optgroup label="Champs personnalisés">
                                                                <template x-for="df in _selectedEntity.dateFields" :key="df._id">
                                                                    <option :value="df._id" x-text="df.label"></option>
                                                                </template>
                                                            </optgroup>
                                                        </template>
                                                    </select>
                                                </div>

                                                <!-- ─── Y Axis ─── -->
                                                <div>
                                                    <label style="font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">
                                                        <iconify-icon icon="solar:arrow-up-bold" width="12" style="color: #e7515a; margin-right: 2px;"></iconify-icon>
                                                        Axe Y (valeur)
                                                    </label>
                                                    <select :value="cfgBlock.config.yField || 'count'"
                                                            @change="cfgBlock.config.yField = $el.value"
                                                            style="width: 100%; padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 13px; outline: none; background: white; box-sizing: border-box;">
                                                        <option value="count">📊 Nombre de records</option>
                                                        <template x-if="_selectedEntity && _selectedEntity.numericFields.length > 0">
                                                            <optgroup label="Champs numériques">
                                                                <template x-for="nf in _selectedEntity.numericFields" :key="nf._id">
                                                                    <option :value="nf._id" x-text="'Σ ' + nf.label"></option>
                                                                </template>
                                                            </optgroup>
                                                        </template>
                                                    </select>
                                                    <!-- Aggregation type (shown if Y field is not count) -->
                                                    <template x-if="cfgBlock.config.yField && cfgBlock.config.yField !== 'count'">
                                                        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin-top: 6px;">
                                                            <template x-for="a in [{v:'sum',l:'Somme'},{v:'avg',l:'Moyenne'},{v:'min',l:'Min'},{v:'max',l:'Max'}]" :key="a.v">
                                                                <button type="button" @click="cfgBlock.config.yAgg = a.v"
                                                                        :style="'padding: 5px; border-radius: 5px; font-size: 10px; font-weight: 600; cursor: pointer; text-align: center; transition: all 0.12s;' + ((cfgBlock.config.yAgg || 'sum') === a.v ? 'background: rgba(231,81,90,0.1); border: 1px solid rgba(231,81,90,0.3); color: #e7515a;' : 'background: white; border: 1px solid #e5e7eb; color: #9ca3af;')"
                                                                        x-text="a.l"></button>
                                                            </template>
                                                        </div>
                                                    </template>
                                                </div>

                                                <!-- SEPARATOR: Filters -->
                                                <div style="display: flex; align-items: center; gap: 8px; padding: 4px 0;">
                                                    <div style="flex: 1; height: 1px; background: #e5e7eb;"></div>
                                                    <span style="font-size: 10px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.05em;">Filtres Avancés</span>
                                                    <div style="flex: 1; height: 1px; background: #e5e7eb;"></div>
                                                </div>

                                                <!-- Advanced filter builder (Chart) -->
                                                <div x-data="{
                                                    _afFields: [],
                                                    _afLoading: false,
                                                    async loadFields() {
                                                        const src = cfgBlock.config.dataSource || 'entity:<%= entity._id %>';
                                                        const entityId = src.startsWith('entity:') ? src.split(':')[1] : '<%= entity._id %>';
                                                        this._afLoading = true;
                                                        try {
                                                            const resp = await fetch('/account/<%= account_number %>/api/widget/entity-fields/' + entityId, { credentials: 'include' });
                                                            const d = await resp.json();
                                                            this._afFields = d.fields || [];
                                                        } catch(e) { console.error(e); }
                                                        this._afLoading = false;
                                                    },
                                                    getOpsForType(type) {
                                                        const t=[{v:'contains',l:'Contient'},{v:'equals',l:'Égal'},{v:'not_equals',l:'Différent'},{v:'starts_with',l:'Commence par'},{v:'ends_with',l:'Finit par'},{v:'is_empty',l:'Vide'},{v:'is_not_empty',l:'Non vide'}];
                                                        const n=[{v:'equals',l:'='},{v:'not_equals',l:'≠'},{v:'gt',l:'&gt;'},{v:'gte',l:'≥'},{v:'lt',l:'&lt;'},{v:'lte',l:'≤'},{v:'between',l:'Entre'},{v:'is_empty',l:'Vide'},{v:'is_not_empty',l:'Non vide'}];
                                                        const d=[{v:'equals',l:'Égal'},{v:'gt',l:'Après'},{v:'gte',l:'Après ou le'},{v:'lt',l:'Avant'},{v:'lte',l:'Avant ou le'},{v:'between',l:'Entre'},{v:'is_empty',l:'Vide'},{v:'is_not_empty',l:'Non vide'}];
                                                        const c=[{v:'equals',l:'Est'},{v:'not_equals',l:'Pas égal'},{v:'is_empty',l:'Vide'},{v:'is_not_empty',l:'Non vide'}];
                                                        if (['number','currency','decimal'].includes(type)) return n;
                                                        if (['date','datetime-local'].includes(type)) return d;
                                                        if (type==='classification') return c;
                                                        return t;
                                                    },
                                                    isNoValueOp(op) { return ['is_empty','is_not_empty'].includes(op); },
                                                    addFilter() { if(!cfgBlock.config.advancedFilters) cfgBlock.config.advancedFilters=[]; cfgBlock.config.advancedFilters.push({field:'',operator:'contains',value:'',value2:''}); },
                                                    removeFilter(i) { cfgBlock.config.advancedFilters.splice(i,1); },
                                                    getFieldObj(fid) { return this._afFields.find(f=>f._id===fid)||null; }
                                                }" x-init="loadFields(); if(!cfgBlock.config.advancedFilters) cfgBlock.config.advancedFilters=[]; if(!cfgBlock.config.advancedFiltersLogic) cfgBlock.config.advancedFiltersLogic='and';"
                                                   x-effect="$watch('cfgBlock.config.dataSource', ()=>loadFields())">
                                                    <template x-if="(cfgBlock.config.advancedFilters||[]).length > 1">
                                                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;">
                                                            <span style="font-size:11px;color:#6b7280;">Combiner avec</span>
                                                            <button type="button" @click="cfgBlock.config.advancedFiltersLogic = cfgBlock.config.advancedFiltersLogic==='and'?'or':'and'"
                                                                    :style="'padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;cursor:pointer;transition:all .15s;'+(cfgBlock.config.advancedFiltersLogic==='and'?'background:rgba(67,97,238,.1);border:1px solid rgba(67,97,238,.3);color:#4361ee;':'background:rgba(0,171,85,.1);border:1px solid rgba(0,171,85,.3);color:#00ab55;')"
                                                                    x-text="cfgBlock.config.advancedFiltersLogic==='and'?'ET':'OU'"></button>
                                                        </div>
                                                    </template>
                                                    <template x-for="(af,afi) in (cfgBlock.config.advancedFilters||[])" :key="afi">
                                                        <div style="padding:8px 10px;background:#f9fafb;border-radius:8px;border:1px solid #f3f4f6;margin-bottom:6px;position:relative;">
                                                            <button type="button" @click="removeFilter(afi)" style="position:absolute;top:6px;right:6px;width:20px;height:20px;border-radius:50%;border:none;cursor:pointer;background:rgba(231,81,90,.08);color:#e7515a;display:flex;align-items:center;justify-content:center;z-index:1;"
                                                                    onmouseover="this.style.background='rgba(231,81,90,.18)'" onmouseout="this.style.background='rgba(231,81,90,.08)'">
                                                                <iconify-icon icon="tabler:x" width="10"></iconify-icon>
                                                            </button>
                                                            <select :value="af.field" @change="af.field=$el.value;const fo=getFieldObj($el.value);if(fo){const ops=getOpsForType(fo.type);af.operator=ops[0]?.v||'contains';}af.value='';af.value2='';"
                                                                    style="width:100%;padding:6px 8px;border:1px solid #e5e7eb;border-radius:6px;font-size:12px;outline:none;background:white;box-sizing:border-box;margin-bottom:6px;padding-right:30px;">
                                                                <option value="">— Choisir un champ —</option>
                                                                <optgroup label="Système"><template x-for="f in _afFields.filter(f=>f.category==='system')" :key="f._id"><option :value="f._id" x-text="f.label"></option></template></optgroup>
                                                                <optgroup label="Champs personnalisés"><template x-for="f in _afFields.filter(f=>f.category==='custom')" :key="f._id"><option :value="f._id" x-text="f.label"></option></template></optgroup>
                                                                <optgroup label="Classifications"><template x-for="f in _afFields.filter(f=>f.category==='classification')" :key="f._id"><option :value="f._id" x-text="'🏷️ '+f.label"></option></template></optgroup>
                                                            </select>
                                                            <template x-if="af.field">
                                                                <div style="display:flex;flex-direction:column;gap:6px;">
                                                                    <select :value="af.operator" @change="af.operator=$el.value;if(isNoValueOp($el.value)){af.value='';af.value2='';}"
                                                                            style="padding:6px 8px;border:1px solid #e5e7eb;border-radius:6px;font-size:11px;outline:none;background:white;box-sizing:border-box;">
                                                                        <template x-for="op in getOpsForType((getFieldObj(af.field)||{}).type)" :key="op.v"><option :value="op.v" x-text="op.l"></option></template>
                                                                    </select>
                                                                    <template x-if="!isNoValueOp(af.operator)">
                                                                        <div>
                                                                            <template x-if="getFieldObj(af.field)&&getFieldObj(af.field).type==='classification'">
                                                                                <select :value="af.value" @change="af.value=$el.value" style="padding:6px 8px;border:1px solid #e5e7eb;border-radius:6px;font-size:11px;outline:none;background:white;box-sizing:border-box;">
                                                                                    <option value="">— option —</option>
                                                                                    <template x-for="opt in (getFieldObj(af.field)||{}).options||[]" :key="opt._id"><option :value="opt._id" x-text="opt.label"></option></template>
                                                                                </select>
                                                                            </template>
                                                                            <template x-if="getFieldObj(af.field)&&['date','datetime-local'].includes(getFieldObj(af.field).type)">
                                                                                <div style="display:flex;gap:4px;">
