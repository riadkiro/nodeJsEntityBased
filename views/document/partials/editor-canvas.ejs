    <!-- Canvas Area -->
    <div class="flex-1 bg-gray-100 dark:bg-gray-800 overflow-auto p-8" id="canvas-container">
      <div id="pages-container" class="flex flex-col gap-8 items-center" style="padding-top: 43px;">
        <template x-for="(page, index) in doc.pages" :key="'page-' + index">
          <div class="relative group">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-10">
              <span class="bg-primary text-white text-xs px-2 py-1 rounded-full shadow-md">
                Page <span x-text="index + 1"></span>
              </span>
            </div>

            <!-- Page Mode Switcher (Always Visible) -->
            <div class="absolute -mt-12 left-0 flex items-center gap-1 bg-white/80 dark:bg-[#0e1726]/80 backdrop-blur-md border border-gray-200/50 dark:border-white/10 shadow-lg rounded-xl p-1 z-30 transition-all">
               <button 
                  @click.stop="setPageMode(index, 'edition')"
                  :class="page.mode === 'edition' ? 'bg-primary text-white shadow-md' : 'text-gray-500 dark:text-white-dark hover:bg-gray-100 dark:hover:bg-white/5'"
                  class="flex items-center gap-2 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider rounded-lg transition-all"
                  title="Mode Édition"
                >
                  <iconify-icon icon="solar:pen-bold-duotone" width="14"></iconify-icon>
                  <span>Édition</span>
                </button>
                
                 <button 
                  @click.stop="setPageMode(index, 'layout')"
                  :class="page.mode === 'layout' ? 'bg-primary text-white shadow-md' : 'text-gray-500 dark:text-white-dark hover:bg-gray-100 dark:hover:bg-white/5'"
                  class="flex items-center gap-2 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider rounded-lg transition-all"
                  title="Mode Layout"
                >
                  <iconify-icon icon="solar:layers-minimalistic-bold-duotone" width="14"></iconify-icon>
                  <span>Layout</span>
                </button>
                
                 <button 
                  @click.stop="setPageMode(index, 'designer')"
                  :class="page.mode === 'designer' ? 'bg-primary text-white shadow-md' : 'text-gray-500 dark:text-white-dark hover:bg-gray-100 dark:hover:bg-white/5'"
                  class="flex items-center gap-2 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider rounded-lg transition-all"
                  title="Mode Designer"
                >
                  <iconify-icon icon="solar:palette-2-broken" width="14"></iconify-icon>
                  <span>Designer</span>
                </button>
            </div>

            <div 
              class="bg-white shadow-2xl relative overflow-hidden" 
              :style="'width: ' + doc.dimensions.width + 'px; height: ' + doc.dimensions.height + 'px;'" 
              @click="selectPage(index)" 
              :class="{ 'ring-2 ring-primary': selectedPageIndex === index }"
            >

              <!-- EDITION MODE: Editable content area -->
              <div x-show="page.mode === 'edition'" class="w-full h-full relative group/edit">
                <div 
                  class="w-full h-full outline-none text-gray-800 leading-relaxed page-content overflow-hidden editor-content"
                  :class="{ 'global-selection': isGlobalSelection }"
                  :contenteditable="!isLayoutActive()"
                  :data-page-index="index"
                  @input="handlePageInput($event, index)"
                  @paste="handlePaste($event, index)"
                  @dragover.prevent
                  @drop.prevent="handleEditionDrop($event, index)"
                  @focus="selectPage(index)"
                  @blur="syncPageContent($event, index)"
                  x-init="$el.innerHTML = page.content || ''"
                  x-ref="pageContent"
                  :style="'white-space: pre-wrap; word-wrap: break-word; line-height: 1.15; padding-top: ' + doc.margins.top + 'px; padding-bottom: ' + doc.margins.bottom + 'px; padding-left: ' + doc.margins.left + 'px; padding-right: ' + doc.margins.right + 'px; overflow: hidden;'"
                ></div>

                <!-- LOCK OVERLAY (Visible only when Layout mode is active on ANY page) -->
                <div 
                  x-show="isLayoutActive()" 
                  class="absolute inset-0 z-[100] flex flex-col items-center justify-center p-8 text-center"
                  style="background-color: rgba(243, 244, 246, 0.75); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);"
                  x-transition.opacity
                >
                  <div class="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 max-w-sm transform transition-all scale-100">
                    <div class="w-12 h-12 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded-full flex items-center justify-center mx-auto mb-4">
                      <iconify-icon icon="solar:lock-bold-duotone" width="28"></iconify-icon>
                    </div>
                    <h4 class="text-sm font-bold text-gray-900 dark:text-white mb-2 uppercase tracking-wider">Édition verrouillée</h4>
                    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
                      L'édition est désactivée car les pages 
                      <span class="font-black text-amber-600 dark:text-amber-400" x-text="'[' + getLayoutPages().join(', ') + ']'"></span> 
                      sont en mode **Layout**.
                    </p>
                    <div class="mt-4 text-[10px] text-gray-400 font-medium">
                      Repassez ces pages en mode Édition pour modifier ce contenu.
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- DESIGN MODE: Layout with rows -->
              <div 
                x-show="page.mode === 'layout' || page.mode === 'designer'"
                class="w-full h-full group/page"
                :style="'padding-top: ' + (doc.margins.top - 12) + 'px; padding-bottom: ' + (doc.margins.bottom - 12) + 'px; padding-left: ' + (doc.margins.left - 12) + 'px; padding-right: ' + (doc.margins.right - 12) + 'px;'"
              >
                <!-- Add row button (Top) - Only generic if empty -->
                <button 
                  x-show="!page.rows || page.rows.length === 0"
                  @click="addRow(index)"
                  class="w-full border border-dashed border-gray-200 dark:border-gray-700 rounded-lg p-3 hover:border-primary hover:bg-gray-50/50 dark:hover:bg-gray-800 transition-all flex items-center justify-center gap-2 text-gray-300 hover:text-primary mb-2"
                >
                  <iconify-icon icon="solar:add-circle-bold" width="18"></iconify-icon>
                  <span class="text-xs font-medium">Commencer par une section</span>
                </button>
                
                <!-- Global Hover Styles for Layout Mode -->
                <style>
                  /* 1. Page Hover -> Reveal all structures (dashed lines) */
                  .group\/page:hover .row-border,
                  .group\/page:hover .sortable-column,
                  .group\/page:hover .element-wrapper {
                    border-color: rgba(156, 163, 175, 0.2) !important; /* Neutral dashed gray */
                  }
                  
                  /* 2. Row Hover -> Show Row Controls & Primary structural hit */
                  .section-row:hover .section-controls {
                    opacity: 1 !important;
                    pointer-events: auto !important;
                  }
                  .section-row:hover > .row-border {
                    border-color: rgba(59, 130, 246, 0.3) !important;
                    background: rgba(59, 130, 246, 0.02);
                  }

                  /* 3. Column Hover -> Hint color */
                  .group\/col:hover {
                    border-color: rgba(59, 130, 246, 0.2) !important;
                  }

                  /* 4. Element Hover -> Show Local Tools & Highlight */
                  .group\/el:hover .element-controls,
                  .group\/el:hover .drag-handle-pill {
                    opacity: 1 !important;
                  }
                  .group\/el:hover {
                    border-color: rgba(59, 130, 246, 0.3) !important;
                  }
                </style>

                <!-- Render existing rows -->
                <template x-for="(row, rowIndex) in page.rows" :key="'row-' + index + '-' + rowIndex">
                  <div class="relative mb-0 section-row group">

                    <!-- Row container - Minimalistic Padding & Neutral Borders -->
                    <div 
                      class="border border-dashed border-transparent rounded-lg p-3 hover:border-primary/20 transition-all min-h-[10px] relative row-border"
                      @click="selectedRow = { pageIndex: index, rowIndex: rowIndex }"
                    >
                      <!-- 1. Layout Selector (Top-Right) - CLASSIC POSITION -->
                      <div 
                        class="section-controls absolute -top-5 right-0 rounded shadow-md opacity-0 transition-opacity flex gap-0.5 bg-white dark:bg-gray-800 p-0.5 border dark:border-gray-700"
                        style="z-index: 1000; pointer-events: none;"
                      >
                        <!-- Layouts -->
                        <button 
                          @click.stop="setRowLayout(index, rowIndex, 1)"
                          :class="row.columns === 1 ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400'"
                          class="w-6 h-6 rounded hover:scale-110 transition-transform flex items-center justify-center text-xs"
                          style="pointer-events: auto !important;"
                          title="1 colonne"
                        >
                          <iconify-icon icon="tabler:rectangle" width="14"></iconify-icon>
                        </button>
                        <button 
                          @click.stop="setRowLayout(index, rowIndex, 2)"
                          :class="row.columns === 2 ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400'"
                          class="w-6 h-6 rounded hover:scale-110 transition-transform flex items-center justify-center text-xs"
                          style="pointer-events: auto !important;"
                          title="2 colonnes"
                        >
                          <iconify-icon icon="tabler:columns-2" width="14"></iconify-icon>
                        </button>
                        <button 
                          @click.stop="setRowLayout(index, rowIndex, 3)"
                          :class="row.columns === 3 ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400'"
                          class="w-6 h-6 rounded hover:scale-110 transition-transform flex items-center justify-center text-xs"
                          style="pointer-events: auto !important;"
                          title="3 colonnes"
                        >
                          <iconify-icon icon="tabler:columns-3" width="14"></iconify-icon>
                        </button>
                        
                        <div class="w-px h-3 bg-gray-300 dark:bg-gray-600 mx-0.5 self-center"></div>
                        
                        <!-- Add Column -->
                        <button 
                          @click.stop="addColumnToRow(index, rowIndex)"
                          class="w-6 h-6 rounded bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 hover:bg-primary hover:text-white hover:scale-110 transition-all flex items-center justify-center text-xs"
                          style="pointer-events: auto !important;"
                          title="Ajouter une colonne (+1)"
                          x-show="(row.columns || 1) < 12"
                        >
                          <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                        </button>
                      </div>

                      <!-- 2. Row Content (Columns) -->
                      <div class="grid gap-2" :style="'grid-template-columns: repeat(' + (row.columns || 1) + ', minmax(0, 1fr))'">
                        <template x-for="col in (row.columns || 1)" :key="'col-' + col">
                          <div 
                            class="rounded group/col relative transition-all border border-dashed border-transparent sortable-column"
                            :class="!(row.elements || []).some(e => e.column === col - 1) ? 'min-h-[40px]' : 'min-h-[10px]'"
                            :data-page-index="index"
                            :data-row-index="rowIndex"
                            :data-column-index="col - 1"
                            x-init="initSortableColumn($el)"
                            x-data="{ isHover: false }"
                            @mouseenter="isHover = true"
                            @mouseleave="isHover = false"
                            :style="isHover ? 'background: rgba(59, 130, 246, 0.02);' : ''"
                          >
                            <!-- Render Elements -->
                            <div class="flex flex-col gap-0 relative z-10 p-0 h-full" style="min-height:10px;">
                              <template x-for="element in (row.elements || []).filter(e => e.column === col - 1)" :key="element.id">
                                <div 
                                  class="group/el relative element-wrapper transition-all sortable-item border border-dashed border-transparent" 
                                  :data-id="element.id"
                                >
                                  <!-- Drop Indicator (Blue Line) -->
                                  <div 
                                    x-show="dragTargetElementId === element.id" 
                                    class="absolute -top-1 left-0 right-0 h-1 bg-blue-500 rounded z-[60] pointer-events-none transition-all shadow-sm"
                                    x-transition.opacity
                                  ></div>

                                  <!-- Top-Center Drag Handle -->
                                  <div 
                                    class="absolute -top-3 left-2 opacity-0 group-hover/el:opacity-100 transition-all z-[70] cursor-move drag-handle-pill"
                                    title="Réorganiser"
                                  >
                                    <div class="bg-primary/80 text-white rounded-full p-1 shadow-sm flex items-center justify-center hover:scale-110 transition-transform">
                                      <iconify-icon icon="solar:reorder-bold" width="12"></iconify-icon>
                                    </div>
                                  </div>

                                  <!-- Element Controls (Simplified Right) -->
                                  <div class="element-controls absolute -top-3 right-0 flex gap-1 opacity-0 group-hover/el:opacity-100 transition-all z-[70]">
                                    <button class="bg-white dark:bg-gray-800 text-gray-400 hover:text-primary rounded-full p-1 shadow-xs border dark:border-gray-700 flex items-center justify-center transition-colors" title="Dupliquer" @click.stop="duplicateElement(index, rowIndex, element.id)">
                                      <iconify-icon icon="solar:copy-linear" width="12"></iconify-icon>
                                    </button>
                                    <button class="bg-white dark:bg-gray-800 text-gray-400 hover:text-red-500 rounded-full p-1 shadow-xs border dark:border-gray-700 flex items-center justify-center transition-colors" title="Supprimer" @click.stop="deleteElement(index, rowIndex, element.id)">
                                      <iconify-icon icon="solar:trash-bin-trash-linear" width="12"></iconify-icon>
                                    </button>
                                  </div>

                                  <!-- Standard Text Element (with HTML support for presets) -->
                                  <template x-if="element.type === 'text'">
                                    <div 
                                      contenteditable="true" 
                                      class="outline-none min-h-[1.5em] p-0 border border-transparent hover:border-gray-100 focus:!border-blue-400/30 focus:!ring-2 focus:!ring-blue-400/10 rounded transition-all editor-content"
                                      style="outline: none !important;"
                                      x-html="element.content"
                                      @blur="updateElementContent($event, index, rowIndex, element.id)"
                                    ></div>
                                  </template>

                                  <!-- Plain Text Element (Stripped HTML) -->
                                  <template x-if="element.type === 'plain-text'">
                                    <div 
                                      contenteditable="true" 
                                      class="outline-none min-h-[1.5em] p-1 border border-transparent hover:border-gray-100 focus:!border-blue-400/30 focus:!ring-2 focus:!ring-blue-400/10 rounded transition-all italic text-gray-500"
                                      style="outline: none !important;"
                                      x-text="element.content"
                                      @blur="updateElementContent($event, index, rowIndex, element.id)"
                                    ></div>
                                  </template>

                                  <!-- HTML Element (WYSIWYG with Word Clean) -->
                                  <template x-if="element.type === 'html'">
                                     <div class="relative group/html">
                                       <div 
                                         contenteditable="true"
                                         class="outline-none min-h-[1.5em] p-0 border border-transparent hover:border-gray-100 focus:!border-blue-400/30 focus:!ring-2 focus:!ring-blue-400/10 rounded transition-all editor-content"
                                         style="outline: none !important;"
                                         x-html="element.content"
                                         @blur="updateElementContent($event, index, rowIndex, element.id)"
                                         @paste="handleLayoutPaste($event, index, rowIndex, element.id)"
                                       ></div>
                                     </div>
                                  </template>

                                  <!-- Image Element -->
                                  <template x-if="element.type === 'image'">
                                    <div class="relative w-full overflow-hidden rounded-lg bg-gray-50 dark:bg-gray-800/30 border border-dashed border-gray-300 dark:border-gray-600 hover:border-primary/50 transition-all group/img flex flex-col items-center justify-center" 
                                         style="aspect-ratio: 2/1;">
                                      
                                      <!-- Placeholder -->
                                      <div x-show="!element.content" class="flex flex-col items-center justify-center text-gray-400 gap-2 select-none">
                                        <div class="w-12 h-12 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center mb-1 group-hover/img:scale-110 transition-transform">
                                          <iconify-icon icon="solar:gallery-upload-bold-duotone" width="28" class="text-gray-400"></iconify-icon>
                                        </div>
                                        <span class="text-[10px] uppercase tracking-wider font-bold opacity-60">Ajouter une Image</span>
                                      </div>

                                      <!-- Image Display -->
                                      <img x-show="element.content" :src="element.content" class="absolute inset-0 w-full h-full object-cover">
                                      
                                      <!-- Hover Overlay -->
                                      <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
                                         <div class="bg-white/90 dark:bg-gray-900/90 p-2 rounded-full shadow-lg text-primary pointer-events-auto cursor-pointer hover:scale-110 transition-transform">
                                           <iconify-icon icon="solar:gallery-send-bold" width="20"></iconify-icon>
                                         </div>
                                      </div>
                                    </div>
                                  </template>
                                </div>
                              </template>
                            </div>

                            <!-- Empty State / Add Button -->
                            <div 
                              x-show="!(row.elements || []).some(e => e.column === col - 1)" 
                              class="absolute inset-0 flex items-center justify-center pointer-events-none transition-opacity duration-200"
                              :style="'opacity: ' + (isHover ? '1' : '0') + '; z-index: 100;'"
                            >
                              <button 
                                class="w-10 h-10 rounded-full bg-white dark:bg-gray-800 shadow-xl flex items-center justify-center text-gray-400 border border-gray-100 dark:border-gray-700 hover:text-primary hover:scale-110 transition-all"
                                style="pointer-events: auto !important;"
                                @click.stop="addElement(index, rowIndex, col - 1, 'text')"
                              >
                                <iconify-icon icon="solar:add-circle-bold" width="28"></iconify-icon>
                              </button>
                            </div>
                          </div>
                        </template>
                      </div>

                      <!-- 3. Action Controls (Bottom Center) - Floating Pill (Screenshot Style) -->
                      <div 
                        class="section-controls absolute -bottom-3 left-1/2 -translate-x-1/2 translate-y-full opacity-0 transition-all duration-300 flex items-center justify-center gap-3 bg-white dark:bg-gray-900 rounded-full shadow-lg border border-gray-100 dark:border-gray-700 px-3 py-1 scale-90 group-hover:scale-100"
                        style="z-index: 1000; pointer-events: none;"
                      >
                        <!-- Add Section -->
                        <button 
                          @click.stop="insertRowAfter(index, rowIndex)" 
                          class="text-gray-400 hover:text-primary transition-colors flex items-center justify-center" 
                          style="pointer-events: auto !important;"
                          title="Ajouter une section dessous"
                        >
                           <iconify-icon icon="solar:add-circle-linear" width="18"></iconify-icon>
                        </button>
                        
                        <div class="w-px h-3 bg-gray-200 dark:bg-gray-700"></div>

                        <!-- Duplicate -->
                        <button 
                          @click.stop="duplicateRow(index, rowIndex)" 
                          class="text-gray-400 hover:text-primary transition-colors flex items-center justify-center" 
                          style="pointer-events: auto !important;"
                          title="Dupliquer la section"
                        >
                           <iconify-icon icon="solar:copy-linear" width="16"></iconify-icon>
                        </button>
                        
                        <!-- Delete -->
                        <button 
                          @click.stop="deleteRow(index, rowIndex)" 
                          class="text-gray-400 hover:text-red-500 transition-colors flex items-center justify-center" 
                          style="pointer-events: auto !important;"
                          title="Supprimer la section"
                        >
                           <iconify-icon icon="solar:trash-bin-trash-linear" width="16"></iconify-icon>
                        </button>
                      </div>

                    </div>
                  </div>
                </template>

              </div>
            </div>

            <!-- Page Actions Bar (bottom) -->
            <div class="flex items-center justify-center gap-1 mt-2 opacity-0 group-hover:opacity-100 transition-opacity">
              <button @click="addPageAfter(index)" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-primary transition-colors" title="Ajouter une page après">
                <iconify-icon icon="solar:add-circle-bold" width="18"></iconify-icon>
              </button>
              <button @click="duplicatePage(index)" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-primary transition-colors" title="Dupliquer">
                <iconify-icon icon="solar:copy-bold" width="18"></iconify-icon>
              </button>
              <button @click="deletePage(index)" x-show="doc.pages.length > 1" class="p-2 rounded hover:bg-white dark:hover:bg-gray-700 text-gray-400 hover:text-danger transition-colors" title="Supprimer">
                <iconify-icon icon="solar:trash-bin-trash-bold" width="18"></iconify-icon>
              </button>
            </div>
          </div>
        </template>
      </div>
    </div>
