<!-- Tenant Admin - Members Management -->
<div>
    <!-- Header -->
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
        <a href="/account/<%= account_number %>/admin" style="display: flex; align-items: center; gap: 6px; color: #4361ee; text-decoration: none; font-size: 13px; font-weight: 500; padding: 6px 14px; border-radius: 8px; background: rgba(67,97,238,0.08);">
            <iconify-icon icon="solar:arrow-left-bold" width="14"></iconify-icon>
            Retour
        </a>
        <div style="flex: 1;">
            <h1 style="font-size: 22px; font-weight: 800; color: #0e1726; margin: 0;">Membres</h1>
            <p style="font-size: 13px; color: #94a3b8; margin: 4px 0 0;"><%= account.name %> · <%= members.length %> membre(s)</p>
        </div>
        <button onclick="document.getElementById('inviteModal').showModal()" class="ltr:ml-auto rtl:mr-auto" style="display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: 10px; font-size: 13px; font-weight: 600; background: linear-gradient(135deg, #4361ee, #3b82f6); color: #fff; border: none; cursor: pointer;">
            <iconify-icon icon="solar:user-plus-bold" width="16"></iconify-icon>
            Inviter un membre
        </button>
    </div>

    <!-- Members Table -->
    <div style="background: #fff; border: 1px solid #e0e6ed; border-radius: 12px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #fafbfc;">
                    <th style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; font-weight: 600; padding: 12px 16px; text-align: left;">Membre</th>
                    <th style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; font-weight: 600; padding: 12px 16px; text-align: left;">Rôle workspace</th>
                    <th style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; font-weight: 600; padding: 12px 16px; text-align: left;">Plan</th>
                    <th style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; font-weight: 600; padding: 12px 16px; text-align: left;">Dernière connexion</th>
                    <th style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; font-weight: 600; padding: 12px 16px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% members.forEach(m => { %>
                <tr style="border-top: 1px solid #f1f5f9;">
                    <td style="padding: 14px 16px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(67,97,238,0.1); color: #4361ee; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px;">
                                <%= m.name ? m.name.charAt(0).toUpperCase() : '?' %>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #0e1726; font-size: 13px;"><%= m.name || '—' %></div>
                                <div style="font-size: 11px; color: #94a3b8;"><%= m.email %></div>
                            </div>
                        </div>
                    </td>
                    <td style="padding: 14px 16px;">
                        <% if (m.workspaceRole === 'owner') { %>
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; background: #ede9fe; color: #7c3aed;">
                                <iconify-icon icon="solar:crown-bold" width="12"></iconify-icon>
                                Propriétaire
                            </span>
                        <% } else if (m.workspaceRole === 'admin') { %>
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; background: #cffafe; color: #0891b2;">Admin</span>
                        <% } else if (m.workspaceRole === 'viewer') { %>
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; background: #f1f5f9; color: #64748b;">Lecteur</span>
                        <% } else { %>
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; background: #dbeafe; color: #2563eb;">Membre</span>
                        <% } %>
                    </td>
                    <td style="padding: 14px 16px;">
                        <% const planBadgeClass = { free: '#f1f5f9;color:#64748b', basic: '#dbeafe;color:#2563eb', premium: '#fef3c7;color:#d97706', enterprise: '#ede9fe;color:#7c3aed' }; %>
                        <span style="display: inline-flex; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; background: <%= planBadgeClass[m.membership?.plan] || planBadgeClass['free'] %>;">
                            <%= (m.membership?.plan || 'free').toUpperCase() %>
                        </span>
                    </td>
                    <td style="padding: 14px 16px; font-size: 12px; color: #94a3b8;">
                        <% if (m.lastLogin) { %>
                            <%= new Date(m.lastLogin).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                        <% } else { %>
                            —
                        <% } %>
                    </td>
                    <td style="padding: 14px 16px;">
                        <div style="display: flex; align-items: center; justify-content: flex-end; gap: 6px;">
                            <% if (m.workspaceRole !== 'owner' && String(m._id) !== String(user._id)) { %>
                                <!-- Role change -->
                                <select onchange="changeMemberRole('<%= m._id %>', this.value)" style="padding: 4px 8px; border-radius: 6px; border: 1px solid #e2e8f0; font-size: 12px; color: #334155; cursor: pointer;">
                                    <option value="admin" <%= m.workspaceRole === 'admin' ? 'selected' : '' %>>Admin</option>
                                    <option value="member" <%= m.workspaceRole === 'member' ? 'selected' : '' %>>Membre</option>
                                    <option value="viewer" <%= m.workspaceRole === 'viewer' ? 'selected' : '' %>>Lecteur</option>
                                </select>
                                <!-- Remove -->
                                <button onclick="removeMember('<%= m._id %>', '<%= m.name || m.email %>')" style="width: 30px; height: 30px; border-radius: 8px; background: transparent; border: none; cursor: pointer; color: #dc2626; display: flex; align-items: center; justify-content: center;" title="Retirer">
                                    <iconify-icon icon="solar:user-minus-bold" width="16"></iconify-icon>
                                </button>
                            <% } else if (m.workspaceRole === 'owner') { %>
                                <span style="font-size: 11px; color: #cbd5e1; font-style: italic;">propriétaire</span>
                            <% } else { %>
                                <span style="font-size: 11px; color: #cbd5e1; font-style: italic;">vous</span>
                            <% } %>
                        </div>
                    </td>
                </tr>
                <% }); %>
                <% if (members.length === 0) { %>
                <tr>
                    <td colspan="5" style="padding: 40px; text-align: center; color: #94a3b8;">Aucun membre trouvé</td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Pending Invitations -->
    <% if (pendingInvites.length > 0) { %>
    <div style="margin-top: 24px;">
        <h2 style="font-size: 16px; font-weight: 700; color: #0e1726; margin: 0 0 12px;">
            <iconify-icon icon="solar:letter-bold-duotone" width="18" style="color: #f59e0b; margin-right: 6px; vertical-align: -3px;"></iconify-icon>
            Invitations en attente (<%= pendingInvites.length %>)
        </h2>
        <div style="background: #fff; border: 1px solid #e0e6ed; border-radius: 12px; overflow: hidden;">
            <% pendingInvites.forEach(inv => { %>
            <div style="padding: 14px 20px; border-bottom: 1px solid #f8fafc; display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(245,158,11,0.1); display: flex; align-items: center; justify-content: center;">
                        <iconify-icon icon="solar:letter-bold" width="16" style="color: #f59e0b;"></iconify-icon>
                    </div>
                    <div>
                        <div style="font-size: 13px; font-weight: 600; color: #0e1726;"><%= inv.email %></div>
                        <div style="font-size: 11px; color: #94a3b8;">Invité en tant que <%= inv.role %> · <% if (inv.expiresAt) { %>expire le <%= new Date(inv.expiresAt).toLocaleDateString('fr-FR') %><% } %></div>
                    </div>
                </div>
                <button onclick="cancelInvite('<%= inv._id %>')" style="padding: 5px 12px; border-radius: 6px; border: 1px solid #fecaca; background: #fee2e2; color: #dc2626; font-size: 11px; font-weight: 600; cursor: pointer;">
                    Annuler
                </button>
            </div>
            <% }); %>
        </div>
    </div>
    <% } %>
</div>

<!-- Invite Modal -->
<dialog id="inviteModal" style="border: none; border-radius: 16px; padding: 0; max-width: 440px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.15); overflow: hidden;">
    <div style="background: linear-gradient(135deg, #4361ee, #06b6d4); padding: 24px;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;">
                    <iconify-icon icon="solar:user-plus-bold-duotone" width="22" style="color: #fff;"></iconify-icon>
                </div>
                <div>
                    <h3 style="font-size: 17px; font-weight: 700; color: #fff; margin: 0;">Inviter un membre</h3>
                    <p style="font-size: 12px; color: rgba(255,255,255,0.7); margin: 2px 0 0;">Envoyer une invitation au workspace</p>
                </div>
            </div>
            <button onclick="this.closest('dialog').close()" style="width: 32px; height: 32px; border-radius: 8px; background: rgba(255,255,255,0.15); border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                <iconify-icon icon="solar:close-circle-bold" width="20" style="color: #fff;"></iconify-icon>
            </button>
        </div>
    </div>
    <form id="inviteForm" style="padding: 24px;">
        <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">Adresse email <span style="color: #dc2626;">*</span></label>
            <input name="email" type="email" required style="width: 100%; padding: 10px 14px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 13.5px; color: #0f172a; outline: none; box-sizing: border-box;" placeholder="membre@example.com" />
        </div>
        <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">Rôle dans le workspace</label>
            <select name="role" style="width: 100%; padding: 10px 14px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 13.5px; color: #0f172a; cursor: pointer;">
                <option value="member">Membre</option>
                <option value="admin">Admin</option>
                <option value="viewer">Lecteur</option>
            </select>
        </div>
    </form>
    <div style="padding: 16px 24px; border-top: 1px solid #f1f5f9; display: flex; gap: 10px; justify-content: flex-end;">
        <button onclick="this.closest('dialog').close()" style="padding: 8px 16px; border-radius: 10px; font-size: 13px; font-weight: 600; background: #fff; color: #334155; border: 1px solid #e2e8f0; cursor: pointer;">Annuler</button>
        <button onclick="inviteMember()" id="inviteBtn" style="padding: 8px 16px; border-radius: 10px; font-size: 13px; font-weight: 600; background: linear-gradient(135deg, #4361ee, #3b82f6); color: #fff; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
            <iconify-icon icon="solar:letter-bold" width="14"></iconify-icon>
            Envoyer l'invitation
        </button>
    </div>
</dialog>

<script>
const accountNumber = '<%= account_number %>';

async function apiCall(endpoint, body) {
    const res = await fetch(`/account/${accountNumber}/admin/api/${endpoint}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(body)
    });
    return res.json();
}

async function changeMemberRole(userId, role) {
    const data = await apiCall('members/role', { userId, role });
    if (data.success) location.reload();
    else alert(data.error || 'Erreur');
}

async function removeMember(userId, name) {
    if (!confirm(`Retirer ${name} du workspace ?`)) return;
    const data = await apiCall('members/remove', { userId });
    if (data.success) location.reload();
    else alert(data.error || 'Erreur');
}

async function cancelInvite(inviteId) {
    if (!confirm('Annuler cette invitation ?')) return;
    const data = await apiCall('invites/cancel', { inviteId });
    if (data.success) location.reload();
    else alert(data.error || 'Erreur');
}

async function inviteMember() {
    const form = document.getElementById('inviteForm');
    const fd = new FormData(form);
    const btn = document.getElementById('inviteBtn');
    btn.disabled = true;
    try {
        const data = await apiCall('members/invite', Object.fromEntries(fd));
        if (data.success) {
            alert('Invitation envoyée ! Lien : ' + data.inviteLink);
            location.reload();
        } else {
            alert(data.error || 'Erreur');
            btn.disabled = false;
        }
    } catch (e) { alert('Erreur'); btn.disabled = false; }
}
</script>
