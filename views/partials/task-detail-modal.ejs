	        async createOption(kind) {
	            const label = String(this.optionSearch[kind] || '').trim();
	            if (!label) return;
	            const meta = this.optionMeta(kind);
		            const next = this.normalizeOptions([
		                ...(this[meta.optionsKey] || []),
		                { label, color: kind === 'priority' ? '#8b5cf6' : (kind === 'tag' ? '#6366f1' : '#4361ee'), order: (this[meta.optionsKey] || []).length }
		            ], this.defaults[meta.payload]);
	            try {
	                const saved = await this.saveOptions(kind, next);
	                const created = saved.find(option => option.label === label) || next[next.length - 1];
	                await this.selectOption(kind, created);
	            } catch (e) {}
