    </style>
    <script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('docsModule', () => ({
            loading: true,
            loadingTemplates: true,
            generatedDocs: [],
            templates: [],
            openTemplates: [],
            expandedTemplates: [],
            generatingId: null,
            showPreview: false,
            previewName: '',
            draftDocId: null,
            finalizing: false,
            finalized: false,
	            downloadUrl: '',
	            renamingDocId: null,
	            docContextMenu: { show: false, x: 0, y: 0, doc: null },
	            sectionContextMenu: { show: false, x: 0, y: 0, section: null },
	            nameModal: { show: false, mode: '', title: '', label: '', value: '', target: null, saving: false },
	            deleteModal: { show: false, type: '', title: '', message: '', target: null, saving: false },
	            editingAttachmentId: null,
            deleteDraftOnCancel: true,
	            copyingDocId: null,
	            creatingTemplate: false,
	            creatingSimpleDoc: false,
	            creatingFolder: false,
	            documentFolders: [],
	            _accountNumber: '<%= account_number %>',
            _entityId: '<%= entity._id %>',
            _entityName: '<%= (entity.name || "").replace(/'/g, "\\'") %>',
            _entityIcon: '<%= entity.icon || "solar:layers-bold-duotone" %>',
	            _entitySlug: '<%= entity.slug || "" %>',
	            _entityColor: '<%= entity.color || "" %>',
	            _recordId: '<%= record._id %>',
	            _recordTitle: '<%= ((record.computedTitle || record.title || "")).replace(/'/g, "\\'") %>',
	            activeDocsTab: 'templates',

	            docsTabStorageKey() {
	                return `record-docs-tab:${this._accountNumber}:${this._recordId}`;
	            },

	            loadPersistedDocsTab() {
	                try {
	                    const tab = localStorage.getItem(this.docsTabStorageKey());
	                    return tab === 'documents' ? 'documents' : 'templates';
	                } catch (_) {
	                    return 'templates';
	                }
	            },

		            setDocsTab(tab) {
		                this.activeDocsTab = tab === 'documents' ? 'documents' : 'templates';
		                try {
		                    localStorage.setItem(this.docsTabStorageKey(), this.activeDocsTab);
		                } catch (_) {}
		            },

		            openNameModal({ mode, title, label, value = '', target = null }) {
		                this.closeDocContext();
		                this.closeSectionContext();
		                this.nameModal = { show: true, mode, title, label, value, target, saving: false };
		                this.$nextTick(() => {
		                    const input = document.getElementById('docs-name-modal-input');
		                    if (input) {
		                        input.focus();
		                        input.select();
		                    }
		                });
		            },

		            closeNameModal() {
		                if (this.nameModal.saving) return;
		                this.nameModal.show = false;
		            },

		            async submitNameModal() {
		                const name = String(this.nameModal.value || '').trim();
		                if (!name || this.nameModal.saving) return;
		                this.nameModal.saving = true;
		                try {
		                    if (this.nameModal.mode === 'create-folder') {
		                        await this.createFolderWithName(name);
		                    } else if (this.nameModal.mode === 'rename-folder') {
		                        await this.renameFolderWithName(this.nameModal.target, name);
		                    } else if (this.nameModal.mode === 'rename-template') {
		                        await this.renameTemplateWithName(this.nameModal.target, name);
		                    } else if (this.nameModal.mode === 'rename-doc') {
		                        await this.renameDocWithName(this.nameModal.target, name);
		                    }
		                    this.nameModal.show = false;
		                } catch (err) {
		                    console.error('[DocsModule] Name modal error:', err);
		                    window.showMessage ? window.showMessage(err.message || 'Action impossible', 'danger') : alert(err.message || 'Action impossible');
		                }
		                this.nameModal.saving = false;
		            },

            async createRecordTemplate() {
                if (this.creatingTemplate) return;
                this.creatingTemplate = true;
                try {
                    // 1. Create the Document
                    const docRes = await fetch(`/account/${this._accountNumber}/documents/api`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({
                            name: 'Nouveau modèle',
                            isTemplate: true,
                            entityId: this._entityId, // Keep for legacy
                            entityIds: [this._entityId], // New structure for data binding
                            linkedRecords: [{
                                recordId: this._recordId,
                                recordTitle: this._recordTitle,
                                entityId: this._entityId,
                                entityName: this._entityName,
                                entityIcon: this._entityIcon,
                                entitySlug: this._entitySlug,
                                entityColor: this._entityColor,
                                alias: this._entitySlug
                            }],
                            format: 'A4',
                            orientation: 'portrait'
                        })
                    });
                    const docData = await docRes.json();
                    if (!docData.success) throw new Error('Erreur creation doc');
                    
                    // 2. Create the SmartDocTemplate linked to this record
                    const smartRes = await fetch(`/account/${this._accountNumber}/api/smartdoc/templates`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({
                            name: docData.document.name,
                            documentId: docData.document._id,
                            entityId: this._entityId,
                            scopeType: 'record',
                            scopeRecordId: this._recordId,
                            outputFormat: 'pdf',
                            active: true
                        })
                    });
	                    const smartData = await smartRes.json();
	                    if (!smartData.success) throw new Error('Erreur creation smart doc');

	                    // 3. Redirect to the editor
	                    const returnTo = encodeURIComponent(window.location.href);
	                    window.location.href = `/account/${this._accountNumber}/documents/${docData.document._id}/edit-react?isTemplate=true&returnTo=${returnTo}`;
                } catch (err) {
                    console.error(err);
                    window.showMessage ? window.showMessage("Erreur lors de la création du modèle", 'danger') : alert("Erreur lors de la création du modèle");
                    this.creatingTemplate = false;
	                }
	            },

		            createSimpleFolder() {
		                if (this.creatingFolder) return;
		                this.openNameModal({
		                    mode: 'create-folder',
		                    title: 'Nouveau dossier',
		                    label: 'Nom du dossier',
		                    value: 'Documents IA'
		                });
		            },

		            async createFolderWithName(name) {
		                if (this.creatingFolder) return;
		                this.creatingFolder = true;
		                try {
		                    const res = await fetch(`/account/${this._accountNumber}/documents/api/folders`, {
		                        method: 'POST',
		                        headers: { 'Content-Type': 'application/json' },
		                        credentials: 'include',
		                        body: JSON.stringify({
		                            name,
		                            color: '#4361ee',
		                            scope: 'record',
		                            recordId: this._recordId,
		                            entityId: this._entityId
		                        })
		                    });
		                    const data = await res.json();
		                    if (!res.ok || !data.success) throw new Error(data.error || 'Création impossible');
		                    if (!this.documentFolders.some(folder => String(folder._id) === String(data.folder._id))) {
		                        this.documentFolders.push(data.folder);
		                    }
		                    const sectionId = `__simple_folder_${data.folder._id}`;
		                    if (!this.openTemplates.includes(sectionId)) this.openTemplates.unshift(sectionId);
		                    if (window.showMessage) window.showMessage('Dossier créé', 'success');
		                } finally {
		                    this.creatingFolder = false;
		                }
		            },

	            findDocumentFolder(name) {
	                const target = String(name || '').trim().toLowerCase();
	                return this.documentFolders.find(folder => String(folder.name || '').trim().toLowerCase() === target) || null;
	            },

	            async ensureSimpleFolder(name = 'Documents IA') {
	                const existing = this.findDocumentFolder(name);
	                if (existing) return existing;
	                const res = await fetch(`/account/${this._accountNumber}/documents/api/folders`, {
	                    method: 'POST',
	                    headers: { 'Content-Type': 'application/json' },
	                    credentials: 'include',
	                    body: JSON.stringify({
	                        name,
	                        color: '#4361ee',
	                        scope: 'record',
	                        recordId: this._recordId,
	                        entityId: this._entityId
	                    })
	                });
	                const data = await res.json();
	                if (!res.ok || !data.success) throw new Error(data.error || 'Création dossier impossible');
	                if (!this.documentFolders.some(folder => String(folder._id) === String(data.folder._id))) {
	                    this.documentFolders.push(data.folder);
	                }
	                return data.folder;
	            },

	            nextSimpleDocName() {
	                const baseName = 'Nouveau document';
	                const existingNames = new Set(
	                    this.generatedDocs
	                        .map(doc => String(doc.originalName || doc.name || '').replace(/\.pdf$/i, '').trim().toLowerCase())
	                        .filter(Boolean)
	                );
	                if (!existingNames.has(baseName.toLowerCase())) return baseName;
	                let index = 2;
	                while (existingNames.has(`${baseName} ${index}`.toLowerCase())) index += 1;
	                return `${baseName} ${index}`;
	            },

	            async createSimpleDoc(folder = null) {
	                if (this.creatingSimpleDoc) return;
	                this.creatingSimpleDoc = true;
	                try {
	                    const targetFolder = folder || await this.ensureSimpleFolder('Documents IA');
	                    const folderName = targetFolder?.name || 'Documents IA';
	                    const folderId = targetFolder?.folderId || targetFolder?._id || null;
	                    const name = this.nextSimpleDocName();
	                    const docRes = await fetch(`/account/${this._accountNumber}/documents/api`, {
	                        method: 'POST',
	                        headers: { 'Content-Type': 'application/json' },
	                        credentials: 'include',
	                        body: JSON.stringify({
	                            name,
	                            isTemplate: false,
	                            isDraft: true,
	                            draftRecordId: this._recordId,
	                            draftOutputName: name,
	                            draftOutputFormat: 'pdf',
	                            status: 'draft',
	                            entityId: this._entityId,
	                            folderId,
	                            linkedRecords: [{
	                                recordId: this._recordId,
	                                recordTitle: this._recordTitle,
	                                entityId: this._entityId,
	                                entityName: this._entityName,
	                                entityIcon: this._entityIcon,
	                                entitySlug: this._entitySlug,
	                                entityColor: this._entityColor,
	                                alias: this._entitySlug
	                            }],
	                            metadata: {
	                                docKind: 'simple',
	                                simpleFolder: folderName,
	                                createdFromRecordDocs: true
	                            },
	                            format: 'A4',
	                            orientation: 'portrait',
	                            dimensions: { width: 794, height: 1123 },
	                            pages: [{
	                                content: '<p><br></p>',
	                                mode: 'edition',
	                                elements: [],
	                                rows: [],
	                                background: { color: '#ffffff' },
	                                order: 0
	                            }]
	                        })
	                    });
	                    const docData = await docRes.json();
	                    if (!docData.success) throw new Error(docData.error || 'Création impossible');
	                    const returnTo = encodeURIComponent(window.location.href);
	                    window.location.href = `/account/${this._accountNumber}/documents/${docData.document._id}/edit-react?returnTo=${returnTo}`;
	                } catch (err) {
	                    console.error('[DocsModule] Simple doc creation error:', err);
	                    window.showMessage ? window.showMessage(err.message || 'Erreur document', 'danger') : alert(err.message || 'Erreur document');
	                    this.creatingSimpleDoc = false;
	                }
	            },

	            get templateSections() {
	                return [...this.templates];
	            },

	            get documentSections() {
	                return [...this.simpleFolderSections];
	            },

	            get documentCount() {
	                return this.generatedDocs.filter(d => this.isSimpleDoc(d)).length;
	            },

	            get simpleFolderSections() {
	                const byKey = new Map();
	                this.documentFolders.forEach(folder => {
	                    const key = folder._id || folder.name;
	                    byKey.set(String(key), {
	                        _id: `__simple_folder_${key}`,
	                        folderId: folder._id || '',
	                        name: folder.name || 'Documents',
	                        color: folder.color || '#4361ee',
	                        isSimpleFolder: true,
	                        isAgentDocs: true
	                    });
	                });
	                this.generatedDocs.filter(d => this.isSimpleDoc(d)).forEach(doc => {
	                    const folderId = doc.simpleFolderId || '';
	                    const folderName = doc.simpleFolder || doc.generatedFromName || 'Documents IA';
	                    const key = folderId || folderName;
	                    if (!byKey.has(String(key))) {
	                        byKey.set(String(key), {
	                            _id: folderId ? `__simple_folder_${folderId}` : `__simple_folder_name_${folderName}`,
	                            folderId,
	                            name: folderName,
	                            color: '#4361ee',
	                            isSimpleFolder: true,
	                            isAgentDocs: true
	                        });
	                    }
	                });
	                return Array.from(byKey.values());
	            },

		            isSimpleDoc(doc) {
		                return Boolean(doc?.isSimpleDoc);
		            },

	            // Templates sorted by most recent generation (template with latest doc first)
	            get sortedTemplates() {
	                return [...this.templateSections].sort((a, b) => {
	                    const aDocs = this.getDocsForTemplate(a.name, a._id);
	                    const bDocs = this.getDocsForTemplate(b.name, b._id);
	                    const aDate = aDocs.length > 0 ? new Date(aDocs[0].uploadedAt) : new Date(0);
	                    const bDate = bDocs.length > 0 ? new Date(bDocs[0].uploadedAt) : new Date(0);
	                    return bDate - aDate;
	                });
	            },

	            get sortedDocumentSections() {
	                return [...this.documentSections].sort((a, b) => {
	                    const aDocs = this.getDocsForTemplate(a.name, a._id);
	                    const bDocs = this.getDocsForTemplate(b.name, b._id);
	                    const aDate = aDocs.length > 0 ? new Date(aDocs[0].uploadedAt) : new Date(0);
	                    const bDate = bDocs.length > 0 ? new Date(bDocs[0].uploadedAt) : new Date(0);
	                    return bDate - aDate;
	                });
	            },

	            get visibleSections() {
	                return this.activeDocsTab === 'documents' ? this.sortedDocumentSections : this.sortedTemplates;
	            },

	            getDocsForTemplate(tplName, tplId = '') {
	                const folder = this.simpleFolderSections.find(section => section._id === tplId);
	                if (folder) {
	                    return this.generatedDocs.filter(d => {
	                        if (!this.isSimpleDoc(d)) return false;
	                        if (folder.folderId) return d.simpleFolderId === folder.folderId;
	                        return (d.simpleFolder || d.generatedFromName || 'Documents IA') === folder.name;
	                    });
	                }
		                return this.generatedDocs.filter(d => {
		                    if (this.isSimpleDoc(d)) return false;
		                    const generatedId = String(d.generatedFrom?.smartDocId || d.generatedFrom || '');
		                    return generatedId === String(tplId || '') || d.generatedFromName === tplName;
		                });
		            },

            getVisibleDocs(tplName, tplId) {
                const all = this.getDocsForTemplate(tplName, tplId);
                if (this.expandedTemplates.includes(tplId) || all.length <= 5) return all;
                return all.slice(0, 5);
            },

            expandTemplate(tplId) {
                if (!this.expandedTemplates.includes(tplId)) this.expandedTemplates.push(tplId);
            },

            toggleTemplate(tplId) {
                const idx = this.openTemplates.indexOf(tplId);
                if (idx >= 0) {
                    this.openTemplates.splice(idx, 1);
                } else {
                    this.openTemplates.push(tplId);
                }
            },

	            async init() {
	                this.activeDocsTab = this.loadPersistedDocsTab();
	                await Promise.all([this.loadGeneratedDocs(), this.loadTemplates()]);
	                // Auto-open all templates that have generated docs
	                [...this.sortedTemplates, ...this.sortedDocumentSections].forEach(tpl => {
	                    if (this.getDocsForTemplate(tpl.name, tpl._id).length > 0) {
	                        this.openTemplates.push(tpl._id);
	                    }
                });
                // Listen for cancel from iframe
                window.addEventListener('message', (e) => {
                    if (e.data && e.data.type === 'smartdoc-cancel') {
                        this.cancelPreview();
                    }
                });
            },

            async loadGeneratedDocs() {
                this.loading = true;
                try {
	                    const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/attachments?includeDrafts=true`, {
	                        credentials: 'include'
	                    });
	                    const data = await res.json();
	                    if (data.success && data.attachments) {
	                        this.documentFolders = data.documentFolders || [];
	                        this.generatedDocs = data.attachments
	                            .filter(a => a.isGenerated)
	                            .sort((a, b) => new Date(b.uploadedAt) - new Date(a.uploadedAt));
                    }
                } catch (e) {
                    console.error('[DocsModule] Load generated docs error:', e);
                    // Fallback: try to read from server-rendered record data
                    try {
                        const record = JSON.parse('<%-  JSON.stringify(record.attachments || []).replace(/\'/g, "\\'") %>');
                        this.generatedDocs = record.filter(a => a.isGenerated)
                            .sort((a, b) => new Date(b.uploadedAt) - new Date(a.uploadedAt));
                    } catch (e2) { /* ignore */ }
                }
                this.loading = false;
            },

            async loadTemplates() {
                this.loadingTemplates = true;
                try {
                    const url = `/account/${this._accountNumber}/api/smartdoc/templates/${this._entityId}?recordId=${this._recordId}`;
                    const res = await fetch(url, { credentials: 'include' });
                    const data = await res.json();
                    if (data.success && data.templates) {
                        this.templates = data.templates;
                    }
                } catch (e) {
                    console.error('[DocsModule] Load templates error:', e);
                }
                this.loadingTemplates = false;
            },

            formatDate(dateStr) {
                if (!dateStr) return '';
                const d = new Date(dateStr);
                return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
            },

	            openGeneratedDoc(doc) {
	                if (doc?.isAgentDraft && doc.editUrl) {
	                    const returnTo = encodeURIComponent(window.location.href);
	                    const sep = doc.editUrl.includes('?') ? '&' : '?';
	                    window.location.href = `${doc.editUrl}${sep}returnTo=${returnTo}`;
	                    return;
	                }
                if (!doc?.filename) return;
                window.openFileViewer('/account/' + this._accountNumber + '/uploads/attachments/' + doc.filename, doc.originalName || doc.generatedFromName || 'Document', doc.category || 'pdf', null, null, { onEdit: () => this.editGeneratedDoc(doc) });
            },

            openDocContext(event, doc) {
                this.docContextMenu = {
                    show: true,
                    x: event.clientX,
                    y: event.clientY,
                    doc
                };
            },

	            closeDocContext() {
	                this.docContextMenu.show = false;
	            },

	            openSectionContext(event, section) {
	                this.closeDocContext();
	                this.sectionContextMenu = {
	                    show: true,
	                    x: event.clientX,
	                    y: event.clientY,
	                    section
	                };
	            },

	            closeSectionContext() {
	                this.sectionContextMenu.show = false;
	            },

	            renameSection(section) {
	                if (!section) return;
	                this.openNameModal({
	                    mode: section.isSimpleFolder ? 'rename-folder' : 'rename-template',
	                    title: section.isSimpleFolder ? 'Renommer le dossier' : 'Renommer le template',
	                    label: section.isSimpleFolder ? 'Nom du dossier' : 'Nom du template',
	                    value: section.name || '',
	                    target: section
	                });
	            },

	            async renameFolderWithName(section, name) {
	                if (!section?.folderId) throw new Error('Dossier introuvable');
	                const oldName = section.name;
	                const res = await fetch(`/account/${this._accountNumber}/documents/api/folders/${section.folderId}`, {
	                    method: 'PUT',
	                    headers: { 'Content-Type': 'application/json' },
	                    credentials: 'include',
	                    body: JSON.stringify({ name })
	                });
	                const data = await res.json();
	                if (!res.ok || !data.success) throw new Error(data.error || 'Renommage impossible');
	                this.documentFolders = this.documentFolders.map(folder => (
	                    String(folder._id) === String(section.folderId) ? data.folder : folder
	                ));
	                this.generatedDocs.forEach(doc => {
	                    if (String(doc.simpleFolderId || '') === String(section.folderId) || doc.simpleFolder === oldName) {
	                        doc.simpleFolder = name;
	                        doc.generatedFromName = name;
	                    }
	                });
	                if (window.showMessage) window.showMessage('Dossier renommé', 'success');
	            },

	            async renameTemplateWithName(section, name) {
	                if (!section?._id) throw new Error('Template introuvable');
	                const oldName = section.name;
	                const res = await fetch(`/account/${this._accountNumber}/api/smartdoc/templates/${section._id}`, {
	                    method: 'PUT',
	                    headers: { 'Content-Type': 'application/json' },
	                    credentials: 'include',
	                    body: JSON.stringify({ name })
	                });
	                const data = await res.json();
	                if (!res.ok || !data.success) throw new Error(data.error || 'Renommage impossible');
	                if (section.documentId) {
	                    try {
	                        await fetch(`/account/${this._accountNumber}/documents/api/${section.documentId}`, {
	                            method: 'PUT',
	                            headers: { 'Content-Type': 'application/json' },
	                            credentials: 'include',
	                            body: JSON.stringify({ name })
	                        });
	                    } catch (_) {}
	                }
	                this.templates = this.templates.map(tpl => (
	                    String(tpl._id) === String(section._id) ? { ...tpl, name } : tpl
	                ));
	                this.generatedDocs.forEach(doc => {
	                    const generatedId = String(doc.generatedFrom?.smartDocId || doc.generatedFrom || '');
	                    if (generatedId === String(section._id) || doc.generatedFromName === oldName) {
	                        doc.generatedFromName = name;
	                    }
	                });
	                if (window.showMessage) window.showMessage('Template renommé', 'success');
	            },

	            editTemplate(section) {
	                this.closeSectionContext();
	                if (!section?.documentId) return;
	                const returnTo = encodeURIComponent(window.location.href);
	                window.location.href = `/account/${this._accountNumber}/documents/${section.documentId}/edit-react?isTemplate=true&returnTo=${returnTo}`;
	            },

	            requestDeleteSection(section) {
	                if (!section) return;
	                const count = this.getDocsForTemplate(section.name, section._id).length;
	                this.closeSectionContext();
	                this.deleteModal = {
	                    show: true,
	                    type: section.isSimpleFolder ? 'folder' : 'template',
	                    title: section.isSimpleFolder ? 'Supprimer le dossier' : 'Supprimer le template',
	                    message: section.isSimpleFolder
	                        ? (count > 0 ? `Le dossier sera supprimé. Les ${count} document(s) seront replacés dans Documents.` : 'Ce dossier vide sera supprimé.')
	                        : (count > 0 ? `Le template sera supprimé. Les ${count} document(s) déjà générés restent disponibles.` : 'Ce template sera supprimé.'),
	                    target: section,
	                    saving: false
	                };
	            },

	            closeDeleteModal() {
	                if (this.deleteModal.saving) return;
	                this.deleteModal.show = false;
	            },

		            async submitDeleteModal() {
		                if (!this.deleteModal.target || this.deleteModal.saving) return;
		                this.deleteModal.saving = true;
		                try {
		                    if (this.deleteModal.type === 'folder') {
		                        await this.deleteFolderSection(this.deleteModal.target);
		                    } else if (this.deleteModal.type === 'template') {
		                        await this.deleteTemplateSection(this.deleteModal.target);
		                    } else if (this.deleteModal.type === 'doc') {
		                        await this.deleteDocNow(this.deleteModal.target, { silentError: true });
		                    }
		                    this.deleteModal.show = false;
		                } catch (err) {
	                    console.error('[DocsModule] Delete section error:', err);
	                    window.showMessage ? window.showMessage(err.message || 'Suppression impossible', 'danger') : alert(err.message || 'Suppression impossible');
	                }
	                this.deleteModal.saving = false;
	            },

	            async deleteFolderSection(section) {
	                if (!section?.folderId) throw new Error('Dossier introuvable');
	                const res = await fetch(`/account/${this._accountNumber}/documents/api/folders/${section.folderId}`, {
	                    method: 'DELETE',
	                    credentials: 'include'
	                });
	                const data = await res.json();
	                if (!res.ok || !data.success) throw new Error(data.error || 'Suppression impossible');
	                this.documentFolders = this.documentFolders.filter(folder => String(folder._id) !== String(section.folderId));
	                this.openTemplates = this.openTemplates.filter(id => id !== section._id);
	                await this.loadGeneratedDocs();
	                if (window.showMessage) window.showMessage('Dossier supprimé', 'success');
	            },

	            async deleteTemplateSection(section) {
	                if (!section?._id) throw new Error('Template introuvable');
	                const res = await fetch(`/account/${this._accountNumber}/api/smartdoc/templates/${section._id}`, {
	                    method: 'DELETE',
	                    credentials: 'include'
	                });
	                const data = await res.json();
	                if (!res.ok || !data.success) throw new Error(data.error || 'Suppression impossible');
	                this.templates = this.templates.filter(tpl => String(tpl._id) !== String(section._id));
	                this.openTemplates = this.openTemplates.filter(id => id !== section._id);
		                if (window.showMessage) window.showMessage('Template supprimé', 'success');
		            },

		            requestDeleteDoc(doc) {
		                if (!doc) return;
		                this.closeDocContext();
		                this.deleteModal = {
		                    show: true,
		                    type: 'doc',
		                    title: 'Supprimer le document',
		                    message: `Supprimer « ${doc.originalName || doc.name || 'Document'} » ?`,
		                    target: doc,
		                    saving: false
		                };
		            },

		            renameGeneratedDoc(doc) {
	                this.closeDocContext();
	                if (!doc || this.renamingDocId) return;
	                const current = (doc.originalName || doc.generatedFromName || 'Document').replace(/\.pdf$/i, '');
	                this.openNameModal({
	                    mode: 'rename-doc',
	                    title: 'Renommer le document',
	                    label: 'Nom du document',
	                    value: current,
	                    target: doc
	                });
	            },

		            async renameDocWithName(doc, clean) {
		                if (!doc) return;
		                const originalName = clean.toLowerCase().endsWith('.pdf') ? clean : clean + '.pdf';
		                this.renamingDocId = doc._id;
		                try {
		                    const res = await fetch(`/account/${this._accountNumber}/api/records/${this._recordId}/attachments/${doc._id}`, {
		                        method: 'PATCH',
		                        headers: { 'Content-Type': 'application/json' },
		                        credentials: 'include',
		                        body: JSON.stringify({ originalName })
		                    });
		                    const data = await res.json();
		                    if (!res.ok || data.error) throw new Error(data.error || 'Renommage impossible');
		                    doc.originalName = originalName;
			                    if (window.showMessage) window.showMessage('Document renommé', 'success');
			                } catch (e) {
			                    console.error('[DocsModule] Rename error:', e);
			                    window.showMessage ? window.showMessage(e.message || 'Erreur lors du renommage', 'danger') : alert(e.message || 'Erreur lors du renommage');
			                    throw e;
			                } finally {
			                    this.renamingDocId = null;
			                }
			            },

            async generateDoc(tpl) {
                this.generatingId = tpl._id;
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/smartdoc/generate-draft/${tpl._id}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ recordId: this._recordId })
                    });
                    const data = await res.json();
                    if (data.success && data.draftDocumentId) {
                        this.draftDocId = data.draftDocumentId;
                        this.previewName = data.outputName || tpl.name;
                        this.showPreview = true;
                        this.finalized = false;
                        this.downloadUrl = '';
                        this.editingAttachmentId = null;
                        this.deleteDraftOnCancel = true;
                        this.$nextTick(() => {
                            const iframe = document.getElementById('docs-smartdoc-preview-iframe');
                            if (iframe) {
                                iframe.src = `/account/${this._accountNumber}/documents/${data.draftDocumentId}/edit-react?minimal=true`;
                            }
                        });
                    } else {
                        window.showMessage ? window.showMessage(data.error || 'Erreur de génération', 'danger') : alert(data.error || 'Erreur de génération');
                    }
                } catch (e) {
                    console.error('[DocsModule] Generate error:', e);
                    window.showMessage ? window.showMessage('Erreur de connexion', 'danger') : alert('Erreur de connexion');
                }
                this.generatingId = null;
            },

	            editGeneratedDoc(doc) {
	                if (doc?.isAgentDraft && doc.editUrl) {
	                    const returnTo = encodeURIComponent(window.location.href);
	                    const sep = doc.editUrl.includes('?') ? '&' : '?';
	                    window.location.href = `${doc.editUrl}${sep}returnTo=${returnTo}`;
	                    return;
	                }
                if (!doc?.snapshotDocumentId) {
                    window.showMessage ? window.showMessage('Aucun snapshot éditable pour ce PDF', 'warning') : alert('Aucun snapshot éditable pour ce PDF');
                    return;
                }
                this.draftDocId = doc.snapshotDocumentId;
                this.previewName = doc.originalName || doc.generatedFromName || 'Document';
                this.showPreview = true;
                this.finalized = false;
                this.downloadUrl = '';
                this.editingAttachmentId = doc._id;
                this.deleteDraftOnCancel = false;
                this.$nextTick(() => {
                    const iframe = document.getElementById('docs-smartdoc-preview-iframe');
                    if (iframe) {
                        iframe.src = `/account/${this._accountNumber}/documents/${doc.snapshotDocumentId}/edit-react?minimal=true`;
                    }
                });
            },

            async copyGeneratedDoc(doc) {
                if (!doc?.snapshotDocumentId || this.copyingDocId) {
                    if (!doc?.snapshotDocumentId) {
                        window.showMessage ? window.showMessage('Aucun snapshot à copier pour ce PDF', 'warning') : alert('Aucun snapshot à copier pour ce PDF');
                    }
                    return;
                }
                this.copyingDocId = doc._id;
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/smartdoc/snapshot/${doc.snapshotDocumentId}/copy`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ recordId: this._recordId })
                    });
                    const data = await res.json();
                    if (!data.success) throw new Error(data.error || 'Copie impossible');
                    this.draftDocId = data.draftDocumentId;
                    this.previewName = data.outputName || doc.originalName || 'Document';
                    this.showPreview = true;
                    this.finalized = false;
                    this.downloadUrl = '';
                    this.editingAttachmentId = null;
                    this.deleteDraftOnCancel = true;
                    this.$nextTick(() => {
                        const iframe = document.getElementById('docs-smartdoc-preview-iframe');
                        if (iframe) {
                            iframe.src = `/account/${this._accountNumber}/documents/${data.draftDocumentId}/edit-react?minimal=true`;
                        }
                    });
                } catch (e) {
                    console.error('[DocsModule] Copy generated doc error:', e);
                    window.showMessage ? window.showMessage(e.message || 'Erreur lors de la copie', 'danger') : alert(e.message || 'Erreur lors de la copie');
                }
                this.copyingDocId = null;
            },

            async finalizePreview() {
                if (!this.draftDocId || this.finalizing) return;
                this.finalizing = true;
                try {
                    // ── PERMANENT FIX: get live DOM content from iframe ──────────────────
                    // The iframe runs the React editor with uncontrolled contenteditable.
                    // The DB (draftDoc.pages) contains only the initial generated content.
                    // User edits live ONLY in the iframe DOM until autosave runs.
                    // We MUST send pagesContent from the iframe to get the correct PDF output.
                    let pagesContent = null;
                    try {
                        const iframe = document.getElementById('docs-smartdoc-preview-iframe');
                        if (iframe && iframe.contentWindow) {
                            pagesContent = await new Promise((resolve) => {
                                const timeout = setTimeout(() => resolve(null), 5000); // 5s timeout
                                const handler = (event) => {
                                    if (event.data && event.data.type === 'PAGES_CONTENT_RESPONSE') {
                                        clearTimeout(timeout);
                                        window.removeEventListener('message', handler);
                                        resolve(event.data.pagesContent || null);
                                    }
                                };
                                window.addEventListener('message', handler);
                                iframe.contentWindow.postMessage({ type: 'REQUEST_PAGES_CONTENT' }, '*');
                            });
                        }
                    } catch (e) {
                        console.warn('[DocsModule] Could not get pages from iframe:', e);
                    }

                    const res = await fetch(`/account/${this._accountNumber}/api/smartdoc/finalize-draft/${this.draftDocId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({
                            recordId: this._recordId,
                            pagesContent,
                            outputName: this.previewName || null,
                            replaceAttachmentId: this.editingAttachmentId || null
                        })
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.downloadUrl = data.attachment?.url ? (data.attachment.url + '?dl=' + encodeURIComponent(data.attachment.originalName || 'document.pdf')) : '';
                        this.finalized = true;
                        if (data.attachment) {
                            if (this.editingAttachmentId) {
                                const idx = this.generatedDocs.findIndex(d => d._id === this.editingAttachmentId);
                                if (idx !== -1) this.generatedDocs.splice(idx, 1, data.attachment);
                            } else {
                                this.generatedDocs.unshift(data.attachment);
                            }
                        }
                        this.draftDocId = null;
                        this.editingAttachmentId = null;
                        this.deleteDraftOnCancel = false;
                        if (window.showMessage) {
                            window.showMessage('Document généré avec succès !', 'success');
                        }
                    } else {
                        window.showMessage ? window.showMessage(data.error || 'Erreur de finalisation', 'danger') : alert(data.error || 'Erreur de finalisation');
                    }
                } catch (e) {
                    console.error('[DocsModule] Finalize error:', e);
                    window.showMessage ? window.showMessage('Erreur de connexion', 'danger') : alert('Erreur de connexion');
                }
                this.finalizing = false;
            },

            closePreview() {
                this.showPreview = false;
                this.finalized = false;
                this.downloadUrl = '';
                this.draftDocId = null;
                this.editingAttachmentId = null;
                this.deleteDraftOnCancel = true;
                this.previewName = '';
                const iframe = document.getElementById('docs-smartdoc-preview-iframe');
                if (iframe) iframe.src = '';
                window.location.reload();
            },

            async cancelPreview() {
                if (this.draftDocId && this.deleteDraftOnCancel) {
                    try {
                        await fetch(`/account/${this._accountNumber}/api/smartdoc/draft/${this.draftDocId}`, {
                            method: 'DELETE',
                            credentials: 'include'
                        });
                    } catch (e) { /* ignore */ }
                }
                this.showPreview = false;
                this.draftDocId = null;
                this.previewName = '';
                this.finalized = false;
                this.downloadUrl = '';
                this.editingAttachmentId = null;
                this.deleteDraftOnCancel = true;
                const iframe = document.getElementById('docs-smartdoc-preview-iframe');
                if (iframe) iframe.src = 'about:blank';
            },

            confirmingDocDelete: null,

	            async deleteDoc(doc) {
	                if (this.confirmingDocDelete !== doc._id) {
	                    this.confirmingDocDelete = doc._id;
	                    setTimeout(() => { if (this.confirmingDocDelete === doc._id) this.confirmingDocDelete = null; }, 3000);
	                    return;
	                }
	                this.confirmingDocDelete = null;
	                await this.deleteDocNow(doc);
	            },

	            async deleteDocNow(doc, options = {}) {
	                try {
		                    const deleteUrl = doc.isTemplateDraft
		                        ? `/account/${this._accountNumber}/api/smartdoc/draft/${doc._id}`
		                        : (doc.isAgentDraft
		                            ? `/account/${this._accountNumber}/documents/api/${doc._id}`
		                            : `/account/${this._accountNumber}/api/records/${this._recordId}/attachments/${doc._id}`);
		                    const res = await fetch(deleteUrl, {
	                        method: 'DELETE', credentials: 'include'
	                    });
                    const data = await res.json();
	                    if (data.success) {
	                        const idx = this.generatedDocs.findIndex(d => d._id === doc._id);
	                        if (idx !== -1) this.generatedDocs.splice(idx, 1);
	                        if (window.showMessage) window.showMessage('Document supprimé', 'success');
	                    } else {
	                        throw new Error(data.error || 'Erreur lors de la suppression');
	                    }
	                } catch (e) {
	                    console.error('[DocsModule] Delete error:', e);
	                    if (!options.silentError) {
	                        window.showMessage ? window.showMessage(e.message || 'Erreur réseau', 'danger') : alert(e.message || 'Erreur réseau');
	                    }
	                    throw e;
	                }
	            }
        }));
    });
    </script>
    <% } %>


