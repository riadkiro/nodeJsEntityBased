<!-- ═══ TEAM MODULE STYLES ═══ -->
<style>
.rt-section{margin-bottom:24px;}
.rt-section-header{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
.rt-section-title{font-size:14px;font-weight:700;color:#0e1726;display:flex;align-items:center;gap:8px;}
.rt-section-title iconify-icon{flex-shrink:0;}
.rt-section-count{font-size:11px;font-weight:600;padding:2px 8px;border-radius:6px;background:rgba(124,58,237,.08);color:#7c3aed;}
.rt-card{background:#fff;border:1px solid #e8ecf1;border-radius:14px;padding:18px;transition:all .25s;}
.rt-card:hover{box-shadow:0 4px 16px rgba(0,0,0,.04);}
.rt-team-row{display:flex;align-items:flex-start;gap:14px;padding:12px 14px;border-radius:10px;transition:all .2s;border:1px solid transparent;}
.rt-team-row:hover{background:#f8fafc;border-color:#e8ecf1;}
.rt-team-row + .rt-team-row{border-top:1px solid #f1f3f5;}
.rt-team-row:hover + .rt-team-row{border-top-color:transparent;}
.rt-team-icon{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;}
.rt-team-info{flex:1;min-width:0;}
.rt-team-name{font-size:13.5px;font-weight:700;color:#0e1726;}
.rt-team-meta{font-size:11.5px;color:#888da8;margin-top:1px;display:flex;align-items:center;gap:6px;}
.rt-perm-badges{display:flex;gap:4px;flex-wrap:wrap;}
.rt-perm-badge{font-size:10px;font-weight:600;padding:2px 8px;border-radius:5px;white-space:nowrap;transition:all .2s;user-select:none;}
.rt-perm-badge:hover{transform:scale(1.08);box-shadow:0 1px 4px rgba(0,0,0,.1);}
.rt-perm-on{background:rgba(34,197,94,.08);color:#22c55e;}
.rt-perm-off{background:#f1f5f9;color:#bfc9d4;}
.rt-btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;font-family:inherit;border:none;}
.rt-btn-assign{background:linear-gradient(135deg,#7c3aed,#a855f7);color:#fff;}
.rt-btn-assign:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(124,58,237,.3);}
.rt-btn-create{background:rgba(67,97,238,.06);color:#4361ee;border:1.5px dashed rgba(67,97,238,.3);}
.rt-btn-create:hover{background:rgba(67,97,238,.1);border-color:#4361ee;}
.rt-btn-danger{background:rgba(239,68,68,.06);color:#ef4444;border:1px solid rgba(239,68,68,.15);}
.rt-btn-danger:hover{background:rgba(239,68,68,.12);}
.rt-btn-sm{padding:4px 10px;font-size:11px;}
.rt-empty{text-align:center;padding:32px 20px;color:#94a3b8;}
.rt-empty iconify-icon{display:block;margin:0 auto 8px;}
.rt-assign-dropdown{margin-top:10px;border:1.5px solid #e2e8f0;border-radius:12px;padding:6px;background:#fff;max-height:280px;overflow-y:auto;}
.rt-assign-option{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;cursor:pointer;transition:background .15s;}
.rt-assign-option:hover{background:#f8fafc;}
.rt-assign-check{width:16px;height:16px;accent-color:#7c3aed;cursor:pointer;flex-shrink:0;}
/* ── Inline switch toggles ── */
.rt-perms-inline{display:flex;gap:8px;flex-wrap:wrap;}
.rt-perm-switch{display:flex;align-items:center;gap:8px;padding:8px 14px;border-radius:10px;border:1.5px solid #e8ecf1;background:#fff;cursor:pointer;transition:all .2s;user-select:none;}
.rt-perm-switch:hover{border-color:#7c3aed30;background:#faf8ff;}
.rt-perm-switch.active{border-color:#7c3aed;background:rgba(124,58,237,.04);}
.rt-perm-switch-icon{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.rt-perm-switch-label{font-size:12px;font-weight:600;white-space:nowrap;}
.rt-switch{position:relative;width:36px;height:20px;flex-shrink:0;}
.rt-switch input{opacity:0;width:0;height:0;position:absolute;}
.rt-switch-slider{position:absolute;inset:0;background:#d1d5db;border-radius:10px;cursor:pointer;transition:all .25s;}
.rt-switch-slider::before{content:'';position:absolute;width:14px;height:14px;border-radius:50%;background:#fff;left:3px;top:3px;transition:all .25s;box-shadow:0 1px 3px rgba(0,0,0,.15);}
.rt-switch input:checked + .rt-switch-slider{background:#7c3aed;}
.rt-switch input:checked + .rt-switch-slider::before{transform:translateX(16px);}
/* ── Modal ── */
.rt-modal-overlay{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;}
.rt-modal-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.35);backdrop-filter:blur(3px);}
.rt-modal{position:relative;background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.18);width:560px;max-width:calc(100vw - 40px);max-height:85vh;overflow-y:auto;animation:rtSlideUp .3s ease;}
@keyframes rtSlideUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
.rt-modal-header{padding:20px 24px;border-bottom:1px solid #e0e6ed;display:flex;align-items:center;gap:12px;}
.rt-modal-header-icon{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.rt-modal-body{padding:20px 24px;}
.rt-modal-footer{padding:14px 24px 20px;display:flex;align-items:center;gap:8px;justify-content:flex-end;border-top:1px solid #f1f5f9;}
.rt-create-input{width:100%;padding:9px 12px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:13px;font-family:inherit;outline:none;background:#fff;box-sizing:border-box;transition:border-color .2s;}
.rt-create-input:focus{border-color:#7c3aed;box-shadow:0 0 0 3px rgba(124,58,237,.06);}
.rt-member-option{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:8px;cursor:pointer;transition:background .15s;}
.rt-member-option:hover{background:rgba(124,58,237,.04);}
.rt-member-avatar{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0;}
.rt-members-avatars{display:flex;margin-top:2px;}
.rt-members-avatars > div{width:22px;height:22px;border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;color:#fff;flex-shrink:0;}
.rt-members-avatars > div + div{margin-left:-4px;}
.rt-color-pick{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px;}
.rt-color-dot{width:24px;height:24px;border-radius:7px;border:2px solid transparent;cursor:pointer;transition:all .15s;}
.rt-color-dot.active{border-color:#0e1726;transform:scale(1.15);}
/* ── Modal tabs ── */
.rt-modal-tabs{display:flex;gap:4px;padding:0 24px;background:#f8fafc;border-bottom:1px solid #e0e6ed;}
.rt-modal-tab{padding:10px 16px;font-size:12px;font-weight:600;color:#64748b;cursor:pointer;border-bottom:2px solid transparent;transition:all .2s;display:flex;align-items:center;gap:6px;}
.rt-modal-tab:hover{color:#7c3aed;}
.rt-modal-tab.active{color:#7c3aed;border-bottom-color:#7c3aed;}
/* ── Section divider ── */
.rt-group-header{display:flex;align-items:center;gap:8px;padding:10px 14px 6px;margin-top:4px;}
.rt-group-header-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#94a3b8;}
.rt-group-header-line{flex:1;height:1px;background:#e8ecf1;}
/* Dark mode */
.dark .rt-card{background:#0e1726;border-color:#253b5c;}
.dark .rt-section-title{color:#e0e6ed;}
.dark .rt-team-row:hover{background:#1b2e4b;border-color:#253b5c;}
.dark .rt-team-row + .rt-team-row{border-top-color:#1b2e4b;}
.dark .rt-team-name{color:#e0e6ed;}
.dark .rt-assign-dropdown{background:#0e1726;border-color:#253b5c;}
.dark .rt-assign-option:hover{background:#1b2e4b;}
.dark .rt-switch-label{color:#e0e6ed;}
.dark .rt-switch-row{border-bottom-color:#1b2e4b;}
.dark .rt-switch-slider{background:#506690;}
.dark .rt-modal{background:#0e1726;}
.dark .rt-modal-header{border-bottom-color:#253b5c;}
.dark .rt-modal-footer{border-top-color:#253b5c;}
.dark .rt-create-input{background:#1b2e4b;border-color:#253b5c;color:#e0e6ed;}
.dark .rt-member-option:hover{background:rgba(124,58,237,.08);}
.dark .rt-perm-off{background:#1b2e4b;color:#506690;}
.dark .rt-modal-tabs{background:#0b1320;border-color:#253b5c;}
.dark .rt-modal-tab{color:#94a3b8;}
.dark .rt-group-header-line{background:#253b5c;}
</style>
