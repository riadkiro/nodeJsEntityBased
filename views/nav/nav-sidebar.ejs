      <div class="flex items-center justify-between px-4 py-3">
        <a href="index.html" class="main-logo flex shrink-0 items-center">
          <!-- <img class="ml-[5px] flex-none" src="assets/images/logo-v1.jpg" alt="image" /> -->
          <svg class="font-semibold text-primary" width="24" height="24" viewBox="0 0 24 24" fill="none"
