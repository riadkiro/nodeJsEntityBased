<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold">Page Builder</h1>
      <p class="text-sm text-gray-500 mt-1">Create and manage custom dashboards and record pages</p>
    </div>
    <a href="/account/<%= account_number %>/page-builder/new" class="btn btn-primary">
      <iconify-icon icon="solar:add-circle-bold" class="mr-1"></iconify-icon>
      New Page
    </a>
  </div>

  <% if (configs && configs.length > 0) { %>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% configs.forEach(config => { %>
        <div class="panel hover:shadow-lg transition-shadow">
          <div class="flex items-start justify-between mb-3">
            <div>
              <h3 class="font-semibold text-lg"><%= config.name %></h3>
              <div class="flex items-center gap-2 mt-1">
                <span class="badge 
                  <%= config.type === 'dashboard' ? 'badge-primary' : 
                      config.type === 'record_page' ? 'badge-info' : 
                      'badge-warning' %>">
                  <%= config.type %>
                </span>
                <span class="badge 
                  <%= config.status === 'published' ? 'badge-success' : 'badge-secondary' %>">
                  <%= config.status %>
                </span>
              </div>
            </div>
            <div x-data="dropdown" @click.outside="open = false" class="dropdown">
              <a href="javascript:;" @click="toggle">
                <iconify-icon icon="solar:menu-dots-bold" width="20"></iconify-icon>
              </a>
              <ul x-cloak x-show="open" x-transition class="ltr:right-0 rtl:left-0">
                <li>
                  <a href="/account/<%= account_number %>/page-builder/edit/<%= config._id %>">
                    Edit
                  </a>
                </li>
                <li>
                  <a href="javascript:;" @click="duplicatePage('<%= config._id %>')">
                    Duplicate
                  </a>
                </li>
                <li>
                  <a href="javascript:;" @click="deletePage('<%= config._id %>')" class="text-danger">
                    Delete
                  </a>
                </li>
              </ul>
            </div>
          </div>
          
          <p class="text-sm text-gray-500 mb-4">
            Version <%= config.version %> • Updated <%= new Date(config.updatedAt).toLocaleDateString() %>
          </p>
          
          <a href="/account/<%= account_number %>/page-builder/edit/<%= config._id %>" 
             class="btn btn-outline-primary btn-sm w-full">
            Open Builder
          </a>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="panel text-center py-12">
      <iconify-icon icon="solar:widget-5-bold-duotone" width="64" class="text-gray-400 mb-4"></iconify-icon>
      <h3 class="text-lg font-semibold mb-2">No pages yet</h3>
      <p class="text-gray-500 mb-4">Create your first custom page with the PageBuilder</p>
      <a href="/account/<%= account_number %>/page-builder/new" class="btn btn-primary">
        <iconify-icon icon="solar:add-circle-bold" class="mr-1"></iconify-icon>
        Create First Page
      </a>
    </div>
  <% } %>
</div>

<script>
async function deletePage(id) {
  if (!confirm('Are you sure you want to delete this page?')) return;
  
  try {
    const response = await fetch(`/account/<%= account_number %>/api/page-configs/${id}`, {
      method: 'DELETE'
    });
    
    if (response.ok) {
      location.reload();
    } else {
      alert('Failed to delete page');
    }
  } catch (error) {
    console.error('Delete error:', error);
    alert('Failed to delete page');
  }
}

async function duplicatePage(id) {
  try {
    const response = await fetch(`/account/<%= account_number %>/api/page-configs/${id}`);
    const config = await response.json();
    
    // Remove _id and update name
    delete config._id;
    config.name = config.name + ' (Copy)';
    config.status = 'draft';
    
    const createResponse = await fetch('/account/<%= account_number %>/api/page-configs', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(config)
    });
    
    if (createResponse.ok) {
      location.reload();
    } else {
      alert('Failed to duplicate page');
    }
  } catch (error) {
    console.error('Duplicate error:', error);
    alert('Failed to duplicate page');
  }
}
</script>
