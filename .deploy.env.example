# Copy this file to .deploy.env and keep .deploy.env out of Git.

# SSH target accepted by ssh/scp, for example: user@dexapp.actirama.com
SSH_TARGET=

# Absolute app directory on the server.
SERVER_APP_DIR=/var/www/dexapp

# Git branch used by local, GitHub, and live server.
GIT_BRANCH=beta

# Server process manager. MISSIONS.md mentions dexioSaas.
PM2_NAME=dexioSaas

# Commands executed on the server after git pull.
SERVER_INSTALL_CMD=npm ci
SERVER_BUILD_CMD=npm run build:all
SERVER_PRUNE_CMD=npm prune --omit=dev
SERVER_RELOAD_CMD=pm2 reload dexioSaas --update-env

# Mongo sync. Keep these base URIs, not full DB names.
LOCAL_MONGO_BASE_URI=mongodb://127.0.0.1:27017/
# If live MongoDB requires auth, use:
# REMOTE_MONGO_BASE_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/?authSource=admin
REMOTE_MONGO_BASE_URI=mongodb://127.0.0.1:27017/
DB_NAMES=saasDemo,saas_app_rb_6804
REMOTE_BACKUP_DIR=/tmp/dexapp-sync
