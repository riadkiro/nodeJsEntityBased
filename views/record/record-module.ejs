	                                <iconify-icon icon="solar:alt-arrow-right-linear" width="18"></iconify-icon>
	                            </span>
                        </div>
                        <!-- Expanded: generated files for this template -->
                        <div x-show="openTemplates.includes(tpl._id)" x-transition.duration.200ms>
	                            <template x-if="getDocsForTemplate(tpl.name, tpl._id).length === 0">
	                                <div style="padding:12px 16px 16px 56px; font-size:11px; color:#94a3b8; font-style:italic;">
	                                    <span x-text="tpl.isSimpleFolder ? 'Aucun document dans ce dossier' : 'Aucun document généré pour ce modèle'"></span>
	                                </div>
	                            </template>
                            <template x-for="(doc, dIdx) in getVisibleDocs(tpl.name, tpl._id)" :key="doc._id || dIdx">
                                <div class="docs-tpl-file"
                                     @contextmenu.prevent.stop="openDocContext($event, doc)"
                                     @click="openGeneratedDoc(doc)">
                                    <span class="docs-tpl-file-date" style="margin-right:8px;">
                                        <iconify-icon icon="solar:calendar-linear" width="10"></iconify-icon>
                                        <span x-text="formatDate(doc.uploadedAt)"></span>
                                    </span>
                                    <div class="docs-tpl-file-icon">
                                        <iconify-icon icon="solar:file-check-bold-duotone" width="14" style="color:#ef4444"></iconify-icon>
                                    </div>
                                    <span class="docs-tpl-file-name" x-text="doc.originalName || 'Document'"></span>
                                    <span class="docs-tpl-file-size" x-text="doc.sizeFormatted || ''"></span>
                                    <button @click.stop="renameGeneratedDoc(doc)" class="docs-tpl-file-dl" x-show="!doc.isAgentDraft"
                                        title="Renommer" style="color:#64748b;">
                                        <iconify-icon :icon="renamingDocId === doc._id ? 'line-md:loading-twotone-loop' : 'solar:text-field-focus-bold'" width="13"></iconify-icon>
                                    </button>
                                    <button @click.stop="openGeneratedDoc(doc)"
                                        class="docs-tpl-file-dl" title="Voir">
                                        <iconify-icon icon="solar:eye-bold" width="13"></iconify-icon>
                                    </button>
                                    <a x-show="!doc.isAgentDraft" :href="'/account/' + _accountNumber + '/uploads/attachments/' + doc.filename + '?dl=' + encodeURIComponent(doc.originalName || 'document')"
                                       download class="docs-tpl-file-dl" title="Télécharger" @click.stop>
                                        <iconify-icon icon="solar:download-bold" width="13"></iconify-icon>
                                    </a>
                                    <button @click.stop="editGeneratedDoc(doc)" class="docs-tpl-file-dl" x-show="doc.snapshotDocumentId || doc.isAgentDraft"
                                        title="Modifier le snapshot" style="color:#4361ee;">
                                        <iconify-icon icon="solar:pen-bold" width="13"></iconify-icon>
                                    </button>
                                    <button @click.stop="copyGeneratedDoc(doc)" class="docs-tpl-file-dl" x-show="doc.snapshotDocumentId && !doc.isAgentDraft"
                                        :disabled="copyingDocId === doc._id" title="Copier vers un nouveau document" style="color:#10b981;">
                                        <iconify-icon :icon="copyingDocId === doc._id ? 'line-md:loading-twotone-loop' : 'solar:copy-bold'" width="13"></iconify-icon>
                                    </button>
                                    <button @click.stop="deleteDoc(doc)" class="docs-tpl-file-dl" x-show="confirmingDocDelete !== doc._id"
                                        title="Supprimer" style="color:#ef4444;">
                                        <iconify-icon icon="solar:trash-bin-2-bold" width="13"></iconify-icon>
                                    </button>
                                    <button @click.stop="deleteDoc(doc)" class="docs-tpl-file-dl" x-show="confirmingDocDelete === doc._id"
                                        style="color:#fff;background:#ef4444;border-radius:6px;padding:2px 7px;font-size:9px;font-weight:700;width:auto;height:auto;white-space:nowrap;">
                                        Supprimer ?
                                    </button>
                                </div>
                            </template>
                            <!-- Load more button -->
                            <template x-if="getDocsForTemplate(tpl.name, tpl._id).length > 5 && !expandedTemplates.includes(tpl._id)">
                                <button @click.stop="expandTemplate(tpl._id)" class="docs-tpl-load-more">
                                    <iconify-icon icon="solar:add-circle-linear" width="13"></iconify-icon>
                                    Voir tout (<span x-text="getDocsForTemplate(tpl.name, tpl._id).length"></span>)
                                </button>
                            </template>
                        </div>
                    </div>
                </template>
            </div>

	            <template x-teleport="body">
	                <div x-show="docContextMenu.show" x-cloak
	                     @click.outside="closeDocContext()"
	                     class="docs-context-menu"
	                     :style="'left:' + docContextMenu.x + 'px;top:' + docContextMenu.y + 'px;'">
	                    <button type="button" x-show="!docContextMenu.doc || !docContextMenu.doc.isAgentDraft" @click="renameGeneratedDoc(docContextMenu.doc)"
	                        >
	                        <iconify-icon icon="solar:text-field-focus-bold" width="14"></iconify-icon>
	                        Renommer
	                    </button>
	                    <button type="button" @click="editGeneratedDoc(docContextMenu.doc); closeDocContext()"
	                        >
	                        <iconify-icon icon="solar:pen-bold" width="14"></iconify-icon>
	                        Modifier
	                    </button>
	                    <button type="button" x-show="!docContextMenu.doc || !docContextMenu.doc.isAgentDraft" @click="copyGeneratedDoc(docContextMenu.doc); closeDocContext()"
	                        >
	                        <iconify-icon icon="solar:copy-bold" width="14"></iconify-icon>
	                        Copier vers
	                    </button>
	                    <div class="docs-context-separator"></div>
	                    <button type="button" class="danger" @click="requestDeleteDoc(docContextMenu.doc)">
	                        <iconify-icon icon="solar:trash-bin-2-bold" width="14"></iconify-icon>
	                        Supprimer
	                    </button>
	                </div>
	            </template>

	            <template x-teleport="body">
	                <div x-show="sectionContextMenu.show" x-cloak
	                     @click.outside="closeSectionContext()"
	                     class="docs-context-menu"
	                     :style="'left:' + sectionContextMenu.x + 'px;top:' + sectionContextMenu.y + 'px;'">
	                    <button type="button" @click="renameSection(sectionContextMenu.section)">
	                        <iconify-icon icon="solar:text-field-focus-bold" width="14"></iconify-icon>
	                        Renommer
	                    </button>
	                    <button type="button" x-show="sectionContextMenu.section && sectionContextMenu.section.isSimpleFolder" @click="createSimpleDoc(sectionContextMenu.section); closeSectionContext()">
	                        <iconify-icon icon="solar:document-add-bold-duotone" width="14"></iconify-icon>
	                        Nouveau doc
	                    </button>
	                    <button type="button" x-show="sectionContextMenu.section && !sectionContextMenu.section.isSimpleFolder && sectionContextMenu.section.documentId" @click="editTemplate(sectionContextMenu.section)">
	                        <iconify-icon icon="solar:pen-bold" width="14"></iconify-icon>
	                        Modifier
	                    </button>
	                    <button type="button" x-show="sectionContextMenu.section && !sectionContextMenu.section.isSimpleFolder" @click="generateDoc(sectionContextMenu.section); closeSectionContext()">
	                        <iconify-icon icon="solar:play-bold" width="14"></iconify-icon>
	                        Générer
	                    </button>
	                    <div class="docs-context-separator"></div>
	                    <button type="button" class="danger" @click="requestDeleteSection(sectionContextMenu.section)">
	                        <iconify-icon icon="solar:trash-bin-2-bold" width="14"></iconify-icon>
	                        Supprimer
	                    </button>
	                </div>
	            </template>

	            <template x-teleport="body">
	                <div x-show="nameModal.show" x-cloak class="docs-modal-backdrop" @keydown.escape.window="closeNameModal()">
	                    <form class="docs-modal" @submit.prevent="submitNameModal()" @click.outside="closeNameModal()">
	                        <div class="docs-modal-head">
	                            <div class="docs-modal-title" x-text="nameModal.title"></div>
	                            <button type="button" class="docs-modal-close" @click="closeNameModal()">
	                                <iconify-icon icon="solar:close-circle-bold" width="16"></iconify-icon>
	                            </button>
	                        </div>
	                        <div class="docs-modal-body">
	                            <label class="docs-modal-label" for="docs-name-modal-input" x-text="nameModal.label"></label>
	                            <input id="docs-name-modal-input" class="docs-modal-input" type="text" x-model="nameModal.value" autocomplete="off">
	                        </div>
	                        <div class="docs-modal-actions">
	                            <button type="button" class="docs-modal-btn" @click="closeNameModal()">Annuler</button>
	                            <button type="submit" class="docs-modal-btn primary" :disabled="nameModal.saving || !String(nameModal.value || '').trim()">
	                                <iconify-icon :icon="nameModal.saving ? 'line-md:loading-twotone-loop' : 'solar:check-circle-bold'" width="14"></iconify-icon>
	                                Valider
	                            </button>
	                        </div>
	                    </form>
	                </div>
	            </template>

	            <template x-teleport="body">
	                <div x-show="deleteModal.show" x-cloak class="docs-modal-backdrop" @keydown.escape.window="closeDeleteModal()">
	                    <div class="docs-modal" @click.outside="closeDeleteModal()">
	                        <div class="docs-modal-head">
	                            <div class="docs-modal-title" x-text="deleteModal.title"></div>
	                            <button type="button" class="docs-modal-close" @click="closeDeleteModal()">
	                                <iconify-icon icon="solar:close-circle-bold" width="16"></iconify-icon>
	                            </button>
	                        </div>
	                        <div class="docs-modal-body">
	                            <p class="docs-modal-text" x-text="deleteModal.message"></p>
	                        </div>
	                        <div class="docs-modal-actions">
	                            <button type="button" class="docs-modal-btn" @click="closeDeleteModal()">Annuler</button>
	                            <button type="button" class="docs-modal-btn danger" @click="submitDeleteModal()" :disabled="deleteModal.saving">
	                                <iconify-icon :icon="deleteModal.saving ? 'line-md:loading-twotone-loop' : 'solar:trash-bin-2-bold'" width="14"></iconify-icon>
	                                Supprimer
	                            </button>
	                        </div>
	                    </div>
	                </div>
	            </template>

	            <!-- Full-screen editor overlay (teleported to body) -->
	            <template x-teleport="body">
                <div x-show="showPreview" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                    class="fixed inset-0 flex flex-col bg-white" style="display:none; z-index: 99998;">
                    <!-- Header -->
                    <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 bg-white" style="min-height: 52px;">
                        <div class="flex items-center gap-3">
                            <button type="button" @click="cancelPreview()" class="p-2 rounded-full hover:bg-gray-100 text-gray-500 transition-colors" title="Retour">
                                <iconify-icon icon="tabler:arrow-left" width="20"></iconify-icon>
                            </button>
                            <div>
                                <input type="text" x-model="previewName"
                                    class="text-[13px] font-bold text-gray-800 bg-transparent border-0 outline-none px-0 py-0"
                                    style="min-width:320px;max-width:520px;"
                                    :readonly="finalized"
                                    placeholder="Nom du document">
                                <p class="text-[10px] text-gray-400 flex items-center gap-1" x-show="!finalized">
                                    <iconify-icon icon="solar:pen-2-bold" width="10" class="text-info"></iconify-icon>
                                    Modifiez le contenu si nécessaire, puis finalisez pour générer le PDF
                                </p>
                                <p class="text-[10px] text-success flex items-center gap-1 font-medium" x-show="finalized">
                                    <iconify-icon icon="solar:check-circle-bold" width="10"></iconify-icon>
                                    PDF généré avec succès !
                                </p>
                            </div>
                        </div>
                        <!-- Before finalization -->
                        <div class="flex items-center gap-2" x-show="!finalized">
                            <button type="button" @click="cancelPreview()" :disabled="finalizing"
                                class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-medium text-gray-500 hover:text-danger hover:bg-danger/5 border border-gray-200 transition-all">
                                <iconify-icon icon="solar:close-circle-linear" width="14"></iconify-icon>
                                Annuler
                            </button>
                            <button type="button" @click="finalizePreview()" :disabled="finalizing"
                                class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-[11px] font-bold bg-success text-white hover:bg-success/90 transition-all shadow-sm disabled:opacity-50">
                                <iconify-icon :icon="finalizing ? 'line-md:loading-twotone-loop' : 'solar:check-circle-bold'" width="14"></iconify-icon>
                                <span x-text="finalizing ? 'Génération en cours...' : 'Finaliser et générer le PDF'"></span>
                            </button>
                        </div>
                        <!-- After finalization -->
                        <div class="flex items-center gap-2" x-show="finalized" x-cloak>
                            <a :href="downloadUrl" download
                                class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-[11px] font-bold bg-primary text-white hover:bg-primary/90 transition-all shadow-sm">
                                <iconify-icon icon="solar:download-bold" width="14"></iconify-icon>
                                Télécharger
                            </a>
                            <button type="button" @click="closePreview()"
                                class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-100 border border-gray-200 transition-all">
                                <iconify-icon icon="solar:close-circle-linear" width="14"></iconify-icon>
                                Fermer
                            </button>
                        </div>
                    </div>
                    <!-- Editor iframe -->
                    <div class="flex-1 overflow-hidden">
                        <iframe id="docs-smartdoc-preview-iframe" class="w-full h-full border-0" allow="clipboard-read; clipboard-write"></iframe>
                    </div>
                </div>
            </template>
        </div>
        <% } %>

        <% if (moduleName === 'drive') { %>
        <%- include('partials/drive-shared', { driveMode: 'record' }) %>
        <% } %>

        <% if (moduleName === 'data-room') { %>
        <%- include('../record/partials/record-data-room-module') %>
        <% } %>

        <% if (moduleName === 'sheet') { %>
        <%- include('../record/partials/record-sheet-module') %>
        <% } %>



        <!-- Tasks module is handled by the dynamic Alpine.js section below -->

        <% if (moduleName === 'agenda') { %>
        <div data-island="record-agenda"
             data-account-number="<%= account_number %>"
             data-record-id="<%= record._id %>"
             data-entity-slug="<%= entity.slug %>"
             data-record-title="<%= (record.title || 'Sans titre').replace(/"/g, '&quot;') %>"
             style="flex:1;min-height:0;display:flex;flex-direction:column;">
            <!-- Loading state while React mounts -->
            <div style="display:flex;align-items:center;justify-content:center;gap:10px;padding:60px 0;color:#888da8;font-size:14px">
                <div style="width:24px;height:24px;border:3px solid #e2e8f0;border-top-color:#14b8a6;border-radius:50%;animation:spin .8s linear infinite"></div>
                Chargement de l'agenda...
            </div>
        </div>
        <link href="/assets/css/fullcalendar.min.css" rel="stylesheet" />
        <script src="/assets/js/fullcalendar.min.js"></script>
        <script type="module" src="/dist/recordAgenda.js"></script>
        <% } %>

        <%- include('../record/partials/record-tasks-module', { _isTasksTab: moduleName === 'tasks' }) %>

        <% if (moduleName === 'emails') { %>
        <style>
            .record-mail-shell{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:18px;align-items:start}
            .record-mail-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
            .record-mail-search{height:38px;border:1px solid #dbe4f0;border-radius:10px;background:#fff;padding:0 12px 0 36px;font-size:13px;min-width:260px;outline:none}
            .record-mail-search:focus{border-color:#0ea5e9;box-shadow:0 0 0 3px rgba(14,165,233,.12)}
            .record-mail-search-wrap{position:relative;display:flex;align-items:center}
            .record-mail-search-wrap iconify-icon{position:absolute;left:12px;color:#94a3b8}
            .record-mail-context{border:1px solid #dbeafe;background:linear-gradient(135deg,#f8fcff,#fff);border-radius:12px;padding:14px}
            .record-mail-context h4{font-size:13px;font-weight:800;color:#0f172a;margin:0 0 10px;display:flex;align-items:center;gap:7px}
            .record-mail-chip{display:flex;align-items:center;gap:8px;border:1px solid #e2e8f0;background:#fff;border-radius:10px;padding:8px 9px;margin-bottom:8px;min-width:0}
            .record-mail-chip-icon{width:28px;height:28px;border-radius:8px;background:#e0f2fe;color:#0ea5e9;display:flex;align-items:center;justify-content:center;flex:none}
            .record-mail-chip-main{min-width:0;flex:1}
            .record-mail-chip-name{font-size:12px;font-weight:800;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
            .record-mail-chip-email{font-size:11px;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
            .record-mail-chip-source{font-size:10px;font-weight:800;color:#0ea5e9;background:#e0f2fe;border-radius:999px;padding:3px 7px;white-space:nowrap}
            .record-mail-empty{border:1px dashed #cbd5e1;border-radius:12px;padding:28px;text-align:center;color:#64748b;background:#fff}
            .record-mail-empty iconify-icon{display:block;margin:0 auto 8px;color:#0ea5e9}
            .record-mail-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:5px;font-size:11px;color:#94a3b8}
            .record-mail-meta span{display:inline-flex;align-items:center;gap:4px}
            @media(max-width:1100px){.record-mail-shell{grid-template-columns:minmax(0,1fr)}.record-mail-context{order:-1}.record-mail-toolbar{align-items:stretch;flex-direction:column}.record-mail-search-wrap{width:100%;min-width:0}.record-mail-search{width:100%;min-width:0}.record-mail-empty{padding:22px 16px}}
        </style>
        <%
            const _mailCtx = recordMailContext || { contacts: [], filters: [], mails: [] };
            const _mailSourceLabel = (source) => ({
                record: 'Fiche',
                record_field: 'Fiche',
                record_text: 'Fiche',
                relation: 'Relation',
                relation_field: 'Relation',
                workspace: 'Equipe'
            }[source] || 'Contexte');
            const _formatMailDate = (d) => {
                if (!d) return '';
                const date = new Date(d);
                return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit', year:'numeric' });
            };
        %>
        <div class="record-mail-shell" x-data="{ q: '', mails: <%- JSON.stringify(_mailCtx.mails || []).replace(/<\//g, '<\\/') %>, get filtered(){ const needle = this.q.trim().toLowerCase(); if(!needle) return this.mails; return this.mails.filter(m => [m.title,m.email,m.from,m.preview].join(' ').toLowerCase().includes(needle)); } }">
            <div>
                <div class="record-mail-toolbar">
                    <div class="record-mail-search-wrap">
                        <iconify-icon icon="solar:magnifer-linear" width="16"></iconify-icon>
                        <input class="record-mail-search" type="search" x-model="q" placeholder="Filtrer les emails du record">
                    </div>
                </div>

                <template x-if="filtered.length === 0">
                    <div class="record-mail-empty">
                        <iconify-icon icon="solar:letter-unread-bold-duotone" width="30"></iconify-icon>
                        <div style="font-weight:800;color:#0f172a;margin-bottom:4px">Aucun email dans la sphère record</div>
                        <div style="font-size:12px">Ajoutez un email sur la fiche, une relation ou un membre d'équipe pour activer le filtre automatique.</div>
                    </div>
                </template>

                <div class="rm-items-list" x-show="filtered.length > 0">
                    <template x-for="(mail, idx) in filtered" :key="mail.id">
                        <div class="rm-item" :style="'animation-delay:' + Math.min(idx * 40, 240) + 'ms'">
                            <div class="rm-item-icon" style="background:linear-gradient(135deg,#0ea5e915,#0ea5e908)">
                                <iconify-icon :icon="mail.type === 'sent_mail' ? 'solar:letter-opened-bold-duotone' : 'solar:letter-bold-duotone'" width="20" style="color:#0ea5e9"></iconify-icon>
                            </div>
                            <div class="rm-item-body">
                                <div class="rm-item-title" x-text="mail.title"></div>
                                <div class="record-mail-meta">
                                    <span><iconify-icon icon="solar:user-rounded-linear" width="12"></iconify-icon><span x-text="mail.from"></span></span>
                                    <span><iconify-icon icon="solar:letter-linear" width="12"></iconify-icon><span x-text="mail.email"></span></span>
                                    <span x-show="mail.date"><iconify-icon icon="solar:calendar-linear" width="12"></iconify-icon><span x-text="new Date(mail.date).toLocaleDateString('fr-FR')"></span></span>
                                    <span x-show="mail.hasAttachments"><iconify-icon icon="solar:paperclip-linear" width="12"></iconify-icon>Pieces jointes</span>
                                </div>
                            </div>
                            <span class="rm-item-badge" :style="mail.isUnread ? 'background:#0ea5e915;color:#0ea5e9' : 'background:#10b98115;color:#10b981'" x-text="mail.isUnread ? 'Non lu' : (mail.type === 'sent_mail' ? 'Envoye' : 'Lu')"></span>
                            <a class="rm-item-action" title="Ouvrir dans Mailbox" :href="'/account/<%= account_number %>/mailbox/inbox'"><iconify-icon icon="solar:arrow-right-up-linear" width="16"></iconify-icon></a>
                        </div>
                    </template>
                </div>
            </div>

            <aside class="record-mail-context">
                <h4><iconify-icon icon="solar:target-bold-duotone" width="16" style="color:#0ea5e9"></iconify-icon>Sphere record</h4>
                <% if ((_mailCtx.contacts || []).length === 0) { %>
                    <div style="font-size:12px;color:#64748b;line-height:1.45">Aucun email detecte dans cette fiche pour le moment.</div>
                <% } %>
                <% (_mailCtx.contacts || []).slice(0, 12).forEach(function(contact) { %>
                    <div class="record-mail-chip">
                        <div class="record-mail-chip-icon"><iconify-icon icon="solar:user-id-bold-duotone" width="15"></iconify-icon></div>
                        <div class="record-mail-chip-main">
                            <div class="record-mail-chip-name"><%= contact.name %></div>
                            <div class="record-mail-chip-email"><%= contact.email %></div>
                        </div>
                        <span class="record-mail-chip-source"><%= _mailSourceLabel(contact.source) %></span>
                    </div>
                <% }) %>
                <div style="border-top:1px solid #e2e8f0;margin-top:12px;padding-top:12px;font-size:11px;color:#64748b;display:flex;align-items:center;gap:6px">
                    <iconify-icon icon="solar:filter-bold-duotone" width="14" style="color:#0ea5e9"></iconify-icon>
                    <span><%= (_mailCtx.filters || []).length %> filtre(s) priorises pour l'IA et la mailbox</span>
                </div>
            </aside>
        </div>
        <script>
            (function(){
                const recordEmailContext = {
                    recordId: '<%= record._id %>',
                    recordTitle: <%- JSON.stringify(record.title || record.computedTitle || '') %>,
                    contacts: <%- JSON.stringify((_mailCtx.contacts || []).slice(0, 20)).replace(/<\//g, '<\\/') %>,
                    filters: <%- JSON.stringify(_mailCtx.filters || []).replace(/<\//g, '<\\/') %>
                };
                const emailContext = {
                    id: 'record-email-' + recordEmailContext.recordId,
                    subject: 'Sphere email - ' + (recordEmailContext.recordTitle || 'record'),
                    from: 'Contexte record',
                    fromEmail: recordEmailContext.filters[0] || '',
                    body: 'Contacts prioritaires:\\n' + recordEmailContext.contacts.map(c => '- ' + c.name + ' <' + c.email + '> [' + c.source + ']').join('\\n'),
                    hasAttachments: false,
                    recordEmailContext
                };
                const emit = () => window.dispatchEvent(new CustomEvent('ai-assistant:email-context-changed', {
                    detail: { emailContext }
                }));
                window.__RECORD_EMAIL_CONTEXT__ = recordEmailContext;
                if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', emit, { once: true });
                setTimeout(emit, 800);
            })();
        </script>
        <% } %>

        <% if (moduleName === 'notes') { %>
        <%- include('../record/partials/record-notes-module') %>
        <% } %>

        <% if (moduleName === 'ai') { %>
        <div data-island="record-ai"
             data-account-number="<%= account_number %>"
             data-record-id="<%= record._id %>"
             data-entity-slug="<%= entity.slug %>"
             data-debug-admin="<%= (user && user.role === 'superadmin') || ['owner', 'admin'].includes(workspaceRole || '') ? '1' : '0' %>"
             data-record-title="<%= (record.title || 'Sans titre').replace(/"/g, '&quot;') %>">
            <div style="display:flex;align-items:center;justify-content:center;gap:10px;padding:60px 0;color:#888da8;font-size:14px">
                <div style="width:24px;height:24px;border:3px solid #e2e8f0;border-top-color:#4f46e5;border-radius:50%;animation:spin .8s linear infinite"></div>
                Chargement de l'IA...
            </div>
        </div>
        <script type="module" src="/dist/recordAI.js"></script>
        <% } %>

        <% if (moduleName === 'team') { %>
        <%- include('../record/partials/ov-widget-team') %>
        <script>
        document.addEventListener('alpine:init', () => {
            const _teamData = <%- JSON.stringify(teamModuleData || { workspaceTeams: [], workspaceMembers: [], recordGrants: [], assignedTeamIds: [], assignedUserIds: [], pendingInvites: [] }) %>;
            const _accountNumber = '<%= account_number %>';
            const _recordId = '<%= record._id %>';
            const _entityId = '<%= entity._id || '' %>';
            const _recordTitle = '<%= (record.title || "Sans titre").replace(/'/g, "\\'") %>';
            const _recordModuleOptions = [
                { key: 'overview', routeKey: 'overview', label: 'Overview', icon: 'solar:widget-5-bold-duotone', color: '#6366f1' },
                { key: 'fiche', routeKey: 'fiche', label: 'Fiche', icon: 'solar:card-bold-duotone', color: '#4361ee' },
                { key: 'docs', routeKey: 'docs', label: 'Docs', icon: 'solar:document-text-bold-duotone', color: '#f59e0b' },
                { key: 'drive', routeKey: 'drive', label: 'Drive', icon: 'solar:cloud-storage-bold-duotone', color: '#ec4899' },
                { key: 'dataRoom', routeKey: 'data-room', label: 'Data Room', icon: 'solar:shield-keyhole-bold-duotone', color: '#0f766e' },
                { key: 'tasks', routeKey: 'tasks', label: 'Tasks', icon: 'solar:checklist-minimalistic-bold-duotone', color: '#10b981' },
                { key: 'agenda', routeKey: 'agenda', label: 'Agenda', icon: 'solar:calendar-bold-duotone', color: '#14b8a6' },
                { key: 'sheet', routeKey: 'sheet', label: 'Sheet', icon: 'tabler:table', color: '#059669' },
                { key: 'chat', routeKey: 'chat', label: 'Chat', icon: 'solar:chat-round-dots-bold-duotone', color: '#f97316' },
                { key: 'emails', routeKey: 'emails', label: 'Emails', icon: 'solar:letter-bold-duotone', color: '#0ea5e9' },
                { key: 'notes', routeKey: 'notes', label: 'Notes', icon: 'solar:notebook-bold-duotone', color: '#8b5cf6' },
                { key: 'ai', routeKey: 'ai', label: 'IA', icon: 'solar:magic-stick-3-bold-duotone', color: '#4f46e5' },
                { key: 'team', routeKey: 'team', label: 'Accès', icon: 'solar:users-group-rounded-bold-duotone', color: '#7c3aed', requiresShare: true },
            ];
            const _defaultRecordModules = Object.fromEntries(_recordModuleOptions.map(m => [
                m.key,
                { view: m.key !== 'team' && m.key !== 'ai', edit: false },
            ]));
            const _cloneDefaultRecordModules = () => JSON.parse(JSON.stringify(_defaultRecordModules));

            Alpine.data('recordTeam', () => ({
                allTeams: _teamData.workspaceTeams || [],
                allMembers: _teamData.workspaceMembers || [],
                recordGrants: _teamData.recordGrants || [],
                assignedTeamIds: [...(_teamData.assignedTeamIds || [])],
                assignedUserIds: [...(_teamData.assignedUserIds || [])],
                pendingInvites: [...(_teamData.pendingInvites || [])],
                recordTitle: _recordTitle,
                moduleOptions: _recordModuleOptions,
                assignPerms: { read: true, update: false, delete: false, share: false, modules: _cloneDefaultRecordModules() },
                showCreateModal: false,
                showAddModal: false,
                modalSearch: '',
                modalTab: 'teams',
                newTeam: { name: '', description: '', color: '#7c3aed', memberIds: [] },
                teamColors: ['#4361ee','#7c3aed','#f97316','#10b981','#ec4899','#06b6d4','#ef4444','#8b5cf6','#eab308','#14b8a6'],
                inviteEmail: '',
                inviting: false,
                creating: false,
                toast: '',
                toastType: 'success',
                searchQuery: '',
                confirmRevokeId: null,
                showPermsId: null,

                init() {
                    this.assignPerms = this.normalizePermissions(this.assignPerms);
                },

                defaultModules(perms = {}) {
                    const modules = _cloneDefaultRecordModules();
                    if (perms.share === true) {
                        modules.team.view = true;
                    }
                    if (perms.update === true) {
                        this.moduleOptions.forEach(opt => {
                            if (opt.requiresShare && perms.share !== true) return;
                            if (modules[opt.key].view) modules[opt.key].edit = true;
                        });
                    }
                    return modules;
                },

                normalizeModuleAccess(value, fallback, perms = {}) {
                    if (typeof value === 'boolean') {
                        return { view: value, edit: value === true && perms.update === true };
                    }
                    if (value && typeof value === 'object') {
                        const explicitView = Object.prototype.hasOwnProperty.call(value, 'view');
                        const edit = value.edit === true;
                        return {
                            view: explicitView ? value.view !== false : (fallback.view || edit),
                            edit,
                        };
                    }
                    return { ...fallback };
                },

                normalizePermissions(perms = {}) {
                    const read = perms.read !== false;
                    const share = perms.share === true;
                    const update = perms.update === true;
                    const modules = this.defaultModules({ update, share });
                    if (perms.modules && typeof perms.modules === 'object') {
                        this.moduleOptions.forEach(opt => {
                            if (Object.prototype.hasOwnProperty.call(perms.modules, opt.key)) {
                                modules[opt.key] = this.normalizeModuleAccess(perms.modules[opt.key], modules[opt.key], { update, share });
                            }
                        });
                    }
                    this.moduleOptions.forEach(opt => {
                        if (!read) {
                            modules[opt.key] = { view: false, edit: false };
                            return;
                        }
                        if (opt.requiresShare && !share) {
                            modules[opt.key] = { view: false, edit: false };
                            return;
                        }
                        if (modules[opt.key].edit) modules[opt.key].view = true;
                        if (!modules[opt.key].view) modules[opt.key].edit = false;
                    });
                    const hasModuleEdit = this.moduleOptions.some(opt => modules[opt.key].edit === true);
                    return {
                        read,
                        update: update || hasModuleEdit,
                        delete: perms.delete === true,
                        share,
                        modules,
                    };
                },

                modulesFor(perms = {}) {
                    return this.normalizePermissions(perms).modules;
                },

                moduleAllowed(perms, moduleKey) {
                    return this.modulesFor(perms)[moduleKey]?.view === true;
                },

                moduleCanEdit(perms, moduleKey) {
                    return this.modulesFor(perms)[moduleKey]?.edit === true;
                },

                moduleSummary(perms) {
                    const modules = this.modulesFor(perms);
                    const viewCount = this.moduleOptions.filter(opt => modules[opt.key]?.view).length;
                    const editCount = this.moduleOptions.filter(opt => modules[opt.key]?.edit).length;
                    if (viewCount === 0) return 'Aucune app';
                    if (editCount === 0) return viewCount + ' en lecture';
                    return viewCount + ' vue' + (viewCount > 1 ? 's' : '') + ' · ' + editCount + ' edit';
                },

                toggleAssignPermission(key) {
                    if (key === 'read' && this.assignPerms.read) {
                        this.showToast('Lire reste actif. Limitez plutôt les apps accessibles.', 'error');
                        return;
                    }
                    this.assignPerms = this.normalizePermissions(this.assignPerms);
                    this.assignPerms[key] = !this.assignPerms[key];
                    if (key === 'update') {
                        this.moduleOptions.forEach(opt => {
                            if (opt.requiresShare && !this.assignPerms.share) return;
                            if (!this.assignPerms.modules[opt.key].view) return;
                            this.assignPerms.modules[opt.key].edit = this.assignPerms.update;
                        });
                    }
                    if (key === 'share' && !this.assignPerms.share) {
                        this.assignPerms.modules.team = { view: false, edit: false };
                    }
                    this.assignPerms = this.normalizePermissions(this.assignPerms);
                },

                toggleAssignModule(moduleKey, mode = 'view') {
                    this.assignPerms = this.normalizePermissions(this.assignPerms);
                    const option = this.moduleOptions.find(opt => opt.key === moduleKey);
                    if (option?.requiresShare && !this.assignPerms.share) {
                        this.showToast('Activez Partager pour donner accès à l’onglet Accès', 'error');
                        return;
                    }
                    const current = this.assignPerms.modules[moduleKey] || { view: false, edit: false };
                    if (mode === 'edit') {
                        const nextEdit = !current.edit;
                        current.edit = nextEdit;
                        if (nextEdit) {
                            current.view = true;
                            this.assignPerms.update = true;
                        }
                    } else {
                        const nextView = !current.view;
                        if (!nextView) {
                            const remaining = this.moduleOptions.filter(opt => opt.key !== moduleKey && this.assignPerms.modules[opt.key]?.view).length;
                            if (remaining === 0) {
                                this.showToast('Gardez au moins une app accessible', 'error');
                                return;
                            }
                            current.edit = false;
                        }
                        current.view = nextView;
                    }
                    this.assignPerms.modules[moduleKey] = current;
                    if (current.view) this.assignPerms.read = true;
                    if (!this.moduleOptions.some(opt => this.assignPerms.modules[opt.key]?.edit)) {
                        this.assignPerms.update = false;
                    }
                    this.assignPerms = this.normalizePermissions(this.assignPerms);
                },

                applyUpdateToModules(perms) {
                    this.moduleOptions.forEach(opt => {
                        if (opt.requiresShare && !perms.share) return;
                        if (!perms.modules[opt.key]?.view) return;
                        perms.modules[opt.key].edit = perms.update === true;
                    });
                    return perms;
                },

                applyShareToModules(perms) {
                    if (!perms.share) {
                        perms.modules.team = { view: false, edit: false };
                    }
                    return perms;
                },

                ensureAtLeastOneView(perms, blockedKey = '') {
                    if (this.moduleOptions.some(opt => opt.key !== blockedKey && perms.modules[opt.key]?.view)) return true;
                    this.showToast('Gardez au moins une app accessible', 'error');
                    return false;
                },

                syncUpdateFromModuleEdits(perms) {
                    perms.update = this.moduleOptions.some(opt => perms.modules[opt.key]?.edit);
                    return perms;
                },

                toggleModuleAccess(perms, moduleKey, mode = 'view') {
                    const option = this.moduleOptions.find(opt => opt.key === moduleKey);
                    if (option?.requiresShare && !perms.share) {
                        this.showToast('Activez Partager pour donner accès à l’onglet Accès', 'error');
                        return null;
                    }
                    const current = perms.modules[moduleKey] || { view: false, edit: false };
                    if (mode === 'edit') {
                        current.edit = !current.edit;
                        if (current.edit) current.view = true;
                    } else {
                        const nextView = !current.view;
                        if (!nextView && !this.ensureAtLeastOneView(perms, moduleKey)) return null;
                        current.view = nextView;
                        if (!nextView) current.edit = false;
                    }
                    perms.modules[moduleKey] = current;
                    return this.normalizePermissions(this.syncUpdateFromModuleEdits(perms));
                },

                payloadAssignPerms() {
                    return this.normalizePermissions(this.assignPerms);
                },

                // ─── Computed: assigned teams with permissions ───
                get assignedTeams() {
                    return this.allTeams
                        .filter(t => this.assignedTeamIds.includes(t._id))
                        .map(t => {
                            const grant = this.recordGrants.find(g => g.granteeType === 'team' && g.granteeId === t._id);
                            return {
                                ...t,
                                permissions: this.normalizePermissions(grant?.permissions || {}),
                                grantedAt: grant?.grantedAt || null,
                            };
                        });
                },

                // ─── Computed: individually assigned users with permissions ───
                get assignedUsers() {
                    return this.assignedUserIds.map(uid => {
                        const member = this.allMembers.find(m => m._id === uid);
                        const grant = this.recordGrants.find(g => g.granteeType === 'user' && g.granteeId === uid);
                        return {
                            _id: uid,
                            name: member?.name || 'Utilisateur',
                            email: member?.email || '',
                            avatar: member?.avatar || null,
                            role: member?.role || 'member',
                            permissions: this.normalizePermissions(grant?.permissions || {}),
                            grantedAt: grant?.grantedAt || null,
                        };
                    }).filter(u => u.name);
                },

                // ─── Computed: teams not yet assigned ───
                get availableTeams() {
                    return this.allTeams.filter(t => !this.assignedTeamIds.includes(t._id));
                },

                // ─── Computed: users not individually assigned (and not in an assigned team) ───
                get availableUsers() {
                    // Get all member IDs that are in already-assigned teams
                    const teamMemberIds = new Set();
                    this.assignedTeams.forEach(t => {
                        (t.memberIds || []).forEach(mid => teamMemberIds.add(String(mid)));
                    });
                    return this.allMembers.filter(m =>
                        !this.assignedUserIds.includes(m._id) &&
                        !teamMemberIds.has(m._id)
                    );
                },

                // ─── Computed: filtered add items ───
                get filteredAddItems() {
                    const q = (this.searchQuery || '').toLowerCase().trim();
                    const teams = this.availableTeams.filter(t => !q || t.name.toLowerCase().includes(q));
                    const users = this.availableUsers.filter(u => !q || u.name.toLowerCase().includes(q) || (u.email || '').toLowerCase().includes(q));
                    return { teams, users };
                },

                // ─── Computed: modal filtered users (all non-assigned) ───
                get modalFilteredUsers() {
                    const q = (this.modalSearch || '').toLowerCase().trim();
                    return this.allMembers.filter(m => {
                        if (this.assignedUserIds.includes(m._id)) return false;
                        if (!q) return true;
                        return m.name.toLowerCase().includes(q) || (m.email || '').toLowerCase().includes(q);
                    });
                },

                // ─── Computed: modal filtered teams (available, not assigned) ───
                get modalFilteredTeams() {
                    const q = (this.modalSearch || '').toLowerCase().trim();
                    return this.availableTeams.filter(t => !q || t.name.toLowerCase().includes(q));
                },

                // ─── Helpers ───
                getTeamMembers(team) {
                    return (team.memberIds || []).map(mid => {
                        const m = this.allMembers.find(m => m._id === String(mid));
                        return m || { _id: mid, name: 'Utilisateur', email: '', role: 'member' };
                    });
                },

                getMemberName(memberId) {
                    const m = this.allMembers.find(m => m._id === String(memberId));
                    return m?.name || 'Utilisateur';
                },

                avatarColor(name) {
                    const colors = ['#4361ee','#e7515a','#00ab55','#e2a03f','#805dca','#2196f3','#3b3f5c','#009688','#e91e63','#ff5722'];
                    let hash = 0;
                    for (let i = 0; i < (name || '').length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
                    return colors[Math.abs(hash) % colors.length];
                },

                formatDate(d) {
                    if (!d) return '';
                    const dt = new Date(d);
                    return dt.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
                },

                // ─── Team actions ───
                async assignTeam(teamId) {
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/grant`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                granteeType: 'team',
                                granteeId: teamId,
                                entityId: _entityId,
                                permissions: this.payloadAssignPerms(),
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.assignedTeamIds.push(teamId);
                            this.recordGrants.push({
                                granteeType: 'team',
                                granteeId: teamId,
                                permissions: this.payloadAssignPerms(),
                                grantedAt: new Date().toISOString(),
                            });
                            this.showToast('Équipe assignée', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] assign error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                async saveGrantPermissions(granteeType, granteeId, newPerms) {
                    const grant = this.recordGrants.find(g => g.granteeType === granteeType && g.granteeId === granteeId);
                    if (!grant) return;
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/grant`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ granteeType, granteeId, entityId: _entityId, permissions: newPerms })
                        });
                        const data = await res.json();
                        if (data.success) {
                            grant.permissions = this.normalizePermissions(newPerms);
                            this.showToast('Permission mise à jour', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] save permissions error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                // ─── Toggle a single CRUD permission on an existing grant ───
                async togglePermission(granteeType, granteeId, permKey) {
                    const grant = this.recordGrants.find(g => g.granteeType === granteeType && g.granteeId === granteeId);
                    if (!grant) return;
                    const newPerms = this.normalizePermissions(grant.permissions || {});
                    if (permKey === 'read' && newPerms.read) {
                        this.showToast('Retirez l’accès ou limitez les apps plutôt que de couper Lire', 'error');
                        return;
                    }
                    newPerms[permKey] = !newPerms[permKey];
                    if (permKey === 'update') {
                        this.applyUpdateToModules(newPerms);
                    }
                    if (permKey === 'share') {
                        this.applyShareToModules(newPerms);
                    }
                    await this.saveGrantPermissions(granteeType, granteeId, this.normalizePermissions(newPerms));
                },

                async toggleModule(granteeType, granteeId, moduleKey, mode = 'view') {
                    const grant = this.recordGrants.find(g => g.granteeType === granteeType && g.granteeId === granteeId);
                    if (!grant) return;
                    const newPerms = this.normalizePermissions(grant.permissions || {});
                    const nextPerms = this.toggleModuleAccess(newPerms, moduleKey, mode);
                    if (!nextPerms) return;
                    await this.saveGrantPermissions(granteeType, granteeId, nextPerms);
                },

                async revokeTeam(teamId) {
                    if (this.confirmRevokeId !== 'team-' + teamId) {
                        this.confirmRevokeId = 'team-' + teamId;
                        setTimeout(() => { if (this.confirmRevokeId === 'team-' + teamId) this.confirmRevokeId = null; }, 3000);
                        return;
                    }
                    this.confirmRevokeId = null;
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/revoke`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ granteeType: 'team', granteeId: teamId })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.assignedTeamIds = this.assignedTeamIds.filter(id => id !== teamId);
                            this.recordGrants = this.recordGrants.filter(g => !(g.granteeType === 'team' && g.granteeId === teamId));
                            this.showToast('Accès retiré', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] revoke error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                // ─── User actions ───
                async assignUser(userId) {
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/grant`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                granteeType: 'user',
                                granteeId: userId,
                                entityId: _entityId,
                                permissions: this.payloadAssignPerms(),
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.assignedUserIds.push(userId);
                            this.recordGrants.push({
                                granteeType: 'user',
                                granteeId: userId,
                                permissions: this.payloadAssignPerms(),
                                grantedAt: new Date().toISOString(),
                            });
                            this.showToast('Utilisateur ajouté', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] assignUser error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                async assignUserFromModal(userId) {
                    await this.assignUser(userId);
                },

                async revokeUser(userId) {
                    if (this.confirmRevokeId !== 'user-' + userId) {
                        this.confirmRevokeId = 'user-' + userId;
                        setTimeout(() => { if (this.confirmRevokeId === 'user-' + userId) this.confirmRevokeId = null; }, 3000);
                        return;
                    }
                    this.confirmRevokeId = null;
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/revoke`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ granteeType: 'user', granteeId: userId })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.assignedUserIds = this.assignedUserIds.filter(id => id !== userId);
                            this.recordGrants = this.recordGrants.filter(g => !(g.granteeType === 'user' && g.granteeId === userId));
                            this.showToast('Accès retiré', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] revokeUser error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                // ─── Team creation ───
                toggleNewTeamMember(memberId) {
                    const idx = this.newTeam.memberIds.indexOf(memberId);
                    if (idx >= 0) {
                        this.newTeam.memberIds.splice(idx, 1);
                    } else {
                        this.newTeam.memberIds.push(memberId);
                    }
                },

                async createTeamAndAssign() {
                    if (!this.newTeam.name.trim()) {
                        this.showToast('Le nom de l\'équipe est requis', 'error');
                        return;
                    }
                    this.creating = true;
                    try {
                        const createRes = await fetch(`/account/${_accountNumber}/api/team/teams`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                name: this.newTeam.name.trim(),
                                description: this.newTeam.description,
                                color: this.newTeam.color,
                                icon: 'solar:users-group-rounded-bold-duotone',
                                memberIds: this.newTeam.memberIds,
                            })
                        });
                        const createData = await createRes.json();
                        if (createData.success && createData.team) {
                            const newTeamId = createData.team._id;
                            this.allTeams.push({
                                _id: newTeamId,
                                name: this.newTeam.name.trim(),
                                description: this.newTeam.description,
                                color: this.newTeam.color,
                                icon: 'solar:users-group-rounded-bold-duotone',
                                memberIds: [...this.newTeam.memberIds],
                                memberCount: this.newTeam.memberIds.length,
                            });
                            await this.assignTeam(newTeamId);
                            this.newTeam = { name: '', description: '', color: '#7c3aed', memberIds: [] };
                            this.showCreateModal = false;
                            this.showToast('Équipe créée et assignée !', 'success');
                        } else {
                            this.showToast(createData.error || 'Erreur lors de la création', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] create error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                    this.creating = false;
                },

                async inviteMember() {
                    const email = this.inviteEmail.trim().toLowerCase();
                    if (!email || !email.includes('@')) {
                        this.showToast('Email invalide', 'error');
                        return;
                    }

                    // Check if already pending
                    if (this.pendingInvites.some(p => p.email === email)) {
                        this.showToast('Une invitation est déjà en attente pour cet email', 'error');
                        return;
                    }

                    // Check if this email belongs to an existing workspace member
                    const existingMember = this.allMembers.find(m => (m.email || '').toLowerCase() === email);
                    if (existingMember) {
                        if (this.assignedUserIds.includes(existingMember._id)) {
                            this.showToast('Cet utilisateur a déjà accès à cette fiche', 'error');
                            return;
                        }
                        await this.assignUser(existingMember._id);
                        this.inviteEmail = '';
                        return;
                    }

                    // Not a workspace member — create pending invite + workspace invite + send email
                    this.inviting = true;
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/pending-invite`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                email,
                                entityId: _entityId,
                                permissions: this.payloadAssignPerms(),
                                recordTitle: _recordTitle,
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.inviteEmail = '';
                            if (data.pendingInvite) {
                                this.pendingInvites.push(data.pendingInvite);
                            }
                            this.showToast(data.message || 'Invitation en attente', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] invite error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                    this.inviting = false;
                },

                confirmCancelEmail: null,

                async cancelPendingInvite(email) {
                    if (this.confirmCancelEmail !== email) {
                        this.confirmCancelEmail = email;
                        setTimeout(() => { if (this.confirmCancelEmail === email) this.confirmCancelEmail = null; }, 3000);
                        return;
                    }
                    this.confirmCancelEmail = null;
                    try {
                        const res = await fetch(`/account/${_accountNumber}/api/record-access/${_recordId}/cancel-pending`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ email })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.pendingInvites = this.pendingInvites.filter(p => p.email !== email);
                            this.showToast('Invitation annulée', 'success');
                        } else {
                            this.showToast(data.error || 'Erreur', 'error');
                        }
                    } catch (e) {
                        console.error('[RecordTeam] cancel pending error:', e);
                        this.showToast('Erreur réseau', 'error');
                    }
                },

                showToast(msg, type) {
                    this.toast = msg;
                    this.toastType = type;
                    setTimeout(() => { this.toast = ''; }, 3000);
                }
            }));
        });
        </script>
        <% } %>

