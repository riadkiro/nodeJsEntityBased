              isHierarchyDragBlocked(evt = null) {
                if (this.editingId) return true;
                const target = evt?.originalEvent?.target || evt?.target;
                return Boolean(target?.closest?.('input, textarea, select, button, [contenteditable="true"], .sidebar-rename-input'));
              },

              menuMode: 'main', // 'main' or 'data'
              allEntities: [],
              entitySearch: '',
              pendingViewType: 'list',
              showViewConfigModal: false,
              configView: null,
              configEntity: null,
              tempFilters: [],
              tempViewType: 'list',

              async fetchHierarchy(force = false) {
                if (this.isLoadingHierarchy) {
                  if (!force) {
                    console.warn("[Sidebar] fetchHierarchy skipped: already fetching");
                    return;
                  }
                  let waitCount = 0;
                  while (this.isLoadingHierarchy && waitCount < 30) {
                    await new Promise(resolve => setTimeout(resolve, 50));
                    waitCount++;
                  }
                  if (this.isLoadingHierarchy) {
                    console.warn("[Sidebar] fetchHierarchy force skipped: previous fetch still running");
                    return;
                  }
                }
                const now = Date.now();
                if (!force && now - this.lastFetchTime < 300) {
                  console.warn("[Sidebar] fetchHierarchy skipped: rate limit cooldown");
                  return;
                }
                this.isLoadingHierarchy = true;
                this.lastFetchTime = now;

                // Initialize Sidebar Store
                if (!Alpine.store('sidebar')) {
                  Alpine.store('sidebar', {
                    showMenu: false,
                    showEditMenu: false,
                    contextItem: null
                  });
                }

                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                console.log(`[Sidebar] Fetching hierarchy for account: ${accountNum}`);
                try {
                  let url = `/account/${accountNum}/api/hierarchy/list?t=${Date.now()}`;
                  if (this.activeEnvironmentId) url += `&environmentId=${this.activeEnvironmentId}`;
                  const res = await fetch(url, {
                    cache: 'no-store'
                  });
                  if (!res.ok) throw new Error(`HTTP ${res.status}`);
                  const data = await res.json();

                  // Clear hierarchy first to force DOM redraw
                  this.hierarchy = [];
                  await new Promise(r => setTimeout(r, 0));

                  this.hierarchy = data.hierarchy || [];
                  this.hierarchyRenderKey += 1;
                  this.realSpacesCount = data.realSpacesCount || 0;
                  if (data.dbName) console.log(`[Sidebar] Connected to Tenant DB: ${data.dbName}`);

                  // Load sidebar preferences
                  await this.loadSidebarPrefs();
                  this.detectActiveItem();
                  this.normalizeOpenStateArrays();

                  // Initialize D&D after render
                  this.$nextTick(() => {
                    this.initDragAndDrop();
                  });

                } catch (e) {
                  console.error("[Sidebar] Failed to load hierarchy", e);
                } finally {
                  this.isLoadingHierarchy = false;
                }
              },

              findDropListForParent(parentId) {
                const targetId = String(parentId || '');
                if (!targetId) return null;
                return Array.from(document.querySelectorAll('.hierarchy-sub-menu[data-parent-id]'))
                  .find(el => String(el.dataset.parentId || '') === targetId) || null;
              },

              getParentContextFromList(listEl) {
                if (!listEl) return null;

                if (listEl.dataset?.parentType === 'root' || listEl.classList.contains('sortable-root')) {
                  return {
                    id: this.activeEnvironmentId || null,
                    type: this.activeEnvironmentId ? 'environment-root' : null,
                    el: listEl
                  };
                }

                if (listEl.dataset?.parentId) {
                  return {
                    id: listEl.dataset.parentId,
                    type: listEl.dataset.parentType,
                    el: listEl
                  };
                }

                const parentContainer = listEl.closest('[data-id][data-type]');
                if (!parentContainer) return null;
                return {
                  id: parentContainer.getAttribute('data-id'),
                  type: parentContainer.getAttribute('data-type'),
                  el: listEl
                };
              },

              getDirectHierarchyRow(itemEl) {
                if (!itemEl) return null;
                return Array.from(itemEl.children || [])
                  .find(child => child.matches?.('.sidebar-space-row, .sidebar-child-row')) || null;
              },

              findHierarchyItemElement(itemId) {
                const targetId = String(itemId || '');
                if (!targetId) return null;
                return Array.from(document.querySelectorAll('.sidebar-spaces-area li[data-id][data-type]'))
                  .find(el => String(el.getAttribute('data-id') || '') === targetId) || null;
              },

              beginHierarchyDrag() {
                this.clearHoverOpenTimer();
                this.dragSession = {
                  activeDropdown: [...this.activeDropdown].map(id => String(id)),
                  subActive: [...this.subActive].map(id => String(id)),
                  expandedIds: [...this.expandedIds].map(id => String(id))
                };
              },

              clearHoverOpenTimer() {
                if (this.hoverOpenTimer) clearTimeout(this.hoverOpenTimer);
                this.hoverOpenTimer = null;
                this.hoverOpenTargetId = null;
              },

              closeTransientDragOpenTargets(keepIds = []) {
                const session = this.dragSession;
                this.clearHoverOpenTimer();
                if (!session) return;

                const keep = new Set((keepIds || []).filter(Boolean).map(id => String(id)));
                const keepOriginalOrTarget = (ids, originalIds) => {
                  const original = new Set((originalIds || []).map(id => String(id)));
                  return [...new Set((ids || []).filter(Boolean).map(id => String(id)))]
                    .filter(id => original.has(id) || keep.has(id));
                };

                this.activeDropdown = keepOriginalOrTarget(this.activeDropdown, session.activeDropdown);
                this.subActive = keepOriginalOrTarget(this.subActive, session.subActive);
                this.expandedIds = keepOriginalOrTarget(this.expandedIds, session.expandedIds);
                this.dragSession = null;
              },

              getContainerElementFromDropElement(element) {
                const containerEl = element?.closest?.('[data-id][data-type]');
                if (!containerEl) return null;

                const targetId = containerEl.getAttribute('data-id');
                const targetType = containerEl.getAttribute('data-type');
                if (!targetId || !this.isContainerItem(targetType)) return null;
                return containerEl;
              },

              resolveExplicitDropParentFromElement(element, ignoredItemId = null) {
                if (!element || typeof element.closest !== 'function') return null;
                const ignoredId = String(ignoredItemId || '');
                const isIgnoredParent = (id) => ignoredId && String(id || '') === ignoredId;

                const placeholder = element.closest('.add-placeholder[data-parent-id][data-parent-type]');
                if (placeholder && !isIgnoredParent(placeholder.dataset.parentId)) {
                  return {
                    id: placeholder.dataset.parentId,
                    type: placeholder.dataset.parentType,
                    source: 'placeholder'
                  };
                }

                const directItem = element.matches?.('li[data-id][data-type]') ? element : null;
                const row = element.closest('.sidebar-space-row, .sidebar-child-row');
                const rowItem = directItem || row?.closest?.('li[data-id][data-type]');
                const rowType = rowItem?.getAttribute?.('data-type');
                if (rowItem && !isIgnoredParent(rowItem.getAttribute('data-id')) && this.isContainerItem(rowType)) {
                  return {
                    id: rowItem.getAttribute('data-id'),
                    type: rowType,
                    source: 'row'
                  };
                }

                const dropList = element.closest('.hierarchy-sub-menu[data-parent-id][data-parent-type]');
                if (dropList && !isIgnoredParent(dropList.dataset.parentId)) {
                  return {
                    id: dropList.dataset.parentId,
                    type: dropList.dataset.parentType,
                    source: 'list'
                  };
                }

                return null;
              },

              resolveDropIntent(evt, parent) {
                if (!parent?.id) return 'inside';

                const originalEvent = evt?.originalEvent;
                if (typeof originalEvent?.clientY !== 'number') return 'inside';

                const enrichedParent = this.captureDropParentMetrics(parent);
                return this.resolveDropIntentFromMetrics(evt, enrichedParent);
              },

              captureDropParentMetrics(parent) {
                if (!parent?.id) return parent;

                const enrichedParent = { ...parent };
                const targetItemEl = this.findHierarchyItemElement(parent.id);
                const row = this.getDirectHierarchyRow(targetItemEl);
                const rowRect = row?.getBoundingClientRect?.();
                if (rowRect) {
                  enrichedParent.rowTop = rowRect.top;
                  enrichedParent.rowBottom = rowRect.bottom;
                  enrichedParent.rowHeight = rowRect.height;
                }

                const targetChildrenList = this.findDropListForParent(parent.id);
                const placeholder = targetChildrenList?.querySelector(':scope > .add-placeholder[data-parent-id]');
                const placeholderRect = placeholder?.getBoundingClientRect?.();
                if (placeholderRect) {
                  enrichedParent.placeholderTop = placeholderRect.top;
                  enrichedParent.placeholderBottom = placeholderRect.bottom;
                }

                return enrichedParent;
              },

              resolveDropIntentFromMetrics(evt, parent) {
                if (!parent?.id) return 'inside';

                const originalEvent = evt?.originalEvent;
                if (typeof originalEvent?.clientY !== 'number') return 'inside';

                const pointerY = originalEvent.clientY;
                const rowTop = Number(parent.rowTop);
                const rowHeight = Number(parent.rowHeight);
                const placeholderBottom = Number(parent.placeholderBottom);

                if (parent.source === 'placeholder' && Number.isFinite(placeholderBottom)) {
                  return 'inside';
                }

                if (parent.source === 'row' && Number.isFinite(rowTop) && Number.isFinite(rowHeight)) {
                  if (this.isDropContainerOpen(parent.id)) return 'inside';
                  return pointerY < rowTop + (rowHeight * 0.5) ? 'before' : 'after';
                }

                if (parent.source === 'list' && Number.isFinite(placeholderBottom)) {
                  return pointerY > placeholderBottom + 8 ? 'after' : 'inside';
                }

                return 'inside';
              },

              refreshDropParentIntent(evt, parent) {
                if (!parent?.id) return parent;
                const refreshedParent = { ...parent };
                refreshedParent.intent = this.resolveDropIntentFromMetrics(evt, refreshedParent);
                return refreshedParent;
              },

              refreshEndDropParentIntent(evt, parent) {
                const refreshedParent = this.refreshDropParentIntent(evt, parent);
                if (!refreshedParent?.id || refreshedParent.source !== 'row' || refreshedParent.intent !== 'after') {
                  return refreshedParent;
                }

                const originalEvent = evt?.originalEvent;
                if (typeof originalEvent?.clientY !== 'number') return refreshedParent;

                const placement = this.findHierarchyPlacement(refreshedParent.id);
                if (!placement || placement.depth === 0) return refreshedParent;
                if (!this.isDropContainerOpen(refreshedParent.id)) return refreshedParent;

                const draggedRow = this.getDirectHierarchyRow(evt?.item);
                const draggedHeight = draggedRow?.getBoundingClientRect?.().height || 0;
                const rowBottom = Number(refreshedParent.rowBottom);
                if (Number.isFinite(rowBottom) && draggedHeight && originalEvent.clientY <= rowBottom + draggedHeight + 8) {
                  refreshedParent.intent = 'inside';
                }

                return refreshedParent;
              },

              isHierarchyAncestor(ancestorId, descendantId) {
                const ancestor = String(ancestorId || '');
                const descendant = String(descendantId || '');
                if (!ancestor || !descendant || ancestor === descendant) return false;

                const path = this.findHierarchyPath(descendant);
                if (!path || path.length < 2) return false;
                return path.slice(0, -1).some(item => String(item.id) === ancestor);
              },

              isPointerWithinDropSnapshot(evt, parent) {
                if (!parent?.id) return false;

                const originalEvent = evt?.originalEvent;
                if (typeof originalEvent?.clientY !== 'number') return false;

                const rowTop = Number(parent.rowTop);
                const rowBottom = Number(parent.rowBottom);
                if (!Number.isFinite(rowTop) || !Number.isFinite(rowBottom)) return false;

                return originalEvent.clientY >= rowTop - 8 && originalEvent.clientY <= rowBottom + 8;
              },

              isDropContainerOpen(id) {
                const targetId = String(id || '');
                if (!targetId) return false;
                return [
                  ...(this.activeDropdown || []),
                  ...(this.subActive || []),
                  ...(this.expandedIds || [])
                ].some(openId => String(openId) === targetId);
              },

              resolveCoordinateDropParent(evt, ignoredItemId = null) {
                const originalEvent = evt?.originalEvent;
                if (
                  typeof originalEvent?.clientX !== 'number' ||
                  typeof originalEvent?.clientY !== 'number'
                ) {
                  return null;
                }

                const ignoredId = String(ignoredItemId || evt?.item?.getAttribute?.('data-id') || '');
                const pointerX = originalEvent.clientX;
                const pointerY = originalEvent.clientY;
                const rows = Array.from(document.querySelectorAll('.sidebar-spaces-area .sidebar-space-row, .sidebar-spaces-area .sidebar-child-row'));
                let best = null;

                for (const row of rows) {
                  const item = row.closest('li[data-id][data-type]');
                  if (!item) continue;
                  const id = item.getAttribute('data-id');
                  const type = item.getAttribute('data-type');
                  if (!id || String(id) === ignoredId || !this.isContainerItem(type)) continue;

                  const rect = row.getBoundingClientRect();
                  const withinX = pointerX >= rect.left - 18 && pointerX <= rect.right + 18;
                  const withinY = pointerY >= rect.top - 4 && pointerY <= rect.bottom + 48;
                  if (!withinX || !withinY) continue;

                  const centerY = rect.top + rect.height / 2;
                  const distance = Math.abs(pointerY - centerY);
                  if (!best || distance < best.distance) {
                    best = {
                      id,
                      type,
                      source: 'row',
                      intent: this.isDropContainerOpen(id)
                        ? 'inside'
                        : (pointerY < rect.top + (rect.height * 0.5) ? 'before' : 'after'),
                      rowTop: rect.top,
                      rowBottom: rect.bottom,
                      rowHeight: rect.height,
                      distance
                    };
                  }
                }

                if (!best) return null;
                const { distance, ...parent } = best;
                return parent;
              },

              resolveAdjacentContainerDrop(evt, itemEl, parentEl) {
                const originalEvent = evt?.originalEvent;
                if (
                  !itemEl ||
                  !parentEl ||
                  typeof originalEvent?.clientY !== 'number' ||
                  typeof originalEvent?.clientX !== 'number'
                ) {
                  return null;
                }

                const pointerX = originalEvent.clientX;
                const pointerY = originalEvent.clientY;
                const siblings = Array.from(parentEl.querySelectorAll(':scope > li[data-id][data-type]'));
                const itemIndex = siblings.findIndex(el => el === itemEl);
                if (itemIndex === -1) return null;

                const candidates = [siblings[itemIndex - 1], siblings[itemIndex + 1]].filter(Boolean);
                for (const candidate of candidates) {
                  const id = candidate.getAttribute('data-id');
                  const type = candidate.getAttribute('data-type');
                  if (!id || !this.isContainerItem(type)) continue;

                  const row = this.getDirectHierarchyRow(candidate);
                  const rect = row?.getBoundingClientRect?.();
                  if (!rect) continue;

                  const insideX = pointerX >= rect.left - 18 && pointerX <= rect.right + 18;
                  const insideY = pointerY >= rect.top - 4 && pointerY <= rect.bottom + 48;
                  if (!insideX || !insideY) continue;

                  return {
                    id,
                    type,
                    source: 'row',
                    intent: this.isDropContainerOpen(id)
                      ? 'inside'
                      : (pointerY < rect.top + (rect.height * 0.5) ? 'before' : 'after'),
                    rowTop: rect.top,
                    rowBottom: rect.bottom,
                    rowHeight: rect.height
                  };
                }

                return null;
              },

              isDropParentStillRelevant(evt, parent) {
                if (!parent?.id) return false;

                const originalEvent = evt?.originalEvent;
                if (typeof originalEvent?.clientY !== 'number') return true;

                const targetItemEl = this.findHierarchyItemElement(parent.id);
                const row = this.getDirectHierarchyRow(targetItemEl);
                const rowRect = row?.getBoundingClientRect?.();
                if (!rowRect) return false;

                const targetChildrenList = this.findDropListForParent(parent.id);
                const placeholder = targetChildrenList?.querySelector(':scope > .add-placeholder[data-parent-id]');
                const placeholderRect = placeholder?.getBoundingClientRect?.();
                const upper = rowRect.top - 104;
                const lower = Math.max(rowRect.bottom, placeholderRect?.bottom || 0) + 104;
                return originalEvent.clientY >= upper && originalEvent.clientY <= lower;
              },

              resolveSameLevelDropContext(evt, explicitDropParent) {
                if (!explicitDropParent?.id) return null;
                if (!['before', 'after'].includes(explicitDropParent.intent)) return null;

                const originalEvent = evt?.originalEvent;
                if (typeof originalEvent?.clientY !== 'number') return null;

                const targetItemEl = this.findHierarchyItemElement(explicitDropParent.id);
                if (!targetItemEl || targetItemEl === evt?.item) return null;
                if (!this.isContainerItem(targetItemEl.getAttribute('data-type'))) return null;

                const row = this.getDirectHierarchyRow(targetItemEl);
                const parentListEl = targetItemEl.parentElement;
                const parentContext = this.getParentContextFromList(parentListEl);
                if (!row || !parentListEl || !parentContext) return null;

                const pointerY = originalEvent.clientY;
                const rowRect = row.getBoundingClientRect();
                const targetChildrenList = this.findDropListForParent(explicitDropParent.id);
                const placeholder = targetChildrenList?.querySelector(':scope > .add-placeholder[data-parent-id]');
                const placeholderRect = placeholder?.getBoundingClientRect?.();
                const rowAfterLimit = Math.max(rowRect.bottom, placeholderRect?.bottom || 0) + 96;
                if (pointerY > rowAfterLimit && explicitDropParent.source !== 'row') return null;

                const siblings = Array.from(parentListEl.querySelectorAll(':scope > li[data-id][data-type]'));
                const targetIndex = siblings.findIndex(el => String(el.getAttribute('data-id')) === String(explicitDropParent.id));
                if (targetIndex === -1) return null;

                return {
                  id: parentContext.id,
                  type: parentContext.type,
                  el: parentContext.el,
                  insertIndex: explicitDropParent.intent === 'before' ? targetIndex : targetIndex + 1
                };
              },

              resolveExplicitDropParentFromEvent(evt) {
                const candidates = [];
                const originalEvent = evt?.originalEvent;
                const ignoredItemId = evt?.item?.getAttribute?.('data-id');
                const coordinateParent = this.resolveCoordinateDropParent(evt, ignoredItemId);
                if (coordinateParent) return coordinateParent;

                if (evt?.related) candidates.push(evt.related);
                if (originalEvent?.target) candidates.push(originalEvent.target);
                if (typeof originalEvent?.clientX === 'number' && typeof originalEvent?.clientY === 'number') {
                  candidates.push(...document.elementsFromPoint(originalEvent.clientX, originalEvent.clientY));
                }
                if (evt?.to) candidates.push(evt.to);

                for (const candidate of candidates) {
                  const parent = this.resolveExplicitDropParentFromElement(candidate, ignoredItemId);
                  if (parent?.id && parent?.type) {
                    const enrichedParent = this.captureDropParentMetrics(parent);
                    enrichedParent.intent = this.resolveDropIntentFromMetrics(evt, enrichedParent);
                    return enrichedParent;
                  }
                }

                return null;
              },

              patchSortableDragOverGuard() {
                if (!window.Sortable || Sortable.__dexioDragOverGuard) return;
                const originalDragOver = Sortable.prototype?._onDragOver;
                if (typeof originalDragOver !== 'function') return;

                Sortable.prototype._onDragOver = function (...args) {
                  if (!this?.el) return false;

                  try {
                    return originalDragOver.apply(this, args);
                  } catch (error) {
                    if (String(error?.message || '').includes('lastElementChild')) {
                      return false;
                    }
                    throw error;
                  }
                };

                Sortable.__dexioDragOverGuard = true;
              },

              isEnvironmentRootDropFromEvent(evt) {
                if (!this.activeEnvironmentId) return false;

                const originalEvent = evt?.originalEvent;
                if (typeof originalEvent?.clientX !== 'number' || typeof originalEvent?.clientY !== 'number') {
                  return false;
                }

                const rootEl = document.querySelector('ul[data-parent-type="root"]');
                if (!rootEl) return false;

                const elements = document.elementsFromPoint(originalEvent.clientX, originalEvent.clientY);
                for (const element of elements) {
                  const row = element.closest?.('.sidebar-space-row');
                  const item = row?.closest?.('li[data-id][data-type]');
                  if (row && item && item.parentElement === rootEl) {
                    const rect = row.getBoundingClientRect();
                    return originalEvent.clientY >= rect.top && originalEvent.clientY <= rect.bottom;
                  }
                }

                return false;
              },

              initDragAndDrop() {
                if (typeof Sortable === 'undefined') {
                  console.warn('[Sidebar] Sortable.js not loaded');
                  return;
                }
                this.patchSortableDragOverGuard();

                // Destroy existing instances first
                this.sortableInstances.forEach(instance => {
                  if (instance && typeof instance.destroy === 'function') {
                    instance.destroy();
                  }
                });
                this.sortableInstances = [];

                // Root list for the active Espace - use data attribute to avoid wrong container
                const rootEl = document.querySelector('ul[data-parent-type="root"]');
                if (rootEl) {
                  console.log('[Sidebar] Initializing Sortable for active espace root');
                  const rootSortable = new Sortable(rootEl, {
                    group: { name: 'hierarchy', pull: true, put: true },
                    draggable: '> li[data-id][data-type]',
                    disabled: Boolean(this.editingId),
                    filter: 'input, textarea, select, button, [contenteditable="true"], .sidebar-rename-input',
                    preventOnFilter: false,
                    animation: 150,
                    emptyInsertThreshold: 28,
                    swapThreshold: 0.65,
                    onStart: (evt) => {
                      if (this.isHierarchyDragBlocked(evt)) return false;
                      this.beginHierarchyDrag();
                    },
                    onMove: (evt) => this.isHierarchyDragBlocked(evt) ? false : this.canAcceptSortableMove(evt),
                    onAdd: (evt) => {
                      if (this.isRailDropItem(evt.item)) {
                        this.handleRailDropIntoHierarchy(evt, 'space');
                      }
                    },
                    onEnd: (evt) => {
                      this.dragOverFolderId = null;
                      if (this.isRailDropItem(evt.item)) return;
                      if (this.isDroppingIntoRail(evt)) return;
                      this.handleDrop(evt, 'space');
                    }
                  });
                  this.sortableInstances.push(rootSortable);
                } else {
                  console.warn('[Sidebar] Active espace root container not found');
                }

                // Nested lists (Folders/Entities) inside spaces and folders
                const nestedEls = document.querySelectorAll('.hierarchy-sub-menu');
                nestedEls.forEach(el => {
                  const nestedSortable = new Sortable(el, {
                    group: { name: 'hierarchy', pull: true, put: true },
                    draggable: '> li[data-id][data-type]',
                    disabled: Boolean(this.editingId),
                    filter: 'input, textarea, select, button, [contenteditable="true"], .sidebar-rename-input',
                    preventOnFilter: false,
                    animation: 150,
                    emptyInsertThreshold: 28,
                    swapThreshold: 0.65,
                    onStart: (evt) => {
                      if (this.isHierarchyDragBlocked(evt)) return false;
                      this.beginHierarchyDrag();
                    },
                    onMove: (evt) => this.isHierarchyDragBlocked(evt) ? false : this.canAcceptSortableMove(evt),
                    onAdd: (evt) => {
                      if (this.isRailDropItem(evt.item)) {
                        this.handleRailDropIntoHierarchy(evt, 'nested');
                      }
                    },
                    onEnd: (evt) => {
                      this.dragOverFolderId = null; // Clear on drop or cancel
                      if (this.isRailDropItem(evt.item)) return;
                      if (this.isDroppingIntoRail(evt)) return;
                      this.handleDrop(evt, 'nested');
                    }
                  });
                  this.sortableInstances.push(nestedSortable);
                });
              },

              isRailDropItem(itemEl) {
                if (!itemEl || typeof itemEl.getAttribute !== 'function') return false;
                return (
                  itemEl.getAttribute('data-source') === 'env-rail' ||
                  (itemEl.hasAttribute('data-env-id') && itemEl.getAttribute('data-type') === 'rail-space')
                );
              },

              isDroppingIntoRail(evt) {
                const target = evt?.to;
                return Boolean(
                  target?.classList?.contains('env-rail-list') ||
                  target?.closest?.('.env-rail-list')
                );
              },

              getRailDropSpaceId(itemEl) {
                if (!itemEl || typeof itemEl.getAttribute !== 'function') return '';
                return itemEl.getAttribute('data-env-id') || itemEl.getAttribute('data-id') || '';
              },

              getSortableInsertIndex(evt) {
                if (Number.isInteger(evt?.newDraggableIndex)) return evt.newDraggableIndex;
                if (Number.isInteger(evt?.newIndex)) return evt.newIndex;
                return null;
              },

              resolveRailDropContext(evt) {
                const parentEl = evt?.to;
                const initialParentContext = this.getParentContextFromList(parentEl) || {};
                let parentId = initialParentContext.id || this.activeEnvironmentId || null;
                let parentType = initialParentContext.type || (this.activeEnvironmentId ? 'environment-root' : null);
                let insertIndex = this.getSortableInsertIndex(evt);

                const pendingDropParent = this.refreshDropParentIntent(evt, this.pendingDropParent);
                const endDropParent = this.refreshEndDropParentIntent(evt, this.resolveExplicitDropParentFromEvent(evt));
                let explicitDropParent = endDropParent;
                if (!endDropParent?.id && this.isDropParentStillRelevant(evt, pendingDropParent)) {
                  explicitDropParent = pendingDropParent;
                }
                this.pendingDropParent = null;

                const sameLevelDrop = this.resolveSameLevelDropContext(evt, explicitDropParent);
                if (sameLevelDrop) {
                  parentId = sameLevelDrop.id;
                  parentType = sameLevelDrop.type;
                  insertIndex = sameLevelDrop.insertIndex;
                } else if (explicitDropParent?.id) {
                  parentId = explicitDropParent.id;
                  parentType = explicitDropParent.type;
                  if (explicitDropParent.source === 'placeholder') {
                    insertIndex = this.getSortableInsertIndex(evt);
                  } else if (explicitDropParent.intent === 'inside') {
                    const targetChildrenList = this.findDropListForParent(explicitDropParent.id);
                    const siblingCount = targetChildrenList
                      ? targetChildrenList.querySelectorAll(':scope > li[data-id][data-type]').length
                      : 0;
                    insertIndex = Number.isInteger(insertIndex) ? insertIndex : siblingCount;
                  }
                }

                const forceEnvironmentRootDrop = !sameLevelDrop && !explicitDropParent && this.isEnvironmentRootDropFromEvent(evt);
                if (forceEnvironmentRootDrop) {
                  parentId = this.activeEnvironmentId || null;
                  parentType = this.activeEnvironmentId ? 'environment-root' : null;
                  insertIndex = this.getSortableInsertIndex(evt);
                }

                return {
                  parentId,
                  parentType,
                  insertIndex
                };
              },

              canAcceptRailSpaceDrop(itemEl, parentId, parentType) {
                const railSpaceId = this.getRailDropSpaceId(itemEl);
                if (!railSpaceId || !this.activeEnvironmentId) return false;
                if (String(railSpaceId) === String(this.activeEnvironmentId)) return false;

                if (this.isHierarchyRootParent(parentId, parentType)) return true;

                return this.canMoveHierarchyItemIntoParent(
                  { id: `rail-${railSpaceId}`, type: 'folder', children: [] },
                  'folder',
                  parentId,
                  parentType
                );
              },

              async handleRailDropIntoHierarchy(evt, group) {
                const itemEl = evt.item;
                const railSpaceId = this.getRailDropSpaceId(itemEl);
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];

                // The rail uses clone mode. Alpine owns the final DOM, so the clone
                // must disappear immediately and the server result drives the render.
                if (itemEl?.parentElement) itemEl.remove();
                this.dragOverFolderId = null;

                const dropContext = this.resolveRailDropContext(evt);
                this.closeTransientDragOpenTargets([dropContext.parentId]);

                if (!this.canAcceptRailSpaceDrop(itemEl, dropContext.parentId, dropContext.parentType)) {
                  console.warn('[Sidebar] Rail drop refused', { railSpaceId, dropContext });
                  this.$nextTick(() => this.initDragAndDrop());
                  return;
                }

                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/demote-space-to-hierarchy`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      spaceId: railSpaceId,
                      targetSpaceId: this.activeEnvironmentId,
                      parentId: dropContext.parentId,
                      parentType: dropContext.parentType,
                      insertIndex: dropContext.insertIndex
                    })
                  });
                  const data = await res.json();
                  if (!res.ok || data.error) {
                    throw new Error(data.error || `Move failed (${res.status})`);
                  }

                  window.dispatchEvent(new CustomEvent('environment-updated', {
                    detail: {
                      force: true,
                      removedSpaceId: data.removedSpaceId || railSpaceId,
                      targetSpaceId: data.targetSpaceId || this.activeEnvironmentId
                    }
                  }));
                  await this.fetchHierarchy(true);

                  const createdId = data.item?.id || data.section?.id || data.folder?.id;
                  if (createdId) {
                    this.openHierarchyBranch(createdId);
                    this.saveSidebarPrefs();
                  }
                  this.$nextTick(() => this.initDragAndDrop());
                } catch (error) {
                  console.error('[Sidebar] Rail drop sync failed:', error);
                  alert(error.message || "Erreur lors du déplacement de l'espace");
                  await this.fetchHierarchy(true);
                }
              },

              async handleDrop(evt, group) {
                const itemEl = evt.item;
                const newIndex = evt.newIndex;
                const oldIndex = evt.oldIndex;
                const parentEl = evt.to;
                const oldParentEl = evt.from;

                const id = itemEl.getAttribute('data-id');
                const type = itemEl.getAttribute('data-type');
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];

                // --- 1. Identify New Parent ---
                const initialParentContext = this.getParentContextFromList(parentEl) || {};
                let newParentId = initialParentContext.id || null;
                let newParentType = initialParentContext.type || null;
                let reorderParentEl = initialParentContext.el || parentEl;
                let targetNewIndex = newIndex;

                // --- 2. Identify Old Parent ---
                let oldParentId_Val = null;
                if (oldParentEl.dataset?.parentType === 'root' || oldParentEl.classList.contains('sortable-root')) {
                  oldParentId_Val = this.activeEnvironmentId || null;
                } else if (oldParentEl.dataset?.parentId) {
                  oldParentId_Val = oldParentEl.dataset.parentId;
                } else {
                  const oldParentContainer = oldParentEl.closest('[data-id]');
                  if (oldParentContainer) {
                    oldParentId_Val = oldParentContainer.getAttribute('data-id');
                  }
                }

                const pendingDropParent = this.refreshDropParentIntent(evt, this.pendingDropParent);
                const endDropParent = this.refreshEndDropParentIntent(evt, this.resolveExplicitDropParentFromEvent(evt));
                let explicitDropParent = endDropParent;
                if (!endDropParent?.id && this.isDropParentStillRelevant(evt, pendingDropParent)) {
                  explicitDropParent = pendingDropParent;
                }
                if (
                  pendingDropParent?.id &&
                  endDropParent?.id &&
                  String(pendingDropParent.id) !== String(endDropParent.id) &&
                  this.isHierarchyAncestor(pendingDropParent.id, endDropParent.id)
                ) {
                  explicitDropParent = endDropParent;
                }
                if (
                  pendingDropParent?.id &&
                  endDropParent?.id &&
                  String(pendingDropParent.id) === String(endDropParent.id) &&
                  endDropParent.intent === 'inside'
                ) {
                  explicitDropParent = endDropParent;
                } else if (
                  pendingDropParent?.id &&
                  endDropParent?.id &&
                  String(pendingDropParent.id) === String(endDropParent.id)
                ) {
                  explicitDropParent = pendingDropParent;
                } else if (
                  pendingDropParent?.id &&
                  endDropParent?.id &&
                  String(pendingDropParent.id) !== String(endDropParent.id) &&
                  ['inside', 'before', 'after'].includes(pendingDropParent.intent) &&
                  this.isPointerWithinDropSnapshot(evt, pendingDropParent)
                ) {
                  explicitDropParent = pendingDropParent;
                }
                this.pendingDropParent = null;

                const sameLevelDrop = this.resolveSameLevelDropContext(evt, explicitDropParent);
                if (sameLevelDrop) {
                  newParentId = sameLevelDrop.id;
                  newParentType = sameLevelDrop.type;
                  reorderParentEl = sameLevelDrop.el;
                  targetNewIndex = sameLevelDrop.insertIndex;
                } else if (explicitDropParent && String(explicitDropParent.id) !== String(id)) {
                  newParentId = explicitDropParent.id;
                  newParentType = explicitDropParent.type;
                  reorderParentEl = this.findDropListForParent(explicitDropParent.id) || parentEl;
                }
                const forceEnvironmentRootDrop = !sameLevelDrop && !explicitDropParent && this.isEnvironmentRootDropFromEvent(evt);
                if (forceEnvironmentRootDrop) {
                  newParentId = this.activeEnvironmentId || null;
                  newParentType = this.activeEnvironmentId ? 'environment-root' : null;
                  reorderParentEl = document.querySelector('ul[data-parent-type="root"]') || parentEl;
                  targetNewIndex = newIndex;
                }

                const adjacentContainerDrop = this.resolveAdjacentContainerDrop(evt, itemEl, parentEl);
                if (
                  adjacentContainerDrop &&
                  adjacentContainerDrop.intent === 'inside' &&
                  String(adjacentContainerDrop.id) !== String(id)
                ) {
                  newParentId = adjacentContainerDrop.id;
                  newParentType = adjacentContainerDrop.type;
                  reorderParentEl = this.findDropListForParent(adjacentContainerDrop.id) || parentEl;
                  targetNewIndex = Number.isInteger(newIndex) ? newIndex : 0;
                }

                this.closeTransientDragOpenTargets();

                if (!this.canMoveHierarchyItemIntoParent(id, type, newParentId, newParentType)) {
                  console.warn('[Sidebar] Drop refused: folder depth limit reached', { id, type, newParentId, newParentType });
                  this.revertSortableDomMove(evt);
                  await this.waitForSortableCleanup();
                  this.$nextTick(() => this.initDragAndDrop());
                  return;
                }

                // If Sortable did not change anything and no explicit parent was chosen,
                // close temporary hover-opened folders and leave the tree untouched.
                if (
                  newIndex === oldIndex &&
                  parentEl === oldParentEl &&
                  String(newParentId || '') === String(oldParentId_Val || '')
                ) {
                  return;
                }

                console.log(`[Sidebar] Drop: ${type}#${id} | From: ${oldParentId_Val || 'root'} -> To: ${newParentId || 'root'} | Idx: ${oldIndex} -> ${newIndex}`);

                // --- 3. Capture order and update local tree immediately ---
                // Alpine owns the x-for DOM. Sortable is only the preview layer, so
                // compute the final order from this.hierarchy by ID, not from DOM indexes.
                this.revertSortableDomMove(evt);
                const moveResult = this.optimisticallyMoveHierarchyItem(
                  id,
                  type,
                  newParentId,
                  newParentType,
                  targetNewIndex,
                  explicitDropParent
                );

                if (!moveResult) {
                  console.warn('[Sidebar] Drop ignored: unable to resolve hierarchy move', { id, type, newParentId, newParentType });
                  this.fetchHierarchy(true);
                  return;
                }

                targetNewIndex = moveResult.insertIndex;
                const items = moveResult.siblings.map((item, index) => ({
                  id: item.id || item._id,
                  type: item.type,
                  order: index
                }));

                await this.waitForSortableCleanup();
                this.applyOptimisticHierarchyMove(moveResult);
                this.cleanupDroppedItemDuplicates(id, newParentId, newParentType, itemEl);
                this.$nextTick(() => this.cleanupDroppedItemDuplicates(id, newParentId, newParentType));

                // --- 4. API Requests ---
                try {
                  // Move API (only if parent changed)
                  if (String(newParentId || '') !== String(oldParentId_Val || '')) {
                    const moveRes = await fetch(`/account/${accountNum}/api/hierarchy/move`, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({
                        itemId: id,
                        itemType: type,
                        newParentId: newParentId,
                        newParentType: newParentType,
                        oldParentId: oldParentId_Val
                      })
                    });
                    if (!moveRes.ok) throw new Error(`Move failed (${moveRes.status})`);
                  }

                  const reorderRes = await fetch(`/account/${accountNum}/api/hierarchy/reorder`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ items })
                  });
                  if (!reorderRes.ok) throw new Error(`Reorder failed (${reorderRes.status})`);

                  console.log("[Sidebar] Sync success", items);
                  await this.syncHierarchyAfterDrop(newParentId, newParentType, id);

                } catch (e) {
                  console.error("Sync failed", e);
                  alert("Erreur de synchronisation serveur");
                  this.fetchHierarchy(); // Revert on error
                }
              },

              getHierarchyItemId(item) {
                return String(item?.id || item?._id || '');
              },

              getHierarchyRenderKey(item) {
                const id = this.getHierarchyItemId(item);
                return `${this.hierarchyRenderKey}:${id || item?.slug || item?.name || 'item'}`;
              },

              cloneHierarchyList(list) {
                return (list || []).map(item => ({
                  ...item,
                  id: this.getHierarchyItemId(item),
                  children: this.cloneHierarchyList(item.children || [])
                }));
              },

              detachHierarchyItem(list, itemId) {
                const targetId = String(itemId || '');
                if (!targetId || !Array.isArray(list)) return null;

                for (let index = 0; index < list.length; index++) {
                  const item = list[index];
                  if (this.getHierarchyItemId(item) === targetId) {
                    return list.splice(index, 1)[0];
                  }

                  const removed = this.detachHierarchyItem(item.children || [], targetId);
                  if (removed) return removed;
                }

                return null;
              },

              findHierarchyItem(id, list = this.hierarchy) {
                const targetId = String(id || '');
                if (!targetId) return null;

                for (const item of list || []) {
                  if (this.getHierarchyItemId(item) === targetId) return item;
                  const found = this.findHierarchyItem(targetId, item.children || []);
                  if (found) return found;
                }

                return null;
              },

              getHierarchyChildrenForParent(parentId, parentType, root) {
                if (
                  parentType === 'environment-root' ||
                  !parentId ||
                  String(parentId) === String(this.activeEnvironmentId || '')
                ) {
                  return root;
                }

                const parent = this.findHierarchyItem(parentId, root);
                if (!parent) return null;
                if (!Array.isArray(parent.children)) parent.children = [];
                return parent.children;
              },

              isFolderLikeType(type) {
                return ['folder', 'environment', 'workstation'].includes(type);
              },

              isSectionLikeType(type) {
                return ['space', 'environment'].includes(type);
              },

              isHierarchyRootParent(parentId, parentType) {
                return (
                  parentType === 'environment-root' ||
                  !parentId ||
                  String(parentId) === String(this.activeEnvironmentId || '')
                );
              },

              getParentHierarchyDepth(parentId, parentType, root = this.hierarchy) {
                const targetId = typeof parentId === 'object'
                  ? this.getHierarchyItemId(parentId)
                  : String(parentId || '');
                const targetType = typeof parentId === 'object'
                  ? parentId?.type
                  : parentType;

                if (
                  targetType === 'environment-root' ||
                  !targetId ||
                  String(targetId) === String(this.activeEnvironmentId || '')
                ) {
                  return -1;
                }

                const placement = this.findHierarchyPlacement(targetId, root);
                if (placement) return placement.depth;
                return targetType === 'space' ? 0 : -1;
              },

              getMaxFolderLikeDepthOffset(item, offset = 0) {
                if (!item) return -1;

                let maxDepth = this.isFolderLikeType(item.type) ? offset : -1;
                for (const child of item.children || []) {
                  maxDepth = Math.max(maxDepth, this.getMaxFolderLikeDepthOffset(child, offset + 1));
                }

                return maxDepth;
              },

              canCreateSectionAtParent(parent) {
                const targetParent = parent || this.environmentRootItem();
                return Boolean(targetParent && this.isHierarchyRootParent(targetParent.id, targetParent.type));
              },

              canCreateFolderLikeChild(parent) {
                if (!parent || !this.isContainerItem(parent)) return false;
                return this.getParentHierarchyDepth(parent) < 2;
              },

              canCreateItemOfType(type, parent) {
                if (!parent || !this.isContainerItem(parent)) return false;
                if (type === 'environment') return this.canCreateSectionAtParent(parent);
                if (this.isFolderLikeType(type)) return this.canCreateFolderLikeChild(parent);
                return true;
              },

              canMoveHierarchyItemIntoParent(itemOrId, itemType, newParentId, newParentType, root = this.hierarchy) {
                const item = typeof itemOrId === 'object' && itemOrId !== null
                  ? itemOrId
                  : this.findHierarchyItem(itemOrId, root) || { id: itemOrId, type: itemType, children: [] };
                const type = item.type || itemType;

                if (this.isSectionLikeType(type) && !this.isHierarchyRootParent(newParentId, newParentType)) {
                  return false;
                }
                if (type === 'space') return true;
                if (!this.isFolderLikeType(type)) return true;

                const parentDepth = this.getParentHierarchyDepth(newParentId, newParentType, root);
                const subtreeMaxOffset = Math.max(0, this.getMaxFolderLikeDepthOffset(item));

                return parentDepth + 1 + subtreeMaxOffset <= 2;
              },

              canAcceptSortableMove(evt) {
                const itemEl = evt?.dragged || evt?.item;
                if (!itemEl) return true;

                if (this.isRailDropItem(itemEl)) {
                  const parentContext = this.getParentContextFromList(evt?.to) || {
                    id: this.activeEnvironmentId || null,
                    type: this.activeEnvironmentId ? 'environment-root' : null
                  };
                  return this.canAcceptRailSpaceDrop(itemEl, parentContext.id, parentContext.type);
                }

                const type = itemEl.getAttribute?.('data-type');
                if (!this.isFolderLikeType(type) && !this.isSectionLikeType(type)) return true;

                const id = itemEl.getAttribute?.('data-id');
                const parentContext = this.getParentContextFromList(evt?.to);
                if (!parentContext) return true;

                return this.canMoveHierarchyItemIntoParent(
                  id,
                  type,
                  parentContext.id,
                  parentContext.type
                );
              },

              resolveHierarchyInsertIndex(targetSiblings, fallbackIndex, explicitDropParent) {
                if (explicitDropParent?.id && ['before', 'after'].includes(explicitDropParent.intent)) {
                  const targetIndex = (targetSiblings || []).findIndex(item =>
                    this.getHierarchyItemId(item) === String(explicitDropParent.id)
                  );

                  if (targetIndex !== -1) {
                    return explicitDropParent.intent === 'before' ? targetIndex : targetIndex + 1;
                  }
                }

                if (Number.isInteger(fallbackIndex)) {
                  return Math.max(0, Math.min(fallbackIndex, targetSiblings.length));
                }

                return targetSiblings.length;
              },

              revertSortableDomMove(evt) {
                const itemEl = evt?.item;
                const fromEl = evt?.from;
                if (!itemEl || !fromEl) return;

                const siblingsWithoutItem = Array.from(fromEl.querySelectorAll(':scope > li[data-id][data-type]'))
                  .filter(el => el !== itemEl);
                const ref = siblingsWithoutItem[evt.oldIndex] || fromEl.querySelector(':scope > .add-placeholder') || null;

                if (itemEl.parentElement !== fromEl || itemEl.nextSibling !== ref) {
                  fromEl.insertBefore(itemEl, ref);
                }
              },

              waitForSortableCleanup() {
                return new Promise(resolve => {
                  requestAnimationFrame(() => requestAnimationFrame(resolve));
                });
              },

              applyOptimisticHierarchyMove(moveResult) {
                if (!moveResult?.root) return false;
                const nextRoot = this.cloneHierarchyList(moveResult.root);
                this.hierarchy = nextRoot;
                this.hierarchyRenderKey += 1;
                this.realSpacesCount = nextRoot.length;
                return true;
              },

              optimisticallyMoveHierarchyItem(itemId, itemType, newParentId, newParentType, newIndex, explicitDropParent = null) {
                if (newParentId && this.isHierarchyAncestor(itemId, newParentId)) return null;

                const root = this.cloneHierarchyList(this.hierarchy);
                const movedItem = this.detachHierarchyItem(root, itemId);
                if (!movedItem) return null;

                movedItem.id = this.getHierarchyItemId(movedItem);
                if (!movedItem.id) return null;
                movedItem.type = movedItem.type || itemType;
                if (!this.canMoveHierarchyItemIntoParent(movedItem, movedItem.type, newParentId, newParentType, root)) {
                  return null;
                }
                const targetSiblings = this.getHierarchyChildrenForParent(newParentId, newParentType, root);
                if (!targetSiblings) return null;

                const insertIndex = this.resolveHierarchyInsertIndex(targetSiblings, newIndex, explicitDropParent);
                targetSiblings.splice(insertIndex, 0, movedItem);
                targetSiblings.forEach((item, index) => { item.order = index; });

                return {
                  root,
                  siblings: targetSiblings,
                  insertIndex
                };
              },

              cleanupDroppedItemDuplicates(itemId, newParentId, newParentType, preferredEl = null) {
                const targetId = String(itemId || '');
                if (!targetId) return;

                const matches = Array.from(document.querySelectorAll('.sidebar-spaces-area li[data-id][data-type]'))
                  .filter(el => String(el.getAttribute('data-id')) === targetId);
                if (matches.length <= 1) return;

                const desiredParentEl = newParentType === 'environment-root'
                  ? document.querySelector('ul[data-parent-type="root"]')
                  : this.findDropListForParent(newParentId);
                const keep = (desiredParentEl && matches.find(el => el.parentElement === desiredParentEl))
                  || (preferredEl && matches.includes(preferredEl) ? preferredEl : null)
                  || matches[0];

                matches.forEach(el => {
                  if (el !== keep) el.remove();
                });

                Array.from(document.querySelectorAll('.sortable-fallback, .sortable-drag'))
                  .filter(el => String(el.getAttribute('data-id') || '') === targetId)
                  .forEach(el => el.remove());
              },

              isItemActive(link) {
                if (!link || link === '#') return false;
                const current = decodeURIComponent(window.location.pathname);
                const target = decodeURIComponent(String(link).split('?')[0]);
                if (current === target) return true;
                // Match sub-paths: /record/serveur/ID/overview matches /record/serveur/ID
                if (target.length > 1 && current.startsWith(target + '/')) return true;
                return false;
              },

              detectActiveItem() {
                const currentPath = decodeURIComponent(window.location.pathname);
                const matchesPath = (link) => {
                  if (!link) return false;
                  const target = decodeURIComponent(String(link).split('?')[0]);
                  return currentPath === target || (target.length > 1 && currentPath.startsWith(target + '/'));
                };
                const openAncestors = (ancestors) => {
                  for (const [index, ancestor] of ancestors.entries()) {
                    if (index === 0) {
                      const ancestorId = String(ancestor.id);
                      if (!this.activeDropdown.includes(ancestorId)) this.activeDropdown.push(ancestorId);
                    } else if (index === 1) {
                      const ancestorId = String(ancestor.id);
                      if (!this.subActive.includes(ancestorId)) this.subActive.push(ancestorId);
                    } else {
                      const ancestorId = String(ancestor.id);
                      if (!this.expandedIds.includes(ancestorId)) this.expandedIds.push(ancestorId);
                    }
                  }
                };
                const walk = (items, ancestors = []) => {
                  for (const item of items || []) {
                    if (matchesPath(item.link)) {
                      openAncestors(ancestors);
                      return true;
                    }
                    if (this.isContainerItem(item) && walk(item.children || [], [...ancestors, item])) {
                      return true;
                    }
                  }
                  return false;
                };
                walk(this.hierarchy);
              },

              toggle(id) {
                id = String(id);
                if (this.activeDropdown.includes(id)) {
                  this.activeDropdown = this.activeDropdown.filter(x => x !== id);
                } else {
                  this.activeDropdown.push(id);
                }
                this.saveSidebarPrefs();
              },

              toggleSub(id) {
                id = String(id);
                if (this.subActive.includes(id)) {
                  this.subActive = this.subActive.filter(x => x !== id);
                } else {
                  this.subActive.push(id);
                }
                this.saveSidebarPrefs();
              },

              toggleExpand(id, forceOpen = false) {
                id = String(id);
                if (forceOpen) {
                  if (!this.expandedIds.includes(id)) this.expandedIds.push(id);
                } else {
                  if (this.expandedIds.includes(id)) {
                    this.expandedIds = this.expandedIds.filter(x => x !== id);
                  } else {
                    this.expandedIds.push(id);
                  }
                }
                this.saveSidebarPrefs();
              },

              isExpanded(id) {
                return this.expandedIds.includes(String(id));
              },

              isContainerItem(item) {
                const type = typeof item === 'object' && item !== null ? item.type : item;
                return ['environment-root', 'space', 'folder', 'environment', 'workstation'].includes(type);
              },

              scheduleOpenDropTargetFromElement(element) {
                const containerEl = this.getContainerElementFromDropElement(element);
                const targetId = containerEl?.getAttribute?.('data-id');
                if (!targetId) {
                  this.clearHoverOpenTimer();
                  return false;
                }

                if (this.hoverOpenTargetId === targetId) return true;

                this.clearHoverOpenTimer();
                this.hoverOpenTargetId = targetId;
                this.hoverOpenTimer = setTimeout(() => {
                  this.openDropTargetFromElement(containerEl);
                  this.hoverOpenTimer = null;
                  this.hoverOpenTargetId = null;
                }, 420);
                return true;
              },

              openDropTargetFromElement(element) {
                const containerEl = this.getContainerElementFromDropElement(element);
                if (!containerEl) return false;

                const targetId = containerEl.getAttribute('data-id');
                const targetType = containerEl.getAttribute('data-type');
                if (!targetId || !this.isContainerItem(targetType)) return false;

                const target = this.findHierarchyPlacement(targetId);
                if (!target) return false;

                if (target.depth === 0) {
                  if (!this.activeDropdown.includes(targetId)) this.activeDropdown.push(targetId);
                } else if (target.depth === 1) {
                  if (!this.subActive.includes(targetId)) this.subActive.push(targetId);
                } else if (!this.expandedIds.includes(targetId)) {
                  this.expandedIds.push(targetId);
                }
                this.dragOverFolderId = targetId;
                return true;
              },

              environmentRootItem() {
                if (!this.activeEnvironmentId) return null;
                return {
                  id: this.activeEnvironmentId,
                  type: 'environment-root',
                  name: this.activeEnvironmentName || 'Espace',
                  icon: this.activeEnvironmentIcon || 'solar:share-circle-bold-duotone',
                  color: this.activeEnvironmentColor || '#4361ee',
                  children: this.hierarchy || [],
                  link: '#'
                };
              },

              findHierarchyPlacement(id, list = this.hierarchy, depth = 0) {
                const targetId = String(id || '');
                if (!targetId) return null;
                for (const item of list || []) {
                  if (this.getHierarchyItemId(item) === targetId) return { item, depth };
                  const found = this.findHierarchyPlacement(targetId, item.children || [], depth + 1);
                  if (found) return found;
                }
                return null;
              },

              findHierarchyPath(id, list = this.hierarchy, path = []) {
                const targetId = String(id || '');
                if (!targetId) return null;
                for (const item of list || []) {
                  const nextPath = [...path, item];
                  if (String(item.id) === targetId) return nextPath;
                  const found = this.findHierarchyPath(targetId, item.children || [], nextPath);
                  if (found) return found;
                }
                return null;
              },

              openHierarchyPath(id, includeTarget = true) {
                const path = this.findHierarchyPath(id);
                if (!path) return false;

                const nodesToOpen = includeTarget ? path : path.slice(0, -1);
                nodesToOpen.forEach((item, index) => {
                  if (!this.isContainerItem(item)) return;
                  const itemId = String(item.id);
                  if (index === 0 || item.type === 'space') {
                    if (!this.activeDropdown.includes(itemId)) this.activeDropdown.push(itemId);
                  } else if (index === 1) {
                    if (!this.subActive.includes(itemId)) this.subActive.push(itemId);
                  } else if (!this.expandedIds.includes(itemId)) {
                    this.expandedIds.push(itemId);
                  }
                });

                this.normalizeOpenStateArrays();
                this.reconcileOpenContainerDom(nodesToOpen.map(item => item.id));
                return true;
              },

              normalizeOpenStateArrays() {
                const uniqueIds = (ids) => [...new Set((ids || []).filter(Boolean).map(id => String(id)))];
                this.activeDropdown = uniqueIds(this.activeDropdown);
                this.subActive = uniqueIds(this.subActive);
                this.expandedIds = uniqueIds(this.expandedIds);
              },

              reconcileOpenContainerDom(ids = []) {
                const targetIds = [...new Set((ids || []).filter(Boolean).map(id => String(id)))];
                if (targetIds.length === 0) return;

                const reveal = () => {
                  targetIds.forEach(id => {
                    const list = this.findDropListForParent(id);
                    if (!list) return;
                    list.hidden = false;
                    list.style.display = 'block';
                    list.style.height = 'auto';
                    list.style.overflow = 'visible';
                  });
                };

                this.$nextTick(() => {
                  reveal();
                  requestAnimationFrame(() => {
                    reveal();
                    requestAnimationFrame(reveal);
                  });
                });
              },

              openHierarchyBranch(id) {
                return this.openHierarchyPath(id, true);
              },

              async syncHierarchyAfterDrop(newParentId, newParentType, movedId) {
                this.dragOverFolderId = null;
                this.normalizeOpenStateArrays();
                this.saveSidebarPrefs();

                // The tree was already updated through the Alpine data model. Avoid
                // clearing/refetching here: destroying Sortable containers while the
                // browser finishes dragover cleanup triggers Sortable null-element errors.
                await new Promise(resolve => setTimeout(resolve, 120));
                await new Promise(resolve => this.$nextTick(resolve));
                this.$nextTick(() => this.initDragAndDrop());
              },

              openCreatedItemPath(parent, createdItem = null) {
                this.openHierarchyBranch(parent?.id);
                const createdId = createdItem?.id || createdItem?._id;
                const created = this.findHierarchyPlacement(createdId);
                if (created && ['space', 'folder', 'environment', 'workstation'].includes(created.item.type)) {
                  this.openHierarchyBranch(createdId);
                }
                this.saveSidebarPrefs();
                this.$nextTick(() => this.initDragAndDrop());
              },

              async loadSidebarPrefs() {
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const res = await fetch(`/account/${accountNum}/api/user/sidebar-prefs`);
                  if (res.ok) {
                    const data = await res.json();
                    const savedIds = data.expandedIds || [];
                    // Helper to find nested item by ID
                    const findInHierarchy = (list, id) => {
                      for (const item of list) {
                        if (item.id === id) return item;
                        if (item.children) {
                          const found = findInHierarchy(item.children, id);
                          if (found) return found;
                        }
                      }
                      return null;
                    };
                    // Restore all state arrays
                    this.activeDropdown = savedIds.filter(id => this.hierarchy.some(item => item.id === id));
                    this.subActive = savedIds.filter(id => {
                      // First-level children of root containers
                      return this.hierarchy.some(space => space.children && space.children.some(child => child.id === id));
                    });
                    this.expandedIds = savedIds.filter(id => {
                      // Everything else (deeper nested)
                      const isSpace = this.hierarchy.some(item => item.id === id);
                      const isFirstLevel = this.hierarchy.some(space => space.children && space.children.some(child => child.id === id));
                      return !isSpace && !isFirstLevel && findInHierarchy(this.hierarchy, id);
                    });
                    console.log('[Sidebar] Loaded preferences', { activeDropdown: this.activeDropdown, subActive: this.subActive, expandedIds: this.expandedIds });
                  }
                } catch (e) {
                  console.error('[Sidebar] Failed to load preferences', e);
                }
              },

              saveSidebarPrefs() {
                // Debounce: save 1 second after last change
                if (this.savePrefsTimeout) clearTimeout(this.savePrefsTimeout);
                this.savePrefsTimeout = setTimeout(async () => {
                  const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                  const allExpandedIds = [...this.activeDropdown, ...this.subActive, ...this.expandedIds];
                  try {
                    await fetch(`/account/${accountNum}/api/user/sidebar-prefs`, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ expandedIds: allExpandedIds })
                    });
                    console.log('[Sidebar] Saved preferences', allExpandedIds);
                  } catch (e) {
                    console.error('[Sidebar] Failed to save preferences', e);
                  }
                }, 1000);
              },

              getIcon(item, hasChildren = false, expanded = false, hovered = false) {
                let type = item;
                let customIcon = null;
                if (typeof item === 'object' && item !== null) {
                  type = item.type;
                  customIcon = item.icon;
                }

                const effectivelyHasChildren = hasChildren || this.isContainerItem(type);
                if (effectivelyHasChildren && (expanded || hovered) && ['folder', 'environment', 'workstation'].includes(type)) {
                  return expanded ? 'solar:folder-open-line-duotone' : 'solar:folder-2-line-duotone';
                }

                if (customIcon) return customIcon;

                if (type === 'environment-root') return this.activeEnvironmentIcon || 'solar:share-circle-bold-duotone';
                if (type === 'space') return 'solar:layers-minimalistic-line-duotone';
                if (type === 'folder') return 'solar:folder-2-line-duotone';
                if (type === 'environment') return 'solar:layers-minimalistic-line-duotone';
                if (type === 'workstation') return 'solar:case-round-bold-duotone';
                if (type === 'entity') return 'solar:database-bold';
                if (type === 'hub') return 'solar:widget-5-bold-duotone';
                return 'solar:file-text-line-duotone';
              },

              getHierarchyIconSize(item, expanded = false, baseSize = 16) {
                const type = typeof item === 'object' && item !== null ? item.type : item;
                if (expanded && ['folder', 'environment', 'workstation'].includes(type)) return baseSize + 2;
                return baseSize;
              },

              async openEnvironmentCreateMenu(event) {
                const parent = this.environmentRootItem();
                if (!parent) return;
                await this.openCreateMenu(event, parent);
              },

              async openCreateMenu(event, item) {
                event?.preventDefault?.();
                event?.stopPropagation?.();
                this.menuMode = 'main';
                this.entitySearch = '';
                this.pendingViewType = 'list';
                Alpine.store('sidebar').contextItem = item;
                Alpine.store('sidebar').openedAt = Date.now();
                Alpine.store('sidebar').showMenu = true;
                Alpine.store('sidebar').showEditMenu = false;
                this.installSidebarPopoverGuard();
                await this.loadAllEntities();
              },

              getDefaultCreateParent() {
                const activeRoot = this.environmentRootItem();
                if (activeRoot) return activeRoot;

                if (this.isSingleSpaceEnv && this.hierarchy[0]) {
                  return { ...this.hierarchy[0], type: 'space' };
                }

                const rootSpace = (this.hierarchy || []).find(item => item.type === 'space');
                if (rootSpace) return rootSpace;

                return (this.hierarchy || [])[0] || null;
              },

              async openSidebarBackgroundMenu(event) {
                if (event?.type !== 'contextmenu') {
                  return;
                }

                const target = event?.target;
                if (target?.closest?.('[data-id][data-type], a, button, input, select, textarea, .hierarchy-popover')) {
                  return;
                }

                const parent = this.getDefaultCreateParent();
                if (!parent) return;

                await this.openCreateMenu(event, parent);
              },

              closeSidebarPopovers() {
                Alpine.store('sidebar').showMenu = false;
                Alpine.store('sidebar').showEditMenu = false;
              },

              installSidebarPopoverGuard() {
                if (this.sidebarPopoverCloseTimer) {
                  clearTimeout(this.sidebarPopoverCloseTimer);
                  this.sidebarPopoverCloseTimer = null;
                }

                if (this.sidebarPopoverCloseHandler) {
                  document.removeEventListener('mousedown', this.sidebarPopoverCloseHandler);
                  document.removeEventListener('contextmenu', this.sidebarPopoverCloseHandler);
                  this.sidebarPopoverCloseHandler = null;
                }

                this.sidebarPopoverCloseTimer = setTimeout(() => {
                  this.sidebarPopoverCloseHandler = (evt) => {
                    const store = Alpine.store('sidebar');
                    if (!store.showMenu && !store.showEditMenu) return;
                    if (Date.now() - (store.openedAt || 0) < 350) return;

                    const target = evt.target;
                    if (target?.closest?.('.hierarchy-popover')) return;

                    this.closeSidebarPopovers();
                  };

                  document.addEventListener('mousedown', this.sidebarPopoverCloseHandler);
                  document.addEventListener('contextmenu', this.sidebarPopoverCloseHandler);
                }, 350);
              },

              async loadAllEntities() {
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/all-entities`);
                  if (res.ok) {
                    const data = await res.json();
                    this.allEntities = data.entities || [];
                  }
                } catch (e) {
                  console.error("Failed to load entities", e);
                }
              },

              filteredEntities() {
                if (!this.entitySearch) return this.allEntities;
                return this.allEntities.filter(e =>
                  e.name.toLowerCase().includes(this.entitySearch.toLowerCase())
                );
              },

              filteredHubEntities() {
                const search = String(this.hubEntitySearch || '').trim().toLowerCase();
                const entities = this.allEntities || [];
                if (!search) return entities;
                return entities.filter(e => {
                  const name = String(e.name || '').toLowerCase();
                  const plural = String(e.namePlural || '').toLowerCase();
                  const singular = String(e.nameSingular || '').toLowerCase();
                  return name.includes(search) || plural.includes(search) || singular.includes(search);
                });
              },

              destroyHubPickers() {
                try {
                  const iconPicker = this.$refs?.hubIconPicker;
                  if (iconPicker?._iconPickerRoot) {
                    iconPicker._iconPickerRoot.unmount();
                    iconPicker._iconPickerRoot = null;
                    iconPicker.dataset.mounted = '';
                    iconPicker.innerHTML = '';
                  }
                } catch (err) {
                  console.warn('[HubModal] Icon picker cleanup failed', err);
                }
                try {
                  if (this.hubColorPicker) {
                    this.hubColorPicker.destroy();
                    this.hubColorPicker = null;
                  }
                } catch (err) {
                  console.warn('[HubModal] Color picker cleanup failed', err);
                  this.hubColorPicker = null;
                }
              },

              mountHubColorPicker() {
                this.$nextTick(() => {
                  const el = this.$refs?.hubEntityColorPicker;
                  if (!el || typeof window.ColorPicker !== 'function') return;
                  try {
                    if (this.hubColorPicker) {
                      this.hubColorPicker.destroy();
                      this.hubColorPicker = null;
                    }
                    this.hubColorPicker = new window.ColorPicker(el, {
                      name: 'hubEntityColor',
                      value: this.hubEntityColor,
                      colors: this.availableColors,
                      allowClear: false,
                      zIndex: 10000,
                      onSelect: (color) => {
                        this.hubEntityColor = color || '#8b5cf6';
                      }
                    });
                  } catch (err) {
                    console.warn('[HubModal] Color picker mount failed', err);
                  }
                });
              },

              openHubEntityImagePicker() {
                const picker = Alpine.store('imagePicker');
                if (!picker || typeof picker.open !== 'function') {
                  alert("Sélecteur d'image indisponible");
                  return;
                }
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                picker.open({
                  accountNumber: accountNum,
                  multiple: false,
                  onSelect: (image) => {
                    this.hubEntityImage = image?.url || '';
                  }
                });
              },

              hubEnabledModulesCount() {
                return this.hubModuleOptions.filter(mod => this.isHubModuleEnabled(mod.key)).length;
              },

              canSubmitHub() {
                if (this.hubSubmitting || !String(this.hubName || '').trim()) return false;
                if (this.hubEntityMode === 'existing') return Boolean(this.hubEntityId);
                return true;
              },

              isHubModuleEnabled(key) {
                return key === 'overview' || this.hubVisibleModules.includes(key);
              },

              toggleHubModule(key) {
                key = String(key || '');
                if (!key || key === 'overview') return;
                if (this.hubVisibleModules.includes(key)) {
                  this.hubVisibleModules = this.hubVisibleModules.filter(item => item !== key);
                } else {
                  this.hubVisibleModules = [...this.hubVisibleModules, key];
                }
              },

              async linkExistingEntity(entity, options = {}) {
                const viewType = this.pendingViewType;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                const parent = Alpine.store('sidebar').contextItem;
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/link-entity`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      entityId: entity.id,
                      parentId: parent.id,
                      parentType: parent.type,
                      viewType: viewType,
                      ...options
                    })
                  });
                  if (res.ok) {
                    Alpine.store('sidebar').showMenu = false;
                    await this.fetchHierarchy();
                  }
                } catch (e) { alert("Erreur: " + e.message); }
              },

              openEditMenu(event, type, item, parent = null) {
                event?.preventDefault?.();
                event?.stopPropagation?.();
                Alpine.store('sidebar').contextItem = { ...item, type, parent };
                Alpine.store('sidebar').openedAt = Date.now();
                Alpine.store('sidebar').showEditMenu = true;
                Alpine.store('sidebar').showMenu = false;
                this.installSidebarPopoverGuard();
              },

              createSection() {
                const parent = Alpine.store('sidebar').contextItem;
                Alpine.store('sidebar').showMenu = false;
                Alpine.store('sidebar').showEditMenu = false;

                if (!this.canCreateSectionAtParent(parent || this.environmentRootItem())) {
                  alert("Les sections se créent uniquement au niveau racine.");
                  return;
                }

                const environmentId = parent?.id || this.activeEnvironmentId;
                if (!environmentId) return;
                window.dispatchEvent(new CustomEvent('open-space-modal', {
                  detail: { space: null, environmentId }
                }));
              },

              createSpace() {
                this.createSection();
              },

              async submitCreateHub() {
                const parent = Alpine.store('sidebar').contextItem;
                const name = this.hubName.trim();
                if (!name || !parent) return;

                this.hubSubmitting = true;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const endpoint = `/account/${accountNum}/api/hierarchy/hub`;
                  const existingEntityId = this.hubEntityMode === 'existing' ? this.hubEntityId : '';
                  const isNewEntity = this.hubEntityMode !== 'existing';
                  const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      name,
                      entityId: existingEntityId,
                      entityName: existingEntityId ? '' : this.hubEntityName.trim(),
                      entityMode: isNewEntity ? 'new' : 'existing',
                      createNewEntity: isNewEntity,
                      entityIcon: isNewEntity ? this.hubEntityIcon : '',
                      entityColor: isNewEntity ? this.hubEntityColor : '',
                      entityImage: isNewEntity ? this.hubEntityImage : '',
                      visibleModules: isNewEntity ? this.hubVisibleModules : [],
                      parentId: parent.id,
                      parentType: parent.type
                    })
                  });
                  const raw = await res.text();
                  let data = {};
                  if (raw) {
                    try { data = JSON.parse(raw); } catch (_) { data = {}; }
                  }
                  if (!res.ok) {
                    const textMessage = raw && !raw.trim().startsWith('<') ? raw.trim() : '';
                    const fallback = res.status === 404
                      ? `Route de création du hub introuvable (${endpoint})`
                      : `HTTP ${res.status}`;
                    throw new Error(data.error || data.message || textMessage || fallback);
                  }
                  this.closeHubModal();
                  await this.fetchHierarchy(true);
                  this.openCreatedItemPath(parent, data.hub || data);
                } catch (e) {
                  alert("Erreur: " + e.message);
                } finally {
                  this.hubSubmitting = false;
                }
              },

              async createItem(type, viewType = 'list') {
                const parent = Alpine.store('sidebar').contextItem;
                if (!this.canCreateItemOfType(type, parent)) {
                  alert("Impossible de créer un sous-dossier à ce niveau.");
                  Alpine.store('sidebar').showMenu = false;
                  Alpine.store('sidebar').showEditMenu = false;
                  return;
                }

                this.creationType = type;
                this.pendingViewType = viewType;
                this.creationName = '';
                
                // Set default icon based on type and viewType
                let icon = this.getIcon(type);
                if (type === 'entity') {
                    if (viewType === 'list') icon = 'solar:list-bold';
                    if (viewType === 'note') icon = 'solar:notes-bold-duotone';
                    if (viewType === 'dashboard') icon = 'solar:pie-chart-3-line-duotone';
                }
                this.creationIcon = icon;
                this.creationColor = '';

                // Initialize picker state
                this.iconSearch = '';
                this.selectedLibrary = this.creationIcon.split(':')[0] || 'solar';
                if (this.libraries.length > 0 && !this.libraries.find(l => l.id === this.selectedLibrary)) {
                  this.selectedLibrary = this.libraries[0].id;
                }

                this.showCreateModal = true;
                Alpine.store('sidebar').showMenu = false;
                Alpine.store('sidebar').showEditMenu = false;

                await this.loadIcons(true); // Load initial icons

                this.$nextTick(() => {
                  if (this.$refs.createInput) this.$refs.createInput.focus();
                });
              },

              async submitCreateItem() {
                if (!this.creationName) return;
                this.isSubmitting = true;
                const type = this.creationType;
                const name = this.creationName;
                const icon = this.creationIcon;
                const color = this.creationColor;
                const viewType = this.pendingViewType;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                const parent = Alpine.store('sidebar').contextItem;

                if (!this.canCreateItemOfType(type, parent)) {
                  this.isSubmitting = false;
                  alert("Impossible de créer un sous-dossier à ce niveau.");
                  return;
                }

                const url = ['folder', 'environment'].includes(type) ? 'folder' : 'entity';
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/${url}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      name,
                      type,
                      icon,
                      color,
                      parentId: parent.id,
                      parentType: parent.type,
                      viewType: viewType
                    })
                  });
                  if (!res.ok) {
                    const err = await res.json();
                    throw new Error(err.error || `HTTP ${res.status}`);
                  }
                  const createdItem = await res.json();
                  this.showCreateModal = false;
                  await this.fetchHierarchy(true);
                  this.openCreatedItemPath(parent, createdItem);
                } catch (e) { alert("Erreur: " + e.message); }
                finally { this.isSubmitting = false; }
              },

              startRename(item) {
                this.editingId = item.id;
                this.editingName = item.name;
                this.setHierarchyDragDisabled(true);
                this.$nextTick(() => this.setHierarchyDragDisabled(true));
                Alpine.store('sidebar').showEditMenu = false;
              },

              async openIconEditor(item) {
                this.editingIcon = item.icon || this.getIcon(item.type);
                this.editingColor = item.color || '';

                // Initialize picker state
                this.iconSearch = '';
                this.selectedLibrary = this.editingIcon.split(':')[0] || 'solar';
                if (this.libraries.length > 0 && !this.libraries.find(l => l.id === this.selectedLibrary)) {
                  this.selectedLibrary = this.libraries[0].id;
                }

                this.showIconEditModal = true;
                Alpine.store('sidebar').showEditMenu = false;

                await this.loadIcons(true);
              },

              async submitEditIcon() {
                // if (!this.editingIcon) return; // Allow empty icon to reset to default via logic? No, just keep required.
                this.isSubmitting = true;
                const item = Alpine.store('sidebar').contextItem;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];

                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/icon`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: item.id, type: item.type, icon: this.editingIcon, color: this.editingColor })
                  });
                  if (!res.ok) throw new Error(`HTTP ${res.status}`);
                  item.icon = this.editingIcon;
                  item.color = this.editingColor;
                  this.showIconEditModal = false;
                  await this.fetchHierarchy();
                } catch (e) { alert("Erreur: " + e.message); }
                finally { this.isSubmitting = false; }
              },

              async saveRename(item) {
                if (this.editingId !== item.id) return;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                const newName = this.editingName;
                this.editingId = null;
                this.$nextTick(() => this.setHierarchyDragDisabled(false));

                if (!newName || newName === item.name) return;

                try {
                  await fetch(`/account/${accountNum}/api/hierarchy/rename`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: item.id, type: item.type, newName })
                  });
                  item.name = newName;
                } catch (e) { console.error(e); }
              },

              async deleteItem() {
                const item = Alpine.store('sidebar').contextItem;
                if (!item || !confirm(`Êtes-vous sûr de vouloir supprimer ${item.type} ?`)) return;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const body = { id: item.id, type: item.type };
                  if (item.type === 'entity' && item.parent) {
                    body.parentId = item.parent.id;
                    body.parentType = item.parent.type;
                  }
                  await fetch(`/account/${accountNum}/api/hierarchy/delete`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                  });
                  console.log(`[Sidebar] Item ${item.id} unlinked/deleted, waiting for refresh...`);
                  Alpine.store('sidebar').showEditMenu = false;

                  // Small delay to ensure DB propagation
                  await new Promise(r => setTimeout(r, 100));
                  await this.fetchHierarchy();
                } catch (e) { alert("Erreur: " + e.message); }
              },

              async openViewConfig() {
                const item = Alpine.store('sidebar').contextItem;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];

                try {
                  // 1. Get View Details
                  const resView = await fetch(`/account/${accountNum}/api/hierarchy/list?id=${item.id}`); // This is just to get data, maybe we need a specific endpoint
                  // Actually, let's just use the item data we have if possible, but we need fields.
                  // Better approach: fetch entity details
                  const resEntity = await fetch(`/account/${accountNum}/api/entity/${item.entityId}`);
                  if (!resEntity.ok) throw new Error("Erreur chargement entité");
                  this.configEntity = await resEntity.json();

                  // Mock view data for now if we don't have a fetch-by-id
                  this.configView = item;
                  this.tempViewType = item.viewType || 'list';
                  this.tempFilters = item.filters || [];

                  this.showViewConfigModal = true;
                  Alpine.store('sidebar').showEditMenu = false;
                } catch (e) {
                  alert("Erreur: " + e.message);
                }
              },

              addFilter() {
                this.tempFilters.push({ field: '', operator: 'equals', value: '' });
              },

              removeFilter(index) {
                this.tempFilters.splice(index, 1);
              },

              async saveViewConfig() {
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const res = await fetch(`/account/${accountNum}/api/view/config`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      viewId: this.configView.id,
                      viewType: this.tempViewType,
                      filters: this.tempFilters
                    })
                  });
                  if (res.ok) {
                    this.showViewConfigModal = false;
                    await this.fetchHierarchy();
                  }
                } catch (e) {
                  alert("Erreur: " + e.message);
                }
              }
            }));
          });
        </script>

        <!-- Environment Rail Alpine Component -->
        <script>
          function environmentRail() {
            return {
              environments: [],
              activeEnvId: null,
              isLoadingEnvironments: false,
              lastRefreshTime: 0,

              // Context menus
              railMenuOpen: false,
              envMenuOpen: false,
              menuX: 0,
              menuY: 0,
              menuEnv: null,
              _envCtxHandled: false,
              _activePopup: null,

              async init() {
                await this.refreshEnvironments();
                // Listen for modal save events to refresh the list
                window.addEventListener('env-modal-saved', async (e) => {
                  const detail = e.detail || {};
                  await this.refreshEnvironments({ force: true });
                  if (detail.newEnv) {
                    this.selectEnvironment(detail.newEnv, true);
                  }
                });

                // ═══ SortableJS: Reorder envs + accept space/folder drops ═══
                const self = this;
                this._sortable = Sortable.create(this.$el, {
                  group: { name: 'env-rail', pull: 'clone', put: ['hierarchy'], revertClone: true },
                  animation: 200,
                  draggable: '.env-rail-sortable-item',
                  filter: '.add-env-btn,.env-rail-space-dropzone',
                  ghostClass: 'env-rail-ghost',
                  dragClass: 'env-rail-dragging',
                  chosenClass: 'env-rail-chosen',
                  onClone(evt) {
                    self.prepareRailClone(evt);
                  },
                  onMove(evt) {
                    const draggedIsEnv = Boolean(evt.dragged?.dataset?.envId);
                    if (draggedIsEnv && evt.to === self.$el && evt.related && !evt.related.matches?.('.env-rail-sortable-item[data-env-id]')) {
                      return false;
                    }
                    return true;
                  },

                  // When a SPACE or FOLDER is dropped from sidebar → promote it
                  onAdd(evt) {
                    const itemId = evt.item.getAttribute('data-id');
                    const itemType = evt.item.getAttribute('data-type');
                    console.log('[EnvironmentRail] Item dropped on rail:', itemType, itemId);

                    // Remove the dropped DOM element (SortableJS moved it here)
                    evt.item.remove();
                    if (itemId && itemType === 'space') {
                      self.promoteSpaceToEnvironment(itemId);
                    } else if (itemId && ['folder', 'environment', 'workstation'].includes(itemType)) {
                      self.promoteFolderToEnvironment(itemId);
                    } else {
                      window.dispatchEvent(new CustomEvent('space-modal-saved'));
                    }
                  },

                  onEnd(evt) {
                    if (evt.pullMode === 'clone' || evt.to !== evt.from) {
                      self.cleanupRailCloneArtifacts();
                      self.$nextTick(() => self.cleanupRailCloneArtifacts());
                      return;
                    }

                    const envId = evt.item.dataset.envId;
                    if (!envId) return;

                    const oldIdx = self.environments.findIndex(e => e.id === envId);
                    if (oldIdx === -1) return;

                    const originalIdx = Number.isInteger(evt.oldDraggableIndex) ? evt.oldDraggableIndex : evt.oldIndex;
                    const previewOrderIds = Array.from(evt.from.querySelectorAll('.env-rail-sortable-item[data-env-id]'))
                      .map(el => el.dataset.envId)
                      .filter(Boolean);
                    const targetIdx = previewOrderIds.indexOf(envId);

                    // REVERT DOM move — Alpine manages the DOM via x-for
                    const itemsWithoutMoved = Array.from(evt.from.querySelectorAll('.env-rail-sortable-item[data-env-id]'))
                      .filter(el => el !== evt.item);
                    const ref = itemsWithoutMoved[originalIdx] || null;
                    if (ref) {
                      evt.from.insertBefore(evt.item, ref);
                    } else {
                      const envBoundary = evt.from.querySelector('.env-rail-space-dropzone, .add-env-btn');
                      if (envBoundary) {
                        evt.from.insertBefore(evt.item, envBoundary);
                      } else {
                        evt.from.appendChild(evt.item);
                      }
                    }

                    const [moved] = self.environments.splice(oldIdx, 1);
                    const insertIdx = targetIdx === -1
                      ? self.environments.length
                      : Math.max(0, Math.min(targetIdx, self.environments.length));
                    self.environments.splice(insertIdx, 0, moved);

                    self.environments.forEach((env, idx) => { env.order = idx; });
                    self.saveEnvOrder();
                  }
                });

              },

              prepareRailClone(evt) {
                const clone = evt?.clone;
                if (!clone) return;

                clone.setAttribute('x-ignore', '');
                clone.setAttribute('data-rail-clone', 'true');

                const stripAlpineAttrs = (element) => {
                  Array.from(element.attributes || []).forEach(attr => {
                    if (
                      attr.name.startsWith('x-') ||
                      attr.name.startsWith('@') ||
                      attr.name.startsWith(':')
                    ) {
                      element.removeAttribute(attr.name);
                    }
                  });
                };

                stripAlpineAttrs(clone);
                clone.querySelectorAll('*').forEach(stripAlpineAttrs);
              },

              cleanupRailCloneArtifacts(extraRemovedIds = []) {
                const railEl = this.$el || document.querySelector('.env-rail-list');
                if (!railEl) return;

                const validIds = new Set((this.environments || []).map(env => String(env.id)));
                const removedIds = new Set((extraRemovedIds || []).filter(Boolean).map(id => String(id)));

                Array.from(railEl.querySelectorAll('.env-rail-sortable-item')).forEach(el => {
                  const envId = el.getAttribute('data-env-id') || el.getAttribute('data-id') || '';
                  const shouldRemove = (
                    el.getAttribute('data-rail-clone') === 'true' ||
                    el.classList.contains('sortable-drag') ||
                    el.classList.contains('sortable-fallback') ||
                    !envId ||
                    removedIds.has(String(envId)) ||
                    (validIds.size > 0 && !validIds.has(String(envId)))
                  );

                  if (shouldRemove) el.remove();
                });

                document.querySelectorAll('[data-rail-clone="true"], .sortable-fallback.env-rail-sortable-item, .sortable-drag.env-rail-sortable-item')
                  .forEach(el => el.remove());
              },

              async handleEnvironmentUpdated(event = null) {
                const detail = event?.detail || {};
                const removedId = detail.removedSpaceId || detail.removedEnvironmentId;

                if (removedId) {
                  this.environments = this.environments.filter(env => String(env.id) !== String(removedId));
                  this.cleanupRailCloneArtifacts([removedId]);
                  this.$nextTick(() => this.cleanupRailCloneArtifacts([removedId]));
                  if (String(this.activeEnvId || '') === String(removedId)) {
                    const fallback = detail.targetSpaceId
                      ? this.environments.find(env => String(env.id) === String(detail.targetSpaceId))
                      : null;
                    this.activeEnvId = null;
                    if (fallback) this.selectEnvironment(fallback, true, false);
                  }
                }

                await this.refreshEnvironments({ force: Boolean(detail.force || removedId) });
              },

              async refreshEnvironments(options = {}) {
                const force = Boolean(options.force);
                const now = Date.now();
                if (this.isLoadingEnvironments) {
                  if (force) {
                    let waitCount = 0;
                    while (this.isLoadingEnvironments && waitCount < 30) {
                      await new Promise(resolve => setTimeout(resolve, 50));
                      waitCount++;
                    }
                    if (!this.isLoadingEnvironments) {
                      return this.refreshEnvironments({ force: true });
                    }
                  }
                  console.warn('[EnvironmentRail] refreshEnvironments skipped: already loading');
                  return;
                }
                if (!force && now - this.lastRefreshTime < 300) {
                  console.warn('[EnvironmentRail] refreshEnvironments skipped: rate limit cooldown');
                  return;
                }
                this.isLoadingEnvironments = true;
                this.lastRefreshTime = now;

                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/environments?t=${Date.now()}`);
                  if (!res.ok) throw new Error(`HTTP ${res.status}`);
                  const data = await res.json();
                  this.environments = data.environments || [];
                  this.$nextTick(() => this.cleanupRailCloneArtifacts());

                  if (this.environments.length > 0 && !this.activeEnvId) {
                    // Try to auto-detect the correct environment from the current URL
                    const detected = await this.detectEnvironmentFromUrl(accountNum);
                    if (detected) {
                      const targetEnv = this.environments.find(e => e.id === detected);
                      if (targetEnv) {
                        this.selectEnvironment(targetEnv, false, false);
                        return;
                      }
                    }
                    // Fallback: select the first environment
                    this.selectEnvironment(this.environments[0], false, false);
                  }
                } catch (err) {
                  console.error('[EnvironmentRail] Error:', err);
                } finally {
                  this.isLoadingEnvironments = false;
                }
              },

              async detectEnvironmentFromUrl(accountNum) {
                try {
                  // Parse URL: /account/XXXX/record/{entitySlug}/list or /add or /edit/...
                  const pathParts = window.location.pathname.split('/');
                  const recordIdx = pathParts.indexOf('record');
                  if (recordIdx === -1 || recordIdx + 1 >= pathParts.length) return null;
                  
                  const entitySlug = pathParts[recordIdx + 1];
                  if (!entitySlug) return null;

                  const res = await fetch(`/account/${accountNum}/api/hierarchy/find-environment?entitySlug=${encodeURIComponent(entitySlug)}`);
                  if (!res.ok) return null;
                  const data = await res.json();
                  return data.success ? data.environmentId : null;
                } catch (err) {
                  console.error('[EnvironmentRail] detectEnvironmentFromUrl error:', err);
                  return null;
                }
              },

              selectEnvironment(env, skipSidebarToggle, showSpaces = true) {
                // If sidebar is closed, open it even when the active environment is clicked again.
                // (skip when called from modal save to avoid breaking modal reactivity)
                if (!skipSidebarToggle && Alpine.store('app').sidebar) {
                  Alpine.store('app').toggleSidebar();
                }
                if (showSpaces) {
                  window.dispatchEvent(new CustomEvent('show-spaces'));
                }
                if (this.activeEnvId === env.id) {
                  return; // Avoid redundant selections to prevent infinite loops
                }
                this.activeEnvId = env.id;
                window.dispatchEvent(new CustomEvent('environment-changed', {
                  detail: { environmentId: env.id, environment: env }
                }));
              },

              // ═══ Pure JS Context Menu (renders at body level) ═══
              _destroyPopup() {
                if (this._popupCloseHandler) {
                  document.removeEventListener('click', this._popupCloseHandler, true);
                  document.removeEventListener('contextmenu', this._popupCloseHandler, true);
                  this._popupCloseHandler = null;
                }
                if (this._activePopup) {
                  this._activePopup.remove();
                  this._activePopup = null;
                }
              },

              _showPopupMenu(x, y, items) {
                this._destroyPopup();

                const isDark = document.documentElement.classList.contains('dark') || document.body.classList.contains('dark');
                const menu = document.createElement('div');
                menu.style.cssText = `position:fixed; top:${y}px; left:${x}px; z-index:99999; min-width:208px; border-radius:12px; border:1px solid ${isDark ? '#374151' : '#e5e7eb'}; background:${isDark ? '#1b2e4b' : '#fff'}; box-shadow:0 10px 25px rgba(0,0,0,0.15); padding:6px 0;`;

                items.forEach(item => {
                  const btn = document.createElement('button');
                  btn.style.cssText = 'width:100%; display:flex; align-items:center; gap:12px; padding:10px 16px; font-size:14px; border:none; background:none; cursor:pointer; transition:all 0.2s ease;';
                  btn.style.color = item.danger ? '#ef4444' : (isDark ? '#d1d5db' : '#374151');
                  btn.innerHTML = `<iconify-icon icon="${item.icon}" width="18" style="color:${item.iconColor || 'inherit'}"></iconify-icon> ${item.label}`;
                  btn.addEventListener('mouseenter', () => {
                    if (!btn._confirming) {
                      btn.style.background = item.danger 
                        ? (isDark ? 'rgba(239,68,68,0.1)' : '#fef2f2')
                        : (isDark ? '#1f2937' : '#f3f4f6');
                    }
                  });
                  btn.addEventListener('mouseleave', () => { 
                    if (!btn._confirming) btn.style.background = 'none'; 
                  });
                  btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    e.preventDefault();
                    if (item.danger && item.confirm !== false) {
                      // Two-step inline confirmation for dangerous actions
                      if (!btn._confirming) {
                        btn._confirming = true;
                        btn.innerHTML = `<iconify-icon icon="solar:danger-triangle-bold-duotone" width="18" style="color:#ef4444"></iconify-icon> Confirmer ?`;
                        btn.style.background = isDark ? 'rgba(239,68,68,0.15)' : '#fef2f2';
                        btn.style.fontWeight = '600';
                        // Auto-reset after 3 seconds
                        btn._resetTimer = setTimeout(() => {
                          btn._confirming = false;
                          btn.innerHTML = `<iconify-icon icon="${item.icon}" width="18" style="color:${item.iconColor || 'inherit'}"></iconify-icon> ${item.label}`;
                          btn.style.background = 'none';
                          btn.style.fontWeight = 'normal';
                        }, 3000);
                        return;
                      }
                      // Second click = confirmed
                      clearTimeout(btn._resetTimer);
                    }
                    this._destroyPopup();
                    item.action();
                  });
                  menu.appendChild(btn);
                });

                document.body.appendChild(menu);
                this._activePopup = menu;

                // Close on any click outside or right-click anywhere
                const closeHandler = (evt) => {
                  if (!menu.contains(evt.target)) {
                    this._destroyPopup();
                  }
                };
                this._popupCloseHandler = closeHandler;
                // Use setTimeout to avoid the current event from immediately closing
                setTimeout(() => {
                  document.addEventListener('click', closeHandler, true);
                  document.addEventListener('contextmenu', closeHandler, true);
                }, 0);
              },

              showRailContextMenu(e) {
                // Don't show rail menu if right-clicking on an environment icon
                if (this._envCtxHandled) {
                  this._envCtxHandled = false;
                  return;
                }
                if (e.target.closest('.mini-rail-item')) return;
                e.stopPropagation();

                const self = this;
                this._showPopupMenu(e.clientX, e.clientY, [
                  {
                    icon: 'solar:add-circle-bold-duotone',
                    iconColor: 'var(--primary)',
                    label: 'Nouvel espace',
                    action: () => self.openCreateModal()
                  }
                ]);
              },

              showEnvContextMenu(e, env) {
                e.stopPropagation();
                this._envCtxHandled = true;

                const self = this;
                this._showPopupMenu(e.clientX, e.clientY, [
                  {
                    icon: 'solar:pen-new-square-bold-duotone',
                    iconColor: '#3b82f6',
                    label: 'Modifier',
                    action: () => self.openEditModal(env)
                  },
                  {
                    icon: 'solar:trash-bin-trash-bold-duotone',
                    iconColor: '#ef4444',
                    label: 'Supprimer',
                    danger: true,
                    action: () => self.deleteEnvironment(env)
                  }
                ]);
              },

              openCreateModal() {
                window.dispatchEvent(new CustomEvent('open-env-modal', { detail: { env: null } }));
              },

              openEditModal(env) {
                window.dispatchEvent(new CustomEvent('open-env-modal', { detail: { env } }));
              },

              async deleteEnvironment(env) {
                // Close context menu immediately (already closed by _showPopupMenu click handler)
                this._destroyPopup();
                console.log('[EnvironmentRail] Deleting environment:', env.name, env.id);
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/environment/delete`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: env.id })
                  });
                  const data = await res.json();
                  if (data.error) { alert(data.error); return; }
                  // Clear activeEnvId if we deleted the active one
                  const wasActive = this.activeEnvId === env.id;
                  if (wasActive) {
                    this.activeEnvId = null;
                  }
                  await this.refreshEnvironments({ force: true });
                  // If we deleted the active env, select the env that inherited the spaces
                  if (wasActive && this.environments.length > 0) {
                    const targetEnv = data.reassignedTo 
                      ? this.environments.find(e => e.id === data.reassignedTo) 
                      : null;
                    this.selectEnvironment(targetEnv || this.environments[0]);
                  }
                } catch (err) {
                  console.error('[EnvironmentRail] Delete error:', err);
                  alert('Erreur lors de la suppression');
                }
              },

              // ═══ Persist environment order to DB ═══
              async saveEnvOrder() {
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const items = this.environments.map((env, idx) => ({
                    id: env.id,
                    order: idx
                  }));
                  await fetch(`/account/${accountNum}/api/hierarchy/environment/reorder`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ items })
                  });
                } catch (err) {
                  console.error('[EnvironmentRail] saveEnvOrder error:', err);
                }
              },



              async promoteSpaceToEnvironment(spaceId) {
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/promote-space-to-environment`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ spaceId })
                  });
                  const data = await res.json();
                  if (!res.ok || data.error) {
                    alert(data.error || 'Erreur lors de la promotion');
                    return;
                  }

                  // Refresh both rail and sidebar
                  await this.refreshEnvironments();

                  // Select the newly created environment
                  const newEnv = this.environments.find(e => e.id === data.environment.id);
                  if (newEnv) {
                    this.selectEnvironment(newEnv);
                    this.$dispatch('show-spaces');
                  }

                  console.log('[EnvironmentRail] Space promoted successfully:', data.environment.name);
                } catch (err) {
                  console.error('[EnvironmentRail] promoteSpaceToEnvironment error:', err);
                  alert('Erreur lors de la promotion de la section en espace');
                }
              },

              async promoteFolderToEnvironment(folderId) {
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/promote-folder-to-environment`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ folderId })
                  });
                  const data = await res.json();
                  if (!res.ok || data.error) {
                    alert(data.error || 'Erreur lors de la promotion');
                    return;
                  }

                  // Refresh both rail and sidebar
                  await this.refreshEnvironments();

                  // Select the newly created environment
                  const newEnv = this.environments.find(e => e.id === data.environment.id);
                  if (newEnv) {
                    this.selectEnvironment(newEnv);
                    this.$dispatch('show-spaces');
                  }

                  console.log('[EnvironmentRail] Folder promoted successfully:', data.environment.name);
                } catch (err) {
                  console.error('[EnvironmentRail] promoteFolderToEnvironment error:', err);
                  alert('Erreur lors de la promotion du dossier en espace');
                }
              }
            };
          }
        </script>

