{
  "name": "saasnodetemplate",
  "version": "1.0.0",
  "description": "",
  "main": "generator.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "vite build --watch",
    "tailwind": "npx tailwindcss -i ./public/themes/default/assets/css/tailwind.css -o ./public/themes/default/assets/css/style.css",
    "tailwind:watch": "npx tailwindcss -i ./public/themes/default/assets/css/tailwind.css -o ./public/themes/default/assets/css/style.css --watch",
    "dev": "concurrently \"npm run server\" \"npm run client\" \"npm run tailwind:watch\"",
    "build": "vite build",
    "build:all": "npm run build && npm run tailwind",
    "build:css": "npm run tailwind",
    "build:watch": "vite build --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
