<!-- ═══ TEAM MODULE ═══ -->
<%- include('./ov-widget-team-styles') %>

<div x-data="recordTeam()" x-init="init()" @open-create-team.window="showCreateModal = true">
    <%- include('./ov-widget-team-content') %>
    <%- include('./ov-widget-team-modal') %>

    <!-- Toast -->
    <div x-show="toast" x-transition :style="'position:fixed;bottom:24px;right:24px;z-index:1000;padding:12px 20px;border-radius:12px;font-size:13px;font-weight:600;color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.15);background:' + (toastType === 'success' ? 'linear-gradient(135deg,#22c55e,#16a34a)' : 'linear-gradient(135deg,#ef4444,#dc2626)')" x-text="toast"></div>
</div>
