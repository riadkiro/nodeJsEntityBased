                                                    <div class="tp-divider"></div>
                                                    <div class="tp-options">
                                                        <template x-for="opt in filterMsOptions(col)" :key="opt.value">
                                                            <div class="tp-option"
                                                                 @click.stop="toggleMultiselectValue(getEditLines()[editModal.lineIdx], col.key, opt.value)">
                                                                <div class="tp-option-icon"
                                                                     :style="(getEditLines()[editModal.lineIdx].values[col.key] || []).includes(opt.value)
