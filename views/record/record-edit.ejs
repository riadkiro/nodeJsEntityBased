                                    <iconify-icon icon="tabler:plus" width="28"></iconify-icon>
                                </div>
                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest group-hover/add-box:text-primary transition-colors">Ajouter un champ</span>
                            </div>
                        `;
                    }
                    return currentTabFields.map((item, index) => this.renderFieldItemHTML(item, index)).join('');
                },

                getRelationFields() {
                    return this.layout
                        .filter(item => {
                            const field = this.fieldsById[item.fieldId];
                            return field && field.type === 'relation';
                        })
                        .map(item => ({
                            item: item,
                            field: this.fieldsById[item.fieldId]
                        }));
                },

                rebuildCanvas() {
                    const canvas = document.getElementById('fields-builder-canvas');
                    if (!canvas) return;

                    if (canvas._sortable) {
                        canvas._sortable.destroy();
                        canvas._sortable = null;
                    }

                    canvas.innerHTML = this.renderAllFields();

                    if (this.designMode) {
                        this.$nextTick(() => {
                            this.initSortables();
                        });
                    }

                    this.executeScripts();
                },

                initSortables() {
                    const builder = document.getElementById('fields-builder-canvas');
                    if (!builder || !this.designMode) return;

                    builder._sortable = new Sortable(builder, {
                        animation: 150,
                        ghostClass: 'sortable-ghost',
                        handle: '.group-handle-drag',
