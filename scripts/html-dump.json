                                            <iconify-icon icon=\"solar:folder-with-files-bold-duotone\" width=\"16\" style=\"color:#4361ee\"></iconify-icon> Choisir\n                                                </button>\n                                                <button type=\"button\" @click.stop=\"$refs.fileInput.click()\" style=\"background:#f1f5f9;border:1px dashed #cbd5e1;border-radius:6px;padding:6px 12px;font-size:12px;color:#475569;cursor:pointer;display:flex;align-items:center;gap:6px;transition:all 0.2s;\">\n                                                    <iconify-icon icon=\"solar:upload-minimalistic-bold-duotone\" width=\"16\" style=\"color:#10b981\"></iconify-icon> Uploader\n                                                </button>\n                                                <input type=\"file\" x-ref=\"fileInput\" @change=\"uploadFiles($event)\" style=\"display:none\" :multiple=\"type === 'gallery'\">\n                                            </div>\n                                        </div>\n                                        \n                                        <!-- Upload Progress -->\n                                        <div x-show=\"uploading\" style=\"padding: 8px 12px; background: rgb(248, 250, 252); border-top: 1px solid rgb(241, 245, 249); font-size: 12px; color: rgb(67, 97, 238); display: none; align-items: center; gap: 8px;\">\n                                            <iconify-icon icon=\"line-md:uploading-loop\" width=\"16\"></iconify-icon> Upload en cours... (<span x-text=\"uploadProgress\">0</span>%)\n                                        </div>\n\n                                        <!-- Drive Picker Dropdown -->\n                                        <div class=\"ov-rel-dropdown\" x-show=\"showDrivePicker\" style=\"max-height: 250px; overflow-y: auto; padding: 4px; border-top: 1px solid rgb(241, 245, 249); display: none;\">\n                                            <div style=\"padding:6px 8px;font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;display:flex;justify-content:space-between;align-items:center;\">\n                                                <span>Fichiers du dossier</span>\n                                                <button type=\"button\" @click.stop=\"showDrivePicker=false\" style=\"background:none;border:none;cursor:pointer;color:#94a3b8;\"><iconify-icon icon=\"solar:close-circle-bold\" width=\"14\"></iconify-icon></button>\n                                            </div>\n                                            <div x-show=\"loadingDrive\" style=\"padding: 12px; text-align: center; color: rgb(148, 163, 184); display: none;\"><iconify-icon icon=\"line-md:loading-twotone-loop\" width=\"24\"></iconify-icon></div>\n                                            <div x-show=\"!loadingDrive &amp;&amp; driveFiles.length === 0\" style=\"padding:12px;text-align:center;color:#94a3b8;font-size:12px;\">Aucun fichier</div>\n                                            <template x-for=\"df in driveFiles\" :key=\"df._id\">\n                                                <div class=\"ov-rel-option\" @click.stop=\"selectDriveFile(df)\" style=\"display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer;\">\n                                                    <template x-if=\"isImage(df.filename)\">\n                                                        <img :src=\"'/account/5096/uploads/attachments/' + df.filename\" style=\"width:24px;height:24px;object-fit:cover;border-radius:4px;\">\n                                                    </template>\n                                                    <template x-if=\"!isImage(df.filename)\">\n                                                        <div style=\"width:24px;height:24px;background:#f1f5f9;border-radius:4px;display:flex;align-items:center;justify-content:center;\">\n                                                            <iconify-icon icon=\"solar:document-bold-duotone\" width=\"14\" style=\"color:#64748b\"></iconify-icon>\n                                                        </div>\n                                                    </template>\n                                                    <span style=\"flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px;color:#334155;\" x-text=\"df.originalName || df.filename\"></span>\n                                                </div>\n                                            </template>\n                                        </div>\n                                    </div>\n                                </div>\n                            \n                        </div>\n                    </div>\n                    <!-- Required badge OR visibility toggle (config mode only) -->\n                    \n                        <button type=\"button\" class=\"fiche-vis-toggle\" @click.stop=\"toggleFieldVisibility('6a09ce5e28942d4bd6b06754')\" :title=\"isFieldHidden('6a09ce5e28942d4bd6b06754') ? 'Afficher' : 'Masquer'\" title=\"Masquer\">\n                            <iconify-icon :icon=\"isFieldHidden('6a09ce5e28942d4bd6b06754') ? 'solar:eye-closed-bold' : 'solar:eye-bold'\" width=\"16\" icon=\"solar:eye-bold\"></iconify-icon>\n                        </button>\n                    \n                "
