<!-- Modal -->
<div x-show="openModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50"
  style="display: none">
  <div class="bg-white rounded shadow p-6 w-[90%] max-w-5xl" @click.outside="openModal = false">
    <h3 class="text-lg font-bold mb-4">Ajouter un champ existant</h3>

    <!-- Liste des templates disponibles (3 par ligne) -->
    <div class="grid grid-cols-3 gap-4">
      <template x-for="template in allTemplates" :key="template._id">
        <div class="p-4 border rounded shadow hover:bg-gray-100 cursor-pointer" @click="addTemplateToSlot(template)">
          <div class="font-semibold text-gray-800" x-text="template.label"></div>
          <div class="text-sm text-gray-500 mt-1" x-text="template.type"></div>
        </div>
      </template>
    </div>
  </div>
</div>