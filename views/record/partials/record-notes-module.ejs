<div x-data="notesModule" x-cloak>
    <!-- Loading -->
    <div x-show="loading" style="text-align:center;padding:60px;">
        <iconify-icon icon="line-md:loading-twotone-loop" width="28" style="color:#8b5cf6"></iconify-icon>
        <p style="font-size:12px;color:#888da8;margin-top:8px;">Chargement des notes...</p>
    </div>

    <!-- ═══ MAIN LAYOUT ═══ -->
    <div x-show="!loading" class="notes-layout">

        <!-- ═══ LEFT SIDEBAR ═══ -->
        <div class="notes-sidebar" :class="{ 'mobile-hidden': activeNote && mobileEditing }">
            <!-- Header -->
            <div class="notes-sidebar-header">
                <div class="notes-sidebar-title">
                    <h3>
                        <iconify-icon icon="solar:notebook-bold-duotone" width="18" style="color:#8b5cf6"></iconify-icon>
                        Notes
                        <span class="notes-count" x-text="notes.length"></span>
                    </h3>
                    <button class="notes-create-btn" @click="showCreateModal = true">
                        <iconify-icon icon="solar:add-circle-bold" width="14"></iconify-icon>
                        Nouvelle
                    </button>
                </div>
                <!-- Search -->
                <div class="notes-search-wrap">
                    <iconify-icon icon="solar:magnifer-linear" width="14"></iconify-icon>
                    <input type="text" class="notes-search-input" placeholder="Rechercher une note..."
                           x-model="searchQuery">
                </div>
            </div>

            <!-- Note List -->
            <div class="notes-list" x-show="filteredNotes.length > 0">
                <!-- Pinned Section -->
                <template x-if="pinnedNotes.length > 0">
                    <div>
                        <div class="notes-list-section-title">
                            <iconify-icon icon="solar:pin-bold" width="10" style="color:#f59e0b"></iconify-icon>
                            Épinglées
                        </div>
                        <template x-for="note in pinnedNotes" :key="note._id">
                            <div class="note-list-item"
                                 :class="{ 'active': activeNote && activeNote._id === note._id }"
                                 @click="openNote(note)">
                                <div class="note-list-item-color" :style="'background:' + (note.color || '#8b5cf6')"></div>
                                <div class="note-list-item-body">
                                    <div class="note-list-item-title">
                                        <span x-text="note.title || 'Sans titre'"></span>
                                        <iconify-icon icon="solar:pin-bold" width="11" class="pin-icon"></iconify-icon>
                                        <iconify-icon x-show="note.isProtected" icon="solar:lock-password-bold" width="12" class="text-warning ml-1" title="Note sécurisée" style="color: #f59e0b;"></iconify-icon>
                                    </div>
                                    <div class="note-list-item-preview">
                                        <template x-if="note.isProtected && !isNoteContentUnlocked(note)">
                                            <span style="font-style:italic; opacity:0.7;">Contenu masqué...</span>
                                        </template>
                                        <template x-if="!note.isProtected || isNoteContentUnlocked(note)">
                                            <span x-text="getPreviewText(note.content)"></span>
                                        </template>
                                    </div>
                                    <div class="note-list-item-meta">
                                        <iconify-icon icon="solar:calendar-linear" width="10"></iconify-icon>
                                        <span x-text="formatDate(note.updatedAt)"></span>
                                    </div>
                                </div>
                                <div class="note-list-item-actions" @click.stop>
                                    <button @click="togglePin(note)" title="Désépingler">
                                        <iconify-icon icon="solar:pin-bold" width="12"></iconify-icon>
                                    </button>
                                    <button class="delete-btn" @click="deleteNote(note)" title="Supprimer">
                                        <iconify-icon icon="solar:trash-bin-trash-bold" width="12"></iconify-icon>
                                    </button>
                                </div>
                            </div>
                        </template>
                    </div>
                </template>

                <!-- All Notes Section -->
                <template x-if="unpinnedNotes.length > 0">
                    <div>
                        <div class="notes-list-section-title" x-show="pinnedNotes.length > 0">
                            <iconify-icon icon="solar:notebook-linear" width="10"></iconify-icon>
                            Autres notes
                        </div>
                        <template x-for="note in unpinnedNotes" :key="note._id">
                            <div class="note-list-item"
                                 :class="{ 'active': activeNote && activeNote._id === note._id }"
                                 @click="openNote(note)">
                                <div class="note-list-item-color" :style="'background:' + (note.color || '#8b5cf6')"></div>
                                <div class="note-list-item-body">
                                    <div class="note-list-item-title">
                                        <span x-text="note.title || 'Sans titre'"></span>
                                        <iconify-icon x-show="note.isProtected" icon="solar:lock-password-bold" width="12" class="text-warning ml-1" title="Note sécurisée" style="color: #f59e0b;"></iconify-icon>
                                    </div>
                                    <div class="note-list-item-preview">
                                        <template x-if="note.isProtected && !isNoteContentUnlocked(note)">
                                            <span style="font-style:italic; opacity:0.7;">Contenu masqué...</span>
                                        </template>
                                        <template x-if="!note.isProtected || isNoteContentUnlocked(note)">
                                            <span x-text="getPreviewText(note.content)"></span>
                                        </template>
                                    </div>
                                    <div class="note-list-item-meta">
                                        <iconify-icon icon="solar:calendar-linear" width="10"></iconify-icon>
                                        <span x-text="formatDate(note.updatedAt)"></span>
                                    </div>
                                </div>
                                <div class="note-list-item-actions" @click.stop>
                                    <button @click="togglePin(note)" title="Épingler">
                                        <iconify-icon icon="solar:pin-linear" width="12"></iconify-icon>
                                    </button>
                                    <button class="delete-btn" @click="deleteNote(note)" title="Supprimer">
                                        <iconify-icon icon="solar:trash-bin-trash-bold" width="12"></iconify-icon>
                                    </button>
                                </div>
                            </div>
                        </template>
                    </div>
                </template>
            </div>

            <!-- No notes / No search results -->
            <div x-show="filteredNotes.length === 0" class="notes-sidebar-empty">
                <template x-if="notes.length === 0 && !searchQuery">
                    <div style="text-align:center;">
                        <iconify-icon icon="solar:notebook-bold-duotone" width="40" style="opacity:.2;color:#8b5cf6"></iconify-icon>
                        <h4>Aucune note</h4>
                        <p>Créez votre première note pour commencer</p>
                    </div>
                </template>
                <template x-if="notes.length > 0 && searchQuery && filteredNotes.length === 0">
                    <div style="text-align:center;">
                        <iconify-icon icon="solar:magnifer-zoom-in-linear" width="32" style="opacity:.2"></iconify-icon>
                        <h4>Aucun résultat</h4>
                        <p>Aucune note ne correspond à votre recherche</p>
                    </div>
                </template>
            </div>
        </div>

        <!-- ═══ RIGHT EDITOR PANEL ═══ -->
        <div class="notes-editor-panel">
            <!-- Empty state: no note selected -->
            <div x-show="!activeNote" class="notes-editor-empty">
                <iconify-icon icon="solar:document-text-bold-duotone" width="56" style="opacity:.15;color:#8b5cf6"></iconify-icon>
                <h3>Sélectionnez une note</h3>
                <p>Choisissez une note dans la liste à gauche ou créez-en une nouvelle pour commencer à écrire</p>
                <button class="notes-create-btn" style="margin-top:12px;" @click="showCreateModal = true">
                    <iconify-icon icon="solar:add-circle-bold" width="14"></iconify-icon>
                    Créer une note
                </button>
            </div>

            <!-- Editor: note selected -->
            <template x-if="activeNote">
                <div style="display:flex;flex-direction:column;height:100%;">
                    <!-- Topbar -->
                    <div class="ne-topbar">
                        <!-- Mobile back button -->
                        <button class="ne-topbar-btn ne-mobile-back" @click="mobileBack()" style="display:none;">
                            <iconify-icon icon="solar:arrow-left-linear" width="16"></iconify-icon>
                        </button>
                        <input type="text" class="ne-title-input"
                               :value="activeNote.title"
                               @input="activeNote.title = $event.target.value; scheduleAutosave('title');"
                               placeholder="Titre de la note...">
                        <div class="ne-save-status" :class="saveStatus">
                            <template x-if="saveStatus === 'saving'">
                                <span><iconify-icon icon="line-md:loading-twotone-loop" width="12"></iconify-icon> Sauvegarde...</span>
                            </template>
                            <template x-if="saveStatus === 'saved'">
                                <span><iconify-icon icon="solar:check-circle-bold" width="12"></iconify-icon> Sauvegardé</span>
                            </template>
                        </div>
                        <div class="ne-topbar-actions" style="display:flex;align-items:center;gap:4px;">
                            <button class="ne-topbar-btn" :class="{ 'pin-active': activeNote.pinned }"
                                    @click="togglePinActive()" :title="activeNote.pinned ? 'Désépingler' : 'Épingler'">
                                <iconify-icon :icon="activeNote.pinned ? 'solar:pin-bold' : 'solar:pin-linear'" width="14"></iconify-icon>
                            </button>

                            <button class="ne-topbar-btn" :class="{ 'pin-active text-warning': activeNote.isProtected }"
                                    @click="toggleProtection()" :title="activeNote.isProtected ? 'Désécuriser la note (PIN requis)' : 'Sécuriser avec PIN'">
                                <iconify-icon :icon="activeNote.isProtected ? 'solar:lock-password-bold' : 'solar:lock-password-linear'" width="14" :style="activeNote.isProtected ? 'color: #f59e0b;' : ''"></iconify-icon>
                            </button>

                            <!-- Note Color Picker — rond coloré à côté de l'épingle -->
                            <div class="ne-toolbar-dropdown" @click.away="showNoteColorMenu = false" style="display:inline-flex;align-items:center;">
                                <button @click.prevent="showNoteColorMenu = !showNoteColorMenu" title="Couleur de la note"
                                        style="width:20px;height:20px;padding:0;border:none;background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;border-radius:50%;flex-shrink:0;">
                                    <span :style="{
                                              display: 'block',
                                              width: '13px',
                                              height: '13px',
                                              borderRadius: '50%',
                                              background: activeNote.color || '#8b5cf6',
                                              transition: 'transform .15s',
                                              flexShrink: '0'
                                          }"
                                          onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'"></span>
                                </button>
                                <div class="ne-toolbar-dropdown-menu" x-show="showNoteColorMenu" x-transition
                                     style="min-width:max-content; padding:10px 12px; right:0; left:auto; z-index:1050;">
                                    <div style="display:flex;gap:7px;align-items:center;flex-wrap:nowrap;">
                                        <template x-for="c in colorOptions" :key="c">
                                            <span class="note-color-picker-dot"
                                                  :class="((activeNote.color || '#8b5cf6') === c) ? 'active' : ''"
                                                  :style="'background:' + c + ';color:' + c"
                                                  @click="updateNoteColor(c); showNoteColorMenu = false"
                                                  :title="c"></span>
                                        </template>
                                    </div>
                                </div>
                            </div>

                            <button class="ne-topbar-btn delete-btn" @click="deleteActiveNote()" title="Supprimer">
                                <iconify-icon icon="solar:trash-bin-trash-bold" width="14"></iconify-icon>
                            </button>
                        </div>
                    </div>

                    <!-- Toolbar -->
                    <div class="ne-toolbar">
                        <!-- Format Block Dropdown -->
                        <div class="ne-toolbar-dropdown" @click.away="showFormatMenu = false">
                            <button class="ne-toolbar-dropdown-btn" @mousedown.prevent="showFormatMenu = !showFormatMenu" title="Format du texte">
                                <span x-text="formatLabel"></span>
                                <iconify-icon icon="solar:alt-arrow-down-linear" width="12"></iconify-icon>
                            </button>
                            <div class="ne-toolbar-dropdown-menu" x-show="showFormatMenu" x-transition @click="showFormatMenu = false">
                                <button @mousedown.prevent="setFormat('div')" :class="{ 'active': activeFormats.formatBlock === 'div' || activeFormats.formatBlock === '' }">
                                    <span style="font-size:13px;">Paragraphe</span>
                                </button>
                                <button @mousedown.prevent="setFormat('h1')" :class="{ 'active': activeFormats.formatBlock === 'h1' }">
                                    <span style="font-size:18px;font-weight:800;">Titre 1</span>
                                </button>
                                <button @mousedown.prevent="setFormat('h2')" :class="{ 'active': activeFormats.formatBlock === 'h2' }">
                                    <span style="font-size:16px;font-weight:700;">Titre 2</span>
                                </button>
                                <button @mousedown.prevent="setFormat('h3')" :class="{ 'active': activeFormats.formatBlock === 'h3' }">
                                    <span style="font-size:14px;font-weight:600;">Titre 3</span>
                                </button>
                            </div>
                        </div>
                        <div class="sep"></div>

                        <!-- Font Size Dropdown -->
                        <div class="ne-toolbar-dropdown" @click.away="showSizeMenu = false">
                            <button class="ne-toolbar-dropdown-btn" @mousedown.prevent="showSizeMenu = !showSizeMenu" title="Taille du texte">
                                <iconify-icon icon="solar:text-field-bold-duotone" width="14"></iconify-icon>
                                <span x-text="sizeLabel"></span>
                                <iconify-icon icon="solar:alt-arrow-down-linear" width="12"></iconify-icon>
                            </button>
                            <div class="ne-toolbar-dropdown-menu" x-show="showSizeMenu" x-transition @click="showSizeMenu = false">
                                <button @mousedown.prevent="setFontSize(1)" :class="{ 'active': activeFormats.fontSize === '1' }">
                                    <span style="font-size:11px;">Petit</span>
                                </button>
                                <button @mousedown.prevent="setFontSize(3)" :class="{ 'active': activeFormats.fontSize === '3' || activeFormats.fontSize === '' }">
                                    <span style="font-size:13px;">Normal</span>
                                </button>
                                <button @mousedown.prevent="setFontSize(5)" :class="{ 'active': activeFormats.fontSize === '5' }">
                                    <span style="font-size:16px;">Grand</span>
                                </button>
                                <button @mousedown.prevent="setFontSize(7)" :class="{ 'active': activeFormats.fontSize === '7' }">
                                    <span style="font-size:20px;">Très grand</span>
                                </button>
                            </div>
                        </div>
                        <div class="sep"></div>

                        <!-- Typography -->
                        <button @mousedown.prevent="exec('bold')" :class="{ 'active': activeFormats.bold }" title="Gras (Ctrl+B)"><b>B</b></button>
                        <button @mousedown.prevent="exec('italic')" :class="{ 'active': activeFormats.italic }" title="Italique (Ctrl+I)"><i>I</i></button>
                        <button @mousedown.prevent="exec('underline')" :class="{ 'active': activeFormats.underline }" title="Souligné (Ctrl+U)"><u>U</u></button>
                        <button @mousedown.prevent="exec('strikeThrough')" :class="{ 'active': activeFormats.strikeThrough }" title="Barré"><s>S</s></button>
                        <div class="sep"></div>
                        
                        <!-- Alignment -->
                        <button @mousedown.prevent="exec('justifyLeft')" :class="{ 'active': activeFormats.justifyLeft }" title="Aligner à gauche">
                            <iconify-icon icon="solar:align-left-bold-duotone" width="16"></iconify-icon>
                        </button>
                        <button @mousedown.prevent="exec('justifyCenter')" :class="{ 'active': activeFormats.justifyCenter }" title="Centrer">
                            <iconify-icon icon="solar:align-horizonta-spacing-bold-duotone" width="16"></iconify-icon>
                        </button>
                        <button @mousedown.prevent="exec('justifyRight')" :class="{ 'active': activeFormats.justifyRight }" title="Aligner à droite">
                            <iconify-icon icon="solar:align-right-bold-duotone" width="16"></iconify-icon>
                        </button>
                        <div class="sep"></div>

                        <!-- Lists -->
                        <button @mousedown.prevent="exec('insertUnorderedList')" :class="{ 'active': activeFormats.insertUnorderedList }" title="Liste à puces">
                            <iconify-icon icon="solar:list-bold-duotone" width="16"></iconify-icon>
                        </button>
                        <button @mousedown.prevent="exec('insertOrderedList')" :class="{ 'active': activeFormats.insertOrderedList }" title="Liste numérotée">
                            <iconify-icon icon="solar:list-check-bold-duotone" width="16"></iconify-icon>
                        </button>
                        <div class="sep"></div>
                        
                        <!-- Quote & Checklist -->
                        <button @mousedown.prevent="exec('formatBlock','<blockquote>')" :class="{ 'active': activeFormats.blockquote }" title="Citation">
                            <iconify-icon icon="solar:chat-square-like-bold-duotone" width="16"></iconify-icon>
                        </button>
                        <button @mousedown.prevent="insertCheckbox()" title="Checklist">
                            <iconify-icon icon="solar:checklist-minimalistic-bold-duotone" width="16"></iconify-icon>
                        </button>
                        <div class="sep"></div>

                        <!-- Insert Link -->
                        <button @mousedown.prevent="openLinkModal()" title="Insérer un lien">
                            <iconify-icon icon="solar:link-round-bold-duotone" width="16"></iconify-icon>
                        </button>
                        <!-- Insert Image (universal picker) -->
                        <button @mousedown.prevent="insertImageFromPicker()" title="Insérer une image">
                            <iconify-icon icon="solar:gallery-bold-duotone" width="16"></iconify-icon>
                        </button>
                        <div class="sep"></div>
                        
                        <!-- Clear format -->
                        <button @mousedown.prevent="clearFormatting()" title="Effacer formatage">
                            <iconify-icon icon="solar:eraser-bold-duotone" width="16"></iconify-icon>
                        </button>
                        <div class="sep"></div>
                        
                        <!-- Highlight Color Picker -->
                        <div class="ne-toolbar-dropdown" @click.away="showColorMenu = false">
                            <button @mousedown.prevent="showColorMenu = !showColorMenu" title="Surlignage" style="width: 32px; height: 32px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative;">
                                <iconify-icon icon="solar:pen-2-bold-duotone" width="16" style="color: #64748b;"></iconify-icon>
                                <span x-ref="highlightIndicator" style="position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); display: inline-block; width: 14px; height: 3px; border-radius: 1px; background: #fef08a; box-shadow: 0 0 1px rgba(0,0,0,0.2);"></span>
                            </button>
                            <div class="ne-toolbar-dropdown-menu" x-show="showColorMenu" x-transition @click="showColorMenu = false" style="min-width: max-content; padding: 10px 14px; z-index: 1050; left: 50%; transform: translateX(-50%);">
                                <div style="display: flex; gap: 8px; justify-content: center; align-items: center; flex-wrap: nowrap;">
                                    <span class="note-color-picker-dot" style="background:#fef08a;color:#fef08a;" @mousedown.prevent="highlight('#fef08a'); $refs.highlightIndicator.style.background = '#fef08a'" title="Jaune"></span>
                                    <span class="note-color-picker-dot" style="background:#bbf7d0;color:#bbf7d0;" @mousedown.prevent="highlight('#bbf7d0'); $refs.highlightIndicator.style.background = '#bbf7d0'" title="Vert"></span>
                                    <span class="note-color-picker-dot" style="background:#bfdbfe;color:#bfdbfe;" @mousedown.prevent="highlight('#bfdbfe'); $refs.highlightIndicator.style.background = '#bfdbfe'" title="Bleu"></span>
                                    <span class="note-color-picker-dot" style="background:#fecaca;color:#fecaca;" @mousedown.prevent="highlight('#fecaca'); $refs.highlightIndicator.style.background = '#fecaca'" title="Rouge"></span>
                                    <span class="note-color-picker-dot" style="background:#e9d5ff;color:#e9d5ff;" @mousedown.prevent="highlight('#e9d5ff'); $refs.highlightIndicator.style.background = '#e9d5ff'" title="Violet"></span>
                                    <span class="note-color-picker-dot" @mousedown.prevent="highlight('transparent'); $refs.highlightIndicator.style.background = 'transparent'" title="Effacer" style="border:1px solid #ccc;background:transparent;display:flex;align-items:center;justify-content:center;color:#ef4444;">
                                        <iconify-icon icon="solar:close-circle-bold" width="14"></iconify-icon>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="ne-content" contenteditable="true" x-ref="editorContent"
                         x-init="hydrateMountedEditor($el)"
                         data-placeholder="Commencez à écrire..."
                         @input="scheduleAutosave('content')"
                         @keyup="updateFormats()"
                         @mouseup="updateFormats()"
                         @click="handleContentClick($event)"
                         @keydown.enter="handleEditorEnter($event)"
                         @keydown.backspace="handleEditorBackspace($event)"></div>

                    <!-- Image Floating Toolbar -->
                    <div class="ne-image-toolbar" x-show="selectedImage" x-ref="imageToolbar"
                         x-transition
                         :style="imageToolbarStyle"
                         @click.outside="selectedImage = null">
                        <button @click="resizeImage('25%')" :class="{ 'active': selectedImageSize === '25%' }">25%</button>
                        <button @click="resizeImage('50%')" :class="{ 'active': selectedImageSize === '50%' }">50%</button>
                        <button @click="resizeImage('75%')" :class="{ 'active': selectedImageSize === '75%' }">75%</button>
                        <button @click="resizeImage('100%')" :class="{ 'active': selectedImageSize === '100%' }">100%</button>
                        <div class="sep"></div>
                        <button class="delete-btn" @click="deleteImage()">
                            <iconify-icon icon="solar:trash-bin-trash-bold" width="14"></iconify-icon>
                        </button>
                    </div>
                </div>
            </template>
        </div>
    </div>

    <!-- ═══ LINK MODAL ═══ -->
    <template x-if="showLinkModal">
        <div class="ne-inline-modal-overlay" @click.self="showLinkModal = false">
            <div class="ne-inline-modal">
                <div class="ne-inline-modal-header">
                    <iconify-icon icon="solar:link-round-bold-duotone" width="18" style="color:#8b5cf6"></iconify-icon>
                    Insérer un lien
                </div>
                <div class="ne-inline-modal-body">
                    <label>Texte du lien</label>
                    <input type="text" x-model="linkText" placeholder="Texte à afficher..." x-ref="linkTextInput">
                    <label>URL</label>
                    <input type="url" x-model="linkUrl" placeholder="https://..." @keydown.enter="insertLink()">
                </div>
                <div class="ne-inline-modal-footer">
                    <button class="btn-cancel" @click="showLinkModal = false">Annuler</button>
                    <button class="btn-insert" @click="insertLink()">Insérer</button>
                </div>
            </div>
        </div>
    </template>

    <!-- ═══ PIN MODAL ═══ -->
    <template x-if="showPinModal">
        <div class="note-modal-overlay" @click.self="cancelPinModal()">
            <div class="note-modal" style="max-width: 400px;">
                <div class="note-modal-header">
                    <h3>
                        <iconify-icon icon="solar:lock-password-bold-duotone" width="18" class="text-warning" style="color: #f59e0b;"></iconify-icon>
                        Note sécurisée
                    </h3>
                </div>
                <div class="note-modal-body text-center">
                    <p class="text-sm text-gray-500 mb-4">
                        <span x-show="pendingProtectToggle && (!activeNote || !activeNote.isProtected)">Veuillez saisir votre code PIN pour sécuriser cette note.</span>
                        <span x-show="!(pendingProtectToggle && (!activeNote || !activeNote.isProtected))">Veuillez saisir votre code PIN pour accéder à cette note.</span>
                    </p>
                    <input type="password" x-ref="pinInputRef" x-model="pinInput" maxlength="4" pattern="[0-9]*"
                           placeholder="••••" class="form-input text-center tracking-widest text-2xl font-mono mx-auto w-32"
                           @keydown.enter="verifyPin()" :disabled="isPinVerifying">
                    
                    <template x-if="pinError">
                        <p class="text-danger text-sm mt-3" x-text="pinError"></p>
                    </template>
                </div>
                <div class="note-modal-footer">
                    <button class="btn-cancel" @click="cancelPinModal()" :disabled="isPinVerifying">Annuler</button>
                    <button class="btn-create" style="background:#f59e0b;border-color:#f59e0b;" @click="verifyPin()" :disabled="isPinVerifying || pinInput.length !== 4">
                        <span x-show="isPinVerifying" class="animate-spin border-2 border-white border-l-transparent rounded-full w-4 h-4 inline-block mr-2" style="vertical-align: middle;"></span>
                        Valider
                    </button>
                </div>
            </div>
        </div>
    </template>

    <!-- ═══ CREATE MODAL ═══ -->
    <template x-if="showCreateModal">
        <div class="note-modal-overlay" @click.self="showCreateModal = false">
            <div class="note-modal">
                <div class="note-modal-header">
                    <h3>
                        <iconify-icon icon="solar:notebook-bold-duotone" width="18" style="color:#8b5cf6"></iconify-icon>
                        Nouvelle note
                    </h3>
                </div>
                <div class="note-modal-body">
                    <label>Titre</label>
                    <input type="text" x-model="newTitle" placeholder="Ex: Observation clinique..."
                           @keydown.enter="createNote()" x-ref="newTitleInput">
                    <label style="margin-top:16px">Couleur</label>
                    <div class="note-colors">
                        <template x-for="c in colorOptions" :key="c">
                            <div class="note-color-dot" :class="newColor === c ? 'active' : ''"
                                 :style="'background:' + c + ';color:' + c"
                                 @click="newColor = c"></div>
                        </template>
                    </div>
                </div>
                <div class="note-modal-footer">
                    <button class="btn-cancel" @click="showCreateModal = false">Annuler</button>
                    <button class="btn-create" @click="createNote()">
                        <iconify-icon icon="solar:add-circle-bold" width="14"></iconify-icon>
                        Créer
                    </button>
                </div>
            </div>
        </div>
    </template>
</div>

<script>
document.addEventListener('alpine:init', () => {
    const _accountNumber = '<%= account_number %>';
    const _recordId = '<%= record._id %>';
    const _apiBase = '/account/' + _accountNumber + '/api/record/' + _recordId + '/notes';

    Alpine.data('notesModule', () => ({
        notes: [],
        loading: true,
        activeNote: null,
        editorNoteId: null,
        isHydratingEditor: false,
        contentDirtyNoteId: null,
        showCreateModal: false,
        showPinModal: false,
        pinInput: '',
        pinError: '',
        isPinVerifying: false,
        pendingNoteToOpen: null,
        pendingProtectToggle: false,
        unlockedNoteIds: {},
        newTitle: '',
        newColor: '#8b5cf6',
        saveStatus: '',
        autosaveTimer: null,
        searchQuery: '',
        mobileEditing: false,
        colorOptions: ['#8b5cf6','#3b82f6','#10b981','#f59e0b','#ef4444','#ec4899','#14b8a6','#6366f1','#f97316','#64748b'],
        activeFormats: {
            bold: false, italic: false, underline: false, strikeThrough: false,
            justifyLeft: false, justifyCenter: false, justifyRight: false,
            insertUnorderedList: false, insertOrderedList: false,
            formatBlock: '', fontSize: '',
            blockquote: false
        },
        showFormatMenu: false,
        showSizeMenu: false,
        showColorMenu: false,
        showNoteColorMenu: false,
        showLinkModal: false,
        linkText: '',
        linkUrl: '',
        savedSelection: null,
        selectedImage: null,
        selectedImageSize: '',
        imageToolbarStyle: '',

        async init() {
            await this.loadNotes();
            this.openInitialNoteFromUrl();
            // Auto-focus the create modal input when shown
            this.$watch('showCreateModal', (val) => {
                if (val) {
                    this.$nextTick(() => {
                        const input = this.$refs.newTitleInput;
                        if (input) input.focus();
                    });
                }
            });
            
            // Listen to global selection changes to update formats when navigating with keyboard
            document.addEventListener('selectionchange', () => {
                if (document.activeElement === this.$refs.editorContent) {
                    this.updateFormats();
                }
            });
        },

        // ── Computed-like getters ──
        get filteredNotes() {
            const q = this.searchQuery.toLowerCase().trim();
            if (!q) return this.notes;
            return this.notes.filter(n => {
                const title = (n.title || '').toLowerCase();
                const content = this.getPreviewText(n.content).toLowerCase();
                return title.includes(q) || content.includes(q);
            });
        },

        get pinnedNotes() {
            return this.filteredNotes.filter(n => n.pinned);
        },

        get unpinnedNotes() {
            return this.filteredNotes.filter(n => !n.pinned);
        },

        // ── API ──
        isNoteContentUnlocked(note) {
            if (!note || !note.isProtected) return true;
            return !!(note._unlocked || this.unlockedNoteIds[note._id]);
        },

        noteSavePayload(note, content, includeContent = true) {
            const payload = { title: note.title };
            if (includeContent && this.isNoteContentUnlocked(note)) {
                payload.content = content;
                payload.editorNoteId = this.editorNoteId;
                if (note.isProtected) {
                    payload.contentEditToken = note._contentEditToken || '';
                    payload.contentBaseHash = note._contentHash || '';
                }
            }
            return payload;
        },

        syncSavedNoteMeta(noteId, savedNote) {
            if (!savedNote) return;
            const activeSame = !!(this.activeNote && String(this.activeNote._id) === String(noteId));
            const idx = this.notes.findIndex(n => String(n._id) === String(noteId));
            if (idx !== -1) {
                const isProtected = !!(savedNote.isProtected || this.notes[idx].isProtected);
                const canExposeContent = !isProtected || activeSame;
                this.notes[idx] = {
                    ...this.notes[idx],
                    _contentHash: canExposeContent ? (savedNote._contentHash || this.notes[idx]._contentHash) : undefined,
                    _contentEditToken: canExposeContent ? (savedNote._contentEditToken || this.notes[idx]._contentEditToken) : undefined,
                    contentLocked: isProtected && !canExposeContent ? true : savedNote.contentLocked,
                    ...(canExposeContent && savedNote.content !== undefined && savedNote.content !== null ? { content: savedNote.content } : {}),
                    ...(isProtected && !canExposeContent ? { content: null, _unlocked: false, _contentRedacted: true } : {})
                };
            }
            if (activeSame) {
                this.activeNote._contentHash = savedNote._contentHash || this.activeNote._contentHash;
                this.activeNote._contentEditToken = savedNote._contentEditToken || this.activeNote._contentEditToken;
                this.activeNote.contentLocked = savedNote.contentLocked;
                if (savedNote.content !== undefined && savedNote.content !== null) {
                    this.activeNote.content = savedNote.content;
                }
            }
        },

        canSaveActiveContent(noteId) {
            if (!this.activeNote || String(this.activeNote._id) !== String(noteId)) return false;
            if (!this.isNoteContentUnlocked(this.activeNote)) return false;
            if (!this.getEditorEl()) return false;
            return String(this.editorNoteId || '') === String(noteId);
        },

        getEditorEl() {
            return this.$refs.editorContent || document.querySelector('.ne-content[contenteditable="true"]');
        },

        hydrateMountedEditor(el) {
            if (!this.activeNote || !el) return;
            const noteId = String(this.activeNote._id);
            const html = this.isNoteContentUnlocked(this.activeNote) ? (this.activeNote.content || '') : '';
            this.isHydratingEditor = true;
            requestAnimationFrame(() => {
                if (!this.activeNote || String(this.activeNote._id) !== noteId || !el.isConnected) {
                    this.isHydratingEditor = false;
                    return;
                }
                el.innerHTML = html;
                this.editorNoteId = noteId;
                this.isHydratingEditor = false;
                this.updateFormats();
            });
        },

        showNoteInEditor(note) {
            this.activeNote = JSON.parse(JSON.stringify(note));
            this.mobileEditing = true;
            this.saveStatus = '';
            this.editorNoteId = null;
            if (String(this.contentDirtyNoteId || '') !== String(note._id)) {
                this.contentDirtyNoteId = null;
            }
            this.isHydratingEditor = true;
            const noteId = String(note._id);
            const html = this.isNoteContentUnlocked(note) ? (note.content || '') : '';
            this.hydrateEditorContent(noteId, html);
        },

        hydrateEditorContent(noteId, html, attempt = 0) {
            this.$nextTick(() => {
                const el = this.getEditorEl();
                if (el && this.activeNote && String(this.activeNote._id) === String(noteId)) {
                    el.innerHTML = html;
                    this.editorNoteId = String(noteId);
                    this.isHydratingEditor = false;
                    el.focus();
                    this.updateFormats();
                    return;
                }

                if (attempt < 12 && this.activeNote && String(this.activeNote._id) === String(noteId)) {
                    requestAnimationFrame(() => this.hydrateEditorContent(noteId, html, attempt + 1));
                    return;
                }

                this.isHydratingEditor = false;
            });
        },

        markNoteUnlocked(note) {
            if (!note || !note._id) return;
            this.unlockedNoteIds = { ...this.unlockedNoteIds, [note._id]: true };
            note._unlocked = true;
            note._contentRedacted = false;
        },

        forgetNoteUnlocked(noteId) {
            if (!noteId) return;
            const next = { ...this.unlockedNoteIds };
            delete next[noteId];
            this.unlockedNoteIds = next;
        },

        lockProtectedNote(noteId) {
            if (!noteId) return;
            this.forgetNoteUnlocked(noteId);
            const idx = this.notes.findIndex(n => String(n._id) === String(noteId));
            if (idx !== -1 && this.notes[idx].isProtected) {
                this.notes[idx] = {
                    ...this.notes[idx],
                    content: null,
                    contentLocked: true,
                    _unlocked: false,
                    _contentRedacted: true,
                    _contentHash: undefined,
                    _contentEditToken: undefined
                };
            }
        },

        async loadNotes() {
            this.loading = true;
            try {
                const res = await fetch(_apiBase, { credentials: 'include' });
                const data = await res.json();
                if (data.success) {
                    this.notes = (data.notes || []).map(note => ({
                        ...note,
                        _contentRedacted: !!note.isProtected && note.content == null
                    }));
                }
            } catch (e) { console.error('[Notes] Load error:', e); }
            this.loading = false;
        },

        async createNote() {
            const title = this.newTitle.trim() || 'Sans titre';
            try {
                const res = await fetch(_apiBase, {
                    method: 'POST', credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, color: this.newColor })
                });
                const data = await res.json();
                if (data.success) {
                    this.notes.unshift(data.note);
                    this.showCreateModal = false;
                    this.newTitle = '';
                    this.newColor = '#8b5cf6';
                    this.openNote(data.note);
                }
            } catch (e) { console.error('[Notes] Create error:', e); }
        },

        openInitialNoteFromUrl() {
            try {
                const params = new URLSearchParams(window.location.search);
                const noteId = params.get('noteId');
                if (!noteId) return;
                const note = this.notes.find(n => String(n._id) === String(noteId));
                if (note) this.openNote(note);
            } catch (e) {
                console.warn('[Notes] Initial note open skipped:', e);
            }
        },

        openNote(note) {
            // Save the currently displayed note before any lock modal can interrupt the switch.
            if (this.activeNote && String(this.activeNote._id) !== String(note._id)) {
                const previousNoteId = this.activeNote._id;
                const shouldRelockPrevious = !!this.activeNote.isProtected;
                this.saveCurrentNote();
                if (shouldRelockPrevious) this.lockProtectedNote(previousNoteId);
            }

            // Check protection FIRST
            if (note.isProtected && !this.isNoteContentUnlocked(note)) {
                this.pendingNoteToOpen = note;
                this.pinInput = '';
                this.pinError = '';
                this.showPinModal = true;
                this.$nextTick(() => {
                    if (this.$refs.pinInputRef) this.$refs.pinInputRef.focus();
                });
                return;
            }

            this.showNoteInEditor(note);
        },

        saveCurrentNote() {
            if (!this.activeNote) return;
            clearTimeout(this.autosaveTimer);
            const el = this.$refs.editorContent;
            const content = el ? el.innerHTML : '';
            const noteId = this.activeNote._id;
            const title = this.activeNote.title;
            const canSaveContent = this.canSaveActiveContent(noteId) && String(this.contentDirtyNoteId || '') === String(noteId);

            // Update local array
            const idx = this.notes.findIndex(n => n._id === noteId);
            if (idx !== -1) {
                this.notes[idx].title = title;
                if (canSaveContent) {
                    this.notes[idx].content = content;
                    this.notes[idx]._contentRedacted = false;
                }
                this.notes[idx].updatedAt = new Date().toISOString();
            }

            // Fire and forget save
            fetch(_apiBase + '/' + noteId, {
                method: 'PUT', credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(this.noteSavePayload(this.activeNote, content, canSaveContent))
            })
                .then(res => res.json().catch(() => null))
                .then(data => {
                    if (data?.success) this.syncSavedNoteMeta(noteId, data.note);
                })
                .catch(e => console.error('[Notes] Save error:', e));
        },

        mobileBack() {
            this.saveCurrentNote();
            if (this.activeNote && this.activeNote.isProtected) this.lockProtectedNote(this.activeNote._id);
            this.activeNote = null;
            this.editorNoteId = null;
            this.contentDirtyNoteId = null;
            this.mobileEditing = false;
            this.saveStatus = '';
        },

        scheduleAutosave(source = 'content') {
            if (this.isHydratingEditor) return;
            if (source === 'content') {
                if (!this.activeNote || !this.canSaveActiveContent(this.activeNote._id)) return;
                this.contentDirtyNoteId = String(this.activeNote._id);
            }
            clearTimeout(this.autosaveTimer);
            this.saveStatus = '';
            this.autosaveTimer = setTimeout(() => this.doAutosave(), 1200);
        },

        async doAutosave() {
            if (!this.activeNote || !this.activeNote._id) return;
            this.saveStatus = 'saving';
            const el = this.$refs.editorContent;
            const content = el ? el.innerHTML : '';
            const noteId = this.activeNote._id;
            const title = this.activeNote.title;
            const canSaveContent = this.canSaveActiveContent(noteId) && String(this.contentDirtyNoteId || '') === String(noteId);
            try {
                const res = await fetch(_apiBase + '/' + noteId, {
                    method: 'PUT', credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(this.noteSavePayload(this.activeNote, content, canSaveContent))
                });
                const data = await res.json().catch(() => null);
                if (data?.success) this.syncSavedNoteMeta(noteId, data.note);
                if (this.activeNote && this.activeNote._id === noteId) {
                    this.saveStatus = 'saved';
                    // Update sidebar preview
                    const idx = this.notes.findIndex(n => n._id === noteId);
                    if (idx !== -1) {
                        this.notes[idx].title = title;
                        if (canSaveContent) {
                            this.notes[idx].content = content;
                            this.notes[idx]._contentRedacted = false;
                            if (this.$refs.editorContent && this.$refs.editorContent.innerHTML === content) {
                                this.contentDirtyNoteId = null;
                            }
                        }
                        this.notes[idx].updatedAt = new Date().toISOString();
                    }
                    setTimeout(() => { if (this.saveStatus === 'saved') this.saveStatus = ''; }, 2000);
                }
            } catch (e) {
                console.error('[Notes] Autosave error:', e);
                if (this.activeNote) this.saveStatus = '';
            }
        },

        async updateNoteColor(color) {
            if (!this.activeNote) return;
            this.activeNote.color = color;
            // Update local array
            const idx = this.notes.findIndex(n => n._id === this.activeNote._id);
            if (idx !== -1) {
                this.notes[idx].color = color;
            }
            this.saveStatus = 'saving';
            try {
                const res = await fetch(_apiBase + '/' + this.activeNote._id, {
                    method: 'PUT', credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ color })
                });
                const data = await res.json();
                if (data.success) {
                    this.saveStatus = 'saved';
                    setTimeout(() => { if (this.saveStatus === 'saved') this.saveStatus = ''; }, 2000);
                }
            } catch (e) {
                console.error('[Notes] Color save error:', e);
                this.saveStatus = '';
            }
        },

        cancelPinModal() {
            this.showPinModal = false;
            this.pendingNoteToOpen = null;
            this.pendingProtectToggle = false;
            this.pinInput = '';
            this.pinError = '';
        },

        async verifyPin() {
            if (this.pinInput.length !== 4) return;
            
            this.isPinVerifying = true;
            this.pinError = '';

            try {
                // If we are toggling protection on the current note
                if (this.pendingProtectToggle && this.activeNote) {
                    const res = await fetch('/account/' + _accountNumber + '/api/user/verify-pin', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ pin: this.pinInput })
                    });
                    const data = await res.json();
                    
                    if (data.success && data.valid) {
                        this.showPinModal = false;
                        this.pendingProtectToggle = false;
                        await this.executeToggleProtection();
                    } else {
                        this.pinError = data.error || 'PIN incorrect';
                    }
                } 
                // If we are opening a protected note
                else if (this.pendingNoteToOpen) {
                    const noteId = this.pendingNoteToOpen._id;
                    const res = await fetch(`${_apiBase}/${noteId}/verify-pin`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ pin: this.pinInput })
                    });
                    const data = await res.json();
                    
                    if (data.success) {
                        this.showPinModal = false;
                        const fullNote = data.note;
                        fullNote.content = data.content || ''; // Attach decrypted content
                        this.markNoteUnlocked(fullNote);
                        const idx = this.notes.findIndex(n => n._id === fullNote._id);
                        if (idx !== -1) {
                            this.notes[idx] = {
                                ...this.notes[idx],
                                ...fullNote,
                                _unlocked: true,
                                _contentRedacted: false
                            };
                        }
                        
                        // Proceed to open note
                        if (this.activeNote && String(this.activeNote._id) !== String(fullNote._id)) {
                            const previousNoteId = this.activeNote._id;
                            const shouldRelockPrevious = !!this.activeNote.isProtected;
                            this.saveCurrentNote();
                            if (shouldRelockPrevious) this.lockProtectedNote(previousNoteId);
                        }
                        this.showNoteInEditor(fullNote);
                        this.pendingNoteToOpen = null;
                    } else {
                        this.pinError = data.error || 'PIN incorrect';
                    }
                }
            } catch (err) {
                console.error('[Notes] PIN error', err);
                this.pinError = 'Erreur réseau';
            } finally {
                this.isPinVerifying = false;
            }
        },

        async toggleProtection() {
            if (!this.activeNote) return;

            // If it's already protected and we want to unprotect it, ask for PIN
            if (this.activeNote.isProtected) {
                this.pendingProtectToggle = true;
                this.pinInput = '';
                this.pinError = '';
                this.showPinModal = true;
                this.$nextTick(() => {
                    if (this.$refs.pinInputRef) this.$refs.pinInputRef.focus();
                });
            } else {
                // If we want to protect it, check if user has PIN enabled first
                try {
                    const statusRes = await fetch('/account/' + _accountNumber + '/api/user/security-status');
                    const statusData = await statusRes.json();
                    
                    if (!statusData.pinEnabled) {
                        alert('Vous devez configurer un code PIN dans vos paramètres (onglet Sécurité) avant de pouvoir sécuriser une note.');
                        return;
                    }
                    
                    this.pendingProtectToggle = true;
                    this.pinInput = '';
                    this.pinError = '';
                    this.showPinModal = true;
                    this.$nextTick(() => {
                        if (this.$refs.pinInputRef) this.$refs.pinInputRef.focus();
                    });
                } catch (e) {
                    console.error('Erreur status', e);
                }
            }
        },

        async executeToggleProtection() {
            if (!this.activeNote) return;
            const newStatus = !this.activeNote.isProtected;
            
            try {
                const res = await fetch(`${_apiBase}/${this.activeNote._id}/protect`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ protect: newStatus })
                });
                const data = await res.json();
                
                if (data.success) {
                    const noteId = this.activeNote._id;
                    const currentContent = this.$refs.editorContent ? this.$refs.editorContent.innerHTML : (this.activeNote.content || '');
                    this.activeNote.isProtected = newStatus;
                    this.syncSavedNoteMeta(noteId, data.note);
                    if (newStatus) {
                        this.markNoteUnlocked(this.activeNote);
                    } else {
                        this.forgetNoteUnlocked(noteId);
                        this.activeNote._unlocked = false;
                        this.activeNote._contentRedacted = false;
                    }
                    
                    // Update in list
                    const idx = this.notes.findIndex(n => n._id === noteId);
                    if (idx > -1) {
                        this.notes[idx].isProtected = newStatus;
                        this.notes[idx]._contentRedacted = false;
                        this.notes[idx]._unlocked = newStatus;
                        this.notes[idx].content = currentContent;
                    }
                }
            } catch (err) {
                console.error('[Notes] Protect error', err);
            }
        },

        async deleteNote(note) {
            if (!confirm('Voulez-vous vraiment supprimer cette note ?')) return;
            const noteId = note._id;
            // If deleting the active note, clear editor
            if (this.activeNote && this.activeNote._id === noteId) {
                clearTimeout(this.autosaveTimer);
                this.activeNote = null;
                this.editorNoteId = null;
                this.contentDirtyNoteId = null;
                this.saveStatus = '';
            }
            this.notes = this.notes.filter(n => n._id !== noteId);
            this.forgetNoteUnlocked(noteId);
            try {
                await fetch(_apiBase + '/' + noteId, { method: 'DELETE', credentials: 'include' });
            } catch (e) { console.error('[Notes] Delete error:', e); }
        },

        async deleteActiveNote() {
            if (!this.activeNote) return;
            const noteId = this.activeNote._id;
            const noteTitle = this.activeNote.title || 'Sans titre';
            if (!confirm('Supprimer la note "' + noteTitle + '" ?')) return;
            clearTimeout(this.autosaveTimer);
            this.activeNote = null;
            this.editorNoteId = null;
            this.contentDirtyNoteId = null;
            this.saveStatus = '';
            this.mobileEditing = false;
            this.notes = this.notes.filter(n => n._id !== noteId);
            this.forgetNoteUnlocked(noteId);
            try {
                await fetch(_apiBase + '/' + noteId, { method: 'DELETE', credentials: 'include' });
            } catch (e) { console.error('[Notes] Delete error:', e); }
        },

        async togglePin(note) {
            try {
                const res = await fetch(_apiBase + '/' + note._id + '/pin', {
                    method: 'PATCH', credentials: 'include'
                });
                const data = await res.json();
                if (data.success !== undefined) {
                    note.pinned = data.pinned;
                    // Update activeNote if same
                    if (this.activeNote && this.activeNote._id === note._id) {
                        this.activeNote.pinned = data.pinned;
                    }
                    // Re-sort notes
                    this.notes.sort((a, b) => (b.pinned ? 1 : 0) - (a.pinned ? 1 : 0) || new Date(b.updatedAt) - new Date(a.updatedAt));
                }
            } catch (e) { console.error('[Notes] Pin error:', e); }
        },

        async togglePinActive() {
            if (!this.activeNote) return;
            const note = this.notes.find(n => n._id === this.activeNote._id);
            if (note) {
                await this.togglePin(note);
            }
        },

        // ── Editor Commands ──
        exec(cmd, val) {
            document.execCommand(cmd, false, val || null);
            this.updateFormats();
            this.scheduleAutosave();
        },

        updateFormats() {
            if (!this.$refs.editorContent) return;
            const commands = ['bold', 'italic', 'underline', 'strikeThrough', 'justifyLeft', 'justifyCenter', 'justifyRight', 'insertUnorderedList', 'insertOrderedList'];
            commands.forEach(cmd => {
                try {
                    this.activeFormats[cmd] = document.queryCommandState(cmd);
                } catch (e) {}
            });
            
            // Check block formats
            try {
                const formatBlock = document.queryCommandValue('formatBlock');
                this.activeFormats.formatBlock = formatBlock || '';
                this.activeFormats.blockquote = formatBlock === 'blockquote';
            } catch(e) {}
            
            // Check font size
            try {
                this.activeFormats.fontSize = document.queryCommandValue('fontSize') || '';
            } catch(e) {}
        },

        get formatLabel() {
            const fb = this.activeFormats.formatBlock;
            if (fb === 'h1') return 'Titre 1';
            if (fb === 'h2') return 'Titre 2';
            if (fb === 'h3') return 'Titre 3';
            return 'Paragraphe';
        },

        get sizeLabel() {
            const sz = this.activeFormats.fontSize;
            if (sz === '1') return 'Petit';
            if (sz === '5') return 'Grand';
            if (sz === '7') return 'Très grand';
            return 'Taille';
        },

        setFormat(tag) {
            document.execCommand('formatBlock', false, '<' + tag + '>');
            this.updateFormats();
            this.scheduleAutosave();
        },

        setFontSize(size) {
            document.execCommand('fontSize', false, size);
            this.updateFormats();
            this.scheduleAutosave();
        },

        clearFormatting() {
            const sel = window.getSelection();
            if (!sel || sel.rangeCount === 0) return;

            const editor = this.$refs.editorContent;
            if (!editor) return;

            // 1) Standard removeFormat (already scoped to selection by browser)
            document.execCommand('removeFormat', false, null);
            document.execCommand('unlink', false, null);

            // 2) Find scope: common ancestor of the selection
            const range = sel.getRangeAt(0);
            let scope = range.commonAncestorContainer;
            if (scope.nodeType === 3) scope = scope.parentElement;
            if (!editor.contains(scope)) scope = editor;

            // If selection is collapsed (no text selected), just do removeFormat
            if (sel.isCollapsed) {
                this.updateFormats();
                return;
            }

            // Helper: unwrap element keeping its children
            const unwrap = (el) => {
                const parent = el.parentNode;
                while (el.firstChild) parent.insertBefore(el.firstChild, el);
                el.remove();
            };

            // 3) Convert headings/blockquotes to <div> — only within scope
            const HEADING_SEL = 'h1,h2,h3,h4,h5,h6,blockquote';
            // If scope itself is a heading, convert it
            if (scope !== editor && scope.matches?.(HEADING_SEL)) {
                const div = document.createElement('div');
                while (scope.firstChild) div.appendChild(scope.firstChild);
                scope.parentNode.replaceChild(div, scope);
                scope = div;
            }
            // Convert headings inside scope
            scope.querySelectorAll?.(HEADING_SEL)?.forEach(el => {
                const div = document.createElement('div');
                while (el.firstChild) div.appendChild(el.firstChild);
                el.parentNode.replaceChild(div, el);
            });

            // 4) Unwrap font, inline formatting, span tags — within scope only
            scope.querySelectorAll?.('font')?.forEach(unwrap);
            scope.querySelectorAll?.('b,strong,i,em,u,s,strike')?.forEach(unwrap);
            scope.querySelectorAll?.('span')?.forEach(unwrap);

            // 5) Strip inline style attributes — within scope only
            scope.querySelectorAll?.('[style]')?.forEach(el => el.removeAttribute('style'));
            if (scope !== editor && scope.hasAttribute?.('style')) {
                scope.removeAttribute('style');
            }

            editor.normalize();
            this.updateFormats();
            this.scheduleAutosave();
        },

        // ── Selection Save/Restore (for modals) ──
        saveSelection() {
            const sel = window.getSelection();
            if (sel.rangeCount > 0) {
                this.savedSelection = sel.getRangeAt(0).cloneRange();
            }
        },

        restoreSelection() {
            if (this.savedSelection) {
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(this.savedSelection);
            }
        },

        // ── Link Insert ──
        openLinkModal() {
            this.saveSelection();
            const sel = window.getSelection();
            this.linkText = sel.toString() || '';
            this.linkUrl = '';
            this.showLinkModal = true;
            this.$nextTick(() => {
                if (this.linkText) {
                    this.$refs.linkTextInput?.nextElementSibling?.nextElementSibling?.focus();
                } else {
                    this.$refs.linkTextInput?.focus();
                }
            });
        },

        insertLink() {
            const url = this.linkUrl.trim();
            if (!url) return;
            const text = this.linkText.trim() || url;
            this.showLinkModal = false;
            this.$refs.editorContent?.focus();
            this.restoreSelection();
            const html = '<a href="' + url + '" target="_blank" rel="noopener">' + text + '</a>&nbsp;';
            document.execCommand('insertHTML', false, html);
            this.scheduleAutosave();
        },

        // ── Image Insert (Universal Picker) ──
        insertImageFromPicker() {
            this.saveSelection();
            Alpine.store('imagePicker').open({
                accountNumber: _accountNumber,
                recordId: _recordId,
                onSelect: (img) => {
                    this.$refs.editorContent?.focus();
                    this.restoreSelection();
                    const html = window.DexRichTextEditor
                        ? window.DexRichTextEditor.imageHtml(img.url, img.alt || 'image', '100%')
                        : '<div><img src="' + img.url + '" alt="' + (img.alt || 'image') + '" style="max-width:100%;"></div><div><br></div>';
                    document.execCommand('insertHTML', false, html);
                    this.scheduleAutosave();
                }
            });
        },

        // ── Content Click Handler (image toolbar + link Ctrl+Click) ──
        handleContentClick(e) {
            this.updateFormats();

            // Image click: show floating toolbar
            if (e.target.tagName === 'IMG') {
                e.preventDefault();
                this.$refs.editorContent?.querySelectorAll('.ne-img-selected').forEach(el => el.classList.remove('ne-img-selected'));
                e.target.classList.add('ne-img-selected');
                this.selectedImage = e.target;
                this.selectedImageSize = window.DexRichTextEditor
                    ? window.DexRichTextEditor.getImageSize(e.target)
                    : (e.target.style.width || '100%');
                this.$nextTick(() => this.positionImageToolbar(e.target));
                return;
            }

            // Link Ctrl+Click: open in new tab
            if (e.target.tagName === 'A' && (e.ctrlKey || e.metaKey)) {
                e.preventDefault();
                const href = e.target.getAttribute('href');
                if (href) window.open(href, '_blank', 'noopener');
                return;
            }

            // Click elsewhere: deselect image
            if (this.selectedImage) {
                this.selectedImage.classList.remove('ne-img-selected');
                this.selectedImage = null;
            }
        },

        positionImageToolbar(img) {
            const toolbar = this.$refs.imageToolbar;
            if (!toolbar || !img) return;
            const container = img.closest('.notes-editor-panel') || img.closest('.notes-container');
            if (!container) return;
            const containerRect = container.getBoundingClientRect();
            const imgRect = img.getBoundingClientRect();
            const toolbarW = toolbar.offsetWidth || 250;
            let left = imgRect.left - containerRect.left + (imgRect.width / 2) - (toolbarW / 2);
            let top = imgRect.top - containerRect.top - 44;
            if (left < 4) left = 4;
            if (left + toolbarW > container.clientWidth - 4) left = container.clientWidth - toolbarW - 4;
            if (top < 0) top = imgRect.bottom - containerRect.top + 8;
            this.imageToolbarStyle = `left:${left}px;top:${top}px;`;
        },

        resizeImage(size) {
            if (!this.selectedImage) return;
            if (window.DexRichTextEditor) {
                window.DexRichTextEditor.applyImageSize(this.selectedImage, size);
            } else {
                this.selectedImage.style.width = size;
            }
            this.selectedImageSize = size;
            this.scheduleAutosave();
            this.$nextTick(() => this.positionImageToolbar(this.selectedImage));
        },

        deleteImage() {
            if (!this.selectedImage) return;
            const parent = this.selectedImage.parentElement;
            this.selectedImage.remove();
            if (parent && parent.tagName === 'DIV' && !parent.textContent.trim() && !parent.querySelector('img')) {
                parent.remove();
            }
            this.selectedImage = null;
            this.scheduleAutosave();
        },

        highlight(color) {
            if (color === 'transparent') {
                document.execCommand('removeFormat', false, null);
            } else {
                document.execCommand('hiliteColor', false, color);
            }
            this.scheduleAutosave();
        },

        insertCheckbox() {
            const html = window.DexRichTextEditor
                ? window.DexRichTextEditor.checklistHtml('Tache', { variant: 'note' })
                : '<div class="note-checklist-item" contenteditable="false">' +
                    '<input type="checkbox" onclick="event.stopPropagation()">' +
                    '<span class="note-checklist-text" contenteditable="true">Tâche</span>' +
                    '<button class="note-checklist-delete" contenteditable="false" onclick="this.parentElement.remove()" title="Supprimer">×</button>' +
                    '</div><div><br></div>';
            document.execCommand('insertHTML', false, html);
            this.scheduleAutosave();
        },

        handleEditorEnter(e) {
            const sel = window.getSelection();
            if (!sel || !sel.anchorNode) return;
            const node = sel.anchorNode.nodeType === 3 ? sel.anchorNode.parentElement : sel.anchorNode;
            const checkItem = node?.closest('.note-checklist-item');
            if (checkItem) {
                e.preventDefault();
                const textSpan = checkItem.querySelector('.note-checklist-text');
                const text = textSpan ? textSpan.textContent.replace(/\u200B/g, '').trim() : '';
                if (!text) {
                    const newP = document.createElement('div');
                    newP.innerHTML = '<br>';
                    checkItem.parentNode.insertBefore(newP, checkItem.nextSibling);
                    checkItem.remove();
                    const range = document.createRange();
                    range.setStart(newP, 0);
                    range.collapse(true);
                    sel.removeAllRanges();
                    sel.addRange(range);
                    this.scheduleAutosave();
                    return;
                }
                const newItem = '<div class="note-checklist-item" contenteditable="false">' +
                    '<input type="checkbox" onclick="event.stopPropagation()">' +
                    '<span class="note-checklist-text" contenteditable="true">\u200B</span>' +
                    '<button class="note-checklist-delete" contenteditable="false" onclick="this.parentElement.remove()" title="Supprimer">×</button>' +
                    '</div>';
                checkItem.insertAdjacentHTML('afterend', newItem);
                const nextItem = checkItem.nextElementSibling;
                if (nextItem) {
                    const span = nextItem.querySelector('.note-checklist-text');
                    if (span) {
                        const range = document.createRange();
                        range.selectNodeContents(span);
                        range.collapse(false);
                        sel.removeAllRanges();
                        sel.addRange(range);
                    }
                }
                this.scheduleAutosave();
            }
        },

        handleEditorBackspace(e) {
            const sel = window.getSelection();
            if (!sel || !sel.anchorNode) return;
            const node = sel.anchorNode.nodeType === 3 ? sel.anchorNode.parentElement : sel.anchorNode;
            const checkItem = node?.closest('.note-checklist-item');
            if (checkItem) {
                const textSpan = checkItem.querySelector('.note-checklist-text');
                const text = textSpan ? textSpan.textContent.replace(/\u200B/g, '').trim() : '';
                if (!text) {
                    e.preventDefault();
                    const prev = checkItem.previousElementSibling;
                    if (prev && prev.classList.contains('note-checklist-item')) {
                        const prevSpan = prev.querySelector('.note-checklist-text');
                        if (prevSpan) {
                            const range = document.createRange();
                            range.selectNodeContents(prevSpan);
                            range.collapse(false);
                            sel.removeAllRanges();
                            sel.addRange(range);
                        }
                    } else {
                        const newP = document.createElement('div');
                        newP.innerHTML = '<br>';
                        checkItem.parentNode.insertBefore(newP, checkItem);
                        const range = document.createRange();
                        range.setStart(newP, 0);
                        range.collapse(true);
                        sel.removeAllRanges();
                        sel.addRange(range);
                    }
                    checkItem.remove();
                    this.scheduleAutosave();
                }
            }
        },

        // ── Helpers ──
        getPreviewText(html) {
            if (!html) return 'Note vide';
            const tmp = document.createElement('div');
            tmp.innerHTML = html;
            const text = tmp.textContent || tmp.innerText || '';
            return text.substring(0, 80).trim() || 'Note vide';
        },

        formatDate(d) {
            if (!d) return '';
            const date = new Date(d);
            if (Number.isNaN(date.getTime())) return '';
            const now = new Date();
            const dateDay = new Date(date.getFullYear(), date.getMonth(), date.getDate());
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const diffDays = Math.round((today - dateDay) / 86400000);
            const time = date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

            if (diffDays === 0) return time;
            if (diffDays === 1) return 'Hier ' + time;
            if (diffDays > 1 && diffDays < 7) {
                return date.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' });
            }
            return date.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
        }
    }));
});
</script>
