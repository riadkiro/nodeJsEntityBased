<div x-data="documentList()">
  <!-- Header with Breadcrumb and Layout Toggle -->
  <div class="flex items-center justify-between">
    <div class="flex-1">
      <%- include("../nav/nav-breadcrumb") %>
    </div>
    <!-- Layout Toggle - minimal like kanban/table -->
    <div class="flex items-center gap-1">
      <button 
        @click="layoutMode = 'dashboard'" 
        class="p-1.5 rounded transition-colors"
        :class="layoutMode === 'dashboard' ? 'text-primary' : 'text-[#888ea8] hover:text-primary'"
        title="Vue Dashboard"
      >
        <!-- Grid icon -->
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
          <path d="M2 6.5C2 4.37868 2 3.31802 2.65901 2.65901C3.31802 2 4.37868 2 6.5 2C8.62132 2 9.68198 2 10.341 2.65901C11 3.31802 11 4.37868 11 6.5C11 8.62132 11 9.68198 10.341 10.341C9.68198 11 8.62132 11 6.5 11C4.37868 11 3.31802 11 2.65901 10.341C2 9.68198 2 8.62132 2 6.5Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M13 6.5C13 4.37868 13 3.31802 13.659 2.65901C14.318 2 15.3787 2 17.5 2C19.6213 2 20.682 2 21.341 2.65901C22 3.31802 22 4.37868 22 6.5C22 8.62132 22 9.68198 21.341 10.341C20.682 11 19.6213 11 17.5 11C15.3787 11 14.318 11 13.659 10.341C13 9.68198 13 8.62132 13 6.5Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M2 17.5C2 15.3787 2 14.318 2.65901 13.659C3.31802 13 4.37868 13 6.5 13C8.62132 13 9.68198 13 10.341 13.659C11 14.318 11 15.3787 11 17.5C11 19.6213 11 20.682 10.341 21.341C9.68198 22 8.62132 22 6.5 22C4.37868 22 3.31802 22 2.65901 21.341C2 20.682 2 19.6213 2 17.5Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M13 17.5C13 15.3787 13 14.318 13.659 13.659C14.318 13 15.3787 13 17.5 13C19.6213 13 20.682 13 21.341 13.659C22 14.318 22 15.3787 22 17.5C22 19.6213 22 20.682 21.341 21.341C20.682 22 19.6213 22 17.5 22C15.3787 22 14.318 22 13.659 21.341C13 20.682 13 19.6213 13 17.5Z" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>
      <button 
        @click="layoutMode = 'notes'" 
        class="p-1.5 rounded transition-colors"
        :class="layoutMode === 'notes' ? 'text-primary' : 'text-[#888ea8] hover:text-primary'"
        title="Vue Sidebar"
      >
        <!-- Sidebar layout icon -->
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
          <path d="M2 6C2 4.11438 2 3.17157 2.58579 2.58579C3.17157 2 4.11438 2 6 2H18C19.8856 2 20.8284 2 21.4142 2.58579C22 3.17157 22 4.11438 22 6V18C22 19.8856 22 20.8284 21.4142 21.4142C20.8284 22 19.8856 22 18 22H6C4.11438 22 3.17157 22 2.58579 21.4142C2 20.8284 2 19.8856 2 18V6Z" stroke="currentColor" stroke-width="1.5"/>
          <path opacity="0.5" d="M8 2V22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- LAYOUT 1: DASHBOARD (Default) -->
  <!-- ============================================ -->
  <template x-if="layoutMode === 'dashboard'">
    <div class="pt-5">
      <!-- Compact Header -->
      <div class="mb-5 flex flex-col gap-4">
        <!-- Top row: Actions -->
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <template x-if="activeFolder !== null">
              <button @click="activeFolder = null; folderTab = 'all'" class="flex items-center gap-2 px-3 py-2 rounded-xl text-sm font-medium text-[#888ea8] hover:text-primary hover:bg-primary/5 transition-all">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M5 12L11 6M5 12L11 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Dossiers
              </button>
            </template>
            <template x-if="activeFolder !== null">
              <h3 class="text-base font-semibold dark:text-white-light" x-text="getFolderLabel(activeFolder)"></h3>
            </template>
          </div>
          <div class="flex items-center gap-3">
            <!-- Search -->
            <div class="relative w-64">
              <input type="text" x-model="searchQuery" placeholder="Rechercher un document..." class="form-input w-full pl-10 py-2 text-sm dark:bg-[#1b2e4b] dark:border-[#1b2e4b] rounded-xl"/>
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-[#888ea8]" viewBox="0 0 24 24" fill="none">
                <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5" opacity="0.5"></circle>
                <path d="M20 20L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <!-- View toggle -->
            <div class="flex gap-0.5 bg-gray-100 dark:bg-[#1b2e4b] p-0.5 rounded-lg" x-show="activeFolder !== null" x-cloak>
              <button @click="viewMode = 'grid'" class="p-1.5 rounded-md transition-all" :class="viewMode === 'grid' ? 'bg-white dark:bg-dark shadow-sm text-primary' : 'text-[#888ea8] hover:text-primary'">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M2 6.5C2 4.37868 2 3.31802 2.65901 2.65901C3.31802 2 4.37868 2 6.5 2C8.62132 2 9.68198 2 10.341 2.65901C11 3.31802 11 4.37868 11 6.5C11 8.62132 11 9.68198 10.341 10.341C9.68198 11 8.62132 11 6.5 11C4.37868 11 3.31802 11 2.65901 10.341C2 9.68198 2 8.62132 2 6.5Z" stroke="currentColor" stroke-width="1.5"/><path d="M13 6.5C13 4.37868 13 3.31802 13.659 2.65901C14.318 2 15.3787 2 17.5 2C19.6213 2 20.682 2 21.341 2.65901C22 3.31802 22 4.37868 22 6.5C22 8.62132 22 9.68198 21.341 10.341C20.682 11 19.6213 11 17.5 11C15.3787 11 14.318 11 13.659 10.341C13 9.68198 13 8.62132 13 6.5Z" stroke="currentColor" stroke-width="1.5"/><path d="M2 17.5C2 15.3787 2 14.318 2.65901 13.659C3.31802 13 4.37868 13 6.5 13C8.62132 13 9.68198 13 10.341 13.659C11 14.318 11 15.3787 11 17.5C11 19.6213 11 20.682 10.341 21.341C9.68198 22 8.62132 22 6.5 22C4.37868 22 3.31802 22 2.65901 21.341C2 20.682 2 19.6213 2 17.5Z" stroke="currentColor" stroke-width="1.5"/><path d="M13 17.5C13 15.3787 13 14.318 13.659 13.659C14.318 13 15.3787 13 17.5 13C19.6213 13 20.682 13 21.341 13.659C22 14.318 22 15.3787 22 17.5C22 19.6213 22 20.682 21.341 21.341C20.682 22 19.6213 22 17.5 22C15.3787 22 14.318 22 13.659 21.341C13 20.682 13 19.6213 13 17.5Z" stroke="currentColor" stroke-width="1.5"/></svg>
              </button>
              <button @click="viewMode = 'list'" class="p-1.5 rounded-md transition-all" :class="viewMode === 'list' ? 'bg-white dark:bg-dark shadow-sm text-primary' : 'text-[#888ea8] hover:text-primary'">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M21 6H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M21 12H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M21 18H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="5" cy="6" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="5" cy="18" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
              </button>
            </div>
            <!-- New document button -->
            <button @click="openTemplateModal()" class="btn btn-primary btn-sm rounded-xl gap-1.5">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              Nouveau
            </button>
          </div>
        </div>

        <!-- Windows-style Folder Icons (landing page) -->
        <template x-if="activeFolder === null">
          <div class="relative" @contextmenu.prevent="contextMenu = { show: true, x: $event.clientX, y: $event.clientY, folderId: null, folderName: null }">
            <div class="flex flex-wrap gap-2 pt-2">
            <!-- + Nouveau -->
            <button @click="openTemplateModal()" class="group flex flex-col items-center justify-center w-[100px] py-4 px-2 rounded-xl hover:bg-primary/5 dark:hover:bg-primary/10 transition-all cursor-pointer">
              <div class="relative mb-2">
                <svg class="w-16 h-16 text-primary/70 group-hover:text-primary transition-colors" viewBox="0 0 64 64" fill="none">
                  <rect x="12" y="8" width="40" height="48" rx="3" fill="currentColor" opacity="0.08" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M32 24V40M24 32H40" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              </div>
              <span class="text-xs font-medium text-primary/80 group-hover:text-primary text-center leading-tight transition-colors">Nouveau</span>
            </button>

            <!-- Récents folder -->
            <button @click="activeFolder = 'recent'; folderTab = 'all'" class="group flex flex-col items-center justify-center w-[100px] py-4 px-2 rounded-xl hover:bg-[#eef2ff] dark:hover:bg-[#1b2e4b]/60 transition-all cursor-pointer">
              <div class="relative mb-2">
                <svg class="w-16 h-16 drop-shadow-sm" viewBox="0 0 64 64" fill="none">
                  <path d="M6 18C6 15.8 6 14.7 6.654 13.91C6.8 13.73 6.965 13.565 7.145 13.419C7.935 12.765 9.035 12.765 11.235 12.765H15.5C16.44 12.765 16.91 12.765 17.34 12.9C17.77 13.035 18.135 13.295 18.865 13.815L21.135 15.39C21.865 15.91 22.23 16.17 22.66 16.305C23.09 16.44 23.56 16.44 24.5 16.44H42C46.4 16.44 48.6 16.44 50 17.84C51.4 19.24 51.4 21.44 51.4 25.84V26" stroke="#e2a03f" stroke-width="2"/>
                  <rect x="4" y="22" width="56" height="32" rx="4" fill="#f5c542" stroke="#e2a03f" stroke-width="1.5"/>
                  <rect x="4" y="22" width="56" height="8" rx="4" fill="#e2a03f" opacity="0.3"/>
                </svg>
                <span class="absolute -top-1 -right-1 text-[10px] min-w-[20px] h-[20px] flex items-center justify-center px-1 rounded-full bg-primary text-white font-bold shadow-sm" x-text="getRecentDocs().length"></span>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-primary text-center leading-tight transition-colors">Récents</span>
            </button>

            <!-- Brouillons folder -->
            <button @click="activeFolder = 'draft'; folderTab = 'draft'" class="group flex flex-col items-center justify-center w-[100px] py-4 px-2 rounded-xl hover:bg-[#fff8ed] dark:hover:bg-[#1b2e4b]/60 transition-all cursor-pointer">
              <div class="relative mb-2">
                <svg class="w-16 h-16 drop-shadow-sm" viewBox="0 0 64 64" fill="none">
                  <path d="M6 18C6 15.8 6 14.7 6.654 13.91C6.8 13.73 6.965 13.565 7.145 13.419C7.935 12.765 9.035 12.765 11.235 12.765H15.5C16.44 12.765 16.91 12.765 17.34 12.9C17.77 13.035 18.135 13.295 18.865 13.815L21.135 15.39C21.865 15.91 22.23 16.17 22.66 16.305C23.09 16.44 23.56 16.44 24.5 16.44H42C46.4 16.44 48.6 16.44 50 17.84C51.4 19.24 51.4 21.44 51.4 25.84V26" stroke="#e2a03f" stroke-width="2"/>
                  <rect x="4" y="22" width="56" height="32" rx="4" fill="#f5c542" stroke="#e2a03f" stroke-width="1.5"/>
                  <rect x="4" y="22" width="56" height="8" rx="4" fill="#e2a03f" opacity="0.3"/>
                </svg>
                <span class="absolute -top-1 -right-1 text-[10px] min-w-[20px] h-[20px] flex items-center justify-center px-1 rounded-full bg-warning text-white font-bold shadow-sm" x-text="documents.filter(d => d.status === 'draft').length"></span>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-warning text-center leading-tight transition-colors">Brouillons</span>
            </button>

            <!-- Publiés folder -->
            <button @click="activeFolder = 'published'; folderTab = 'published'" class="group flex flex-col items-center justify-center w-[100px] py-4 px-2 rounded-xl hover:bg-[#edfff5] dark:hover:bg-[#1b2e4b]/60 transition-all cursor-pointer">
              <div class="relative mb-2">
                <svg class="w-16 h-16 drop-shadow-sm" viewBox="0 0 64 64" fill="none">
                  <path d="M6 18C6 15.8 6 14.7 6.654 13.91C6.8 13.73 6.965 13.565 7.145 13.419C7.935 12.765 9.035 12.765 11.235 12.765H15.5C16.44 12.765 16.91 12.765 17.34 12.9C17.77 13.035 18.135 13.295 18.865 13.815L21.135 15.39C21.865 15.91 22.23 16.17 22.66 16.305C23.09 16.44 23.56 16.44 24.5 16.44H42C46.4 16.44 48.6 16.44 50 17.84C51.4 19.24 51.4 21.44 51.4 25.84V26" stroke="#00ab55" stroke-width="2"/>
                  <rect x="4" y="22" width="56" height="32" rx="4" fill="#34d399" stroke="#00ab55" stroke-width="1.5"/>
                  <rect x="4" y="22" width="56" height="8" rx="4" fill="#00ab55" opacity="0.3"/>
                </svg>
                <span class="absolute -top-1 -right-1 text-[10px] min-w-[20px] h-[20px] flex items-center justify-center px-1 rounded-full bg-success text-white font-bold shadow-sm" x-text="documents.filter(d => d.status === 'published').length"></span>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-success text-center leading-tight transition-colors">Publiés</span>
            </button>

            <!-- Favoris folder -->
            <button @click="activeFolder = 'fav'; folderTab = 'fav'" class="group flex flex-col items-center justify-center w-[100px] py-4 px-2 rounded-xl hover:bg-[#fef3f2] dark:hover:bg-[#1b2e4b]/60 transition-all cursor-pointer">
              <div class="relative mb-2">
                <svg class="w-16 h-16 drop-shadow-sm" viewBox="0 0 64 64" fill="none">
                  <path d="M6 18C6 15.8 6 14.7 6.654 13.91C6.8 13.73 6.965 13.565 7.145 13.419C7.935 12.765 9.035 12.765 11.235 12.765H15.5C16.44 12.765 16.91 12.765 17.34 12.9C17.77 13.035 18.135 13.295 18.865 13.815L21.135 15.39C21.865 15.91 22.23 16.17 22.66 16.305C23.09 16.44 23.56 16.44 24.5 16.44H42C46.4 16.44 48.6 16.44 50 17.84C51.4 19.24 51.4 21.44 51.4 25.84V26" stroke="#e7515a" stroke-width="2"/>
                  <rect x="4" y="22" width="56" height="32" rx="4" fill="#fca5a5" stroke="#e7515a" stroke-width="1.5"/>
                  <rect x="4" y="22" width="56" height="8" rx="4" fill="#e7515a" opacity="0.3"/>
                  <!-- Star icon inside -->
                  <path d="M32 30L34.5 35.5L40.5 36L36 40L37.5 46L32 43L26.5 46L28 40L23.5 36L29.5 35.5Z" fill="#e7515a" opacity="0.5"/>
                </svg>
                <span class="absolute -top-1 -right-1 text-[10px] min-w-[20px] h-[20px] flex items-center justify-center px-1 rounded-full bg-danger text-white font-bold shadow-sm" x-text="documents.filter(d => d.isFav).length"></span>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-danger text-center leading-tight transition-colors">Favoris</span>
            </button>

            <!-- Tous les documents folder -->
            <button @click="activeFolder = 'all'; folderTab = 'all'" class="group flex flex-col items-center justify-center w-[100px] py-4 px-2 rounded-xl hover:bg-[#eff6ff] dark:hover:bg-[#1b2e4b]/60 transition-all cursor-pointer">
              <div class="relative mb-2">
                <svg class="w-16 h-16 drop-shadow-sm" viewBox="0 0 64 64" fill="none">
                  <path d="M6 18C6 15.8 6 14.7 6.654 13.91C6.8 13.73 6.965 13.565 7.145 13.419C7.935 12.765 9.035 12.765 11.235 12.765H15.5C16.44 12.765 16.91 12.765 17.34 12.9C17.77 13.035 18.135 13.295 18.865 13.815L21.135 15.39C21.865 15.91 22.23 16.17 22.66 16.305C23.09 16.44 23.56 16.44 24.5 16.44H42C46.4 16.44 48.6 16.44 50 17.84C51.4 19.24 51.4 21.44 51.4 25.84V26" stroke="#2196f3" stroke-width="2"/>
                  <rect x="4" y="22" width="56" height="32" rx="4" fill="#64b5f6" stroke="#2196f3" stroke-width="1.5"/>
                  <rect x="4" y="22" width="56" height="8" rx="4" fill="#2196f3" opacity="0.3"/>
                </svg>
                <span class="absolute -top-1 -right-1 text-[10px] min-w-[20px] h-[20px] flex items-center justify-center px-1 rounded-full bg-info text-white font-bold shadow-sm" x-text="documents.length"></span>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-info text-center leading-tight transition-colors">Tous</span>
            </button>

            <!-- User-created custom folders -->
            <template x-for="folder in customFolders" :key="folder._id">
              <button @click="activeFolder = 'custom-' + folder._id; folderTab = 'all'" class="group flex flex-col items-center justify-center w-[100px] py-4 px-2 rounded-xl hover:bg-[#fff8ed] dark:hover:bg-[#1b2e4b]/60 transition-all cursor-pointer" @contextmenu.prevent.stop="contextMenu = { show: true, x: $event.clientX, y: $event.clientY, folderId: folder._id, folderName: folder.name }">
                <div class="relative mb-2">
                  <svg class="w-16 h-16 drop-shadow-sm" viewBox="0 0 64 64" fill="none">
                    <path d="M6 18C6 15.8 6 14.7 6.654 13.91C6.8 13.73 6.965 13.565 7.145 13.419C7.935 12.765 9.035 12.765 11.235 12.765H15.5C16.44 12.765 16.91 12.765 17.34 12.9C17.77 13.035 18.135 13.295 18.865 13.815L21.135 15.39C21.865 15.91 22.23 16.17 22.66 16.305C23.09 16.44 23.56 16.44 24.5 16.44H42C46.4 16.44 48.6 16.44 50 17.84C51.4 19.24 51.4 21.44 51.4 25.84V26" :stroke="folder.color || '#e2a03f'" stroke-width="2"/>
                    <rect x="4" y="22" width="56" height="32" rx="4" :fill="folder.color || '#f5c542'" :stroke="folder.color || '#e2a03f'" stroke-width="1.5" opacity="0.7"/>
                    <rect x="4" y="22" width="56" height="8" rx="4" :fill="folder.color || '#e2a03f'" opacity="0.3"/>
                  </svg>
                  <span class="absolute -top-1 -right-1 text-[10px] min-w-[20px] h-[20px] flex items-center justify-center px-1 rounded-full bg-gray-500 text-white font-bold shadow-sm" x-text="documents.filter(d => d.folderId === folder._id).length"></span>
                </div>
                <span class="text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-white text-center leading-tight transition-colors truncate max-w-[90px]" x-text="folder.name"></span>
              </button>
            </template>
            </div>

            <!-- Right-click Context Menu -->
            <div x-show="contextMenu.show" x-cloak
              @click.outside="contextMenu.show = false"
              :style="'left:' + contextMenu.x + 'px; top:' + contextMenu.y + 'px'"
              class="fixed z-50 bg-white dark:bg-[#1b2e4b] border border-[#e0e6ed] dark:border-gray-700 rounded-lg shadow-xl py-1.5 min-w-[180px]"
              x-transition:enter="transition ease-out duration-100"
              x-transition:enter-start="opacity-0 scale-95"
              x-transition:enter-end="opacity-100 scale-100">
              <template x-if="!contextMenu.folderId">
                <div>
                  <button @click="createFolder(); contextMenu.show = false" class="flex items-center gap-2.5 w-full px-3.5 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-[#f4f4f4] dark:hover:bg-[#253b5c] transition-colors">
                    <svg class="w-4 h-4 text-warning" viewBox="0 0 24 24" fill="none"><path d="M2 6.95c0-.883 0-1.324.07-1.692A4 4 0 015.257 2.07C5.626 2 6.068 2 6.95 2c.386 0 .58 0 .766.017a4 4 0 012.18.904c.144.119.28.255.554.529L11 4h5c1.886 0 2.828 0 3.414.586C20 5.172 20 6.114 20 8v1" stroke="currentColor" stroke-width="1.5"/><path d="M2 10c0-1.886 0-2.828.586-3.414C3.172 6 4.114 6 6 6h12c1.886 0 2.828 0 3.414.586C22 7.172 22 8.114 22 10v5c0 1.886 0 2.828-.586 3.414C20.828 19 19.886 19 18 19H6c-1.886 0-2.828 0-3.414-.586C2 17.828 2 16.886 2 15v-5z" stroke="currentColor" stroke-width="1.5"/></svg>
                    Nouveau dossier
                  </button>
                  <button @click="openTemplateModal(); contextMenu.show = false" class="flex items-center gap-2.5 w-full px-3.5 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-[#f4f4f4] dark:hover:bg-[#253b5c] transition-colors">
                    <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none"><path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/><path d="M12 8V16M8 12H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Nouveau document
                  </button>
                </div>
              </template>
              <template x-if="contextMenu.folderId">
                <div>
                  <button @click="renameFolder(contextMenu.folderId, contextMenu.folderName); contextMenu.show = false" class="flex items-center gap-2.5 w-full px-3.5 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-[#f4f4f4] dark:hover:bg-[#253b5c] transition-colors">
                    <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none"><path d="M15.6287 5.12132L4.31497 16.435C4.18538 16.5646 4.09816 16.7304 4.06417 16.9108L3.54167 19.6667C3.48335 19.9735 3.73482 20.2425 4.04497 20.2012L6.8675 19.8243C7.03693 19.8017 7.19326 19.7258 7.31639 19.6068L18.5355 8.71751" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M12.5 7.5L16.5 11.5" stroke="currentColor" stroke-width="1.5"/></svg>
                    Renommer
                  </button>
                  <button @click="deleteFolder(contextMenu.folderId); contextMenu.show = false" class="flex items-center gap-2.5 w-full px-3.5 py-2 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M20.5 6H3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M18.833 8.5L18.373 15.4C18.197 18.054 18.109 19.381 17.243 20.19C16.378 21 15.048 21 12.388 21H11.612C8.952 21 7.622 21 6.757 20.19C5.891 19.381 5.803 18.054 5.627 15.4L5.167 8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Supprimer
                  </button>
                </div>
              </template>
            </div>

            <!-- Upload zone -->
            <div class="mt-8">
              <h3 class="text-sm font-semibold text-[#888ea8] mb-3 flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M12 15V3M12 3L8 7.5M12 3L16 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 17L2.621 19.485C2.72 19.878 2.769 20.074 2.871 20.226C2.96 20.361 3.082 20.471 3.224 20.545C3.385 20.63 3.585 20.66 3.984 20.72L11.326 21.82C11.549 21.854 11.661 21.87 11.774 21.876C11.874 21.881 11.974 21.881 12.074 21.876C12.187 21.87 12.298 21.854 12.522 21.82L19.864 20.72C20.263 20.66 20.462 20.63 20.624 20.545C20.766 20.471 20.888 20.361 20.977 20.226C21.079 20.074 21.128 19.878 21.227 19.485L21.848 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                Documents uploadés
                <span class="text-[10px] px-1.5 py-0.5 bg-gray-100 dark:bg-gray-700 rounded-full" x-text="uploadedDocs.length"></span>
              </h3>
              <div class="border-2 border-dashed rounded-xl p-6 text-center transition-all"
                :class="isDraggingFile ? 'border-primary bg-primary/5 dark:bg-primary/10' : 'border-[#e0e6ed] dark:border-gray-700 hover:border-primary/40'"
                @dragover.prevent="isDraggingFile = true"
                @dragleave.prevent="isDraggingFile = false"
                @drop.prevent="handleFileDrop($event); isDraggingFile = false">
                <template x-if="uploadedDocs.length === 0 && !isUploading">
                  <div>
                    <svg class="w-10 h-10 mx-auto mb-2 text-[#888ea8]/50" viewBox="0 0 24 24" fill="none"><path d="M12 15V3M12 3L8 7.5M12 3L16 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 17L2.621 19.485C2.72 19.878 2.769 20.074 2.871 20.226C2.96 20.361 3.082 20.471 3.224 20.545C3.385 20.63 3.585 20.66 3.984 20.72L11.326 21.82C11.549 21.854 11.661 21.87 11.774 21.876C11.874 21.881 11.974 21.881 12.074 21.876C12.187 21.87 12.298 21.854 12.522 21.82L19.864 20.72C20.263 20.66 20.462 20.63 20.624 20.545C20.766 20.471 20.888 20.361 20.977 20.226C21.079 20.074 21.128 19.878 21.227 19.485L21.848 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    <p class="text-sm text-[#888ea8] mb-1">Glissez-déposez vos fichiers ici</p>
                    <p class="text-[11px] text-[#888ea8]/70 mb-3">PDF, Word, Images, Excel...</p>
                    <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary/10 text-primary text-xs font-medium cursor-pointer hover:bg-primary/20 transition-colors">
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none"><path d="M12 15V3M12 3L8 7.5M12 3L16 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      Parcourir
                      <input type="file" multiple class="hidden" @change="handleFileSelect($event)">
                    </label>
                  </div>
                </template>
                <template x-if="uploadedDocs.length > 0 || isUploading">
                  <div class="text-left">
                    <div class="flex flex-wrap gap-3">
                      <template x-for="udoc in uploadedDocs" :key="udoc._id">
                        <a :href="udoc.uploadedFile?.path" target="_blank" class="group flex flex-col items-center w-[80px] py-2 px-1 rounded-lg hover:bg-gray-50 dark:hover:bg-[#1b2e4b]/40 transition-colors">
                          <div class="w-10 h-12 rounded-md flex items-center justify-center mb-1.5" :class="getFileIconClass(udoc.uploadedFile?.mimeType)">
                            <span class="text-[10px] font-bold uppercase" x-text="getFileExt(udoc.uploadedFile?.originalName)"></span>
                          </div>
                          <span class="text-[11px] text-gray-600 dark:text-gray-400 truncate w-full text-center" x-text="udoc.name"></span>
                        </a>
                      </template>
                      <label class="flex flex-col items-center justify-center w-[80px] py-2 px-1 rounded-lg border border-dashed border-[#e0e6ed] dark:border-gray-700 hover:border-primary/40 cursor-pointer transition-colors">
                        <svg class="w-6 h-6 text-[#888ea8]/50 mb-1" viewBox="0 0 24 24" fill="none"><path d="M12 8V16M8 12H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        <span class="text-[10px] text-[#888ea8]">Ajouter</span>
                        <input type="file" multiple class="hidden" @change="handleFileSelect($event)">
                      </label>
                    </div>
                    <template x-if="isUploading">
                      <div class="mt-3 flex items-center gap-2 text-xs text-primary">
                        <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                        Upload en cours...
                      </div>
                    </template>
                  </div>
                </template>
              </div>
            </div>

            <!-- Recent documents preview -->
            <div class="mt-6" x-show="getRecentDocs().length > 0">
              <h3 class="text-sm font-semibold text-[#888ea8] mb-3 flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 8V12L14.5 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Modifiés récemment
              </h3>
              <div class="panel p-0 overflow-hidden">
                <template x-for="(doc, idx) in getRecentDocs().slice(0, 5)" :key="doc._id">
                  <a :href="'/account/<%= account_number %>/documents/' + doc._id + '/edit-react'" class="flex items-center gap-3 px-4 py-3 hover:bg-[#f8f9fa] dark:hover:bg-[#1b2e4b]/50 transition-colors" :class="idx < 4 ? 'border-b border-[#e0e6ed] dark:border-[#1b2e4b]' : ''">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg flex-shrink-0" :class="doc.status === 'published' ? 'bg-success/10 text-success' : 'bg-warning/10 text-warning'">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M8 12H16M8 8H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="font-medium text-sm dark:text-white-light truncate" x-text="doc.name || 'Document sans titre'"></div>
                      <div class="text-[11px] text-[#888ea8]" x-text="formatDate(doc.updatedAt)"></div>
                    </div>
                    <span class="badge text-[10px]" :class="{'badge-outline-warning': doc.status === 'draft', 'badge-outline-success': doc.status === 'published'}" x-text="doc.status === 'draft' ? 'Brouillon' : doc.status === 'published' ? 'Publié' : 'Archivé'"></span>
                  </a>
                </template>
              </div>
            </div>
          </div>
        </template>
      </div>
      <!-- Document contents (shown when a folder is active) -->
      <template x-if="activeFolder !== null">
      <div class="space-y-6">
      <!-- Grid View with Time Grouping -->
      <template x-if="viewMode === 'grid'">
        <div class="space-y-6">

          <!-- Today -->
          <template x-if="getDocumentsByPeriod('today').length > 0">
            <div>
              <h3 class="text-sm font-semibold text-[#888ea8] mb-3 flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 8V12L14.5 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Aujourd'hui
                <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full" x-text="getDocumentsByPeriod('today').length"></span>
              </h3>
              <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-3">
                <template x-for="doc in getDocumentsByPeriod('today')" :key="doc._id">
                  <a :href="'/account/<%= account_number %>/documents/' + doc._id + '/edit-react'" class="panel p-4 hover:shadow-lg transition-all group relative border-l-[3px]" :class="{'border-l-warning': doc.status === 'draft', 'border-l-success': doc.status === 'published', 'border-l-secondary': doc.status === 'archived', 'border-l-primary': !doc.status}">
                    <div class="flex items-start justify-between mb-3">
                      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M8 12H16M8 8H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      </div>
                      <span class="badge text-xs" :class="{'badge-outline-warning': doc.status === 'draft', 'badge-outline-success': doc.status === 'published', 'badge-outline-secondary': doc.status === 'archived'}" x-text="doc.status === 'draft' ? 'Brouillon' : doc.status === 'published' ? 'Publié' : 'Archivé'"></span>
                    </div>
                    <h4 class="font-semibold dark:text-white-light mb-1 truncate" x-text="doc.name"></h4>
                    <p class="text-xs text-[#888ea8]" x-text="formatDate(doc.updatedAt)"></p>
                    <div class="absolute bottom-3 right-3 flex" x-data="{ count: (getDocumentsByPeriod('today').indexOf(doc) % 3) + 1, names: ['Marie L.', 'Jean D.', 'Sophie M.', 'Pierre B.', 'Emma R.'], groupHover: false, activeAvatar: null }" @mouseenter="groupHover = true" @mouseleave="groupHover = false; activeAvatar = null" :class="groupHover ? 'gap-1' : '-space-x-2'">
                      <template x-for="i in count" :key="i">
                        <div class="relative" @mouseenter="activeAvatar = i" @mouseleave="activeAvatar = null">
                          <img :src="'/assets/images/profile-' + (((getDocumentsByPeriod('today').indexOf(doc) * 3 + i) % 35) + 1) + '.jpeg'" class="w-6 h-6 rounded-full object-cover border-2 border-white dark:border-[#1b2e4b] transition-transform duration-200 cursor-pointer" :style="groupHover ? 'transform: scale(1.2); z-index: ' + (50 + i) : ''" alt="Collaborateur"/>
                          <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1 px-2 py-0.5 bg-dark text-white text-[9px] rounded whitespace-nowrap pointer-events-none transition-opacity duration-150" :class="activeAvatar === i ? 'opacity-100' : 'opacity-0'" style="z-index: 60;" x-text="names[(getDocumentsByPeriod('today').indexOf(doc) + i) % 5]"></div>
                        </div>
                      </template>
                    </div>
                  </a>
                </template>
              </div>
            </div>
          </template>

          <!-- Yesterday -->
          <template x-if="getDocumentsByPeriod('yesterday').length > 0">
            <div>
              <h3 class="text-sm font-semibold text-[#888ea8] mb-3 flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M7 12L10.5 15.5L17 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Hier
                <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full" x-text="getDocumentsByPeriod('yesterday').length"></span>
              </h3>
              <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-3">
                <template x-for="doc in getDocumentsByPeriod('yesterday')" :key="doc._id">
                  <a :href="'/account/<%= account_number %>/documents/' + doc._id + '/edit-react'" class="panel p-4 hover:shadow-lg transition-all group relative border-l-[3px]" :class="{'border-l-warning': doc.status === 'draft', 'border-l-success': doc.status === 'published', 'border-l-secondary': doc.status === 'archived', 'border-l-primary': !doc.status}">
                    <div class="flex items-start justify-between mb-3">
                      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M8 12H16M8 8H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      </div>
                      <span class="badge text-xs" :class="{'badge-outline-warning': doc.status === 'draft', 'badge-outline-success': doc.status === 'published', 'badge-outline-secondary': doc.status === 'archived'}" x-text="doc.status === 'draft' ? 'Brouillon' : doc.status === 'published' ? 'Publié' : 'Archivé'"></span>
                    </div>
                    <h4 class="font-semibold dark:text-white-light mb-1 truncate" x-text="doc.name"></h4>
                    <p class="text-xs text-[#888ea8]" x-text="formatDate(doc.updatedAt)"></p>
                    <div class="absolute bottom-3 right-3 flex -space-x-2">
                      <template x-for="i in Math.min((getDocumentsByPeriod('yesterday').indexOf(doc) % 3) + 1, 3)" :key="i">
                        <img :src="'/assets/images/profile-' + (((getDocumentsByPeriod('yesterday').indexOf(doc) * 3 + i) % 35) + 1) + '.jpeg'" class="w-6 h-6 rounded-full object-cover border-2 border-white dark:border-[#1b2e4b]" alt="Collaborateur"/>
                      </template>
                    </div>
                  </a>
                </template>
              </div>
            </div>
          </template>

          <!-- "Voir plus" button -->
          <template x-if="!showAllDocs && getOlderDocsCount() > 0">
            <div class="flex justify-center pt-2">
              <button @click="showAllDocs = true" class="group flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white dark:bg-[#1b2e4b] border border-[#e0e6ed] dark:border-[#1b2e4b] hover:border-primary/50 hover:shadow-md transition-all text-sm font-medium text-[#888ea8] hover:text-primary">
                <svg class="w-4 h-4 transition-transform group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none"><path d="M19 9L12 15L5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Voir plus
                <span class="text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary tabular-nums" x-text="getOlderDocsCount() + ' documents'"></span>
              </button>
            </div>
          </template>

          <!-- Older docs (hidden by default) -->
          <template x-if="showAllDocs">
            <div class="space-y-6">
              <!-- This Week -->
              <template x-if="getDocumentsByPeriod('week').length > 0">
                <div>
                  <h3 class="text-sm font-semibold text-[#888ea8] mb-3 flex items-center gap-2">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M2 12C2 8.22876 2 6.34315 3.17157 5.17157C4.34315 4 6.22876 4 10 4H14C17.7712 4 19.6569 4 20.8284 5.17157C22 6.34315 22 8.22876 22 12V14C22 17.7712 22 19.6569 20.8284 20.8284C19.6569 22 17.7712 22 14 22H10C6.22876 22 4.34315 22 3.17157 20.8284C2 19.6569 2 17.7712 2 14V12Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M7 4V2.5M17 4V2.5M2.5 9H21.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Cette semaine
                    <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full" x-text="getDocumentsByPeriod('week').length"></span>
                  </h3>
                  <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-3">
                    <template x-for="doc in getDocumentsByPeriod('week')" :key="doc._id">
                      <a :href="'/account/<%= account_number %>/documents/' + doc._id + '/edit-react'" class="panel p-4 hover:shadow-lg transition-all group relative border-l-[3px]" :class="{'border-l-warning': doc.status === 'draft', 'border-l-success': doc.status === 'published', 'border-l-secondary': doc.status === 'archived', 'border-l-primary': !doc.status}">
                        <div class="flex items-start justify-between mb-3">
                          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M8 12H16M8 8H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                          </div>
                          <span class="badge text-xs" :class="{'badge-outline-warning': doc.status === 'draft', 'badge-outline-success': doc.status === 'published', 'badge-outline-secondary': doc.status === 'archived'}" x-text="doc.status === 'draft' ? 'Brouillon' : doc.status === 'published' ? 'Publié' : 'Archivé'"></span>
                        </div>
                        <h4 class="font-semibold dark:text-white-light mb-1 truncate" x-text="doc.name"></h4>
                        <p class="text-xs text-[#888ea8]" x-text="formatDate(doc.updatedAt)"></p>
                        <div class="absolute bottom-3 right-3 flex -space-x-2">
                          <template x-for="i in Math.min((getDocumentsByPeriod('week').indexOf(doc) % 3) + 1, 3)" :key="i">
                            <img :src="'/assets/images/profile-' + (((getDocumentsByPeriod('week').indexOf(doc) * 3 + i) % 35) + 1) + '.jpeg'" class="w-6 h-6 rounded-full object-cover border-2 border-white dark:border-[#1b2e4b]" alt="Collaborateur"/>
                          </template>
                        </div>
                      </a>
                    </template>
                  </div>
                </div>
              </template>

              <!-- By Month -->
              <template x-for="month in getMonthGroups()" :key="month.key">
                <div>
                  <h3 class="text-sm font-semibold text-[#888ea8] mb-3 flex items-center gap-2">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M2 12C2 8.22876 2 6.34315 3.17157 5.17157C4.34315 4 6.22876 4 10 4H14C17.7712 4 19.6569 4 20.8284 5.17157C22 6.34315 22 8.22876 22 12V14C22 17.7712 22 19.6569 20.8284 20.8284C19.6569 22 17.7712 22 14 22H10C6.22876 22 4.34315 22 3.17157 20.8284C2 19.6569 2 17.7712 2 14V12Z" stroke="currentColor" stroke-width="1.5"/><path opacity="0.5" d="M7 4V2.5M17 4V2.5M2.5 9H21.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    <span x-text="month.label"></span>
                    <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full" x-text="month.docs.length"></span>
                  </h3>
                  <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-3">
                    <template x-for="doc in month.docs" :key="doc._id">
                      <a :href="'/account/<%= account_number %>/documents/' + doc._id + '/edit-react'" class="panel p-4 hover:shadow-lg transition-all group relative border-l-[3px]" :class="{'border-l-warning': doc.status === 'draft', 'border-l-success': doc.status === 'published', 'border-l-secondary': doc.status === 'archived', 'border-l-primary': !doc.status}">
                        <div class="flex items-start justify-between mb-3">
