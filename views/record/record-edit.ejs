        background: rgba(27, 46, 75, 0.4) !important;
    }
    [data-panel-id="attributs"] .form-input:focus,
    [data-panel-id="attributs"] .form-textarea:focus,
    [data-panel-id="attributs"] .form-select:focus,
    [data-panel-id="attributs"] input.form-input:focus,
    [data-panel-id="attributs"] textarea.form-textarea:focus,
    [data-panel-id="attributs"] select.form-select:focus {
        border-color: #4361ee !important;
        background: #fff !important;
