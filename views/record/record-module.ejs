                                <button @click="deleteConversation()" style="background:none;border:none;cursor:pointer;color:#ef4444;opacity:.5;transition:opacity .2s;" title="Supprimer">
                                    <iconify-icon icon="solar:trash-bin-trash-bold" width="18" @mouseover="$el.style.opacity=1" @mouseout="$el.style.opacity=.5"></iconify-icon>
                                </button>
                            </div>
                        </div>

                        <!-- Messages -->
                        <div class="chat-messages" x-ref="messagesContainer">
                            <template x-if="loadingMessages">
                                <div style="text-align:center;padding:20px;">
                                    <iconify-icon icon="line-md:loading-twotone-loop" width="22" style="color:#f97316"></iconify-icon>
                                </div>
                            </template>
                            <template x-for="msg in messages" :key="msg._id">
                                <div>
                                    <div class="chat-msg" :class="msg.senderId === currentUserId ? 'mine' : ''">
                                        <div class="chat-msg-avatar" x-text="(msg.senderName || '?')[0]"></div>
                                        <div>
                                            <div class="chat-msg-bubble" :class="isTaskMessage(msg.text) ? 'has-task' : ''" x-html="renderMessageHtml(msg.text)"></div>
                                            <div class="chat-msg-meta">
                                                <span x-text="msg.senderName"></span> · <span x-text="formatTime(msg.createdAt)"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </template>
                            <template x-if="!loadingMessages && messages.length === 0">
                                <div style="text-align:center;padding:40px;color:#bfc9d4;font-size:12px;">
                                    <iconify-icon icon="solar:chat-round-line-bold-duotone" width="28" style="opacity:.3"></iconify-icon>
                                    <p style="margin-top:8px;">Commencez la conversation...</p>
                                </div>
                            </template>
                        </div>

                        <!-- Input -->
                        <div class="chat-input-area">
                            <textarea class="chat-input" x-model="messageText" @keydown.enter.prevent="sendMessage()" placeholder="Écrire un message..." rows="1" x-ref="chatInput"></textarea>
                            <button class="chat-send-btn" @click="sendMessage()" :disabled="!messageText.trim()">
                                <iconify-icon icon="solar:plain-bold" width="18"></iconify-icon>
                            </button>
                        </div>
                    </div>
                </template>
            </div>

            <!-- ═══ Participants Panel ═══ -->
            <template x-if="showParticipants && activeConvId">
                <div class="chat-participants-panel">
                    <div class="chat-pp-header">
                        <span class="chat-pp-title">
                            <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="16" style="color:#f97316"></iconify-icon>
                            Participants
                        </span>
                        <button class="chat-pp-close" @click="showParticipants = false">
                            <iconify-icon icon="solar:close-circle-linear" width="16"></iconify-icon>
                        </button>
                    </div>

                    <!-- Success message -->
                    <template x-if="ppSuccess">
                        <div class="chat-pp-success" x-text="ppSuccess"></div>
                    </template>

                    <!-- Current participants -->
                    <div class="chat-pp-section">
                        <div class="chat-pp-section-title">
                            <iconify-icon icon="solar:user-check-rounded-bold" width="12"></iconify-icon>
                            Membres actuels (<span x-text="participants.length"></span>)
                        </div>
                        <template x-for="p in participants" :key="p.userId">
                            <div class="chat-pp-item">
                                <div class="chat-pp-avatar" :style="'background:' + ppAvatarColor(p.name)" x-text="(p.name || '?')[0]"></div>
                                <div class="chat-pp-info">
                                    <div class="chat-pp-name" x-text="p.name"></div>
                                    <div class="chat-pp-email" x-text="p.email"></div>
                                </div>
                                <span class="chat-pp-role" x-text="p.role"></span>
                                <button class="chat-pp-remove" @click="removeParticipant(p.userId)" title="Retirer" x-show="p.userId !== currentUserId">
                                    <iconify-icon icon="solar:close-circle-linear" width="14"></iconify-icon>
                                </button>
                            </div>
                        </template>
                        <div x-show="ppLoadingParticipants" style="text-align:center;padding:10px;">
                            <iconify-icon icon="line-md:loading-twotone-loop" width="18" style="color:#f97316"></iconify-icon>
                        </div>
                    </div>

                    <div class="chat-pp-divider"></div>

                    <!-- Search -->
                    <div class="chat-pp-section" style="padding-bottom:0;">
                        <input type="text" class="chat-pp-search" x-model="ppSearch" placeholder="Rechercher membres ou équipes..." />
                    </div>

                    <!-- Teams section -->
                    <div class="chat-pp-section" x-show="filteredTeams.length > 0">
                        <div class="chat-pp-section-title">
                            <iconify-icon icon="solar:users-group-two-rounded-bold" width="12"></iconify-icon>
                            Équipes
                        </div>
                        <template x-for="team in filteredTeams" :key="team._id">
                            <div class="chat-pp-team-item">
                                <div class="chat-pp-team-dot" :style="'background:' + (team.color || '#4361ee')"></div>
                                <div class="chat-pp-team-info">
                                    <div class="chat-pp-team-name" x-text="team.name"></div>
                                    <div class="chat-pp-team-count" x-text="(team.memberCount || 0) + ' membres'"></div>
                                </div>
                                <button class="chat-pp-team-add" @click="addTeam(team._id)" :disabled="ppAdding">
                                    <iconify-icon icon="solar:add-circle-bold" width="12"></iconify-icon>
                                    Ajouter
                                </button>
                            </div>
                        </template>
                    </div>

                    <!-- Individual members section -->
                    <div class="chat-pp-section" x-show="filteredNonParticipants.length > 0">
                        <div class="chat-pp-section-title">
                            <iconify-icon icon="solar:user-plus-rounded-bold" width="12"></iconify-icon>
                            Ajouter un membre
                        </div>
                        <template x-for="m in filteredNonParticipants" :key="m._id">
                            <div class="chat-pp-item" style="cursor:pointer;" @click="addParticipant(m._id)">
                                <div class="chat-pp-avatar" :style="'background:' + ppAvatarColor(m.name)" x-text="(m.name || '?')[0]"></div>
                                <div class="chat-pp-info">
                                    <div class="chat-pp-name" x-text="m.name"></div>
                                    <div class="chat-pp-email" x-text="m.email"></div>
                                </div>
                                <button class="chat-pp-add-btn" title="Ajouter">
                                    <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
                                </button>
                            </div>
                        </template>
                    </div>

                    <!-- Empty state -->
                    <div class="chat-pp-empty" x-show="filteredTeams.length === 0 && filteredNonParticipants.length === 0 && !ppLoadingParticipants">
                        Tous les membres sont déjà participants
                    </div>
                </div>
            </template>
        </div>

        <!-- Create conversation modal -->
        <template x-if="showCreate">
            <div class="chat-create-overlay" @click.self="showCreate = false">
                <div class="chat-create-modal">
                    <h3>
                        <iconify-icon icon="solar:chat-round-dots-bold-duotone" width="20" style="color:#f97316"></iconify-icon>
                        Nouvelle conversation
                    </h3>
                    <input type="text" class="chat-create-input" x-model="newConvName" placeholder="Nom de la conversation..." @keydown.enter="createConversation()" x-ref="createInput" autofocus>
                    <div class="chat-create-btns">
                        <button class="chat-create-cancel" @click="showCreate = false; newConvName = ''">Annuler</button>
                        <button class="chat-create-submit" @click="createConversation()" :disabled="!newConvName.trim() || creating">
                            <span x-text="creating ? 'Création...' : 'Créer'"></span>
                        </button>
                    </div>
                </div>
            </div>
        </template>
    </div>

    <script>
    document.addEventListener('alpine:init', () => {
        const _apiBase = '/account/<%= account_number %>/api/record/<%= record._id %>';
        const _currentUserId = '<%= typeof user !== "undefined" && user ? user._id : "" %>';

        Alpine.data('chatModule', () => ({
            conversations: [],
            messages: [],
            activeConvId: null,
            activeConv: null,
            loading: true,
            loadingMessages: false,
            messageText: '',
            showCreate: false,
            newConvName: '',
            creating: false,
            currentUserId: _currentUserId || (document.cookie.match(/userId=([^;]+)/) || [])[1] || '',
            // Participants panel
            showParticipants: false,
            participants: [],
            allMembers: [],
            allTeams: [],
            ppSearch: '',
            ppLoadingParticipants: false,
            ppAdding: false,
            ppSuccess: '',

            async init() {
                // Try to get currentUserId from page if not available
                if (!this.currentUserId) {
                    try {
                        const userEl = document.querySelector('[data-user-id]');
                        if (userEl) this.currentUserId = userEl.dataset.userId;
                    } catch(e) {}
                }
                await this.loadConversations();
                // Auto-scroll to the chat box and lock scroll there
                this.$nextTick(() => {
                    const chatEl = document.querySelector('.chat-wrap');
                    if (chatEl) {
                        const maxY = chatEl.getBoundingClientRect().top + window.scrollY - 75;
                        window.scrollTo({ top: maxY, behavior: 'smooth' });
                        // Lock: prevent scrolling past the chat box
                        window.addEventListener('scroll', function chatScrollLock() {
                            if (window.scrollY > maxY) window.scrollTo({ top: maxY });
                        });
                    }
                });
            },

            async loadConversations() {
                this.loading = true;
                try {
                    const res = await fetch(_apiBase + '/conversations', { credentials: 'include' });
                    const data = await res.json();
                    this.conversations = data.success ? data.conversations : [];
                } catch (e) {
                    console.error('[Chat] Load conversations error:', e);
                    this.conversations = [];
                }
                this.loading = false;
            },

            async selectConversation(conv) {
                this.activeConvId = conv._id;
                this.activeConv = conv;
                this.loadingMessages = true;
                this.messages = [];

                try {
                    const res = await fetch(_apiBase + '/conversations/' + conv._id, { credentials: 'include' });
                    const data = await res.json();
                    if (data.success) {
                        this.messages = data.messages || [];
                        this.activeConv = data.conversation;
                    }
                } catch (e) {
                    console.error('[Chat] Load messages error:', e);
                }
                this.loadingMessages = false;
                this.$nextTick(() => this.scrollToBottom());
            },

            async sendMessage() {
                const text = this.messageText.trim();
                if (!text || !this.activeConvId) return;

                // Optimistic add
                const tempMsg = {
                    _id: 'temp_' + Date.now(),
                    conversationId: this.activeConvId,
                    senderId: this.currentUserId,
                    senderName: 'Moi',
                    text: text,
                    createdAt: new Date().toISOString()
                };
                this.messages.push(tempMsg);
                this.messageText = '';
                this.$nextTick(() => this.scrollToBottom());

                try {
                    const res = await fetch(_apiBase + '/conversations/' + this.activeConvId + '/messages', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ text })
                    });
                    const data = await res.json();
                    if (data.success && data.message) {
                        // Replace temp with real message
                        const idx = this.messages.findIndex(m => m._id === tempMsg._id);
                        if (idx !== -1) this.messages[idx] = data.message;

                        // Update conversation preview in sidebar
                        const conv = this.conversations.find(c => c._id === this.activeConvId);
                        if (conv) {
                            conv.lastMessage = { text, sentAt: data.message.createdAt, senderName: data.message.senderName };
                        }
                    }
                } catch (e) {
                    console.error('[Chat] Send error:', e);
                }
            },

            async createConversation() {
                if (!this.newConvName.trim() || this.creating) return;
                this.creating = true;

                try {
                    const res = await fetch(_apiBase + '/conversations', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ name: this.newConvName.trim() })
                    });
                    const data = await res.json();
                    if (data.success && data.conversation) {
                        this.conversations.unshift(data.conversation);
                        this.showCreate = false;
                        this.newConvName = '';
                        this.selectConversation(data.conversation);
                    }
                } catch (e) {
                    console.error('[Chat] Create error:', e);
                }
                this.creating = false;
            },

            async deleteConversation() {
                if (!this.activeConvId) return;
                if (!confirm('Supprimer cette conversation et tous ses messages ?')) return;

                try {
                    await fetch(_apiBase + '/conversations/' + this.activeConvId, {
                        method: 'DELETE',
                        credentials: 'include'
                    });
                    this.conversations = this.conversations.filter(c => c._id !== this.activeConvId);
                    this.activeConvId = null;
                    this.activeConv = null;
                    this.messages = [];
                } catch (e) {
                    console.error('[Chat] Delete error:', e);
                }
            },

            scrollToBottom() {
                const container = this.$refs.messagesContainer;
                if (container) container.scrollTop = container.scrollHeight;
            },

            isTaskMessage(text) {
                if (!text) return false;
                return /^__TASK__/.test(text) || /^💬\s*\[/.test(text);
            },

            renderMessageHtml(text) {
                if (!text) return '';
                // Detect new format: __TASK__taskId|TaskTitle__END__\nComment
                const taskMatch = text.match(/^__TASK__(?:([a-f0-9]{24})\|)?(.+?)__END__\n?([\s\S]*)$/);
                if (taskMatch) {
                    const taskId = taskMatch[1] || '';
                    const taskTitle = taskMatch[2].replace(/</g, '&lt;').replace(/>/g, '&gt;');
                    const comment = (taskMatch[3] || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                    // Dispatch event to open task detail modal in-place (no navigation)
                    const clickAction = taskId
                        ? `window.dispatchEvent(new CustomEvent('open-task-detail', { detail: { taskId: '${taskId}' } }))`
                        : `window.location.href='${window.location.pathname.replace(/\/[^/]*$/, '/tasks')}'`;
                    return `<div class="chat-task-quote" onclick="${clickAction}">` +
                        `<span class="chat-task-quote-icon"><iconify-icon icon="solar:checklist-minimalistic-bold" width="13"></iconify-icon></span>` +
                        `<span class="chat-task-quote-title">${taskTitle}</span>` +
                        `<span class="chat-task-quote-arrow"><iconify-icon icon="solar:arrow-right-linear" width="11"></iconify-icon></span>` +
                    `</div>` +
                    `<div class="chat-task-text">${comment}</div>`;
                }
                // Legacy format: 💬 [TaskTitle] Comment — navigate to tasks tab
                const legacyMatch = text.match(/^💬\s*\[(.+?)\]\s*([\s\S]*)$/);
                if (legacyMatch) {
                    const taskTitle = legacyMatch[1].replace(/</g, '&lt;').replace(/>/g, '&gt;');
                    const comment = (legacyMatch[2] || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                    const tasksUrl = window.location.pathname.replace(/\/[^/]*$/, '/tasks');
                    return `<div class="chat-task-quote" onclick="window.location.href='${tasksUrl}'">` +
                        `<span class="chat-task-quote-icon"><iconify-icon icon="solar:checklist-minimalistic-bold" width="13"></iconify-icon></span>` +
                        `<span class="chat-task-quote-title">${taskTitle}</span>` +
                        `<span class="chat-task-quote-arrow"><iconify-icon icon="solar:arrow-right-linear" width="11"></iconify-icon></span>` +
                    `</div>` +
                    `<div class="chat-task-text">${comment}</div>`;
                }
                // Regular message
                return text.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>');
            },

            cleanPreviewText(text) {
                if (!text) return '';
                // Strip __TASK__[id|]title__END__ markers for sidebar preview
                const taskMatch = text.match(/^__TASK__(?:[a-f0-9]{24}\|)?(.+?)__END__\n?([\s\S]*)$/);
                if (taskMatch) return `📋 ${taskMatch[1]}: ${taskMatch[2]}`;
                return text;
            },

            // ═══ Participants panel methods ═══
            async toggleParticipants() {
                this.showParticipants = !this.showParticipants;
                if (this.showParticipants) {
                    await this.loadParticipantsPanel();
                }
            },

            async loadParticipantsPanel() {
                this.ppLoadingParticipants = true;
                this.ppSuccess = '';
                try {
                    // Load current participants
                    const pRes = await fetch(_apiBase + '/conversations/' + this.activeConvId + '/participants', { credentials: 'include' });
                    const pData = await pRes.json();
                    if (pData.success) this.participants = pData.participants || [];

                    // Load all account members
                    const mRes = await fetch('/account/<%= account_number %>/api/team/members', { credentials: 'include' });
                    const mData = await mRes.json();
                    if (mData.success) {
                        this.allMembers = mData.members || [];
                        this.allTeams = mData.teams || [];
                    }
                } catch (e) {
                    console.error('[Chat] Load participants error:', e);
                }
                this.ppLoadingParticipants = false;
            },

            get filteredTeams() {
                const q = (this.ppSearch || '').toLowerCase();
                let teams = this.allTeams || [];
                if (q) teams = teams.filter(t => (t.name || '').toLowerCase().includes(q));
                return teams;
            },

            get filteredNonParticipants() {
                const q = (this.ppSearch || '').toLowerCase();
                const participantIds = this.participants.map(p => p.userId);
                let members = (this.allMembers || []).filter(m => !participantIds.includes(String(m._id)));
                if (q) members = members.filter(m => (m.name || '').toLowerCase().includes(q) || (m.email || '').toLowerCase().includes(q));
                return members;
            },

            async addParticipant(userId) {
                if (this.ppAdding) return;
                this.ppAdding = true;
                this.ppSuccess = '';
                try {
                    const res = await fetch(_apiBase + '/conversations/' + this.activeConvId + '/add-participant', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ userId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.ppSuccess = data.message || 'Membre ajouté';
                        await this.loadParticipantsPanel();
                        // Update header count
                        if (this.activeConv) this.activeConv.participants = this.participants;
                        setTimeout(() => this.ppSuccess = '', 3000);
                    }
                } catch (e) {
                    console.error('[Chat] Add participant error:', e);
                }
                this.ppAdding = false;
            },

            async addTeam(teamId) {
                if (this.ppAdding) return;
                this.ppAdding = true;
                this.ppSuccess = '';
                try {
                    const res = await fetch(_apiBase + '/conversations/' + this.activeConvId + '/add-team', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ teamId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.ppSuccess = data.message || 'Équipe ajoutée';
                        await this.loadParticipantsPanel();
                        if (this.activeConv) this.activeConv.participants = this.participants;
                        setTimeout(() => this.ppSuccess = '', 3000);
                    }
                } catch (e) {
                    console.error('[Chat] Add team error:', e);
                }
                this.ppAdding = false;
            },

            async removeParticipant(userId) {
                if (this.ppAdding) return;
                this.ppAdding = true;
                try {
                    const res = await fetch(_apiBase + '/conversations/' + this.activeConvId + '/remove-participant', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ userId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        await this.loadParticipantsPanel();
                        if (this.activeConv) this.activeConv.participants = this.participants;
                    }
                } catch (e) {
                    console.error('[Chat] Remove participant error:', e);
                }
                this.ppAdding = false;
            },

            ppAvatarColor(name) {
                const colors = ['#4361ee','#10b981','#f97316','#8b5cf6','#ec4899','#06b6d4','#f59e0b','#ef4444'];
                let hash = 0;
                for (let i = 0; i < (name || '').length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
                return colors[Math.abs(hash) % colors.length];
            },

            formatTime(dateStr) {
                if (!dateStr) return '';
                const d = new Date(dateStr);
                const now = new Date();
                const diffMs = now - d;
                const diffMins = Math.floor(diffMs / 60000);
                if (diffMins < 1) return 'à l\'instant';
                if (diffMins < 60) return diffMins + ' min';
                const diffHrs = Math.floor(diffMins / 60);
                if (diffHrs < 24) return diffHrs + 'h';
                return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
            }
        }));
    });
    </script>
    <% } %>

    <% if (moduleName === 'fiche' || moduleName === 'overview') { %>
    <script>
    if (!window.__destroyAppContextMenu) {
        window.__destroyAppContextMenu = function() {
            if (window.__appContextMenuCloseHandler) {
                document.removeEventListener('click', window.__appContextMenuCloseHandler, true);
                document.removeEventListener('contextmenu', window.__appContextMenuCloseHandler, true);
                window.__appContextMenuCloseHandler = null;
            }
            if (window.__appContextMenuEl) {
                window.__appContextMenuEl.remove();
                window.__appContextMenuEl = null;
            }
        };
    }
    if (!window.__showAppContextMenu) {
        window.__showAppContextMenu = function(x, y, items) {
            window.__destroyAppContextMenu();
            const isDark = document.documentElement.classList.contains('dark') || document.body.classList.contains('dark');
            const menu = document.createElement('div');
            menu.style.cssText = `position:fixed; top:${y}px; left:${x}px; z-index:99999; min-width:208px; border-radius:12px; border:1px solid ${isDark ? '#374151' : '#e5e7eb'}; background:${isDark ? '#1b2e4b' : '#fff'}; box-shadow:0 10px 25px rgba(0,0,0,0.15); padding:6px 0;`;
            items.forEach(item => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.style.cssText = 'width:100%; display:flex; align-items:center; gap:12px; padding:10px 16px; font-size:14px; border:none; background:none; cursor:pointer; transition:all .2s ease;';
                btn.style.color = item.danger ? '#ef4444' : (isDark ? '#d1d5db' : '#374151');
                btn.innerHTML = `<iconify-icon icon="${item.icon}" width="18" style="color:${item.iconColor || 'inherit'}"></iconify-icon> ${item.label}`;
                btn.addEventListener('mouseenter', () => {
                    if (!btn._confirming) btn.style.background = item.danger ? (isDark ? 'rgba(239,68,68,.1)' : '#fef2f2') : (isDark ? '#1f2937' : '#f3f4f6');
                });
                btn.addEventListener('mouseleave', () => {
                    if (!btn._confirming) btn.style.background = 'none';
                });
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (item.danger && item.confirm !== false) {
                        if (!btn._confirming) {
                            btn._confirming = true;
                            btn.innerHTML = '<iconify-icon icon="solar:danger-triangle-bold-duotone" width="18" style="color:#ef4444"></iconify-icon> Confirmer ?';
                            btn.style.background = isDark ? 'rgba(239,68,68,.15)' : '#fef2f2';
                            btn.style.fontWeight = '600';
                            btn._resetTimer = setTimeout(() => {
                                btn._confirming = false;
                                btn.innerHTML = `<iconify-icon icon="${item.icon}" width="18" style="color:${item.iconColor || 'inherit'}"></iconify-icon> ${item.label}`;
                                btn.style.background = 'none';
                                btn.style.fontWeight = 'normal';
                            }, 3000);
                            return;
                        }
                        clearTimeout(btn._resetTimer);
                    }
                    window.__destroyAppContextMenu();
                    item.action();
                });
                menu.appendChild(btn);
            });
            document.body.appendChild(menu);
            const width = menu.offsetWidth || 208;
            const height = menu.offsetHeight || 48;
            menu.style.left = Math.max(8, Math.min(x || 8, window.innerWidth - width - 8)) + 'px';
            menu.style.top = Math.max(8, Math.min(y || 8, window.innerHeight - height - 8)) + 'px';
            window.__appContextMenuEl = menu;
            const closeHandler = (evt) => {
                if (!menu.contains(evt.target)) window.__destroyAppContextMenu();
            };
            window.__appContextMenuCloseHandler = closeHandler;
            setTimeout(() => {
                document.addEventListener('click', closeHandler, true);
                document.addEventListener('contextmenu', closeHandler, true);
            }, 0);
        };
    }
    document.addEventListener('alpine:init', () => {
        const _recUrl = '/account/<%= account_number %>/record/<%= entity.slug %>/<%= record._id %>';
        const _prefsUrl = '/account/<%= account_number %>/api/user/view-preferences';
        const _ficheViewId = 'fiche-<%= entity.slug %>';
        const _ficheAccountNumber = '<%= account_number %>';
        const _ficheEntityId = '<%= entity._id %>';
        const _initialHidden = <%- JSON.stringify((typeof fichePreferences !== 'undefined' && fichePreferences.hiddenFields) ? fichePreferences.hiddenFields : []) %>;
        const _ficheRecordModuleCanEdit = <%= _canEditCurrentModule ? 'true' : 'false' %>;

        // Fiche config component (root-level)
        Alpine.data('ficheConfig', () => ({
            configMode: false,
            hiddenFields: [..._initialHidden],
            deletingFieldKey: '',
            _sortableInstance: null,
            _saveTimer: null,

            toggleConfig() {
                if (!_ficheRecordModuleCanEdit) return;
                this.configMode = !this.configMode;
                if (this.configMode) {
                    this.$nextTick(() => this._initSortable());
                } else {
                    this._destroySortable();
                    if (this._saveTimer) {
                        clearTimeout(this._saveTimer);
                        this._saveTimer = null;
                    }
                    this._savePreferences();
                }
            },

            isFieldHidden(key) {
                return this.hiddenFields.includes(key);
            },

            toggleFieldVisibility(key) {
                if (this.hiddenFields.includes(key)) {
                    this.hiddenFields = this.hiddenFields.filter(k => k !== key);
                } else {
                    this.hiddenFields.push(key);
                }
            },

            async deleteField(key, label) {
                if (!this.configMode || this.deletingFieldKey) return;
                const fieldLabel = label || 'ce champ';
                const confirmed = window.confirm(
                    `Supprimer le champ "${fieldLabel}" ?\n\nIl sera retire de cette entite et ses valeurs seront supprimees des fiches existantes.`
                );
                if (!confirmed) return;

                this.deletingFieldKey = key;
                this._destroySortable();
                try {
                    const res = await fetch(`/account/${_ficheAccountNumber}/entity/api/${_ficheEntityId}/remove-field`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ fieldId: key, deleteValues: true })
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok || !data.success) {
                        throw new Error(data.error || 'Suppression impossible');
                    }

                    this.hiddenFields = this.hiddenFields.filter(k => k !== key);
                    const list = this.$refs.ficheFieldsList;
                    const item = list ? [...list.querySelectorAll('.ov-ef[data-field-key]')].find(el => el.dataset.fieldKey === key) : null;
                    if (item) item.remove();
                    await this._savePreferences();

                    if (window.showMessage) window.showMessage('Champ supprime', 'success');
                    window.location.reload();
                } catch (e) {
                    console.error('[FicheConfig] Delete field error:', e);
                    if (window.showMessage) window.showMessage(e.message || 'Erreur lors de la suppression', 'danger');
                    else alert(e.message || 'Erreur lors de la suppression');
                    if (this.configMode) this.$nextTick(() => this._initSortable());
                } finally {
                    this.deletingFieldKey = '';
                }
            },

            resetLayout() {
                this.hiddenFields = [];
                // Save empty preferences (reset)
                this._savePreferences(true);
            },

            _getFieldItems() {
                const list = this.$refs.ficheFieldsList;
                if (!list) return [];
                return [...list.querySelectorAll(':scope > .ov-ef[data-field-key]')]
                    .filter(el => !el.classList.contains('sortable-fallback'));
            },

            _getFieldOrder() {
                return this._getFieldItems().map(el => el.dataset.fieldKey);
            },

            _applyFieldOrder(order) {
                const list = this.$refs.ficheFieldsList;
                if (!list || !Array.isArray(order)) return;
                const items = this._getFieldItems();
                const byKey = new Map(items.map(el => [el.dataset.fieldKey, el]));
                const seen = new Set();
                const fragment = document.createDocumentFragment();

                order.forEach(key => {
                    const el = byKey.get(key);
                    if (!el || seen.has(key)) return;
                    fragment.appendChild(el);
                    seen.add(key);
                });

                items.forEach(el => {
                    const key = el.dataset.fieldKey;
                    if (!seen.has(key)) fragment.appendChild(el);
                });

                list.appendChild(fragment);
            },

            _savePreferencesSoon() {
                if (this._saveTimer) clearTimeout(this._saveTimer);
                this._saveTimer = setTimeout(() => {
                    this._saveTimer = null;
                    this._savePreferences();
                }, 250);
            },

            _initSortable() {
                const list = this.$refs.ficheFieldsList;
                if (!list) {
                    console.warn('[FicheConfig] ficheFieldsList ref not found');
                    return;
                }
                if (this._sortableInstance) return;
                if (typeof Sortable === 'undefined') {
                    console.warn('[FicheConfig] SortableJS not loaded');
                    return;
                }
                this._sortableInstance = Sortable.create(list, {
                    animation: 200,
                    handle: '.fiche-drag-handle',
                    draggable: '.ov-ef[data-field-key]',
                    ghostClass: 'sortable-ghost',
                    chosenClass: 'sortable-chosen',
                    dragClass: 'sortable-drag',
                    direction: 'vertical',
                    swapThreshold: 0.65,
                    fallbackTolerance: 4,
                    onEnd: (evt) => {
                        const movedKey = evt.item && evt.item.dataset ? evt.item.dataset.fieldKey : '';
                        if (!movedKey) return;

                        const order = this._getFieldOrder().filter(key => key !== movedKey);
                        let newIndex = this._getFieldItems().findIndex(el => el.dataset.fieldKey === movedKey);
                        if (newIndex < 0) newIndex = evt.newIndex || 0;
                        order.splice(newIndex, 0, movedKey);
                        this._applyFieldOrder(order);
                        this._savePreferencesSoon();
                    }
                });
                console.log('[FicheConfig] SortableJS initialized on', this._getFieldItems().length, 'fields');
            },

            _destroySortable() {
                if (this._sortableInstance) {
                    this._sortableInstance.destroy();
                    this._sortableInstance = null;
                }
            },

            async _savePreferences(isReset) {
                const fieldOrder = isReset ? [] : this._getFieldOrder();
                const hiddenFields = isReset ? [] : [...this.hiddenFields];
                try {
                    await fetch(_prefsUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({
                            viewId: _ficheViewId,
                            preferences: {
                                ficheLayout: { fieldOrder, hiddenFields }
                            }
                        })
                    });
                } catch (e) { console.error('[FicheConfig] Save error:', e); }
            },

            // ── Inline Edit (merged from ovInlineEdit) ──
            editingKey: '',
            saving: false,
            startEdit(key, e) {
                if (!_ficheRecordModuleCanEdit) return;
                if (this.configMode) return;
                if (this.editingKey === key) return;
                if (this.editingKey) this._doSave(this.editingKey);
                this.editingKey = key;
                this.$nextTick(() => {
                    const ref = this.$refs['input_' + key];
                    if (ref) ref.focus();
                });
            },
            cancelEdit() { this.editingKey = ''; },
            autoSave(key) {
                if (this.editingKey !== key) return;
                this._doSave(key);
            },
            saveCurrentField() {
                if (!this.editingKey) return;
                this._doSave(this.editingKey);
            },
            _doSave(key) {
                const ref = this.$refs['input_' + key];
                if (!ref) { this.editingKey = ''; return; }
                this.saveField(key, ref.type === 'checkbox' ? ref.checked : ref.value);
            },
            async saveField(key, value) {
                if (!_ficheRecordModuleCanEdit) return;
                if (this.saving) return;
                this.saving = true;
                const editingK = key;
                try {
                    const res = await fetch(_recUrl + '/update-field', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ fieldKey: key, value })
                    });
                    if (res.ok) {
                        const fieldEl = document.querySelector('.ov-ef[data-key="' + editingK + '"]');
                        if (fieldEl) {
                            const viewEl = fieldEl.querySelector('.ov-ef-view');
                            if (viewEl) {
                                const isBool = typeof value === 'boolean';
                                const displayVal = Array.isArray(value) ? value.join(', ') : (isBool ? (value ? 'Oui' : 'Non') : (value || ''));
                                if (isBool) {
                                    viewEl.innerHTML = '<span class="ov-bool-pill ' + (value ? 'ov-bool-pill--on' : 'ov-bool-pill--off') + '"><span class="ov-bool-dot" style="background:' + (value ? '#10b981' : '#cbd5e1') + '"></span>' + displayVal + '</span>';
                                } else if (displayVal) {
                                    viewEl.innerHTML = '<span class="ov-ef-val">' + String(displayVal).replace(/</g,'&lt;') + '</span>';
                                } else {
                                    viewEl.innerHTML = '<span class="ov-placeholder">' + (fieldEl.querySelector('.ov-ef-label')?.textContent || 'Valeur') + '</span>';
                                }
                                if (editingK === 'title') {
                                    const heroTitle = document.getElementById('record-hero-title');
                                    if (heroTitle) heroTitle.textContent = displayVal || 'Sans titre';
                                }
                            }
                        }
                        this.editingKey = '';
                    }
                } catch (e) { console.error('[Fiche save]', e); }
                this.saving = false;
            }
        }));

        // ─── Field Picker Modal (inline add field from fiche) ───
        const _entityId = '<%= entity._id %>';
        const _acn = '<%= account_number %>';
        const _entityCustomFieldIds = <%- JSON.stringify((entity.customFields || []).map(f => (f._id || f).toString())) %>;

        Alpine.data('ficheFieldPicker', () => ({
            isOpen: false,
            mode: 'create',
            step: 1,
            selectedType: {},
            editingFieldId: '',
            editingTypeConfig: {},
            allSystemFields: [],
            existingFields: [],
            allEntities: [],
            loadingFields: false,
            searchQ: '',
            addingId: null,
            creating: false,
            newFieldLabel: '',
            newFieldOptions: '',
            newFieldUseAsPipeline: false,
            newFieldTargetEntity: '',

            fieldTypes: [
                { key: 'string',      label: 'Texte court',    desc: 'Nom, titre, référence',           icon: 'solar:text-bold-duotone',                    color: '#3b82f6', type: 'string' },
                { key: 'text',        label: 'Texte long',     desc: 'Description, notes',              icon: 'solar:document-text-bold-duotone',           color: '#6366f1', type: 'text' },
                { key: 'number',      label: 'Nombre',         desc: 'Quantité, montant, prix',         icon: 'solar:calculator-bold-duotone',              color: '#f59e0b', type: 'number' },
                { key: 'date',        label: 'Date',           desc: 'Date, échéance, rappel',          icon: 'solar:calendar-bold-duotone',                color: '#14b8a6', type: 'date' },
                { key: 'select',      label: 'Liste déroulante', desc: 'Statut, catégorie, priorité',   icon: 'solar:list-check-bold-duotone',              color: '#8b5cf6', type: 'select' },
                { key: 'multiselect', label: 'Multi-sélection',  desc: 'Tags, compétences',             icon: 'solar:checklist-minimalistic-bold-duotone',  color: '#ec4899', type: 'select', subtype: 'multi' },
                { key: 'email',       label: 'Email',          desc: 'Adresse email',                   icon: 'solar:letter-bold-duotone',                  color: '#0ea5e9', type: 'string', subtype: 'email' },
                { key: 'tel',         label: 'Téléphone',      desc: 'Numéro de téléphone',             icon: 'solar:phone-bold-duotone',                   color: '#10b981', type: 'string', subtype: 'tel' },
                { key: 'url',         label: 'URL / Lien',     desc: 'Site web, LinkedIn',              icon: 'solar:global-bold-duotone',                  color: '#f97316', type: 'string', subtype: 'url' },
                { key: 'boolean',     label: 'Case à cocher',  desc: 'Oui / Non, Actif / Inactif',     icon: 'solar:check-circle-bold-duotone',            color: '#22c55e', type: 'boolean' },
                { key: 'image',       label: 'Image',          desc: 'Photo, avatar, logo',             icon: 'solar:camera-bold-duotone',                  color: '#e11d48', type: 'image' },
                { key: 'gallery',     label: 'Galerie',        desc: 'Plusieurs images',                icon: 'solar:gallery-wide-bold-duotone',            color: '#db2777', type: 'gallery' },
                { key: 'file',        label: 'Fichier',        desc: 'Document, PDF, pièce jointe',     icon: 'solar:file-bold-duotone',                    color: '#64748b', type: 'file' },
                { key: 'relation',    label: 'Relation',       desc: 'Lien vers une autre entité',      icon: 'solar:link-round-angle-bold-duotone',        color: '#7c3aed', type: 'relation' },
                { key: 'monetary',    label: 'Monétaire',      desc: 'Prix, coût, budget',              icon: 'solar:dollar-bold-duotone',                  color: '#059669', type: 'number', subtype: 'currency' },
                { key: 'map',         label: 'Adresse / Map',  desc: 'Localisation, adresse',           icon: 'solar:map-point-bold-duotone',               color: '#dc2626', type: 'map' },
            ],

            get filteredExisting() {
                if (!this.searchQ.trim()) return this.existingFields;
                const q = this.searchQ.toLowerCase();
                return this.existingFields.filter(f =>
                    (f.label || '').toLowerCase().includes(q) ||
                    (f.name || '').toLowerCase().includes(q)
                );
            },

            openModal() {
                if (!_ficheRecordModuleCanEdit) return;
                this.isOpen = true;
                this.mode = 'create';
                this.step = 1;
                this.selectedType = {};
                this.editingFieldId = '';
                this.editingTypeConfig = {};
                this.searchQ = '';
                this.newFieldLabel = '';
                this.newFieldOptions = '';
                this.newFieldUseAsPipeline = false;
                this.newFieldTargetEntity = '';
                document.body.style.overflow = 'hidden';
                // Fetch all entities for relation picker
                this._fetchEntities();
            },

            openEdit(field) {
                if (!_ficheRecordModuleCanEdit || !field?.id) return;
                const typeConfig = field.typeConfig || {};
                this.isOpen = true;
                this.mode = 'edit';
                this.step = 2;
                this.editingFieldId = field.id;
                this.editingTypeConfig = typeConfig;
                this.selectedType = this._typeForField(field);
                this.searchQ = '';
                this.existingFields = [];
                this.loadingFields = false;
                this.newFieldLabel = field.label || '';
                this.newFieldOptions = this._optionsToLines(field.options || typeConfig.options || []);
                this.newFieldUseAsPipeline = !!typeConfig.useAsPipeline;
                this.newFieldTargetEntity = field.targetEntityId || typeConfig.refEntity || '';
                document.body.style.overflow = 'hidden';
                this._fetchEntities();
            },

            closeModal() {
                this.isOpen = false;
                document.body.style.overflow = '';
            },

            async selectType(t) {
                this.selectedType = t;
                this.step = 2;
                this.searchQ = '';
                this.newFieldLabel = '';
                this.newFieldOptions = '';
                this.newFieldUseAsPipeline = false;
                this.newFieldTargetEntity = '';
                await this._fetchFieldsForType(t);
            },

            _typeForField(field) {
                const type = String(field.type || '').toLowerCase();
                const inputType = String(field.inputType || '').toLowerCase();
                const subtype = String(field.subtype || '').toLowerCase();
                const typeConfig = field.typeConfig || {};
                const key = (type === 'select' && (inputType === 'multiselect' || typeConfig.multiple || subtype === 'multi'))
                    ? 'multiselect'
                    : (inputType === 'multiselect'
                        ? 'multiselect'
                        : (type === 'relation' || inputType === 'relation'
                            ? 'relation'
                            : (type === 'select' || inputType === 'select' ? 'select' : type || inputType || 'string')));
                return this.fieldTypes.find(t => t.key === key)
                    || this.fieldTypes.find(t => t.type === type && (!t.subtype || t.subtype === subtype))
                    || this.fieldTypes[0];
            },

            _optionsToLines(options) {
                return (options || [])
                    .map(option => {
                        if (option && typeof option === 'object') return option.label || option.value || '';
                        return option || '';
                    })
                    .filter(Boolean)
                    .join('\n');
            },

            _buildTypeConfig() {
                const typeConfig = {};
                if (this.selectedType.key === 'select' || this.selectedType.key === 'multiselect') {
                    const previousOptions = Array.isArray(this.editingTypeConfig.options) ? this.editingTypeConfig.options : [];
                    const options = this.newFieldOptions.trim().split('\n')
                        .map(o => o.trim()).filter(Boolean)
                        .map((label, index) => {
                            const previous = previousOptions.find(option => {
                                if (!option || typeof option !== 'object') return option === label;
                                return option.label === label || option.value === label;
                            }) || previousOptions[index];
                            if (previous && typeof previous === 'object') {
                                return {
                                    label,
                                    value: previous.value || label,
                                    color: previous.color,
                                    order: index
                                };
                            }
                            return { label, value: label, order: index };
                        });
                    typeConfig.options = options;
                    if (this.selectedType.key === 'multiselect') {
                        typeConfig.multiple = true;
                    } else {
                        typeConfig.useAsPipeline = !!this.newFieldUseAsPipeline;
                    }
                }
                if (this.selectedType.key === 'relation' && this.newFieldTargetEntity) {
                    typeConfig.refEntity = this.newFieldTargetEntity;
                }
                return typeConfig;
            },

            async _fetchFieldsForType(t) {
                this.loadingFields = true;
                this.existingFields = [];
                try {
                    // Use the system fields API
                    if (this.allSystemFields.length === 0) {
                        const res = await fetch(`/account/${_acn}/field-template/api/system`, { credentials: 'include' });
                        const groups = await res.json();
                        // Flatten all groups into a single array
                        this.allSystemFields = groups.flatMap(g => g.fields || []);
                    }

                    // Filter fields matching the selected type that are NOT already on this entity
                    this.existingFields = this.allSystemFields.filter(f => {
                        // Match by type
                        const typeMatch = f.type === t.type;
                        // Match by subtype if specified
                        const subtypeMatch = !t.subtype || f.subtype === t.subtype;
                        // Not already on entity
                        const notOnEntity = !_entityCustomFieldIds.includes(f._id);
                        return typeMatch && subtypeMatch && notOnEntity;
                    });
                } catch (e) {
                    console.error('[FieldPicker] Fetch error:', e);
                } finally {
                    this.loadingFields = false;
                }
            },

            async _fetchEntities() {
                if (this.allEntities.length > 0) return;
                try {
                    const res = await fetch(`/account/${_acn}/entity/api/list`, { credentials: 'include' });
                    this.allEntities = await res.json();
                } catch (e) { console.error('[FieldPicker] Entities fetch error:', e); }
            },

            async addExistingField(fieldId) {
                this.addingId = fieldId;
                try {
                    const res = await fetch(`/account/${_acn}/entity/api/${_entityId}/add-field`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ fieldId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        // Reload page to show new field
                        this.closeModal();
                        window.location.reload();
                    } else {
                        window.showMessage ? window.showMessage(data.error || 'Erreur lors de l\'ajout', 'danger') : alert(data.error || 'Erreur lors de l\'ajout');
                    }
                } catch (e) {
                    console.error('[FieldPicker] Add field error:', e);
                    window.showMessage ? window.showMessage('Erreur réseau', 'danger') : alert('Erreur réseau');
                } finally {
                    this.addingId = null;
                }
            },

            async createAndAdd() {
                if (!this.newFieldLabel.trim()) return;
                this.creating = true;

                try {
                    if (this.mode === 'edit') {
                        const typeConfig = this._buildTypeConfig();
                        const updateRes = await fetch(`/account/${_acn}/field-template/api/${this.editingFieldId}/update`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                label: this.newFieldLabel.trim(),
                                typeConfig: {
                                    ...this.editingTypeConfig,
                                    ...typeConfig
                                }
                            })
                        });
                        const updateData = await updateRes.json();
                        if (!updateData.success) {
                            throw new Error(updateData.error || 'Modification échouée');
                        }
                        this.closeModal();
                        window.location.reload();
                        return;
                    }

                    // Build field data
                    const slug = this.newFieldLabel.trim()
                        .toLowerCase()
                        .replace(/[àáâãäå]/g, 'a').replace(/[èéêë]/g, 'e')
                        .replace(/[ìíîï]/g, 'i').replace(/[òóôõö]/g, 'o')
                        .replace(/[ùúûü]/g, 'u').replace(/[ýÿ]/g, 'y')
                        .replace(/[ç]/g, 'c').replace(/[ñ]/g, 'n')
                        .replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');

                    const fieldData = {
                        name: slug,
                        label: this.newFieldLabel.trim(),
                        type: this.selectedType.type || 'string',
                        subtype: this.selectedType.subtype || undefined,
                        icon: this.selectedType.icon || 'solar:widget-bold-duotone',
                        category: 'custom',
                    };

                    // Handle select/multiselect options
                    if (this.selectedType.key === 'select' || this.selectedType.key === 'multiselect') {
                        fieldData.typeConfig = this._buildTypeConfig();
                    }

                    // Handle relation target entity
                    if (this.selectedType.key === 'relation' && this.newFieldTargetEntity) {
                        fieldData.typeConfig = { refEntity: this.newFieldTargetEntity };
                    }

                    // Step 1: Create the field template
                    const createRes = await fetch(`/account/${_acn}/field-template/api/create`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify(fieldData)
                    });
                    const createData = await createRes.json();

                    if (!createData.success || !createData.field?._id) {
                        throw new Error(createData.error || 'Création échouée');
                    }

                    // Step 2: Add to entity
                    const addRes = await fetch(`/account/${_acn}/entity/api/${_entityId}/add-field`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ fieldId: createData.field._id })
                    });
                    const addData = await addRes.json();

                    if (addData.success) {
                        this.closeModal();
                        window.location.reload();
                    } else {
                        throw new Error(addData.error || 'Ajout échoué');
                    }
                } catch (e) {
                    console.error('[FieldPicker] Create error:', e);
                    window.showMessage ? window.showMessage('Erreur: ' + e.message, 'danger') : alert('Erreur: ' + e.message);
                } finally {
                    this.creating = false;
                }
            }
        }));

        // Select / multiselect editor sub-component (same interaction model as relations)
        Alpine.data('ovChoiceEditor', (cfg) => ({
            key: cfg.key,
            fieldId: cfg.fieldId,
            isMulti: !!cfg.isMulti,
            color: cfg.color || '#4361ee',
            options: (cfg.options || []).map(opt => {
                if (typeof opt === 'object') {
                    return { label: opt.label || opt.value, value: opt.value || opt.label, color: opt.color };
                }
                return { label: opt, value: opt };
            }).filter(opt => opt.label && opt.value),
            selectedValues: Array.isArray(cfg.initial) ? cfg.initial.map(v => String(v)) : (cfg.initial ? [String(cfg.initial)] : []),
            searchQ: '',
            showDropdown: false,
            saving: false,

            init() {
                this.$nextTick(() => {
                    const inp = this.$refs.choiceSearchInput;
                    if (inp) inp.focus();
                    this.showDropdown = true;
                });
            },

            get selectedOptions() {
                return this.selectedValues.map(value => {
                    const match = this.options.find(opt => String(opt.value) === String(value));
                    return match || { label: value, value };
                });
            },

            get filteredOptions() {
                const q = this.searchQ.trim().toLowerCase();
                return this.options.filter(opt => {
                    const alreadySelected = this.selectedValues.includes(String(opt.value));
                    if (alreadySelected) return false;
                    if (!q) return true;
                    return String(opt.label || '').toLowerCase().includes(q) || String(opt.value || '').toLowerCase().includes(q);
                });
            },

            get visibleOptions() {
                return this.filteredOptions.slice(0, 5);
            },

            get hasExactMatch() {
                const q = this.searchQ.trim().toLowerCase();
                if (!q) return false;
                return this.options.some(opt =>
                    String(opt.label || '').toLowerCase() === q ||
                    String(opt.value || '').toLowerCase() === q
                );
            },

            normalizeChoice(option) {
                return typeof option === 'object'
                    ? { label: option.label || option.value, value: option.value || option.label }
                    : { label: option, value: option };
            },

            async addChoice(option) {
                const opt = typeof option === 'object'
                    ? { label: option.label || option.value, value: option.value || option.label, color: option.color }
                    : { label: option, value: option };
                if (!opt.value) return;
                window.__destroyAppContextMenu?.();

                if (this.isMulti) {
                    if (!this.selectedValues.includes(String(opt.value))) this.selectedValues.push(String(opt.value));
                } else {
                    this.selectedValues = [String(opt.value)];
                }

                this.searchQ = '';
                this.showDropdown = this.isMulti;
                await this.persist();
                this.updateView();

                if (this.isMulti) {
                    this.$nextTick(() => this.$refs.choiceSearchInput && this.$refs.choiceSearchInput.focus());
                } else {
                    this.closeAndSave();
                }
            },

            async removeChoice(value) {
                window.__destroyAppContextMenu?.();
                this.selectedValues = this.selectedValues.filter(v => String(v) !== String(value));
                await this.persist();
                this.updateView();
                this.$nextTick(() => this.$refs.choiceSearchInput && this.$refs.choiceSearchInput.focus());
            },

            openChoiceContextMenu(event, option) {
                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                const opt = this.normalizeChoice(option);
                if (!opt.value) return;

                const isSelected = this.selectedValues.some(v => String(v) === String(opt.value));
                const items = [];
                if (isSelected) {
                    items.push({
                        icon: 'solar:close-circle-linear',
                        label: 'Retirer de cette fiche',
                        action: () => this.removeChoice(opt.value)
                    });
                }
                items.push({
                    icon: 'solar:trash-bin-trash-bold-duotone',
                    iconColor: '#ef4444',
                    label: 'Supprimer le choix',
                    danger: true,
                    action: () => this.deleteChoiceOption(opt)
                });
                window.__showAppContextMenu?.(event?.clientX || 0, event?.clientY || 0, items);
            },

            async deleteChoiceOption(option) {
                const opt = this.normalizeChoice(option);
                if (!opt.value || this.saving) return;

                this.saving = true;
                try {
                    const res = await fetch('/account/<%= account_number %>/field-template/api/' + this.fieldId + '/delete-option', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ label: opt.label, value: opt.value })
                    });
                    const data = await res.json();
                    if (!res.ok || !data.success) throw new Error(data.error || 'Suppression impossible');

                    this.options = this.options.filter(o => String(o.value) !== String(opt.value) && String(o.label) !== String(opt.value));
                    this.selectedValues = this.selectedValues.filter(v => String(v) !== String(opt.value) && String(v) !== String(opt.label));
                    await this.persist();
                    this.updateView();
                    this.showDropdown = true;
                    window.showMessage ? window.showMessage('Choix supprime', 'success') : null;
                } catch (e) {
                    console.error('[ChoiceDelete]', e);
                    window.showMessage ? window.showMessage(e.message || 'Erreur lors de la suppression', 'danger') : alert(e.message || 'Erreur lors de la suppression');
                } finally {
                    this.saving = false;
                    window.__destroyAppContextMenu?.();
                    this.$nextTick(() => this.$refs.choiceSearchInput && this.$refs.choiceSearchInput.focus());
                }
            },

            async createNew() {
                const label = this.searchQ.trim();
                if (!label || this.hasExactMatch || this.saving) return;
                this.saving = true;
                try {
                    const res = await fetch('/account/<%= account_number %>/field-template/api/' + this.fieldId + '/add-option', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ label, value: label })
                    });
                    const data = await res.json();
                    if (!res.ok || !data.success) throw new Error(data.error || 'Creation impossible');

                    const option = data.option || { label, value: label };
                    if (!this.options.some(opt => String(opt.value) === String(option.value))) {
                        this.options.push(option);
                    }
                    await this.addChoice(option);
                } catch (e) {
                    console.error('[ChoiceCreate]', e);
                    window.showMessage ? window.showMessage(e.message || 'Erreur lors de la creation', 'danger') : alert(e.message || 'Erreur lors de la creation');
                } finally {
                    this.saving = false;
                }
            },

            async persist() {
                const value = this.isMulti ? [...this.selectedValues] : (this.selectedValues[0] || '');
                try {
                    const res = await fetch(_recUrl + '/update-field', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ fieldKey: this.key, value })
                    });
                    if (!res.ok) throw new Error('Sauvegarde impossible');
                } catch (e) {
                    console.error('[ChoicePersist]', e);
                    window.showMessage ? window.showMessage(e.message || 'Erreur lors de la sauvegarde', 'danger') : alert(e.message || 'Erreur lors de la sauvegarde');
                }
            },

            escapeHtml(value) {
                return String(value || '').replace(/[&<>"']/g, ch => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                }[ch]));
            },

            updateView() {
                const parent = this.$el.closest('.ov-ef');
                const viewEl = parent ? parent.querySelector('.ov-ef-view') : null;
                if (!viewEl) return;

                if (this.selectedOptions.length > 0) {
                    viewEl.innerHTML = '<div class="ov-tags">' + this.selectedOptions.map(opt =>
                        '<span class="ov-tag" style="background:' + this.color + '10;border-color:' + this.color + '30;color:' + this.color + '">' + this.escapeHtml(opt.label) + '</span>'
                    ).join('') + '</div>';
                } else {
                    viewEl.innerHTML = '<span class="ov-placeholder">S&eacute;lectionner...</span>';
                }
            },

            closeAndSave() {
                window.__destroyAppContextMenu?.();
                this.searchQ = '';
                this.showDropdown = false;
                this.updateView();
                const grid = this.$el.closest('[x-data]');
                if (grid && grid._x_dataStack) {
                    const root = grid._x_dataStack.find(d => d.editingKey !== undefined);
                    if (root) root.editingKey = '';
                }
            }
        }));

        // Relation editor sub-component (for fiche)
        Alpine.data('ovRelEditor', (cfg) => ({
            key: cfg.key,
            targetEntityId: cfg.targetEntityId,
            targetEntitySlug: cfg.targetEntitySlug || '',
            isMulti: cfg.isMulti,
            color: cfg.color || '#4361ee',
            tags: [...(cfg.initial || [])],
            searchQ: '',
            results: [],
            showDropdown: false,
            dirty: false,
            init() {
                this.$nextTick(() => {
                    const inp = this.$refs.relSearchInput;
                    if (inp) inp.focus();
                    this.search();
                });
            },
            async search() {
                if (!this.targetEntityId) return;
                const q = this.searchQ.trim();
                try {
                    let url = '/account/<%= account_number %>/record/api/search?entityId=' + this.targetEntityId + '&limit=5';
                    if (q) url += '&q=' + encodeURIComponent(q);
                    const res = await fetch(url, { credentials: 'include' });
                    const data = await res.json();
                    const tagIds = this.tags.map(t => String(t._id));
                    this.results = (data.data || []).filter(r => !tagIds.includes(String(r.id))).map(r => ({
                        _id: r.id,
                        title: r.label || 'Sans titre'
                    }));
                    this.showDropdown = true;
                } catch (e) { console.error('[RelSearch]', e); }
            },
            async addTag(record) {
                if (!this.isMulti) this.tags = [];
                this.tags.push({ _id: record._id, title: record.title });
                this.searchQ = '';
                this.results = [];
                this.showDropdown = false;
                this.dirty = true;
                if (this.isMulti) {
                    await this._persist('add', record._id);
                } else {
                    await this._persistSet([record._id]);
                    this.closeAndSave();
                }
            },
            async removeTag(id) {
                this.tags = this.tags.filter(t => t._id !== id);
                this.dirty = true;
                await this._persist('remove', id);
            },
            async _persist(action, targetId) {
                try {
                    await fetch(_recUrl + '/update-relation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ relationKey: this.key, action, targetId })
                    });
                } catch (e) { console.error('[RelPersist]', e); }
            },
            async _persistSet(ids) {
                try {
                    await fetch(_recUrl + '/update-relation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ relationKey: this.key, action: 'set', targetIds: ids })
                    });
                } catch (e) { console.error('[RelPersist]', e); }
            },
            async createNew() {
                const title = this.searchQ.trim();
                if (!title || !this.targetEntityId) return;
                try {
                    const res = await fetch('/account/<%= account_number %>/record/api/quick-create', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ entityId: this.targetEntityId, title })
                    });
                    const data = await res.json();
                    if (data.success && data.record) {
                        await this.addTag({ _id: data.record._id, title: data.record.title });
                    }
                } catch (e) { console.error('[QuickCreate]', e); }
            },
            closeAndSave() {
                this.results = [];
                this.searchQ = '';
                this.showDropdown = false;
                const parent = this.$el.closest('.ov-ef');
                if (parent) {
                    const viewEl = parent.querySelector('.ov-ef-view');
                    if (viewEl) {
                        if (this.tags.length > 0) {
                            viewEl.innerHTML = '<div class="ov-tags">' + this.tags.map(t =>
                                '<span class="ov-tag" style="background:' + this.color + '10;border-color:' + this.color + '30;color:' + this.color + '">' + t.title.replace(/</g,'&lt;') + '</span>'
                            ).join('') + '</div>';
                        } else {
                            viewEl.innerHTML = '<span class="ov-placeholder">Sélectionner...</span>';
                        }
                    }
                }
                const grid = this.$el.closest('[x-data]');
                if (grid && grid._x_dataStack) {
                    const root = grid._x_dataStack.find(d => d.editingKey !== undefined);
                    if (root) root.editingKey = '';
                }
            }
        }));

        // Media editor sub-component (for fiche: file, image, gallery)
        Alpine.data('ovMediaEditor', (cfg) => ({
            key: cfg.key,
            type: cfg.type,
            selectedFiles: Array.isArray(cfg.initial) ? cfg.initial : (cfg.initial ? [cfg.initial] : []),
            showDrivePicker: false,
            loadingDrive: false,
            driveData: null,
            currentView: 'record', // 'hub', 'entity', 'record', 'folder'
            selectedEntity: null,
            selectedRecord: null,
            selectedFolder: null,
            modalSearchQ: '',
            uploading: false,
            uploadProgress: 0,
            uploadError: { show: false, title: '', message: '', files: [] },
            
            get filteredDriveFiles() {
                let files = [];
                if (this.currentView === 'folder' && this.selectedFolder) {
                    files = this.selectedFolder.files || [];
                } else if (this.currentView === 'record' && this.selectedRecord) {
                    files = [
                        ...(this.selectedRecord.rootFiles || []),
                        ...(this.selectedRecord.folders || []).flatMap(f => f.files || [])
                    ];
                } else if (this.currentView === 'entity' && this.selectedEntity) {
                    files = this.selectedEntity.records.flatMap(r => [
                        ...(r.rootFiles || []),
                        ...(r.folders || []).flatMap(f => f.files || [])
                    ]);
                } else if (this.currentView === 'hub' && this.driveData && this.driveData.entities) {
                    files = this.driveData.entities.flatMap(e => 
                        e.records.flatMap(r => [
                            ...(r.rootFiles || []),
                            ...(r.folders || []).flatMap(f => f.files || [])
                        ])
                    );
                }
                if (!this.modalSearchQ || !this.modalSearchQ.trim()) return files;
                const q = this.modalSearchQ.toLowerCase();
                return files.filter(df => 
                    (df.originalName || df.filename || '').toLowerCase().includes(q)
                );
            },
            init() {
                if (!Array.isArray(this.selectedFiles)) {
                    this.selectedFiles = this.selectedFiles ? [this.selectedFiles] : [];
                }
            },
            isImage(filename) {
                if (!filename) return false;
                const ext = filename.split('.').pop().toLowerCase();
                return ['jpg','jpeg','png','gif','webp','svg'].includes(ext);
            },
            async openDrivePicker() {
                this.showDrivePicker = true;
                this.modalSearchQ = '';
                if (!this.driveData) {
                    this.loadingDrive = true;
                    try {
                        const res = await fetch(`/account/${cfg.num || '<%= account_number %>'}/api/drive`, { credentials: 'include' });
                        const data = await res.json();
                        if (data.success) {
                            this.driveData = data;
                            
                            // Traverse directly to current record's folder
                            let ent = data.entities.find(e => String(e.entityId) === '<%= entity._id %>');
                            if (!ent) {
                                ent = data.entities.find(e => e.entitySlug === '<%= entity.slug %>');
                            }
                            if (ent) {
                                this.selectedEntity = ent;
                                let rec = ent.records.find(r => String(r.recordId) === '<%= record._id %>');
                                if (!rec) {
                                    rec = {
                                        recordId: '<%= record._id %>',
                                        recordTitle: '<%= (record.computedTitle || record.title || "Sans titre").replace(/"/g, "&quot;").replace(/'/g, "\\'") %>',
                                        folders: [],
                                        rootFiles: [],
                                        fileCount: 0,
                                        totalSize: 0
                                    };
                                    ent.records.push(rec);
                                }
                                this.selectedRecord = rec;
                                this.currentView = 'record';
                            } else {
                                this.currentView = 'hub';
                            }
                        }
                    } catch (e) {
                        console.error('[MediaEditor] Fetch drive error:', e);
                    } finally {
                        this.loadingDrive = false;
                    }
                } else {
                    // Reset view to current record when re-opening
                    this.currentView = 'record';
                    this.selectedFolder = null;
                }
            },
            setView(v) {
                this.currentView = v;
                if (v === 'hub') {
                    this.selectedEntity = null;
                    this.selectedRecord = null;
                    this.selectedFolder = null;
                } else if (v === 'entity') {
                    this.selectedRecord = null;
                    this.selectedFolder = null;
                } else if (v === 'record') {
                    this.selectedFolder = null;
                }
            },
            selectEntity(ent) {
                this.selectedEntity = ent;
                this.currentView = 'entity';
            },
            selectRecord(rec) {
                this.selectedRecord = rec;
                this.currentView = 'record';
            },
            selectFolder(fld) {
                this.selectedFolder = fld;
                this.currentView = 'folder';
            },
            goBack() {
                if (this.currentView === 'folder') {
                    this.currentView = 'record';
                    this.selectedFolder = null;
                } else if (this.currentView === 'record') {
                    this.currentView = 'entity';
                    this.selectedRecord = null;
                } else if (this.currentView === 'entity') {
                    this.currentView = 'hub';
                    this.selectedEntity = null;
                }
            },
            async selectDriveFile(df) {
                if (this.type === 'gallery') {
                    if (this.selectedFiles.includes(df.filename)) {
                        this.selectedFiles = this.selectedFiles.filter(f => f !== df.filename);
                        this._persist();
                        this._updateView();
                    } else {
                        this.selectedFiles = [...this.selectedFiles, df.filename];
                        this._persist();
                        this._updateView();
                    }
                } else {
                    this.selectedFiles = [df.filename];
                    this._persist();
                    this.closeAndSave();
                }
            },
            async removeFile(idx) {
                const newFiles = [...this.selectedFiles];
                newFiles.splice(idx, 1);
                this.selectedFiles = newFiles;
                await this._persist();
                this._updateView(); // sync read-mode immediately
            },

            async uploadFiles(event) {
                const files = event.target.files;
                if (!files || files.length === 0) return;
                
                this.uploading = true;
                this.uploadProgress = 0;
                this.uploadError = { show: false, title: '', message: '', files: [] };
                
                const formData = new FormData();
                for (let i = 0; i < files.length; i++) {
                    formData.append('files', files[i]);
                }
                
                try {
                    const xhr = new XMLHttpRequest();
                    xhr.open('POST', `/account/<%= account_number %>/api/records/<%= record._id %>/attachments`, true);
                    xhr.withCredentials = true;
                    
                    xhr.upload.addEventListener('progress', (e) => {
                        if (e.lengthComputable) {
                            this.uploadProgress = Math.round((e.loaded / e.total) * 100);
                        }
                    });
                    
                    const uploadPromise = new Promise((resolve, reject) => {
                        xhr.onload = () => {
                            if (xhr.status >= 200 && xhr.status < 300) {
                                resolve(JSON.parse(xhr.responseText));
                            } else {
                                let errMsg = 'Erreur lors de l\'upload';
                                try { const d = JSON.parse(xhr.responseText); if (d.error) errMsg = d.error; } catch(e) {}
                                reject(new Error(errMsg));
                            }
                        };
                        xhr.onerror = () => reject(new Error('Erreur réseau'));
                        xhr.send(formData);
                    });
                    
                    const res = await uploadPromise;
                    if (res.success && res.attachments) {
                        if (this.type === 'gallery') {
                            let newFiles = [...this.selectedFiles];
                            let addedAny = false;
                            for (const f of res.attachments) {
                                if (!newFiles.includes(f.filename)) {
                                    newFiles.push(f.filename);
                                    addedAny = true;
                                }
                            }
                            if (addedAny) {
                                this.selectedFiles = newFiles;
                                await this._persist();
                                this._updateView();
                            }
                        } else {
                            if (res.attachments.length > 0) {
                                this._addFile(res.attachments[0].filename);
                            }
                        }
                    }
                } catch (e) {
                    console.error('[MediaEditor] Upload error:', e);
                    const msg = e.message || 'Erreur lors de l\'upload';
                    const isSecurity = msg.includes('interdit') || msg.includes('falsifié') || msg.includes('corrompu') || msg.includes('sécurité') || msg.includes('autorisé') || msg.includes('SECURITY') || msg.includes('blocked');
                    this.uploadError = {
                        show: true,
                        title: isSecurity ? 'Fichier bloqué par la sécurité' : 'Erreur d\'upload',
                        message: msg,
                        files: isSecurity ? Array.from(event.target.files || []).map(f => f.name) : []
                    };
                } finally {
                    this.uploading = false;
                    this.uploadProgress = 0;
                    if (this.$refs.fileInput) this.$refs.fileInput.value = '';
                }
            },
            _addFile(filename) {
                if (this.type === 'gallery') {
                    if (!this.selectedFiles.includes(filename)) {
                        this.selectedFiles = [...this.selectedFiles, filename];
                        this._persist();
                        this._updateView(); // sync read-mode immediately
                    }
                } else {
                    this.selectedFiles = [filename];
                    this._persist();
                    this.closeAndSave();
                }
            },
            async _persist() {
                try {
                    const value = this.type === 'gallery' ? this.selectedFiles : (this.selectedFiles[0] || '');
                    await fetch('/account/<%= account_number %>/record/<%= entity.slug %>/<%= record._id %>/update-field', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ fieldKey: this.key, value })
                    });
                } catch (e) { console.error('[MediaPersist]', e); }
            },
            // Update read-mode view (.ov-ef-view) immediately with current selectedFiles
            _updateView() {
                const parent = this.$el.closest('.ov-ef');
                if (!parent) return;
                const viewEl = parent.querySelector('.ov-ef-view');
                if (!viewEl) return;
                const acct = '<%= account_number %>';
                if (this.selectedFiles.length === 0) {
                    viewEl.innerHTML = '<span class="ov-placeholder">Vide</span>';
                } else if (this.type === 'gallery') {
                    viewEl.innerHTML = '<div style="display:flex;flex-wrap:wrap;gap:6px;">' +
                        this.selectedFiles.map(img =>
                            `<img src="/account/${acct}/uploads/attachments/${img}" style="height:36px;width:36px;object-fit:cover;border-radius:6px;border:1px solid #e0e6ed;" onerror="this.style.display='none'">`
                        ).join('') + '</div>';
                } else if (this.type === 'image') {
                    viewEl.innerHTML = `<img src="/account/${acct}/uploads/attachments/${this.selectedFiles[0]}" style="max-height:40px;border-radius:6px;border:1px solid #e0e6ed;" onerror="this.style.display='none'">`;
                } else {
                    const fullPath = this.selectedFiles[0];
                    const displayName = fullPath ? fullPath.split('/').pop() : fullPath;
                    viewEl.innerHTML = `<a href="/account/${acct}/uploads/attachments/${fullPath}" target="_blank" style="display:inline-flex;align-items:center;gap:6px;color:#4361ee;font-size:13px;font-weight:500;background:#4361ee10;padding:4px 10px;border-radius:6px;text-decoration:none;"><iconify-icon icon="solar:document-bold-duotone" width="16"></iconify-icon> ${displayName}</a>`;
                }
            },
            closeAndSave() {
                this.showDrivePicker = false;
                this._updateView();
                const grid = this.$el.closest('[x-data]');
                if (grid && grid._x_dataStack) {
                    const root = grid._x_dataStack.find(d => d.editingKey !== undefined);
                    if (root) root.editingKey = '';
                }
            }

        }));
    });
    </script>
    <% } %>

    <script>
    document.addEventListener('alpine:init', () => {
        const recordModuleTabs = <%- JSON.stringify(_visibleRecordModuleNavItems).replace(/</g, '\\u003C') %>;
        const recordModuleDefaultHiddenTabs = <%- JSON.stringify(_defaultHiddenRecordModules).replace(/</g, '\\u003C') %>;
        Alpine.data('recordModuleShell', () => ({
            accountNumber: '<%= account_number %>',
            entityId: '<%= entity._id %>',
            currentModule: '<%= moduleName %>',
            tabs: recordModuleTabs,
            hiddenTabs: Array.isArray(recordModuleDefaultHiddenTabs) ? [...recordModuleDefaultHiddenTabs] : [],
            configOpen: false,
            savingTabs: false,

            init() {
                this.hiddenTabs = this.normalizeHiddenTabs(this.hiddenTabs);
                this.loadStoredTabs();
                this.loadTabPreferences();
            },

            get storageKey() {
                return `record_module_tabs_${this.accountNumber}_${this.entityId}`;
            },

            get viewId() {
                return `record_module_tabs_${this.entityId}`;
            },

            isTabLocked(key) {
                return key === 'overview' || this.tabs.length <= 1;
            },

            isTabEnabled(key) {
                return this.isTabLocked(key) || !this.hiddenTabs.includes(key);
            },

            isTabVisible(key) {
                return this.isTabEnabled(key) || key === this.currentModule;
            },

            normalizeHiddenTabs(value) {
                const allowed = new Set((this.tabs || []).map(tab => String(tab.key)));
                if (!Array.isArray(value)) return [];
                return value
                    .map(key => String(key))
                    .filter((key, idx, arr) => allowed.has(key) && !this.isTabLocked(key) && arr.indexOf(key) === idx);
            },

            loadStoredTabs() {
                try {
                    const raw = window.localStorage.getItem(this.storageKey);
                    if (raw) this.hiddenTabs = this.normalizeHiddenTabs(JSON.parse(raw));
                } catch (e) { /* local fallback only */ }
            },

            persistStoredTabs() {
                try {
                    window.localStorage.setItem(this.storageKey, JSON.stringify(this.hiddenTabs));
                } catch (e) { /* preferences API remains source of truth */ }
            },

            async loadTabPreferences() {
                try {
                    const res = await fetch(`/account/${this.accountNumber}/api/user/view-preferences/${this.viewId}`, { credentials: 'include' });
                    const data = await res.json();
                    if (data.success && data.preferences && Array.isArray(data.preferences.hiddenRecordModules)) {
                        this.hiddenTabs = this.normalizeHiddenTabs(data.preferences.hiddenRecordModules);
                        this.persistStoredTabs();
                    }
                } catch (e) {
                    console.warn('[RecordTabs] Preference load skipped:', e);
                }
            },

            toggleTab(key) {
                key = String(key || '');
                if (!key || this.isTabLocked(key)) return;
                if (this.hiddenTabs.includes(key)) {
                    this.hiddenTabs = this.hiddenTabs.filter(item => item !== key);
                } else {
                    this.hiddenTabs = this.normalizeHiddenTabs([...this.hiddenTabs, key]);
                }
                this.saveTabPreferences();
            },

            async saveTabPreferences() {
                this.persistStoredTabs();
                this.savingTabs = true;
                try {
                    await fetch(`/account/${this.accountNumber}/api/user/view-preferences`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({
                            viewId: this.viewId,
                            preferences: { hiddenRecordModules: this.hiddenTabs }
                        })
                    });
                } catch (e) {
                    console.warn('[RecordTabs] Preference save skipped:', e);
                }
                this.savingTabs = false;
            }
        }));
    });
    </script>

    <!-- Global: Create Draft Record -->
    <script>
    async function createDraftRecord() {
        try {
            const res = await fetch('/account/<%= account_number %>/record/api/create-draft', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ entitySlug: '<%= entity.slug %>' })
            });
            const data = await res.json();
            if (data.success && data._id) {
                window.location.href = '/account/<%= account_number %>/record/<%= entity.slug %>/' + data._id + '/fiche';
            } else {
                console.error('[CreateDraft] Failed:', data);
                window.showMessage ? window.showMessage('Erreur lors de la création', 'danger') : alert('Erreur lors de la création');
            }
        } catch (e) {
            console.error('[CreateDraft]', e);
            window.showMessage ? window.showMessage('Erreur réseau', 'danger') : alert('Erreur réseau');
        }
    }
    </script>

</div>
