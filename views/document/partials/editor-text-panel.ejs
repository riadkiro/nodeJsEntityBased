<div 
    x-show="activeTab === 'text'"
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="-translate-x-full opacity-0"
    x-transition:enter-end="translate-x-0 opacity-100"
    x-transition:leave="transition ease-in duration-200 transform"
    x-transition:leave-start="translate-x-0 opacity-100"
    x-transition:leave-end="-translate-x-full opacity-0"
    class="w-72 bg-white dark:bg-[#0e1726] border-0 flex flex-col shadow-xl z-20 overflow-hidden"
    style="display: none;"
    x-init="$el.classList.add('p-2')"
>
    <!-- Header -->
    <div class="p-4 border-b border-white-light dark:border-white/5 flex justify-between items-center">
        <h3 class="font-semibold text-sm text-gray-900 dark:text-white flex items-center gap-2">
            <iconify-icon icon="solar:text-bold-duotone" class="text-primary"></iconify-icon>
            Texte & Contenu
        </h3>
        <button @click="activeTab = null" class="w-7 h-7 rounded-full flex items-center justify-center text-gray-400 dark:text-white-dark/70 hover:bg-white-light dark:hover:bg-white/5 transition-colors">
            <iconify-icon icon="solar:close-circle-bold" width="20"></iconify-icon>
        </button>
    </div>

    <!-- Scrollable Content - Sortable on direct children -->
    <div class="flex-1 overflow-y-auto p-2 custom-scrollbar space-y-2"
         x-init="Sortable.create($el, { 
            group: { name: 'elements', pull: 'clone', put: false }, 
            sort: false, 
            draggable: '.text-source-item', 
            fallbackOnBody: true,
            onStart: function() { document.body.classList.add('is-dragging'); },
            onEnd: function() { document.body.classList.remove('is-dragging'); }
         })">
        
        <!-- Basic Text Tools -->
        <div class="text-source-item group cursor-move bg-transparent p-3 rounded-lg border border-white-light dark:border-white/10 hover:border-primary/20 hover:shadow-md dark:hover:border-primary/20 transition-all flex items-center gap-3"
                draggable="true" @dragstart="handleDragStart($event)"
                data-type="text" data-content="<h1>Ajouter un titre</h1>">
            <div class="w-10 h-10 rounded-lg bg-primary-light flex items-center justify-center text-primary flex-shrink-0">
                <iconify-icon icon="solar:text-bold-duotone" width="22"></iconify-icon>
            </div>
            <span class="text-sm font-semibold text-gray-900 dark:text-white">Ajouter un titre</span>
        </div>


        <div class="text-source-item group cursor-move bg-transparent p-3 rounded-lg border border-white-light dark:border-white/10 hover:border-primary/20 hover:shadow-md dark:hover:border-primary/20 transition-all flex items-center gap-3"
                draggable="true" @dragstart="handleDragStart($event)"
                data-type="text" data-content="<h3>Ajouter un sous-titre</h3>">
            <div class="w-10 h-10 rounded-lg bg-primary-light/50 flex items-center justify-center text-primary/70 flex-shrink-0">
                <iconify-icon icon="solar:text-underline-cross-bold-duotone" width="20"></iconify-icon>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-white/90">Ajouter un sous-titre</span>
        </div>

        <div class="text-source-item group cursor-move bg-transparent p-3 rounded-lg border border-white-light dark:border-white/10 hover:border-primary/20 hover:shadow-md dark:hover:border-primary/20 transition-all flex items-center gap-3"
                draggable="true" @dragstart="handleDragStart($event)"
                data-type="text" data-content="<p>Texte de corps</p>">
            <div class="w-10 h-10 rounded-lg bg-gray-100 dark:bg-white/10 flex items-center justify-center text-gray-500 dark:text-white/70 flex-shrink-0">
                <iconify-icon icon="solar:align-left-bold-duotone" width="20"></iconify-icon>
            </div>
            <span class="text-sm text-gray-600 dark:text-white/80 font-medium">Texte de corps</span>
        </div>

        <div class="h-px bg-white-light dark:bg-white/5 !my-4"></div>

        <!-- Simple Text Tool -->
        <div class="text-source-item group cursor-move bg-transparent p-3 rounded-lg border border-white-light dark:border-white/10 hover:border-primary/20 hover:shadow-md dark:hover:border-primary/20 transition-all flex items-center gap-3"
                draggable="true" @dragstart="handleDragStart($event)"
                data-type="plain-text" data-content="Texte simple sans HTML">
            <div class="w-10 h-10 rounded-lg bg-gray-100 dark:bg-white/10 flex items-center justify-center text-gray-500 dark:text-white/70 flex-shrink-0">
                <iconify-icon icon="solar:info-circle-bold-duotone" width="20"></iconify-icon>
            </div>
            <span class="text-sm text-gray-600 dark:text-white/80 font-medium">Texte simple (Sans HTML)</span>
        </div>

        <div class="h-px bg-white-light dark:bg-white/5 !my-4"></div>

        <!-- HTML Tool -->
        <div class="text-source-item group cursor-move bg-transparent p-3 rounded-lg border border-white-light dark:border-white/10 hover:border-primary/20 hover:shadow-md dark:hover:border-primary/20 transition-all flex items-center gap-3"
                draggable="true" @dragstart="handleDragStart($event)"
                data-type="html" data-content="<div style='padding: 20px; background: #f8fafc; border-radius: 8px;'>Code HTML personnalisé</div>">
            <div class="w-10 h-10 rounded-lg bg-green-50 dark:bg-green-500/10 flex items-center justify-center text-green-600 dark:text-green-400 flex-shrink-0">
                <iconify-icon icon="solar:code-bold-duotone" width="22"></iconify-icon>
            </div>
            <span class="text-sm font-semibold text-gray-900 dark:text-white">Code HTML Brut</span>
        </div>

        <div class="mt-6 px-1" style="margin-top:24px;">
            <p class="text-[10px] uppercase tracking-widest text-gray-400 dark:text-white/40 font-bold mb-3">Presets ou templates</p>
            <div class="space-y-2">
                <!-- Style 01 -->
                <div class="text-source-item group cursor-move bg-gradient-to-r from-indigo-50 to-blue-50 dark:from-indigo-500/10 dark:to-blue-500/10 p-3 rounded-lg border border-indigo-100 dark:border-indigo-500/20 hover:border-indigo-300 dark:hover:border-indigo-400/30 hover:shadow-md transition-all flex items-center gap-3"
                        draggable="true" @dragstart="handleDragStart($event)"
                        data-type="text" data-content="<h2 style='color: #4f46e5; font-weight: 800; font-style: italic;'>STYLE 01</h2>">
                    <div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-500/20 flex items-center justify-center text-indigo-600 dark:text-indigo-400 flex-shrink-0">
                        <iconify-icon icon="solar:stars-minimalistic-bold-duotone" width="20"></iconify-icon>
                    </div>
                    <span class="text-xs font-bold text-indigo-700 dark:text-indigo-300 italic">Style 01</span>
                </div>

                <!-- Style 02 -->
                <div class="text-source-item group cursor-move bg-transparent p-3 rounded-lg border border-white-light dark:border-white/10 hover:border-blue-300 dark:hover:border-blue-400/30 hover:shadow-md transition-all flex items-center gap-3"
                        draggable="true" @dragstart="handleDragStart($event)"
                        data-type="text" data-content="<div style='border-left: 4px solid #3b82f6; padding-left: 10px; font-style: italic; color: #64748b;'>Style 02 (Citation)</div>">
                    <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-500/10 flex items-center justify-center text-blue-600 dark:text-blue-400 flex-shrink-0">
                        <iconify-icon icon="solar:double-quotes-l-bold" width="20"></iconify-icon>
                    </div>
                    <span class="text-xs font-semibold text-gray-700 dark:text-white/90">Style 02</span>
                </div>

                <!-- Style 03 -->
                <div class="text-source-item group cursor-move bg-purple-50 dark:bg-purple-500/10 p-3 rounded-lg border border-purple-100 dark:border-purple-500/20 hover:border-purple-300 dark:hover:border-purple-400/30 hover:shadow-md transition-all flex items-center gap-3"
                        draggable="true" @dragstart="handleDragStart($event)"
                        data-type="text" data-content="<div style='background: #f3e8ff; padding: 10px; border-radius: 8px; color: #7e22ce;'>Style 03 (Encadré)</div>">
                    <div class="w-10 h-10 rounded-lg bg-purple-100 dark:bg-purple-500/20 flex items-center justify-center text-purple-600 dark:text-purple-400 flex-shrink-0">
                        <iconify-icon icon="solar:filters-bold-duotone" width="20"></iconify-icon>
                    </div>
                    <span class="text-xs font-bold text-purple-700 dark:text-purple-300">Style 03</span>
                </div>
            </div>
        </div>
    </div>
</div>
