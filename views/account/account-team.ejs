<link rel="stylesheet" href="/css/app/team-system.css" />

<div x-data="teamHub()" x-init="init()" x-cloak>
  <!-- Page Header -->
  <div class="ts-page-header">
    <div class="ts-page-header-icon">
      <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="28" style="color:#4361ee"></iconify-icon>
    </div>
    <div class="ts-page-header-info">
      <h1>Équipe & Membres</h1>
      <p x-text="accountName ? 'Gérez les membres de ' + accountName : 'Chargement...'"></p>
    </div>
    <div style="display:flex;gap:10px;z-index:1;">
      <a href="/account/<%= account_number %>/roles" style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border:1.5px solid #7c3aed40;border-radius:10px;font-size:12px;font-weight:600;color:#7c3aed;text-decoration:none;transition:all .15s;background:transparent;" onmouseover="this.style.background='#7c3aed08';this.style.borderColor='#7c3aed'" onmouseout="this.style.background='transparent';this.style.borderColor='#7c3aed40'">
        <iconify-icon icon="solar:shield-keyhole-bold-duotone" width="16"></iconify-icon> Rôles
      </a>
      <a href="/account/<%= account_number %>/chat" class="ts-btn-primary" style="background:linear-gradient(135deg,#f97316,#ea580c);">
        <iconify-icon icon="solar:chat-round-dots-bold" width="16"></iconify-icon> Team Chat
      </a>
      <button class="ts-btn-primary" @click="showInviteModal = true">
        <iconify-icon icon="solar:user-plus-bold" width="16"></iconify-icon> Inviter
      </button>
    </div>
  </div>

  <!-- Loading -->
  <template x-if="loading">
    <div style="text-align:center;padding:60px 20px;color:#94a3b8;">
      <iconify-icon icon="solar:refresh-bold-duotone" width="32" style="animation:spin 1s linear infinite;"></iconify-icon>
      <p style="margin-top:8px;font-size:13px;">Chargement des membres...</p>
    </div>
  </template>

  <template x-if="!loading">
    <div>
      <!-- Stats -->
      <div class="ts-stats">
        <div class="ts-stat-card">
          <div class="ts-stat-icon" style="background:rgba(67,97,238,.1);"><iconify-icon icon="solar:users-group-rounded-bold-duotone" width="24" style="color:#4361ee"></iconify-icon></div>
          <div><div class="ts-stat-value" x-text="members.length"></div><div class="ts-stat-label">Membres total</div></div>
        </div>
        <div class="ts-stat-card">
          <div class="ts-stat-icon" style="background:rgba(124,58,237,.1);"><iconify-icon icon="solar:users-group-two-rounded-bold-duotone" width="24" style="color:#7c3aed"></iconify-icon></div>
          <div><div class="ts-stat-value" x-text="teams.length"></div><div class="ts-stat-label">Teams</div></div>
        </div>
        <div class="ts-stat-card">
          <div class="ts-stat-icon" style="background:rgba(34,197,94,.1);"><iconify-icon icon="solar:check-circle-bold-duotone" width="24" style="color:#22c55e"></iconify-icon></div>
          <div><div class="ts-stat-value" x-text="members.filter(m => m.userStatus === 'active').length"></div><div class="ts-stat-label">Actifs</div></div>
        </div>
        <div class="ts-stat-card">
          <div class="ts-stat-icon" style="background:rgba(249,115,22,.1);"><iconify-icon icon="solar:letter-bold-duotone" width="24" style="color:#f97316"></iconify-icon></div>
          <div><div class="ts-stat-value" x-text="invitations.length"></div><div class="ts-stat-label">Invitations en attente</div></div>
        </div>

      </div>

      <!-- Teams Section -->
      <div class="ts-teams-section">
        <div class="ts-teams-section-header">
          <div class="ts-teams-section-title">
            <iconify-icon icon="solar:users-group-two-rounded-bold-duotone" width="18" style="color:#7c3aed"></iconify-icon>
            Teams
            <span class="ts-teams-section-count" x-text="teams.length + ' groupe(s)'"></span>
          </div>
          <button @click="openTeamModal()" style="display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:8px;border:1.5px dashed #7c3aed40;background:transparent;color:#7c3aed;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;font-family:inherit;" onmouseover="this.style.background='#7c3aed08';this.style.borderColor='#7c3aed'" onmouseout="this.style.background='transparent';this.style.borderColor='#7c3aed40'">
            <iconify-icon icon="solar:add-circle-bold" width="14"></iconify-icon> Nouvelle team
          </button>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;">
          <template x-for="team in teams" :key="team._id">
            <div class="ts-team-card" :class="teamFilter === team._id && 'ts-team-active'" @click="teamFilter = teamFilter === team._id ? null : team._id">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                <div :style="'width:32px;min-width:32px;max-width:32px;height:32px;min-height:32px;max-height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:' + team.color + '15'">
                  <iconify-icon :icon="team.icon" width="16" :style="'color:' + team.color"></iconify-icon>
                </div>
                <div style="flex:1;min-width:0;">
                  <div style="font-size:13px;font-weight:700;color:#0e1726;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" class="dark:!text-[#e0e6ed]" x-text="team.name"></div>
                  <div style="font-size:11px;color:#94a3b8;" x-text="(team.memberIds || []).length + ' membre(s)'"></div>
                </div>
                <button @click.stop="openTeamModal(team)" style="border:none;background:transparent;cursor:pointer;padding:4px;border-radius:6px;color:#94a3b8;transition:all .15s;" onmouseover="this.style.color='#7c3aed';this.style.background='#7c3aed08'" onmouseout="this.style.color='#94a3b8';this.style.background='transparent'">
                  <iconify-icon icon="solar:pen-bold" width="14"></iconify-icon>
                </button>
              </div>
              <div style="display:flex;">
                <template x-for="(mid, idx) in (team.memberIds || []).slice(0, 5)" :key="mid">
                  <div :style="'width:22px;min-width:22px;max-width:22px;height:22px;min-height:22px;max-height:22px;border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;color:#fff;margin-left:' + (idx === 0 ? '0' : '-4px') + ';flex-shrink:0;background:' + avatarColor(getMemberName(mid))" x-text="getMemberName(mid).charAt(0).toUpperCase()"></div>
                </template>
                <template x-if="(team.memberIds || []).length > 5">
                  <div style="width:22px;height:22px;border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:600;color:#64748b;background:#f1f5f9;margin-left:-4px;" x-text="'+' + ((team.memberIds || []).length - 5)"></div>
                </template>
              </div>
            </div>
          </template>
        </div>
      </div>

      <!-- Members Section -->
      <div class="ts-members-section">
        <!-- Toolbar -->
        <div class="ts-members-toolbar">
          <div class="ts-members-toolbar-left">
            <!-- Role Dropdown -->
            <div style="position:relative;" x-data="{roleOpen:false}" @click.outside="roleOpen=false">
              <button @click="roleOpen=!roleOpen" style="display:flex;align-items:center;gap:6px;padding:7px 12px;border:1.5px solid #e0e6ed;border-radius:10px;background:#fff;font-size:12px;font-weight:600;color:#334155;cursor:pointer;font-family:inherit;transition:all .15s;min-width:130px;" class="dark:!bg-[#1b2e4b] dark:!border-[#253b5c] dark:!text-[#cbd5e1]" :style="activeFilter !== 'all' ? 'border-color:#4361ee;background:rgba(67,97,238,.04);color:#4361ee' : ''">
                <iconify-icon icon="solar:shield-user-bold-duotone" width="14" style="flex-shrink:0;"></iconify-icon>
                <span x-text="activeFilter === 'all' ? 'Tous les rôles' : roleLabel(activeFilter)" style="flex:1;text-align:left;"></span>
                <span style="font-size:10px;opacity:.6;" x-text="'(' + (activeFilter === 'all' ? members.length : members.filter(m => m.role === activeFilter).length) + ')'"></span>
                <iconify-icon icon="solar:alt-arrow-down-linear" width="14" style="flex-shrink:0;opacity:.5;"></iconify-icon>
              </button>
              <div x-show="roleOpen" x-transition style="position:absolute;top:calc(100% + 4px);left:0;min-width:180px;max-width:220px;background:#fff;border:1px solid #e0e6ed;border-radius:12px;padding:4px;box-shadow:0 8px 24px rgba(0,0,0,.1);z-index:20;" class="dark:!bg-[#0e1726] dark:!border-[#253b5c]">
                <template x-for="role in allRoles" :key="'dd-'+role.key">
                  <div style="display:block;">
                    <button @click="activeFilter = role.key; roleOpen=false" style="display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;width:100%;border:none;background:none;font-size:12px;font-weight:500;color:#334155;cursor:pointer;font-family:inherit;transition:background .1s;text-align:left;box-sizing:border-box;" class="dark:!text-[#cbd5e1]" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='none'" :style="activeFilter === role.key ? 'background:#f1f5f9;font-weight:700;' : ''">
                      <span x-text="role.label" style="flex:1;text-align:left;"></span>
                      <span style="font-size:10px;color:#94a3b8;" x-text="'(' + (role.key === 'all' ? members.length : members.filter(m => m.role === role.key).length) + ')'"></span>
                      <iconify-icon x-show="activeFilter === role.key" icon="solar:check-circle-bold" width="14" style="color:#4361ee;"></iconify-icon>
                    </button>
                  </div>
                </template>
              </div>
            </div>
            <!-- Team Dropdown -->
            <template x-if="teams.length > 0">
              <div style="position:relative;" x-data="{teamOpen:false}" @click.outside="teamOpen=false">
                <button @click="teamOpen=!teamOpen" style="display:flex;align-items:center;gap:6px;padding:7px 12px;border:1.5px solid #e0e6ed;border-radius:10px;background:#fff;font-size:12px;font-weight:600;color:#334155;cursor:pointer;font-family:inherit;transition:all .15s;min-width:130px;" class="dark:!bg-[#1b2e4b] dark:!border-[#253b5c] dark:!text-[#cbd5e1]" :style="teamFilter ? 'border-color:#7c3aed;background:rgba(124,58,237,.04);color:#7c3aed' : ''">
                  <iconify-icon icon="solar:users-group-two-rounded-bold-duotone" width="14" style="flex-shrink:0;"></iconify-icon>
                  <span x-text="teamFilter ? teams.find(t => t._id === teamFilter)?.name || 'Team' : 'Toutes les teams'" style="flex:1;text-align:left;"></span>
                  <iconify-icon icon="solar:alt-arrow-down-linear" width="14" style="flex-shrink:0;opacity:.5;"></iconify-icon>
                </button>
                <div x-show="teamOpen" x-transition style="position:absolute;top:calc(100% + 4px);left:0;min-width:200px;max-width:260px;background:#fff;border:1px solid #e0e6ed;border-radius:12px;padding:4px;box-shadow:0 8px 24px rgba(0,0,0,.1);z-index:20;" class="dark:!bg-[#0e1726] dark:!border-[#253b5c]">
                  <div style="display:block;">
                    <button @click="teamFilter=null; teamOpen=false" style="display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;width:100%;border:none;background:none;font-size:12px;font-weight:500;color:#334155;cursor:pointer;font-family:inherit;transition:background .1s;text-align:left;box-sizing:border-box;" class="dark:!text-[#cbd5e1]" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='none'" :style="!teamFilter ? 'background:#f1f5f9;font-weight:700;' : ''">
                      <span style="flex:1;text-align:left;">Toutes les teams</span>
                      <iconify-icon x-show="!teamFilter" icon="solar:check-circle-bold" width="14" style="color:#7c3aed;"></iconify-icon>
                    </button>
                  </div>
                  <template x-for="team in teams" :key="'tdd-'+team._id">
                    <div style="display:block;">
                      <button @click="teamFilter=team._id; teamOpen=false" style="display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;width:100%;border:none;background:none;font-size:12px;font-weight:500;color:#334155;cursor:pointer;font-family:inherit;transition:background .1s;text-align:left;box-sizing:border-box;" class="dark:!text-[#cbd5e1]" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='none'" :style="teamFilter === team._id ? 'background:#f1f5f9;font-weight:700;' : ''">
                        <div :style="'width:8px;height:8px;border-radius:50%;flex-shrink:0;background:' + team.color"></div>
                        <span x-text="team.name" style="flex:1;text-align:left;"></span>
                        <span style="font-size:10px;color:#94a3b8;" x-text="(team.memberIds || []).length + ' membres'"></span>
                        <iconify-icon x-show="teamFilter === team._id" icon="solar:check-circle-bold" width="14" style="color:#7c3aed;"></iconify-icon>
                      </button>
                    </div>
                  </template>
                </div>
              </div>
            </template>
          </div>
          <div class="ts-members-toolbar-right">
            <div class="ts-search">
              <iconify-icon icon="solar:magnifer-linear" width="15" class="ts-search-icon"></iconify-icon>
              <input type="text" placeholder="Rechercher un membre..." x-model="searchQuery" />
            </div>
          </div>
        </div>

        <!-- Member Rows -->
        <div>
          <template x-for="member in filteredMembers" :key="member._id">
            <div class="ts-member-row" x-data="{open:false,editRole:false,confirmRevoke:false}" @click.outside="open=false;editRole=false;confirmRevoke=false">
              <div style="position:relative;flex-shrink:0;">
                <template x-if="member.avatar"><img :src="member.avatar" :alt="member.name" /></template>
                <template x-if="!member.avatar">
                  <div :style="'width:36px;min-width:36px;max-width:36px;height:36px;min-height:36px;max-height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff;flex-shrink:0;background:' + avatarColor(member.name)">
                    <span x-text="member.name.charAt(0).toUpperCase()"></span>
                  </div>
                </template>
                <span class="ts-status" :class="member.userStatus === 'active' ? 'ts-status-online' : 'ts-status-offline'" style="position:absolute;bottom:0;right:-2px;"></span>
              </div>
              <div class="ts-member-row-info" style="min-width:120px;">
                <div class="ts-member-row-name" x-text="member.name"></div>
                <div class="ts-member-row-email" x-text="member.email"></div>
              </div>
              <span class="ts-role-badge" :class="'ts-role-' + member.role" x-text="roleLabel(member.role)"></span>
              <!-- Team Badges -->
              <div style="display:flex;gap:4px;flex-wrap:wrap;min-width:0;">
                <template x-for="team in getMemberTeams(member._id)" :key="'tb-'+team._id">
                  <span class="ts-team-badge" :style="'background:' + team.color + '10;color:' + team.color">
                    <div :style="'width:6px;height:6px;border-radius:50%;background:' + team.color + ';flex-shrink:0;'"></div>
                    <span x-text="team.name"></span>
                  </span>
                </template>
              </div>
              <!-- Permission Status -->
              <template x-if="member.entityPermissions && member.entityPermissions.length > 0">
                <span style="font-size:10px;font-weight:600;padding:3px 8px;border-radius:6px;background:rgba(249,115,22,.08);color:#f97316;white-space:nowrap;" x-text="member.entityPermissions.length + ' entité(s)'"></span>
              </template>
              <template x-if="(!member.entityPermissions || member.entityPermissions.length === 0) && (!member.entityAccess || member.entityAccess.length === 0) && (member.role === 'owner' || member.role === 'admin')">
                <span style="font-size:10px;font-weight:600;padding:3px 8px;border-radius:6px;background:rgba(34,197,94,.08);color:#22c55e;white-space:nowrap;">Accès complet</span>
              </template>
              <template x-if="(!member.entityPermissions || member.entityPermissions.length === 0) && (!member.entityAccess || member.entityAccess.length === 0) && member.role !== 'owner' && member.role !== 'admin'">
                <span style="font-size:10px;font-weight:600;padding:3px 8px;border-radius:6px;background:rgba(148,163,184,.08);color:#94a3b8;white-space:nowrap;">Non restreint</span>
              </template>
              <!-- Actions -->
              <div style="display:flex;align-items:center;gap:6px;margin-left:auto;flex-shrink:0;">
                <a :href="'/account/<%= account_number %>/permissions?user=' + member._id" style="padding:4px 10px;border:1px solid #e0e6ed;background:#fff;border-radius:8px;font-size:11px;font-weight:600;color:#64748b;cursor:pointer;display:flex;align-items:center;gap:4px;font-family:inherit;white-space:nowrap;transition:all .15s;text-decoration:none;" onmouseover="this.style.borderColor='#4361ee';this.style.color='#4361ee'" onmouseout="this.style.borderColor='#e0e6ed';this.style.color='#64748b'" x-show="member.role !== 'owner'">
                  <iconify-icon icon="solar:lock-keyhole-bold" width="12"></iconify-icon> Accès
                </a>
                <div style="position:relative;" x-show="member.role !== 'owner'">
                  <button @click="open=!open" style="width:28px;height:28px;border-radius:8px;border:none;background:transparent;color:#94a3b8;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;" onmouseover="this.style.background='#f1f5f9';this.style.color='#0e1726'" onmouseout="this.style.background='transparent';this.style.color='#94a3b8'">
                    <iconify-icon icon="solar:menu-dots-bold" width="16"></iconify-icon>
                  </button>
                  <div x-show="open" x-transition style="position:absolute;right:0;top:32px;background:#fff;border:1px solid #e0e6ed;border-radius:12px;padding:6px;min-width:200px;box-shadow:0 8px 24px rgba(0,0,0,.1);z-index:10;" class="dark:!bg-[#0e1726] dark:!border-[#253b5c]">
                    <template x-if="!editRole">
                      <div>
                        <button @click="editRole=true" style="display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;width:100%;border:none;background:none;font-size:12px;font-weight:500;color:#334155;cursor:pointer;font-family:inherit;" class="dark:!text-[#cbd5e1]" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='none'">
                          <iconify-icon icon="solar:pen-bold" width="14"></iconify-icon> Modifier le rôle
                        </button>
                        <button @click="confirmRevoke ? (removeMember(member._id, member.name), open=false, confirmRevoke=false) : (confirmRevoke = true)" :style="confirmRevoke ? 'display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;width:100%;border:none;background:#fef2f2;font-size:12px;font-weight:600;color:#ef4444;cursor:pointer;font-family:inherit;' : 'display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;width:100%;border:none;background:none;font-size:12px;font-weight:500;color:#ef4444;cursor:pointer;font-family:inherit;'" onmouseover="if(!this.__x_refs)this.style.background='#fef2f2'" onmouseout="if(!this.__x_refs)this.style.background='none'">
                          <iconify-icon icon="solar:trash-bin-trash-bold" width="14"></iconify-icon>
                          <span x-text="confirmRevoke ? 'Confirmer la révocation' : 'Révoquer l\'accès'"></span>
                        </button>
                      </div>
                    </template>
                    <template x-if="editRole">
                      <div>
                        <div style="padding:6px 12px 4px;font-size:10px;font-weight:700;text-transform:uppercase;color:#94a3b8;">Choisir un rôle</div>
                        <template x-for="r in ['admin','manager','member','external','guest'].concat(customRoles.map(cr => cr.slug))" :key="r">
                          <button @click="updateRole(member._id, r); open=false; editRole=false" style="display:flex;align-items:center;gap:8px;padding:7px 12px;border-radius:8px;width:100%;border:none;background:none;font-size:12px;font-weight:500;color:#334155;cursor:pointer;font-family:inherit;" class="dark:!text-[#cbd5e1]" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='none'">
                            <span class="ts-role-badge" :class="'ts-role-' + r" x-text="roleLabel(r)" style="font-size:9px;"></span>
                            <iconify-icon x-show="member.role === r" icon="solar:check-circle-bold" width="14" style="color:#22c55e;margin-left:auto;"></iconify-icon>
                          </button>
                        </template>
                      </div>
                    </template>
                  </div>
                </div>
              </div>
            </div>
          </template>
          <template x-if="filteredMembers.length === 0">
            <div style="padding:40px 20px;text-align:center;color:#94a3b8;">
              <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="32" style="opacity:.5;"></iconify-icon>
              <p style="margin-top:8px;font-size:13px;">Aucun membre ne correspond aux filtres</p>
            </div>
          </template>
        </div>
      </div>

      <!-- Pending Invites -->
      <template x-if="invitations.length > 0">
        <div style="margin-top:24px;">
          <div class="ts-separator">
            <div class="ts-separator-line"></div>
            <div class="ts-separator-label">
              <iconify-icon icon="solar:letter-bold-duotone" width="14" style="color:#f97316"></iconify-icon>
              Invitations en attente
            </div>
            <div class="ts-separator-line"></div>
          </div>
          <div class="ts-members-section">
            <template x-for="inv in invitations" :key="inv.email">
              <div class="ts-member-row" style="opacity:.75;">
                <div style="width:36px;height:36px;border-radius:50%;background:rgba(249,115,22,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <iconify-icon icon="solar:letter-bold" width="16" style="color:#f97316"></iconify-icon>
                </div>
                <div class="ts-member-row-info">
                  <div class="ts-member-row-name" x-text="inv.email"></div>
                  <div class="ts-member-row-email" x-text="'Invitation envoyée ' + formatDate(inv.invitedAt)"></div>
                </div>
                <span class="ts-role-badge" :class="'ts-role-' + inv.role" x-text="roleLabel(inv.role)"></span>
                <div style="margin-left:auto;display:flex;gap:6px;align-items:center;">
                  <button class="ts-filter-btn" style="font-size:11px;padding:5px 10px;" @click="resendInvite(inv.email)">Renvoyer</button>
                  <button style="padding:6px;border:none;background:none;color:#ef4444;cursor:pointer;border-radius:6px;" @click="cancelInvite(inv.email)">
                    <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
                  </button>
                </div>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>
  </template>

  <!-- Invite Modal -->
  <template x-if="showInviteModal">
    <div class="ts-modal-overlay" @click.self="showInviteModal = false">
      <div class="ts-modal" @click.stop style="max-width:520px;">
        <div style="padding:20px 24px;border-bottom:1px solid #e0e6ed;display:flex;align-items:center;gap:12px;">
          <div style="width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:rgba(67,97,238,.1);flex-shrink:0;">
            <iconify-icon icon="solar:user-plus-bold-duotone" width="20" style="color:#4361ee;"></iconify-icon>
          </div>
          <div style="flex:1;">
            <div style="font-size:16px;font-weight:700;color:#0e1726;">Ajouter un membre</div>
            <div style="font-size:12px;color:#94a3b8;">Inviter par email ou ajouter un utilisateur existant</div>
          </div>
          <button @click="showInviteModal = false" style="border:none;background:#f1f5f9;cursor:pointer;padding:6px;border-radius:8px;color:#64748b;">
            <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
          </button>
        </div>
        <div style="padding:20px 24px;">
          <div x-show="inviteError" style="padding:10px 14px;border-radius:10px;background:rgba(239,68,68,.08);color:#ef4444;font-size:12px;font-weight:600;margin-bottom:14px;display:flex;align-items:center;gap:6px;">
            <iconify-icon icon="solar:danger-triangle-bold" width="14"></iconify-icon>
            <span x-text="inviteError"></span>
          </div>
          <div x-show="inviteSuccess" style="padding:10px 14px;border-radius:10px;background:rgba(34,197,94,.08);color:#22c55e;font-size:12px;font-weight:600;margin-bottom:14px;display:flex;align-items:center;gap:6px;">
            <iconify-icon icon="solar:check-circle-bold" width="14"></iconify-icon>
            <span x-text="inviteSuccess"></span>
          </div>

          <!-- Email Input with lookup -->
          <div style="margin-bottom:16px;">
            <label style="font-size:12px;font-weight:600;color:#334155;display:block;margin-bottom:6px;" class="dark:!text-[#cbd5e1]">Adresse email</label>
            <div style="position:relative;">
              <input type="email" placeholder="email@example.com" x-model="inviteEmail"
                @input.debounce.500ms="lookupEmail()"
                style="width:100%;padding:10px 14px 10px 38px;border:1.5px solid #e0e6ed;border-radius:10px;font-size:13px;font-family:inherit;outline:none;background:#fff;box-sizing:border-box;" class="dark:!bg-[#1b2e4b] dark:!border-[#253b5c] dark:!text-[#e0e6ed]"
                :style="inviteLookup ? 'border-color:#22c55e;' : ''" />
              <iconify-icon icon="solar:letter-bold-duotone" width="16" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94a3b8;pointer-events:none;"></iconify-icon>
            </div>
            <!-- Lookup result: existing user found -->
            <template x-if="inviteLookup">
              <div style="margin-top:8px;padding:10px 12px;border-radius:10px;background:rgba(34,197,94,.06);border:1px solid rgba(34,197,94,.15);display:flex;align-items:center;gap:10px;">
                <div :style="'width:28px;min-width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;background:' + avatarColor(inviteLookup.name)" x-text="inviteLookup.name.charAt(0).toUpperCase()"></div>
                <div style="flex:1;min-width:0;">
                  <div style="font-size:12px;font-weight:600;color:#0e1726;" x-text="inviteLookup.name"></div>
                  <div style="font-size:11px;color:#22c55e;display:flex;align-items:center;gap:3px;">
                    <iconify-icon icon="solar:check-circle-bold" width="11"></iconify-icon>
                    Utilisateur existant — sera ajouté directement
                  </div>
                </div>
              </div>
            </template>
          </div>

          <!-- Role Selector -->
          <div style="margin-bottom:16px;">
            <label style="font-size:12px;font-weight:600;color:#334155;display:block;margin-bottom:8px;" class="dark:!text-[#cbd5e1]">Rôle</label>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
              <template x-for="r in [{key:'admin',label:'Admin',desc:'Accès complet',icon:'solar:shield-bold-duotone',color:'#4361ee'},{key:'manager',label:'Manager',desc:'Gère son équipe',icon:'solar:user-check-bold-duotone',color:'#f97316'},{key:'member',label:'Membre',desc:'Accès standard',icon:'solar:user-bold-duotone',color:'#64748b'},{key:'external',label:'Externe',desc:'Accès limité',icon:'solar:link-round-bold-duotone',color:'#06b6d4'},{key:'guest',label:'Invité',desc:'Lecture seule',icon:'solar:eye-bold-duotone',color:'#10b981'}]" :key="r.key">
                <div class="ts-role-select-card dark:!border-[#253b5c]" :class="inviteRole === r.key && 'ts-role-select-active'" :style="inviteRole === r.key ? '--role-color:'+r.color+';border-color:'+r.color+';background:'+r.color+'08;box-shadow:0 0 0 3px '+r.color+'12' : '--role-color:#94a3b8'" @click="inviteRole = r.key">
                  <div style="display:flex;align-items:center;gap:10px;">
                    <div :style="'width:34px;min-width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:'+r.color+'12;transition:all .2s;'">
                      <iconify-icon :icon="r.icon" width="17" :style="'color:'+r.color"></iconify-icon>
                    </div>
                    <div style="flex:1;min-width:0;">
                      <div style="font-size:13px;font-weight:700;color:#0e1726;line-height:1.2;" class="dark:!text-[#e0e6ed]" x-text="r.label"></div>
                      <div style="font-size:11px;color:#94a3b8;margin-top:1px;" x-text="r.desc"></div>
                    </div>
                    <div :style="'width:18px;min-width:18px;height:18px;border-radius:50%;border:2px solid '+(inviteRole === r.key ? r.color : '#d1d5db')+';display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0;'">
                      <div :style="'width:8px;height:8px;border-radius:50%;background:'+(inviteRole === r.key ? r.color : 'transparent')+';transition:all .2s;'"></div>
                    </div>
                  </div>
                </div>
              </template>
            </div>
          </div>

          <!-- Entity Access Picker -->
          <div style="margin-bottom:18px;">
            <label style="font-size:12px;font-weight:600;color:#334155;display:block;margin-bottom:6px;" class="dark:!text-[#cbd5e1]">
              Accès aux entités
              <span style="font-weight:400;color:#94a3b8;">(vide = accès complet)</span>
            </label>
            <template x-if="allEntities.length === 0">
              <div style="padding:12px;text-align:center;color:#94a3b8;font-size:12px;border:1px dashed #e0e6ed;border-radius:10px;">Chargement des entités...</div>
            </template>
            <template x-if="allEntities.length > 0">
              <div style="max-height:160px;overflow-y:auto;border:1px solid #e0e6ed;border-radius:10px;padding:4px;" class="dark:!border-[#253b5c]">
                <template x-for="entity in allEntities" :key="entity._id">
                  <div :style="'display:flex;flex-direction:row;flex-wrap:nowrap;align-items:center;gap:10px;padding:7px 10px;border-radius:8px;cursor:pointer;transition:background .15s;' + (inviteEntityAccess.includes(String(entity._id)) ? 'background:rgba(67,97,238,.04)' : '')" @click="toggleInviteEntity(entity._id)">
                    <input type="checkbox" :checked="inviteEntityAccess.includes(String(entity._id))" style="accent-color:#4361ee;width:15px;min-width:15px;max-width:15px;height:15px;min-height:15px;max-height:15px;cursor:pointer;flex-shrink:0;margin:0;pointer-events:none;" />
                    <div :style="'width:24px;min-width:24px;max-width:24px;height:24px;min-height:24px;max-height:24px;border-radius:7px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;background:' + (entity.color || '#4361ee') + '15'">
                      <iconify-icon :icon="entity.icon || 'solar:folder-bold-duotone'" width="13" :style="'color:' + (entity.color || '#4361ee')"></iconify-icon>
                    </div>
                    <span style="font-size:13px;font-weight:500;color:#0e1726;" class="dark:!text-[#e0e6ed]" x-text="entity.name"></span>
                  </div>
                </template>
              </div>
            </template>
          </div>

          <!-- Actions -->
          <div style="display:flex;align-items:center;justify-content:flex-end;gap:10px;padding-top:6px;border-top:1px solid #f1f5f9;">
            <button @click="showInviteModal = false" style="padding:9px 18px;border:1px solid #e0e6ed;background:#fff;border-radius:10px;font-size:12px;font-weight:600;color:#64748b;cursor:pointer;font-family:inherit;">Annuler</button>
            <button @click="sendInvite()" :disabled="inviteSending" style="padding:9px 18px;border:none;border-radius:10px;font-size:12px;font-weight:600;color:#fff;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:6px;transition:all .15s;" :style="inviteLookup ? 'background:linear-gradient(135deg,#22c55e,#16a34a)' : 'background:linear-gradient(135deg,#4361ee,#3b82f6)'">
              <iconify-icon :icon="inviteLookup ? 'solar:user-plus-bold' : 'solar:plain-bold'" width="15"></iconify-icon>
              <span x-text="inviteSending ? 'Envoi...' : (inviteLookup ? 'Ajouter directement' : 'Envoyer l\'invitation')"></span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </template>

  <!-- Toast -->
  <div x-show="toast" x-transition :style="'position:fixed;bottom:24px;right:24px;z-index:1000;padding:12px 20px;border-radius:12px;font-size:13px;font-weight:600;color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.15);background:' + (toastType === 'success' ? 'linear-gradient(135deg,#22c55e,#16a34a)' : 'linear-gradient(135deg,#ef4444,#dc2626)')" x-text="toast"></div>

  <!-- Team Create/Edit Modal -->
  <template x-if="showTeamModal">
    <div style="position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;" @click.self="showTeamModal = false">
      <div style="position:absolute;inset:0;background:rgba(0,0,0,.35);backdrop-filter:blur(3px);"></div>
      <div style="position:relative;background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.18);width:480px;max-width:calc(100vw - 40px);max-height:85vh;overflow-y:auto;animation:nhSlideUp .3s ease;" x-transition @click.stop>
        <div style="padding:20px 24px;border-bottom:1px solid #e0e6ed;display:flex;align-items:center;gap:12px;">
          <div style="width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;" :style="'background:' + teamForm.color + '15'">
            <iconify-icon :icon="teamForm.icon" width="20" :style="'color:' + teamForm.color"></iconify-icon>
          </div>
          <div style="flex:1;">
            <div style="font-size:16px;font-weight:700;color:#0e1726;" x-text="teamForm._id ? 'Modifier la team' : 'Nouvelle team'"></div>
            <div style="font-size:12px;color:#94a3b8;">Organisez vos membres en groupes</div>
          </div>
          <button @click="showTeamModal = false" style="border:none;background:#f1f5f9;cursor:pointer;padding:6px;border-radius:8px;color:#64748b;">
            <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
          </button>
        </div>
        <div style="padding:20px 24px;">
          <div style="margin-bottom:14px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:4px;">Nom de la team *</label>
            <input type="text" x-model="teamForm.name" placeholder="ex: Développement" style="width:100%;padding:10px 14px;border:1.5px solid #e0e6ed;border-radius:10px;font-size:13px;outline:none;font-family:inherit;box-sizing:border-box;" onfocus="this.style.borderColor='#7c3aed'" onblur="this.style.borderColor='#e0e6ed'" />
          </div>
          <div style="margin-bottom:14px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:4px;">Description</label>
            <input type="text" x-model="teamForm.description" placeholder="Description optionnelle..." style="width:100%;padding:10px 14px;border:1.5px solid #e0e6ed;border-radius:10px;font-size:13px;outline:none;font-family:inherit;box-sizing:border-box;" onfocus="this.style.borderColor='#7c3aed'" onblur="this.style.borderColor='#e0e6ed'" />
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:6px;">Couleur</label>
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
              <template x-for="c in teamColors" :key="c">
                <button @click="teamForm.color = c" style="width:28px;height:28px;border-radius:8px;border:2px solid transparent;cursor:pointer;transition:all .15s;" :style="'background:' + c + (teamForm.color === c ? ';border-color:#0e1726;transform:scale(1.15)' : '')">
                </button>
              </template>
            </div>
          </div>
          <div>
            <label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:6px;">Membres <span style="color:#94a3b8;font-weight:400;" x-text="'(' + teamForm.memberIds.length + ' sélectionné(s))'"></span></label>
            <div style="max-height:220px;overflow-y:auto;border:1px solid #e0e6ed;border-radius:10px;padding:4px;">
              <template x-for="m in members" :key="m._id">
                <div :style="'display:flex;flex-direction:row;flex-wrap:nowrap;align-items:center;gap:10px;padding:8px 10px;border-radius:8px;cursor:pointer;transition:background .15s;' + (teamForm.memberIds.includes(String(m._id)) ? 'background:rgba(124,58,237,.04)' : '')" @click="toggleTeamMember(m._id)">
                  <input type="checkbox" :checked="teamForm.memberIds.includes(String(m._id))" style="accent-color:#7c3aed;width:16px;min-width:16px;max-width:16px;height:16px;min-height:16px;max-height:16px;cursor:pointer;flex-shrink:0;margin:0;pointer-events:none;" />
                  <div :style="'width:28px;min-width:28px;max-width:28px;height:28px;min-height:28px;max-height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0;line-height:1;background:' + avatarColor(m.name)" x-text="m.name.charAt(0).toUpperCase()"></div>
                  <div style="flex:1;min-width:0;overflow:hidden;">
                    <div style="font-size:13px;font-weight:600;color:#0e1726;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3;" x-text="m.name"></div>
                    <div style="font-size:11px;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3;" x-text="m.email"></div>
                  </div>
                  <span style="font-size:10px;font-weight:600;padding:2px 8px;border-radius:6px;background:#f1f5f9;color:#64748b;flex-shrink:0;white-space:nowrap;" x-text="roleLabel(m.role)"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
        <div style="padding:14px 24px 20px;display:flex;align-items:center;gap:8px;justify-content:space-between;">
          <div>
            <template x-if="teamForm._id">
              <button @click="confirmDeleteTeam ? deleteTeam(teamForm._id) : (confirmDeleteTeam = true)" :style="confirmDeleteTeam ? 'padding:8px 16px;border:1px solid #ef4444;background:#ef4444;border-radius:8px;font-size:12px;font-weight:600;color:#fff;cursor:pointer;font-family:inherit;transition:all .15s;' : 'padding:8px 16px;border:1px solid #fecaca;background:#fef2f2;border-radius:8px;font-size:12px;font-weight:600;color:#ef4444;cursor:pointer;font-family:inherit;transition:all .15s;'">
                <iconify-icon icon="solar:trash-bin-minimalistic-bold" width="12" style="vertical-align:-2px;"></iconify-icon>
                <span x-text="confirmDeleteTeam ? 'Confirmer la suppression' : 'Supprimer'"></span>
              </button>
            </template>
          </div>
          <div style="display:flex;gap:8px;">
            <button @click="showTeamModal = false" style="padding:8px 18px;border:1px solid #e0e6ed;background:#fff;border-radius:8px;font-size:13px;font-weight:500;color:#64748b;cursor:pointer;font-family:inherit;">Annuler</button>
            <button @click="saveTeam()" style="padding:8px 18px;border:none;background:linear-gradient(135deg,#7c3aed,#a855f7);border-radius:8px;font-size:13px;font-weight:600;color:#fff;cursor:pointer;font-family:inherit;transition:all .15s;" x-text="teamForm._id ? 'Enregistrer' : 'Créer la team'"></button>
          </div>
        </div>
      </div>
    </div>
  </template>

  <!-- Permissions Modal -->
  <template x-if="showPermissionsModal">
    <div style="position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;" @click.self="showPermissionsModal = false">
      <div style="position:absolute;inset:0;background:rgba(0,0,0,.35);backdrop-filter:blur(3px);"></div>
      <div style="position:relative;background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.18);width:520px;max-width:calc(100vw - 40px);max-height:85vh;overflow-y:auto;animation:nhSlideUp .3s ease;" x-transition @click.stop>
        <div style="padding:20px 24px;border-bottom:1px solid #e0e6ed;display:flex;align-items:center;gap:12px;">
          <div style="width:40px;height:40px;border-radius:12px;background:rgba(67,97,238,.1);display:flex;align-items:center;justify-content:center;">
            <iconify-icon icon="solar:lock-keyhole-bold-duotone" width="20" style="color:#4361ee"></iconify-icon>
          </div>
          <div style="flex:1;">
            <div style="font-size:16px;font-weight:700;color:#0e1726;" x-text="'Accès de ' + (permMember?.name || '')"></div>
            <div style="font-size:12px;color:#94a3b8;">Choisissez les entités accessibles</div>
          </div>
          <button @click="showPermissionsModal = false" style="border:none;background:#f1f5f9;cursor:pointer;padding:6px;border-radius:8px;color:#64748b;">
            <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
          </button>
        </div>
        <div style="padding:20px 24px;">
          <!-- Quick actions -->
          <div style="display:flex;gap:8px;margin-bottom:14px;">
            <button @click="permEntityAccess = []" style="padding:6px 14px;border:1px solid #e0e6ed;border-radius:8px;background:#fff;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .15s;" :style="permEntityAccess.length === 0 ? 'border-color:#22c55e;background:rgba(34,197,94,.06);color:#22c55e' : 'color:#64748b'">
              <iconify-icon icon="solar:check-circle-bold" width="12" style="vertical-align:-1px;"></iconify-icon> Accès complet
            </button>
            <button @click="permEntityAccess = allEntities.map(e => String(e._id))" style="padding:6px 14px;border:1px solid #e0e6ed;border-radius:8px;background:#fff;font-size:12px;font-weight:600;color:#64748b;cursor:pointer;font-family:inherit;transition:all .15s;">
              <iconify-icon icon="solar:checklist-bold" width="12" style="vertical-align:-1px;"></iconify-icon> Tout cocher
            </button>
          </div>
          <div style="font-size:11px;color:#94a3b8;margin-bottom:10px;font-weight:500;">
            <iconify-icon icon="solar:info-circle-bold" width="12" style="vertical-align:-1px;"></iconify-icon>
            Aucune sélection = accès à toutes les entités
          </div>
          <!-- Entity Grid -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;max-height:300px;overflow-y:auto;">
            <template x-for="entity in allEntities" :key="entity._id">
              <div :style="'display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;border:1.5px solid ' + (permEntityAccess.includes(String(entity._id)) ? (entity.color || '#4361ee') : '#e0e6ed') + ';cursor:pointer;transition:all .15s;' + (permEntityAccess.includes(String(entity._id)) ? 'background:' + (entity.color || '#4361ee') + '06' : '')" @click="togglePermEntity(entity._id)">
                <input type="checkbox" :checked="permEntityAccess.includes(String(entity._id))" style="accent-color:#4361ee;width:15px;min-width:15px;max-width:15px;height:15px;min-height:15px;max-height:15px;cursor:pointer;flex-shrink:0;margin:0;pointer-events:none;" />
                <div :style="'width:28px;min-width:28px;max-width:28px;height:28px;min-height:28px;max-height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;background:' + (entity.color || '#4361ee') + '15'">
                  <iconify-icon :icon="entity.icon || 'solar:folder-bold-duotone'" width="14" :style="'color:' + (entity.color || '#4361ee')"></iconify-icon>
                </div>
                <span style="font-size:13px;font-weight:600;color:#0e1726;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" x-text="entity.name"></span>
              </div>
            </template>
          </div>
        </div>
        <div style="padding:14px 24px 20px;display:flex;justify-content:flex-end;gap:8px;border-top:1px solid #f1f5f9;">
          <button @click="showPermissionsModal = false" style="padding:8px 18px;border:1px solid #e0e6ed;background:#fff;border-radius:8px;font-size:13px;font-weight:500;color:#64748b;cursor:pointer;font-family:inherit;">Annuler</button>
          <button @click="savePermissions()" style="padding:8px 18px;border:none;background:linear-gradient(135deg,#4361ee,#3b82f6);border-radius:8px;font-size:13px;font-weight:600;color:#fff;cursor:pointer;font-family:inherit;transition:all .15s;">Enregistrer</button>
        </div>
      </div>
    </div>
  </template>
</div>

<style>@keyframes spin { to { transform: rotate(360deg); } }</style>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('teamHub', () => ({
    loading: true,
    viewMode: 'list',
    activeFilter: 'all',
    searchQuery: '',
    accountName: '',
    members: [],
    invitations: [],
    teams: [],
    teamFilter: null,
    allEntities: [],

    // Team modal
    showTeamModal: false,
    confirmDeleteTeam: false,
    teamForm: { _id: null, name: '', description: '', color: '#4361ee', icon: 'solar:users-group-rounded-bold-duotone', memberIds: [] },
    teamColors: ['#4361ee','#7c3aed','#f97316','#10b981','#ec4899','#06b6d4','#ef4444','#8b5cf6','#eab308','#14b8a6'],
    showInviteModal: false,
    inviteEmail: '',
    inviteRole: 'member',
    inviteSending: false,
    inviteError: '',
    inviteSuccess: '',
    inviteEntityAccess: [],
    inviteLookup: null,

    // Permissions modal
    showPermissionsModal: false,
    permMember: null,
    permEntityAccess: [],
    toast: '',
    toastType: 'success',
    customRoles: [],
    allRoles: [
      { key: 'all', label: 'Tous' },
      { key: 'owner', label: 'Owner' },
      { key: 'admin', label: 'Admin' },
      { key: 'manager', label: 'Manager' },
      { key: 'member', label: 'Membre' },
      { key: 'external', label: 'Externe' },
      { key: 'guest', label: 'Invité' }
    ],
    apiBase: '/account/<%= account_number %>/api/team',

    async init() {
      await Promise.all([this.fetchMembers(), this.fetchEntities(), this.fetchCustomRoles()]);
      this.loading = false;
    },

    async fetchCustomRoles() {
      try {
        const res = await fetch(this.apiBase + '/roles', { credentials: 'include' });
        const data = await res.json();
        if (data.success) {
          this.customRoles = data.roles.filter(r => r.isCustom);
          // Add custom roles to allRoles filter
          for (const cr of this.customRoles) {
            if (!this.allRoles.find(r => r.key === cr.slug)) {
              this.allRoles.push({ key: cr.slug, label: cr.name });
            }
          }
        }
      } catch (e) { /* silent - custom roles are optional */ }
    },

    async fetchEntities() {
      try {
        const res = await fetch(this.apiBase + '/entities', { credentials: 'include' });
        const data = await res.json();
        if (data.success) this.allEntities = data.entities;
      } catch (e) { console.error('fetchEntities error:', e); }
    },

    async fetchMembers() {
      try {
        const res = await fetch(this.apiBase + '/members', { credentials: 'include' });
        const data = await res.json();
        if (data.success) {
          this.members = data.members;
          this.invitations = data.invitations;
          this.teams = data.teams || [];
          this.accountName = data.accountName;
        }
      } catch (e) { console.error('fetchMembers error:', e); }
    },



    async sendInvite() {
      this.inviteError = '';
      this.inviteSuccess = '';
      if (!this.inviteEmail.trim()) { this.inviteError = 'Email requis'; return; }
      this.inviteSending = true;
      try {
        const res = await fetch(this.apiBase + '/invite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email: this.inviteEmail, role: this.inviteRole, entityAccess: this.inviteEntityAccess }),
        });
        const data = await res.json();
        if (data.success) {
          this.inviteSuccess = data.message;
          this.inviteEmail = '';
          this.inviteEntityAccess = [];
          this.inviteLookup = null;
          await this.fetchMembers();
          setTimeout(() => { this.showInviteModal = false; this.inviteSuccess = ''; }, 1500);
          this.showToast(data.message, 'success');
        } else {
          this.inviteError = data.error;
        }
      } catch (e) { this.inviteError = 'Erreur réseau'; }
      this.inviteSending = false;
    },

    async lookupEmail() {
      this.inviteLookup = null;
      const email = this.inviteEmail?.trim();
      if (!email || !email.includes('@') || email.length < 5) return;
      try {
        const res = await fetch(this.apiBase + '/lookup-user?email=' + encodeURIComponent(email), { credentials: 'include' });
        const data = await res.json();
        if (data.found) {
          this.inviteLookup = { name: data.name, email: data.email };
        }
      } catch (e) { /* silent */ }
    },

    async updateRole(userId, newRole) {
      try {
        const res = await fetch(this.apiBase + '/update-role', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ userId, newRole }),
        });
        const data = await res.json();
        if (data.success) {
          await this.fetchMembers();
          this.showToast('Rôle mis à jour', 'success');
        }
      } catch (e) { this.showToast('Erreur', 'error'); }
    },

    async removeMember(userId, name) {
      try {
        const res = await fetch(this.apiBase + '/remove-member', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ userId }),
        });
        const data = await res.json();
        if (data.success) {
          await this.fetchMembers();
          this.showToast(name + ' retiré', 'success');
        } else {
          this.showToast(data.error, 'error');
        }
      } catch (e) { this.showToast('Erreur', 'error'); }
    },

    async resendInvite(email) {
      try {
        await fetch(this.apiBase + '/resend-invite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email }),
        });
        this.showToast('Invitation renvoyée', 'success');
      } catch (e) { this.showToast('Erreur', 'error'); }
    },

    async cancelInvite(email) {
      try {
        await fetch(this.apiBase + '/cancel-invite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email }),
        });
        await this.fetchMembers();
        this.showToast('Invitation annulée', 'success');
      } catch (e) { this.showToast('Erreur', 'error'); }
    },

    showToast(msg, type) {
      this.toast = msg;
      this.toastType = type;
      setTimeout(() => { this.toast = ''; }, 3000);
    },

    // Entity Permissions
    openPermissionsModal(member) {
      if (member.role === 'owner') return;
      this.permMember = member;
      this.permEntityAccess = [...(member.entityAccess || [])];
      this.showPermissionsModal = true;
    },

    togglePermEntity(entityId) {
      const id = String(entityId);
      const idx = this.permEntityAccess.indexOf(id);
      if (idx === -1) this.permEntityAccess.push(id);
      else this.permEntityAccess.splice(idx, 1);
    },

    toggleInviteEntity(entityId) {
      const id = String(entityId);
      const idx = this.inviteEntityAccess.indexOf(id);
      if (idx === -1) this.inviteEntityAccess.push(id);
      else this.inviteEntityAccess.splice(idx, 1);
    },

    async savePermissions() {
      if (!this.permMember) return;
      try {
        const res = await fetch(this.apiBase + '/update-permissions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ userId: String(this.permMember._id), entityAccess: this.permEntityAccess }),
        });
        const data = await res.json();
        if (data.success) {
          this.showPermissionsModal = false;
          await this.fetchMembers();
          this.showToast('Permissions mises à jour', 'success');
        } else {
          this.showToast(data.error || 'Erreur', 'error');
        }
      } catch (e) { this.showToast('Erreur', 'error'); }
    },

    get filteredMembers() {
      let list = this.members;
      if (this.activeFilter !== 'all') list = list.filter(m => m.role === this.activeFilter);
      if (this.teamFilter) list = list.filter(m => (m.teamIds || []).some(tid => String(tid) === String(this.teamFilter)));
      if (this.searchQuery.trim()) {
        const q = this.searchQuery.toLowerCase();
        list = list.filter(m => m.name.toLowerCase().includes(q) || m.email.toLowerCase().includes(q));
      }
      return list;
    },

    getMemberName(userId) {
      const m = this.members.find(m => String(m._id) === String(userId));
      return m?.name || 'Inconnu';
    },

    getMemberTeams(userId) {
      return this.teams.filter(t => (t.memberIds || []).some(mid => String(mid) === String(userId)));
    },

    openTeamModal(team) {
      if (team) {
        this.teamForm = { _id: team._id, name: team.name, description: team.description || '', color: team.color, icon: team.icon, memberIds: [...(team.memberIds || [])] };
      } else {
        this.teamForm = { _id: null, name: '', description: '', color: '#4361ee', icon: 'solar:users-group-rounded-bold-duotone', memberIds: [] };
      }
      this.confirmDeleteTeam = false;
      this.showTeamModal = true;
    },

    toggleTeamMember(userId) {
      const idx = this.teamForm.memberIds.indexOf(String(userId));
      if (idx === -1) this.teamForm.memberIds.push(String(userId));
      else this.teamForm.memberIds.splice(idx, 1);
    },

    async saveTeam() {
      if (!this.teamForm.name.trim()) return;
      try {
        const url = this.teamForm._id
          ? this.apiBase + '/teams/' + this.teamForm._id
          : this.apiBase + '/teams';
        const method = this.teamForm._id ? 'PUT' : 'POST';
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(this.teamForm),
        });
        const data = await res.json();
        if (data.success) {
          this.showTeamModal = false;
          await this.fetchMembers();
          this.showToast(this.teamForm._id ? 'Team mise à jour' : 'Team créée', 'success');
        }
      } catch (e) { this.showToast('Erreur', 'error'); }
    },

    async deleteTeam(teamId) {
      try {
        const res = await fetch(this.apiBase + '/teams/' + teamId, { method: 'DELETE', credentials: 'include' });
        const data = await res.json();
        if (data.success) {
          this.showTeamModal = false;
          this.confirmDeleteTeam = false;
          if (this.teamFilter === teamId) this.teamFilter = null;
          await this.fetchMembers();
          this.showToast('Team supprimée', 'success');
        } else {
          this.showToast(data.error || 'Erreur', 'error');
        }
      } catch (e) {
        console.error('[Team] Delete error:', e);
        this.showToast('Erreur réseau', 'error');
      }
      this.confirmDeleteTeam = false;
    },

    roleLabel(role) {
      const sys = { owner:'Owner', admin:'Admin', manager:'Manager', member:'Membre', external:'Externe', guest:'Invité', viewer:'Viewer' };
      if (sys[role]) return sys[role];
      const custom = this.customRoles.find(r => r.slug === role);
      return custom ? custom.name : role;
    },

    avatarColor(name) {
      const colors = ['#4361ee','#7c3aed','#f97316','#10b981','#ec4899','#06b6d4','#ef4444','#8b5cf6'];
      let hash = 0;
      for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
      return colors[Math.abs(hash) % colors.length];
    },

    formatDate(d) {
      if (!d) return '-';
      const date = new Date(d);
      return date.toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' });
    },
  }));
});
</script>

<style>
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes nhSlideUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
</style>
