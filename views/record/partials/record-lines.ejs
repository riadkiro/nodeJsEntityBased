<%# ═══════════════════════════════════════════════════════════════════
    Lines Generator Panel — Mission 10
    Dynamic line table for records (invoices, prescriptions, etc.)
    ═══════════════════════════════════════════════════════════════════ %>

<style>
    /* ── Lines Panel Styles ───────────────────────────────── */
    .lines-panel-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    .lines-panel-table th {
        background: #f8f9fa;
        padding: 6px 8px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        border-bottom: 2px solid #e5e7eb;
        text-align: left;
        white-space: nowrap;
        user-select: none;
    }
    .dark .lines-panel-table th {
        background: #1b2e4b;
        color: #888ea8;
        border-color: #253b5c;
    }
    .lines-panel-table td {
        padding: 4px 6px;
        border-bottom: 1px solid #f0f0f0;
        vertical-align: middle;
    }
    .dark .lines-panel-table td {
        border-color: #1b2e4b;
    }
    .lines-panel-table tbody tr:hover {
        background: rgba(67, 97, 238, 0.03);
    }
    .dark .lines-panel-table tbody tr:hover {
        background: rgba(67, 97, 238, 0.06);
    }
    .lines-panel-table .lp-input {
        width: 100%;
        border: 1px solid transparent;
        border-radius: 6px;
        padding: 5px 8px;
        font-size: 12px;
        background: transparent;
        transition: all 0.15s;
        color: inherit;
    }
    .lines-panel-table .lp-input:hover {
        border-color: #e5e7eb;
        background: #fafbfc;
    }
    .dark .lines-panel-table .lp-input:hover {
        border-color: #253b5c;
        background: #0e1726;
    }
    .lines-panel-table .lp-input:focus {
        outline: none;
        border-color: #4361ee;
        background: #fff;
        box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.1);
    }
    .dark .lines-panel-table .lp-input:focus {
        background: #0e1726;
    }
    .lines-panel-table select.lp-input {
        cursor: pointer;
        padding-right: 20px;
    }
    /* Formula / computed cells */
    .lp-computed {
        font-weight: 600;
        color: #4361ee;
        font-size: 12px;
        text-align: right;
        padding: 5px 8px;
    }
    .dark .lp-computed {
        color: #6993ff;
    }
    /* Drag handle */
    .lp-drag-handle {
        cursor: grab;
        color: #d1d5db;
        transition: color 0.15s;
        padding: 2px;
    }
    .lp-drag-handle:active { cursor: grabbing; }
    .lp-drag-handle:hover { color: #6b7280; }
    .dark .lp-drag-handle { color: #3b4a5e; }
    .dark .lp-drag-handle:hover { color: #888ea8; }
    /* Row action buttons */
    .lp-row-actions {
        display: flex; gap: 2px; align-items: center;
        opacity: 0; transition: opacity 0.15s;
    }
    .lines-panel-table tbody tr:hover .lp-row-actions { opacity: 1; }
    .lp-row-btn {
        padding: 3px; border-radius: 4px; border: none;
        background: transparent; cursor: pointer; line-height: 1;
        transition: background 0.12s, color 0.12s;
    }
    .lp-row-btn.edit { color: #6b7280; }
    .lp-row-btn.edit:hover { color: #4361ee; background: rgba(67, 97, 238, 0.08); }
    .dark .lp-row-btn.edit { color: #888ea8; }
    .dark .lp-row-btn.edit:hover { color: #6993ff; background: rgba(67, 97, 238, 0.15); }
    .lp-row-btn.delete { color: #ef4444; }
    .lp-row-btn.delete:hover { background: rgba(239, 68, 68, 0.08); }
    /* Relation search dropdown */
    .lp-relation-wrap { position: relative; }
    .lp-relation-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 50;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        max-height: 180px;
        overflow-y: auto;
        margin-top: 2px;
    }
    .dark .lp-relation-dropdown {
        background: #0e1726;
        border-color: #253b5c;
    }
    .lp-relation-dropdown .lp-rel-item {
        padding: 6px 10px;
        font-size: 12px;
        cursor: pointer;
        transition: background 0.1s;
    }
    .lp-relation-dropdown .lp-rel-item:hover {
        background: rgba(67, 97, 238, 0.08);
    }
    /* Totals row */
    .lp-totals-bar {
        display: flex;
        justify-content: flex-end;
        gap: 24px;
        padding: 10px 12px;
        background: #f8f9fa;
        border-top: 2px solid #e5e7eb;
        border-radius: 0 0 8px 8px;
        font-size: 12px;
    }
    .dark .lp-totals-bar {
        background: #1b2e4b;
        border-color: #253b5c;
    }
    .lp-totals-bar .lp-total-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .lp-totals-bar .lp-total-label {
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        font-size: 10px;
        letter-spacing: 0.05em;
    }
    .dark .lp-totals-bar .lp-total-label { color: #888ea8; }
    .lp-totals-bar .lp-total-value {
        font-weight: 700;
        font-size: 14px;
        color: #1f2937;
    }
    .dark .lp-totals-bar .lp-total-value { color: #e0e6ed; }
    /* Width classes */
    .lp-w-xs { min-width: 50px; max-width: 70px; }
    .lp-w-s  { min-width: 70px; max-width: 100px; }
    .lp-w-m  { min-width: 120px; }
    .lp-w-l  { min-width: 180px; }
    .lp-w-xl { min-width: 240px; }
    /* Schema selector */
    .lp-schema-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid #e5e7eb;
        color: #6b7280;
        background: #fff;
        transition: all 0.15s;
    }
    .dark .lp-schema-pill {
        border-color: #253b5c;
        background: #0e1726;
        color: #888ea8;
    }
    .lp-schema-pill:hover, .lp-schema-pill.active {
        border-color: #4361ee;
        color: #4361ee;
        background: rgba(67, 97, 238, 0.06);
    }
    .lp-schema-pill.active {
        background: rgba(67, 97, 238, 0.1);
    }
    /* Multiselect tags */
    .lp-ms-tag {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 1px 6px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 600;
        background: rgba(67, 97, 238, 0.1);
        color: #4361ee;
        margin: 1px;
    }
    .lp-ms-tag .lp-ms-tag-x {
        cursor: pointer;
        font-size: 12px;
        line-height: 1;
        opacity: 0.6;
    }
    .lp-ms-tag .lp-ms-tag-x:hover { opacity: 1; }
    /* Add row button area */
    .lp-add-row-area {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        border-top: 1px dashed #e5e7eb;
        cursor: pointer;
        color: #9ca3af;
        font-size: 12px;
        transition: all 0.15s;
        gap: 6px;
    }
    .dark .lp-add-row-area { border-color: #1b2e4b; color: #4a5568; }
    .lp-add-row-area:hover {
        background: rgba(67, 97, 238, 0.04);
        color: #4361ee;
    }
    /* Sortable ghost */
    .lines-panel-table .sortable-ghost { opacity: 0.3; }
    .lines-panel-table .sortable-chosen { background: rgba(67, 97, 238, 0.05); }

    /* ── Add Lines Modal ─────────────────────────────── */
    .lp-modal-overlay {
        position: fixed; inset: 0; z-index: 9999;
        background: rgba(0,0,0,0.45);
        display: flex; align-items: center; justify-content: center;
        animation: lp-fade-in 0.15s ease;
    }
    @keyframes lp-fade-in { from { opacity: 0; } to { opacity: 1; } }
    .lp-modal {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        width: 680px;
        max-width: 95vw;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        animation: lp-slide-up 0.2s ease;
        overflow: hidden;
    }
    .dark .lp-modal { background: #0e1726; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
    @keyframes lp-slide-up { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .lp-modal-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 20px; border-bottom: 1px solid #e5e7eb;
    }
    .dark .lp-modal-header { border-color: #253b5c; }
    .lp-modal-header h3 {
        font-size: 15px; font-weight: 700; color: #1f2937; margin: 0;
        display: flex; align-items: center; gap: 8px;
    }
    .dark .lp-modal-header h3 { color: #e0e6ed; }
    .lp-modal-close {
        width: 28px; height: 28px; border-radius: 8px; border: none;
        background: transparent; cursor: pointer; color: #9ca3af;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s;
    }
    .lp-modal-close:hover { background: #f3f4f6; color: #374151; }
    .dark .lp-modal-close:hover { background: #1b2e4b; color: #e0e6ed; }
    .lp-modal-search {
        padding: 12px 20px; border-bottom: 1px solid #e5e7eb;
    }
    .dark .lp-modal-search { border-color: #253b5c; }
    .lp-modal-search-input {
        width: 100%; padding: 10px 12px 10px 40px !important; border-radius: 10px;
        border: 1.5px solid #e5e7eb; font-size: 13px; background: #f8f9fa;
        transition: all 0.15s; color: inherit;
    }
    .dark .lp-modal-search-input { background: #1b2e4b; border-color: #253b5c; color: #e0e6ed; }
    .lp-modal-search-input:focus {
        outline: none; border-color: #4361ee; background: #fff;
        box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
    }
    .dark .lp-modal-search-input:focus { background: #0e1726; }
    .lp-modal-search-wrap {
        position: relative;
    }
    .lp-modal-search-wrap .lp-search-icon {
        position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
        color: #9ca3af; pointer-events: none; z-index: 1;
        display: flex; align-items: center; justify-content: center;
    }
    /* Manual add section */
    .lp-manual-add {
        padding: 8px 20px 12px; border-bottom: 1px solid #e5e7eb;
    }
    .dark .lp-manual-add { border-color: #253b5c; }
    .lp-manual-add-label {
        font-size: 11px; color: #6b7280; margin-bottom: 6px; display: flex; align-items: center; gap: 4px;
    }
    .dark .lp-manual-add-label { color: #9ca3af; }
    .lp-manual-add-row {
        display: flex; gap: 6px; position: relative;
    }
    .lp-manual-add-input {
        flex: 1; padding: 8px 12px; border-radius: 8px;
        border: 1.5px solid #e5e7eb; font-size: 13px; background: #fff;
        transition: all 0.15s; color: inherit;
    }
    .dark .lp-manual-add-input { background: #1b2e4b; border-color: #253b5c; color: #e0e6ed; }
    .lp-manual-add-input:focus {
        outline: none; border-color: #4361ee; background: #fff;
        box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
    }
    .dark .lp-manual-add-input:focus { background: #0e1726; }
    .lp-manual-add-btn {
        width: 36px; height: 36px; border-radius: 8px; border: none;
        background: #4361ee; color: #fff; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s; flex-shrink: 0;
    }
    .lp-manual-add-btn:hover { background: #3651d4; transform: scale(1.05); }
    .lp-manual-add-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
    .lp-manual-autocomplete {
        position: absolute; top: 100%; left: 0; right: 42px; z-index: 10;
        background: #fff; border: 1px solid #e5e7eb; border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1); max-height: 180px; overflow-y: auto;
        margin-top: 4px;
    }
    .dark .lp-manual-autocomplete { background: #0e1726; border-color: #253b5c; }
    .lp-manual-autocomplete-item {
        padding: 8px 12px; font-size: 12px; cursor: pointer;
        border-bottom: 1px solid #f3f4f6; transition: background 0.1s;
        display: flex; align-items: center; gap: 8px;
    }
    .dark .lp-manual-autocomplete-item { border-color: #1b2e4b; }
    .lp-manual-autocomplete-item:hover { background: rgba(67, 97, 238, 0.06); }
    .lp-manual-autocomplete-item:last-child { border-bottom: none; }
    .lp-manual-autocomplete-item .lp-ac-title {
        font-weight: 500; color: #1f2937;
    }
    .dark .lp-manual-autocomplete-item .lp-ac-title { color: #e0e6ed; }
    .lp-manual-autocomplete-item .lp-ac-desc {
        font-size: 11px; color: #9ca3af;
    }
    .lp-modal-body {
        flex: 1; overflow-y: auto; padding: 0;
        min-height: 200px;
    }
    .lp-modal-empty {
        padding: 40px 20px; text-align: center; color: #9ca3af;
    }
    .lp-modal-empty iconify-icon { display: block; margin: 0 auto 8px; opacity: 0.5; }
    .lp-catalog-item {
        display: flex; align-items: flex-start; gap: 10px;
        padding: 10px 20px;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.1s;
        cursor: pointer;
    }
    .dark .lp-catalog-item { border-color: #1b2e4b; }
    .lp-catalog-item:hover { background: rgba(67, 97, 238, 0.03); }
    .lp-catalog-item.selected { background: rgba(67, 97, 238, 0.06); }
    .dark .lp-catalog-item.selected { background: rgba(67, 97, 238, 0.12); }
    .lp-catalog-check {
        width: 18px; height: 18px; border-radius: 5px;
        border: 2px solid #d1d5db; background: #fff;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s; flex-shrink: 0; margin-top: 2px;
    }
    .dark .lp-catalog-check { border-color: #3b4a5e; background: #1b2e4b; }
    .lp-catalog-item.selected .lp-catalog-check {
        background: #4361ee; border-color: #4361ee;
    }
    .lp-catalog-info { flex: 1; min-width: 0; }
    .lp-catalog-title {
        font-size: 13px; font-weight: 600; color: #1f2937;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .dark .lp-catalog-title { color: #e0e6ed; }
    .lp-catalog-sub {
        font-size: 11px; color: #9ca3af; margin-top: 2px;
    }
    /* Selected item config form */
    .lp-config-fields {
        display: flex; flex-direction: column; gap: 6px; margin-top: 8px;
        padding: 8px 10px; background: rgba(67, 97, 238, 0.03);
        border-radius: 8px; border: 1px solid rgba(67, 97, 238, 0.08);
    }
    .dark .lp-config-fields {
        background: rgba(67, 97, 238, 0.05);
        border-color: rgba(67, 97, 238, 0.1);
    }
    .lp-config-field {
        display: flex; align-items: flex-start; gap: 8px;
    }
    .lp-config-field label {
        font-size: 10px; font-weight: 600; color: #6b7280;
        text-transform: uppercase; letter-spacing: 0.03em;
        white-space: nowrap; min-width: 55px; padding-top: 4px;
    }
    .dark .lp-config-field label { color: #888ea8; }
    .lp-config-field input, .lp-config-field select {
        border: 1px solid #e5e7eb; border-radius: 6px;
        padding: 4px 6px; font-size: 12px; background: #fff;
        color: inherit; min-width: 50px;
    }
    .dark .lp-config-field input, .dark .lp-config-field select {
        background: #0e1726; border-color: #253b5c; color: #e0e6ed;
    }
    .lp-config-field input:focus, .lp-config-field select:focus {
        outline: none; border-color: #4361ee;
    }
    .lp-config-field input[type="number"] { width: 60px; text-align: right; }
    .lp-modal-footer {
        padding: 12px 20px; border-top: 1px solid #e5e7eb;
        display: flex; align-items: center; justify-content: space-between;
    }
    .dark .lp-modal-footer { border-color: #253b5c; }
    .lp-modal-footer .lp-sel-count {
        font-size: 12px; color: #6b7280; font-weight: 600;
    }
    .dark .lp-modal-footer .lp-sel-count { color: #888ea8; }
    .lp-modal-footer .lp-btn-add {
        padding: 8px 24px; border-radius: 10px; border: none;
        background: #4361ee; color: #fff; font-size: 13px;
        font-weight: 600; cursor: pointer; transition: all 0.15s;
        display: flex; align-items: center; gap: 6px;
    }
    .lp-modal-footer .lp-btn-add:hover { background: #3651d4; }
    .lp-modal-footer .lp-btn-add:disabled {
        opacity: 0.4; cursor: not-allowed;
    }
    .lp-modal-footer .lp-btn-cancel {
        padding: 8px 16px; border-radius: 10px;
        border: 1px solid #e5e7eb; background: transparent;
        color: #6b7280; font-size: 13px; font-weight: 500;
        cursor: pointer; transition: all 0.15s;
    }
    .dark .lp-modal-footer .lp-btn-cancel { border-color: #253b5c; color: #888ea8; }
    .lp-modal-footer .lp-btn-cancel:hover { background: #f3f4f6; }
    .dark .lp-modal-footer .lp-btn-cancel:hover { background: #1b2e4b; }

    /* Multiselect toggle pills (add modal) */
    .lp-multi-pills {
        display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px;
    }
    .lp-pill {
        padding: 3px 10px; border-radius: 20px; border: 1.5px solid #e5e7eb;
        background: transparent; font-size: 11px; font-weight: 500;
        color: #6b7280; cursor: pointer; transition: all 0.15s;
        white-space: nowrap; line-height: 1.4;
    }
    .dark .lp-pill { border-color: #253b5c; color: #888ea8; }
    .lp-pill:hover { border-color: #4361ee; color: #4361ee; }
    .lp-pill.active {
        background: rgba(67, 97, 238, 0.12); border-color: #4361ee;
        color: #4361ee; font-weight: 600;
    }
    .dark .lp-pill.active {
        background: rgba(67, 97, 238, 0.2); border-color: #6993ff; color: #6993ff;
    }

    /* ── Inline multiselect tag-picker ── */
    .lp-ms-wrap {
        position: relative;
        min-width: 100px;
    }
    .lp-ms-trigger {
        display: flex;
        flex-wrap: wrap;
        gap: 3px;
        padding: 3px 6px;
        min-height: 28px;
        border: 1px solid transparent;
        border-radius: 6px;
        cursor: pointer;
        transition: border-color 0.15s;
        align-items: center;
    }
    .lp-ms-trigger:hover {
        border-color: #d1d5db;
    }
    .dark .lp-ms-trigger:hover {
        border-color: #334155;
    }
    .lp-ms-placeholder {
        font-size: 11px;
        color: #9ca3af;
        font-style: italic;
    }
    .lp-ms-dropdown {
        position: fixed;
        min-width: 200px;
        max-width: 280px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.06);
        z-index: 9999;
        overflow: hidden;
    }
    .dark .lp-ms-dropdown {
        background: #0e1726;
        border-color: #334155;
    }
</style>

<div data-id="lines"
    x-data='linesPanel({
        recordId: "<%= locals.record && record._id ? record._id : '' %>",
        accountNumber: "<%= account_number %>",
        entityId: "<%= locals.entity ? entity._id : '' %>"
    })'
>
    <!-- Loading state -->
    <template x-if="loading">
        <div class="panel !p-0 overflow-hidden">
            <div class="px-4 py-8 text-center">
                <iconify-icon icon="svg-spinners:ring-resize" width="24" class="text-primary"></iconify-icon>
                <p class="text-xs text-gray-400 mt-2">Chargement des schémas...</p>
            </div>
        </div>
    </template>

    <!-- No schemas available -->
    <template x-if="!loading && schemas.length === 0">
        <div class="panel !p-0 overflow-hidden">
            <div class="px-4 py-6 text-center">
                <iconify-icon icon="solar:document-text-linear" width="28" class="text-gray-300 dark:text-gray-600 mb-2"></iconify-icon>
                <p class="text-xs text-gray-400">Aucun schéma de lignes disponible pour cette entité</p>
            </div>
        </div>
    </template>

    <!-- One panel per schema -->
    <template x-for="schema in schemas" :key="schema._id">
        <div class="panel !p-0 overflow-hidden" :class="schemas.indexOf(schema) > 0 ? 'mt-4' : ''">
            <!-- Schema Panel Header -->
            <div class="flex items-center justify-between px-3 py-2 cursor-pointer hover:bg-gray-50/50 dark:hover:bg-gray-800/30 transition-colors"
                @click="toggleSchemaOpen(schema._id)">
                <div class="flex items-center gap-1.5">
                    <iconify-icon icon="solar:document-text-bold-duotone" width="14" class="text-success"></iconify-icon>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400" x-text="schema.name"></span>
                    <span x-show="getSchemaLines(schema._id).length > 0" class="text-[9px] bg-success/10 text-success min-w-[16px] h-4 rounded-full flex items-center justify-center font-bold px-1" x-text="getSchemaLines(schema._id).length"></span>
                </div>
                <iconify-icon icon="solar:alt-arrow-down-bold" width="12" :class="isSchemaOpen(schema._id) ? '' : '-rotate-90'" class="transition-transform text-gray-300"></iconify-icon>
            </div>

            <!-- Schema Body -->
            <div x-show="isSchemaOpen(schema._id)" x-collapse
                 @click="activeSchemaId = schema._id"
                 @focusin="activeSchemaId = schema._id">

                <!-- Line Type selector (if schema has multiple line types) -->
                <div x-show="schema.lineTypes && schema.lineTypes.length > 1"
                    class="px-3 py-1.5 flex items-center gap-2 border-b border-gray-100 dark:border-gray-800">
                    <span class="text-[10px] font-semibold text-gray-400 uppercase">Type:</span>
                    <select class="lp-input !w-auto !text-[11px] !py-1 !px-2 !border-gray-200 dark:!border-gray-700"
                        @change="setSchemaLineType(schema._id, $event.target.value)"
                        :value="getSchemaLineType(schema._id)">
                        <template x-for="lt in schema.lineTypes" :key="lt">
                            <option :value="lt" x-text="lt"></option>
                        </template>
                    </select>
                </div>

                <!-- Table -->
                <div class="overflow-x-auto">
                    <table class="lines-panel-table">
                        <thead>
                            <tr>
                                <th style="width: 28px;"></th>
                                <th style="width: 24px;">#</th>
                                <template x-if="getRelationColForSchema(schema)">
                                    <th class="lp-w-m" x-text="getRelationColForSchema(schema)?.label || 'Article'"></th>
                                </template>
                                <template x-for="col in getVisibleColumnsForSchema(schema).filter(c => c.type !== 'relation')" :key="col.key">
                                    <th :class="'lp-w-' + (col.width || 'M').toLowerCase()" x-text="col.label"></th>
                                </template>
                                <th style="width: 56px;"></th>
                            </tr>
                        </thead>
                        <tbody :data-schema-id="schema._id">
                            <template x-for="(line, lineIdx) in getSchemaLines(schema._id)" :key="line._tempId || line._id || lineIdx">
                                <tr>
                                    <!-- Drag handle -->
                                    <td>
                                        <span class="lp-drag-handle">
                                            <iconify-icon icon="tabler:grip-vertical" width="14"></iconify-icon>
                                        </span>
                                    </td>
                                    <!-- Row number -->
                                    <td class="text-[11px] text-gray-400" x-text="lineIdx + 1"></td>
                                    <!-- Relation name (always visible) -->
                                    <template x-if="getRelationCol()">
                                        <td class="lp-w-m">
                                            <div class="lp-relation-wrap">
                                                <input type="text" class="lp-input"
                                                    :value="getRelationLabel(line)"
                                                    @focus="openRelationSearch(lineIdx, getRelationCol().key)"
                                                    @input="searchRelation(lineIdx, getRelationCol().key, $event.target.value)"
                                                    @keydown.escape="closeRelationSearch()"
                                                    :placeholder="'🔍 ' + (getRelationCol()?.label || 'Article')" />
                                                <!-- Dropdown -->
                                                <div x-show="relationSearch.lineIdx === lineIdx && relationSearch.colKey === getRelationCol().key && relationSearch.open"
                                                    class="lp-relation-dropdown"
                                                    @click.outside="closeRelationSearch()">
                                                    <template x-if="relationSearch.loading">
                                                        <div class="px-3 py-2 text-xs text-gray-400 text-center">
                                                            <iconify-icon icon="svg-spinners:ring-resize" width="14"></iconify-icon>
                                                        </div>
                                                    </template>
                                                    <template x-if="!relationSearch.loading && relationSearch.results.length === 0">
                                                        <div class="px-3 py-2 text-xs text-gray-400 text-center">Aucun résultat</div>
                                                    </template>
                                                    <template x-for="item in relationSearch.results" :key="item._id">
                                                        <div class="lp-rel-item"
                                                            @click="selectRelation(lineIdx, getRelationCol(), item)">
                                                            <span x-text="item.label || item.title"></span>
                                                        </div>
                                                    </template>
                                                </div>
                                            </div>
                                        </td>
                                    </template>
                                    <!-- Dynamic columns (excluding relation) -->
                                    <template x-for="col in getVisibleColumnsForLine(line).filter(c => c.type !== 'relation')" :key="col.key">
                                        <td :class="'lp-w-' + (col.width || 'M').toLowerCase()">
                                            <!-- Text -->
                                            <template x-if="col.type === 'text'">
                                                <input type="text" class="lp-input"
                                                    :value="line.values[col.key] || ''"
                                                    @input="line.values[col.key] = $event.target.value; debouncedSave()"
                                                    :placeholder="col.label" />
                                            </template>

                                            <!-- Textarea -->
                                            <template x-if="col.type === 'textarea'">
                                                <input type="text" class="lp-input"
                                                    :value="line.values[col.key] || ''"
                                                    @input="line.values[col.key] = $event.target.value; debouncedSave()"
                                                    :placeholder="col.label" />
                                            </template>

                                            <!-- Number -->
                                            <template x-if="col.type === 'number'">
                                                <input type="number" class="lp-input text-right"
                                                    :value="line.values[col.key] || ''"
                                                    @input="line.values[col.key] = parseFloat($event.target.value) || 0; recomputeLine(line); debouncedSave()"
                                                    step="any" />
                                            </template>

                                            <!-- Money -->
                                            <template x-if="col.type === 'money'">
                                                <input type="number" class="lp-input text-right"
                                                    :value="line.values[col.key] || ''"
                                                    @input="line.values[col.key] = parseFloat($event.target.value) || 0; recomputeLine(line); debouncedSave()"
                                                    step="0.01" />
                                            </template>

                                            <!-- Date -->
                                            <template x-if="col.type === 'date'">
                                                <input type="date" class="lp-input"
                                                    :value="line.values[col.key] || ''"
                                                    @input="line.values[col.key] = $event.target.value; debouncedSave()" />
                                            </template>

                                            <!-- Select -->
                                            <template x-if="col.type === 'select'">
                                                <select class="lp-input"
                                                    :value="line.values[col.key] || ''"
                                                    @change="line.values[col.key] = $event.target.value; debouncedSave()">
                                                    <option value="">—</option>
                                                    <template x-for="opt in getSelectOptions(col, line)" :key="opt.value">
                                                        <option :value="opt.value" x-text="opt.label" :selected="line.values[col.key] === opt.value"></option>
                                                    </template>
                                                </select>
                                            </template>

                                            <!-- Multiselect (inline tag-picker dropdown) -->
                                            <template x-if="col.type === 'multiselect'">
                                                <div class="lp-ms-wrap">
                                                    <!-- Selected tags display (trigger) -->
                                                    <div class="lp-ms-trigger"
                                                         @click.stop="activeSchemaId = schema._id; openMultiselectDropdown(lineIdx, col.key, $event)">
                                                        <template x-if="(line.values[col.key] || []).length === 0">
                                                            <span class="lp-ms-placeholder">Sélectionner...</span>
                                                        </template>
                                                        <template x-for="selVal in (line.values[col.key] || [])" :key="selVal">
                                                            <span class="tp-tag"
                                                                  :style="'background:' + getMultiselectOptStyle(col, selVal).bg + '; color:' + getMultiselectOptStyle(col, selVal).text"
                                                                  x-text="getMultiselectOptLabel(col, selVal)">
                                                            </span>
                                                        </template>
                                                    </div>
                                                    <!-- Backdrop + Dropdown (only rendered for the active one) -->
                                                    <template x-if="msDropdown.lineIdx === lineIdx && msDropdown.colKey === col.key && msDropdown.open">
                                                        <div>
                                                            <!-- Invisible backdrop to close on click -->
                                                            <div style="position: fixed; inset: 0; z-index: 9998;"
                                                                 @click.stop="closeMultiselectDropdown()"></div>
                                                            <!-- Dropdown panel -->
                                                            <div class="lp-ms-dropdown"
                                                                 :style="'top:' + (msDropdown.pos?.top || 0) + 'px; left:' + (msDropdown.pos?.left || 0) + 'px'">
                                                                <div class="tp-search-wrap">
                                                                    <input type="text" class="tp-search-input"
                                                                           placeholder="Rechercher..."
                                                                           :value="msDropdown.query"
                                                                           @input="msDropdown.query = $event.target.value" />
                                                                </div>
                                                                <div class="tp-divider"></div>
                                                                <div class="tp-options">
                                                                    <template x-for="opt in filterMsOptions(col)" :key="opt.value">
                                                                        <div class="tp-option"
                                                                             @click.stop="toggleMultiselectValue(line, col.key, opt.value)">
                                                                            <div class="tp-option-icon"
                                                                                 :style="(line.values[col.key] || []).includes(opt.value)
                                                                                     ? 'background:' + getMultiselectOptStyle(col, opt.value).bg + '; border: 2px solid ' + getMultiselectOptStyle(col, opt.value).bg
                                                                                     : 'background: #fff; border: 2px solid #d1d5db'">
                                                                                <iconify-icon x-show="(line.values[col.key] || []).includes(opt.value)"
                                                                                              icon="tabler:check" width="12"
                                                                                              :style="'color:' + getMultiselectOptStyle(col, opt.value).text"></iconify-icon>
                                                                            </div>
                                                                            <span class="tp-option-label" x-text="opt.label"></span>
                                                                        </div>
                                                                    </template>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </template>
                                                </div>
                                            </template>

                                            <!-- Duration -->
                                            <template x-if="col.type === 'duration'">
                                                <div class="flex gap-1 items-center">
                                                    <input type="number" class="lp-input text-right !w-14"
                                                        :value="line.values[col.key]?.value || ''"
                                                        @input="if(!line.values[col.key]) line.values[col.key] = {}; line.values[col.key].value = parseFloat($event.target.value) || 0; debouncedSave()"
                                                        min="0" step="1" />
                                                    <select class="lp-input !w-16 !text-[10px]"
                                                        :value="line.values[col.key]?.unit || (col.config?.units?.[0] || 'day')"
                                                        @change="if(!line.values[col.key]) line.values[col.key] = {}; line.values[col.key].unit = $event.target.value; debouncedSave()">
                                                        <template x-for="u in (col.config?.units || ['day','week','month'])" :key="u">
                                                            <option :value="u" x-text="durationLabel(u)"></option>
                                                        </template>
                                                    </select>
                                                </div>
                                            </template>

                                            <!-- Dosage -->
                                            <template x-if="col.type === 'dosage'">
                                                <div class="flex gap-1 items-center">
                                                    <input type="number" class="lp-input text-right !w-14"
                                                        :value="line.values[col.key]?.value || ''"
                                                        @input="if(!line.values[col.key]) line.values[col.key] = {}; line.values[col.key].value = parseFloat($event.target.value) || 0; debouncedSave()"
                                                        min="0" step="any" />
                                                    <select class="lp-input !w-16 !text-[10px]"
                                                        :value="line.values[col.key]?.unit || (col.config?.units?.[0] || 'mg')"
                                                        @change="if(!line.values[col.key]) line.values[col.key] = {}; line.values[col.key].unit = $event.target.value; debouncedSave()">
                                                        <template x-for="u in (col.config?.units || ['mg','ml','g','cp'])" :key="u">
                                                            <option :value="u" x-text="u"></option>
                                                        </template>
                                                    </select>
                                                </div>
                                            </template>

                                            <!-- Relation (autocomplete search) -->
                                            <template x-if="col.type === 'relation'">
                                                <div class="lp-relation-wrap">
                                                    <input type="text" class="lp-input"
                                                        :value="line.values[col.key + '_label'] || ''"
                                                        @focus="openRelationSearch(lineIdx, col.key)"
                                                        @input="searchRelation(lineIdx, col.key, $event.target.value)"
                                                        @keydown.escape="closeRelationSearch()"
                                                        :placeholder="'🔍 ' + col.label" />
                                                    <!-- Dropdown -->
                                                    <div x-show="relationSearch.lineIdx === lineIdx && relationSearch.colKey === col.key && relationSearch.open"
                                                        class="lp-relation-dropdown"
                                                        @click.outside="closeRelationSearch()">
                                                        <template x-if="relationSearch.loading">
                                                            <div class="px-3 py-2 text-xs text-gray-400 text-center">
                                                                <iconify-icon icon="svg-spinners:ring-resize" width="14"></iconify-icon>
                                                            </div>
                                                        </template>
                                                        <template x-if="!relationSearch.loading && relationSearch.results.length === 0">
                                                            <div class="px-3 py-2 text-xs text-gray-400 text-center">Aucun résultat</div>
                                                        </template>
                                                        <template x-for="item in relationSearch.results" :key="item._id">
                                                            <div class="lp-rel-item"
                                                                @click="selectRelation(lineIdx, col, item)">
                                                                <span x-text="item.label || item.title"></span>
                                                            </div>
                                                        </template>
                                                    </div>
                                                </div>
                                            </template>

                                            <!-- Formula (computed, read-only) -->
                                            <template x-if="col.type === 'formula'">
                                                <div class="lp-computed" x-text="formatComputed(line, col)"></div>
                                            </template>
                                        </td>
                                    </template>
                                    <!-- Actions (edit + delete) -->
                                    <td>
                                        <div class="lp-row-actions">
                                            <button type="button" class="lp-row-btn edit" @click="activeSchemaId = schema._id; openEditLine(lineIdx)" title="Modifier">
                                                <iconify-icon icon="tabler:pencil" width="14"></iconify-icon>
                                            </button>
                                            <button type="button" class="lp-row-btn delete" @click="activeSchemaId = schema._id; removeLine(lineIdx)" title="Supprimer">
                                                <iconify-icon icon="tabler:trash" width="14"></iconify-icon>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>

                <!-- Add row -->
                <div class="lp-add-row-area" style="display: flex; gap: 0;">
                    <div style="flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px;"
                         @click.stop="activateAndOpenModal(schema._id)">
                        <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                        <span>Ajouter des lignes</span>
                    </div>
                    <div style="border-left: 1px solid #e5e7eb; padding: 0 10px; display: flex; align-items: center;"
                         class="dark:!border-gray-700"
                         @click.stop="addLineToSchema(schema._id)" title="Ajouter une ligne vide">
                        <iconify-icon icon="tabler:row-insert-bottom" width="14"></iconify-icon>
                    </div>
                </div>

                <!-- Totals -->
                <div x-show="schema.totals && (schema.totals.subtotalKey || schema.totals.totalFormula)"
                    class="lp-totals-bar">
                    <template x-if="getSchemaTotals(schema._id).subtotal !== undefined">
                        <div class="lp-total-item">
                            <span class="lp-total-label">Sous-total</span>
                            <span class="lp-total-value" x-text="formatMoney(getSchemaTotals(schema._id).subtotal)"></span>
                        </div>
                    </template>
                    <template x-if="getSchemaTotals(schema._id).vat !== undefined">
                        <div class="lp-total-item">
                            <span class="lp-total-label">TVA</span>
                            <span class="lp-total-value" x-text="formatMoney(getSchemaTotals(schema._id).vat)"></span>
                        </div>
                    </template>
                    <template x-if="getSchemaTotals(schema._id).total !== undefined">
                        <div class="lp-total-item">
                            <span class="lp-total-label">Total</span>
                            <span class="lp-total-value" x-text="formatMoney(getSchemaTotals(schema._id).total)"></span>
                        </div>
                    </template>
                </div>

                <!-- Save indicator -->
                <div x-show="savingSchemas[schema._id]" class="px-3 py-1 text-center">
                    <span class="text-[10px] text-gray-400 flex items-center justify-center gap-1">
                        <iconify-icon icon="svg-spinners:ring-resize" width="10"></iconify-icon>
                        Enregistrement...
                    </span>
                </div>
            </div><!-- end schema body -->
        </div><!-- end panel -->
    </template>

    <!-- ═══ Add Lines Modal ═══ -->
        <template x-if="addModal.open">
            <div class="lp-modal-overlay" @click.self="closeAddModal()" @keydown.escape.window="closeAddModal()">
                <div class="lp-modal">
                    <!-- Header -->
                    <div class="lp-modal-header">
                        <h3>
                            <iconify-icon icon="solar:document-add-bold-duotone" width="18" class="text-primary"></iconify-icon>
                            Ajouter des lignes
                        </h3>
                        <button class="lp-modal-close" @click="closeAddModal()">
                            <iconify-icon icon="tabler:x" width="16"></iconify-icon>
                        </button>
                    </div>

                    <!-- Search -->
                    <div class="lp-modal-search">
                        <div class="lp-modal-search-wrap">
                            <iconify-icon icon="tabler:search" width="15" height="15" class="lp-search-icon"></iconify-icon>
                            <input type="text" class="lp-modal-search-input"
                                   style="padding-left: 40px !important;"
                                   x-model="addModal.query"
                                   @input="searchCatalog()"
                                   placeholder="Rechercher un article, traitement..."
                                   x-ref="modalSearchInput" />
                        </div>
                    </div>

                    <!-- Manual Add -->
                    <div class="lp-manual-add">
                        <div class="lp-manual-add-label">
                            <iconify-icon icon="tabler:pencil-plus" width="13"></iconify-icon>
                            Ou ajouter manuellement
                        </div>
                        <div class="lp-manual-add-row">
                            <input type="text" class="lp-manual-add-input"
                                   x-model="manualAdd.input"
                                   @input="searchManualAutocomplete()"
                                   @keydown.enter.prevent="addManualLine()"
                                   @click.away="manualAdd.open = false"
                                   placeholder="Nom de l'élément..." />
                            <button class="lp-manual-add-btn"
                                    @click="addManualLine()"
                                    :disabled="!manualAdd.input.trim()">
                                <iconify-icon icon="tabler:plus" width="16"></iconify-icon>
                            </button>
                            <!-- Autocomplete dropdown -->
                            <div class="lp-manual-autocomplete"
                                 x-show="manualAdd.open && manualAdd.suggestions.length > 0"
                                 x-transition.opacity>
                                <template x-for="sug in manualAdd.suggestions" :key="sug._id">
                                    <div class="lp-manual-autocomplete-item"
                                         @click="selectManualSuggestion(sug)">
                                        <iconify-icon icon="tabler:file-text" width="14" style="color: #9ca3af;"></iconify-icon>
                                        <div>
                                            <span class="lp-ac-title" x-text="sug.label || sug.title"></span>
                                            <span class="lp-ac-desc" x-show="sug.description" x-text="sug.description"></span>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </div>

                    <!-- Body: Results -->
                    <div class="lp-modal-body">
                        <!-- Loading -->
                        <div x-show="addModal.loading" class="lp-modal-empty">
                            <iconify-icon icon="svg-spinners:ring-resize" width="24" class="text-primary"></iconify-icon>
                            <p style="font-size: 12px; margin-top: 8px;">Recherche en cours...</p>
                        </div>

                        <!-- No source entity configured -->
                        <div x-show="addModal._noTarget" class="lp-modal-empty">
                            <iconify-icon icon="solar:danger-triangle-bold-duotone" width="32" style="color: #f59e0b;"></iconify-icon>
                            <p style="font-size: 12px; margin-top: 8px;">Ce schéma n'a pas de source de données configurée.</p>
                            <p style="font-size: 11px; color: #9ca3af; margin-top: 4px;">Configurez la <strong>Source de données</strong> dans les paramètres du schéma de lignes.</p>
                        </div>

                        <!-- No results -->
                        <div x-show="!addModal.loading && !addModal._noTarget && addModal.results.length === 0 && addModal.query.length > 0" class="lp-modal-empty">
                            <iconify-icon icon="solar:magnifer-broken" width="32"></iconify-icon>
                            <p style="font-size: 12px;">Aucun résultat pour "<span x-text="addModal.query"></span>"</p>
                        </div>

                        <!-- Initial state -->
                        <div x-show="!addModal.loading && !addModal._noTarget && addModal.results.length === 0 && addModal.query.length === 0" class="lp-modal-empty">
                            <iconify-icon icon="solar:magnifer-bold-duotone" width="32"></iconify-icon>
                            <p style="font-size: 12px;">Tapez pour rechercher dans le catalogue</p>
                        </div>

                        <!-- Results list -->
                        <template x-for="item in addModal.results" :key="item._id">
                            <div class="lp-catalog-item"
                                 :class="{ 'selected': addModal.selected.find(s => s._id === item._id) }"
                                 @click="toggleCatalogItem(item)">
                                <!-- Checkbox -->
                                <div class="lp-catalog-check">
                                    <iconify-icon x-show="addModal.selected.find(s => s._id === item._id)"
                                                  icon="tabler:check" width="12" style="color: #fff;"></iconify-icon>
                                </div>
                                <!-- Info -->
                                <div class="lp-catalog-info">
                                    <div class="lp-catalog-title" x-text="item.label || item.title"></div>
                                    <div class="lp-catalog-sub" x-show="item.description" x-text="item.description"></div>

                                    <!-- Config fields for selected items -->
                                    <template x-if="addModal.selected.find(s => s._id === item._id)">
                                        <div class="lp-config-fields" @click.stop>
                                            <template x-for="col in getEditableColumns()" :key="col.key">
                                                <div class="lp-config-field">
                                                    <label x-text="col.label"></label>

                                                    <!-- Number / Money -->
                                                    <template x-if="col.type === 'number' || col.type === 'money'">
                                                        <input type="number"
                                                               :value="getSelectedItemValue(item._id, col.key)"
                                                               @input="setSelectedItemValue(item._id, col.key, parseFloat($event.target.value) || 0)"
                                                               :step="col.type === 'money' ? '0.01' : 'any'"
                                                               :placeholder="col.label" />
                                                    </template>

                                                    <!-- Text -->
                                                    <template x-if="col.type === 'text' || col.type === 'textarea'">
                                                        <input type="text"
                                                               :value="getSelectedItemValue(item._id, col.key)"
                                                               @input="setSelectedItemValue(item._id, col.key, $event.target.value)"
                                                               :placeholder="col.label"
                                                               style="min-width: 100px;" />
                                                    </template>

                                                    <!-- Select -->
                                                    <template x-if="col.type === 'select'">
                                                        <select :value="getSelectedItemValue(item._id, col.key)"
                                                                @change="setSelectedItemValue(item._id, col.key, $event.target.value)">
                                                            <option value="">—</option>
                                                            <template x-for="opt in (col.config?.options || [])" :key="opt.value">
                                                                <option :value="opt.value" x-text="opt.label"></option>
                                                            </template>
                                                        </select>
                                                    </template>

                                                    <!-- Duration -->
                                                    <template x-if="col.type === 'duration'">
                                                        <div style="display: flex; gap: 4px; align-items: center;">
                                                            <input type="number"
                                                                   :value="getSelectedItemValue(item._id, col.key)?.value || ''"
                                                                   @input="setSelectedItemDuration(item._id, col.key, 'value', parseFloat($event.target.value) || 0)"
                                                                   style="width: 50px;" min="0" />
                                                            <select :value="getSelectedItemValue(item._id, col.key)?.unit || (col.config?.units?.[0] || 'day')"
                                                                    @change="setSelectedItemDuration(item._id, col.key, 'unit', $event.target.value)"
                                                                    style="width: 70px; font-size: 11px;">
                                                                <template x-for="u in (col.config?.units || ['day','week','month'])" :key="u">
                                                                    <option :value="u" x-text="durationLabel(u)"></option>
                                                                </template>
                                                            </select>
                                                        </div>
                                                    </template>

                                                    <!-- Dosage -->
                                                    <template x-if="col.type === 'dosage'">
                                                        <div style="display: flex; gap: 4px; align-items: center;">
                                                            <input type="number"
                                                                   :value="getSelectedItemValue(item._id, col.key)?.value || ''"
                                                                   @input="setSelectedItemDuration(item._id, col.key, 'value', parseFloat($event.target.value) || 0)"
                                                                   style="width: 50px;" min="0" step="any" />
                                                            <select :value="getSelectedItemValue(item._id, col.key)?.unit || (col.config?.units?.[0] || 'mg')"
                                                                    @change="setSelectedItemDuration(item._id, col.key, 'unit', $event.target.value)"
                                                                    style="width: 55px; font-size: 11px;">
                                                                <template x-for="u in (col.config?.units || ['mg','ml','g','cp'])" :key="u">
                                                                    <option :value="u" x-text="u"></option>
                                                                </template>
                                                            </select>
                                                        </div>
                                                    </template>

                                                    <!-- Multiselect (inline tag-picker) -->
                                                    <template x-if="col.type === 'multiselect'">
                                                        <div class="lp-ms-wrap">
                                                            <div class="lp-ms-trigger"
                                                                 @click.stop="openMultiselectDropdown('add_' + item._id + '_' + col.key, col.key, $event)">
                                                                <template x-if="(getSelectedItemValue(item._id, col.key) || []).length === 0">
                                                                    <span class="lp-ms-placeholder">Sélectionner...</span>
                                                                </template>
                                                                <template x-for="selVal in (getSelectedItemValue(item._id, col.key) || [])" :key="selVal">
                                                                    <span class="tp-tag"
                                                                          :style="'background:' + getMultiselectOptStyle(col, selVal).bg + '; color:' + getMultiselectOptStyle(col, selVal).text"
                                                                          x-text="getMultiselectOptLabel(col, selVal)">
                                                                    </span>
                                                                </template>
                                                            </div>
                                                            <template x-if="msDropdown.lineIdx === ('add_' + item._id + '_' + col.key) && msDropdown.colKey === col.key && msDropdown.open">
                                                                <div>
                                                                    <div style="position: fixed; inset: 0; z-index: 9998;"
                                                                         @click.stop="closeMultiselectDropdown()"></div>
                                                                    <div class="lp-ms-dropdown"
                                                                         :style="'top:' + (msDropdown.pos?.top || 0) + 'px; left:' + (msDropdown.pos?.left || 0) + 'px'">
                                                                        <div class="tp-search-wrap">
                                                                            <input type="text" class="tp-search-input"
                                                                                   placeholder="Rechercher..."
                                                                                   :value="msDropdown.query"
                                                                                   @input="msDropdown.query = $event.target.value" />
                                                                        </div>
                                                                        <div class="tp-divider"></div>
                                                                        <div class="tp-options">
                                                                            <template x-for="opt in filterMsOptions(col)" :key="opt.value">
                                                                                <div class="tp-option"
                                                                                     @click.stop="toggleSelectedItemMultiselect(item._id, col.key, opt.value)">
                                                                                    <div class="tp-option-icon"
                                                                                         :style="(getSelectedItemValue(item._id, col.key) || []).includes(opt.value)
                                                                                             ? 'background:' + getMultiselectOptStyle(col, opt.value).bg + '; border: 2px solid ' + getMultiselectOptStyle(col, opt.value).bg
                                                                                             : 'background: #fff; border: 2px solid #d1d5db'">
                                                                                        <iconify-icon x-show="(getSelectedItemValue(item._id, col.key) || []).includes(opt.value)"
                                                                                                      icon="tabler:check" width="12"
                                                                                                      :style="'color:' + getMultiselectOptStyle(col, opt.value).text"></iconify-icon>
                                                                                    </div>
                                                                                    <span class="tp-option-label" x-text="opt.label"></span>
                                                                                </div>
                                                                            </template>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </template>
                                                        </div>
                                                    </template>

                                                    <!-- Date -->
                                                    <template x-if="col.type === 'date'">
                                                        <input type="date"
                                                               :value="getSelectedItemValue(item._id, col.key) || ''"
                                                               @input="setSelectedItemValue(item._id, col.key, $event.target.value)" />
                                                    </template>
                                                </div>
                                            </template>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </template>
                    </div>

                    <!-- Footer -->
                    <div class="lp-modal-footer">
                        <div class="lp-sel-count">
                            <span x-text="addModal.selected.length"></span> sélectionné(s)
                        </div>
                        <div style="display: flex; gap: 8px;">
                            <button class="lp-btn-cancel" @click="closeAddModal()">Annuler</button>
                            <button class="lp-btn-add"
                                    :disabled="addModal.selected.length === 0"
                                    @click="confirmAddLines()">
                                <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                                Ajouter
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <!-- ═══ Edit Line Modal ═══ -->
        <template x-if="editModal.open">
            <div class="lp-modal-overlay" @click.self="closeEditModal()" @keydown.escape.window="closeEditModal()">
                <div class="lp-modal" style="max-width: 520px;">
                    <!-- Header -->
                    <div class="lp-modal-header">
                        <h3>
                            <iconify-icon icon="solar:pen-bold-duotone" width="18" class="text-primary"></iconify-icon>
                            Modifier la ligne <span x-text="'#' + (editModal.lineIdx + 1)" class="text-gray-400 text-sm font-normal"></span>
                        </h3>
                        <button class="lp-modal-close" @click="closeEditModal()">
                            <iconify-icon icon="tabler:x" width="16"></iconify-icon>
                        </button>
                    </div>

                    <!-- Form fields -->
                    <div style="padding: 16px 20px; display: flex; flex-direction: column; gap: 14px; max-height: 60vh; overflow-y: auto;">
                        <!-- Entity/Relation name (always shown first) -->
                        <template x-if="getRelationCol()">
                            <div style="padding: 10px 14px; background: linear-gradient(135deg, rgba(67,97,238,0.06), rgba(67,97,238,0.02)); border-radius: 8px; border: 1px solid rgba(67,97,238,0.12);">
                                <label style="display: block; font-size: 10px; font-weight: 600; color: #4361ee; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px;" x-text="getRelationCol()?.label || 'Article'"></label>
                                <div style="font-size: 14px; font-weight: 600; color: #1e293b;" x-text="getRelationLabel(lines[editModal.lineIdx]) || '—'"></div>
                            </div>
                        </template>
                        <template x-for="col in getVisibleColumnsForLine(lines[editModal.lineIdx]).filter(c => c.type !== 'relation')" :key="col.key">
                            <div>
                                <label style="display: block; font-size: 11px; font-weight: 600; color: #6b7280; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px;" x-text="col.label"></label>

                                <!-- Text / Textarea -->
                                <template x-if="col.type === 'text' || col.type === 'textarea'">
                                    <input type="text" class="lp-input" style="width: 100%; height: 34px; font-size: 13px;"
                                        :value="lines[editModal.lineIdx].values[col.key] || ''"
                                        @input="lines[editModal.lineIdx].values[col.key] = $event.target.value"
                                        :placeholder="col.label" />
                                </template>

                                <!-- Number -->
                                <template x-if="col.type === 'number'">
                                    <input type="number" class="lp-input" style="width: 100%; height: 34px; font-size: 13px;"
                                        :value="lines[editModal.lineIdx].values[col.key] || ''"
                                        @input="lines[editModal.lineIdx].values[col.key] = parseFloat($event.target.value) || 0; recomputeLine(lines[editModal.lineIdx])"
                                        step="any" />
                                </template>

                                <!-- Money -->
                                <template x-if="col.type === 'money'">
                                    <input type="number" class="lp-input" style="width: 100%; height: 34px; font-size: 13px;"
                                        :value="lines[editModal.lineIdx].values[col.key] || ''"
                                        @input="lines[editModal.lineIdx].values[col.key] = parseFloat($event.target.value) || 0; recomputeLine(lines[editModal.lineIdx])"
                                        step="0.01" />
                                </template>

                                <!-- Date -->
                                <template x-if="col.type === 'date'">
                                    <input type="date" class="lp-input" style="width: 100%; height: 34px; font-size: 13px;"
                                        :value="lines[editModal.lineIdx].values[col.key] || ''"
                                        @input="lines[editModal.lineIdx].values[col.key] = $event.target.value" />
                                </template>

                                <!-- Select -->
                                <template x-if="col.type === 'select'">
                                    <select class="lp-input" style="width: 100%; height: 34px; font-size: 13px;"
                                        :value="lines[editModal.lineIdx].values[col.key] || ''"
                                        @change="lines[editModal.lineIdx].values[col.key] = $event.target.value">
                                        <option value="">—</option>
                                        <template x-for="opt in getSelectOptions(col, lines[editModal.lineIdx])" :key="opt.value">
                                            <option :value="opt.value" x-text="opt.label" :selected="lines[editModal.lineIdx].values[col.key] === opt.value"></option>
                                        </template>
                                    </select>
                                </template>

                                <!-- Multiselect (inline tag-picker) -->
                                <template x-if="col.type === 'multiselect'">
                                    <div class="lp-ms-wrap">
                                        <div class="lp-ms-trigger"
                                             @click.stop="openMultiselectDropdown('edit_' + editModal.lineIdx + '_' + col.key, col.key, $event)">
                                            <template x-if="(lines[editModal.lineIdx].values[col.key] || []).length === 0">
                                                <span class="lp-ms-placeholder">Sélectionner...</span>
                                            </template>
                                            <template x-for="selVal in (lines[editModal.lineIdx].values[col.key] || [])" :key="selVal">
                                                <span class="tp-tag"
                                                      :style="'background:' + getMultiselectOptStyle(col, selVal).bg + '; color:' + getMultiselectOptStyle(col, selVal).text"
                                                      x-text="getMultiselectOptLabel(col, selVal)">
                                                </span>
                                            </template>
                                        </div>
                                        <template x-if="msDropdown.lineIdx === ('edit_' + editModal.lineIdx + '_' + col.key) && msDropdown.colKey === col.key && msDropdown.open">
                                            <div>
                                                <div style="position: fixed; inset: 0; z-index: 9998;"
                                                     @click.stop="closeMultiselectDropdown()"></div>
                                                <div class="lp-ms-dropdown"
                                                     :style="'top:' + (msDropdown.pos?.top || 0) + 'px; left:' + (msDropdown.pos?.left || 0) + 'px'">
                                                    <div class="tp-search-wrap">
                                                        <input type="text" class="tp-search-input"
                                                               placeholder="Rechercher..."
                                                               :value="msDropdown.query"
                                                               @input="msDropdown.query = $event.target.value" />
                                                    </div>
                                                    <div class="tp-divider"></div>
                                                    <div class="tp-options">
                                                        <template x-for="opt in filterMsOptions(col)" :key="opt.value">
                                                            <div class="tp-option"
                                                                 @click.stop="toggleMultiselectValue(lines[editModal.lineIdx], col.key, opt.value)">
                                                                <div class="tp-option-icon"
                                                                     :style="(lines[editModal.lineIdx].values[col.key] || []).includes(opt.value)
                                                                         ? 'background:' + getMultiselectOptStyle(col, opt.value).bg + '; border: 2px solid ' + getMultiselectOptStyle(col, opt.value).bg
                                                                         : 'background: #fff; border: 2px solid #d1d5db'">
                                                                    <iconify-icon x-show="(lines[editModal.lineIdx].values[col.key] || []).includes(opt.value)"
                                                                                  icon="tabler:check" width="12"
                                                                                  :style="'color:' + getMultiselectOptStyle(col, opt.value).text"></iconify-icon>
                                                                </div>
                                                                <span class="tp-option-label" x-text="opt.label"></span>
                                                            </div>
                                                        </template>
                                                    </div>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </template>

                                <!-- Duration -->
                                <template x-if="col.type === 'duration'">
                                    <div style="display: flex; gap: 6px; align-items: center;">
                                        <input type="number" class="lp-input" style="width: 80px; height: 34px; font-size: 13px; text-align: right;"
                                            :value="lines[editModal.lineIdx].values[col.key]?.value || ''"
                                            @input="if(!lines[editModal.lineIdx].values[col.key]) lines[editModal.lineIdx].values[col.key] = {}; lines[editModal.lineIdx].values[col.key].value = parseFloat($event.target.value) || 0"
                                            min="0" step="1" />
                                        <select class="lp-input" style="width: auto; height: 34px; font-size: 13px;"
                                            :value="lines[editModal.lineIdx].values[col.key]?.unit || (col.config?.units?.[0] || 'day')"
                                            @change="if(!lines[editModal.lineIdx].values[col.key]) lines[editModal.lineIdx].values[col.key] = {}; lines[editModal.lineIdx].values[col.key].unit = $event.target.value">
                                            <template x-for="u in (col.config?.units || ['day','week','month'])" :key="u">
                                                <option :value="u" x-text="durationLabel(u)"></option>
                                            </template>
                                        </select>
                                    </div>
                                </template>

                                <!-- Dosage -->
                                <template x-if="col.type === 'dosage'">
                                    <div style="display: flex; gap: 6px; align-items: center;">
                                        <input type="number" class="lp-input" style="width: 80px; height: 34px; font-size: 13px; text-align: right;"
                                            :value="lines[editModal.lineIdx].values[col.key]?.value || ''"
                                            @input="if(!lines[editModal.lineIdx].values[col.key]) lines[editModal.lineIdx].values[col.key] = {}; lines[editModal.lineIdx].values[col.key].value = parseFloat($event.target.value) || 0"
                                            min="0" step="any" />
                                        <select class="lp-input" style="width: auto; height: 34px; font-size: 13px;"
                                            :value="lines[editModal.lineIdx].values[col.key]?.unit || (col.config?.units?.[0] || 'mg')"
                                            @change="if(!lines[editModal.lineIdx].values[col.key]) lines[editModal.lineIdx].values[col.key] = {}; lines[editModal.lineIdx].values[col.key].unit = $event.target.value">
                                            <template x-for="u in (col.config?.units || ['mg','ml','g','cp'])" :key="u">
                                                <option :value="u" x-text="u"></option>
                                            </template>
                                        </select>
                                    </div>
                                </template>

                                <!-- Relation (display only) -->
                                <template x-if="col.type === 'relation'">
                                    <div class="lp-input" style="width: 100%; height: 34px; font-size: 13px; display: flex; align-items: center; background: #f9fafb; color: #374151;"
                                        x-text="lines[editModal.lineIdx].values[col.key + '_label'] || '—'"></div>
                                </template>

                                <!-- Formula (computed, read-only) -->
                                <template x-if="col.type === 'formula'">
                                    <div class="lp-input" style="width: 100%; height: 34px; font-size: 13px; display: flex; align-items: center; background: #f9fafb; color: #374151;"
                                        x-text="formatComputed(lines[editModal.lineIdx], col)"></div>
                                </template>
                            </div>
                        </template>
                    </div>

                    <!-- Footer -->
                    <div class="lp-modal-footer" style="padding: 12px 20px;">
                        <div></div>
                        <div style="display: flex; gap: 8px;">
                            <button class="lp-btn-cancel" @click="closeEditModal()">Annuler</button>
                            <button class="lp-btn-add" @click="saveEditLine()">
                                <iconify-icon icon="tabler:check" width="14"></iconify-icon>
                                Enregistrer
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </template>
</div><!-- end x-data linesPanel -->

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('linesPanel', (config) => ({
        recordId: config.recordId,
        accountNumber: config.accountNumber,
        entityId: config.entityId,
        loading: true,
        saving: false,

        schemas: [],
        activeSchemaId: null,
        linesMap: {},       // { schemaId: lines[] }
        totalsMap: {},      // { schemaId: totals{} }
        openSchemas: {},    // { schemaId: boolean } — which panels are expanded
        lineTypeMap: {},    // { schemaId: string } — selected line type per schema
        savingSchemas: {},  // { schemaId: boolean } — saving indicator per schema

        // Keep backward-compatible getters for modal interactions
        get lines() {
            return this.linesMap[this.activeSchemaId] || [];
        },
        set lines(val) {
            if (this.activeSchemaId) {
                this.linesMap[this.activeSchemaId] = val;
            }
        },
        get totals() {
            return this.totalsMap[this.activeSchemaId] || {};
        },
        set totals(val) {
            if (this.activeSchemaId) {
                this.totalsMap[this.activeSchemaId] = val;
            }
        },
        get newLineType() {
            return this.lineTypeMap[this.activeSchemaId] || 'product';
        },
        set newLineType(val) {
            if (this.activeSchemaId) {
                this.lineTypeMap[this.activeSchemaId] = val;
            }
        },

        // Relation search state
        relationSearch: {
            lineIdx: -1,
            colKey: '',
            open: false,
            loading: false,
            results: [],
            query: '',
            debounceTimer: null
        },

        // Multiselect dropdown state
        msDropdown: {
            lineIdx: -1,
            colKey: '',
            open: false,
            query: '',
            pos: null
        },

        // Add Lines modal state
        addModal: {
            open: false,
            query: '',
            loading: false,
            results: [],
            selected: [],  // { _id, label, customFields, values: {} }
            _searchTimer: null,
            _noTarget: false
        },

        // Manual add state
        manualAdd: {
            input: '',
            suggestions: [],
            open: false,
            _timer: null
        },

        _saveTimers: {},  // per-schema save timers
        editModal: { open: false, lineIdx: -1 },

        get activeSchema() {
            return this.schemas.find(s => s._id === this.activeSchemaId) || null;
        },

        get visibleColumns() {
            if (!this.activeSchema) return [];
            return (this.activeSchema.columns || [])
                .filter(c => c.visible !== false)
                .sort((a, b) => (a.order || 0) - (b.order || 0));
        },

        // ── Per-schema helpers ────────────────────────────────
        getSchemaLines(schemaId) {
            return this.linesMap[schemaId] || [];
        },

        getSchemaTotals(schemaId) {
            return this.totalsMap[schemaId] || {};
        },

        isSchemaOpen(schemaId) {
            return this.openSchemas[schemaId] !== false; // default open
        },

        toggleSchemaOpen(schemaId) {
            this.openSchemas[schemaId] = !this.isSchemaOpen(schemaId);
        },

        getSchemaLineType(schemaId) {
            return this.lineTypeMap[schemaId] || 'product';
        },

        setSchemaLineType(schemaId, value) {
            this.lineTypeMap[schemaId] = value;
        },

        getRelationColForSchema(schema) {
            if (!schema) return null;
            return (schema.columns || []).find(c => c.type === 'relation') || null;
        },

        getVisibleColumnsForSchema(schema) {
            if (!schema) return [];
            return (schema.columns || [])
                .filter(c => c.visible !== false)
                .sort((a, b) => (a.order || 0) - (b.order || 0));
        },

        // Activate a schema and open the add modal
        activateAndOpenModal(schemaId) {
            this.activeSchemaId = schemaId;
            this.openAddModal();
        },

        // Add an empty line to a specific schema
        addLineToSchema(schemaId) {
            this.activeSchemaId = schemaId;
            this.addLine();
        },

        async init() {
            if (!this.recordId) {
                this.loading = false;
                return;
            }
            await this.loadSchemas();
        },

        async loadSchemas() {
            try {
                const url = `/account/${this.accountNumber}/api/line-schemas/by-context?entityId=${this.entityId}`;
                const res = await fetch(url, { credentials: 'include' });
                const data = await res.json();
                this.schemas = data.data || [];

                // Initialize per-schema state
                for (const s of this.schemas) {
                    this.linesMap[s._id] = [];
                    this.totalsMap[s._id] = {};
                    this.openSchemas[s._id] = true;
                    this.lineTypeMap[s._id] = s.defaultLineType || s.lineTypes?.[0] || 'product';
                    this.savingSchemas[s._id] = false;
                }

                if (this.schemas.length > 0) {
                    this.activeSchemaId = this.schemas[0]._id;
                    await this.loadLines();
                }
            } catch (e) {
                console.error('[LinesPanel] Load schemas error:', e);
            } finally {
                this.loading = false;
            }
        },

        async loadLines() {
            try {
                const res = await fetch(`/account/${this.accountNumber}/api/document-lines/${this.recordId}`, {
                    credentials: 'include'
                });
                const data = await res.json();
                const allLines = (data.data || []).map(l => ({
                    ...l,
                    values: l.values || {},
                    computed: l.computed || {},
                    _tempId: l._id || ('tmp_' + Date.now() + '_' + Math.random())
                }));

                // Distribute lines by schemaId
                for (const s of this.schemas) {
                    this.linesMap[s._id] = allLines.filter(l => 
                        l.schemaId === s._id || 
                        (l.schemaId && l.schemaId.toString() === s._id.toString())
                    );
                }

                // Lines without a schemaId go to the first schema
                const orphanLines = allLines.filter(l => !l.schemaId);
                if (orphanLines.length > 0 && this.schemas.length > 0) {
                    this.linesMap[this.schemas[0]._id] = [
                        ...(this.linesMap[this.schemas[0]._id] || []),
                        ...orphanLines
                    ];
                }

                // Recompute formulas for each schema
                for (const s of this.schemas) {
                    this.activeSchemaId = s._id;
                    (this.linesMap[s._id] || []).forEach(l => this.recomputeLine(l));
                    this.recomputeTotals();
                }

                // Reset active to first
                if (this.schemas.length > 0) {
                    this.activeSchemaId = this.schemas[0]._id;
                }
                this.initSortable();
            } catch (e) {
                console.error('[LinesPanel] Load lines error:', e);
            }
        },

        selectSchema(schemaId) {
            this.activeSchemaId = schemaId;
        },

        // Get the primary relation column (always, ignoring visible/showWhen)
        getRelationCol() {
            if (!this.activeSchema) return null;
            return (this.activeSchema.columns || []).find(c => c.type === 'relation') || null;
        },

        // Get the relation label for a line (checks all relation columns across all schemas)
        getRelationLabel(line) {
            if (!line) return '';
            // First: check the active schema's relation column
            const relCol = this.getRelationCol();
            if (relCol && line.values[relCol.key + '_label']) {
                return line.values[relCol.key + '_label'];
            }
            // Fallback: check ALL schemas for a matching relation key with a label in the line
            for (const schema of this.schemas) {
                for (const col of (schema.columns || [])) {
                    if (col.type === 'relation' && line.values[col.key + '_label']) {
                        return line.values[col.key + '_label'];
                    }
                }
            }
            return '';
        },

        getVisibleColumnsForLine(line) {
            if (!this.activeSchema) return [];
            return (this.activeSchema.columns || [])
                .filter(c => c.visible !== false)
                .filter(c => {
                    // Show if no lineType restriction, or if matches current line's type
                    if (!c.showWhen || !c.showWhen.lineType || c.showWhen.lineType.length === 0) return true;
                    return c.showWhen.lineType.includes(line.lineType);
                })
                .sort((a, b) => (a.order || 0) - (b.order || 0));
        },

        addLine() {
            const schemaLines = this.linesMap[this.activeSchemaId] || [];
            schemaLines.push({
                _tempId: 'tmp_' + Date.now() + '_' + Math.random(),
                schemaId: this.activeSchemaId,
                lineType: this.newLineType,
                values: {},
                computed: {},
                order: schemaLines.length
            });
            this.linesMap[this.activeSchemaId] = [...schemaLines];
            this.debouncedSave();
        },

        // ── Add Lines Modal ──────────────────────────────────
        openAddModal() {
            // Sync lineType with current schema (in case of stale value)
            if (this.activeSchema) {
                const validTypes = this.activeSchema.lineTypes || [];
                if (validTypes.length > 0 && !validTypes.includes(this.newLineType)) {
                    this.newLineType = this.activeSchema.defaultLineType || validTypes[0];
                }
            }

            this.addModal.open = true;
            this.addModal.query = '';
            this.addModal.results = [];
            this.addModal.selected = [];
            this.addModal.loading = false;
            this.addModal._noTarget = false;
            // Reset manual add
            this.manualAdd.input = '';
            this.manualAdd.suggestions = [];
            this.manualAdd.open = false;
            this.$nextTick(() => {
                if (this.$refs.modalSearchInput) {
                    this.$refs.modalSearchInput.focus();
                }
            });
        },

        closeAddModal() {
            this.addModal.open = false;
            this.manualAdd.input = '';
            this.manualAdd.suggestions = [];
            this.manualAdd.open = false;
        },

        searchCatalog() {
            clearTimeout(this.addModal._searchTimer);
            const query = this.addModal.query.trim();
            if (!query) {
                this.addModal.results = [];
                return;
            }
            this.addModal._searchTimer = setTimeout(() => {
                this._doCatalogSearch(query);
            }, 250);
        },

        async _doCatalogSearch(query) {
            // Use schema-level sourceEntityId first, then fallback to relation column config
            const sourceEntity = this.activeSchema?.sourceEntityId;
            const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
            const targetEntity = sourceEntity || relCol?.config?.targetEntity;

            // CRITICAL: respect schema config — don't fallback to current entity
            if (!targetEntity) {
                console.warn('[LinesPanel] No source entity configured in schema');
                this.addModal.results = [];
                this.addModal.loading = false;
                this.addModal._noTarget = true;
                return;
            }
            this.addModal._noTarget = false;

            const searchFields = (relCol?.config?.searchFields || ['title']).join(',');

            this.addModal.loading = true;
            try {
                const url = `/account/${this.accountNumber}/api/catalog-search?entityId=${targetEntity}&q=${encodeURIComponent(query)}&searchFields=${searchFields}`;
                const res = await fetch(url, { credentials: 'include' });
                const data = await res.json();
                this.addModal.results = data.data || [];
            } catch (e) {
                console.error('[LinesPanel] Catalog search error:', e);
                this.addModal.results = [];
            } finally {
                this.addModal.loading = false;
            }
        },

        toggleCatalogItem(item) {
            const idx = this.addModal.selected.findIndex(s => s._id === item._id);
            if (idx >= 0) {
                // Deselect
                this.addModal.selected.splice(idx, 1);
            } else {
                // Select — apply default values from catalog
                const values = {};
                const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
                const cfArray = Array.isArray(item.customFields) ? item.customFields : [];
                if (relCol?.config?.applyDefaults && cfArray.length > 0) {
                    const cfMap = {};
                    cfArray.forEach(cf => {
                        const fieldId = (cf.field_id?._id || cf.field_id)?.toString();
                        if (fieldId) cfMap[fieldId] = cf.value;
                    });
                    for (const [targetKey, sourceExpr] of Object.entries(relCol.config.applyDefaults)) {
                        let val;
                        if (sourceExpr.startsWith('cf.')) {
                            val = cfMap[sourceExpr.substring(3)];
                        } else {
                            val = item[sourceExpr];
                        }
                        if (val !== undefined && val !== null) values[targetKey] = val;
                    }
                }
                // Set default qty to 1
                const qtyCol = (this.activeSchema?.columns || []).find(c => c.key === 'qty');
                if (qtyCol && !values.qty) values.qty = 1;

                this.addModal.selected.push({
                    _id: item._id,
                    label: item.label || item.title,
                    customFields: cfArray,
                    values: values
                });
            }
        },

        getEditableColumns() {
            if (!this.activeSchema) return [];
            return (this.activeSchema.columns || [])
                .filter(c => c.visible !== false && c.type !== 'formula' && c.type !== 'relation')
                .sort((a, b) => (a.order || 0) - (b.order || 0));
        },

        getSelectedItemValue(itemId, colKey) {
            const sel = this.addModal.selected.find(s => s._id === itemId);
            return sel ? sel.values[colKey] : undefined;
        },

        setSelectedItemValue(itemId, colKey, value) {
            const sel = this.addModal.selected.find(s => s._id === itemId);
            if (sel) sel.values[colKey] = value;
        },

        setSelectedItemDuration(itemId, colKey, prop, value) {
            const sel = this.addModal.selected.find(s => s._id === itemId);
            if (!sel) return;
            if (!sel.values[colKey] || typeof sel.values[colKey] !== 'object') {
                sel.values[colKey] = {};
            }
            sel.values[colKey][prop] = value;
        },

        addSelectedItemMultiselect(itemId, colKey, value) {
            if (!value) return;
            const sel = this.addModal.selected.find(s => s._id === itemId);
            if (!sel) return;
            if (!sel.values[colKey]) sel.values[colKey] = [];
            if (!sel.values[colKey].includes(value)) {
                sel.values[colKey].push(value);
            }
        },

        toggleSelectedItemMultiselect(itemId, colKey, value) {
            if (!value) return;
            const sel = this.addModal.selected.find(s => s._id === itemId);
            if (!sel) return;
            if (!sel.values[colKey]) sel.values[colKey] = [];
            const idx = sel.values[colKey].indexOf(value);
            if (idx >= 0) {
                sel.values[colKey].splice(idx, 1);
            } else {
                sel.values[colKey].push(value);
            }
        },

        confirmAddLines() {
            const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
            // Ensure lineType matches current schema (guards against stale value)
            const lineType = this.newLineType || this.activeSchema?.defaultLineType || this.activeSchema?.lineTypes?.[0] || 'product';

            for (const sel of this.addModal.selected) {
                const schemaLines = this.linesMap[this.activeSchemaId] || [];
                const newLine = {
                    _tempId: 'tmp_' + Date.now() + '_' + Math.random(),
                    schemaId: this.activeSchemaId,
                    lineType: lineType,
                    values: { ...sel.values },
                    computed: {},
                    order: schemaLines.length
                };
                // Set relation ID + label
                if (relCol) {
                    newLine.values[relCol.key] = sel._id;
                    newLine.values[relCol.key + '_label'] = sel.label;
                }
                this.recomputeLine(newLine);
                schemaLines.push(newLine);
            }
            this.linesMap[this.activeSchemaId] = [...(this.linesMap[this.activeSchemaId] || [])];

            this.recomputeTotals();
            this.debouncedSave();
            this.closeAddModal();
        },

        // ── Manual Add with autocomplete ──────────────────────
        searchManualAutocomplete() {
            clearTimeout(this.manualAdd._timer);
            const q = this.manualAdd.input.trim();
            if (!q) {
                this.manualAdd.suggestions = [];
                this.manualAdd.open = false;
                return;
            }
            this.manualAdd._timer = setTimeout(async () => {
                try {
                    const sourceEntity = this.activeSchema?.sourceEntityId;
                    const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
                    const targetEntity = sourceEntity || relCol?.config?.targetEntity;
                    if (!targetEntity) {
                        this.manualAdd.suggestions = [];
                        this.manualAdd.open = false;
                        return;
                    }
                    const url = `/account/${this.accountNumber}/api/document-lines/catalog-search?entityId=${targetEntity}&q=${encodeURIComponent(q)}`;
                    const res = await fetch(url, { credentials: 'include' });
                    const data = await res.json();
                    this.manualAdd.suggestions = (data.data || []).slice(0, 8);
                    this.manualAdd.open = this.manualAdd.suggestions.length > 0;
                } catch (e) {
                    console.error('[ManualAdd] autocomplete error:', e);
                    this.manualAdd.suggestions = [];
                    this.manualAdd.open = false;
                }
            }, 300);
        },

        selectManualSuggestion(sug) {
            const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
            const lineType = this.newLineType || this.activeSchema?.defaultLineType || this.activeSchema?.lineTypes?.[0] || 'product';
            const values = {};

            // Map custom fields from the suggestion
            if (sug.customFields && this.activeSchema) {
                for (const cf of sug.customFields) {
                    const matchCol = (this.activeSchema.columns || []).find(c => c.key === cf.key);
                    if (matchCol) {
                        values[cf.key] = cf.value;
                    }
                }
            }
            // Set default qty to 1
            const qtyCol = (this.activeSchema?.columns || []).find(c => c.key === 'qty');
            if (qtyCol && !values.qty) values.qty = 1;

            const schemaLines = this.linesMap[this.activeSchemaId] || [];
            const newLine = {
                _tempId: 'tmp_' + Date.now() + '_' + Math.random(),
                schemaId: this.activeSchemaId,
                lineType,
                values,
                computed: {},
                order: schemaLines.length
            };
            if (relCol) {
                newLine.values[relCol.key] = sug._id;
                newLine.values[relCol.key + '_label'] = sug.label || sug.title;
            }
            this.recomputeLine(newLine);
            schemaLines.push(newLine);
            this.linesMap[this.activeSchemaId] = [...schemaLines];
            this.recomputeTotals();
            this.debouncedSave();

            // Reset manual add
            this.manualAdd.input = '';
            this.manualAdd.suggestions = [];
            this.manualAdd.open = false;
        },

        addManualLine() {
            const label = this.manualAdd.input.trim();
            if (!label) return;

            const relCol = (this.activeSchema?.columns || []).find(c => c.type === 'relation');
            const lineType = this.newLineType || this.activeSchema?.defaultLineType || this.activeSchema?.lineTypes?.[0] || 'product';
            const values = {};

            // Try to set the label in the first visible text column
            const firstTextCol = (this.activeSchema?.columns || []).find(c => 
                c.type === 'text' && c.visible !== false && c.type !== 'relation'
            );
            if (firstTextCol) values[firstTextCol.key] = label;
            if (relCol) values[relCol.key + '_label'] = label;

            const qtyCol = (this.activeSchema?.columns || []).find(c => c.key === 'qty');
            if (qtyCol && !values.qty) values.qty = 1;

            const schemaLines = this.linesMap[this.activeSchemaId] || [];
            const newLine = {
                _tempId: 'tmp_' + Date.now() + '_' + Math.random(),
                schemaId: this.activeSchemaId,
                lineType,
                values,
                computed: {},
                order: schemaLines.length
            };
            this.recomputeLine(newLine);
            schemaLines.push(newLine);
            this.linesMap[this.activeSchemaId] = [...schemaLines];
            this.recomputeTotals();
            this.debouncedSave();

            // Reset
            this.manualAdd.input = '';
            this.manualAdd.suggestions = [];
            this.manualAdd.open = false;
        },

        // ── Edit Line Modal ──────────────────────────────────
        openEditLine(lineIdx) {
            const line = this.lines[lineIdx];
            if (!line) return;
            this.editModal.lineIdx = lineIdx;
            this.editModal.open = true;
        },

        closeEditModal() {
            this.editModal.open = false;
            this.editModal.lineIdx = -1;
        },

        saveEditLine() {
            const line = this.lines[this.editModal.lineIdx];
            if (line) {
                this.recomputeLine(line);
                this.recomputeTotals();
                this.debouncedSave();
            }
            this.closeEditModal();
        },

        removeLine(idx) {
            const schemaLines = this.linesMap[this.activeSchemaId] || [];
            schemaLines.splice(idx, 1);
            this.linesMap[this.activeSchemaId] = [...schemaLines];
            this.recomputeTotals();
            this.debouncedSave();
        },

        // ── Formula evaluation ────────────────────────────
        recomputeLine(line) {
            if (!this.activeSchema) return;
            const formulaCols = (this.activeSchema.columns || []).filter(c => c.type === 'formula');
            const computed = {};
            for (const col of formulaCols) {
                if (col.config?.expression) {
                    const ctx = { ...line.values, ...computed };
                    computed[col.key] = this.evaluateFormula(col.config.expression, ctx);
                }
            }
            line.computed = computed;
            this.recomputeTotals();
        },

        evaluateFormula(expression, context) {
            try {
                const safeExpr = expression.replace(/[a-zA-Z_]\w*/g, (varName) => {
                    if (context.hasOwnProperty(varName)) {
                        const val = parseFloat(context[varName]);
                        return isNaN(val) ? '0' : val.toString();
                    }
                    return '0';
                });
                if (!/^[\d\s.+\-*/()]+$/.test(safeExpr)) return 0;
                return Function('"use strict"; return (' + safeExpr + ')')();
            } catch (e) {
                return 0;
            }
        },

        recomputeTotals() {
            const schema = this.activeSchema;
            if (!schema || !schema.totals) { this.totalsMap[this.activeSchemaId] = {}; return; }

            const schemaLines = this.linesMap[this.activeSchemaId] || [];
            const t = {};
            if (schema.totals.subtotalKey) {
                t.subtotal = schemaLines.reduce((sum, line) => {
                    const val = line.computed?.[schema.totals.subtotalKey] ??
                                line.values?.[schema.totals.subtotalKey] ?? 0;
                    return sum + (parseFloat(val) || 0);
                }, 0);
            }
            if (schema.totals.vatKey) {
                t.vat = schemaLines.reduce((sum, line) => {
                    const val = line.computed?.[schema.totals.vatKey] ??
                                line.values?.[schema.totals.vatKey] ?? 0;
                    return sum + (parseFloat(val) || 0);
                }, 0);
            }
            if (schema.totals.totalFormula) {
                t.total = this.evaluateFormula(schema.totals.totalFormula, t);
            }
            this.totalsMap[this.activeSchemaId] = t;
        },

        formatComputed(line, col) {
            const val = line.computed?.[col.key];
            if (val === undefined || val === null) return '—';
            if (col.type === 'formula' && (col.config?.currency || true)) {
                return this.formatMoney(val);
            }
            return val;
        },

        formatMoney(val) {
            if (val === undefined || val === null) return '—';
            return parseFloat(val).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' €';
        },

        // ── Select / multiselect helpers ───────────────────
        getSelectOptions(col, line) {
            // Hybrid: merge schema options with catalog-fetched options
            const opts = [];
            if (col.config?.options) {
                opts.push(...col.config.options);
            }
            // If line has _catalogOptions for this column, merge them
            if (line._catalogOptions?.[col.key]) {
                for (const co of line._catalogOptions[col.key]) {
                    if (!opts.find(o => o.value === co.value)) {
                        opts.push(co);
                    }
                }
            }
            return opts;
        },

        getOptionLabel(col, value) {
            const opts = col.config?.options || [];
            const found = opts.find(o => o.value === value);
            return found ? found.label : value;
        },

        addMultiselectValue(line, key, value) {
            if (!value) return;
            if (!line.values[key]) line.values[key] = [];
            if (!line.values[key].includes(value)) {
                line.values[key].push(value);
                this.debouncedSave();
            }
        },

        removeMultiselectValue(line, key, idx) {
            if (line.values[key]) {
                line.values[key].splice(idx, 1);
                this.debouncedSave();
            }
        },

        toggleMultiselectValue(line, key, value) {
            if (!value) return;
            if (!line.values[key]) line.values[key] = [];
            const idx = line.values[key].indexOf(value);
            if (idx >= 0) {
                line.values[key].splice(idx, 1);
            } else {
                line.values[key].push(value);
            }
            this.debouncedSave();
        },

        openMultiselectDropdown(lineIdx, colKey, event) {
            if (this.msDropdown.lineIdx === lineIdx && this.msDropdown.colKey === colKey && this.msDropdown.open) {
                this.closeMultiselectDropdown();
                return;
            }
            this.msDropdown.lineIdx = lineIdx;
            this.msDropdown.colKey = colKey;
            this.msDropdown.open = true;
            this.msDropdown.query = '';

            // Calculate fixed position from the trigger
            if (event) {
                const trigger = event.currentTarget || event.target;
                const rect = trigger.getBoundingClientRect();
                this.msDropdown.pos = {
                    top: rect.bottom + 4,
                    left: rect.left
                };
            }
        },

        closeMultiselectDropdown() {
            this.msDropdown.open = false;
            this.msDropdown.lineIdx = -1;
            this.msDropdown.colKey = '';
            this.msDropdown.query = '';
        },

        filterMsOptions(col) {
            const opts = col.config?.options || [];
            const q = (this.msDropdown.query || '').trim().toLowerCase();
            if (!q) return opts;
            return opts.filter(o => o.label.toLowerCase().includes(q));
        },

        getMultiselectOptLabel(col, value) {
            const opts = col.config?.options || [];
            const opt = opts.find(o => o.value === value);
            return opt?.label || value;
        },

        getMultiselectOptStyle(col, value) {
            const opts = col.config?.options || [];
            const opt = opts.find(o => o.value === value);
            if (opt?.bg) return { bg: opt.bg, text: opt.text || '#fff' };
            // Default color based on value hash for consistent coloring
            const colors = [
                { bg: '#dbeafe', text: '#1e40af' },
                { bg: '#dcfce7', text: '#166534' },
                { bg: '#fef3c7', text: '#92400e' },
                { bg: '#fce7f3', text: '#9d174d' },
                { bg: '#e0e7ff', text: '#3730a3' },
                { bg: '#fae8ff', text: '#86198f' },
                { bg: '#ecfdf5', text: '#065f46' },
            ];
            let hash = 0;
            for (let i = 0; i < String(value).length; i++) hash = (hash * 31 + String(value).charCodeAt(i)) % colors.length;
            return colors[Math.abs(hash) % colors.length];
        },



        // ── Duration label ────────────────────────────────
        durationLabel(unit) {
            const map = { day: 'jour(s)', week: 'sem.', month: 'mois', year: 'an(s)' };
            return map[unit] || unit;
        },

        // ── Relation search (autocomplete) ─────────────────
        openRelationSearch(lineIdx, colKey) {
            this.relationSearch.lineIdx = lineIdx;
            this.relationSearch.colKey = colKey;
            this.relationSearch.open = true;
            this.relationSearch.results = [];
            this.relationSearch.query = '';
        },

        closeRelationSearch() {
            this.relationSearch.open = false;
        },

        searchRelation(lineIdx, colKey, query) {
            this.relationSearch.query = query;
            this.relationSearch.lineIdx = lineIdx;
            this.relationSearch.colKey = colKey;
            this.relationSearch.open = true;

            clearTimeout(this.relationSearch.debounceTimer);
            this.relationSearch.debounceTimer = setTimeout(() => {
                this._doRelationSearch(colKey, query);
            }, 250);
        },

        async _doRelationSearch(colKey, query) {
            const col = (this.activeSchema?.columns || []).find(c => c.key === colKey);
            if (!col || !col.config?.targetEntity) return;

            this.relationSearch.loading = true;
            try {
                const searchFields = (col.config.searchFields || ['title']).join(',');
                const url = `/account/${this.accountNumber}/api/catalog-search?entityId=${col.config.targetEntity}&q=${encodeURIComponent(query)}&searchFields=${searchFields}`;
                const res = await fetch(url, { credentials: 'include' });
                const data = await res.json();
                this.relationSearch.results = data.data || [];
            } catch (e) {
                console.error('[LinesPanel] Relation search error:', e);
                this.relationSearch.results = [];
            } finally {
                this.relationSearch.loading = false;
            }
        },

        selectRelation(lineIdx, col, item) {
            const line = this.lines[lineIdx];
            if (!line) return;

            // Set the relation value (ID + label)
            line.values[col.key] = item._id;
            line.values[col.key + '_label'] = item.label || item.title;

            // Apply defaults from the catalog item (hybrid mode)
            if (col.config?.applyDefaults && item.customFields) {
                for (const [targetKey, sourceExpr] of Object.entries(col.config.applyDefaults)) {
                    let val;
                    if (sourceExpr.startsWith('cf.')) {
                        // Custom field reference
                        const cfId = sourceExpr.substring(3);
                        val = item.customFields[cfId];
                    } else {
                        val = item[sourceExpr];
                    }
                    if (val !== undefined && val !== null) {
                        line.values[targetKey] = val;

                        // HYBRID: If this is a select/multiselect column, also inject the
                        // value as an available option so it appears in the dropdown
                        const targetCol = (this.activeSchema?.columns || []).find(c => c.key === targetKey);
                        if (targetCol && (targetCol.type === 'select' || targetCol.type === 'multiselect')) {
                            if (!line._catalogOptions) line._catalogOptions = {};
                            if (!line._catalogOptions[targetKey]) line._catalogOptions[targetKey] = [];
                            if (typeof val === 'string' && !line._catalogOptions[targetKey].find(o => o.value === val)) {
                                line._catalogOptions[targetKey].push({ value: val, label: val });
                            } else if (Array.isArray(val)) {
                                val.forEach(v => {
                                    if (!line._catalogOptions[targetKey].find(o => o.value === v)) {
                                        line._catalogOptions[targetKey].push({ value: v, label: v });
                                    }
                                });
                            }
                        }
                    }
                }
            }

            this.recomputeLine(line);
            this.closeRelationSearch();
            this.debouncedSave();
        },

        // ── Debounced save ──────────────────────────────────
        debouncedSave() {
            const schemaId = this.activeSchemaId;
            if (!schemaId) return;
            clearTimeout(this._saveTimers[schemaId]);
            this._saveTimers[schemaId] = setTimeout(() => this.saveLinesForSchema(schemaId), 800);
        },

        async saveLinesForSchema(schemaId) {
            if (!this.recordId || !schemaId) return;
            this.savingSchemas[schemaId] = true;
            try {
                const schemaLines = this.linesMap[schemaId] || [];
                const payload = {
                    schemaId: schemaId,
                    lines: schemaLines.map((l, i) => ({
                        _id: l._id || undefined,
                        lineType: l.lineType,
                        values: l.values,
                        order: i
                    }))
                };

                const res = await fetch(`/account/${this.accountNumber}/api/document-lines/${this.recordId}/bulk`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.data) {
                    // Update lines with server IDs (for new lines)
                    const prevActive = this.activeSchemaId;
                    this.activeSchemaId = schemaId;
                    this.linesMap[schemaId] = data.data.map(l => ({
                        ...l,
                        values: l.values || {},
                        computed: l.computed || {},
                        _tempId: l._id
                    }));
                    // Recompute locally (formulas)
                    (this.linesMap[schemaId] || []).forEach(l => this.recomputeLine(l));
                    this.activeSchemaId = prevActive;
                }
                if (data.totals) {
                    this.totalsMap[schemaId] = data.totals;
                }
            } catch (e) {
                console.error('[LinesPanel] Save error for schema', schemaId, e);
            } finally {
                this.savingSchemas[schemaId] = false;
            }
        },

        // ── Sortable init ───────────────────────────────────
        initSortable() {
            this.$nextTick(() => {
                if (typeof Sortable === 'undefined') return;
                // Init sortable for each schema's tbody
                for (const s of this.schemas) {
                    const tbody = this.$el.querySelector(`tbody[data-schema-id="${s._id}"]`);
                    if (tbody) {
                        Sortable.create(tbody, {
                            handle: '.lp-drag-handle',
                            animation: 150,
                            ghostClass: 'sortable-ghost',
                            chosenClass: 'sortable-chosen',
                            onEnd: (evt) => {
                                const schemaId = s._id;
                                const items = [...(this.linesMap[schemaId] || [])];
                                const [moved] = items.splice(evt.oldIndex, 1);
                                items.splice(evt.newIndex, 0, moved);
                                this.linesMap[schemaId] = items;
                                this.activeSchemaId = schemaId;
                                this.debouncedSave();
                            }
                        });
                    }
                }
            });
        }
    }));
});
</script>
