                </div>

                <!-- Loading -->
                <div x-show="loadingFields" style="text-align:center;padding:24px;">
                    <iconify-icon icon="line-md:loading-twotone-loop" width="24" style="color:#4361ee"></iconify-icon>
                </div>

                <!-- Existing fields -->
