	        normalizeOptions(options, fallback = []) {
	            const source = Array.isArray(options) && options.length ? options : fallback;
	            return source
                .map((item, index) => ({
                    label: String(item?.label || '').trim(),
                    color: item?.color || (fallback[index]?.color || '#94a3b8'),
                    order: Number.isFinite(Number(item?.order)) ? Number(item.order) : index
                }))
                .filter(item => item.label)
	                .sort((a, b) => a.order - b.order);
	        },

	        normalizeListOptions(options = []) {
	            const seen = new Set();
	            return (Array.isArray(options) ? options : [])
	                .map((item, index) => {
	                    const id = String(item?._id || item?.id || item?.listId || '').trim();
	                    const label = String(item?.label || item?.name || item?.listLabel || '').trim();
	                    return {
	                        ...item,
	                        _id: id,
	                        label: label || 'Liste des tâches',
	                        color: item?.color || item?.listColor || '#6366f1',
	                        icon: item?.icon || item?.listIcon || 'solar:list-check-bold-duotone',
	                        order: Number.isFinite(Number(item?.order)) ? Number(item.order) : index
	                    };
	                })
	                .filter(item => {
	                    if (!item._id || seen.has(item._id)) return false;
	                    seen.add(item._id);
	                    return true;
	                })
	                .sort((a, b) => a.order - b.order);
	        },

	        canChangeList() {
	            return Array.isArray(this.listOptions) && this.listOptions.length > 1;
