<div :class="{'dark text-white-dark' : $store.app.semidark}">
  <nav x-data="{ sidebar }"
    class="sidebar fixed top-0 bottom-0 z-50 col-span-1 grid h-full min-h-screen w-[248px] grid-cols-12 shadow-[5px_0_25px_0_rgba(94,92,154,0.1)] transition-all duration-300">
    <style>
      .mini-rail {
        --rail-bg: #0f1521;
        --rail-icon: rgba(255,255,255,0.55);
        --rail-icon-hover: rgba(255,255,255,0.9);
        --rail-active-bg: rgba(255,255,255,0.12);
        --rail-active-icon: #fff;
        --rail-hover-bg: rgba(255,255,255,0.07);
        --rail-divider: rgba(255,255,255,0.06);
      }
      .mini-rail-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        padding: 10px 6px;
        border-radius: 12px;
        color: var(--rail-icon);
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
        text-decoration: none;
      }
      .mini-rail-item:hover {
        color: var(--rail-icon-hover);
        background: var(--rail-hover-bg);
      }
      .mini-rail-item[data-active="true"] {
        color: var(--rail-active-icon);
        background: var(--rail-active-bg);
      }
      .mini-rail-item[data-active="true"]::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 3px;
        height: 20px;
        border-radius: 0 3px 3px 0;
        background: #fff;
      }
      .mini-rail-label {
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 0.02em;
        line-height: 1.1;
        opacity: 0.7;
        white-space: nowrap;
        overflow: hidden;
        max-height: 0;
        transition: all 0.25s ease;
      }
      .mini-rail--expanded .mini-rail-label {
        max-height: 20px;
        opacity: 0.7;
        margin-top: 2px;
      }
      .mini-rail-item:hover .mini-rail-label,
      .mini-rail-item[data-active="true"] .mini-rail-label {
        opacity: 1;
      }
      .mini-rail-divider {
        width: 24px;
        height: 1px;
        background: var(--rail-divider);
        margin: 4px auto;
      }
    </style>
    <div
      :class="$store.app.sidebar ? 'col-span-12 mini-rail--expanded' : 'col-span-2'"
      class="mini-rail h-full flex flex-col items-center justify-between pt-2 pb-4"
      style="background: var(--rail-bg);">
      <!-- Toggle button -->
      <a href="javascript:;"
        class="mini-rail-item"
        @click="$store.app.toggleSidebar()"
        style="padding: 8px;">
        <!-- Sidebar OPEN icon (Solar duotone - with left panel) -->
        <svg x-show="$store.app.sidebar" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <path opacity="0.5" d="M9 3V21" stroke="currentColor" stroke-width="1.5"/>
          <rect opacity="0.3" x="4" y="4" width="4" height="16" fill="currentColor"/>
        </svg>
        <!-- Sidebar CLOSED icon (Solar duotone - without left panel fill) -->
        <svg x-show="!$store.app.sidebar" x-cloak width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <path opacity="0.5" d="M9 3V21" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </a>

      <!-- MIDDLE: Navigation icons -->
      <div class="flex flex-col items-center gap-y-1 flex-1 mt-2">
        <!-- Dashboard -->
      <a href="/account/<%= account_number %>/dashboard"
         data-active="<%= (typeof path !== 'undefined' ? path : '').includes('/dashboard') %>"
         class="mini-rail-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 12.2039C2 9.91549 2 8.77128 2.5192 7.82274C3.0384 6.87421 3.98695 6.28551 5.88403 5.10813L7.88403 3.86687C9.88939 2.62229 10.8921 2 12 2C13.1079 2 14.1106 2.62229 16.116 3.86687L18.116 5.10812C20.0131 6.28551 20.9616 6.87421 21.4808 7.82274C22 8.77128 22 9.91549 22 12.2039V13.725C22 17.6258 22 19.5763 20.8284 20.7881C19.6569 22 17.7712 22 14 22H10C6.22876 22 4.34315 22 3.17157 20.7881C2 19.5763 2 17.6258 2 13.725V12.2039Z" stroke="currentColor" stroke-width="1.5"/>
          <path opacity="0.5" d="M12 15V18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span class="mini-rail-label">Dashboard</span>
      </a>

      <!-- Données (Create popup) -->
      <div x-data="{ createPopupOpen: false }" class="relative">
        <div @click="createPopupOpen = !createPopupOpen"
             class="mini-rail-item"
             :data-active="createPopupOpen">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.5777 4.43152L15.5777 3.38197C13.8221 2.46066 12.9443 2 12 2C11.0557 2 10.1779 2.46066 8.42229 3.38197L6.42229 4.43152C4.27063 5.53552 3.19479 6.09982 2.5974 7.07264C2 8.04547 2 9.30798 2 11.833V12.167C2 14.692 2 15.9545 2.5974 16.9274C3.19479 17.9002 4.27063 18.4645 6.42229 19.5931L8.42229 20.618C10.1779 21.5394 11.0557 22 12 22C12.9443 22 13.8221 21.5394 15.5777 20.618L17.5777 19.5685C19.7294 18.4395 20.8052 17.8749 21.4026 16.9021C22 15.9292 22 14.6667 22 12.1418V11.8582C22 9.33327 22 8.07081 21.4026 7.09797C20.8052 6.12512 19.7294 5.56054 17.5777 4.43152Z" stroke="currentColor" stroke-width="1.5"/>
            <path opacity="0.5" d="M12 2V22" stroke="currentColor" stroke-width="1.5"/>
            <path opacity="0.5" d="M22 12L2 12" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span class="mini-rail-label">Données</span>
        </div>
        
        <!-- Create Popup Modal -->
        <div x-show="createPopupOpen" x-cloak
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          @click.away="createPopupOpen = false"
          class="fixed top-1/2 -translate-y-1/2 w-[278px] left-[55px] rounded-xl p-5 z-[60]
            bg-white dark:bg-[#0e1726]
            border border-[#ebedf2] dark:border-[#1b2e4b]
            shadow-[5px_0_25px_0_rgba(94,92,154,0.1)]">
          
          <!-- Header -->
          <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-3">
              <!-- Sidebar panel icon -->
              <div class="w-8 h-8 rounded-lg bg-[#1b2e4b] flex items-center justify-center">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="3" y="3" width="18" height="18" rx="2" stroke="#4f83cc" stroke-width="1.5"/>
                  <path d="M9 3V21" stroke="#4f83cc" stroke-width="1.5"/>
                </svg>
              </div>
              <span class="text-gray-800 dark:text-white-light text-lg font-semibold">Create</span>
            </div>
            <button @click="createPopupOpen = false" class="text-gray-500 dark:text-white-dark hover:text-gray-800 dark:hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div>

          <!-- Quick Create Section -->
          <div class="mb-5">
            <h3 class="text-gray-500 dark:text-gray-500 text-xs font-medium mb-3">Quick Create</h3>
            <div class="grid grid-cols-3 gap-2">
              <!-- Facture -->
              <a href="/account/<%= account_number %>/create/facture" class="flex flex-col items-center gap-2 p-3 rounded-xl hover:bg-[#ebedf2] dark:hover:bg-[#253b5c] transition-all cursor-pointer group">
                <div class="w-11 h-11 rounded shadow-[5px_0_25px_0_rgba(94,92,154,0.1)] flex items-center justify-center bg-[#f6f8fa] dark:bg-[#1b2e4b] backdrop-blur-sm">
                  <svg class="text-gray-600 dark:text-gray-300" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/>
                    <path opacity="0.5" d="M8 10H16M8 14H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </div>
                <span class="text-xs text-gray-600 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white transition-colors">Facture</span>
              </a>
              
              <!-- Client -->
              <a href="/account/<%= account_number %>/create/client" class="flex flex-col items-center gap-2 p-3 rounded-xl hover:bg-[#ebedf2] dark:hover:bg-[#253b5c] transition-all cursor-pointer group">
                <div class="w-11 h-11 rounded shadow-[5px_0_25px_0_rgba(94,92,154,0.1)] flex items-center justify-center bg-[#f6f8fa] dark:bg-[#1b2e4b] backdrop-blur-sm">
                  <svg class="text-gray-600 dark:text-gray-300" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="6" r="4" stroke="currentColor" stroke-width="1.5"/>
                    <path opacity="0.5" d="M20 17.5C20 19.9853 20 22 12 22C4 22 4 19.9853 4 17.5C4 15.0147 7.58172 13 12 13C16.4183 13 20 15.0147 20 17.5Z" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </div>
                <span class="text-xs text-gray-600 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white transition-colors">Client</span>
              </a>
              
              <!-- Projet -->
              <a href="/account/<%= account_number %>/create/projet" class="flex flex-col items-center gap-2 p-3 rounded-xl hover:bg-[#ebedf2] dark:hover:bg-[#253b5c] transition-all cursor-pointer group">
                <div class="w-11 h-11 rounded shadow-[5px_0_25px_0_rgba(94,92,154,0.1)] flex items-center justify-center bg-[#f6f8fa] dark:bg-[#1b2e4b] backdrop-blur-sm">
                  <svg class="text-gray-600 dark:text-gray-300" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2 6.94975C2 6.06722 2 5.62595 2.06935 5.25839C2.37464 3.64031 3.64031 2.37464 5.25839 2.06935C5.62595 2 6.06722 2 6.94975 2C7.33642 2 7.52976 2 7.71557 2.01738C8.51665 2.09229 9.27652 2.40704 9.89594 2.92051C10.0396 3.03961 10.1763 3.17633 10.4497 3.44975L11 4C11.8158 4.81578 12.2237 5.22367 12.7121 5.49543C12.9804 5.64471 13.2651 5.7626 13.5604 5.84678C14.0979 6 14.6747 6 15.8284 6H16.2021C18.8345 6 20.1506 6 21.0062 6.76946C21.0849 6.84024 21.1598 6.91514 21.2305 6.99383C22 7.84935 22 9.16554 22 11.7979V14C22 17.7712 22 19.6569 20.8284 20.8284C19.6569 22 17.7712 22 14 22H10C6.22876 22 4.34315 22 3.17157 20.8284C2 19.6569 2 17.7712 2 14V6.94975Z" stroke="currentColor" stroke-width="1.5"/>
                    <path opacity="0.5" d="M2 6.94975C2 6.06722 2 5.62595 2.06935 5.25839C2.37464 3.64031 3.64031 2.37464 5.25839 2.06935C5.62595 2 6.06722 2 6.94975 2" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </div>
                <span class="text-xs text-gray-600 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white transition-colors">Projet</span>
              </a>
              
              <!-- Document -->
              <a href="/account/<%= account_number %>/create/document" class="flex flex-col items-center gap-2 p-3 rounded-xl hover:bg-[#ebedf2] dark:hover:bg-[#253b5c] transition-all cursor-pointer group">
                <div class="w-11 h-11 rounded shadow-[5px_0_25px_0_rgba(94,92,154,0.1)] flex items-center justify-center bg-[#f6f8fa] dark:bg-[#1b2e4b] backdrop-blur-sm">
                  <svg class="text-gray-600 dark:text-gray-300" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H13C16.7712 2 18.6569 2 19.8284 3.17157C21 4.34315 21 6.22876 21 10V14C21 17.7712 21 19.6569 19.8284 20.8284C18.6569 22 16.7712 22 13 22H11C7.22876 22 5.34315 22 4.17157 20.8284C3 19.6569 3 17.7712 3 14V10Z" stroke="currentColor" stroke-width="1.5"/>
                    <path opacity="0.5" d="M8 12H16M8 8H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </div>
                <span class="text-xs text-gray-600 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white transition-colors">Document</span>
              </a>
              
              <!-- Tâche -->
              <a href="/account/<%= account_number %>/create/tache" class="flex flex-col items-center gap-2 p-3 rounded-xl hover:bg-[#ebedf2] dark:hover:bg-[#253b5c] transition-all cursor-pointer group">
                <div class="w-11 h-11 rounded shadow-[5px_0_25px_0_rgba(94,92,154,0.1)] flex items-center justify-center bg-[#f6f8fa] dark:bg-[#1b2e4b] backdrop-blur-sm">
                  <svg class="text-gray-600 dark:text-gray-300" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12Z" stroke="currentColor" stroke-width="1.5"/>
                    <path opacity="0.5" d="M8.5 12.5L10.5 14.5L15.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <span class="text-xs text-gray-600 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white transition-colors">Tâche</span>
              </a>
              
              <!-- Import -->
              <a href="/account/<%= account_number %>/import" class="flex flex-col items-center gap-2 p-3 rounded-xl hover:bg-[#ebedf2] dark:hover:bg-[#253b5c] transition-all cursor-pointer group">
                <div class="w-11 h-11 rounded shadow-[5px_0_25px_0_rgba(94,92,154,0.1)] flex items-center justify-center bg-[#f6f8fa] dark:bg-[#1b2e4b] backdrop-blur-sm">
                  <svg class="text-gray-600 dark:text-gray-300" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 14V4M12 4L15 7M12 4L9 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path opacity="0.5" d="M2 17L2.621 19.485C2.72915 19.9177 2.78323 20.1341 2.87076 20.3128C3.08429 20.7455 3.43793 21.0927 3.874 21.2988C4.05476 21.3839 4.27318 21.4348 4.71 21.5366L12 23L19.29 21.5366C19.7268 21.4348 19.9452 21.3839 20.126 21.2988C20.5621 21.0927 20.9157 20.7455 21.1292 20.3128C21.2168 20.1341 21.2709 19.9177 21.379 19.485L22 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </div>
                <span class="text-xs text-gray-600 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white transition-colors">Import</span>
              </a>
            </div>
          </div>

          <!-- From Template Section -->
          <div>
            <h3 class="text-gray-500 dark:text-gray-500 text-xs font-medium mb-3">From Template</h3>
            <div class="space-y-2">
              <!-- Template 1 -->
              <a href="/account/<%= account_number %>/template/facture-hotel" class="flex items-center justify-between p-3 rounded-xl bg-[#f6f8fa] dark:bg-[#1b2e4b] hover:bg-[#ebedf2] dark:hover:bg-[#253b5c] transition-all cursor-pointer group">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect x="4" y="3" width="16" height="18" rx="2" stroke="white" stroke-width="1.5"/>
                      <path d="M8 7H16M8 11H16M8 15H12" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </div>
                  <span class="text-sm text-gray-700 dark:text-white-dark group-hover:text-gray-900 dark:group-hover:text-white transition-colors">Facture Hôtel Standard</span>
                </div>
                <svg class="text-gray-500 dark:text-white-dark group-hover:text-gray-900 dark:group-hover:text-white transition-colors" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              
              <!-- Template 2 -->
              <a href="/account/<%= account_number %>/template/devis" class="flex items-center justify-between p-3 rounded-xl bg-[#f6f8fa] dark:bg-[#1b2e4b] hover:bg-[#ebedf2] dark:hover:bg-[#253b5c] transition-all cursor-pointer group">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-teal-500 to-teal-700 flex items-center justify-center">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect x="4" y="3" width="16" height="18" rx="2" stroke="white" stroke-width="1.5"/>
                      <path d="M8 7H16M8 11H16M8 15H12" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </div>
                  <span class="text-sm text-gray-700 dark:text-white-dark group-hover:text-gray-900 dark:group-hover:text-white transition-colors">Devis nettoyage</span>
                </div>
                <svg class="text-gray-500 dark:text-white-dark group-hover:text-gray-900 dark:group-hover:text-white transition-colors" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              
              <!-- Template 3 -->
              <a href="/account/<%= account_number %>/template/relance" class="flex items-center justify-between p-3 rounded-xl bg-[#f6f8fa] dark:bg-[#1b2e4b] hover:bg-[#ebedf2] dark:hover:bg-[#253b5c] transition-all cursor-pointer group">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-600 to-cyan-800 flex items-center justify-center">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect x="4" y="3" width="16" height="18" rx="2" stroke="white" stroke-width="1.5"/>
                      <path d="M8 7H16M8 11H16M8 15H12" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </div>
                  <span class="text-sm text-gray-700 dark:text-white-dark group-hover:text-gray-900 dark:group-hover:text-white transition-colors">Relance paiement</span>
                </div>
                <svg class="text-gray-500 dark:text-white-dark group-hover:text-gray-900 dark:group-hover:text-white transition-colors" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="mini-rail-divider"></div>

      <!-- Contacts -->
      <a href="/account/<%= account_number %>/contacts"
         data-active="<%= (typeof path !== 'undefined' ? path : '').includes('/contacts') %>"
         class="mini-rail-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="6" r="4" stroke="currentColor" stroke-width="1.5"/>
          <path opacity="0.5" d="M20 17.5C20 19.9853 20 22 12 22C4 22 4 19.9853 4 17.5C4 15.0147 7.58172 13 12 13C16.4183 13 20 15.0147 20 17.5Z" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <span class="mini-rail-label">Contacts</span>
      </a>

      <!-- Dossiers -->
      <a href="/account/<%= account_number %>/dossiers"
         data-active="<%= (typeof path !== 'undefined' ? path : '').includes('/dossiers') %>"
         class="mini-rail-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
