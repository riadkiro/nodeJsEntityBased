                    </div>
                </template>
            </div>

            <!-- Tab: Templates -->
            <div x-show="activeTab === 'templates'" class="rm-items-list">
                <!-- Loading state -->
                <div x-show="loadingTemplates" style="text-align:center; padding:32px 0; color:#94a3b8;">
                    <iconify-icon icon="line-md:loading-twotone-loop" width="28"></iconify-icon>
                    <p style="font-size:12px; margin-top:8px;">Chargement...</p>
                </div>
                <!-- Empty state -->
                <div x-show="!loadingTemplates && templates.length === 0" style="text-align:center; padding:40px 20px; color:#94a3b8;">
                    <iconify-icon icon="solar:file-text-bold-duotone" width="40" style="opacity:0.3"></iconify-icon>
                    <p style="font-size:13px; margin-top:10px; font-weight:500;">Aucun modèle disponible</p>
                    <p style="font-size:11px; margin-top:4px;">Créez des templates dans le module Documents</p>
                </div>
                <!-- Templates list -->
                <template x-for="(tpl, idx) in templates" :key="tpl._id">
                    <div class="rm-item" :style="'animation-delay:' + (idx * 50) + 'ms'">
