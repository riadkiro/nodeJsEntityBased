<link rel="stylesheet" href="/css/app/team-system.css" />

<div x-data="permissionsHub()" x-cloak>
  <!-- Page Header -->
  <div class="ts-page-header">
    <div class="ts-page-header-icon" style="background:linear-gradient(135deg,rgba(124,58,237,.15),rgba(124,58,237,.05));">
      <iconify-icon icon="solar:shield-keyhole-bold-duotone" width="28" style="color:#7c3aed"></iconify-icon>
    </div>
    <div class="ts-page-header-info">
      <h1>Permissions & Rôles</h1>
      <p>Configurez les droits d'accès pour chaque rôle de votre organisation</p>
    </div>
  </div>

  <!-- Tabs -->
  <div style="display:flex;gap:4px;margin-bottom:24px;border-bottom:1px solid #e0e6ed;padding-bottom:0;" class="dark:!border-[#253b5c]">
    <template x-for="t in [{key:'matrix',label:'Matrice',icon:'solar:tuning-square-2-bold-duotone'},{key:'roles',label:'Rôles personnalisés',icon:'solar:user-id-bold-duotone'},{key:'groups',label:'Groupes',icon:'solar:users-group-two-rounded-bold-duotone'},{key:'log',label:'Journal',icon:'solar:clipboard-list-bold-duotone'}]" :key="t.key">
      <button style="padding:10px 18px;border:none;background:none;font-size:13px;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;color:#94a3b8;transition:all .2s;display:flex;align-items:center;gap:6px;font-family:inherit;" :style="tab === t.key ? 'color:#4361ee;border-bottom-color:#4361ee' : ''" @click="tab = t.key" class="dark:!text-[#94a3b8]">
        <iconify-icon :icon="t.icon" width="16"></iconify-icon>
        <span x-text="t.label"></span>
      </button>
    </template>
  </div>

  <!-- Matrix Tab -->
  <template x-if="tab === 'matrix'">
    <div style="overflow-x:auto;border:1px solid #e0e6ed;border-radius:14px;background:#fff;" class="dark:!bg-[#0e1726] dark:!border-[#253b5c]">
      <table class="ts-perm-matrix">
        <thead>
          <tr>
            <th style="min-width:220px;">Permission</th>
            <th>Owner</th>
            <th>Admin</th>
            <th>Manager</th>
            <th>Membre</th>
            <th>Viewer</th>
          </tr>
        </thead>
        <tbody>
          <template x-for="cat in permCategories" :key="cat.name">
            <template x-fragment>
              <tr><td colspan="6" class="ts-perm-category" x-text="cat.name"></td></tr>
              <template x-for="perm in cat.perms" :key="perm.key">
                <tr>
                  <td>
                    <div style="display:flex;align-items:center;gap:8px;">
                      <iconify-icon :icon="perm.icon" width="16" style="color:#94a3b8;flex-shrink:0;"></iconify-icon>
                      <span x-text="perm.label"></span>
                    </div>
                  </td>
                  <template x-for="role in ['owner','admin','manager','member','viewer']" :key="role">
                    <td>
                      <template x-if="role === 'owner'">
                        <iconify-icon icon="solar:check-circle-bold" width="20" style="color:#22c55e"></iconify-icon>
                      </template>
                      <template x-if="role !== 'owner'">
                        <label class="ts-toggle">
                          <input type="checkbox" :checked="perm.roles.includes(role)" />
                          <span class="ts-toggle-slider"></span>
                        </label>
                      </template>
                    </td>
                  </template>
                </tr>
              </template>
            </template>
          </template>
        </tbody>
      </table>
    </div>
  </template>

  <!-- Custom Roles Tab -->
  <template x-if="tab === 'roles'">
    <div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
        <p style="font-size:13px;color:#64748b;">Créez des rôles personnalisés avec des permissions spécifiques</p>
        <button class="ts-btn-primary">
          <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
          Nouveau rôle
        </button>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;">
        <template x-for="r in customRoles" :key="r.name">
          <div class="ts-share-card">
            <div class="ts-share-card-header">
              <div class="ts-share-card-icon" :style="'background:' + r.color + '15'">
                <iconify-icon :icon="r.icon" width="20" :style="'color:' + r.color"></iconify-icon>
              </div>
              <div style="flex:1;">
                <div class="ts-share-card-title" x-text="r.name"></div>
                <div class="ts-share-card-type" x-text="r.usersCount + ' utilisateurs'"></div>
              </div>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:10px;">
              <template x-for="p in r.permissions" :key="p">
                <span style="padding:2px 8px;border-radius:6px;font-size:10px;font-weight:600;background:#f1f5f9;color:#64748b;" class="dark:!bg-[#1b2e4b] dark:!text-[#94a3b8]" x-text="p"></span>
              </template>
            </div>
          </div>
        </template>
      </div>
    </div>
  </template>

  <!-- Groups Tab -->
  <template x-if="tab === 'groups'">
    <div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
        <p style="font-size:13px;color:#64748b;">Organisez vos membres en départements et équipes</p>
        <button class="ts-btn-primary">
          <iconify-icon icon="solar:add-circle-bold" width="16"></iconify-icon>
          Nouveau groupe
        </button>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;">
        <template x-for="g in groups" :key="g.name">
          <div class="ts-share-card">
            <div class="ts-share-card-header">
              <div class="ts-share-card-icon" :style="'background:' + g.color + '15'">
                <iconify-icon :icon="g.icon" width="20" :style="'color:' + g.color"></iconify-icon>
              </div>
              <div style="flex:1;">
                <div class="ts-share-card-title" x-text="g.name"></div>
                <div class="ts-share-card-type" x-text="g.members.length + ' membres'"></div>
              </div>
            </div>
            <div class="ts-share-avatars" style="margin-top:10px;">
              <template x-for="m in g.members.slice(0,5)" :key="m">
                <img :src="'https://i.pravatar.cc/60?img=' + m" alt="member" />
              </template>
              <span class="ts-share-more" x-show="g.members.length > 5" x-text="'+' + (g.members.length - 5)"></span>
            </div>
          </div>
        </template>
      </div>
    </div>
  </template>

  <!-- Activity Log Tab -->
  <template x-if="tab === 'log'">
    <div style="background:#fff;border:1px solid #e0e6ed;border-radius:14px;padding:20px;" class="dark:!bg-[#0e1726] dark:!border-[#253b5c]">
      <template x-for="log in activityLogs" :key="log.id">
        <div class="ts-activity-item">
          <div class="ts-activity-dot" :style="'background:' + log.color"></div>
          <div style="flex:1;">
            <div class="ts-activity-text" x-html="log.text"></div>
            <div class="ts-activity-time" x-text="log.time"></div>
          </div>
        </div>
      </template>
    </div>
  </template>
</div>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('permissionsHub', () => ({
    tab: 'matrix',
    permCategories: [
      { name: 'Données', perms: [
        { key:'create_records', label:'Créer des enregistrements', icon:'solar:add-square-bold', roles:['admin','manager','member'] },
        { key:'edit_records', label:'Modifier des enregistrements', icon:'solar:pen-bold', roles:['admin','manager','member'] },
        { key:'delete_records', label:'Supprimer des enregistrements', icon:'solar:trash-bin-trash-bold', roles:['admin','manager'] },
        { key:'export_data', label:'Exporter les données', icon:'solar:download-bold', roles:['admin','manager'] },
        { key:'import_data', label:'Importer les données', icon:'solar:upload-bold', roles:['admin'] },
      ]},
      { name: 'Espaces & Vues', perms: [
        { key:'create_spaces', label:'Créer des espaces', icon:'solar:widget-add-bold', roles:['admin','manager'] },
        { key:'manage_views', label:'Gérer les vues', icon:'solar:eye-bold', roles:['admin','manager','member'] },
        { key:'share_views', label:'Partager des vues', icon:'solar:share-bold', roles:['admin','manager'] },
      ]},
      { name: 'Documents', perms: [
        { key:'create_docs', label:'Créer des documents', icon:'solar:document-add-bold', roles:['admin','manager','member'] },
        { key:'edit_templates', label:'Modifier les templates', icon:'solar:file-text-bold', roles:['admin'] },
        { key:'sign_docs', label:'Signer des documents', icon:'solar:pen-new-square-bold', roles:['admin','manager','member'] },
      ]},
      { name: 'Administration', perms: [
        { key:'manage_users', label:'Gérer les utilisateurs', icon:'solar:users-group-rounded-bold', roles:['admin'] },
        { key:'manage_billing', label:'Gérer la facturation', icon:'solar:wallet-bold', roles:['admin'] },
        { key:'manage_integrations', label:'Gérer les intégrations', icon:'solar:plug-circle-bold', roles:['admin'] },
        { key:'account_settings', label:'Paramètres du compte', icon:'solar:settings-bold', roles:['admin'] },
      ]},
    ],
    customRoles: [
      { name:'Comptable', icon:'solar:calculator-bold-duotone', color:'#06b6d4', usersCount:2, permissions:['Voir données','Exporter','Documents'] },
      { name:'Stagiaire', icon:'solar:graduation-cap-bold-duotone', color:'#8b5cf6', usersCount:3, permissions:['Voir données','Chat'] },
      { name:'Commercial', icon:'solar:case-bold-duotone', color:'#f97316', usersCount:5, permissions:['CRUD données','Partager','Documents','Chat'] },
    ],
    groups: [
      { name:'Direction', icon:'solar:crown-bold-duotone', color:'#7c3aed', members:[1,3,5,8] },
      { name:'Développement', icon:'solar:code-bold-duotone', color:'#4361ee', members:[11,12,14,15,17,20] },
      { name:'Marketing', icon:'solar:chart-bold-duotone', color:'#f97316', members:[10,16,22] },
      { name:'Support Client', icon:'solar:headphones-round-bold-duotone', color:'#10b981', members:[9,23,25,26] },
    ],
    activityLogs: [
      { id:1, text:'<strong>Riad Boukirou</strong> a modifié le rôle de <strong>Marc Dubois</strong> de Membre à Manager', time:'Il y a 2 heures', color:'#4361ee' },
      { id:2, text:'<strong>Sophie Martin</strong> a invité <strong>nouveau@email.com</strong> avec le rôle Membre', time:'Il y a 5 heures', color:'#f97316' },
      { id:3, text:'<strong>Riad Boukirou</strong> a créé le groupe <strong>Support Client</strong>', time:'Hier', color:'#7c3aed' },
      { id:4, text:'<strong>Thomas Petit</strong> a révoqué l\'accès de <strong>ancien@email.com</strong>', time:'Il y a 2 jours', color:'#ef4444' },
      { id:5, text:'<strong>Sophie Martin</strong> a activé la permission <em>Exporter les données</em> pour le rôle Manager', time:'Il y a 3 jours', color:'#22c55e' },
      { id:6, text:'<strong>Riad Boukirou</strong> a créé le rôle personnalisé <strong>Commercial</strong>', time:'Il y a 1 semaine', color:'#06b6d4' },
    ]
  }));
});
</script>
