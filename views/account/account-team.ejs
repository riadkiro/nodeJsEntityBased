<link rel="stylesheet" href="/css/app/team-system.css" />

<div x-data="teamHub()" x-init="init()" x-cloak>
  <!-- Page Header -->
  <div class="ts-page-header">
    <div class="ts-page-header-icon">
      <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="28" style="color:#4361ee"></iconify-icon>
    </div>
    <div class="ts-page-header-info">
      <h1>Équipe & Membres</h1>
      <p x-text="accountName ? 'Gérez les membres de ' + accountName : 'Chargement...'"></p>
    </div>
    <div style="display:flex;gap:10px;z-index:1;">
      <a href="/account/<%= account_number %>/chat" class="ts-btn-primary" style="background:linear-gradient(135deg,#f97316,#ea580c);">
        <iconify-icon icon="solar:chat-round-dots-bold" width="16"></iconify-icon> Team Chat
      </a>
      <button class="ts-btn-primary" @click="showInviteModal = true">
        <iconify-icon icon="solar:user-plus-bold" width="16"></iconify-icon> Inviter
      </button>
    </div>
  </div>

  <!-- Loading -->
  <template x-if="loading">
    <div style="text-align:center;padding:60px 20px;color:#94a3b8;">
      <iconify-icon icon="solar:refresh-bold-duotone" width="32" style="animation:spin 1s linear infinite;"></iconify-icon>
      <p style="margin-top:8px;font-size:13px;">Chargement des membres...</p>
    </div>
  </template>

  <template x-if="!loading">
    <div>
      <!-- Stats -->
      <div class="ts-stats">
        <div class="ts-stat-card">
          <div class="ts-stat-icon" style="background:rgba(67,97,238,.1);"><iconify-icon icon="solar:users-group-rounded-bold-duotone" width="24" style="color:#4361ee"></iconify-icon></div>
          <div><div class="ts-stat-value" x-text="members.length"></div><div class="ts-stat-label">Membres total</div></div>
        </div>
        <div class="ts-stat-card">
          <div class="ts-stat-icon" style="background:rgba(34,197,94,.1);"><iconify-icon icon="solar:check-circle-bold-duotone" width="24" style="color:#22c55e"></iconify-icon></div>
          <div><div class="ts-stat-value" x-text="members.filter(m => m.userStatus === 'active').length"></div><div class="ts-stat-label">Actifs</div></div>
        </div>
        <div class="ts-stat-card">
          <div class="ts-stat-icon" style="background:rgba(249,115,22,.1);"><iconify-icon icon="solar:letter-bold-duotone" width="24" style="color:#f97316"></iconify-icon></div>
          <div><div class="ts-stat-value" x-text="invitations.length"></div><div class="ts-stat-label">Invitations en attente</div></div>
        </div>
        <div class="ts-stat-card">
          <div class="ts-stat-icon" style="background:rgba(124,58,237,.1);"><iconify-icon icon="solar:share-bold-duotone" width="24" style="color:#7c3aed"></iconify-icon></div>
          <div><div class="ts-stat-value" x-text="myAccounts.length"></div><div class="ts-stat-label">Mes comptes</div></div>
        </div>
      </div>

      <!-- Toolbar -->
      <div class="ts-toolbar">
        <div class="ts-toolbar-left">
          <div class="ts-view-toggle">
            <button class="ts-view-btn" :class="viewMode === 'grid' && 'active'" @click="viewMode = 'grid'">
              <iconify-icon icon="solar:widget-bold" width="14"></iconify-icon> Grille
            </button>
            <button class="ts-view-btn" :class="viewMode === 'list' && 'active'" @click="viewMode = 'list'">
              <iconify-icon icon="solar:list-bold" width="14"></iconify-icon> Liste
            </button>
          </div>
          <template x-for="role in allRoles" :key="role.key">
            <button class="ts-filter-btn" :class="activeFilter === role.key && 'active'" @click="activeFilter = activeFilter === role.key ? 'all' : role.key">
              <span x-text="role.label"></span>
              <span style="opacity:.6;" x-text="'(' + members.filter(m => role.key === 'all' ? true : m.role === role.key).length + ')'"></span>
            </button>
          </template>
        </div>
        <div class="ts-toolbar-right">
          <div class="ts-search">
            <iconify-icon icon="solar:magnifer-linear" width="15" class="ts-search-icon"></iconify-icon>
            <input type="text" placeholder="Rechercher un membre..." x-model="searchQuery" />
          </div>
        </div>
      </div>

      <!-- Grid View -->
      <template x-if="viewMode === 'grid'">
        <div class="ts-member-grid">
          <template x-for="member in filteredMembers" :key="member._id">
            <div class="ts-member-card" :data-role="member.role">
              <div class="ts-member-actions" x-data="{open:false,editRole:false}" @click.outside="open=false;editRole=false">
                <button @click="open=!open"><iconify-icon icon="solar:menu-dots-bold" width="16"></iconify-icon></button>
                <div x-show="open" x-transition style="position:absolute;right:0;top:32px;background:#fff;border:1px solid #e0e6ed;border-radius:12px;padding:6px;min-width:200px;box-shadow:0 8px 24px rgba(0,0,0,.1);z-index:10;" class="dark:!bg-[#0e1726] dark:!border-[#253b5c]">
                  <template x-if="!editRole">
                    <div>
                      <button @click="editRole=true" style="display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;width:100%;border:none;background:none;font-size:12px;font-weight:500;color:#334155;cursor:pointer;font-family:inherit;" class="dark:!text-[#cbd5e1]" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='none'">
                        <iconify-icon icon="solar:pen-bold" width="14"></iconify-icon> Modifier le rôle
                      </button>
                      <button @click="removeMember(member._id, member.name); open=false" x-show="member.role !== 'owner'" style="display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;width:100%;border:none;background:none;font-size:12px;font-weight:500;color:#ef4444;cursor:pointer;font-family:inherit;" onmouseover="this.style.background='#fef2f2'" onmouseout="this.style.background='none'">
                        <iconify-icon icon="solar:trash-bin-trash-bold" width="14"></iconify-icon> Révoquer l'accès
                      </button>
                    </div>
                  </template>
                  <template x-if="editRole">
                    <div>
                      <div style="padding:6px 12px 4px;font-size:10px;font-weight:700;text-transform:uppercase;color:#94a3b8;">Choisir un rôle</div>
                      <template x-for="r in ['admin','manager','member','viewer']" :key="r">
                        <button @click="updateRole(member._id, r); open=false; editRole=false" style="display:flex;align-items:center;gap:8px;padding:7px 12px;border-radius:8px;width:100%;border:none;background:none;font-size:12px;font-weight:500;color:#334155;cursor:pointer;font-family:inherit;" class="dark:!text-[#cbd5e1]" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='none'">
                          <span class="ts-role-badge" :class="'ts-role-' + r" x-text="roleLabel(r)" style="font-size:9px;"></span>
                          <iconify-icon x-show="member.role === r" icon="solar:check-circle-bold" width="14" style="color:#22c55e;margin-left:auto;"></iconify-icon>
                        </button>
                      </template>
                    </div>
                  </template>
                </div>
              </div>
              <div style="text-align:center;">
                <div class="ts-member-avatar" style="display:inline-block;">
                  <template x-if="member.avatar">
                    <img :src="member.avatar" :alt="member.name" />
                  </template>
                  <template x-if="!member.avatar">
                    <div style="width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;color:#fff;" :style="'background:' + avatarColor(member.name)">
                      <span x-text="member.name.charAt(0).toUpperCase()"></span>
                    </div>
                  </template>
                  <span class="ts-status" :class="member.userStatus === 'active' ? 'ts-status-online' : 'ts-status-offline'"></span>
                </div>
                <div class="ts-member-name" x-text="member.name"></div>
                <div class="ts-member-email" x-text="member.email"></div>
                <span class="ts-role-badge" :class="'ts-role-' + member.role" x-text="roleLabel(member.role)"></span>
              </div>
              <div class="ts-member-meta">
                <span x-text="member.email.split('@')[1]"></span>
                <span x-text="formatDate(member.joinedAt)"></span>
              </div>
            </div>
          </template>
          <div class="ts-invite-card" @click="showInviteModal = true">
            <div class="ts-invite-card-icon"><iconify-icon icon="solar:user-plus-bold-duotone" width="24" style="color:#4361ee"></iconify-icon></div>
            <h6>Inviter un membre</h6>
            <p>Développez votre équipe</p>
          </div>
        </div>
      </template>

      <!-- List View -->
      <template x-if="viewMode === 'list'">
        <div class="ts-member-list">
          <template x-for="member in filteredMembers" :key="member._id">
            <div class="ts-member-row">
              <div style="position:relative;">
                <template x-if="member.avatar"><img :src="member.avatar" :alt="member.name" /></template>
                <template x-if="!member.avatar">
                  <div style="width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff;" :style="'background:' + avatarColor(member.name)">
                    <span x-text="member.name.charAt(0).toUpperCase()"></span>
                  </div>
                </template>
                <span class="ts-status" :class="member.userStatus === 'active' ? 'ts-status-online' : 'ts-status-offline'" style="position:absolute;bottom:0;right:-2px;"></span>
              </div>
              <div class="ts-member-row-info">
                <div class="ts-member-row-name" x-text="member.name"></div>
                <div class="ts-member-row-email" x-text="member.email"></div>
              </div>
              <span class="ts-role-badge" :class="'ts-role-' + member.role" x-text="roleLabel(member.role)"></span>
              <span class="ts-member-row-dept" x-text="member.email.split('@')[1]"></span>
              <span class="ts-member-row-date" x-text="formatDate(member.joinedAt)"></span>
            </div>
          </template>
        </div>
      </template>

      <!-- Pending Invites -->
      <div class="ts-section-title" x-show="invitations.length > 0">
        <iconify-icon icon="solar:letter-bold-duotone" width="16" style="color:#f97316"></iconify-icon> Invitations en attente
      </div>
      <div class="ts-member-list" x-show="invitations.length > 0">
        <template x-for="inv in invitations" :key="inv.email">
          <div class="ts-member-row" style="opacity:.75;">
            <div style="width:36px;height:36px;border-radius:50%;background:rgba(249,115,22,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <iconify-icon icon="solar:letter-bold" width="16" style="color:#f97316"></iconify-icon>
            </div>
            <div class="ts-member-row-info">
              <div class="ts-member-row-name" x-text="inv.email"></div>
              <div class="ts-member-row-email" x-text="'Invitation envoyée ' + formatDate(inv.invitedAt)"></div>
            </div>
            <span class="ts-role-badge" :class="'ts-role-' + inv.role" x-text="roleLabel(inv.role)"></span>
            <button class="ts-filter-btn" style="font-size:11px;padding:5px 10px;" @click="resendInvite(inv.email)">Renvoyer</button>
            <button style="padding:6px;border:none;background:none;color:#ef4444;cursor:pointer;border-radius:6px;" @click="cancelInvite(inv.email)">
              <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
            </button>
          </div>
        </template>
      </div>

      <!-- My Accounts -->
      <div class="ts-section-title">
        <iconify-icon icon="solar:buildings-2-bold-duotone" width="16" style="color:#7c3aed"></iconify-icon> Mes comptes
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;">
        <template x-for="acc in myAccounts" :key="acc.account_number">
          <a :href="'/account/' + acc.account_number + '/team'" class="ts-share-card" style="cursor:pointer;text-decoration:none;">
            <div class="ts-share-card-header">
              <div class="ts-share-card-icon" :style="'background:' + (acc.isActive ? 'rgba(67,97,238,.12)' : 'rgba(100,116,139,.08)')">
                <iconify-icon :icon="acc.icon" width="20" :style="'color:' + (acc.isActive ? '#4361ee' : '#64748b')"></iconify-icon>
              </div>
              <div style="flex:1;min-width:0;">
                <div class="ts-share-card-title" x-text="acc.name"></div>
                <div class="ts-share-card-type" x-text="acc.membersCount + ' membres'"></div>
              </div>
              <span class="ts-role-badge" :class="'ts-role-' + acc.role" x-text="roleLabel(acc.role)"></span>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#94a3b8;margin-top:6px;">
              <span x-text="'#' + acc.account_number"></span>
              <span x-show="acc.isActive" style="color:#22c55e;font-weight:600;">● Actif</span>
            </div>
          </a>
        </template>
      </div>
    </div>
  </template>

  <!-- Invite Modal -->
  <template x-if="showInviteModal">
    <div class="ts-modal-overlay" @click.self="showInviteModal = false">
      <div class="ts-modal" @click.stop>
        <div class="ts-modal-header">
          <h3>Inviter un membre</h3>
          <button class="ts-modal-close" @click="showInviteModal = false"><iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon></button>
        </div>
        <div class="ts-modal-body">
          <div x-show="inviteError" style="padding:10px 14px;border-radius:10px;background:rgba(239,68,68,.08);color:#ef4444;font-size:12px;font-weight:600;margin-bottom:14px;" x-text="inviteError"></div>
          <div x-show="inviteSuccess" style="padding:10px 14px;border-radius:10px;background:rgba(34,197,94,.08);color:#22c55e;font-size:12px;font-weight:600;margin-bottom:14px;" x-text="inviteSuccess"></div>
          <div style="margin-bottom:18px;">
            <label style="font-size:12px;font-weight:600;color:#334155;display:block;margin-bottom:6px;" class="dark:!text-[#cbd5e1]">Adresse email</label>
            <input type="email" placeholder="email@example.com" x-model="inviteEmail" style="width:100%;padding:10px 14px;border:1.5px solid #e0e6ed;border-radius:10px;font-size:13px;font-family:inherit;outline:none;background:#fff;" class="dark:!bg-[#1b2e4b] dark:!border-[#253b5c] dark:!text-[#e0e6ed]" />
          </div>
          <div style="margin-bottom:18px;">
            <label style="font-size:12px;font-weight:600;color:#334155;display:block;margin-bottom:6px;" class="dark:!text-[#cbd5e1]">Rôle</label>
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px;">
              <template x-for="r in [{key:'admin',label:'Admin',desc:'Accès complet',icon:'solar:shield-bold-duotone',color:'#4361ee'},{key:'manager',label:'Manager',desc:'Gestion d\'équipe',icon:'solar:user-check-bold-duotone',color:'#f97316'},{key:'member',label:'Membre',desc:'Accès standard',icon:'solar:user-bold-duotone',color:'#64748b'},{key:'viewer',label:'Observateur',desc:'Lecture seule',icon:'solar:eye-bold-duotone',color:'#10b981'}]" :key="r.key">
                <div style="padding:12px;border-radius:12px;border:1.5px solid #e0e6ed;cursor:pointer;transition:all .2s;" :style="inviteRole === r.key ? 'border-color:#4361ee;background:rgba(67,97,238,.04)' : ''" @click="inviteRole = r.key" class="dark:!border-[#253b5c]">
                  <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
                    <iconify-icon :icon="r.icon" width="16" :style="'color:'+r.color"></iconify-icon>
                    <span style="font-size:13px;font-weight:600;" x-text="r.label" class="dark:!text-[#e0e6ed]"></span>
                  </div>
                  <div style="font-size:11px;color:#94a3b8;" x-text="r.desc"></div>
                </div>
              </template>
            </div>
          </div>
          <div style="display:flex;justify-content:flex-end;gap:10px;">
            <button class="ts-filter-btn" @click="showInviteModal = false">Annuler</button>
            <button class="ts-btn-primary" @click="sendInvite()" :disabled="inviteSending">
              <iconify-icon icon="solar:plain-bold" width="16"></iconify-icon>
              <span x-text="inviteSending ? 'Envoi...' : 'Envoyer l\'invitation'"></span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </template>

  <!-- Toast -->
  <div x-show="toast" x-transition style="position:fixed;bottom:24px;right:24px;z-index:1000;padding:12px 20px;border-radius:12px;font-size:13px;font-weight:600;color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.15);" :style="'background:' + (toastType === 'success' ? 'linear-gradient(135deg,#22c55e,#16a34a)' : 'linear-gradient(135deg,#ef4444,#dc2626)')" x-text="toast"></div>
</div>

<style>@keyframes spin { to { transform: rotate(360deg); } }</style>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('teamHub', () => ({
    loading: true,
    viewMode: 'grid',
    activeFilter: 'all',
    searchQuery: '',
    accountName: '',
    members: [],
    invitations: [],
    myAccounts: [],
    showInviteModal: false,
    inviteEmail: '',
    inviteRole: 'member',
    inviteSending: false,
    inviteError: '',
    inviteSuccess: '',
    toast: '',
    toastType: 'success',
    allRoles: [
      { key: 'all', label: 'Tous' },
      { key: 'owner', label: 'Owner' },
      { key: 'admin', label: 'Admin' },
      { key: 'manager', label: 'Manager' },
      { key: 'member', label: 'Membre' },
      { key: 'viewer', label: 'Viewer' }
    ],
    apiBase: '/account/<%= account_number %>/api/team',

    async init() {
      await Promise.all([this.fetchMembers(), this.fetchMyAccounts()]);
      this.loading = false;
    },

    async fetchMembers() {
      try {
        const res = await fetch(this.apiBase + '/members', { credentials: 'include' });
        const data = await res.json();
        if (data.success) {
          this.members = data.members;
          this.invitations = data.invitations;
          this.accountName = data.accountName;
        }
      } catch (e) { console.error('fetchMembers error:', e); }
    },

    async fetchMyAccounts() {
      try {
        const res = await fetch(this.apiBase + '/my-accounts', { credentials: 'include' });
        const data = await res.json();
        if (data.success) this.myAccounts = data.accounts;
      } catch (e) { console.error('fetchMyAccounts error:', e); }
    },

    async sendInvite() {
      this.inviteError = '';
      this.inviteSuccess = '';
      if (!this.inviteEmail.trim()) { this.inviteError = 'Email requis'; return; }
      this.inviteSending = true;
      try {
        const res = await fetch(this.apiBase + '/invite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email: this.inviteEmail, role: this.inviteRole }),
        });
        const data = await res.json();
        if (data.success) {
          this.inviteSuccess = data.message;
          this.inviteEmail = '';
          await this.fetchMembers();
          setTimeout(() => { this.showInviteModal = false; this.inviteSuccess = ''; }, 1500);
          this.showToast(data.message, 'success');
        } else {
          this.inviteError = data.error;
        }
      } catch (e) { this.inviteError = 'Erreur réseau'; }
      this.inviteSending = false;
    },

    async updateRole(userId, newRole) {
      try {
        const res = await fetch(this.apiBase + '/update-role', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ userId, newRole }),
        });
        const data = await res.json();
        if (data.success) {
          await this.fetchMembers();
          this.showToast('Rôle mis à jour', 'success');
        }
      } catch (e) { this.showToast('Erreur', 'error'); }
    },

    async removeMember(userId, name) {
      if (!confirm('Retirer ' + name + ' du compte ?')) return;
      try {
        const res = await fetch(this.apiBase + '/remove-member', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ userId }),
        });
        const data = await res.json();
        if (data.success) {
          await this.fetchMembers();
          this.showToast(name + ' retiré', 'success');
        } else {
          this.showToast(data.error, 'error');
        }
      } catch (e) { this.showToast('Erreur', 'error'); }
    },

    async resendInvite(email) {
      try {
        await fetch(this.apiBase + '/resend-invite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email }),
        });
        this.showToast('Invitation renvoyée', 'success');
      } catch (e) { this.showToast('Erreur', 'error'); }
    },

    async cancelInvite(email) {
      try {
        await fetch(this.apiBase + '/cancel-invite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email }),
        });
        await this.fetchMembers();
        this.showToast('Invitation annulée', 'success');
      } catch (e) { this.showToast('Erreur', 'error'); }
    },

    showToast(msg, type) {
      this.toast = msg;
      this.toastType = type;
      setTimeout(() => { this.toast = ''; }, 3000);
    },

    get filteredMembers() {
      let list = this.members;
      if (this.activeFilter !== 'all') list = list.filter(m => m.role === this.activeFilter);
      if (this.searchQuery.trim()) {
        const q = this.searchQuery.toLowerCase();
        list = list.filter(m => m.name.toLowerCase().includes(q) || m.email.toLowerCase().includes(q));
      }
      return list;
    },

    roleLabel(role) {
      return { owner:'Owner', admin:'Admin', manager:'Manager', member:'Membre', viewer:'Viewer' }[role] || role;
    },

    avatarColor(name) {
      const colors = ['#4361ee','#7c3aed','#f97316','#10b981','#ec4899','#06b6d4','#ef4444','#8b5cf6'];
      let hash = 0;
      for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
      return colors[Math.abs(hash) % colors.length];
    },

    formatDate(d) {
      if (!d) return '-';
      const date = new Date(d);
      return date.toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' });
    },
  }));
});
</script>
