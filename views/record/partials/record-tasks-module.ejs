</style>

<div class="tl-wrap" :class="{'tl-fs-active': kanbanList}" x-data="recordTaskLists()" @click.window="statusMenuId = null; ctxMenu = null; previewStatusMenu = null; previewStatusListId = null; taskCtx = null; statusMgrListId = null" @contextmenu.prevent>

    <% if (_isTasksTabLocal) { %>
    <!-- ════════ VIEW 1: LISTS ════════ -->
