<div class="animate__animated p-6" :class="[$store.app.animation]">
    <ul class="flex space-x-2 rtl:space-x-reverse">
        <li>
            <a href="/account/<%= account_number %>/dashboard" class="text-primary hover:underline">Dashboard</a>
        </li>
        <li class="before:content-['/'] ltr:before:mr-1 rtl:before:ml-1">
            <span>Paramètres du compte</span>
        </li>
    </ul>
    
    <div class="pt-5" x-data="accountSettings()">
        <div class="mb-5 flex items-center justify-between">
            <h5 class="text-lg font-semibold dark:text-white-light">Paramètres du compte</h5>
        </div>
        
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <!-- Account Info Panel -->
            <div class="panel">
                <div class="mb-5">
                    <h6 class="text-lg font-bold">Informations du compte</h6>
                    <p class="text-sm text-gray-500 mt-1">Modifiez les informations de votre espace de travail</p>
                </div>
                
                <form @submit.prevent="saveAccountInfo">
                    <div class="mb-5">
                        <label for="accountName" class="block text-sm font-medium mb-2">Nom du compte</label>
                        <input 
                            id="accountName" 
                            type="text" 
                            x-model="accountName"
                            class="form-input"
                            placeholder="Entrez le nom du compte"
                        >
                    </div>
                    
                    <div class="mb-5">
                        <label class="block text-sm font-medium mb-2">Icône du compte</label>
                        <div class="flex items-center gap-4">
                            <div class="p-3 bg-primary/10 text-primary rounded-lg">
                                <iconify-icon :icon="accountIcon" width="32" height="32"></iconify-icon>
                            </div>
                            <div class="flex-1">
                                <div class="flex flex-wrap gap-2 mb-2">
                                    <template x-for="icon in popularIcons" :key="icon">
                                        <button 
                                            type="button" 
                                            class="p-2 rounded-lg border transition-all"
                                            :class="accountIcon === icon ? 'border-primary bg-primary/10' : 'border-gray-200 dark:border-gray-800 hover:border-primary'"
                                            @click="accountIcon = icon"
                                        >
                                            <iconify-icon :icon="icon" width="20" height="20"></iconify-icon>
                                        </button>
                                    </template>
                                </div>
                                <input 
                                    type="text" 
                                    x-model="accountIcon"
                                    class="form-input text-sm"
                                    placeholder="Nom de l'icône (ex: solar:home-bold)"
                                >
                                <p class="text-xs text-gray-500 mt-1">Utilisez les icônes <a href="https://icon-sets.iconify.design/" target="_blank" class="text-primary hover:underline">Iconify</a></p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-5">
                        <label class="block text-sm font-medium mb-2">Numéro de compte</label>
                        <div class="flex items-center gap-2">
                            <input 
                                type="text" 
                                value="<%= account_number %>"
                                class="form-input bg-gray-100 dark:bg-gray-800"
                                disabled
                            >
                            <button type="button" class="btn btn-outline-secondary btn-sm" @click="copyAccountNumber">
                                <iconify-icon icon="solar:copy-linear" width="16" height="16"></iconify-icon>
                            </button>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">Ce numéro ne peut pas être modifié</p>
                    </div>
                    
                    <div class="mb-5">
                        <label for="accountStatus" class="block text-sm font-medium mb-2">Statut</label>
                        <select id="accountStatus" x-model="accountStatus" class="form-select">
                            <option value="active">Actif</option>
                            <option value="inactive">Inactif</option>
                            <option value="suspended">Suspendu</option>
                        </select>
                    </div>
                    
                    <div class="flex items-center gap-2">
                        <button type="submit" class="btn btn-primary" :disabled="isSaving">
                            <span x-show="isSaving" class="animate-spin border-2 border-white border-l-transparent rounded-full w-4 h-4 inline-block mr-2"></span>
                            <span x-text="isSaving ? 'Enregistrement...' : 'Enregistrer'"></span>
                        </button>
                        <span x-show="saveSuccess" x-transition class="text-success text-sm">
                            <iconify-icon icon="solar:check-circle-bold" class="align-middle"></iconify-icon>
                            Enregistré avec succès
                        </span>
                    </div>
                </form>
            </div>
            
            <!-- Account Stats Panel -->
            <div class="panel">
                <div class="mb-5">
                    <h6 class="text-lg font-bold">Statistiques</h6>
                    <p class="text-sm text-gray-500 mt-1">Aperçu de votre utilisation</p>
                </div>
                
                <div class="space-y-4">
                    <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
                        <div class="flex items-center gap-3">
                            <div class="p-2 bg-primary/20 text-primary rounded-lg">
                                <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="24" height="24"></iconify-icon>
                            </div>
                            <div>
                                <div class="text-sm text-gray-500">Utilisateurs</div>
                                <div class="text-lg font-semibold" x-text="stats.users">-</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
                        <div class="flex items-center gap-3">
                            <div class="p-2 bg-success/20 text-success rounded-lg">
                                <iconify-icon icon="solar:box-bold-duotone" width="24" height="24"></iconify-icon>
                            </div>
                            <div>
                                <div class="text-sm text-gray-500">Collections</div>
                                <div class="text-lg font-semibold" x-text="stats.collections">-</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
                        <div class="flex items-center gap-3">
                            <div class="p-2 bg-warning/20 text-warning rounded-lg">
                                <iconify-icon icon="solar:document-text-bold-duotone" width="24" height="24"></iconify-icon>
                            </div>
                            <div>
                                <div class="text-sm text-gray-500">Enregistrements</div>
                                <div class="text-lg font-semibold" x-text="stats.records">-</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
                        <div class="flex items-center gap-3">
                            <div class="p-2 bg-info/20 text-info rounded-lg">
                                <iconify-icon icon="solar:calendar-bold-duotone" width="24" height="24"></iconify-icon>
                            </div>
                            <div>
                                <div class="text-sm text-gray-500">Date de création</div>
                                <div class="text-lg font-semibold" x-text="stats.createdAt">-</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- App Presets Link -->
        <a href="/account/<%= account_number %>/app-presets" class="panel mt-6 flex items-center gap-4 hover:border-primary transition-colors group cursor-pointer block">
            <div class="p-3 bg-primary/10 text-primary rounded-xl group-hover:bg-primary group-hover:text-white transition-colors">
                <iconify-icon icon="solar:magic-stick-3-bold-duotone" width="28" height="28"></iconify-icon>
            </div>
            <div class="flex-1">
                <h6 class="font-semibold dark:text-white-light group-hover:text-primary transition-colors">Démo</h6>
                <p class="text-sm text-gray-500 mt-0.5">Installer un modèle métier complet (Cabinet médical, Notaire...)</p>
            </div>
            <iconify-icon icon="solar:arrow-right-linear" width="20" height="20" class="text-gray-400 group-hover:text-primary transition-colors"></iconify-icon>
        </a>

        <!-- Danger Zone -->
        <div class="panel mt-6 border-danger/30">
            <div class="mb-5">
                <h6 class="text-lg font-bold text-danger">Zone de danger</h6>
                <p class="text-sm text-gray-500 mt-1">Actions irréversibles</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-4 border border-gray-200 dark:border-gray-800 rounded-lg">
                    <h6 class="font-semibold mb-2">Exporter les données</h6>
                    <p class="text-sm text-gray-500 mb-3">Téléchargez toutes les données de ce compte au format JSON.</p>
                    <button type="button" class="btn btn-outline-primary btn-sm">
                        <iconify-icon icon="solar:download-bold" class="mr-1"></iconify-icon>
                        Exporter
                    </button>
                </div>
                
                <div class="p-4 border border-danger/30 rounded-lg bg-danger/5">
                    <h6 class="font-semibold mb-2 text-danger">Supprimer le compte</h6>
                    <p class="text-sm text-gray-500 mb-3">Cette action est irréversible. Toutes les données seront supprimées.</p>
                    <button type="button" class="btn btn-danger btn-sm" @click="confirmDelete">
                        <iconify-icon icon="solar:trash-bin-trash-bold" class="mr-1"></iconify-icon>
                        Supprimer le compte
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('accountSettings', () => ({
        accountName: '<%= typeof account !== "undefined" && account ? account.name || "" : "" %>',
        accountIcon: '<%= typeof account !== "undefined" && account ? account.icon || "solar:settings-bold-duotone" : "solar:settings-bold-duotone" %>',
        accountStatus: '<%= typeof account !== "undefined" && account ? account.status || "active" : "active" %>',
        isSaving: false,
        saveSuccess: false,
        popularIcons: [
            'solar:settings-bold-duotone',
            'solar:home-bold-duotone',
            'solar:buildings-bold-duotone',
            'solar:case-bold-duotone',
            'solar:shop-bold-duotone',
            'solar:cart-large-bold-duotone',
            'solar:code-bold-duotone',
            'solar:heart-bold-duotone',
            'solar:star-bold-duotone',
            'solar:rocket-bold-duotone'
        ],
        stats: {
            users: '<%= typeof account !== "undefined" && account && account.users ? account.users.length : 0 %>',
            collections: '-',
            records: '-',
            createdAt: '<%= typeof account !== "undefined" && account && account.created_on ? new Date(account.created_on).toLocaleDateString("fr-FR") : "-" %>'
        },
        
        async saveAccountInfo() {
            this.isSaving = true;
            this.saveSuccess = false;
            
            try {
                const response = await fetch('/account/<%= account_number %>/api/account/update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        name: this.accountName,
                        icon: this.accountIcon,
                        status: this.accountStatus
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    this.saveSuccess = true;
                    setTimeout(() => this.saveSuccess = false, 3000);
                } else {
                    alert('Erreur: ' + (data.message || 'Impossible de sauvegarder'));
                }
            } catch (error) {
                console.error('Error saving account:', error);
                alert('Erreur lors de la sauvegarde');
            } finally {
                this.isSaving = false;
            }
        },
        
        copyAccountNumber() {
            navigator.clipboard.writeText('<%= account_number %>');
            // Show toast notification
            if (window.Swal) {
                Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 2000
                }).fire({
                    icon: 'success',
                    title: 'Numéro copié!'
                });
            }
        },
        
        confirmDelete() {
            if (window.Swal) {
                Swal.fire({
                    title: 'Êtes-vous sûr?',
                    text: "Cette action est irréversible. Toutes les données du compte seront supprimées.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e7515a',
                    cancelButtonColor: '#888ea8',
                    confirmButtonText: 'Oui, supprimer',
                    cancelButtonText: 'Annuler'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // TODO: Implement account deletion
                        console.log('Account deletion requested');
                    }
                });
            } else {
                if (confirm('Êtes-vous sûr de vouloir supprimer ce compte? Cette action est irréversible.')) {
                    console.log('Account deletion requested');
                }
            }
        },
        
        async init() {
            // Fetch additional stats if needed
            try {
                const response = await fetch('/account/<%= account_number %>/api/account/stats');
                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        this.stats = { ...this.stats, ...data.stats };
                    }
                }
            } catch (error) {
                console.error('Error fetching stats:', error);
            }
        }
    }));
});
</script>
