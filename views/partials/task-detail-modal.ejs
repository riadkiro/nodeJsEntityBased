	        async selectOption(kind, option) {
	            const meta = this.optionMeta(kind);
	            if (!this.task || !option?.label) return;
	            if (kind === 'tag') {
	                const key = String(option.label || '').trim().toLowerCase();
	                const current = this.selectedTags();
	                const hasTag = current.some(tag => tag.label.toLowerCase() === key);
	                const next = hasTag
	                    ? current.filter(tag => tag.label.toLowerCase() !== key)
	                    : [...current, { label: option.label, color: option.color || meta.fallbackColor, order: current.length }];
	                this.task.tags = this.normalizeTaskTags(next, this.tagOptions);
	                await this.updateField('tags', this.task.tags, { silent: true });
	                return;
	            }
	            this.task[meta.field] = option.label;
	            this.task[meta.colorField] = option.color || meta.fallbackColor;
            if (kind === 'status') {
                this.task.completedAt = String(option.label || '').toLowerCase().includes('termin')
                    ? (this.task.completedAt || new Date().toISOString())
                    : null;
