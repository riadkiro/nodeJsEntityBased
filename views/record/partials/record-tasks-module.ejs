                        <div class="tl-side-kpi">
                            <div class="tl-side-kpi-icon" style="background:#fff7ed;color:#f97316">
                                <iconify-icon icon="solar:clock-circle-bold-duotone" width="18"></iconify-icon>
                            </div>
                            <div><strong x-text="overdueTaskCount"></strong><span>En retard</span></div>
                        </div>
                        <div class="tl-side-kpi">
                            <div class="tl-side-kpi-icon" style="background:#eff6ff;color:#3b82f6">
                                <iconify-icon icon="solar:calendar-date-bold-duotone" width="18"></iconify-icon>
                            </div>
                            <div><strong x-text="todayTaskCount"></strong><span>Aujourd'hui</span></div>
                        </div>
                        <div class="tl-side-kpi">
                            <div class="tl-side-kpi-icon" style="background:#ecfdf5;color:#10b981">
                                <iconify-icon icon="solar:check-circle-bold-duotone" width="18"></iconify-icon>
                            </div>
                            <div><strong x-text="completedTasks"></strong><span>Terminées</span></div>
                        </div>
                        <div class="tl-side-kpi">
                            <div class="tl-side-kpi-icon" style="background:#f5f3ff;color:#7c3aed">
                                <iconify-icon icon="solar:folder-with-files-bold-duotone" width="18"></iconify-icon>
                            </div>
                            <div><strong x-text="activeListsCount"></strong><span>Listes actives</span></div>
                        </div>
                    </div>
                </section>

                <section class="tl-side-panel">
                    <div class="tl-side-head">
                        <h3 class="tl-side-title">
                            <iconify-icon icon="solar:chart-2-bold-duotone" width="17" style="color:#10b981"></iconify-icon>
                            Avancement
                        </h3>
                        <span class="tl-side-chip" x-text="completionPct + '%'"></span>
                    </div>
                    <div class="tl-side-donut-row">
                        <div class="tl-side-donut" :style="'background:conic-gradient(' + taskProgressConic + ')'">
                            <div class="tl-side-donut-center">
                                <b x-text="totalTasks"></b>
                                <span>Tâches</span>
                            </div>
                        </div>
                        <div class="tl-side-legend">
                            <template x-for="item in progressLegend" :key="item.label">
                                <div class="tl-side-legend-row">
                                    <span class="tl-side-dot" :style="'background:' + item.color"></span>
                                    <span x-text="item.label"></span>
                                    <b x-text="item.count"></b>
                                </div>
                            </template>
                        </div>
                    </div>
                    <div class="tl-side-metrics">
                        <div class="tl-side-metric"><b x-text="lists.length"></b><span>Listes</span></div>
                        <div class="tl-side-metric"><b x-text="totalTasks"></b><span>Total</span></div>
                        <div class="tl-side-metric"><b x-text="completedTasks"></b><span>Terminées</span></div>
                    </div>
                </section>

                <section class="tl-side-panel">
                    <div class="tl-side-head">
                        <h3 class="tl-side-title">Charge de travail</h3>
                        <button type="button" class="tl-pro-btn" style="height:30px;padding:0 9px">Cette semaine</button>
                    </div>
                    <div class="tl-side-bars">
                        <template x-for="bar in workloadBars" :key="bar.label">
                            <div class="tl-side-bar-wrap">
                                <div class="tl-side-bar-bg"><div class="tl-side-bar" :style="'height:' + bar.height + '%'"></div></div>
                                <span class="tl-side-bar-label" x-text="bar.label"></span>
                            </div>
                        </template>
                    </div>
                </section>

                <section class="tl-side-panel">
                    <div class="tl-side-head"><h3 class="tl-side-title">À traiter</h3></div>
                    <div class="tl-side-action">
                        <span class="tl-side-action-icon" style="background:#fff7ed;color:#f97316"><iconify-icon icon="solar:clock-circle-bold-duotone" width="15"></iconify-icon></span>
                        <div style="min-width:0;flex:1">
                            <div class="tl-side-action-title"><span x-text="overdueTaskCount"></span> en retard</div>
                            <div class="tl-side-action-sub">À reprendre en priorité</div>
                        </div>
                        <iconify-icon icon="solar:alt-arrow-right-linear" width="13" style="color:#a7b3c8"></iconify-icon>
                    </div>
                    <div class="tl-side-action">
                        <span class="tl-side-action-icon" style="background:#eff6ff;color:#3b82f6"><iconify-icon icon="solar:calendar-date-bold-duotone" width="15"></iconify-icon></span>
                        <div style="min-width:0;flex:1">
                            <div class="tl-side-action-title"><span x-text="todayTaskCount"></span> aujourd'hui</div>
                            <div class="tl-side-action-sub">Échéances du jour</div>
                        </div>
                        <iconify-icon icon="solar:alt-arrow-right-linear" width="13" style="color:#a7b3c8"></iconify-icon>
                    </div>
                </section>

                <section class="tl-side-panel">
                    <div class="tl-side-head">
                        <h3 class="tl-side-title">Échéances à venir</h3>
                        <a class="tl-side-link">Voir tout</a>
                    </div>
                    <template x-for="task in upcomingTasks" :key="task._id">
                        <div class="tl-side-action" @click="openDetail(task._list, task)" style="cursor:pointer">
                            <span class="tl-side-action-icon" :style="'background:' + colorSoft(taskAccent(task, task._list)) + ';color:' + taskAccent(task, task._list)">
                                <iconify-icon icon="solar:calendar-bold-duotone" width="15"></iconify-icon>
                            </span>
                            <div style="min-width:0">
                                <div class="tl-side-action-title" x-text="task.title"></div>
                                <div class="tl-side-action-sub"><span x-text="formatTaskDate(task.dueDate || task.createdAt)"></span> · <span x-text="task._list?.label || 'Tâches'"></span></div>
                            </div>
                        </div>
                    </template>
                    <template x-if="upcomingTasks.length === 0">
                        <div class="tl-side-empty">Aucune échéance pour l'instant.</div>
                    </template>
                </section>
            </aside>
        </div>
    </template>

    <!-- ════════ VIEW 2: TASKS INSIDE A LIST ════════ -->
    <template x-if="activeList && !kanbanList">
        <div class="tl-list-detail-view">
            <!-- Back -->
            <button class="tl-back" @click="activeList = null; tasks = [];">
                <iconify-icon icon="solar:alt-arrow-left-linear" width="14"></iconify-icon>
                Retour aux listes
            </button>

            <!-- List header -->
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
                <div class="tl-card-icon" :style="'background:' + activeList.color + '12;width:28px;height:28px'">
                    <iconify-icon icon="solar:checklist-minimalistic-bold-duotone" width="16" :style="'color:' + activeList.color"></iconify-icon>
                </div>
                <span style="font-size:16px;font-weight:700;color:#0e1726" x-text="activeList.label"></span>
                <span class="tl-section-count" :style="'background:' + activeList.color + '15;color:' + activeList.color" x-text="tasks.length"></span>
            </div>

            <!-- Add task -->
            <div class="tl-task-add">
                <div style="width:20px;height:20px;border-radius:6px;border:2px solid #d1d5db;flex-shrink:0"></div>
                <input type="text" placeholder="Ajouter une tâche..."
                       x-model="newTaskTitle"
                       x-init="newTaskTitle = normalizeDraftValue(newTaskTitle)"
                       @input="newTaskTitle = normalizeDraftValue(newTaskTitle)"
                       @keydown.enter="addTask()"
                       @keydown.escape="newTaskTitle = ''">
                <button type="button" class="tl-task-add-btn" @click="addTask()">
                    <iconify-icon icon="solar:add-circle-bold" width="12" style="margin-right:2px"></iconify-icon>
                    Ajouter
                </button>
            </div>

            <!-- Loading -->
            <div x-show="loadingTasks" style="text-align:center; padding:24px;">
                <iconify-icon icon="line-md:loading-twotone-loop" width="22" style="color:#10b981"></iconify-icon>
            </div>

            <!-- Active tasks -->
            <template x-if="!loadingTasks">
                <div>
                    <div class="tl-section" x-show="activeTasks.length > 0">
                        À faire
                        <span class="tl-section-count" style="background:#3b82f612;color:#3b82f6" x-text="activeTasks.length"></span>
                    </div>
                    <div class="tl-grid">
                        <template x-for="task in activeTasks" :key="task._id">
                            <div class="tl-task" :class="{'has-menu-open': statusMenuId === task._id}" @click.stop="openDetail(activeList, task)" @contextmenu.prevent.stop="openCtx($event, 'task', task)" :style="'animation-delay:' + activeTasks.indexOf(task)*30 + 'ms'">
                                <div class="tl-task-check" @click.stop="toggleDone(task)">
                                    <svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </div>
                                <div class="tl-task-body">
                                    <div class="tl-task-title" x-show="editingTaskId !== task._id" x-text="task.title"></div>
                                    <input x-show="editingTaskId === task._id" class="tl-inline-edit" style="font-size:13.5px;font-weight:500"
                                           x-model="editTaskTitle"
                                           @click.stop
                                           @keydown.enter="saveTaskName(task)"
                                           @keydown.escape="editingTaskId = null"
                                           @blur="saveTaskName(task)">
                                </div>
                                <div style="position:relative;z-index:1">
                                    <span class="tl-task-status"
                                          :style="'background:' + (task.statusColor||'#9ca3af') + '15;color:' + (task.statusColor||'#9ca3af')"
                                          x-text="task.status || 'À faire'"
                                          @click.stop="statusMenuId = statusMenuId === task._id ? null : task._id"></span>
                                    <!-- Status dropdown -->
                                    <div class="tl-status-menu" x-show="statusMenuId === task._id" x-cloak @click.stop>
                                        <template x-for="s in statuses" :key="s.label">
                                            <button class="tl-status-opt" @click="setStatus(task, s.label); statusMenuId = null">
                                                <span class="tl-status-dot" :style="'background:' + s.color"></span>
                                                <span x-text="s.label"></span>
                                            </button>
                                        </template>
                                    </div>
                                </div>
                                <button class="tl-task-delete" @click.stop="deleteTask(task._id)" title="Supprimer">
                                    <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="13"></iconify-icon>
                                </button>
                            </div>
                        </template>
                    </div>

                    <!-- Done tasks -->
                    <div x-show="doneTasks.length > 0" style="margin-top:8px;">
                        <div class="tl-section" style="cursor:pointer" @click="showDone = !showDone">
                            Terminées
                            <span class="tl-section-count" style="background:#10b98112;color:#10b981" x-text="doneTasks.length"></span>
                            <iconify-icon :icon="showDone ? 'solar:alt-arrow-up-linear' : 'solar:alt-arrow-down-linear'" width="12" style="margin-left:4px;vertical-align:middle"></iconify-icon>
                        </div>
                        <div class="tl-grid" x-show="showDone" x-collapse>
                            <template x-for="task in doneTasks" :key="task._id">
                                <div class="tl-task done" @click.stop="openDetail(activeList, task)">
                                    <div class="tl-task-check checked" @click.stop="toggleDone(task)">
                                        <svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </div>
                                    <div class="tl-task-body">
                                        <div class="tl-task-title" x-text="task.title"></div>
                                    </div>
                                    <span class="tl-task-status" style="background:#10b98115;color:#10b981"
                                          @click.stop="statusMenuId = statusMenuId === task._id ? null : task._id">Terminé</span>
                                    <div style="position:relative">
                                        <div class="tl-status-menu" x-show="statusMenuId === task._id" x-cloak @click.stop>
                                            <template x-for="s in statuses" :key="s.label">
                                                <button class="tl-status-opt" @click="setStatus(task, s.label); statusMenuId = null">
                                                    <span class="tl-status-dot" :style="'background:' + s.color"></span>
                                                    <span x-text="s.label"></span>
                                                </button>
                                            </template>
                                        </div>
                                    </div>
                                    <button class="tl-task-delete" @click.stop="deleteTask(task._id)" title="Supprimer">
                                        <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="13"></iconify-icon>
                                    </button>
                                </div>
                            </template>
                        </div>
                    </div>

                    <!-- Empty -->
                    <div class="tl-empty" x-show="tasks.length === 0">
                        <iconify-icon icon="solar:checklist-minimalistic-bold-duotone" width="36" style="color:#d1d5db;margin-bottom:8px"></iconify-icon>
                        <span style="font-size:13px;font-weight:600;color:#94a3b8">Liste vide</span>
                        <span style="font-size:12px;color:#bfc9d4;margin-top:2px">Ajoutez une tâche ci-dessus</span>
                    </div>
                </div>
            </template>
        </div>
    </template>

    <!-- ════════ CONTEXT MENU ════════ -->
    <div class="tl-ctx" x-show="ctxMenu" x-cloak
         :style="ctxMenu ? 'left:' + ctxMenu.x + 'px;top:' + ctxMenu.y + 'px' : ''"
         @click.stop>

        <!-- Rename -->
        <button class="tl-ctx-item" @click="ctxRename()">
            <iconify-icon icon="solar:pen-2-linear" width="15"></iconify-icon>
            Renommer
        </button>

        <!-- Color picker (lists only) -->
        <template x-if="ctxMenu?.type === 'list'">
            <div>
                <div class="tl-ctx-sep"></div>
                <div style="padding:4px 12px 2px;font-size:10px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:0.5px">Couleur</div>
                <div class="tl-ctx-colors">
                    <template x-for="c in ctxColors" :key="c">
                        <div class="tl-ctx-color" :class="{'active': ctxMenu?.target?.color === c}" :style="'background:' + c" @click="ctxChangeColor(c)"></div>
                    </template>
                </div>
            </div>
        </template>

        <!-- Delete -->
        <div class="tl-ctx-sep"></div>
        <button class="tl-ctx-item danger" @click="ctxDelete()">
            <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="15"></iconify-icon>
            Supprimer
        </button>
    </div>

    <!-- ════════ TASK CONTEXT MENU ════════ -->
    <div class="tl-task-ctx" x-show="taskCtx" x-cloak
         :style="taskCtx ? 'left:' + taskCtx.x + 'px;top:' + taskCtx.y + 'px' : ''"
         @click.stop>
        <button @click="taskCtxRename()">
            <iconify-icon icon="solar:pen-2-linear" width="14"></iconify-icon>
            Renommer
        </button>
        <button class="tl-ctx-delete" @click="taskCtxDelete()">
            <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="14"></iconify-icon>
            Supprimer
        </button>
    </div>

    <!-- ════════ VIEW 3: FULL-SCREEN KANBAN ════════ -->
    <template x-if="kanbanList">
        <div class="tl-kb-fs">
            <!-- Header -->
            <div class="tl-kb-fs-header">
                <div class="tl-kb-breadcrumb">
                    <button class="tl-bc-back" @click="closeKanban()" title="Retour aux tâches">
                        <iconify-icon icon="solar:alt-arrow-left-linear" width="16"></iconify-icon>
                    </button>
                    <span class="tl-bc-record">
                        <iconify-icon icon="<%= entity.icon || 'solar:folder-bold-duotone' %>" width="16" style="color:<%= entity.color || '#4361ee' %>"></iconify-icon>
                        <span class="tl-bc-record-title"><%= record.title || 'Sans titre' %></span>
                    </span>
                    <iconify-icon icon="solar:alt-arrow-right-linear" width="10" class="tl-bc-sep"></iconify-icon>
                    <span class="tl-bc-current">
                        <div class="tl-card-icon" style="width:24px;height:24px;border-radius:7px" :style="'background:' + kanbanList.color + '12'">
                            <iconify-icon icon="solar:checklist-minimalistic-bold-duotone" width="13" :style="'color:' + kanbanList.color"></iconify-icon>
                        </div>
                        <span x-text="kanbanList.label"></span>
                        <span class="tl-bc-count" x-text="(kanbanList.tasks||[]).length + ' tâche' + ((kanbanList.tasks||[]).length !== 1 ? 's' : '')"></span>
                    </span>
                </div>
                <div class="tl-kb-fs-actions">
                    <!-- Status manager gear -->
                    <div style="position:relative">
                        <button type="button" class="tl-view-toggle" @click.stop="openStatusMgr(kanbanList._id)" title="Gérer les statuts">
                            <iconify-icon icon="solar:settings-linear" width="14"></iconify-icon>
                        </button>
                        <template x-if="statusMgrListId === kanbanList._id">
                            <div class="tl-status-mgr" @click.stop>
                                <div class="tl-status-mgr-title">Gérer les statuts</div>
                                <div class="tl-status-mgr-list" x-init="$nextTick(() => { if (typeof Sortable !== 'undefined') { if ($el._sortable) { try { $el._sortable.destroy(); } catch(e){} } $el._sortable = new Sortable($el, { draggable: '.tl-status-mgr-item', handle: '.tl-status-mgr-drag', animation: 180, ghostClass: 'tl-status-mgr-ghost', dragClass: 'tl-status-mgr-dragging', onEnd: (evt) => { if (evt.oldIndex === evt.newIndex) return; const parent = evt.from; const item = evt.item; if (evt.oldIndex < evt.newIndex) { parent.insertBefore(item, parent.children[evt.oldIndex]); } else { parent.insertBefore(item, parent.children[evt.oldIndex + 1]); } const moved = statusMgrStatuses.splice(evt.oldIndex, 1)[0]; statusMgrStatuses.splice(evt.newIndex, 0, moved); statusMgrStatuses.forEach((s, i) => s.order = i); } }); } })">
                                <template x-for="(ms, msIdx) in statusMgrStatuses" :key="ms.label + '_' + ms.color + '_' + msIdx">
                                    <div class="tl-status-mgr-item" :data-idx="msIdx">
                                        <iconify-icon icon="solar:hamburger-menu-linear" width="12" class="tl-status-mgr-drag"></iconify-icon>
                                        <div style="position:relative">
                                            <div class="tl-status-mgr-color" :style="'background:' + ms.color" @click.stop="statusMgrColorIdx = statusMgrColorIdx === msIdx ? null : msIdx"></div>
                                            <template x-if="statusMgrColorIdx === msIdx">
                                                <div class="tl-color-grid" @click.stop>
                                                    <template x-for="sc in statusColors" :key="sc">
                                                        <div class="tl-color-swatch" :class="{'active': ms.color === sc}" :style="'background:' + sc" @click="statusMgrSetColor(msIdx, sc)"></div>
                                                    </template>
                                                </div>
                                            </template>
                                        </div>
                                        <input type="text" class="tl-status-mgr-label" x-model="ms.label" @click.stop>
                                        <button type="button" class="tl-status-mgr-del" @click.stop="statusMgrRemoveStatus(msIdx)" title="Supprimer" :disabled="statusMgrStatuses.length <= 1">
                                            <iconify-icon icon="solar:close-circle-linear" width="13"></iconify-icon>
                                        </button>
                                    </div>
                                </template>
                                </div>
                                <button type="button" class="tl-status-mgr-add" @click.stop="statusMgrAddStatus()">
                                    <iconify-icon icon="solar:add-circle-linear" width="14"></iconify-icon>
                                    Ajouter un statut
                                </button>
                                <button type="button" class="tl-status-mgr-save" @click.stop="statusMgrSave()">
                                    Enregistrer
                                </button>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Full-width kanban board -->
            <div class="tl-kb-fs-board">
                <div class="tl-kanban" x-init="$nextTick(() => { initKanbanSortable($el, kanbanList); initDragScroll($el); })" x-effect="if(kanbanList) $nextTick(() => { initKanbanSortable($el, kanbanList); initDragScroll($el); })">
                    <template x-for="s in getStatuses(kanbanList)" :key="s.label">
                        <div class="tl-kb-col" :style="'border-top: 3px solid ' + s.color + ';background: linear-gradient(180deg, ' + s.color + (document.body.classList.contains('dark') ? '12' : '08') + ' 0%, ' + s.color + '03 40%, ' + (document.body.classList.contains('dark') ? '#0e1726' : '#f8fafc') + ' 100%)'">
                            <div class="tl-kb-hdr">
                                <span class="tl-kb-hdr-pill" :style="'background:' + s.color" x-text="s.label"></span>
                                <span class="tl-kb-count" x-text="(kanbanList.tasks||[]).filter(t => (t.status||'À faire') === s.label).length"></span>
                            </div>
                            <div class="tl-kb-cards" :data-status="s.label" :data-list-id="kanbanList._id">
                                <template x-for="kt in (kanbanList.tasks||[]).filter(t => (t.status||'À faire') === s.label)" :key="kt._id">
                                    <div class="tl-kb-card" :data-task-id="kt._id" @click="openDetail(kanbanList, kt)">
                                        <div class="tl-kb-card-title" x-text="kt.title"></div>
                                        <div class="tl-kb-card-status">
                                            <span class="tl-kb-card-status-dot" :style="'background:' + s.color"></span>
                                            <span class="tl-kb-card-status-pill" :style="'background:' + s.color + '15;color:' + s.color" x-text="s.label"></span>
                                        </div>
                                        <div class="tl-kb-card-footer">
                                            <div class="tl-kb-card-date">
                                                <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="17" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 9H21" stroke="currentColor" stroke-width="2"/></svg>
                                                <span x-text="kt.dueDate ? new Date(kt.dueDate).toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit',year:'2-digit'}) : (kt.createdAt ? new Date(kt.createdAt).toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit',year:'2-digit'}) : '—')"></span>
                                            </div>
                                            <div class="tl-kb-card-actions">
                                                <button type="button" @click.stop="openDetail(kanbanList, kt)" title="Modifier">
                                                    <iconify-icon icon="solar:pen-2-linear" width="14"></iconify-icon>
                                                </button>
                                                <button type="button" @click.stop="openDetail(kanbanList, kt)" title="Voir">
                                                    <iconify-icon icon="solar:eye-linear" width="14"></iconify-icon>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </template>
                                <div class="tl-kb-empty" x-show="(kanbanList.tasks||[]).filter(t => (t.status||'À faire') === s.label).length === 0">Aucun enregistrement</div>
                            </div>
                            <div class="tl-kb-footer">
                                <template x-if="kanbanAddStatus === s.label && kanbanAddListId === kanbanList._id">
                                    <input type="text" class="tl-kb-add-input"
                                           placeholder="Nom de la tâche..."
                                           x-model="kanbanNewTitle"
                                           x-init="kanbanNewTitle = normalizeDraftValue(kanbanNewTitle)"
                                           @input="kanbanNewTitle = normalizeDraftValue(kanbanNewTitle)"
                                           @keydown.enter="kanbanAddTask(kanbanList, s.label)"
                                           @keydown.escape="kanbanAddStatus = null; kanbanAddListId = null; kanbanNewTitle = ''"
                                           @click.outside="kanbanAddStatus = null; kanbanAddListId = null; kanbanNewTitle = ''">
                                </template>
                                <template x-if="kanbanAddStatus !== s.label || kanbanAddListId !== kanbanList._id">
                                    <button type="button" class="tl-kb-add-btn" @click.stop="kanbanAddStatus = s.label; kanbanAddListId = kanbanList._id; kanbanNewTitle = ''; $nextTick(() => { const inp = $el.closest('.tl-kb-footer').querySelector('.tl-kb-add-input'); if(inp) inp.focus(); })">
                                        + Ajouter
                                    </button>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </template>
    <% } %>

    <!-- Shared task detail modal. Keep task detail UI in one reusable partial. -->
</div>

<%- include('../../partials/task-detail-modal') %>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('recordTaskLists', () => ({
        lists: [],
        tasks: [],
        activeList: null,
        loading: true,
        loadingTasks: false,
        addingList: false,
        showDone: false,
        newListName: '',
        newTaskTitle: '',
        statusMenuId: null,
        editingListId: null,
        editListLabel: '',
        editingTaskId: null,
        editTaskTitle: '',
        ctxMenu: null,
        expandedListIds: [],
        previewNewTask: {},
        previewStatusMenu: null,
        previewStatusListId: null,
        previewStatusFlip: false,
        previewEditId: null,
        previewEditTitle: '',
        priorityExpanded: true,
        priorityNewTaskTitle: '',
        dayTaskOffset: 0,
        dayOpenExpanded: false,
        dayOpenLimit: 10,
        myListSavingId: null,
        taskCtx: null,
        kanbanListIds: [],
        kanbanList: null,
        kanbanAddStatus: null,
        kanbanAddListId: null,
        kanbanNewTitle: '',
        _currentUserId: '',
        statusMgrListId: null,
        statusMgrStatuses: [],
        statusMgrColorIdx: null,
        _kanbanInstances: {},
        _sortableInstances: {},
        _listSortable: null,
        _preListDragIds: [],
        ctxColors: ['#6366f1','#3b82f6','#06b6d4','#10b981','#22c55e','#f59e0b','#f97316','#ef4444','#ec4899','#8b5cf6','#6b7280'],
        statusColors: ['#9ca3af','#3b82f6','#f59e0b','#22c55e','#ef4444','#6366f1','#06b6d4','#10b981','#f97316','#ec4899','#8b5cf6','#dc2626','#0891b2','#7c3aed'],
        defaultStatuses: [
            { label: 'À faire',  color: '#9ca3af', order: 0 },
            { label: 'En cours', color: '#3b82f6', order: 1 },
            { label: 'En revue', color: '#f59e0b', order: 2 },
            { label: 'Terminé',  color: '#22c55e', order: 3 },
            { label: 'Bloqué',   color: '#ef4444', order: 4 },
        ],
        // Keep global statuses as fallback (used by view 2: tasks inside a list)
        statuses: [
            { label: 'À faire',  color: '#9ca3af' },
            { label: 'En cours', color: '#3b82f6' },
            { label: 'En revue', color: '#f59e0b' },
            { label: 'Terminé',  color: '#22c55e' },
            { label: 'Bloqué',   color: '#ef4444' },
        ],
        priorities: [
            { label: 'Aucune', color: '#cbd5e1', order: 0 },
            { label: 'Normal', color: '#3b82f6', order: 1 },
            { label: 'Important', color: '#f59e0b', order: 2 },
            { label: 'Urgent', color: '#ef4444', order: 3 },
        ],
        _accountNumber: '<%= account_number %>',
        _recordId: '<%= record._id %>',
        _recordTitle: <%- JSON.stringify(record.computedTitle || record.title || 'Record').replace(/</g, '\\u003C') %>,
        _entityName: <%- JSON.stringify(entity.name || entity.slug || 'Entité').replace(/</g, '\\u003C') %>,

        get activeTasks() {
            return this.tasks.filter(t => t.status !== 'Terminé');
        },
        get doneTasks() {
            return this.tasks.filter(t => t.status === 'Terminé');
        },
        get totalTasks() {
            return this.lists.reduce((sum, list) => sum + this.listTaskCount(list), 0);
        },
        get completedTasks() {
            return Math.min(this.totalTasks, this.lists.reduce((sum, list) => sum + this.listDoneCount(list), 0));
        },
        get remainingTasks() {
            return Math.max(0, this.totalTasks - this.completedTasks);
        },
        get completionPct() {
            return this.totalTasks ? Math.round((this.completedTasks / this.totalTasks) * 100) : 0;
        },
        get progressLegend() {
            return [
                { label: 'Terminées', color: '#22c55e', count: this.completedTasks },
                { label: 'Restantes', color: '#cbd5e1', count: this.remainingTasks }
            ];
        },
        get taskProgressConic() {
            return this.buildProgressConic(this.progressLegend, this.totalTasks);
        },
        get allTasksFlat() {
            return this.lists.flatMap(list => (list.tasks || []).map(task => {
                task._list = list;
                task._listId = list._id;
                task.taskListId = list._id;
                return task;
            }));
        },
        get daySourceTasks() {
            const byId = new Map();
            const add = (list, task) => {
                if (!list || !task?._id || byId.has(task._id)) return;
                task._list = list;
                task._listId = list._id;
                task.taskListId = list._id;
                byId.set(task._id, task);
            };
            (this.lists || []).forEach(list => {
                (list.tasks || []).forEach(task => add(list, task));
                (list.dayTasks || []).forEach(task => add(list, task));
            });
            return [...byId.values()];
        },
        get priorityTasks() {
            return this.dayTasks;
        },
        get dayTasks() {
            return this.daySourceTasks
                .filter(task => this.taskMatchesDay(task, this.dayTaskOffset))
                .sort((a, b) => {
                    if (a.status === 'Terminé' && b.status !== 'Terminé') return 1;
                    if (a.status !== 'Terminé' && b.status === 'Terminé') return -1;
                    const orderDiff = Number(a.order || 0) - Number(b.order || 0);
                    if (orderDiff !== 0) return orderDiff;
                    return this.sortTaskDate(a) - this.sortTaskDate(b);
                });
        },
        get dayTaskDoneCount() {
            return this.dayCompletedTasks.length;
        },
        get dayPanelTaskCount() {
            return this.dayOpenTasks.length + this.dayCompletedTasks.length;
        },
        get dayOpenTasks() {
            return this.dayTasks.filter(task => task.status !== 'Terminé');
        },
        get dayVisibleOpenTasks() {
            return this.dayOpenExpanded ? this.dayOpenTasks : this.dayOpenTasks.slice(0, this.dayOpenLimit);
        },
        get dayHiddenOpenCount() {
            return Math.max(0, this.dayOpenTasks.length - this.dayOpenLimit);
        },
        get dayCompletedTasks() {
            const selected = this.dayTaskDateKey(this.dayTaskOffset);
            return this.daySourceTasks
                .filter(task => {
                    if (!task || task.status !== 'Terminé') return false;
                    const completed = this.taskDateKey(task.completedAt || task.updatedAt);
                    if (completed) return completed === selected;
                    return this.taskMatchesDay(task, this.dayTaskOffset);
                })
                .sort((a, b) => new Date(b.completedAt || b.updatedAt || 0) - new Date(a.completedAt || a.updatedAt || 0));
        },
        get dayTaskOverdueCount() {
            return this.dayOpenTasks.filter(task => this.isTaskOverdue(task)).length;
        },
        get dayTaskCompletionPct() {
            const total = this.dayOpenTasks.length + this.dayCompletedTasks.length;
            return total ? Math.round((this.dayCompletedTasks.length / total) * 100) : 0;
        },
        get dayTaskTitle() {
            return 'Tâches du jour';
        },
        get dayTaskEmptyLabel() {
            return this.dayTaskOffset === 1 ? 'Aucune tâche prévue demain' : "Aucune tâche à faire aujourd'hui";
        },
        get dayTaskInputPlaceholder() {
            return this.dayTaskOffset === 1 ? 'Ajouter une tâche pour demain...' : "Ajouter une tâche pour aujourd'hui...";
        },
        get dayTaskDateLabel() {
            const d = this.dateForOffset(this.dayTaskOffset);
            return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: '2-digit' });
        },
        get dayCompletedTitle() {
            const label = this.dayTaskOffset === 1 ? 'demain' : "aujourd'hui";
            return `Terminées ${label} (${this.dayCompletedTasks.length})`;
        },
        get dayCompletedEmptyLabel() {
            return this.dayTaskOffset === 1 ? 'Aucune tâche terminée demain' : "Aucune tâche terminée aujourd'hui";
        },
        get priorityDoneCount() {
            return this.dayTaskDoneCount;
        },
        get priorityCompletionPct() {
            return this.dayTaskCompletionPct;
        },
        get legacyPriorityTasks() {
            return this.daySourceTasks
                .filter(task => !!task.isDayPriority)
                .sort((a, b) => this.sortTaskDate(a) - this.sortTaskDate(b));
        },
        get overdueTaskCount() {
            return this.allTasksFlat.filter(task => this.isTaskOverdue(task)).length;
        },
        get todayTaskCount() {
            return this.daySourceTasks.filter(task => this.taskMatchesDay(task, 0)).length;
        },
        get activeListsCount() {
            return this.lists.filter(list => this.listTaskCount(list) > 0).length;
        },
        get workloadBars() {
            const labels = ['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'];
            const counts = [0,0,0,0,0,0,0];
            this.allTasksFlat.forEach(task => {
                const date = task.dueDate ? new Date(task.dueDate) : null;
                if (!date || Number.isNaN(date.getTime())) return;
                counts[(date.getDay() + 6) % 7]++;
            });
            const max = Math.max(1, ...counts);
            return labels.map((label, index) => ({ label, height: Math.max(10, Math.round((counts[index] / max) * 92)) }));
        },
        get upcomingTasks() {
            return this.allTasksFlat
                .filter(task => task.status !== 'Terminé')
                .sort((a, b) => this.sortTaskDate(a) - this.sortTaskDate(b))
                .slice(0, 4);
        },

        normalizeDraftValue(value) {
            if (value === false || value === null || value === undefined) return '';
            const text = String(value);
            if (['false', 'null', 'undefined'].includes(text.trim().toLowerCase())) return '';
            return text;
        },

        cleanTaskTitle(value) {
            return this.normalizeDraftValue(value).trim();
        },

        displayTaskText(value, fallback = 'Sans titre') {
            return this.cleanTaskTitle(value) || fallback;
        },

        displayTaskListLabel(value) {
            const label = this.displayTaskText(value, 'À faire');
            const lower = label.toLowerCase();
            if (lower === 'général' || lower === 'tâches du jour' || lower === 'taches du jour') return 'À faire';
            return label;
        },

        defaultRecordListLabel() {
            const title = this.displayTaskText(this._recordTitle, '').trim();
            return title || 'Tâches du record';
        },

        legacyDefaultRecordListLabel() {
            const title = this.displayTaskText(this._recordTitle, '').trim();
            return title ? `Tâches ${title}` : 'Tâches du record';
        },

        taskListKey(value = '') {
            return String(value || '').trim().toLowerCase();
        },

        findTaskListByLabel(label = '') {
            const key = this.taskListKey(label);
            if (!key) return null;
            return this.lists.find(list => this.taskListKey(list.label) === key || this.taskListKey(list.rawLabel) === key) || null;
        },

        isLegacyDayPriorityLabel(value) {
            const lower = this.displayTaskText(value, '').toLowerCase();
            return lower === 'tâches du jour' || lower === 'taches du jour' || lower === 'priorité du jour' || lower === 'priorite du jour';
        },

        listTaskCount(list = {}) {
            const count = Number(list.count);
            if (Number.isFinite(count)) return Math.max(0, count);
            return Array.isArray(list.tasks) ? list.tasks.length : 0;
        },

        listDoneCount(list = {}) {
            const doneCount = Number(list.doneCount);
            if (Number.isFinite(doneCount)) return Math.min(this.listTaskCount(list), Math.max(0, doneCount));
            return Array.isArray(list.tasks) ? list.tasks.filter(t => t.status === 'Terminé').length : 0;
        },

        buildProgressConic(items, total) {
            if (!total) return '#e2e8f0 0deg 360deg';
            let angle = 0;
            const parts = [];
            items.forEach(item => {
                if (!item.count) return;
                const nextAngle = angle + (item.count / total) * 360;
                parts.push(`${item.color} ${angle}deg ${nextAngle}deg`);
                angle = nextAngle;
            });
            if (angle < 360) parts.push(`#e2e8f0 ${angle}deg 360deg`);
            return parts.join(', ');
        },

        isTaskOverdue(task = {}) {
            if (task.status === 'Terminé' || !task.dueDate) return false;
            const due = new Date(task.dueDate);
            if (Number.isNaN(due.getTime())) return false;
            due.setHours(23, 59, 59, 999);
            return due < new Date();
        },

        isTaskToday(task = {}) {
            if (!task.dueDate) return false;
            const due = new Date(task.dueDate);
            if (Number.isNaN(due.getTime())) return false;
            const now = new Date();
            return due.getFullYear() === now.getFullYear()
                && due.getMonth() === now.getMonth()
                && due.getDate() === now.getDate();
        },

        async focusQuickAdd() {
            await this.ensureTaskList(this.defaultRecordListLabel(), { isDefault: true });
            const target = this.getDefaultTaskList() || this.lists[0];
            if (!target) return;
            if (!this.expandedListIds.includes(target._id)) this.expandedListIds.push(target._id);
            this.$nextTick(() => {
                const card = this.$el.querySelector(`.tl-card[data-list-id="${target._id}"]`);
                const input = card?.querySelector('.tl-record-add input, .tl-preview-add input');
                if (input) input.focus();
            });
        },

        openDefaultKanban() {
            const target = this.lists.find(list => this.listTaskCount(list) > 0) || this.lists[0];
            if (target) this.openKanban(target);
        },

        getDefaultTaskList() {
            return this.findTaskListByLabel(this.defaultRecordListLabel())
                || this.lists.find(list => !!list.isDefault)
                || this.findTaskListByLabel(this.legacyDefaultRecordListLabel())
                || this.findTaskListByLabel('À faire')
                || null;
        },

        async ensureTaskList(label = 'Liste sans nom', options = {}) {
            const desiredLabel = this.cleanTaskTitle(label) || this.defaultRecordListLabel();
            if (options.isDefault === true) {
                const exact = this.findTaskListByLabel(desiredLabel);
                if (exact) {
                    if (exact.isDefault) return exact;
                    return this.updateTaskListConfig(exact, { label: desiredLabel, isDefault: true });
                }
                const legacy = this.findTaskListByLabel(this.legacyDefaultRecordListLabel()) || this.findTaskListByLabel('À faire');
                if (legacy) return this.updateTaskListConfig(legacy, { label: desiredLabel, isDefault: true });
            }
            const existing = this.findTaskListByLabel(desiredLabel);
            if (existing) return existing;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/record/${this._recordId}/task-lists`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ label: desiredLabel, isDefault: options.isDefault === true })
                });
                const data = await res.json();
                if (data.success && data.list) {
                    const newList = this.normalizeList(data.list);
                    if (newList.isDefault) this.lists = this.lists.map(item => ({ ...item, isDefault: false }));
                    this.lists.push(newList);
                    return newList;
                }
            } catch (e) { console.error('[TaskLists] Ensure list error:', e); }
            return null;
        },

        async updateTaskListConfig(list = {}, payload = {}) {
            const id = String(list._id || '');
            if (!id) return list;
            const body = {
                label: payload.label || list.rawLabel || list.label || this.defaultRecordListLabel(),
                color: payload.color || list.color || '#6366f1',
                icon: payload.icon || list.icon || 'solar:checklist-bold-duotone',
                viewMode: payload.viewMode || list.viewMode || 'kanban',
                tags: Array.isArray(payload.tags) ? payload.tags : (Array.isArray(list.tags) ? list.tags : []),
                displayOptions: payload.displayOptions || list.displayOptions || undefined,
                isDefault: payload.isDefault === true || list.isDefault === true
            };
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(body)
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false || !data.list) throw new Error(data.error || 'Mise à jour de liste impossible');
                const updated = this.normalizeList({ ...list, ...data.list, tasks: list.tasks || [] });
                this.lists = this.lists.map(item => {
                    if (String(item._id || '') === id) return updated;
                    return updated.isDefault ? { ...item, isDefault: false } : item;
                });
                return updated;
            } catch (e) {
                console.error('[TaskLists] Update list config error:', e);
                return list;
            }
        },

        normalizeTagOptions(options = []) {
            const seen = new Set();
            return (Array.isArray(options) ? options : [])
                .map((item, index) => {
                    const label = String(item?.label || item || '').trim();
                    return {
                        label,
                        color: item?.color || this.statusColors[index % this.statusColors.length] || '#6366f1',
                        order: Number.isFinite(Number(item?.order)) ? Number(item.order) : index
                    };
                })
                .filter(item => {
                    const key = item.label.toLowerCase();
                    if (!item.label || seen.has(key)) return false;
                    seen.add(key);
                    return true;
                })
                .sort((a, b) => a.order - b.order);
        },

        normalizeTaskTags(tags = [], options = []) {
            const optionByLabel = new Map(this.normalizeTagOptions(options)
                .map(option => [option.label.toLowerCase(), option]));
            const seen = new Set();
            return (Array.isArray(tags) ? tags : [])
                .map((item, index) => {
                    const label = String(item?.label || item || '').trim();
                    const option = optionByLabel.get(label.toLowerCase());
                    return {
                        label,
                        color: item?.color || option?.color || '#6366f1',
                        order: Number.isFinite(Number(item?.order)) ? Number(item.order) : (option?.order ?? index)
                    };
                })
                .filter(item => {
                    const key = item.label.toLowerCase();
                    if (!item.label || seen.has(key)) return false;
                    seen.add(key);
                    return true;
                })
                .sort((a, b) => a.order - b.order);
        },

        normalizeTask(task = {}) {
            const tagOptions = this.normalizeTagOptions(task.tagOptions || []);
            return {
                ...task,
                title: this.displayTaskText(task.title),
                description: typeof task.description === 'string' ? task.description : '',
                status: typeof task.status === 'string' && task.status.trim() ? task.status : 'À faire',
                statusColor: typeof task.statusColor === 'string' && task.statusColor ? task.statusColor : this.getStatusColor(task.status),
                priority: typeof task.priority === 'string' && task.priority ? task.priority : 'Aucune',
                priorityColor: typeof task.priorityColor === 'string' ? task.priorityColor : '',
                isDayPriority: !!task.isDayPriority,
                taskListId: task.taskListId ? String(task.taskListId) : '',
                assignedTo: typeof task.assignedTo === 'string' ? task.assignedTo : '',
                tags: this.normalizeTaskTags(task.tags || [], tagOptions),
                tagOptions,
                attachments: Array.isArray(task.attachments) ? task.attachments : []
            };
        },

        normalizeList(list = {}) {
            const id = String(list._id || '');
            if (id && this.previewNewTask[id] === undefined) this.previewNewTask[id] = '';
            const legacyDayPriority = this.isLegacyDayPriorityLabel(list.rawLabel || list.label);
            const label = this.displayTaskListLabel(list.rawLabel || list.label);
            const listTags = this.normalizeTagOptions(list.tags || []);
            return {
                ...list,
                _id: id,
                label,
                rawLabel: list.rawLabel || list.label || label,
                isLegacyDayPriorityList: legacyDayPriority,
                contextType: list.contextType || 'record',
                isDefault: !!list.isDefault,
                showInMyLists: !!list.showInMyLists,
                myListOrder: Number(list.myListOrder) || 0,
                color: typeof list.color === 'string' && list.color ? list.color : '#6366f1',
                priorities: Array.isArray(list.priorities) && list.priorities.length ? list.priorities : this.priorities,
                tags: listTags,
                tasksLimit: Number.isFinite(Number(list.tasksLimit)) ? Number(list.tasksLimit) : 0,
                tasksLoadedCount: Number.isFinite(Number(list.tasksLoadedCount)) ? Number(list.tasksLoadedCount) : ((list.tasks || []).length),
                hasMoreTasks: list.hasMoreTasks === true || (Number(list.count || 0) > (list.tasks || []).length),
                remainingTasks: Number.isFinite(Number(list.remainingTasks)) ? Math.max(0, Number(list.remainingTasks)) : Math.max(0, Number(list.count || 0) - (list.tasks || []).length),
                loadingAllTasks: false,
                allTasksLoaded: list.allTasksLoaded === true,
                tasks: (list.tasks || []).map(task => {
                    const normalized = this.normalizeTask({ ...task, taskListId: id, tagOptions: task.tagOptions || listTags });
                    if (legacyDayPriority) normalized.isDayPriority = true;
                    return normalized;
                }),
                dayTasks: (list.dayTasks || []).map(task => {
                    const normalized = this.normalizeTask({ ...task, taskListId: id, tagOptions: task.tagOptions || listTags });
                    if (legacyDayPriority) normalized.isDayPriority = true;
                    return normalized;
                })
            };
        },

        listCompletionPct(list = {}) {
            const total = this.listTaskCount(list);
            return total ? Math.round((this.listDoneCount(list) / total) * 100) : 0;
        },

        setDayTaskOffset(offset = 0) {
            this.dayTaskOffset = Number(offset) === 1 ? 1 : 0;
            this.dayOpenExpanded = false;
            this.priorityExpanded = true;
            this.previewStatusMenu = null;
            this.previewStatusListId = null;
        },

        dateForOffset(offset = 0) {
            const d = new Date();
            d.setHours(12, 0, 0, 0);
            d.setDate(d.getDate() + (Number(offset) || 0));
            return d;
        },

        taskDateKey(value) {
            if (!value) return '';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '';
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${y}-${m}-${day}`;
        },

        dayTaskDateKey(offset = this.dayTaskOffset) {
            return this.taskDateKey(this.dateForOffset(offset));
        },

        taskMatchesDay(task = {}, offset = this.dayTaskOffset) {
            const selected = this.dayTaskDateKey(offset);
            if (selected && Number(offset) === 0 && task.isDayPriority === true) return true;
            const scheduled = this.taskDateKey(task.dueDate || task.startDate);
            if (scheduled) return scheduled === selected;
            return false;
        },

        sortTaskDate(task = {}) {
            const d = task.dueDate ? new Date(task.dueDate) : new Date(task.createdAt || Date.now());
            return Number.isNaN(d.getTime()) ? Date.now() : d.getTime();
        },

        formatTaskDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return '—';
            return d.toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit', year:'2-digit' });
        },

        taskAssigneeLabel(task = {}) {
            return this.cleanTaskTitle(task.assignedTo) || 'Moi';
        },

        taskAssigneeInitials(task = {}) {
            return this.taskAssigneeLabel(task)
                .split(' ')
                .filter(Boolean)
                .map(part => part[0])
                .join('')
                .slice(0, 2)
                .toUpperCase();
        },

        priorityStyle(priority) {
            const map = {
                Urgent: ['#fee2e2', '#ef4444'],
                Important: ['#fff7ed', '#f59e0b'],
                Normal: ['#eff6ff', '#3b82f6'],
                Urgente: ['#fee2e2', '#dc2626'],
                Haute: ['#fef2f2', '#ef4444'],
                Moyenne: ['#fff7ed', '#f97316'],
                Basse: ['#eff6ff', '#3b82f6'],
                Aucune: ['#f1f5f9', '#64748b']
            };
            const [bg, color] = map[priority || 'Aucune'] || map.Aucune;
            return `background:${bg};color:${color}`;
        },

        statusPillStyle(status, color) {
            const base = color || this.getStatusColor(status || 'À faire');
            return `background:${base}15;color:${base}`;
        },

        taskAccent(task = {}, list = {}) {
            if (this.isTaskOverdue(task)) return '#ef4444';
            if (['Urgent', 'Haute', 'Urgente'].includes(task.priority)) return '#ef4444';
            if (['Important', 'Moyenne'].includes(task.priority)) return '#f59e0b';
            if (['Normal', 'Basse'].includes(task.priority)) return '#3b82f6';
            if (task.status === 'Terminé') return '#10b981';
            return list.color || task.statusColor || '#6366f1';
        },

        colorSoft(color) {
            const hex = color || '#6366f1';
            return String(hex).startsWith('#') ? hex + '16' : 'rgba(99,102,241,.09)';
        },

        resetDraftInputs() {
            this.newListName = '';
            this.newTaskTitle = '';
            this.kanbanNewTitle = '';
            this.priorityNewTaskTitle = '';
            this.addingList = false;
            Object.keys(this.previewNewTask || {}).forEach(key => { this.previewNewTask[key] = ''; });
        },

        async init() {
            this.resetDraftInputs();
            this.$nextTick(() => this.resetDraftInputs());
            // Get current user ID for chat bubble alignment
            const userEl = document.querySelector('[data-user-id]');
            if (userEl) this._currentUserId = userEl.dataset.userId || '';
            window.addEventListener('task-priorities-updated', (e) => {
                const priorities = Array.isArray(e.detail?.priorities) ? e.detail.priorities : [];
                if (!priorities.length) return;
                this.priorities = priorities;
                this.lists = (this.lists || []).map(list => ({ ...list, priorities }));
            });
            await this.loadLists();
            // Auto-open specific task if coming from chat link (?openTask=taskId)
            const params = new URLSearchParams(window.location.search);
            const openTaskId = params.get('openTask');
            if (openTaskId) {
                let openedTask = false;
                // Find the task across all lists
                for (const list of this.lists) {
                    const task = (list.tasks || []).find(t => t._id === openTaskId);
                    if (task) {
                        this.openDetail(list, task);
                        openedTask = true;
                        break;
                    }
                }
                if (!openedTask) {
                    try {
                        const res = await fetch(`/account/${this._accountNumber}/api/record-tasks/${openTaskId}`, { credentials: 'include' });
                        const data = await res.json().catch(() => ({}));
                        if (res.ok && data.success !== false && data.task) {
                            let list = this.lists.find(l => l._id === data.task.taskListId);
                            if (!list) {
                                list = this.normalizeList({ _id: data.task.taskListId, label: data.task.listLabel || 'À faire', tasks: [data.task], statuses: data.task.statuses || this.defaultStatuses });
                                this.lists.push(list);
                            }
                            this.openDetail(list, this.normalizeTask(data.task));
                            openedTask = true;
                        }
                    } catch (err) {
                        console.error('[TaskLists] openTask fallback error:', err);
                    }
                }
                if (openedTask) window.history.replaceState({}, '', window.location.pathname);
            }
            if (!openTaskId) {
                const openKanbanListId = params.get('kanbanList');
                const openListId = params.get('list');
                if (openKanbanListId) {
                    const list = this.lists.find(item => item._id === openKanbanListId);
                    if (list) this.openKanban(list);
                } else if (openListId) {
                    const list = this.lists.find(item => item._id === openListId);
                    if (list) this.openList(list);
                }
            }
            // Listen for cross-tab task detail opens (e.g. from chat)
            window.addEventListener('open-task-detail', async (e) => {
                const taskId = e.detail?.taskId;
                if (!taskId) return;
                // Try to find in locally loaded lists first
                for (const list of this.lists) {
                    const task = (list.tasks || []).find(t => t._id === taskId);
                    if (task) {
                        this.openDetail(list, task);
                        return;
                    }
                }
                // Fallback: fetch the task directly from API (useful on non-tasks tabs)
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/record-tasks/${taskId}`, { credentials: 'include' });
                    const data = await res.json();
                    if (data.success && data.task) {
                        // Find or create a synthetic list reference
                        let list = this.lists.find(l => l._id === data.task.taskListId);
                        if (!list) {
                            list = this.normalizeList({ _id: data.task.taskListId, label: 'À faire', tasks: [data.task], statuses: this.defaultStatuses });
                        }
                        this.openDetail(list, this.normalizeTask(data.task));
                    }
                } catch (err) { console.error('[TaskLists] Fallback open-task-detail error:', err); }
            });
        },

        // Helper: get color for a status/priority label from current list's statuses
        getStatusColor(statusLabel) {
            if (!statusLabel) return '#9ca3af';
            const list = this.kanbanList || null;
            if (list) {
                const found = this.lists.find(l => l._id === list._id);
                const listStatuses = (found && found.statuses) || (list.statuses) || this.defaultStatuses;
                const s = listStatuses.find(s => s.label === statusLabel);
                if (s) return s.color;
            }
            // Fallback: priority colors
            const prio = { 'Aucune': '#9ca3af', 'Normal': '#3b82f6', 'Important': '#f59e0b', 'Urgent': '#ef4444', 'Basse': '#3b82f6', 'Moyenne': '#f59e0b', 'Haute': '#ef4444', 'Urgente': '#dc2626' };
            return prio[statusLabel] || '#9ca3af';
        },

        // Helper: get color for priority label
        getPriorityColor(priorityLabel) {
            const list = this.kanbanList || null;
            const found = list ? this.lists.find(l => l._id === list._id) : null;
            const source = (found?.priorities && found.priorities.length)
                ? found.priorities
                : this.priorities;
            const p = source.find(p => p.label === priorityLabel);
            return p ? p.color : '';
        },

        // Helper: get statuses for a specific list (kanban)
        getStatuses(list) {
            return (list && list.statuses && list.statuses.length > 0) ? list.statuses : this.defaultStatuses;
        },

        // ─── Status Manager ───
        openStatusMgr(listId) {
            if (this.statusMgrListId === listId) {
                this.statusMgrListId = null;
                return;
            }
            const list = this.lists.find(l => l._id === listId);
            const statuses = (list && list.statuses && list.statuses.length > 0) ? list.statuses : this.defaultStatuses;
            this.statusMgrStatuses = JSON.parse(JSON.stringify(statuses));
            this.statusMgrListId = listId;
            this.statusMgrColorIdx = null;
        },

        statusMgrAddStatus() {
            this.statusMgrStatuses.push({
                label: 'Nouveau statut',
                color: '#6366f1',
                order: this.statusMgrStatuses.length
            });
        },

        statusMgrRemoveStatus(idx) {
            if (this.statusMgrStatuses.length <= 1) return;
            this.statusMgrStatuses.splice(idx, 1);
            this.statusMgrStatuses.forEach((s, i) => s.order = i);
        },

        statusMgrSetColor(idx, color) {
            this.statusMgrStatuses[idx].color = color;
            this.statusMgrColorIdx = null;
        },

        async statusMgrSave() {
            if (!this.statusMgrListId) return;
            const statuses = this.statusMgrStatuses.map((s, i) => ({
                label: s.label.trim() || 'Sans nom',
                color: s.color,
                order: i
            }));
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${this.statusMgrListId}/statuses`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ statuses })
                });
                const data = await res.json();
                if (data.success) {
                    const list = this.lists.find(l => l._id === this.statusMgrListId);
                    if (list) list.statuses = data.statuses || statuses;
                    this.statusMgrListId = null;
                }
            } catch (e) { console.error('[TaskLists] Save statuses error:', e); }
        },

        async loadLists() {
            this.loading = true;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/record/${this._recordId}/task-lists`, { credentials: 'include' });
                const data = await res.json();
                if (data.success) {
                    if (Array.isArray(data.priorities) && data.priorities.length) {
                        this.priorities = data.priorities;
                    }
                    this.lists = (data.lists || []).map(list => this.normalizeList(list));
                    await this.ensureTaskList(this.defaultRecordListLabel(), { isDefault: true });
                    await this.refreshDayTasksForLists();
                    if (this.lists.length > 0) {
                        this.priorityExpanded = true;
                        this.expandedListIds = [];
                    }
                }
            } catch (e) { console.error('[TaskLists] Load error:', e); }
            this.loading = false;
        },

        async refreshDayTasksForLists() {
            const targets = (this.lists || []).filter(list => {
                if (!list?._id) return false;
                if (list.hasMoreTasks === true) return true;
                return Number(list.count || 0) > (list.tasks || []).length;
            });
            if (!targets.length) return;
            await Promise.all(targets.map(async list => {
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${list._id}/tasks?scope=day`, { credentials: 'include' });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok || data.success === false || !Array.isArray(data.tasks)) throw new Error(data.error || 'Chargement des tâches du jour impossible');
                    const tagOptions = this.normalizeTagOptions(list.tags || []);
                    list.dayTasks = data.tasks.map(task => this.normalizeTask({ ...task, taskListId: list._id, tagOptions: task.tagOptions || tagOptions }));
                } catch (e) {
                    console.error('[TaskLists] Day tasks hydrate error:', e);
                }
            }));
        },

        async addList() {
            const label = this.cleanTaskTitle(this.newListName);
            this.newListName = label;
            if (!label) return;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/record/${this._recordId}/task-lists`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ label })
                });
                const data = await res.json();
                if (data.success && data.list) {
                    const newList = this.normalizeList(data.list);
                    this.lists.push(newList);
                    if (newList._id && !this.expandedListIds.includes(newList._id)) this.expandedListIds.push(newList._id);
                    this.newListName = '';
                    this.addingList = false;
                }
            } catch (e) { console.error('[TaskLists] Create error:', e); }
        },

        async toggleMyList(list) {
            if (!list?._id || this.myListSavingId) return;
            const next = !list.showInMyLists;
            const previous = !!list.showInMyLists;
            this.myListSavingId = list._id;
            list.showInMyLists = next;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${list._id}/my-lists`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ enabled: next })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) throw new Error(data.error || 'Mise à jour impossible');
                if (data.list) {
                    list.showInMyLists = !!data.list.showInMyLists;
                    list.myListOrder = Number(data.list.myListOrder) || 0;
                    list.contextType = data.list.contextType || list.contextType || 'record';
                }
                if (window.showMessage) window.showMessage(next ? 'Liste ajoutée dans Mes listes' : 'Liste retirée de Mes listes', 'success');
            } catch (e) {
                list.showInMyLists = previous;
                console.error('[TaskLists] Toggle my list error:', e);
                if (window.showMessage) window.showMessage(e.message || 'Erreur', 'danger');
            } finally {
                this.myListSavingId = null;
            }
        },

        toggleExpand(listId) {
            const idx = this.expandedListIds.indexOf(listId);
            if (idx >= 0) { this.expandedListIds.splice(idx, 1); }
            else { this.expandedListIds.push(listId); }
            this.previewStatusMenu = null;
        },

        statusMenuKey(task, list, scope = 'list') {
            return [scope, list?._id || 'none', task?._id || 'none'].join(':');
        },

        isStatusMenuOpen(task, list, scope = 'list') {
            return this.previewStatusMenu === this.statusMenuKey(task, list, scope);
        },

        isSectionMenuOpen(list, scope = 'list') {
            if (!this.previewStatusMenu) return false;
            if (scope === 'priority') return this.previewStatusMenu.startsWith('priority:');
            return this.previewStatusMenu.startsWith(`list:${list?._id || 'none'}:`);
        },

        toggleStatusMenu(event, task, list, scope = 'list') {
            const key = this.statusMenuKey(task, list, scope);
            const open = this.previewStatusMenu !== key;
            this.previewStatusMenu = open ? key : null;
            this.previewStatusListId = open ? `${scope}:${list?._id || 'none'}` : null;
            this.previewStatusFlip = open ? event.clientY + 180 > window.innerHeight : false;
            this.taskCtx = null;
            this.ctxMenu = null;
        },

        initListSortable(el) {
            if (!el || typeof Sortable === 'undefined') return;
            if (this._listSortable?.el === el) return;
            if (this._listSortable) {
                try { this._listSortable.destroy(); } catch (e) {}
                this._listSortable = null;
            }

            const comp = this;
            this._listSortable = Sortable.create(el, {
                animation: 180,
                handle: '.tl-list-drag',
                draggable: '.tl-card',
                ghostClass: 'tl-list-ghost',
                chosenClass: 'tl-list-chosen',
                onStart() {
                    comp._preListDragIds = comp.lists.map(list => list._id);
                },
                onEnd(evt) {
                    const oldIndex = evt.oldDraggableIndex ?? evt.oldIndex;
                    const newIndex = evt.newDraggableIndex ?? evt.newIndex;
                    if (oldIndex === newIndex || oldIndex == null || newIndex == null) return;

                    const parent = evt.from;
                    const item = evt.item;
                    if (oldIndex < newIndex) parent.insertBefore(item, parent.children[oldIndex]);
                    else parent.insertBefore(item, parent.children[oldIndex + 1]);

                    const movedId = comp._preListDragIds[oldIndex];
                    const fromIdx = comp.lists.findIndex(list => list._id === movedId);
                    if (fromIdx < 0) return;
                    const nextLists = [...comp.lists];
                    const [moved] = nextLists.splice(fromIdx, 1);
                    nextLists.splice(newIndex, 0, moved);
                    nextLists.forEach((list, idx) => { list.order = idx; });
                    comp.lists = nextLists;
                    comp._persistListOrder(nextLists);
                }
            });
            this._listSortable.el = el;
        },

        async _persistListOrder(lists) {
            try {
                await fetch(`/account/${this._accountNumber}/api/record/${this._recordId}/task-lists/reorder`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ listIds: lists.map(list => list._id) })
                });
            } catch (e) { console.error('[TaskLists] Reorder lists error:', e); }
        },

        async previewToggle(list, pt) {
            const isDone = pt.status === 'Terminé';
            const newStatus = isDone ? 'À faire' : 'Terminé';
            await this.previewSetStatus(list, pt, newStatus);
        },

        async previewSetStatus(list, pt, statusLabel) {
            this.previewStatusMenu = null;
            this.previewStatusListId = null;
            const statusColors = {
                'À faire': '#9ca3af', 'En cours': '#3b82f6',
                'En revue': '#f59e0b', 'Terminé': '#22c55e', 'Bloqué': '#ef4444'
            };
            const wasDone = pt.status === 'Terminé';
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/record-tasks/${pt._id}/status`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ status: statusLabel })
                });
                const data = await res.json();
                if (data.success) {
                    pt.status = data.status;
                    pt.statusColor = data.statusColor;
                    pt.completedAt = data.completedAt || data.task?.completedAt || null;
                    if (data.task) this.syncTaskFromModal(data.task);
                    const isDone = pt.status === 'Terminé';
                    if (list && wasDone !== isDone) {
                        list.doneCount = Math.max(0, (Number(list.doneCount) || 0) + (isDone ? 1 : -1));
                    }
                }
            } catch (e) { console.error('[TaskLists] Preview status error:', e); }
        },

        async previewAddTask(list, options = {}) {
            const title = this.cleanTaskTitle(this.previewNewTask[list._id]);
            this.previewNewTask[list._id] = title;
            if (!title) return;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${list._id}/tasks`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        title,
                        isDayPriority: !!options.isDayPriority,
                        startDate: options.startDate || undefined,
                        dueDate: options.dueDate || undefined
                    })
                });
                const data = await res.json();
                if (data.success && data.task) {
                    if (!list.tasks) list.tasks = [];
                    list.tasks.unshift(this.normalizeTask({ ...data.task, taskListId: list._id }));
                    list.count = (list.count || 0) + 1;
                    this.previewNewTask[list._id] = '';
                }
            } catch (e) { console.error('[TaskLists] Preview add error:', e); }
        },

        async loadAllTasks(list = {}) {
            const listId = String(list._id || '');
            if (!listId || list.loadingAllTasks) return;
            list.loadingAllTasks = true;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${listId}/tasks`, { credentials: 'include' });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false || !Array.isArray(data.tasks)) throw new Error(data.error || 'Chargement impossible');
                const tagOptions = this.normalizeTagOptions(list.tags || []);
                list.tasks = data.tasks.map(task => this.normalizeTask({ ...task, taskListId: listId, tagOptions: task.tagOptions || tagOptions }));
                list.count = list.tasks.length;
                list.doneCount = list.tasks.filter(task => task.status === 'Terminé').length;
                list.tasksLoadedCount = list.tasks.length;
                list.remainingTasks = 0;
                list.hasMoreTasks = false;
                list.allTasksLoaded = true;
                this.$nextTick(() => {
                    const container = this.$el.querySelector(`.sortable-tasks-container[data-list-id="${listId}"]`);
                    if (container) this.initPreviewSortable(container, list);
                });
            } catch (e) {
                console.error('[TaskLists] Load all tasks error:', e);
                window.showMessage && window.showMessage(e.message || 'Chargement impossible', 'danger');
            } finally {
                list.loadingAllTasks = false;
            }
        },

        collapseListTasks(list = {}) {
            const listId = String(list._id || '');
            if (!listId || !Array.isArray(list.tasks)) return;
            const limit = Math.max(1, Number(list.tasksLimit || 10));
            const total = Math.max(Number(list.count || 0), list.tasks.length);
            list.tasks = list.tasks.slice(0, limit);
            list.tasksLoadedCount = list.tasks.length;
            list.remainingTasks = Math.max(0, total - list.tasks.length);
            list.hasMoreTasks = list.remainingTasks > 0;
            list.allTasksLoaded = false;
            this.$nextTick(() => {
                const container = this.$el.querySelector(`.sortable-tasks-container[data-list-id="${listId}"]`);
                if (container) this.initPreviewSortable(container, list);
            });
        },

        async addPriorityTask() {
            const title = this.cleanTaskTitle(this.priorityNewTaskTitle);
            this.priorityNewTaskTitle = title;
            if (!title) return;
            const list = await this.ensureTaskList(this.defaultRecordListLabel(), { isDefault: true });
            if (!list) return;
            if (this.previewNewTask[list._id] === undefined) this.previewNewTask[list._id] = '';
            this.previewNewTask[list._id] = title;
            const selectedDate = this.dayTaskDateKey(this.dayTaskOffset);
            await this.previewAddTask(list, {
                isDayPriority: this.dayTaskOffset === 0,
                startDate: selectedDate,
                dueDate: selectedDate
            });
            this.priorityNewTaskTitle = '';
            this.priorityExpanded = true;
        },

        previewStartEdit(pt) {
            this.previewEditId = pt._id;
            this.previewEditTitle = pt.title;
            this.$nextTick(() => {
                const inp = this.$el.querySelector('.tl-preview-edit');
                if (inp) { inp.focus(); inp.select(); }
            });
        },

        async previewSaveTitle(pt) {
            if (!this.previewEditId) return;
            const newTitle = this.cleanTaskTitle(this.previewEditTitle);
            this.previewEditId = null;
            if (!newTitle || newTitle === pt.title) return;
            const oldTitle = pt.title;
            pt.title = newTitle;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/record-tasks/${pt._id}/rename`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ title: newTitle })
                });
                const data = await res.json();
                if (!data.success) pt.title = oldTitle;
            } catch (e) { pt.title = oldTitle; console.error('[TaskLists] Preview rename error:', e); }
        },

        openTaskCtx(e, list, pt) {
            const menuH = 80;
            const y = (e.clientY + menuH > window.innerHeight) ? e.clientY - menuH : e.clientY;
            this.taskCtx = { x: e.clientX, y, list, task: pt };
            this.ctxMenu = null;
            this.previewStatusMenu = null;
            this.previewStatusListId = null;
        },

        taskCtxRename() {
            if (!this.taskCtx) return;
            const pt = this.taskCtx.task;
            this.taskCtx = null;
            this.previewStartEdit(pt);
        },

        async taskCtxDelete() {
            if (!this.taskCtx) return;
            const { list, task } = this.taskCtx;
            this.taskCtx = null;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/record-tasks/${task._id}`, {
                    method: 'DELETE', credentials: 'include'
                });
                const data = await res.json();
                if (data.success) {
                    list.tasks = (list.tasks || []).filter(t => t._id !== task._id);
                    list.dayTasks = (list.dayTasks || []).filter(t => t._id !== task._id);
                    list.count = Math.max(0, (list.count || 1) - 1);
                    if (task.status === 'Terminé') list.doneCount = Math.max(0, (list.doneCount || 1) - 1);
                }
            } catch (e) { console.error('[TaskLists] Delete task error:', e); }
        },

        initPreviewSortable(el, list) {
            if (!el || !list?._id) return;
            const listId = list._id;

            // Don't re-init if already active on this container
            if (this._sortableInstances[listId]?.el === el) return;

            // Destroy previous instance if any
            if (this._sortableInstances[listId]) {
                this._sortableInstances[listId].destroy();
                delete this._sortableInstances[listId];
            }

            const comp = this;
            const instance = Sortable.create(el, {
                animation: 180,
                handle: '.tl-preview-drag',
                draggable: '.tl-record-row',
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                // DO NOT use fallbackOnBody or forceFallback with Alpine x-for
                onStart() {
                    comp._preDragKeys = (list.tasks || []).map(t => t._id);
                },
                onEnd(evt) {
                    const { oldDraggableIndex, newDraggableIndex } = evt;
                    if (oldDraggableIndex === newDraggableIndex) return;

                    // 1. Compute new order from snapshot
                    const keys = [...comp._preDragKeys];
                    const fromId = keys[oldDraggableIndex];
                    const tasks = list.tasks || [];
                    const fromIdx = tasks.findIndex(t => t._id === fromId);
                    if (fromIdx < 0) return;

                    const newTasks = [...tasks];
                    const [moved] = newTasks.splice(fromIdx, 1);
                    // Insert at new position mapped back to full array
                    const targetId = keys[newDraggableIndex];
                    let toIdx = newTasks.findIndex(t => t._id === targetId);
                    if (toIdx < 0) toIdx = newTasks.length;
                    newTasks.splice(toIdx, 0, moved);

                    // 2. Destroy Sortable to release DOM refs
                    instance.destroy();
                    delete comp._sortableInstances[listId];

                    // 3. FLUSH: clear array so Alpine destroys all x-for nodes
                    list.tasks = [];

                    // 4. REBUILD: next tick, set new order
                    comp.$nextTick(() => {
                        list.tasks = newTasks;
                        // 5. RE-INIT: double nextTick for stable DOM
                        comp.$nextTick(() => {
                            const newEl = document.querySelector(`.sortable-tasks-container[data-list-id="${listId}"]`);
                            if (newEl) comp.initPreviewSortable(newEl, list);
                        });
                        // 6. Persist order to API
                        comp._persistTaskOrder(listId, newTasks);
                    });
                }
            });
            instance.el = el;
            this._sortableInstances[listId] = instance;
        },

        async _persistTaskOrder(listId, tasks) {
            try {
                await fetch(`/account/${this._accountNumber}/api/task-lists/${listId}/reorder`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ taskIds: tasks.map(t => t._id) })
                });
            } catch (e) { console.error('[TaskLists] Reorder error:', e); }
        },

        async openList(list) {
            this.activeList = list;
            this.loadingTasks = true;
            this.showDone = false;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${list._id}/tasks`, { credentials: 'include' });
                const data = await res.json();
                if (data.success) this.tasks = (data.tasks || []).map(task => this.normalizeTask(task));
            } catch (e) { console.error('[TaskLists] Load tasks error:', e); }
            this.loadingTasks = false;
        },

        async addTask() {
            const title = this.cleanTaskTitle(this.newTaskTitle);
            this.newTaskTitle = title;
            if (!title || !this.activeList) return;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${this.activeList._id}/tasks`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ title })
                });
                const data = await res.json();
                if (data.success && data.task) {
                    this.tasks.unshift(this.normalizeTask(data.task));
                    this.newTaskTitle = '';
                    this.activeList.count = (this.activeList.count || 0) + 1;
                }
            } catch (e) { console.error('[TaskLists] Add task error:', e); }
        },

        async toggleDone(task) {
            const isDone = task.status === 'Terminé';
            const newStatus = isDone ? 'À faire' : 'Terminé';
            await this.setStatus(task, newStatus);
        },

        async setStatus(task, statusLabel) {
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/record-tasks/${task._id}/status`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ status: statusLabel })
                });
                const data = await res.json();
                if (data.success) {
                    task.status = data.status;
                    task.statusColor = data.statusColor;
                    if (this.activeList) {
                        this.activeList.doneCount = this.doneTasks.length;
                    }
                }
            } catch (e) { console.error('[TaskLists] Status error:', e); }
        },

        async deleteTask(taskId) {
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/record-tasks/${taskId}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const data = await res.json();
                if (data.success) {
                    const wasDone = this.tasks.find(t => t._id === taskId)?.status === 'Terminé';
                    this.tasks = this.tasks.filter(t => t._id !== taskId);
                    if (this.activeList) {
                        this.activeList.count = Math.max(0, (this.activeList.count || 0) - 1);
                        if (wasDone) this.activeList.doneCount = Math.max(0, (this.activeList.doneCount || 0) - 1);
                    }
                }
            } catch (e) { console.error('[TaskLists] Delete error:', e); }
        },

        startEditList(list) {
            this.editingListId = list._id;
            this.editListLabel = list.label;
            this.$nextTick(() => {
                const inp = this.$el.querySelector('.tl-card .tl-inline-edit');
                if (inp) { inp.focus(); inp.select(); }
            });
        },

        async saveListName(list) {
            if (!this.editingListId) return;
            const newLabel = this.cleanTaskTitle(this.editListLabel);
            this.editingListId = null;
            if (!newLabel || newLabel === list.label) return;
            const oldLabel = list.label;
            list.label = newLabel;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${list._id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ label: newLabel })
                });
                const data = await res.json();
                if (!data.success) list.label = oldLabel;
            } catch (e) { list.label = oldLabel; console.error('[TaskLists] Rename list error:', e); }
        },

        startEditTask(task) {
            this.editingTaskId = task._id;
            this.editTaskTitle = task.title;
            this.$nextTick(() => {
                const inp = this.$el.querySelector('.tl-task .tl-inline-edit');
                if (inp) { inp.focus(); inp.select(); }
            });
        },

        async saveTaskName(task) {
            if (!this.editingTaskId) return;
            const newTitle = this.cleanTaskTitle(this.editTaskTitle);
            this.editingTaskId = null;
            if (!newTitle || newTitle === task.title) return;
            const oldTitle = task.title;
            task.title = newTitle;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/record-tasks/${task._id}/rename`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ title: newTitle })
                });
                const data = await res.json();
                if (!data.success) task.title = oldTitle;
            } catch (e) { task.title = oldTitle; console.error('[TaskLists] Rename task error:', e); }
        },

        openCtx(e, type, target) {
            const menuH = type === 'list' ? 220 : 80;
            const y = (e.clientY + menuH > window.innerHeight) ? e.clientY - menuH : e.clientY;
            this.ctxMenu = { x: e.clientX, y, type, target };
            this.previewStatusMenu = null;
            this.previewStatusListId = null;
        },

        ctxRename() {
            const { type, target } = this.ctxMenu;
            this.ctxMenu = null;
            if (type === 'list') {
                this.editingListId = target._id;
                this.editListLabel = target.label;
                this.$nextTick(() => {
                    const inp = this.$el.querySelector('.tl-card .tl-inline-edit');
                    if (inp) { inp.focus(); inp.select(); }
                });
            } else {
                this.editingTaskId = target._id;
                this.editTaskTitle = target.title;
                this.$nextTick(() => {
                    const inp = this.$el.querySelector('.tl-task .tl-inline-edit');
                    if (inp) { inp.focus(); inp.select(); }
                });
            }
        },

        async ctxChangeColor(color) {
            const target = this.ctxMenu?.target;
            if (!target) return;
            const oldColor = target.color;
            target.color = color;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${target._id}/color`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ color })
                });
                const data = await res.json();
                if (!data.success) target.color = oldColor;
            } catch (e) { target.color = oldColor; console.error('[TaskLists] Color error:', e); }
            this.ctxMenu = null;
        },

        async ctxDelete() {
            const { type, target } = this.ctxMenu;
            this.ctxMenu = null;
            if (type === 'task') {
                await this.deleteTask(target._id);
            } else {
                await this.deleteList(target._id);
            }
        },

        async deleteList(listId) {
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${listId}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const data = await res.json();
                if (data.success) {
                    this.lists = this.lists.filter(l => l._id !== listId);
                }
            } catch (e) { console.error('[TaskLists] Delete list error:', e); }
        },

        // ─── Kanban open/close (full-screen) ───
        async openKanban(list) {
            // Ensure tasks are loaded
            if (!list.tasks || list.tasks.length === 0) {
                try {
                    const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${list._id}/tasks`, { credentials: 'include' });
                    const data = await res.json();
                    if (data.success) list.tasks = (data.tasks || []).map(task => this.normalizeTask(task));
                } catch (e) { console.error('[TaskLists] Load tasks for kanban:', e); }
            }
            // Force Alpine reactivity: clear first, then set on nextTick
            // (assigning an existing reactive object after await can fail detection)
            this.kanbanList = null;
            this.$nextTick(() => {
                this.kanbanList = list;
                this.kanbanAddStatus = null;
                this.kanbanAddListId = null;
                this.kanbanNewTitle = '';
            });
        },
        closeKanban() {
            // Destroy kanban sortable instances
            if (this.kanbanList) {
                const list = this.kanbanList;
                this.getStatuses(list).forEach(s => {
                    const key = list._id + '_' + s.label;
                    if (this._kanbanInstances[key]) {
                        this._kanbanInstances[key].destroy();
                        delete this._kanbanInstances[key];
                    }
                });
            }
            this.kanbanList = null;
            this.statusMgrListId = null;
        },

        async kanbanAddTask(list, status) {
            const title = this.cleanTaskTitle(this.kanbanNewTitle);
            this.kanbanNewTitle = title;
            if (!title) return;
            try {
                const res = await fetch(`/account/${this._accountNumber}/api/task-lists/${list._id}/tasks`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ title, status })
                });
                const data = await res.json();
                if (data.success && data.task) {
                    if (!list.tasks) list.tasks = [];
                    list.tasks.push(this.normalizeTask(data.task));
                    list.count = (list.count || 0) + 1;
                    if (status === 'Terminé') list.doneCount = (list.doneCount || 0) + 1;
                    this.kanbanNewTitle = '';
                }
            } catch (e) { console.error('[TaskLists] Kanban add error:', e); }
        },

        initKanbanSortable(kanbanEl, list) {
            if (!kanbanEl || !list?._id) return;
            const comp = this;
            this.$nextTick(() => {
                const cols = kanbanEl.querySelectorAll('.tl-kb-cards');
                cols.forEach(col => {
                    const status = col.dataset.status;
                    const key = list._id + '_' + status;
                    if (this._kanbanInstances[key]?.el === col) return;
                    if (this._kanbanInstances[key]) {
                        this._kanbanInstances[key].destroy();
                    }
                    const inst = Sortable.create(col, {
                        group: 'kanban-' + list._id,
                        animation: 180,
                        draggable: '.tl-kb-card',
                        ghostClass: 'sortable-ghost',
                        scroll: kanbanEl,
                        bubbleScroll: true,
                        scrollSensitivity: 60,
                        scrollSpeed: 12,
                        onEnd(evt) {
                            const taskId = evt.item.dataset.taskId;
                            const newStatus = evt.to.dataset.status;
                            const task = (list.tasks || []).find(t => t._id === taskId);
                            if (task && task.status !== newStatus) {
                                comp.previewSetStatus(list, task, newStatus);
                            }
                        }
                    });
                    inst.el = col;
                    comp._kanbanInstances[key] = inst;
                });
            });
        },

        // ─── Drag-to-scroll (ClickUp style, mouse + touch) ───
        initDragScroll(slider) {
            if (!slider || slider._dragScrollInit) return;
            slider._dragScrollInit = true;
            let isDown = false, startX = 0, scrollLeft = 0, moved = false;
            const THRESHOLD = 5; // px before we consider it a real drag

            // ── Mouse events ──
            slider.addEventListener('mousedown', (e) => {
                if (e.target.closest('.tl-kb-card') || e.target.closest('button') || e.target.closest('a') || e.target.closest('input') || e.target.closest('.tl-kb-add-input')) return;
                isDown = true; moved = false;
                startX = e.pageX - slider.offsetLeft;
                scrollLeft = slider.scrollLeft;
            });
            slider.addEventListener('mouseleave', () => {
                if (isDown) { isDown = false; slider.classList.remove('is-dragging'); }
            });
            slider.addEventListener('mouseup', () => {
                isDown = false; slider.classList.remove('is-dragging');
            });
            slider.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                const x = e.pageX - slider.offsetLeft;
                const walk = x - startX;
                if (!moved && Math.abs(walk) > THRESHOLD) {
                    moved = true; slider.classList.add('is-dragging');
                }
                if (moved) {
                    e.preventDefault();
                    slider.scrollLeft = scrollLeft - walk;
                }
            });

            // ── Touch events (tablet / mobile) ──
            let touchStartX = 0, touchScrollLeft = 0, touchMoved = false;
            slider.addEventListener('touchstart', (e) => {
                if (e.target.closest('.tl-kb-card') || e.target.closest('button') || e.target.closest('input')) return;
                touchStartX = e.touches[0].pageX - slider.offsetLeft;
                touchScrollLeft = slider.scrollLeft; touchMoved = false;
            }, { passive: true });
            slider.addEventListener('touchmove', (e) => {
                if (touchStartX === 0) return;
                const x = e.touches[0].pageX - slider.offsetLeft;
                const walk = x - touchStartX;
                if (!touchMoved && Math.abs(walk) > THRESHOLD) touchMoved = true;
                if (touchMoved) slider.scrollLeft = touchScrollLeft - walk;
            }, { passive: true });
            slider.addEventListener('touchend', () => { touchStartX = 0; touchMoved = false; });
        },

        // ─── Detail panel ───
        resolveTaskList(task, fallbackList = null) {
            const taskId = task?._id;
            if (fallbackList && (!taskId || (fallbackList.tasks || []).some(t => t._id === taskId))) return fallbackList;
            return this.lists.find(list => (list.tasks || []).some(t => t._id === taskId))
                || fallbackList
                || this.lists.find(list => list._id === task?.taskListId)
                || null;
        },

        taskListOptionsForModal() {
            return (this.lists || []).map((list, index) => ({
                _id: list._id,
                label: list.label,
                color: list.color,
                icon: list.icon || 'solar:list-check-bold-duotone',
                order: Number.isFinite(Number(list.order)) ? Number(list.order) : index
            }));
        },

        taskPayloadForModal(list, task) {
            const sourceList = this.resolveTaskList(task, list);
            const sourceTask = sourceList?.tasks?.find(t => t._id === task?._id) || task;
            const taskListId = sourceList?._id || sourceTask?.taskListId || '';
            return this.normalizeTask({
                ...sourceTask,
                taskListId,
                listLabel: sourceList?.label || sourceTask?.listLabel || 'Liste des tâches',
                listColor: sourceList?.color || sourceTask?.listColor || '#6366f1',
                listIcon: sourceList?.icon || sourceTask?.listIcon || 'solar:list-check-bold-duotone',
                statuses: this.getStatuses(sourceList),
                priorities: sourceList?.priorities || this.priorities,
                tagOptions: sourceTask?.tagOptions || sourceList?.tags || [],
                listOptions: this.taskListOptionsForModal(),
                publishToChatDefault: true
            });
        },

        recalcListStats(list) {
            if (!list) return;
            list.count = (list.tasks || []).length;
            list.doneCount = (list.tasks || []).filter(task => task.status === 'Terminé').length;
        },

        taskCompletedOnDay(task = {}, offset = 0) {
            if (!task || task.status !== 'Terminé') return false;
            const completed = this.taskDateKey(task.completedAt || task.updatedAt);
            return !!completed && completed === this.dayTaskDateKey(offset);
        },

        taskBelongsInDayCache(task = {}) {
            return this.taskMatchesDay(task, 0)
                || this.taskMatchesDay(task, 1)
                || this.taskCompletedOnDay(task, 0)
                || this.taskCompletedOnDay(task, 1);
        },

        syncDayTaskForList(list, task) {
            if (!list || !task?._id) return;
            if (!Array.isArray(list.dayTasks)) list.dayTasks = [];
            const idx = list.dayTasks.findIndex(item => item._id === task._id);
            if (this.taskBelongsInDayCache(task)) {
                const normalized = this.normalizeTask({
                    ...task,
                    taskListId: list._id,
                    tagOptions: task.tagOptions || list.tags || []
                });
                if (idx >= 0) list.dayTasks.splice(idx, 1, { ...list.dayTasks[idx], ...normalized });
                else list.dayTasks.unshift(normalized);
                return;
            }
            if (idx >= 0) list.dayTasks.splice(idx, 1);
        },

        removeTaskLocally(taskId) {
            const id = String(taskId || '');
            if (!id) return;
            this.lists.forEach(list => {
                const before = (list.tasks || []).length;
                list.tasks = (list.tasks || []).filter(task => task._id !== id);
                list.dayTasks = (list.dayTasks || []).filter(task => task._id !== id);
                if ((list.tasks || []).length !== before) this.recalcListStats(list);
            });
            this.tasks = (this.tasks || []).filter(task => task._id !== id);
        },

        syncTaskFromModal(taskData = {}) {
            if (!taskData?._id) return null;
            const targetListId = String(taskData.taskListId || '');
            let targetList = this.lists.find(list => list._id === targetListId)
                || this.lists.find(list => (list.tasks || []).some(task => task._id === taskData._id))
                || this.lists.find(list => (list.dayTasks || []).some(task => task._id === taskData._id))
                || null;
            const normalizedTask = this.normalizeTask({
                ...taskData,
                taskListId: targetList?._id || targetListId,
                tagOptions: taskData.tagOptions || targetList?.tags || []
            });

            this.lists.forEach(list => {
                if (targetList && list._id === targetList._id) return;
                const before = (list.tasks || []).length;
                list.tasks = (list.tasks || []).filter(task => task._id !== normalizedTask._id);
                list.dayTasks = (list.dayTasks || []).filter(task => task._id !== normalizedTask._id);
                if ((list.tasks || []).length !== before) this.recalcListStats(list);
            });

            if (targetList) {
                if (!targetList.tasks) targetList.tasks = [];
                const idx = targetList.tasks.findIndex(task => task._id === normalizedTask._id);
                if (idx >= 0) targetList.tasks.splice(idx, 1, { ...targetList.tasks[idx], ...normalizedTask });
                else if (!targetList.hasMoreTasks) targetList.tasks.unshift(normalizedTask);
                this.syncDayTaskForList(targetList, normalizedTask);
                if (!targetList.hasMoreTasks) this.recalcListStats(targetList);
            }

            const activeIdx = (this.tasks || []).findIndex(task => task._id === normalizedTask._id);
            if (this.activeList && normalizedTask.taskListId === this.activeList._id) {
                if (activeIdx >= 0) this.tasks.splice(activeIdx, 1, { ...this.tasks[activeIdx], ...normalizedTask });
                else this.tasks.unshift(normalizedTask);
            } else if (activeIdx >= 0) {
                this.tasks.splice(activeIdx, 1);
            }
            return normalizedTask;
        },

        handleTaskModalUpdate(taskId, field, value, updatedTask = {}) {
            const listId = String(updatedTask?.taskListId || '');
            const list = this.lists.find(item => item._id === listId)
                || this.lists.find(item => (item.tasks || []).some(task => task._id === taskId));
            if (field === 'statuses' && list && Array.isArray(value)) list.statuses = value;
            if (field === 'tagOptions' && list && Array.isArray(value)) list.tags = this.normalizeTagOptions(value);
            if (field === 'priorities' && Array.isArray(value)) {
                this.priorities = value;
                this.lists.forEach(item => { item.priorities = value; });
            }
            if (updatedTask?._id) this.syncTaskFromModal(updatedTask);
        },

        openDetail(list, task) {
            this.previewStatusMenu = null;
            this.previewStatusListId = null;
            this.taskCtx = null;
            this.ctxMenu = null;
            const modalTask = this.taskPayloadForModal(list, task);
            if (!window.Alpine?.store('taskModal')) {
                window.dispatchEvent(new CustomEvent('open-task-modal', {
                    detail: {
                        task: modalTask,
                        onUpdate: (taskId, field, value, updatedTask) => this.handleTaskModalUpdate(taskId, field, value, updatedTask),
                        onDelete: (taskId) => this.removeTaskLocally(taskId)
                    }
                }));
                return;
            }
            window.Alpine.store('taskModal').open(modalTask, {
                onUpdate: (taskId, field, value, updatedTask) => this.handleTaskModalUpdate(taskId, field, value, updatedTask),
                onDelete: (taskId) => this.removeTaskLocally(taskId)
            });
        },

    }));
});
</script>
