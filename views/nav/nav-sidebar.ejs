            class="-mx-4 mb-2 flex items-center justify-between bg-white-light/30 py-3 px-4 font-extrabold uppercase text-[12px] tracking-wider dark:bg-dark dark:bg-opacity-[0.08]">
            <div class="flex items-center gap-2">
              <iconify-icon icon="solar:share-circle-bold-duotone" width="18" height="18"></iconify-icon>
              <span x-text="'Spaces (' + realSpacesCount + ')'">Spaces</span>
            </div>
            <div class="flex items-center gap-1 pr-2">
              <iconify-icon icon="solar:add-square-bold" width="18" height="18"
                class="cursor-pointer text-primary hover:scale-110 transition-transform"
                @click="createSpace()"></iconify-icon>
            </div>
          </h2>

          <ul class="sortable-root" data-parent-type="root">
            <template x-for="item in hierarchy" :key="item.id">
              <li class="menu nav-item" :data-id="item.id" data-type="space">
                <div class="nav-link group flex items-center justify-between -mx-4 px-4 py-2 hover:bg-gray-50 dark:hover:bg-gray-800/40 transition-colors"
                  :class="activeDropdown.includes(item.id) ? 'bg-gray-100/50 dark:bg-gray-800/50' : ''">
                  <div x-data="{ hovered: false }" class="flex items-center mx-2 cursor-pointer flex-1"
                    @mouseenter="hovered = true" @mouseleave="hovered = false" @click="toggle(item.id)"
                    @contextmenu.prevent="openEditMenu($event, 'space', item)">
                    <iconify-icon
                      :icon="getIcon(item, item.children && item.children.length > 0, activeDropdown.includes(item.id), hovered)"
                      class="ml-1" width="18" height="18"
                      :style="item.color ? 'color: ' + item.color : ''"></iconify-icon>
                    
                    <template x-if="editingId !== item.id">
                      <span
                        class="text-sm text-gray-700 dark:text-gray-400 group-hover:text-primary transition-all ltr:pl-2 rtl:pr-2"
                        x-text="item.name"></span>
                    </template>
                    <template x-if="editingId === item.id">
                      <input x-ref="editInput" type="text"
                        class="form-input py-0 px-2 h-6 text-sm ml-1 bg-transparent border-primary w-full"
                        x-model="editingName" @keyup.enter="saveRename(item)" @blur="saveRename(item)"
                        x-init="$nextTick(() => $el.focus())">
                    </template>
                  </div>

                  <div class="flex items-center gap-2 pr-4 opacity-0 group-hover:opacity-100 transition-opacity">
                    <iconify-icon icon="solar:add-square-linear" width="16" height="16"
                      class="cursor-pointer hover:text-primary"
                      @click.stop="openEditMenu($event, 'space', item)"></iconify-icon>
                    <div class="rtl:rotate-180 transition-transform"
                      :class="{'!rotate-90' : activeDropdown.includes(item.id)}"
                      x-show="item.children && item.children.length > 0">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M9 5L15 12L9 19" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </div>
                  </div>
                </div>

                <ul x-cloak x-show="activeDropdown.includes(item.id)" x-collapse
                  class="sub-menu text-gray-500 dark:text-gray-400 mx-4 mb-2">
                  <template x-for="child in item.children" :key="child.id">
                    <li x-data="{ hovered: false }" class="relative" :data-id="child.id" :data-type="child.type">
                      <div
                        class="flex items-center hover:bg-gray-50 dark:hover:bg-gray-800 rounded transition-colors group/sub"
                        :class="subActive.includes(child.id) ? 'bg-gray-100/40 dark:bg-gray-800' : ''"
                        @mouseenter="hovered = true" @mouseleave="hovered = false"
                        @contextmenu.prevent="openEditMenu($event, child.type, child, item)">
                          <iconify-icon
                            :icon="getIcon(child, child.children && child.children.length > 0, subActive.includes(child.id), hovered)"
                            class="ml-2 cursor-pointer bg-transparent" width="16" height="16"
                          :style="child.color ? 'color: ' + child.color : ''"
                          @click.stop="if(['folder', 'environment'].includes(child.type)) { toggleSub(child.id); }"></iconify-icon>

                        <div class="flex-1 min-w-0">
                          <template x-if="editingId !== child.id">
                            <a :href="child.link || '#'" class="block ml-1 truncate text-gray-700 dark:text-gray-400 transition-colors"
                              :class="isItemActive(child.link) ? '!text-primary font-bold' : ''"
                              @click="if(['folder', 'environment'].includes(child.type)) { $event.preventDefault(); toggleSub(child.id); }">
                              <span x-text="child.name"></span>
                            </a>
                          </template>
                          <template x-if="editingId === child.id">
                            <input x-ref="editInput" type="text"
                              class="form-input py-0 px-2 h-6 text-sm ml-1 bg-transparent border-primary w-full"
                              x-model="editingName" @keyup.enter="saveRename(child)" @blur="saveRename(child)"
                              x-init="$nextTick(() => $el.focus())">
                          </template>
                        </div>

                        <div class="flex items-center gap-1 pr-4 transition-opacity"
                          :class="hovered ? 'opacity-100' : 'opacity-0'">
                          <iconify-icon icon="solar:add-square-linear" width="14" height="14"
                            class="cursor-pointer hover:text-primary"
                            @click.stop="openEditMenu($event, child.type, child, item)"></iconify-icon>
                        </div>

                      </div>

                      <!-- Nested children for Folders/Environments -->
                      <ul x-show="['folder', 'environment'].includes(child.type) && subActive.includes(child.id)"
                        x-collapse class="sub-menu text-gray-500 dark:text-gray-400 ltr:ml-4 rtl:mr-4 border-l dark:border-gray-800 ml-4">
                        <template x-for="subChild in child.children" :key="subChild.id">
                          <li x-data="{ hovered: false }"
                            x-init="if (subChild.children && subChild.children.some(c => isItemActive(c.link))) toggleExpand(subChild.id, true)"
                            class="relative block" :data-id="subChild.id" :data-type="subChild.type">
                            <div class="flex items-center hover:bg-gray-50 dark:hover:bg-gray-800 rounded transition-colors group/sub2"
                              :class="isExpanded(subChild.id) ? 'bg-gray-100/40 dark:bg-gray-800' : ''" @mouseenter="hovered = true"
                              @mouseleave="hovered = false"
                              @contextmenu.prevent="openEditMenu($event, subChild.type, subChild, child)">
                              <iconify-icon
                                :icon="getIcon(subChild, subChild.children && subChild.children.length > 0, isExpanded(subChild.id), hovered)"
                                class="ml-2 cursor-pointer bg-transparent" width="16" height="16"
                                :style="subChild.color ? 'color: ' + subChild.color : ''"
                                @click.stop="if(['folder', 'environment'].includes(subChild.type)) { toggleExpand(subChild.id); }"></iconify-icon>
                              <div class="flex-1 truncate min-w-0">
                                <template x-if="editingId !== subChild.id">
                                  <a :href="subChild.link || '#'" class="ml-1 text-sm text-gray-700 dark:text-gray-400 transition-colors block py-1"
                                    :class="isItemActive(subChild.link) ? '!text-primary font-bold' : ''"
                                    @click="if(['folder', 'environment'].includes(subChild.type)) { $event.preventDefault(); toggleExpand(subChild.id); }"
                                    x-text="subChild.name"></a>
                                </template>
                                <template x-if="editingId === subChild.id">
                                  <input x-ref="editInput" type="text"
                                    class="form-input py-0 px-2 h-6 text-sm ml-1 bg-transparent border-primary w-full"
                                    x-model="editingName" @keyup.enter="saveRename(subChild)"
                                    @blur="saveRename(subChild)" x-init="$nextTick(() => $el.focus())">
                                </template>
                              </div>
                              <div class="flex items-center gap-1 pr-4 transition-opacity"
                                :class="hovered ? 'opacity-100' : 'opacity-0'">
                                <iconify-icon icon="solar:add-square-linear" width="14" height="14"
                                  class="cursor-pointer hover:text-primary"
                                  @click.stop="openEditMenu($event, subChild.type, subChild, child)"></iconify-icon>
                              </div>


                            </div>

                            <ul x-show="['folder', 'environment'].includes(subChild.type) && isExpanded(subChild.id)"
                              x-collapse
                              class="sub-menu text-gray-500 dark:text-gray-400 ltr:ml-4 rtl:mr-4 border-l dark:border-gray-800 ml-4">
                              <template x-for="subSubChild in subChild.children" :key="subSubChild.id">
                                <li x-data="{ hovered: false }"
                                  class="flex items-center hover:bg-gray-50 dark:hover:bg-gray-800 rounded transition-colors group/sub3"
                                  :class="isExpanded(subSubChild.id) ? 'bg-gray-100/40 dark:bg-gray-800' : ''"
                                  @mouseenter="hovered = true" @mouseleave="hovered = false"
                                  @contextmenu.prevent="openEditMenu($event, subSubChild.type, subSubChild, subChild)"
                                  :data-id="subSubChild.id" :data-type="subSubChild.type">
                                  <iconify-icon :icon="getIcon(subSubChild)" class="ml-2" width="16" height="16"
                                    :style="subSubChild.color ? 'color: ' + subSubChild.color : ''"></iconify-icon>
                                  <div class="flex-1 truncate">
                                    <template x-if="editingId !== subSubChild.id">
                                      <a :href="subSubChild.link || '#'"
                                        class="ml-1 text-sm text-gray-700 dark:text-gray-400 transition-colors block py-1"
                                        :class="isItemActive(subSubChild.link) ? '!text-primary font-bold' : ''"
                                        x-text="subSubChild.name"></a>
                                    </template>
                                    <template x-if="editingId === subSubChild.id">
                                      <input x-ref="editInput" type="text"
                                        class="form-input py-0 px-2 h-6 text-sm ml-1 bg-transparent border-primary w-full"
                                        x-model="editingName" @keyup.enter="saveRename(subSubChild)"
                                        @blur="saveRename(subSubChild)" x-init="$nextTick(() => $el.focus())">
                                    </template>
                                  </div>
                                  <div class="flex items-center gap-1 pr-4 transition-opacity"
                                    :class="hovered ? 'opacity-100' : 'opacity-0'">
                                    <iconify-icon icon="solar:add-square-linear" width="14" height="14"
                                      class="cursor-pointer hover:text-primary"
                                      @click.stop="openEditMenu($event, subSubChild.type, subSubChild, subChild)"></iconify-icon>
                                  </div>
                                </li>
                              </template>
                              <li
                                x-show="(!subChild.children || subChild.children.length === 0) && dragOverFolderId !== subChild.id"
                                class="flex items-center hover:bg-gray-50 dark:hover:bg-gray-800 rounded transition-colors cursor-pointer add-placeholder"
                                :data-parent-id="subChild.id" @click.stop="openEditMenu($event, subChild.type, subChild)">
                                <iconify-icon icon="solar:add-square-linear" class="ml-2 text-primary" width="16"
                                  height="16"></iconify-icon>
                                <span class="ml-2 text-sm text-primary py-1">Ajouter</span>
                              </li>
                            </ul>
                          </li>
                        </template>
                        <li x-show="(!child.children || child.children.length === 0) && dragOverFolderId !== child.id"
                          class="flex items-center hover:bg-gray-50 dark:hover:bg-gray-800 rounded transition-colors cursor-pointer add-placeholder"
                          :data-parent-id="child.id" @click.stop="openEditMenu($event, child.type, child)">
                          <iconify-icon icon="solar:add-square-linear" class="ml-2 text-primary" width="16"
                            height="16"></iconify-icon>
                          <span class="ml-2 text-sm text-primary py-1">Ajouter</span>
                        </li>
                      </ul>

                    </li>
                  </template>
                </ul>
              </li>
            </template>
          </ul>

          <!-- Icon Edit Modal -->
          <div class="fixed inset-0 bg-[black]/60 z-[999] hidden overflow-y-auto"
            :class="showIconEditModal && '!block'">
            <div class="flex items-start justify-center min-h-screen px-4" @click.self="showIconEditModal = false">
              <div x-show="showIconEditModal" x-transition x-transition.duration.300
                class="panel border-0 py-1 px-4 rounded-lg overflow-hidden w-full max-w-sm my-8 bg-white dark:bg-[#1b2e4b]">
                <div class="flex items-center justify-between p-5 font-semibold text-lg dark:text-white">
                  <span>Changer l'icône</span>
                  <button type="button" @click="showIconEditModal = false" class="text-white-dark hover:text-dark">
                    <iconify-icon icon="solar:close-circle-bold" width="24" height="24"></iconify-icon>
                  </button>
                </div>
                <div class="p-5">
                  <form @submit.prevent="submitEditIcon">
                    <div class="relative mb-4">
                      <label class="mb-2 block text-sm font-bold">Choisir une icône</label>

                      <!-- Search & Library -->
                      <div class="relative mb-2 flex gap-2">
                        <select x-model="selectedLibrary"
                          class="form-select w-1/3 text-xs py-1.5 border-gray-300 dark:border-gray-600 focus:border-primary">
                          <template x-for="lib in libraries" :key="lib.id">
                            <option :value="lib.id" x-text="lib.name"></option>
                          </template>
                        </select>
                        <div class="relative w-2/3">
                          <input type="text" x-model="iconSearch" placeholder="Rechercher..."
                            class="form-input w-full text-xs pl-8 py-1.5 border-gray-300 dark:border-gray-600" />
                          <iconify-icon icon="solar:magnifer-linear" class="absolute left-2.5 top-2 text-gray-400"
                            width="14"></iconify-icon>
                        </div>
                      </div>

                      <!-- Grid -->
                      <div
                        class="flex flex-wrap gap-1 mb-2 max-h-60 overflow-y-auto custom-scrollbar p-1 border rounded dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/50 content-start"
                        @scroll.debounce="if($el.scrollTop + $el.clientHeight >= $el.scrollHeight - 20) loadMoreIcons()">
                        <template x-for="icon in icons" :key="icon">
                          <div
                            class="w-8 h-8 rounded cursor-pointer border border-transparent hover:border-primary/50 hover:bg-white dark:hover:bg-gray-700 transition-all flex items-center justify-center shrink-0"
                            :class="editingIcon === icon ? '!bg-primary/10 !border-primary text-primary shadow-sm' : 'text-gray-500 dark:text-gray-400'"
                            @click="editingIcon = icon" :title="icon">
                            <iconify-icon :icon="icon" width="20" height="20"></iconify-icon>
                          </div>
                        </template>
                        <template x-if="icons.length === 0 && !isLoadingIcons">
                          <div class="w-full text-center py-4 text-xs text-gray-400">Aucune icône trouvée</div>
                        </template>

                        <template x-if="isLoadingIcons">
                          <div class="w-full text-center py-2">
                            <span
                              class="animate-spin border-2 border-primary border-l-transparent rounded-full w-4 h-4 inline-block"></span>
                          </div>
                        </template>

                        <div class="w-full text-center pt-2 pb-1" x-show="hasMore && !isLoadingIcons">
                          <button type="button" @click="loadMoreIcons()"
                            class="text-xs text-primary hover:underline hover:text-primary-focus">
                            Charger plus...
                          </button>
                        </div>
                      </div>

                      <div class="text-xs text-gray-400 mb-2 text-center" x-show="!iconSearch">
                        <span x-text="icons.length"></span> icônes affichées
                      </div>
                      <input type="text" x-model="editingIcon" class="form-input w-full text-xs"
                        placeholder="Nom d'icône personnalisé..." />
                    </div>

                    <!-- Color Picker -->
                    <div class="mb-4">
                      <label class="mb-2 block text-sm font-bold">Couleur</label>
                      <div class="flex flex-wrap gap-2">
                        <template x-for="color in availableColors" :key="color">
                          <div
                            class="w-6 h-6 rounded-full cursor-pointer flex items-center justify-center border transition-transform hover:scale-110"
                            :style="'background-color: ' + color + '; border-color: ' + (editingColor === color ? 'black' : 'transparent')"
                            @click="editingColor = color">
                            <iconify-icon icon="solar:check-circle-bold" class="text-white" width="14"
                              x-show="editingColor === color"></iconify-icon>
                          </div>
                        </template>

                        <!-- Custom Picker -->
                        <div
                          class="relative w-6 h-6 rounded-full cursor-pointer border border-gray-300 flex items-center justify-center overflow-hidden hover:border-gray-400"
                          :style="editingColor && !availableColors.includes(editingColor) ? 'background-color: ' + editingColor + '; border-color: ' + editingColor : ''">
                          <iconify-icon icon="solar:pen-new-square-linear" width="14" class="pointer-events-none"
                            :class="editingColor && !availableColors.includes(editingColor) ? 'text-white mix-blend-difference' : 'text-gray-500'"></iconify-icon>
                          <input type="color"
                            class="absolute inset-0 opacity-0 cursor-pointer w-full h-full p-0 border-0"
                            x-model="editingColor" title="Couleur personnalisée" />
                        </div>
                        <span x-show="editingColor && !availableColors.includes(editingColor)" x-text="editingColor"
                          class="text-[10px] self-center font-mono text-gray-500 uppercase"></span>

                        <div
                          class="w-6 h-6 rounded-full cursor-pointer flex items-center justify-center border hover:border-gray-400 bg-transparent text-gray-400"
                          title="Réinitialiser" @click="editingColor = ''" :class="!editingColor && 'border-black'">
                          <iconify-icon icon="solar:close-circle-linear" width="16"></iconify-icon>
                        </div>
                      </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-full" :disabled="isSubmitting">
                      <span x-show="isSubmitting"
                        class="animate-spin border-2 border-white border-l-transparent rounded-full w-5 h-5 ltr:mr-2 rtl:ml-2 inline-block align-middle"></span>
                      Enregistrer
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>

          <!-- Creation Modal -->
          <div class="fixed inset-0 bg-[black]/60 z-[999] hidden overflow-y-auto" :class="showCreateModal && '!block'">
            <div class="flex items-start justify-center min-h-screen px-4" @click.self="showCreateModal = false">
              <div x-show="showCreateModal" x-transition x-transition.duration.300
                class="panel border-0 py-1 px-4 rounded-lg overflow-hidden w-full max-w-sm my-8 bg-white dark:bg-[#1b2e4b]">
                <div class="flex items-center justify-between p-5 font-semibold text-lg dark:text-white">
                  <span x-text="'Nouveau ' + (creationType === 'entity' ? 'Collection' : creationType)"></span>
                  <button type="button" @click="showCreateModal = false" class="text-white-dark hover:text-dark">
                    <iconify-icon icon="solar:close-circle-bold" width="24" height="24"></iconify-icon>
                  </button>
                </div>
                <div class="p-5">
                  <form @submit.prevent="submitCreateItem">
                    <div class="relative mb-4">
                      <label class="mb-2 block text-sm font-bold">Nom</label>
                      <input type="text" x-model="creationName" x-ref="createInput" placeholder="Entrez le nom..."
                        class="form-input w-full" />
                    </div>
                    <div class="relative mb-4">
                      <label class="mb-2 block text-sm font-bold">Icône</label>

                      <!-- Reuse Picker Logic -->
                      <div class="relative mb-2 flex gap-2">
                        <select x-model="selectedLibrary"
                          class="form-select w-1/3 text-xs py-1.5 border-gray-300 dark:border-gray-600 focus:border-primary">
                          <template x-for="lib in libraries" :key="lib.id">
                            <option :value="lib.id" x-text="lib.name"></option>
                          </template>
                        </select>
                        <div class="relative w-2/3">
                          <input type="text" x-model="iconSearch" placeholder="Rechercher..."
                            class="form-input w-full text-xs pl-8 py-1.5 border-gray-300 dark:border-gray-600" />
                          <iconify-icon icon="solar:magnifer-linear" class="absolute left-2.5 top-2 text-gray-400"
                            width="14"></iconify-icon>
                        </div>
                      </div>

                      <div
                        class="flex gap-2 flex-wrap mb-2 max-h-40 overflow-y-auto custom-scrollbar p-1 border rounded"
                        @scroll.debounce="if($el.scrollTop + $el.clientHeight >= $el.scrollHeight - 20) loadMoreIcons()">
                        <template x-for="icon in icons" :key="icon">
                          <div class="p-2 rounded cursor-pointer border hover:border-primary transition-colors"
                            :class="creationIcon === icon ? 'bg-primary/10 border-primary text-primary' : 'border-transparent bg-gray-50 dark:bg-gray-700'"
                            @click="creationIcon = icon">
                            <iconify-icon :icon="icon" width="20" height="20"></iconify-icon>
                          </div>
                        </template>

                        <template x-if="isLoadingIcons">
                          <div class="w-full text-center py-2">
                            <span
                              class="animate-spin border-dark border-l-transparent rounded-full w-4 h-4 inline-block"></span>
                          </div>
                        </template>

                        <div class="w-full text-center pt-2 pb-1" x-show="hasMore && !isLoadingIcons">
                          <button type="button" @click="loadMoreIcons()" class="text-xs text-primary hover:underline">
                            Charger plus...
                          </button>
                        </div>
                      </div>
                      <input type="text" x-model="creationIcon" class="form-input w-full text-xs"
                        placeholder="ou tapez un nom d'icône..." />

                      <!-- Color Picker Creation -->
                      <div class="mt-4">
                        <label class="mb-2 block text-sm font-bold">Couleur</label>
                        <div class="flex flex-wrap gap-2">
                          <template x-for="color in availableColors" :key="color">
                            <div
                              class="w-6 h-6 rounded-full cursor-pointer flex items-center justify-center border transition-transform hover:scale-110"
                              :style="'background-color: ' + color + '; border-color: ' + (creationColor === color ? 'black' : 'transparent')"
                              @click="creationColor = color">
                              <iconify-icon icon="solar:check-circle-bold" class="text-white" width="14"
                                x-show="creationColor === color"></iconify-icon>
                            </div>
                        </div>
                        </template>

                        <!-- Custom Picker -->
                        <div
                          class="relative w-6 h-6 rounded-full cursor-pointer border border-gray-300 flex items-center justify-center overflow-hidden hover:border-gray-400"
                          :style="creationColor && !availableColors.includes(creationColor) ? 'background-color: ' + creationColor + '; border-color: ' + creationColor : ''">
                          <iconify-icon icon="solar:pen-new-square-linear" width="14" class="pointer-events-none"
                            :class="creationColor && !availableColors.includes(creationColor) ? 'text-white mix-blend-difference' : 'text-gray-500'"></iconify-icon>
                          <input type="color"
                            class="absolute inset-0 opacity-0 cursor-pointer w-full h-full p-0 border-0"
                            x-model="creationColor" title="Couleur personnalisée" />
                        </div>
                        <span x-show="creationColor && !availableColors.includes(creationColor)" x-text="creationColor"
                          class="text-[10px] self-center font-mono text-gray-500 uppercase"></span>
                      </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-full" :disabled="isSubmitting">
                  <span x-show="isSubmitting"
                    class="animate-spin border-2 border-white border-l-transparent rounded-full w-5 h-5 ltr:mr-2 rtl:ml-2 inline-block align-middle"></span>
                  Créer
                </button>
                </form>
              </div>
            </div>
          </div>
        </div>

        <script>
          document.addEventListener("alpine:init", () => {
            Alpine.data('sidebarHierarchy', () => ({
              hierarchy: [],
              activeDropdown: [],
              subActive: [],
              expandedIds: [],
              savePrefsTimeout: null,
              dragOverFolderId: null,
              sortableInstances: [],
              showCreateModal: false,
              creationName: '',
              creationType: 'folder',
              creationIcon: '',
              creationColor: '',
              showIconEditModal: false,
              editingIcon: '',
              editingColor: '',

              // Icon Picker State
              icons: [],
              libraries: [],
              selectedLibrary: 'solar',
              iconSearch: '',
              page: 1,
              hasMore: true,
              isLoadingIcons: false,
              searchTimeout: null,

              availableColors: [
                '#4361ee', '#805dca', '#00ab55', '#e7515a', '#e2a03f',
                '#2196f3', '#3b3f5c', '#818181', '#673ab7', '#ff4081'
              ],

              init() {
                this.loadLibraries();
                this.$watch('iconSearch', () => {
                  if (this.searchTimeout) clearTimeout(this.searchTimeout);
                  this.searchTimeout = setTimeout(() => {
                    this.loadIcons(true);
                  }, 300);
                });
                this.$watch('selectedLibrary', () => {
                  this.loadIcons(true);
                });
              },

              async loadLibraries() {
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/icon-libraries`);
                  if (res.ok) {
                    const data = await res.json();
                    this.libraries = data.libraries || [];
                    if (this.libraries.length > 0 && !this.libraries.find(l => l.id === this.selectedLibrary)) {
                      this.selectedLibrary = this.libraries[0].id;
                    }
                  }
                } catch (e) { console.error("Failed to load libraries", e); }
              },

              async loadIcons(reset = false) {
                if (reset) {
                  this.page = 1;
                  this.icons = [];
                  this.hasMore = true;
                }

                if (!this.hasMore && !reset) return;

                this.isLoadingIcons = true;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];

                try {
                  const params = new URLSearchParams({
                    library: this.selectedLibrary,
                    search: this.iconSearch,
                    page: this.page,
                    limit: 60
                  });
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/icons?${params.toString()}`);
                  if (res.ok) {
                    const data = await res.json();
                    if (reset) {
                      this.icons = data.icons;
                    } else {
                      this.icons = [...this.icons, ...data.icons];
                    }
                    this.hasMore = data.hasMore;
                    if (data.hasMore) this.page++;
                  }
                } catch (e) {
                  console.error("Failed to load icons", e);
                  // Fallback
                  if (reset && this.icons.length === 0) {
                    this.icons = ['solar:planet-3-bold-duotone', 'solar:folder-2-line-duotone', 'solar:database-bold'];
                  }
                } finally {
                  this.isLoadingIcons = false;
                }
              },

              loadMoreIcons() {
                this.loadIcons(false);
              },

              isSubmitting: false,
              editingId: null,
              editingName: '',
              realSpacesCount: 0,
              menuMode: 'main', // 'main' or 'data'
              allEntities: [],
              entitySearch: '',
              pendingViewType: 'list',
              showViewConfigModal: false,
              configView: null,
              configEntity: null,
              tempFilters: [],
              tempViewType: 'list',

              async fetchHierarchy() {
                // Initialize Sidebar Store
                if (!Alpine.store('sidebar')) {
                  Alpine.store('sidebar', {
                    showMenu: false,
                    showEditMenu: false,
                    contextItem: null
                  });
                }

                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                console.log(`[Sidebar] Fetching hierarchy for account: ${accountNum}`);
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/list?t=${Date.now()}`, {
                    cache: 'no-store'
                  });
                  if (!res.ok) throw new Error(`HTTP ${res.status}`);
                  const data = await res.json();

                  // Clear hierarchy first to force DOM redraw
                  this.hierarchy = [];
                  await new Promise(r => setTimeout(r, 0));

                  this.hierarchy = data.hierarchy || [];
                  this.realSpacesCount = data.realSpacesCount || 0;
                  if (data.dbName) console.log(`[Sidebar] Connected to Tenant DB: ${data.dbName}`);

                  this.detectActiveItem();

                  // Load sidebar preferences
                  await this.loadSidebarPrefs();

                  // Initialize D&D after render
                  this.$nextTick(() => {
                    this.initDragAndDrop();
                  });

                } catch (e) {
                  console.error("[Sidebar] Failed to load hierarchy", e);
                }
              },

              initDragAndDrop() {
                if (typeof Sortable === 'undefined') {
                  console.warn('[Sidebar] Sortable.js not loaded');
                  return;
                }

                // Destroy existing instances first
                this.sortableInstances.forEach(instance => {
                  if (instance && typeof instance.destroy === 'function') {
                    instance.destroy();
                  }
                });
                this.sortableInstances = [];

                // Root list (Spaces) - use data attribute to avoid wrong container
                const rootEl = document.querySelector('ul[data-parent-type="root"]');
                if (rootEl) {
                  console.log('[Sidebar] Initializing Sortable for spaces');
                  const rootSortable = new Sortable(rootEl, {
                    group: 'spaces',
                    animation: 150,
                    onEnd: (evt) => this.handleDrop(evt, 'space')
                  });
                  this.sortableInstances.push(rootSortable);
                } else {
                  console.warn('[Sidebar] Root spaces container not found');
                }

                // Nested lists (Folders/Entities) inside spaces and folders
                const nestedEls = document.querySelectorAll('.sub-menu');
                nestedEls.forEach(el => {
                  const nestedSortable = new Sortable(el, {
                    group: 'nested',
                    animation: 150,
                    fallbackOnBody: true,
                    swapThreshold: 0.65,
                    filter: '.add-placeholder',  // Prevent dragging "Ajouter" button
                    onMove: (evt) => {
                      // Auto-expand empty folders when dragging over them
                      const toEl = evt.to;
                      const parentContainer = toEl.closest('[data-id]');
                      if (parentContainer) {
                        const folderId = parentContainer.getAttribute('data-id');
                        const folderType = parentContainer.getAttribute('data-type');

                        // Check if it's a folder and if it's closed
                        if (['folder', 'environment'].includes(folderType)) {
                          // Find in hierarchy to check if it has children or is empty
                          const findFolder = (list) => {
                            for (const item of list) {
                              if (item.id === folderId) return item;
                              if (item.children) {
                                const found = findFolder(item.children);
                                if (found) return found;
                              }
                            }
                            return null;
                          };

                          const folder = findFolder(this.hierarchy);

                          // Auto-open if folder exists and not already in subActive or expandedIds
                          if (folder) {
                            // Check if it's first-level (direct child of space)
                            const isFirstLevel = this.hierarchy.some(space =>
                              space.children && space.children.some(child => child.id === folderId)
                            );

                            if (isFirstLevel && !this.subActive.includes(folderId)) {
                              this.subActive.push(folderId);
                            } else if (!isFirstLevel && !this.expandedIds.includes(folderId)) {
                              this.expandedIds.push(folderId);
                            }
                          }
                        }

                        // Track for hiding Add button
                        this.dragOverFolderId = folderId;
                      }
                    },
                    onEnd: (evt) => {
                      this.dragOverFolderId = null; // Clear on drop or cancel
                      this.handleDrop(evt, 'nested');
                    }
                  });
                  this.sortableInstances.push(nestedSortable);
                });
              },

              async handleDrop(evt, group) {
                const itemEl = evt.item;
                const newIndex = evt.newIndex;
                const oldIndex = evt.oldIndex;
                const parentEl = evt.to;
                const oldParentEl = evt.from;

                // Optimization: If index didn't change and parent didn't change, do nothing
                if (newIndex === oldIndex && parentEl === oldParentEl) return;

                const id = itemEl.getAttribute('data-id');
                const type = itemEl.getAttribute('data-type');
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];

                // --- 1. Identify New Parent ---
                let newParentId = null;
                let newParentType = null;

                // For root spaces, parentEl will be the .sortable-root UL
                if (parentEl.classList.contains('sortable-root')) {
                  // Root level - no parent
                  newParentId = null;
                  newParentType = null;
                } else {
                  // Nested item - find the parent container
                  const newParentContainer = parentEl.closest('[data-id]');
                  if (newParentContainer) {
                    newParentId = newParentContainer.getAttribute('data-id');
                    newParentType = newParentContainer.getAttribute('data-type');
                  }
                }

                // --- 2. Identify Old Parent ---
                let oldParentId_Val = null;
                if (oldParentEl.classList.contains('sortable-root')) {
                  oldParentId_Val = null;
                } else {
                  const oldParentContainer = oldParentEl.closest('[data-id]');
                  if (oldParentContainer) {
                    oldParentId_Val = oldParentContainer.getAttribute('data-id');
                  }
                }

                console.log(`[Sidebar] Drop: ${type}#${id} | From: ${oldParentId_Val || 'root'} -> To: ${newParentId || 'root'} | Idx: ${oldIndex} -> ${newIndex}`);

                // --- 3. Optimistic Local Update (Optional - Sortable already moved it in DOM) ---
                // We'll rely on server sync and fetchHierarchy for now, or you can update this.hierarchy manually

                // --- 4. API Requests ---
                try {
                  // Move API (only if parent changed)
                  if (String(newParentId || '') !== String(oldParentId_Val || '')) {
                    await fetch(`/account/${accountNum}/api/hierarchy/move`, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({
                        itemId: id,
                        itemType: type,
                        newParentId: newParentId,
                        newParentType: newParentType,
                        oldParentId: oldParentId_Val
                      })
                    });
                  }

                  // Reorder API (always, to update order field)
                  // Get all siblings at the same level
                  let siblings;
                  if (parentEl.classList.contains('sortable-root')) {
                    // Root level - get all space LI elements
                    siblings = Array.from(parentEl.querySelectorAll(':scope > li[data-id][data-type="space"]'));
                  } else {
                    // Nested level - get all child LI elements with data-id
                    siblings = Array.from(parentEl.querySelectorAll(':scope > li[data-id]'));
                  }

                  const items = siblings.map((el, index) => ({
                    id: el.getAttribute('data-id'),
                    type: el.getAttribute('data-type'),
                    order: index
                  }));

                  await fetch(`/account/${accountNum}/api/hierarchy/reorder`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ items })
                  });

                  console.log("[Sidebar] Sync success", items);

                } catch (e) {
                  console.error("Sync failed", e);
                  alert("Erreur de synchronisation serveur");
                  this.fetchHierarchy(); // Revert on error
                }
              },

              isItemActive(link) {
                if (!link || link === '#') return false;
                return decodeURIComponent(window.location.pathname) === decodeURIComponent(link);
              },

              detectActiveItem() {
                const currentPath = decodeURIComponent(window.location.pathname);
                for (const space of this.hierarchy) {
                  for (const child of space.children || []) {
                    // Check child (Folder or Entity)
                    if (child.link && decodeURIComponent(child.link) === currentPath) {
                      this.activeDropdown = [space.id];
                      this.subActive = [];
                      return;
                    }
                    // Check if it's a folder/environment with sub-children
                    if (['folder', 'environment'].includes(child.type) && child.children) {
                      for (const sub of child.children) {
                        if (sub.link && decodeURIComponent(sub.link) === currentPath) {
                          this.activeDropdown = [space.id];
                          this.subActive = [child.id];
                          return;
                        }
                        // Check sub-sub-children
                        if (['folder', 'environment'].includes(sub.type) && sub.children) {
                          for (const subSub of sub.children) {
                            if (subSub.link && decodeURIComponent(subSub.link) === currentPath) {
                              this.activeDropdown = [space.id];
                              this.subActive = [child.id];
                              return;
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },

              toggle(id) {
                if (this.activeDropdown.includes(id)) {
                  this.activeDropdown = this.activeDropdown.filter(x => x !== id);
                } else {
                  this.activeDropdown.push(id);
                }
                this.saveSidebarPrefs();
              },

              toggleSub(id) {
                if (this.subActive.includes(id)) {
                  this.subActive = this.subActive.filter(x => x !== id);
                } else {
                  this.subActive.push(id);
                }
                this.saveSidebarPrefs();
              },

              toggleExpand(id, forceOpen = false) {
                if (forceOpen) {
                  if (!this.expandedIds.includes(id)) this.expandedIds.push(id);
                } else {
                  if (this.expandedIds.includes(id)) {
                    this.expandedIds = this.expandedIds.filter(x => x !== id);
                  } else {
                    this.expandedIds.push(id);
                  }
                }
                this.saveSidebarPrefs();
              },

              isExpanded(id) {
                return this.expandedIds.includes(id);
              },

              async loadSidebarPrefs() {
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const res = await fetch(`/account/${accountNum}/api/user/sidebar-prefs`);
                  if (res.ok) {
                    const data = await res.json();
                    const savedIds = data.expandedIds || [];
                    // Helper to find nested item by ID
                    const findInHierarchy = (list, id) => {
                      for (const item of list) {
                        if (item.id === id) return item;
                        if (item.children) {
                          const found = findInHierarchy(item.children, id);
                          if (found) return found;
                        }
                      }
                      return null;
                    };
                    // Restore all state arrays
                    this.activeDropdown = savedIds.filter(id => this.hierarchy.some(item => item.id === id));
                    this.subActive = savedIds.filter(id => {
                      // First-level children of spaces
                      return this.hierarchy.some(space => space.children && space.children.some(child => child.id === id));
                    });
                    this.expandedIds = savedIds.filter(id => {
                      // Everything else (deeper nested)
                      const isSpace = this.hierarchy.some(item => item.id === id);
                      const isFirstLevel = this.hierarchy.some(space => space.children && space.children.some(child => child.id === id));
                      return !isSpace && !isFirstLevel && findInHierarchy(this.hierarchy, id);
                    });
                    console.log('[Sidebar] Loaded preferences', { activeDropdown: this.activeDropdown, subActive: this.subActive, expandedIds: this.expandedIds });
                  }
                } catch (e) {
                  console.error('[Sidebar] Failed to load preferences', e);
                }
              },

              saveSidebarPrefs() {
                // Debounce: save 1 second after last change
                if (this.savePrefsTimeout) clearTimeout(this.savePrefsTimeout);
                this.savePrefsTimeout = setTimeout(async () => {
                  const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                  const allExpandedIds = [...this.activeDropdown, ...this.subActive, ...this.expandedIds];
                  try {
                    await fetch(`/account/${accountNum}/api/user/sidebar-prefs`, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ expandedIds: allExpandedIds })
                    });
                    console.log('[Sidebar] Saved preferences', allExpandedIds);
                  } catch (e) {
                    console.error('[Sidebar] Failed to save preferences', e);
                  }
                }, 1000);
              },

              getIcon(item, hasChildren = false, expanded = false, hovered = false) {
                let type = item;
                let customIcon = null;
                if (typeof item === 'object' && item !== null) {
                  type = item.type;
                  customIcon = item.icon;
                }

                const effectivelyHasChildren = hasChildren || ['space', 'folder', 'environment'].includes(type);
                if (effectivelyHasChildren && hovered && ['folder', 'environment'].includes(type)) {
                  return expanded ? 'solar:folder-open-line-duotone' : 'solar:folder-2-line-duotone';
                }

                if (customIcon) return customIcon;

                if (type === 'space') return 'solar:planet-3-bold-duotone';
                if (type === 'folder') return 'solar:folder-2-line-duotone';
                if (type === 'environment') return 'solar:layers-minimalistic-line-duotone';
                if (type === 'entity') return 'solar:database-bold';
                return 'solar:file-text-line-duotone';
              },

              async openCreateMenu(event, item) {
                this.menuMode = 'main';
                this.entitySearch = '';
                this.pendingViewType = 'list';
                Alpine.store('sidebar').contextItem = item;
                Alpine.store('sidebar').showMenu = true;
                Alpine.store('sidebar').showEditMenu = false;
                await this.loadAllEntities();
              },

              async loadAllEntities() {
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/all-entities`);
                  if (res.ok) {
                    const data = await res.json();
                    this.allEntities = data.entities || [];
                  }
                } catch (e) {
                  console.error("Failed to load entities", e);
                }
              },

              filteredEntities() {
                if (!this.entitySearch) return this.allEntities;
                return this.allEntities.filter(e =>
                  e.name.toLowerCase().includes(this.entitySearch.toLowerCase())
                );
              },

              async linkExistingEntity(entity) {
                const viewType = this.pendingViewType;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                const parent = Alpine.store('sidebar').contextItem;
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/link-entity`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      entityId: entity.id,
                      parentId: parent.id,
                      parentType: parent.type,
                      viewType: viewType
                    })
                  });
                  if (res.ok) {
                    Alpine.store('sidebar').showMenu = false;
                    await this.fetchHierarchy();
                  }
                } catch (e) { alert("Erreur: " + e.message); }
              },

              openEditMenu(event, type, item, parent = null) {
                Alpine.store('sidebar').contextItem = { ...item, type, parent };
                Alpine.store('sidebar').showEditMenu = true;
                Alpine.store('sidebar').showMenu = false;
              },

              async createSpace() {
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                const name = prompt("Nom de l'Espace :");
                if (!name) return;
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/space`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name })
                  });
                  if (!res.ok) {
                    const err = await res.json();
                    throw new Error(err.error || `HTTP ${res.status}`);
                  }
                  const newSpace = await res.json();
                  this.hierarchy.push({
                    id: newSpace._id,
                    name: newSpace.name,
                    type: 'space',
                    children: []
                  });
                  this.startRename({ id: newSpace._id, name: newSpace.name });
                } catch (e) { alert("Erreur: " + e.message); }
              },

              async createItem(type, viewType = 'list') {
                this.creationType = type;
                this.pendingViewType = viewType;
                this.creationName = '';
                
                // Set default icon based on type and viewType
                let icon = this.getIcon(type);
                if (type === 'entity') {
                    if (viewType === 'list') icon = 'solar:list-bold';
                    if (viewType === 'note') icon = 'solar:notes-bold-duotone';
                    if (viewType === 'dashboard') icon = 'solar:pie-chart-3-line-duotone';
                }
                this.creationIcon = icon;
                this.creationColor = '';

                // Initialize picker state
                this.iconSearch = '';
                this.selectedLibrary = this.creationIcon.split(':')[0] || 'solar';
                if (this.libraries.length > 0 && !this.libraries.find(l => l.id === this.selectedLibrary)) {
                  this.selectedLibrary = this.libraries[0].id;
                }

                this.showCreateModal = true;
                Alpine.store('sidebar').showMenu = false;

                await this.loadIcons(true); // Load initial icons

                this.$nextTick(() => {
                  if (this.$refs.createInput) this.$refs.createInput.focus();
                });
              },

              async submitCreateItem() {
                if (!this.creationName) return;
                this.isSubmitting = true;
                const type = this.creationType;
                const name = this.creationName;
                const icon = this.creationIcon;
                const color = this.creationColor;
                const viewType = this.pendingViewType;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                const parent = Alpine.store('sidebar').contextItem;

                const url = ['folder', 'environment'].includes(type) ? 'folder' : 'entity';
                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/${url}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      name,
                      type,
                      icon,
                      color,
                      parentId: parent.id,
                      parentType: parent.type,
                      viewType: viewType
                    })
                  });
                  if (!res.ok) {
                    const err = await res.json();
                    throw new Error(err.error || `HTTP ${res.status}`);
                  }
                  this.showCreateModal = false;
                  await this.fetchHierarchy();
                } catch (e) { alert("Erreur: " + e.message); }
                finally { this.isSubmitting = false; }
              },

              startRename(item) {
                this.editingId = item.id;
                this.editingName = item.name;
                Alpine.store('sidebar').showEditMenu = false;
              },

              async openIconEditor(item) {
                this.editingIcon = item.icon || this.getIcon(item.type);
                this.editingColor = item.color || '';

                // Initialize picker state
                this.iconSearch = '';
                this.selectedLibrary = this.editingIcon.split(':')[0] || 'solar';
                if (this.libraries.length > 0 && !this.libraries.find(l => l.id === this.selectedLibrary)) {
                  this.selectedLibrary = this.libraries[0].id;
                }

                this.showIconEditModal = true;
                Alpine.store('sidebar').showEditMenu = false;

                await this.loadIcons(true);
              },

              async submitEditIcon() {
                // if (!this.editingIcon) return; // Allow empty icon to reset to default via logic? No, just keep required.
                this.isSubmitting = true;
                const item = Alpine.store('sidebar').contextItem;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];

                try {
                  const res = await fetch(`/account/${accountNum}/api/hierarchy/icon`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: item.id, type: item.type, icon: this.editingIcon, color: this.editingColor })
                  });
                  if (!res.ok) throw new Error(`HTTP ${res.status}`);
                  item.icon = this.editingIcon;
                  item.color = this.editingColor;
                  this.showIconEditModal = false;
                  await this.fetchHierarchy();
                } catch (e) { alert("Erreur: " + e.message); }
                finally { this.isSubmitting = false; }
              },

              async saveRename(item) {
                if (this.editingId !== item.id) return;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                const newName = this.editingName;
                this.editingId = null;

                if (!newName || newName === item.name) return;

                try {
                  await fetch(`/account/${accountNum}/api/hierarchy/rename`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: item.id, type: item.type, newName })
                  });
                  item.name = newName;
                } catch (e) { console.error(e); }
              },

              async deleteItem() {
                const item = Alpine.store('sidebar').contextItem;
                if (!item || !confirm(`Êtes-vous sûr de vouloir supprimer ${item.type} ?`)) return;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const body = { id: item.id, type: item.type };
                  if (item.type === 'entity' && item.parent) {
                    body.parentId = item.parent.id;
                    body.parentType = item.parent.type;
                  }
                  await fetch(`/account/${accountNum}/api/hierarchy/delete`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                  });
                  console.log(`[Sidebar] Item ${item.id} unlinked/deleted, waiting for refresh...`);
                  Alpine.store('sidebar').showEditMenu = false;

                  // Small delay to ensure DB propagation
                  await new Promise(r => setTimeout(r, 100));
                  await this.fetchHierarchy();
                } catch (e) { alert("Erreur: " + e.message); }
              },

              async openViewConfig() {
                const item = Alpine.store('sidebar').contextItem;
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];

                try {
                  // 1. Get View Details
                  const resView = await fetch(`/account/${accountNum}/api/hierarchy/list?id=${item.id}`); // This is just to get data, maybe we need a specific endpoint
                  // Actually, let's just use the item data we have if possible, but we need fields.
                  // Better approach: fetch entity details
                  const resEntity = await fetch(`/account/${accountNum}/api/entity/${item.entityId}`);
                  if (!resEntity.ok) throw new Error("Erreur chargement entité");
                  this.configEntity = await resEntity.json();

                  // Mock view data for now if we don't have a fetch-by-id
                  this.configView = item;
                  this.tempViewType = item.viewType || 'list';
                  this.tempFilters = item.filters || [];

                  this.showViewConfigModal = true;
                  Alpine.store('sidebar').showEditMenu = false;
                } catch (e) {
                  alert("Erreur: " + e.message);
                }
              },

              addFilter() {
                this.tempFilters.push({ field: '', operator: 'equals', value: '' });
              },

              removeFilter(index) {
                this.tempFilters.splice(index, 1);
              },

              async saveViewConfig() {
                const accountNum = '<%= account_number %>' || window.location.pathname.split('/')[2];
                try {
                  const res = await fetch(`/account/${accountNum}/api/view/config`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      viewId: this.configView.id,
                      viewType: this.tempViewType,
                      filters: this.tempFilters
                    })
                  });
                  if (res.ok) {
                    this.showViewConfigModal = false;
                    await this.fetchHierarchy();
                  }
                } catch (e) {
                  alert("Erreur: " + e.message);
                }
              }
            }));
          });
        </script>

