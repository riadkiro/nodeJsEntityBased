<!-- 
    Document Editor React Island
    This view integrates into layout-app with sidebar, navbar, dark/light mode
    Supports minimal mode (isMinimal: true) for iframe embedding
-->

<% if (locals.isMinimal) { %>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' };
    </script>
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
</head>
<body style="margin:0; padding:0; overflow:hidden;">
<script>
    // Sync theme from parent page's localStorage so Tailwind dark: classes work in iframe
    // Handles both Alpine.$persist JSON format ("dark") and plain string (dark)
    try {
        var stored = localStorage.getItem('_x_theme');
        if (stored) {
            var theme;
            try { theme = JSON.parse(stored); } catch(e) { theme = stored; }
            if (theme === 'dark') {
                document.body.classList.add('dark');
            } else if (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.body.classList.add('dark');
            }
        }
    } catch(e) {}
</script>
<% } %>

<style>
    /* Template token styling */
    .template-token {
        display: inline-block;
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        color: #92400e;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.875em;
        font-weight: 500;
        border: 1px solid #fcd34d;
        cursor: default;
        user-select: none;
        vertical-align: baseline;
    }
    .dark .template-token {
        background: linear-gradient(135deg, #78350f 0%, #92400e 100%);
        color: #fef3c7;
        border-color: #b45309;
    }
    
    /* Override padding for full-height editor */
    .animate__animated.p-6 {
        padding: 0 !important;
    }
    
    /* Print styles */
    @media print {
        .sidebar, header, nav, .mode-switcher, [data-print-hide] {
            display: none !important;
        }
        .main-content {
            margin-left: 0 !important;
        }
        .bg-white.shadow-2xl {
            box-shadow: none !important;
            margin: 0 auto !important;
            border: none !important;
            page-break-after: always;
        }
    }
</style>

<!-- Document Editor React Island Mount Point -->
<div 
    data-island="document-editor"
    data-document="<%-
        // Safely encode JSON for HTML attribute using base64 to avoid all escaping issues
        Buffer.from(JSON.stringify(document || {})).toString('base64')
    %>"
    data-account-number="<%= account_number %>"
    data-is-new="<%= isNew ? 'true' : 'false' %>"
    class="<%= locals.isMinimal ? 'h-screen' : 'h-[calc(100vh-80px)] -m-6' %>"
></div>

<!-- React Island Script -->
<script type="module" src="/dist/documentEditor.js"></script>

<% if (locals.isMinimal) { %>
</body>
</html>
<% } %>
