                                        <template x-if="getEditLines()[editModal.lineIdx]?.values[getRelationCol()?.key]">
                                            <span class="tp-tag" style="background:#dbeafe; color:#2563eb;">
                                                <span x-text="getEditLines()[editModal.lineIdx]?.values[getRelationCol()?.key + '_label'] || getRelationLabel(getEditLines()[editModal.lineIdx]) || '—'"></span>
                                                <button type="button" class="tp-tag-remove" @click.stop="getEditLines()[editModal.lineIdx].values[getRelationCol().key] = ''; getEditLines()[editModal.lineIdx].values[getRelationCol().key + '_label'] = ''">
                                                    <iconify-icon icon="tabler:x" width="10"></iconify-icon>
                                                </button>
                                            </span>
                                        </template>
                                        <template x-if="!getEditLines()[editModal.lineIdx]?.values[getRelationCol()?.key]">
                                            <span class="tp-placeholder">
