<!-- 
    Document Editor React Island
    This view integrates into layout-app with sidebar, navbar, dark/light mode
    Supports minimal mode (isMinimal: true) for iframe embedding
-->

<% if (locals.isMinimal || locals.isTemplateMode || locals.isFocusMode) { %>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/themes/default/assets/css/style.css">
    <link rel="stylesheet" href="/css/app/main.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' };
    </script>
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
</head>
<body style="margin:0; padding:0; overflow:hidden;">
<% if (locals.isMinimal) { %>
<script>
    // Document editor in minimal/iframe mode is always light — 
    // it's A4 paper content for PDF generation, dark mode makes no sense here
    // We explicitly do NOT sync the parent page's dark theme
    document.body.classList.remove('dark');
</script>
<% } %>
<% } %>

<style>
    /* Template token styling */
    .template-token {
        display: inline-block;
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        color: #92400e;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.875em;
        font-weight: 500;
        border: 1px solid #fcd34d;
        cursor: default;
        user-select: none;
        vertical-align: baseline;
    }
    .dark .template-token {
        background: linear-gradient(135deg, #78350f 0%, #92400e 100%);
        color: #fef3c7;
        border-color: #b45309;
    }
    
    /* Full-height editor: make main-content a flex column so editor fills all remaining space */
    .main-content {
        display: flex !important;
        flex-direction: column !important;
        height: 100vh !important;
        overflow: hidden !important;
    }
    /* Neutralize the global -20px header margin within the doc editor full-height layout */
    .main-content > header > .shadow-sm {
        margin-top: 0 !important;
    }
    /* Ensure the header toolbar renders ABOVE the canvas scrollable area */
    .main-content > header {
        position: relative;
        z-index: 30;
    }
    /* Override padding for full-height editor */
    .animate__animated.p-6 {
        padding: 0 !important;
        flex: 1 !important;
        overflow: hidden !important;
        min-height: 0 !important;
    }
    
    /* Print styles */
    @media print {
        .sidebar, header, nav, .mode-switcher, [data-print-hide] {
            display: none !important;
        }
        .main-content {
            margin-left: 0 !important;
        }
        .bg-white.shadow-2xl {
            box-shadow: none !important;
            margin: 0 auto !important;
            border: none !important;
            page-break-after: always;
        }
    }

    /* Binding placeholder tokens (context-free generation) */
    .binding-placeholder {
        display: inline-block;
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        color: #92400e;
        padding: 2px 10px;
        border-radius: 6px;
        font-size: 0.85em;
        font-weight: 500;
        border: 1px dashed #f59e0b;
        cursor: pointer;
        user-select: none;
        vertical-align: baseline;
        white-space: nowrap;
        transition: all 0.15s ease;
    }
    .binding-placeholder:hover {
        background: linear-gradient(135deg, #fde68a 0%, #fbbf24 100%);
        border-color: #d97706;
        transform: scale(1.03);
        box-shadow: 0 2px 8px rgba(245, 158, 11, 0.25);
    }
</style>

<!-- Document Editor React Island Mount Point -->
<div 
    data-island="document-editor"
    data-document="<%-
        // Safely encode JSON for HTML attribute using base64 to avoid all escaping issues
        Buffer.from(JSON.stringify(document || {})).toString('base64')
    %>"
    data-account-number="<%= account_number %>"
    data-is-new="<%= isNew ? 'true' : 'false' %>"
    data-is-minimal="<%= locals.isMinimal ? 'true' : 'false' %>"
    <% if (locals.contextFreeBindings) { %>
    data-bindings="<%-
        Buffer.from(JSON.stringify(contextFreeBindings)).toString('base64')
    %>"
    <% } %>
    <% if (locals.isTemplateMode) { %>
    data-is-template-mode="true"
    <% } %>
    class="<%= (locals.isMinimal || locals.isTemplateMode || locals.isFocusMode) ? 'h-screen' : '' %>"
    style="<%= (locals.isMinimal || locals.isTemplateMode || locals.isFocusMode) ? '' : 'height:100%;overflow:hidden;' %>"
></div>

<!-- React Island Script -->
<script type="module" src="/dist/documentEditor.js"></script>

<% if (locals.isMinimal || locals.isTemplateMode || locals.isFocusMode) { %>
</body>
</html>
<% } %>

