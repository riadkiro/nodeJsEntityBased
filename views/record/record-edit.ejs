                    let inputHtml = this.renderField(field, item.id);

                    // Build data attributes for field assignment system
                    const fieldType = field.type || 'custom';
                    const fieldLabel = field.label || field.name || field.key || item.fieldId;
                    const fieldAssignId = fieldType + '_' + item.fieldId;
                    // Check if this field is assigned to a tab
