<link rel="stylesheet" href="/css/app/team-system.css" />

<div class="animate__animated p-6" :class="[$store.app.animation]">
<div x-data="permissionsHub()" x-init="init()" x-cloak>
  <!-- Page Header -->
  <div class="ts-page-header">
    <div class="ts-page-header-icon" style="background:linear-gradient(135deg,rgba(124,58,237,.15),rgba(124,58,237,.05));">
      <iconify-icon icon="solar:shield-keyhole-bold-duotone" width="28" style="color:#7c3aed"></iconify-icon>
    </div>
    <div class="ts-page-header-info">
      <h1>Permissions & Accès</h1>
      <p>Configurez les droits d'accès CRUD pour chaque membre par entité</p>
    </div>
    <a href="/account/<%= account_number %>/team" style="margin-left:auto;display:flex;align-items:center;gap:6px;padding:8px 18px;border:1px solid #e0e6ed;border-radius:10px;font-size:12px;font-weight:600;color:#64748b;text-decoration:none;transition:all .15s;" class="dark:!border-[#253b5c] dark:!text-[#94a3b8]" onmouseover="this.style.borderColor='#4361ee';this.style.color='#4361ee'" onmouseout="this.style.borderColor='#e0e6ed';this.style.color='#64748b'">
      <iconify-icon icon="solar:arrow-left-linear" width="14"></iconify-icon>
      Équipe
    </a>
  </div>

  <!-- Loading -->
  <template x-if="loading">
    <div style="display:flex;align-items:center;justify-content:center;padding:80px 0;">
      <div class="animate-spin" style="width:28px;height:28px;border:3px solid #e0e6ed;border-top-color:#4361ee;border-radius:50%;"></div>
    </div>
  </template>

  <template x-if="!loading">
    <div>
      <!-- Member Selector -->
      <div style="background:#fff;border:1px solid #e0e6ed;border-radius:14px;padding:20px;margin-bottom:20px;" class="dark:!bg-[#0e1726] dark:!border-[#253b5c]">
        <div style="font-size:12px;font-weight:700;text-transform:uppercase;color:#94a3b8;margin-bottom:12px;letter-spacing:.04em;">Sélectionnez un membre</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <template x-for="m in editableMembers" :key="m._id">
            <button @click="selectMember(m)" :style="'display:flex;align-items:center;gap:8px;padding:8px 16px;border-radius:10px;border:1.5px solid ' + (selectedMember?._id === m._id ? '#4361ee' : '#e0e6ed') + ';background:' + (selectedMember?._id === m._id ? 'rgba(67,97,238,.04)' : '#fff') + ';cursor:pointer;transition:all .15s;font-family:inherit;'" class="dark:!bg-[#1b2e4b] dark:!border-[#253b5c]">
              <div :style="'width:28px;min-width:28px;max-width:28px;height:28px;min-height:28px;max-height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0;background:' + avatarColor(m.name)">
                <span x-text="m.name.charAt(0).toUpperCase()"></span>
              </div>
              <div style="text-align:left;">
                <div style="font-size:12px;font-weight:600;color:#0e1726;" class="dark:!text-[#e0e6ed]" x-text="m.name"></div>
                <div style="font-size:10px;color:#94a3b8;" x-text="m.role.toUpperCase()"></div>
              </div>
            </button>
          </template>
        </div>
      </div>

      <!-- CRUD Matrix -->
      <template x-if="selectedMember">
        <div>
          <!-- Selected Member Header -->
          <div style="background:#fff;border:1px solid #e0e6ed;border-radius:14px;padding:18px 20px;margin-bottom:16px;display:flex;align-items:center;justify-content:space-between;" class="dark:!bg-[#0e1726] dark:!border-[#253b5c]">
            <div style="display:flex;align-items:center;gap:12px;">
              <div :style="'width:36px;min-width:36px;max-width:36px;height:36px;min-height:36px;max-height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff;flex-shrink:0;background:' + avatarColor(selectedMember.name)">
                <span x-text="selectedMember.name.charAt(0).toUpperCase()"></span>
              </div>
              <div>
                <div style="font-size:15px;font-weight:700;color:#0e1726;" class="dark:!text-[#e0e6ed]" x-text="selectedMember.name"></div>
                <div style="font-size:12px;color:#94a3b8;" x-text="selectedMember.email"></div>
              </div>
              <span :style="'display:inline-flex;padding:3px 10px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;background:' + roleColor(selectedMember.role) + '15;color:' + roleColor(selectedMember.role)" x-text="selectedMember.role"></span>
            </div>
            <div style="display:flex;gap:6px;">
              <button @click="setAllPermissions(true)" style="display:flex;align-items:center;gap:5px;padding:6px 14px;border:1px solid #e0e6ed;border-radius:8px;font-size:11px;font-weight:600;color:#64748b;cursor:pointer;background:#fff;font-family:inherit;transition:all .15s;" class="dark:!bg-[#1b2e4b] dark:!border-[#253b5c] dark:!text-[#94a3b8]" onmouseover="this.style.borderColor='#22c55e';this.style.color='#22c55e'" onmouseout="this.style.borderColor='#e0e6ed';this.style.color='#64748b'">
                <iconify-icon icon="solar:check-circle-bold" width="13"></iconify-icon>
                Accès complet
              </button>
              <button @click="setReadOnly()" style="display:flex;align-items:center;gap:5px;padding:6px 14px;border:1px solid #e0e6ed;border-radius:8px;font-size:11px;font-weight:600;color:#64748b;cursor:pointer;background:#fff;font-family:inherit;transition:all .15s;" class="dark:!bg-[#1b2e4b] dark:!border-[#253b5c] dark:!text-[#94a3b8]" onmouseover="this.style.borderColor='#3b82f6';this.style.color='#3b82f6'" onmouseout="this.style.borderColor='#e0e6ed';this.style.color='#64748b'">
                <iconify-icon icon="solar:eye-bold" width="13"></iconify-icon>
                Lecture seule
              </button>
              <button @click="clearAllPermissions()" style="display:flex;align-items:center;gap:5px;padding:6px 14px;border:1px solid #e0e6ed;border-radius:8px;font-size:11px;font-weight:600;color:#64748b;cursor:pointer;background:#fff;font-family:inherit;transition:all .15s;" class="dark:!bg-[#1b2e4b] dark:!border-[#253b5c] dark:!text-[#94a3b8]" onmouseover="this.style.borderColor='#ef4444';this.style.color='#ef4444'" onmouseout="this.style.borderColor='#e0e6ed';this.style.color='#64748b'">
                <iconify-icon icon="solar:close-circle-bold" width="13"></iconify-icon>
                Aucun accès
              </button>
            </div>
          </div>

          <!-- Info Banner -->
          <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;background:rgba(67,97,238,.04);border:1px solid rgba(67,97,238,.12);border-radius:10px;margin-bottom:16px;" class="dark:!bg-[rgba(67,97,238,.08)] dark:!border-[rgba(67,97,238,.2)]">
            <iconify-icon icon="solar:info-circle-bold" width="16" style="color:#4361ee;flex-shrink:0;"></iconify-icon>
            <span style="font-size:12px;color:#4361ee;font-weight:500;">Aucune entité configurée = accès complet à toutes les entités. Cochez uniquement les entités auxquelles ce membre doit avoir accès.</span>
          </div>

          <!-- Entity CRUD Matrix Table -->
          <div style="background:#fff;border:1px solid #e0e6ed;border-radius:14px;overflow:hidden;" class="dark:!bg-[#0e1726] dark:!border-[#253b5c]">
            <table style="width:100%;border-collapse:collapse;">
              <thead>
                <tr style="border-bottom:1px solid #e0e6ed;" class="dark:!border-[#253b5c]">
                  <th style="text-align:left;padding:14px 18px;font-size:12px;font-weight:700;color:#0e1726;text-transform:uppercase;letter-spacing:.04em;" class="dark:!text-[#e0e6ed]">Entité</th>
                  <th style="text-align:center;padding:14px 12px;font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.04em;width:90px;">
                    <div style="display:flex;flex-direction:column;align-items:center;gap:2px;">
                      <iconify-icon icon="solar:eye-bold" width="15" style="color:#3b82f6;"></iconify-icon>
                      Voir
                    </div>
                  </th>
                  <th style="text-align:center;padding:14px 12px;font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.04em;width:90px;">
                    <div style="display:flex;flex-direction:column;align-items:center;gap:2px;">
                      <iconify-icon icon="solar:add-square-bold" width="15" style="color:#22c55e;"></iconify-icon>
                      Créer
                    </div>
                  </th>
                  <th style="text-align:center;padding:14px 12px;font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.04em;width:90px;">
                    <div style="display:flex;flex-direction:column;align-items:center;gap:2px;">
                      <iconify-icon icon="solar:pen-bold" width="15" style="color:#f59e0b;"></iconify-icon>
                      Modifier
                    </div>
                  </th>
                  <th style="text-align:center;padding:14px 12px;font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.04em;width:90px;">
                    <div style="display:flex;flex-direction:column;align-items:center;gap:2px;">
                      <iconify-icon icon="solar:trash-bin-trash-bold" width="15" style="color:#ef4444;"></iconify-icon>
                      Supprimer
                    </div>
                  </th>
                </tr>
              </thead>
              <tbody>
                <template x-for="entity in allEntities" :key="entity._id">
                  <tr style="border-bottom:1px solid #f1f5f9;transition:background .15s;" class="dark:!border-[#1b2e4b]" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
                    <td style="padding:12px 18px;">
                      <div style="display:flex;align-items:center;gap:10px;">
                        <div :style="'width:32px;min-width:32px;max-width:32px;height:32px;min-height:32px;max-height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:' + (entity.color || '#4361ee') + '15'">
                          <iconify-icon :icon="entity.icon || 'solar:folder-bold-duotone'" width="16" :style="'color:' + (entity.color || '#4361ee')"></iconify-icon>
                        </div>
                        <div>
                          <div style="font-size:13px;font-weight:600;color:#0e1726;" class="dark:!text-[#e0e6ed]" x-text="entity.name"></div>
                          <div style="font-size:10px;color:#94a3b8;" x-text="entity.slug"></div>
                        </div>
                      </div>
                    </td>
                    <td style="text-align:center;padding:12px;">
                      <label style="display:inline-flex;cursor:pointer;position:relative;">
                        <input type="checkbox" :checked="getEntityPerm(entity._id, 'read')" @change="togglePerm(entity._id, 'read')" style="display:none;" />
                        <div :style="'width:36px;height:20px;border-radius:12px;transition:all .2s;position:relative;' + (getEntityPerm(entity._id, 'read') ? 'background:#3b82f6' : 'background:#e0e6ed')">
                          <div :style="'width:16px;height:16px;border-radius:50%;background:#fff;position:absolute;top:2px;transition:all .2s;box-shadow:0 1px 3px rgba(0,0,0,.15);' + (getEntityPerm(entity._id, 'read') ? 'left:18px' : 'left:2px')"></div>
                        </div>
                      </label>
                    </td>
                    <td style="text-align:center;padding:12px;">
                      <label style="display:inline-flex;cursor:pointer;position:relative;">
                        <input type="checkbox" :checked="getEntityPerm(entity._id, 'create')" @change="togglePerm(entity._id, 'create')" style="display:none;" />
                        <div :style="'width:36px;height:20px;border-radius:12px;transition:all .2s;position:relative;' + (getEntityPerm(entity._id, 'create') ? 'background:#22c55e' : 'background:#e0e6ed')">
                          <div :style="'width:16px;height:16px;border-radius:50%;background:#fff;position:absolute;top:2px;transition:all .2s;box-shadow:0 1px 3px rgba(0,0,0,.15);' + (getEntityPerm(entity._id, 'create') ? 'left:18px' : 'left:2px')"></div>
                        </div>
                      </label>
                    </td>
                    <td style="text-align:center;padding:12px;">
                      <label style="display:inline-flex;cursor:pointer;position:relative;">
                        <input type="checkbox" :checked="getEntityPerm(entity._id, 'update')" @change="togglePerm(entity._id, 'update')" style="display:none;" />
                        <div :style="'width:36px;height:20px;border-radius:12px;transition:all .2s;position:relative;' + (getEntityPerm(entity._id, 'update') ? 'background:#f59e0b' : 'background:#e0e6ed')">
                          <div :style="'width:16px;height:16px;border-radius:50%;background:#fff;position:absolute;top:2px;transition:all .2s;box-shadow:0 1px 3px rgba(0,0,0,.15);' + (getEntityPerm(entity._id, 'update') ? 'left:18px' : 'left:2px')"></div>
                        </div>
                      </label>
                    </td>
                    <td style="text-align:center;padding:12px;">
                      <label style="display:inline-flex;cursor:pointer;position:relative;">
                        <input type="checkbox" :checked="getEntityPerm(entity._id, 'delete')" @change="togglePerm(entity._id, 'delete')" style="display:none;" />
                        <div :style="'width:36px;height:20px;border-radius:12px;transition:all .2s;position:relative;' + (getEntityPerm(entity._id, 'delete') ? 'background:#ef4444' : 'background:#e0e6ed')">
                          <div :style="'width:16px;height:16px;border-radius:50%;background:#fff;position:absolute;top:2px;transition:all .2s;box-shadow:0 1px 3px rgba(0,0,0,.15);' + (getEntityPerm(entity._id, 'delete') ? 'left:18px' : 'left:2px')"></div>
                        </div>
                      </label>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>

          <!-- Save Status -->
          <div style="display:flex;align-items:center;justify-content:flex-end;margin-top:14px;gap:10px;">
            <template x-if="saveStatus === 'saving'">
              <span style="display:flex;align-items:center;gap:6px;font-size:12px;color:#94a3b8;">
                <div class="animate-spin" style="width:14px;height:14px;border:2px solid #e0e6ed;border-top-color:#4361ee;border-radius:50%;"></div>
                Enregistrement...
              </span>
            </template>
            <template x-if="saveStatus === 'saved'">
              <span style="display:flex;align-items:center;gap:5px;font-size:12px;color:#22c55e;font-weight:600;">
                <iconify-icon icon="solar:check-circle-bold" width="14"></iconify-icon>
                Enregistré
              </span>
            </template>
            <template x-if="saveStatus === 'error'">
              <span style="display:flex;align-items:center;gap:5px;font-size:12px;color:#ef4444;font-weight:600;">
                <iconify-icon icon="solar:danger-triangle-bold" width="14"></iconify-icon>
                Erreur
              </span>
            </template>
          </div>
        </div>
      </template>

      <!-- No Member Selected -->
      <template x-if="!selectedMember && editableMembers.length > 0">
        <div style="text-align:center;padding:60px 20px;">
          <iconify-icon icon="solar:user-check-bold-duotone" width="48" style="color:#e0e6ed;"></iconify-icon>
          <p style="font-size:14px;color:#94a3b8;margin-top:12px;">Sélectionnez un membre ci-dessus pour configurer ses permissions</p>
        </div>
      </template>

      <!-- No Editable Members -->
      <template x-if="editableMembers.length === 0 && !loading">
        <div style="text-align:center;padding:60px 20px;">
          <iconify-icon icon="solar:users-group-rounded-bold-duotone" width="48" style="color:#e0e6ed;"></iconify-icon>
          <p style="font-size:14px;color:#94a3b8;margin-top:12px;">Aucun membre à configurer. Seuls les membres non-owner peuvent avoir des permissions personnalisées.</p>
        </div>
      </template>
    </div>
  </template>
</div>
</div>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('permissionsHub', () => ({
    loading: true,
    members: [],
    allEntities: [],
    selectedMember: null,
    permMap: {}, // { entityId: { create, read, update, delete } }
    saveStatus: '', // 'saving' | 'saved' | 'error'
    saveTimeout: null,
    apiBase: '/account/<%= account_number %>/api/team',

    async init() {
      // Check URL param for preselected user
      const params = new URLSearchParams(window.location.search);
      const preselectedUserId = params.get('user');

      await Promise.all([this.fetchMembers(), this.fetchEntities()]);
      this.loading = false;

      // Auto-select if user param provided
      if (preselectedUserId) {
        const member = this.editableMembers.find(m => String(m._id) === preselectedUserId);
        if (member) this.selectMember(member);
      }
    },

    get editableMembers() {
      return this.members.filter(m => m.role !== 'owner');
    },

    async fetchMembers() {
      try {
        const res = await fetch(this.apiBase + '/members', { credentials: 'include' });
        const data = await res.json();
        if (data.success) this.members = data.members;
      } catch (e) { console.error('Fetch members error:', e); }
    },

    async fetchEntities() {
      try {
        const res = await fetch(this.apiBase + '/entities', { credentials: 'include' });
        const data = await res.json();
        if (data.success) this.allEntities = data.entities;
      } catch (e) { console.error('Fetch entities error:', e); }
    },

    selectMember(member) {
      this.selectedMember = member;
      this.saveStatus = '';
      // Build permMap from member's entityPermissions
      this.permMap = {};
      (member.entityPermissions || []).forEach(ep => {
        this.permMap[ep.entityId] = {
          create: ep.create !== false,
          read: ep.read !== false,
          update: ep.update !== false,
          delete: ep.delete !== false,
        };
      });
    },

    getEntityPerm(entityId, action) {
      return !!this.permMap[entityId]?.[action];
    },

    togglePerm(entityId, action) {
      if (!this.permMap[entityId]) {
        this.permMap[entityId] = { create: false, read: false, update: false, delete: false };
      }
      this.permMap[entityId][action] = !this.permMap[entityId][action];

      // If enabling create/update/delete, also enable read
      if (action !== 'read' && this.permMap[entityId][action]) {
        this.permMap[entityId].read = true;
      }

      // Clean up: remove entity from map if all permissions are false
      const ep = this.permMap[entityId];
      if (!ep.create && !ep.read && !ep.update && !ep.delete) {
        delete this.permMap[entityId];
      }

      this.autoSave();
    },

    setAllPermissions(enable) {
      this.allEntities.forEach(entity => {
        this.permMap[entity._id] = {
          create: enable, read: enable, update: enable, delete: enable
        };
      });
      this.autoSave();
    },

    setReadOnly() {
      this.allEntities.forEach(entity => {
        this.permMap[entity._id] = {
          create: false, read: true, update: false, delete: false
        };
      });
      this.autoSave();
    },

    clearAllPermissions() {
      this.permMap = {};
      this.autoSave();
    },

    autoSave() {
      clearTimeout(this.saveTimeout);
      this.saveStatus = 'saving';
      this.saveTimeout = setTimeout(() => this.savePermissions(), 600);
    },

    async savePermissions() {
      if (!this.selectedMember) return;
      try {
        // Build entityPermissions array from permMap
        const entityPermissions = Object.entries(this.permMap).map(([entityId, perms]) => ({
          entityId,
          create: perms.create,
          read: perms.read,
          update: perms.update,
          delete: perms.delete,
        }));

        const res = await fetch(this.apiBase + '/update-permissions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({
            userId: String(this.selectedMember._id),
            entityPermissions,
          }),
        });
        const data = await res.json();
        if (data.success) {
          this.saveStatus = 'saved';
          // Update local member data
          const member = this.members.find(m => String(m._id) === String(this.selectedMember._id));
          if (member) {
            member.entityPermissions = entityPermissions;
            member.entityAccess = data.entityAccess;
          }
          setTimeout(() => { if (this.saveStatus === 'saved') this.saveStatus = ''; }, 2000);
        } else {
          this.saveStatus = 'error';
        }
      } catch (e) {
        console.error('Save permissions error:', e);
        this.saveStatus = 'error';
      }
    },

    avatarColor(name) {
      const colors = ['#4361ee','#805dca','#00ab55','#e7515a','#e2a03f','#2196f3','#3b3f5c','#009688'];
      let hash = 0;
      for (let i = 0; i < (name||'').length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
      return colors[Math.abs(hash) % colors.length];
    },

    roleColor(role) {
      const map = { owner:'#7c3aed', admin:'#4361ee', manager:'#f59e0b', member:'#22c55e', viewer:'#94a3b8' };
      return map[role] || '#94a3b8';
    },
  }));
});
</script>
