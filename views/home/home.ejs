        async toggleLayoutMode(force) {
            this.layoutMode = force !== undefined ? force : !this.layoutMode;
            if (this.layoutMode) {
                // Wait for Alpine to render the design-mode DOM, then init
                this.$nextTick(() => {
                    requestAnimationFrame(() => {
                        setTimeout(() => this._startObserver(), 100);
                    });
                });
            } else {
                this._stopObserver();
                this._destroySortables();
                await this._saveLayout();
            }
        },

        // ── Layout persistence ──
        async _loadLayout() {
            try {
                const res = await fetch(`/account/${_accountNumber}/api/user/view-preferences/${this._viewId}`, { credentials: 'include' });
                const data = await res.json();
                if (data.success && data.preferences && data.preferences.rows) {
                    const migrated = this._migrateLayoutPreferences(data.preferences);
                    this.rows = migrated.rows;
                    this.customWidgets = migrated.customWidgets;
                    this.widgetSettings = migrated.widgetSettings;
                    if (migrated.changed) this._saveLayout();
                }
            } catch (e) { /* use defaults */ }
        },

        async _saveLayout() {
            try {
                const res = await fetch(`/account/${_accountNumber}/api/user/view-preferences`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
                    body: JSON.stringify({ viewId: this._viewId, preferences: { rows: this.rows, customWidgets: this.customWidgets, widgetSettings: this.widgetSettings, homeLayoutVersion: this._layoutVersion } })
                });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json().catch(() => ({}));
                if (data.success === false) throw new Error(data.error || 'Save rejected');
                return true;
            } catch (e) {
                console.error('[HomeLayout] save error', e);
                return false;
            }
        },

	        _migrateLayoutPreferences(preferences = {}) {
	            const savedRows = Array.isArray(preferences.rows) ? preferences.rows : null;
	            let rows = JSON.parse(JSON.stringify(savedRows || this._defaultRows));
	            const customWidgets = this._normalizeCustomWidgets(preferences.customWidgets);
	            const widgetSettings = this._normalizeWidgetSettings(preferences.widgetSettings);
	            const storedVersion = Number(preferences.homeLayoutVersion || preferences.overviewLayoutVersion || 0);
	            let changed = storedVersion !== this._layoutVersion;

	            if ((storedVersion > 0 && storedVersion < 3) || (!storedVersion && savedRows && !this._looksLikeCurrentHomeLayout(rows))) {
	                rows = JSON.parse(JSON.stringify(this._defaultRows));
	                changed = true;
	            }

	            const repaired = this._repairCollapsedHomeRows(rows, customWidgets);
	            if (repaired.changed) {
	                rows = repaired.rows;
	                changed = true;
	            }

	            this._normalizeRows(rows);
	            return { rows, customWidgets, widgetSettings, changed };
	        },

	        _repairCollapsedHomeRows(rows, customWidgets = {}) {
	            const ids = this._collectWidgetIds(rows);
	            const defaultIds = this._collectWidgetIds(this._defaultRows);
	            const defaultSet = new Set(defaultIds);
	            const presentDefaultCount = ids.filter(id => defaultSet.has(id)).length;
	            const hasCollapsedSingleRow = Array.isArray(rows)
	                && rows.length <= 1
	                && presentDefaultCount >= 5
	                && ids.length >= 6;
	            const isTooSparse = Array.isArray(rows) && ids.length > 0 && ids.length < 4 && !Object.keys(customWidgets || {}).length;
	            if (!hasCollapsedSingleRow && !isTooSparse) return { rows, changed: false };

	            const repaired = JSON.parse(JSON.stringify(this._defaultRows));
	            const customIds = ids.filter(id => id && !defaultSet.has(id));
	            if (customIds.length) {
	                const target = this._homeMigrationColumn(repaired);
	                target.widgetIds = Array.from(new Set([...(target.widgetIds || []), ...customIds]));
	            }
	            return { rows: repaired, changed: true };
	        },

	        _normalizeRows(rows) {
	            (rows || []).forEach(row => {
	                row.columns = Array.isArray(row.columns) ? row.columns : [];
	                row.columns.forEach(col => {
	                    col.widgetIds = Array.isArray(col.widgetIds) ? col.widgetIds : [];
	                    col.childRows = Array.isArray(col.childRows) ? col.childRows : [];
	                    this._normalizeRows(col.childRows);
	                });
	            });
	        },

	        isNestedOnlyColumn(col) {
	            return !(col?.widgetIds || []).length && !!(col?.childRows || []).length;
	        },

	        _collectWidgetIds(rows) {
	            const ids = [];
	            this._walkColumns(rows, col => {
	                ids.push(...(col.widgetIds || []));
	            });
	            return ids;
	        },

	        _looksLikeCurrentHomeLayout(rows) {
	            const homeWidgetIds = new Set([
	                'priority-day', 'upcoming-events', 'important-dates', 'objectives',
	                'tasks', 'finance', 'shopping-list', 'tasks-by-record',
	                'activity-timeline', 'ai-feed', 'weekly-timeline'
	            ]);
	            let hasNestedRows = false;
	            this._walkColumns(rows, col => {
	                if ((col.childRows || []).length) hasNestedRows = true;
	            });
	            return hasNestedRows || this._collectWidgetIds(rows).some(id => homeWidgetIds.has(id));
	        },

	        _homeMigrationColumn(rows) {
	            const allColumns = [];
	            this._walkColumns(rows, col => allColumns.push(col));
	            const preferred = allColumns.find(col => (col.widgetIds || []).some(id => ['stats', 'quick-links'].includes(id)));
	            if (preferred) return preferred;
	            if (allColumns.length) return allColumns.reduce((best, col) => (col.width || 12) < (best.width || 12) ? col : best, allColumns[0]);
            const fallback = { id: 'c_home_events_' + Date.now(), width: 12, widgetIds: [] };
            rows.push({ id: 'r_home_events_' + Date.now(), columns: [fallback] });
            return fallback;
        },

        _normalizeCustomWidgets(value) {
            if (!value) return {};
            if (Array.isArray(value)) {
                return value.reduce((acc, w) => { if (w && w.id) acc[String(w.id)] = w; return acc; }, {});
            }
            return typeof value === 'object' ? value : {};
	        },

	        _normalizeWidgetSettings(value) {
	            if (!value || typeof value !== 'object' || Array.isArray(value)) return {};
	            return Object.entries(value).reduce((acc, [id, settings]) => {
	                if (!id || !settings || typeof settings !== 'object') return acc;
	                acc[String(id)] = {
	                    ...settings,
	                    config: JSON.parse(JSON.stringify(settings.config || {}))
	                };
	                return acc;
	            }, {});
	        },

	        // ── Row/Column management ──
	        addRow() {
	            this.rows.push({ id: 'r_' + Date.now(), columns: [{ id: 'c_' + Date.now(), width: 12, widgetIds: [] }] });
	            this._saveLayout();
	        },
	        removeRow(rowId) { this.rows = this.rows.filter(r => r.id !== rowId); this._saveLayout(); },
	        addNestedRow(parentColId) {
	            const found = this._findColumn(parentColId);
	            if (!found || found.depth >= 1) return;
	            const stamp = Date.now();
	            const col = found.col;
	            col.childRows = Array.isArray(col.childRows) ? col.childRows : [];
	            col.childRows.push({
	                id: 'nr_' + stamp,
	                columns: [
	                    { id: 'nc_' + stamp + '_1', width: 6, widgetIds: [] },
	                    { id: 'nc_' + stamp + '_2', width: 6, widgetIds: [] }
	                ]
	            });
	            this._saveLayout();
	            this.$nextTick(() => this._scheduleSortableInit());
	        },
		        removeNestedRow(parentColId, rowId) {
		            const found = this._findColumn(parentColId);
		            if (!found) return;
		            found.col.childRows = (found.col.childRows || []).filter(row => row.id !== rowId);
		            this._saveLayout();
		        },
		        moveNestedRow(parentColId, rowId, direction) {
		            const found = this._findColumn(parentColId);
		            const childRows = found?.col?.childRows;
		            if (!Array.isArray(childRows)) return;
		            const index = childRows.findIndex(row => row.id === rowId);
		            const nextIndex = index + Number(direction || 0);
		            if (index < 0 || nextIndex < 0 || nextIndex >= childRows.length) return;
		            const [moved] = childRows.splice(index, 1);
		            childRows.splice(nextIndex, 0, moved);
		            this._saveLayout();
		            this.$nextTick(() => this._scheduleSortableInit());
		        },
		        splitColumn(rowId, colId) {
	            const foundRow = this._findRow(rowId);
	            const row = foundRow?.row;
	            if (!row) return;
	            const ci = row.columns.findIndex(c => c.id === colId);
	            if (ci === -1) return;
	            const col = row.columns[ci];
	            if (col.width < 4) return;
	            const half = Math.floor(col.width / 2);
	            col.width = col.width - half;
	            row.columns.splice(ci + 1, 0, { id: 'c_' + Date.now(), width: half, widgetIds: [] });
	            this._saveLayout();
	        },
	        removeColumn(rowId, colId) {
	            const foundRow = this._findRow(rowId);
	            const row = foundRow?.row;
	            if (!row || row.columns.length <= 1) return;
	            const ci = row.columns.findIndex(c => c.id === colId);
	            if (ci === -1) return;
            const removed = row.columns.splice(ci, 1)[0];
            const neighbor = row.columns[Math.min(ci, row.columns.length - 1)];
	            if (neighbor) neighbor.width = Math.min(12, neighbor.width + removed.width);
	            this._saveLayout();
	        },
	        _walkColumns(rows, cb, depth = 0, parentRow = null) {
	            (rows || []).forEach(row => {
	                (row.columns || []).forEach(col => {
	                    cb(col, row, depth, parentRow);
	                    this._walkColumns(col.childRows || [], cb, depth + 1, row);
	                });
	            });
	        },
	        _findColumn(colId) {
	            let found = null;
	            this._walkColumns(this.rows, (col, row, depth) => {
	                if (!found && col.id === colId) found = { col, row, depth };
	            });
	            return found;
	        },
	        _findRow(rowId, rows = this.rows, parentCol = null, depth = 0) {
	            for (const row of rows || []) {
	                if (row.id === rowId) return { row, parentCol, depth };
	                for (const col of row.columns || []) {
	                    const nested = this._findRow(rowId, col.childRows || [], col, depth + 1);
	                    if (nested) return nested;
	                }
	            }
	            return null;
	        },

	        // ── Widget management ──
	        _placedWidgets() {
	            const ids = [];
	            this._walkColumns(this.rows, col => ids.push(...(col.widgetIds || [])));
	            return ids;
	        },
	        addWidget(colId, widgetId, options = {}) {
	            if (!options.allowDuplicate && this._placedWidgets().includes(widgetId)) return;
	            const found = this._findColumn(colId);
	            if (!found) return;
	            found.col.widgetIds = Array.isArray(found.col.widgetIds) ? found.col.widgetIds : [];
	            found.col.widgetIds.push(widgetId);
	            if (options.save !== false) this._saveLayout();
	        },
	        removeWidget(widgetId, colId = '', index = -1) {
	            const removeFromColumn = (col) => {
	                col.widgetIds = Array.isArray(col.widgetIds) ? col.widgetIds : [];
	                const numericIndex = Number(index);
	                if (Number.isInteger(numericIndex) && numericIndex >= 0 && col.widgetIds[numericIndex] === widgetId) {
	                    col.widgetIds.splice(numericIndex, 1);
	                    return true;
	                }
	                const foundIndex = col.widgetIds.findIndex(w => w === widgetId);
	                if (foundIndex >= 0) {
	                    col.widgetIds.splice(foundIndex, 1);
	                    return true;
	                }
	                return false;
	            };
	            if (colId) {
	                const found = this._findColumn(colId);
	                if (found?.col && removeFromColumn(found.col)) {
	                    this._saveLayout();
	                    return;
	                }
	            }
	            let removed = false;
	            this._walkColumns(this.rows, c => {
	                if (!removed) removed = removeFromColumn(c);
	            });
	            if (removed) this._saveLayout();
	        },
	        isCustomWidget(wid) { return !!(this.customWidgets && this.customWidgets[wid]); },
	        baseWidgetMeta(wid) {
	            if (this.isCustomWidget(wid)) return this.getCustomWidget(wid);
	            return this._defaultWidgetCatalog[wid] || { type: wid, label: 'Widget', icon: 'solar:widget-bold-duotone', color: '#4361ee', config: {} };
	        },
	        getCustomWidget(wid) {
	            return (this.customWidgets && this.customWidgets[wid]) || { type: '', label: 'Widget', icon: 'solar:widget-bold-duotone', color: '#4361ee', config: {} };
	        },
	        getWidgetSettings(wid) {
	            const base = this.baseWidgetMeta(wid);
	            const saved = (this.widgetSettings && this.widgetSettings[wid]) || {};
	            return {
	                ...base,
	                ...saved,
	                id: wid,
		                _id: wid,
		                type: saved.type || base.type || wid,
		                label: saved.label || base.label || this.customWidgetLabel(base.type || wid),
		                icon: this.normalizedHomeWidgetIcon(wid, saved.icon || base.icon || this.customWidgetIcon(base.type || wid)),
		                color: saved.color || base.color || '#4361ee',
	                config: {
	                    ...(base.config || {}),
	                    ...(saved.config || {})
	                }
	            };
		        },
		        normalizedHomeWidgetIcon(wid, icon) {
		            if (wid === 'today-tasks' && icon === 'solar:checklist-minimalistic-bold-duotone') {
		                return 'solar:calendar-date-bold-duotone';
		            }
		            return icon;
		        },
		        customWidgetConfig(wid) {
	            if (this.isCustomWidget(wid)) return this.getCustomWidget(wid).config || {};
	            return this.getWidgetSettings(wid).config || {};
	        },
	        widgetTitle(wid, fallback = 'Widget') { return this.getWidgetSettings(wid).label || fallback; },
	        widgetIcon(wid, fallback = 'solar:widget-bold-duotone') { return this.getWidgetSettings(wid).icon || fallback; },
	        widgetColor(wid, fallback = '#4361ee') { return this.getWidgetSettings(wid).color || fallback; },
	        widgetOption(wid, key, fallback = null) {
	            const cfg = this.getWidgetSettings(wid).config || {};
	            return cfg[key] !== undefined ? cfg[key] : fallback;
	        },
	        widgetLimit(wid, fallback = 5) {
	            return Math.max(1, Math.min(40, Number(this.widgetOption(wid, 'limit', fallback)) || fallback));
	        },
	        widgetShowLink(wid, fallback = true) {
	            const value = this.widgetOption(wid, 'showLink', fallback);
	            return value !== false;
	        },
	        widgetShared(wid, fallback = false) {
	            return this.widgetOption(wid, 'shared', fallback) === true;
	        },
	        customWidgetIcon(type) {
	            const m = { note:'solar:notes-bold-duotone', notes:'solar:notes-bold-duotone', html:'solar:code-bold-duotone', iframe:'solar:monitor-bold-duotone', video:'solar:video-library-bold-duotone', link:'solar:link-round-bold-duotone', image:'solar:gallery-bold-duotone', separator:'solar:minus-circle-bold-duotone', timeline:'solar:clock-circle-bold-duotone', kpi:'solar:graph-up-bold-duotone', chart:'solar:chart-bold-duotone', fields:'solar:layers-bold-duotone', cards:'solar:card-bold-duotone', tasks:'solar:checklist-bold-duotone', 'task-list':'solar:checklist-bold-duotone' };
	            return m[type] || 'solar:widget-bold-duotone';
	        },
	        customWidgetLabel(type) {
	            const m = { note:'Note', notes:'Notes', html:'HTML', iframe:'Embed', video:'Vidéo', link:'Lien', image:'Image', separator:'Séparateur', timeline:'Timeline', kpi:'KPI', chart:'Graphique', fields:'Champs', cards:'Cartes', tasks:'Checklist', 'task-list':'Liste de tâches' };
	            return m[type] || 'Widget';
	        },
        isEmbeddableVideo(url) {
            const v = String(url || '').toLowerCase();
            return v.includes('youtube.com') || v.includes('youtu.be') || v.includes('vimeo.com');
        },
	        videoEmbedUrl(url) {
	            const v = String(url || '').trim();
	            try {
	                const p = new URL(v);
                if (p.hostname.includes('youtu.be')) { const id = p.pathname.split('/').filter(Boolean)[0]; return id ? `https://www.youtube.com/embed/${id}` : v; }
                if (p.hostname.includes('youtube.com')) { const id = p.searchParams.get('v') || p.pathname.split('/').filter(Boolean).pop(); return id ? `https://www.youtube.com/embed/${id}` : v; }
                if (p.hostname.includes('vimeo.com')) { const id = p.pathname.split('/').filter(Boolean).pop(); return id ? `https://player.vimeo.com/video/${id}` : v; }
            } catch (e) {}
	            return v;
	        },

	        homeWidgetsForPicker() {
	            return Object.entries(this.customWidgets || {})
	                .filter(([, widget]) => widget)
	                .map(([id, widget]) => ({
	                    id: String(widget.id || id),
	                    type: widget.type || '',
	                    label: widget.label || this.customWidgetLabel(widget.type),
	                    icon: widget.icon || this.customWidgetIcon(widget.type),
	                    color: widget.color || '#4361ee',
	                    config: JSON.parse(JSON.stringify(widget.config || {})),
	                    usageCount: this.widgetUsageCount(String(widget.id || id))
	                }));
	        },
	        widgetUsageCount(widgetId) {
	            let count = 0;
	            this._walkColumns(this.rows, col => {
	                count += (col.widgetIds || []).filter(id => id === widgetId).length;
	            });
	            return count;
	        },

	        // ── Widget picker integration ──
	        openWidgetPicker(colId) {
	            const picker = window.Alpine && window.Alpine.store ? window.Alpine.store('widgetPicker') : null;
	            if (!picker) { window.showMessage && window.showMessage('Widget picker indisponible', 'danger'); return; }
	            picker.initPicker({
	                accountNumber: _accountNumber,
	                gridSchemas: [],
	                taskLists: this.homeTaskLists,
	                homeWidgets: this.homeWidgetsForPicker()
	            });
	            picker.initOpen({ type: 'home-overview', colId, accountNumber: _accountNumber });
	        },
	        openWidgetSettings(wid) {
	            const picker = window.Alpine && window.Alpine.store ? window.Alpine.store('widgetPicker') : null;
	            if (!picker) { window.showMessage && window.showMessage('Widget picker indisponible', 'danger'); return; }
	            picker.initPicker({
	                accountNumber: _accountNumber,
	                gridSchemas: [],
	                taskLists: this.homeTaskLists,
	                homeWidgets: this.homeWidgetsForPicker()
	            });
	            picker.openEditWidget(
	                { type: 'home-overview', widgetId: wid, accountNumber: _accountNumber },
	                this._widgetForPicker(wid)
	            );
	        },
	        _widgetForPicker(wid) {
	            const meta = this.getWidgetSettings(wid);
	            return {
	                _id: wid,
	                id: wid,
	                type: meta.type || wid,
	                label: meta.label || this.widgetTitle(wid),
	                icon: meta.icon || this.widgetIcon(wid),
	                color: meta.color || this.widgetColor(wid),
	                config: JSON.parse(JSON.stringify(meta.config || {}))
	            };
	        },
        insertWidgetFromPicker(detail) {
            const target = detail?.target || {};
            if (target.type && target.type !== 'home-overview') return;
            const colId = target.colId;
            const widget = detail?.widget || null;
            if (!colId || !widget) return;

            const widgetIds = this._homeWidgetIdsFromPickerWidget(widget);
            widgetIds.forEach(wid => this.addWidget(colId, wid, { save: false, allowDuplicate: wid.startsWith('cw_') }));
            this._saveLayout();
            this.$nextTick(() => this._scheduleSortableInit());
        },
        _updateWidgetFromPicker(detail) {
            const widget = detail?.widget || null;
            if (!widget || !widget._id) return;
	            if (this.customWidgets[widget._id]) {
	                const existing = this.customWidgets[widget._id];
	                this.customWidgets = {
	                    ...this.customWidgets,
	                    [widget._id]: { ...existing, ...widget, config: JSON.parse(JSON.stringify(widget.config || {})) }
	                };
	            } else {
	                const base = this.baseWidgetMeta(widget._id);
	                this.widgetSettings = {
	                    ...this.widgetSettings,
	                    [widget._id]: {
	                        type: widget.type || base.type || widget._id,
	                        label: widget.label || base.label || 'Widget',
	                        icon: widget.icon || base.icon || 'solar:widget-bold-duotone',
	                        color: widget.color || base.color || '#4361ee',
	                        config: JSON.parse(JSON.stringify(widget.config || {}))
	                    }
	                };
            }
            this._saveLayout();
        },
	        deleteCustomWidgetFromPicker(detail) {
	            const widgetId = String(detail?.widgetId || '');
	            if (!widgetId || !this.customWidgets?.[widgetId]) return;
	            const nextCustomWidgets = { ...(this.customWidgets || {}) };
	            delete nextCustomWidgets[widgetId];
	            this.customWidgets = nextCustomWidgets;
	            const nextSettings = { ...(this.widgetSettings || {}) };
	            delete nextSettings[widgetId];
	            this.widgetSettings = nextSettings;
	            this._walkColumns(this.rows, col => {
	                col.widgetIds = (col.widgetIds || []).filter(id => id !== widgetId);
	            });
	            this._saveLayout();
	            this.$nextTick(() => this._scheduleSortableInit());
	            window.showMessage && window.showMessage('Widget personnalisé supprimé', 'success');
	        },
	        _homeWidgetIdsFromPickerWidget(widget) {
		            const type = String(widget.type || '');
	            const existingId = String(widget._id || widget.id || '');
	            if (existingId && this.customWidgets?.[existingId]) return [existingId];
		            const homeMap = {
	                'home-priority-day': 'priority-day',
	                'home-today-tasks': 'today-tasks',
	                'home-objectives': 'objectives',
	                'home-tasks': 'tasks',
	                'home-finance': 'finance',
	                'home-shopping-list': 'shopping-list',
	                'home-tasks-by-record': 'tasks-by-record',
	                'home-activity-timeline': 'activity-timeline',
	                'home-ai-feed': 'ai-feed',
	                'home-weekly-timeline': 'weekly-timeline',
	                'home-stats': 'stats',
	                'home-recent-records': 'recent-records',
	                'home-upcoming-events': 'upcoming-events',
                'home-important-dates': 'important-dates',
                'home-quick-links': 'quick-links'
            };
            if (homeMap[type]) return [homeMap[type]];
            // Custom widget
            const id = 'cw_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
            this.customWidgets = {
                ...this.customWidgets,
                [id]: { id, type, label: widget.label || this.customWidgetLabel(type), icon: widget.icon || this.customWidgetIcon(type), color: widget.color || '#4361ee', config: JSON.parse(JSON.stringify(widget.config || {})) }
            };
            return [id];
        },

        // ── Sortable ──
        _startObserver() {
            this._stopObserver();
            this._scheduleSortableInit();
            const container = this.$refs.ovRowContainer;
            if (!container) return;
            this._observer = new MutationObserver(() => {
                if (!this._sortableIniting && !this._isDragging) this._scheduleSortableInit();
            });
            this._observer.observe(container, { childList: true, subtree: true });
        },
        _stopObserver() {
            if (this._observer) { this._observer.disconnect(); this._observer = null; }
            if (this._sortableTimer) { clearTimeout(this._sortableTimer); this._sortableTimer = null; }
        },
        _scheduleSortableInit() {
            if (this._sortableTimer) clearTimeout(this._sortableTimer);
            this._sortableTimer = setTimeout(() => this._initSortables(), 80);
        },
        _initSortables() {
            this._sortableIniting = true;
            this._destroySortables();
            if (typeof Sortable === 'undefined') { this._sortableIniting = false; return; }
            const self = this;
            const rowContainer = this.$refs.ovRowContainer;
            const colEls = rowContainer ? rowContainer.querySelectorAll('.ov-col-widgets:not(.ov-col-widgets-nested-only)') : [];
            // Retry if Alpine x-for hasn't rendered the columns yet
            if (colEls.length === 0 && this.rows.length > 0) {
                this._sortableIniting = false;
                setTimeout(() => this._initSortables(), 300);
                return;
            }
	            if (rowContainer) {
	                this._sortables.push(new Sortable(rowContainer, {
                    animation: 150,
                    handle: '.ov-row-drag',
                    ghostClass: 'ov-sort-ghost',
                    draggable: '.ov-layout-row',
                    filter: '.ov-layout-row-nested',
                    scroll: true,
                    forceAutoScrollFallback: true,
                    scrollSensitivity: 80,
                    scrollSpeed: 14,
                    bubbleScroll: true,
                    onStart() {
                        self._setLayoutDragging(true);
                    },
                    onEnd(evt) {
                        self._setLayoutDragging(false);
                        const rowId = evt.item.dataset.rowId;
                        const oldIdx = evt.oldIndex, newIdx = evt.newIndex;
                        if (oldIdx === newIdx) return;
                        evt.from.removeChild(evt.item);
                        const rows = evt.from.querySelectorAll(':scope > .ov-layout-row');
                        if (oldIdx >= rows.length) evt.from.appendChild(evt.item);
                        else evt.from.insertBefore(evt.item, rows[oldIdx]);
                        const idx = self.rows.findIndex(r => r.id === rowId);
                        if (idx === -1) return;
                        const [moved] = self.rows.splice(idx, 1);
                        self.rows.splice(newIdx, 0, moved);
                        self._saveLayout();
	                    }
	                }));
	            }
	            const nestedRowEls = rowContainer ? rowContainer.querySelectorAll('.ov-nested-rows') : [];
	            nestedRowEls.forEach(nestedEl => {
	                this._sortables.push(new Sortable(nestedEl, {
	                    animation: 150,
	                    handle: '.ov-nested-row-drag',
	                    ghostClass: 'ov-sort-ghost',
	                    draggable: '.ov-layout-row-nested',
	                    direction: 'vertical',
	                    forceFallback: true,
	                    fallbackOnBody: true,
	                    fallbackTolerance: 3,
	                    scroll: true,
	                    forceAutoScrollFallback: true,
	                    scrollSensitivity: 80,
	                    scrollSpeed: 14,
	                    bubbleScroll: true,
	                    onStart() {
	                        self._setLayoutDragging(true);
	                    },
	                    onEnd(evt) {
	                        self._setLayoutDragging(false);
	                        const parentColId = evt.from.dataset.nestedParentId;
	                        const rowId = evt.item.dataset.rowId;
	                        const oldIdx = evt.oldIndex, newIdx = evt.newIndex;
	                        if (!parentColId || !rowId || oldIdx === newIdx) return;
	                        if (evt.item.parentNode) evt.item.parentNode.removeChild(evt.item);
	                        const rows = evt.from.querySelectorAll(':scope > .ov-layout-row-nested');
	                        if (oldIdx >= rows.length) evt.from.appendChild(evt.item);
	                        else evt.from.insertBefore(evt.item, rows[oldIdx] || null);
	                        const found = self._findColumn(parentColId);
	                        const childRows = found?.col?.childRows;
	                        if (!Array.isArray(childRows)) return;
	                        const idx = childRows.findIndex(row => row.id === rowId);
	                        if (idx === -1) return;
	                        const [moved] = childRows.splice(idx, 1);
	                        childRows.splice(newIdx, 0, moved);
	                        self._saveLayout();
	                    }
	                }));
	            });
	            colEls.forEach(colEl => {
	                this._sortables.push(new Sortable(colEl, {
                    animation: 150,
                    handle: '.ov-widget-drag',
                    ghostClass: 'ov-sort-ghost',
                    draggable: '.ov-widget-wrap',
                    group: 'ov-widgets',
                    swapThreshold: 0.65,
                    invertSwap: true,
                    emptyInsertThreshold: 80,
                    filter: '.ov-add-choice, .ov-add-widget-btn, .ov-add-nested-row-btn, .ov-nested-add-widget',
                    scroll: true,
                    forceAutoScrollFallback: true,
                    scrollSensitivity: 80,
                    scrollSpeed: 14,
                    bubbleScroll: true,
                    onStart() {
                        self._setLayoutDragging(true);
                    },
                    onEnd(evt) {
                        const widgetId = evt.item.dataset.widgetId;
                        const fromColId = evt.from.dataset.colId;
                        const toColEl = self._resolveWidgetDropTarget(evt);
                        const toColId = toColEl?.dataset?.colId || '';
                        self._setLayoutDragging(false);
                        if (!widgetId || !fromColId) return;
                        const toWidgets = Array.from((toColEl || evt.to).querySelectorAll(':scope > .ov-widget-wrap'));
                        let newIdx = toWidgets.indexOf(evt.item);
                        if (newIdx === -1) newIdx = toWidgets.length;
                        if (evt.item.parentNode) evt.item.parentNode.removeChild(evt.item);
                        const fromWidgets = Array.from(evt.from.querySelectorAll(':scope > .ov-widget-wrap'));
                        if (evt.oldIndex >= fromWidgets.length) evt.from.appendChild(evt.item);
                        else evt.from.insertBefore(evt.item, fromWidgets[evt.oldIndex] || null);
                        const fromFound = self._findColumn(fromColId);
                        const toFound = self._findColumn(toColId);
                        const fromCol = fromFound?.col || null;
                        const toCol = toFound?.col || null;
                        if (!fromCol || !toCol) return;
                        fromCol.widgetIds = Array.isArray(fromCol.widgetIds) ? fromCol.widgetIds : [];
                        const fi = fromCol.widgetIds.findIndex(w => w === widgetId);
                        if (fi === -1) return;
                        fromCol.widgetIds.splice(fi, 1);
                        toCol.widgetIds = Array.isArray(toCol.widgetIds) ? toCol.widgetIds : [];
                        toCol.widgetIds.splice(newIdx, 0, widgetId);
                        self._saveLayout();
                    }
                }));
            });
            this._sortableIniting = false;
        },
        _destroySortables() {
            this._sortables.forEach(s => { try { s.destroy(); } catch(e) {} });
            this._sortables = [];
        },
        _setLayoutDragging(isDragging) {
            this._isDragging = !!isDragging;
            this.$el?.classList.toggle('ov-dragging', !!isDragging);
        },
        _resolveWidgetDropTarget(evt) {
            const isUsableDropCol = (el) => el && el.classList?.contains('ov-col-widgets') && !el.classList.contains('ov-col-widgets-nested-only');
            let colEl = null;

            const originalEvent = evt?.originalEvent;
            if (originalEvent && Number.isFinite(originalEvent.clientX) && Number.isFinite(originalEvent.clientY)) {
                const pointedEl = document.elementFromPoint(originalEvent.clientX, originalEvent.clientY);
                colEl = pointedEl?.closest?.('.ov-col-widgets') || null;
                if (!isUsableDropCol(colEl)) {
                    colEl = pointedEl?.closest?.('.ov-layout-col')?.querySelector?.(':scope > .ov-col-widgets') || null;
                }
            }

            if (!isUsableDropCol(colEl)) {
                colEl = evt?.to?.classList?.contains('ov-col-widgets') ? evt.to : null;
            }
            if (!isUsableDropCol(colEl)) {
                colEl = evt?.to?.closest?.('.ov-col-widgets') || null;
            }
            if (!colEl && evt?.to?.querySelector) {
                colEl = evt.to.querySelector(':scope > .ov-col-widgets');
            }

            return isUsableDropCol(colEl) ? colEl : null;
        },

        // ── Resize ──
        _onResizeStart(e, rowId, colIndex) {
            e.preventDefault();
            const foundRow = this._findRow(rowId);
            const row = foundRow?.row;
            const col = row?.columns?.[colIndex];
            const next = row?.columns?.[colIndex + 1];
            if (!col || !next) return;
            if (e.currentTarget?.setPointerCapture && e.pointerId != null) {
                try { e.currentTarget.setPointerCapture(e.pointerId); } catch (err) {}
            }
            this._resizing = {
                rowId,
                colIndex,
                startX: e.clientX,
                rowEl: e.currentTarget.closest('.ov-layout-row'),
                startColWidth: Number(col.width) || 0,
                startNextWidth: Number(next.width) || 0
            };
            document.body.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
        },
        _resizeUnitWidth(rowEl, row) {
            if (!rowEl) return 0;
            const styles = window.getComputedStyle(rowEl);
            const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
            const paddingLeft = parseFloat(styles.paddingLeft || '0') || 0;
            const paddingRight = parseFloat(styles.paddingRight || '0') || 0;
            const columnCount = Math.max(1, (row?.columns || []).length);
            const usableWidth = rowEl.clientWidth - paddingLeft - paddingRight - (gap * Math.max(0, columnCount - 1));
            return Math.max(1, usableWidth / 12);
        },
        _onResizeMove(e) {
            if (!this._resizing) return;
            const foundRow = this._findRow(this._resizing.rowId);
            const row = foundRow?.row;
            if (!row) return;
            const ci = this._resizing.colIndex;
            const col = row.columns[ci], next = row.columns[ci + 1];
            if (!col || !next) return;
            const rowEl = this._resizing.rowEl?.isConnected
                ? this._resizing.rowEl
                : this.$el.querySelector(`[data-row-id="${this._resizing.rowId}"]`);
            if (!rowEl) return;
            const unitW = this._resizeUnitWidth(rowEl, row);
            if (!unitW) return;
            const startColWidth = this._resizing.startColWidth;
            const startNextWidth = this._resizing.startNextWidth;
            let delta = Math.round((e.clientX - this._resizing.startX) / unitW);
            delta = Math.max(2 - startColWidth, Math.min(startNextWidth - 2, delta));
            const newW = startColWidth + delta;
            const newNextW = startNextWidth - delta;
            if (col.width !== newW || next.width !== newNextW) {
                col.width = newW;
                next.width = newNextW;
            }
        },
        _onResizeEnd() {
            if (!this._resizing) return;
            this._resizing = null;
            document.body.style.cursor = '';
            document.body.style.userSelect = '';
            this._saveLayout();
	        },

	        // ── Helpers ──
	        productivityPct() {
	            const total = Number(this.stats.totalTasks || 0);
	            const done = Number(this.stats.doneTasks || 0);
	            if (!total) return 0;
	            return Math.max(0, Math.min(100, Math.round((done / total) * 100)));
	        },
