<!-- Timeline Widgets Demo Page -->
<div class="animate__animated p-6" :class="[$store.app.animation]">
  <!-- Breadcrumb -->
  <ul class="flex space-x-2 rtl:space-x-reverse mb-6">
    <li>
      <a href="javascript:;" class="text-primary hover:underline">Components</a>
    </li>
    <li class="before:content-['/'] ltr:before:mr-1 rtl:before:ml-1">
      <span>Timeline Widgets</span>
    </li>
  </ul>

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-2xl font-bold dark:text-white-light mb-2">Timeline Widget Library</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400">
      Bibliothèque de composants Timeline réutilisables — React Islands prêts pour le Page Builder & Cockpit Builder
    </p>
  </div>

  <!-- React Island Mount Points -->
  <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">

    <!-- 1. Profile Timeline -->
    <div class="panel">
      <div class="mb-5 flex items-center justify-between">
        <h5 class="text-lg font-semibold dark:text-white-light">
          <iconify-icon icon="solar:user-bold-duotone" width="20" class="text-primary mr-2 align-middle"></iconify-icon>
          Profile Timeline
        </h5>
        <span class="badge bg-primary/10 text-primary rounded-full px-3 py-1 text-xs">island: timeline-widget</span>
      </div>
      <div 
        data-island="timeline-widget"
        data-account-number="<%= account_number %>"
        data-variant="profile"
        data-api-url="/account/<%= account_number %>/api/demo/timeline-data?variant=profile"
      ></div>
    </div>

    <!-- 2. Modern Timeline -->
    <div class="panel">
      <div class="mb-5 flex items-center justify-between">
        <h5 class="text-lg font-semibold dark:text-white-light">
          <iconify-icon icon="solar:layers-bold-duotone" width="20" class="text-info mr-2 align-middle"></iconify-icon>
          Modern Timeline
        </h5>
        <span class="badge bg-info/10 text-info rounded-full px-3 py-1 text-xs">island: timeline-widget</span>
      </div>
      <div 
        data-island="timeline-widget"
        data-account-number="<%= account_number %>"
        data-variant="modern"
        data-api-url="/account/<%= account_number %>/api/demo/timeline-data?variant=modern"
      ></div>
    </div>

    <!-- 3. Basic Timeline -->
    <div class="panel">
      <div class="mb-5 flex items-center justify-between">
        <h5 class="text-lg font-semibold dark:text-white-light">
          <iconify-icon icon="solar:list-bold-duotone" width="20" class="text-success mr-2 align-middle"></iconify-icon>
          Basic Timeline
        </h5>
        <span class="badge bg-success/10 text-success rounded-full px-3 py-1 text-xs">island: timeline-widget</span>
      </div>
      <div 
        data-island="timeline-widget"
        data-account-number="<%= account_number %>"
        data-variant="basic"
        data-api-url="/account/<%= account_number %>/api/demo/timeline-data?variant=basic"
      ></div>
    </div>

    <!-- 4. With Images Timeline -->
    <div class="panel">
      <div class="mb-5 flex items-center justify-between">
        <h5 class="text-lg font-semibold dark:text-white-light">
          <iconify-icon icon="solar:gallery-bold-duotone" width="20" class="text-warning mr-2 align-middle"></iconify-icon>
          Timeline with Images
        </h5>
        <span class="badge bg-warning/10 text-warning rounded-full px-3 py-1 text-xs">island: timeline-widget</span>
      </div>
      <div 
        data-island="timeline-widget"
        data-account-number="<%= account_number %>"
        data-variant="images"
        data-api-url="/account/<%= account_number %>/api/demo/timeline-data?variant=images"
      ></div>
    </div>

  </div>

  <!-- Widget Library Section -->
  <div class="mt-10">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold dark:text-white-light">Widget Library</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
          Drag & drop ces widgets dans le Page Builder ou Cockpit Builder
        </p>
      </div>
    </div>

    <div 
      data-island="widget-library"
      data-account-number="<%= account_number %>"
      data-api-url="/account/<%= account_number %>/api/demo/widget-catalog"
    ></div>
  </div>
</div>

<!-- React Island Scripts -->
<script src="/dist/timelineWidget.js" type="module" defer></script>
<script src="/dist/widgetLibrary.js" type="module" defer></script>
