<%- include('../components/tag-picker') %>
<div x-data="recordForm()" class="space-y-4">
    <form action="/account/<%= account_number %>/record/<%= entity.slug %>/update/<%= record._id %>" method="POST"
        enctype="multipart/form-data" id="main-record-form">

        <!-- ═══════════════ HORIZONTAL TOOLBAR (Mission 1) ═══════════════ -->
        <div class="flex items-center justify-between px-5 py-2.5 bg-white dark:bg-[#1b2e4b] rounded-xl border border-gray-100 dark:border-gray-800 shadow-sm mb-4"
            x-data="{ showDeleteConfirm: false }">
            <!-- Left: Back + Entity/Title breadcrumb -->
            <div class="flex items-center gap-3 min-w-0">
                <a href="/account/<%= account_number %>/record/<%= entity.slug %>/list"
                    class="flex items-center justify-center w-8 h-8 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-all"
                    title="Retour à la liste">
                    <iconify-icon icon="solar:arrow-left-linear" width="18"></iconify-icon>
                </a>
                <div class="h-5 w-px bg-gray-200 dark:bg-gray-700"></div>
                <div class="flex items-center gap-2 min-w-0">
                    <span class="text-sm text-gray-400 dark:text-gray-500 font-medium whitespace-nowrap"><%= entity.name %></span>
                    <iconify-icon icon="solar:alt-arrow-right-linear" width="14" class="text-gray-300 dark:text-gray-600 flex-none"></iconify-icon>
                    <span class="text-sm font-semibold text-gray-700 dark:text-gray-200 truncate max-w-[300px]"><%= record.title || 'Sans titre' %></span>
                </div>
            </div>

            <!-- Center: Last modified -->
            <div class="hidden md:flex items-center gap-1.5 text-[10px] text-gray-400 dark:text-gray-500">
                <iconify-icon icon="solar:clock-circle-linear" width="12"></iconify-icon>
                <span>Modifié le <strong class="text-gray-500 dark:text-gray-400"><%= record.updatedAt ? new Date(record.updatedAt).toLocaleDateString('fr-FR') : '-' %></strong></span>
            </div>

            <!-- Right: Actions cluster -->
            <div class="flex items-center gap-2">
                <!-- Public toggle -->
                <label class="flex items-center gap-1.5 cursor-pointer px-2.5 py-1.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-all" title="Publier">
                    <input type="hidden" name="standard[published]" value="">
                    <input type="checkbox" name="standard[published]"
                        class="form-checkbox rounded text-success border-gray-300 dark:border-gray-600 focus:ring-0 !w-3.5 !h-3.5"
                        <%= record.published ? 'checked' : '' %>>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Public</span>
                </label>

                <div class="h-5 w-px bg-gray-200 dark:bg-gray-700"></div>

                <!-- Layout mode -->
                <button type="button" @click="designMode = !designMode"
                    :class="designMode ? 'text-primary bg-primary/10' : 'text-gray-400 hover:text-primary hover:bg-gray-50 dark:hover:bg-gray-700/50'"
                    class="flex items-center justify-center w-8 h-8 rounded-lg transition-all" title="Mode Layout">
                    <iconify-icon icon="tabler:layout-dashboard" width="16"></iconify-icon>
                </button>

                <div class="h-5 w-px bg-gray-200 dark:bg-gray-700"></div>

                <!-- Cancel -->
                <a href="/account/<%= account_number %>/record/<%= entity.slug %>/list"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-semibold text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all"
                    title="Annuler">
                    <iconify-icon icon="solar:close-circle-linear" width="14"></iconify-icon>
                    <span class="hidden sm:inline">Annuler</span>
                </a>

                <!-- Save -->
                <button type="submit" form="main-record-form"
                    class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-primary text-white text-[11px] font-bold hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20 transition-all"
                    x-data="{ submitting: false }" @submit.window="submitting = true"
                    :disabled="submitting"
                    :class="submitting ? 'opacity-60 cursor-wait' : ''">
                    <iconify-icon :icon="submitting ? 'line-md:loading-twotone-loop' : 'solar:diskette-bold'" width="14"></iconify-icon>
                    <span x-text="submitting ? 'Envoi...' : 'Enregistrer'">Enregistrer</span>
                </button>

                <!-- Delete -->
                <div class="relative">
                    <button type="button" @click="showDeleteConfirm = !showDeleteConfirm"
                        class="flex items-center justify-center w-8 h-8 rounded-lg text-gray-400 hover:text-danger hover:bg-danger/5 transition-all"
                        title="Supprimer">
                        <iconify-icon icon="solar:trash-bin-minimalistic-linear" width="15"></iconify-icon>
                    </button>
                    <!-- Delete confirm dropdown -->
                    <div x-show="showDeleteConfirm" x-transition @click.outside="showDeleteConfirm = false"
                        class="absolute right-0 top-full mt-2 bg-white dark:bg-[#1b2e4b] rounded-xl shadow-xl border border-gray-100 dark:border-gray-700 p-4 w-[220px] z-50">
                        <p class="text-xs text-gray-600 dark:text-gray-400 mb-3">Supprimer définitivement cet enregistrement ?</p>
                        <div class="flex items-center gap-2">
                            <button type="button" @click="showDeleteConfirm = false"
                                class="flex-1 px-3 py-1.5 text-[10px] font-semibold text-gray-500 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 transition-all">
                                Non
                            </button>
                            <a href="/account/<%= account_number %>/record/<%= entity.slug %>/delete/<%= record._id %>"
                                class="flex-1 px-3 py-1.5 text-[10px] font-bold text-white bg-danger rounded-lg hover:bg-danger/90 text-center transition-all">
                                Supprimer
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════════════ RELATION TABS BAR ═══════════════ -->
        <% if (locals.relationTabsMeta && locals.relationTabsMeta.length > 0) { %>
        <div x-data="relationTabs()" class="mb-4">
            <!-- Tab Bar -->
            <div class="flex items-center bg-white dark:bg-[#1b2e4b] rounded-xl border border-gray-100 dark:border-gray-800 shadow-sm overflow-hidden">
                <!-- Scrollable Tabs Container -->
                <div class="flex-1 flex items-center gap-0.5 overflow-x-auto hide-scrollbar px-1.5 py-1.5" id="relation-tabs-scroll">
                    <!-- Self Tab (entity itself) — always first -->
                    <button type="button"
                            @click="selectTab('__self__')"
                            class="relation-tab-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all duration-200 shrink-0 select-none"
                            :class="activeTab === '__self__'
                                ? 'bg-primary/10 text-primary shadow-sm ring-1 ring-primary/20'
                                : 'text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:text-gray-700 dark:hover:text-gray-300'">
                        <span class="w-5 h-5 rounded flex items-center justify-center shrink-0"
                              :style="activeTab === '__self__' ? 'background:<%= entity.color || '#4361ee' %>15; color:<%= entity.color || '#4361ee' %>' : ''">
                            <iconify-icon icon="<%= entity.icon || 'solar:widget-bold-duotone' %>" width="13"
                                :style="activeTab === '__self__' ? 'color:<%= entity.color || '#4361ee' %>' : ''"
                                :class="activeTab !== '__self__' ? 'text-gray-400 dark:text-gray-500' : ''"></iconify-icon>
                        </span>
                        <span><%= entity.name %></span>
                    </button>

                    <!-- Separator between self and relations -->
                    <div class="w-px h-5 bg-gray-200 dark:bg-gray-700 mx-1 shrink-0"></div>

                    <!-- Relation Tabs -->
                    <template x-for="tab in visibleTabs" :key="tab.key">
                        <div class="flex items-center shrink-0">
                            <button type="button"
                                    @click="selectTab(tab.key)"
                                    class="relation-tab-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-all duration-200 select-none"
                                    :class="activeTab === tab.key
                                        ? 'bg-primary/10 text-primary shadow-sm ring-1 ring-primary/20'
                                        : 'text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:text-gray-700 dark:hover:text-gray-300'">
                                <span class="w-5 h-5 rounded flex items-center justify-center shrink-0"
                                      :style="activeTab === tab.key ? 'background:' + tab.color + '15; color:' + tab.color : ''">
                                    <iconify-icon :icon="tab.icon" width="13"
                                        :style="activeTab === tab.key ? 'color:' + tab.color : ''"
                                        :class="activeTab !== tab.key ? 'text-gray-400 dark:text-gray-500' : ''"></iconify-icon>
                                </span>
                                <span x-text="tab.label"></span>
                                <span x-show="tab._count > 0"
                                      class="ml-0.5 px-1.5 py-0 text-[10px] font-bold rounded-full min-w-[18px] text-center leading-[18px]"
                                      :class="activeTab === tab.key
                                          ? 'bg-primary/20 text-primary'
                                          : 'bg-gray-100 dark:bg-gray-700 text-gray-400 dark:text-gray-500'"
                                      x-text="tab._count"></span>
                                <span x-show="tab.direction === 'inverse'" class="text-[8px] text-amber-500 font-bold uppercase tracking-wider opacity-60">↩</span>
                            </button>
                            <!-- Quick Add button per tab -->
                            <button type="button"
                                    @click.stop="canAddOnTab(tab) && openQuickCreate(tab)"
                                    class="w-5 h-5 rounded flex items-center justify-center ml-0.5 transition-all shrink-0"
                                    :class="canAddOnTab(tab)
                                        ? 'text-gray-300 dark:text-gray-600 hover:text-primary hover:bg-primary/10 cursor-pointer'
                                        : 'text-gray-200 dark:text-gray-700 cursor-not-allowed opacity-40'"
                                    :title="canAddOnTab(tab) ? 'Créer ' + tab.label : 'Ajout non disponible'"
                                    :disabled="!canAddOnTab(tab)">
                                <iconify-icon icon="tabler:plus" width="12"></iconify-icon>
                            </button>
                        </div>
                    </template>
                </div>

                <!-- Config Button -->
                <div class="flex items-center gap-1 pr-2 pl-1 border-l dark:border-gray-700/50">
                    <button type="button" @click="showConfig = !showConfig"
                            class="flex items-center justify-center w-7 h-7 rounded-lg transition-all"
                            :class="showConfig ? 'bg-primary/10 text-primary' : 'text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50'"
                            title="Configurer les onglets">
                        <iconify-icon icon="solar:settings-bold-duotone" width="15"></iconify-icon>
                    </button>
                </div>
            </div>

            <!-- Config Panel (dropdown) -->
            <div x-show="showConfig" x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0 -translate-y-2"
                 @click.outside="showConfig = false"
                 class="mt-2 bg-white dark:bg-[#1b2e4b] rounded-xl border border-gray-100 dark:border-gray-800 shadow-lg p-3 relative z-40"
                 x-cloak>
                <div class="flex items-center justify-between mb-3">
                    <h4 class="text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider flex items-center gap-1.5">
                        <iconify-icon icon="solar:tuning-2-bold-duotone" width="14" class="text-primary"></iconify-icon>
                        Configurer les onglets
                    </h4>
                    <button type="button" @click="resetConfig()" class="text-[10px] text-gray-400 hover:text-primary transition-colors">
                        Réinitialiser
                    </button>
                </div>
                <p class="text-[10px] text-gray-400 dark:text-gray-500 mb-3">
                    Glissez pour réordonner. Activez ou désactivez les relations à afficher.
                </p>
                <div id="relation-tabs-sortable" class="space-y-1.5">
                    <template x-for="tab in allTabs" :key="'cfg-' + tab.key">
                        <div class="flex items-center gap-2 px-2.5 py-2 rounded-lg border dark:border-gray-700/50 bg-gray-50/50 dark:bg-gray-800/30 cursor-grab active:cursor-grabbing transition-colors hover:bg-gray-50 dark:hover:bg-gray-800/50"
                             :data-key="tab.key">
                            <iconify-icon icon="tabler:grip-vertical" width="14" class="text-gray-300 dark:text-gray-600 shrink-0 drag-handle"></iconify-icon>
                            <div class="w-5 h-5 rounded flex items-center justify-center shrink-0"
                                 :style="'background:' + tab.color + '15'">
                                <iconify-icon :icon="tab.icon" width="12" :style="'color:' + tab.color"></iconify-icon>
                            </div>
                            <span class="text-xs font-medium text-gray-700 dark:text-gray-300 flex-1 truncate" x-text="tab.label"></span>
                            <span x-show="tab.direction === 'inverse'" class="text-[8px] text-amber-500/60 font-bold uppercase tracking-wider">Inverse</span>
                            <label class="relative inline-flex items-center cursor-pointer shrink-0">
                                <input type="checkbox" class="sr-only peer" :checked="tab.visible !== false"
                                       @change="toggleTabVisibility(tab.key, $event.target.checked)">
                                <div class="w-7 h-4 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-primary"></div>
                            </label>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Tab Content Area (only shown for relation tabs, not for __self__) -->
            <div x-show="activeTab && activeTab !== '__self__'" x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 translate-y-1" x-transition:enter-end="opacity-100 translate-y-0"
                 class="mt-3" x-cloak>
                <div class="bg-white dark:bg-[#1b2e4b] rounded-xl border border-gray-100 dark:border-gray-800 shadow-sm overflow-hidden">

                    <!-- Loading State -->
                    <template x-if="tabLoading">
                        <div class="flex items-center justify-center py-8">
                            <iconify-icon icon="svg-spinners:ring-resize" width="24" class="text-primary"></iconify-icon>
                            <span class="ml-2 text-xs text-gray-400">Chargement...</span>
                        </div>
                    </template>

                    <!-- Records List -->
                    <template x-if="!tabLoading && tabRecords.length > 0">
                        <div>
                            <!-- Header -->
                            <div class="flex items-center justify-between px-4 py-2 border-b dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/30">
                                <div class="flex items-center gap-2">
                                    <span class="w-5 h-5 rounded flex items-center justify-center"
                                          :style="'background:' + activeTabMeta?.color + '15'">
                                        <iconify-icon :icon="activeTabMeta?.icon || 'solar:widget-bold-duotone'" width="12"
                                                      :style="'color:' + (activeTabMeta?.color || '#4361ee')"></iconify-icon>
                                    </span>
                                    <span class="text-xs font-semibold text-gray-700 dark:text-gray-300" x-text="activeTabMeta?.label"></span>
                                    <span class="text-[10px] bg-primary/10 text-primary px-1.5 py-0.5 rounded-full font-bold" x-text="tabRecords.length"></span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <button type="button" @click="canAddOnTab(activeTabMeta) && openQuickCreate(activeTabMeta)"
                                            class="flex items-center gap-1 px-2 py-1 rounded-lg text-[10px] font-semibold transition-all"
                                            :class="canAddOnTab(activeTabMeta)
                                                ? 'text-primary hover:bg-primary/10 cursor-pointer'
                                                : 'text-gray-300 dark:text-gray-600 cursor-not-allowed'"
                                            :disabled="!canAddOnTab(activeTabMeta)"
                                            title="Ajouter">
                                        <iconify-icon icon="tabler:plus" width="12"></iconify-icon>
                                        Ajouter
                                    </button>
                                    <button type="button" @click="activeTab = '__self__'" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
                                        <iconify-icon icon="solar:close-circle-linear" width="16"></iconify-icon>
                                    </button>
                                </div>
                            </div>
                            <!-- Records -->
                            <div class="divide-y dark:divide-gray-800">
                                <template x-for="rec in tabRecords" :key="rec._id">
                                    <a :href="'/account/<%= account_number %>/record/' + rec.entitySlug + '/' + rec._id + '/edit'"
                                       class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 dark:hover:bg-white/5 transition-colors group">
                                        <div class="w-7 h-7 rounded-lg flex items-center justify-center shrink-0"
                                             :style="'background:' + rec.color + '15'">
                                            <iconify-icon :icon="rec.icon" width="14" :style="'color:' + rec.color"></iconify-icon>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="text-sm font-medium text-gray-700 dark:text-gray-200 truncate group-hover:text-primary transition-colors" x-text="rec.title"></div>
                                            <div class="text-[10px] text-gray-400 dark:text-gray-500" x-text="rec.updatedAt ? 'Modifié le ' + new Date(rec.updatedAt).toLocaleDateString('fr-FR') : ''"></div>
                                        </div>
                                        <iconify-icon icon="solar:arrow-right-linear" width="14" class="text-gray-300 dark:text-gray-600 group-hover:text-primary transition-colors shrink-0"></iconify-icon>
                                    </a>
                                </template>
                            </div>
                        </div>
                    </template>

                    <!-- Empty State -->
                    <template x-if="!tabLoading && tabRecords.length === 0 && activeTab && activeTab !== '__self__'">
                        <div class="flex flex-col items-center justify-center py-10 text-gray-400 dark:text-gray-500">
                            <iconify-icon icon="solar:box-minimalistic-bold-duotone" width="36" class="mb-3 opacity-40"></iconify-icon>
                            <span class="text-xs mb-3">Aucun enregistrement lié</span>
                            <template x-if="canAddOnTab(activeTabMeta)">
                                <button type="button" @click="openQuickCreate(activeTabMeta)"
                                        class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold text-white bg-primary hover:bg-primary/90 shadow-md hover:shadow-lg hover:shadow-primary/20 transition-all">
                                    <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                                    <span x-text="'Créer ' + (activeTabMeta?.label || '')"></span>
                                </button>
                            </template>
                            <template x-if="!canAddOnTab(activeTabMeta)">
                                <span class="text-[10px] text-gray-400">L'ajout n'est pas disponible pour cette relation</span>
                            </template>
                        </div>
                    </template>
                </div>
            </div>

            <!-- ═══════════════ QUICK CREATE MODAL ═══════════════ -->
            <div x-show="qcOpen" x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                 class="fixed inset-0 z-[999] flex items-center justify-center"
                 style="display: none; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"
                 @click.self="closeQuickCreate()" @keydown.escape.window="closeQuickCreate()">
                <div x-show="qcOpen"
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0 scale-95 translate-y-4" x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                     x-transition:leave="transition ease-in duration-200"
                     x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95 translate-y-4"
                     class="bg-white dark:bg-[#0e1726] rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden border border-gray-100 dark:border-gray-800"
                     @click.stop>

                    <!-- Modal Header -->
                    <div class="flex items-center justify-between px-6 py-4 border-b dark:border-gray-800"
                         :style="'background: linear-gradient(135deg, ' + (qcTab?.color || '#4361ee') + '08, ' + (qcTab?.color || '#4361ee') + '03)'">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center"
                                 :style="'background:' + (qcTab?.color || '#4361ee') + '15'">
                                <iconify-icon :icon="qcTab?.icon || 'solar:widget-bold-duotone'" width="18"
                                              :style="'color:' + (qcTab?.color || '#4361ee')"></iconify-icon>
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-gray-800 dark:text-gray-200" x-text="'Nouveau ' + (qcTab?.label || '')"></h3>
                                <p class="text-[10px] text-gray-400 dark:text-gray-500">
                                    Création rapide · lié à <strong><%= record.title || 'cet enregistrement' %></strong>
                                </p>
                            </div>
                        </div>
                        <button type="button" @click="closeQuickCreate()"
                                class="w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all">
                            <iconify-icon icon="tabler:x" width="18"></iconify-icon>
                        </button>
                    </div>

                    <!-- Modal Body -->
                    <div class="px-6 py-5 space-y-4">
                        <!-- Loading entity fields -->
                        <template x-if="qcLoading">
                            <div class="flex items-center justify-center py-6">
                                <iconify-icon icon="svg-spinners:ring-resize" width="24" class="text-primary"></iconify-icon>
                            </div>
                        </template>

                        <!-- Form -->
                            <template x-if="!qcLoading">
                            <div class="space-y-3">
                                <!-- Title: Manual or Auto-generated -->
                                <template x-if="!qcAutoTitle">
                                    <div>
                                        <label class="flex items-center gap-1.5 text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">
                                            <iconify-icon icon="solar:text-bold-duotone" width="13" class="text-warning"></iconify-icon>
                                            Titre<span class="text-danger">*</span>
                                        </label>
                                        <input type="text" x-ref="qcTitleInput" x-model="qcTitle"
                                               class="form-input w-full font-medium dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-200"
                                               :placeholder="'Nom du ' + (qcTab?.label || 'record')" />
                                    </div>
                                </template>
                                <template x-if="qcAutoTitle">
                                    <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                                        <iconify-icon icon="solar:magic-stick-3-bold-duotone" width="16" class="text-warning shrink-0"></iconify-icon>
                                        <div class="flex-1 min-w-0">
                                            <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Titre auto-généré</div>
                                            <div class="text-sm font-semibold text-gray-700 dark:text-gray-200 truncate"
                                                 x-text="computeQcTitle() || 'Remplissez les champs...'"
                                                 :class="!computeQcTitle() && 'text-gray-400 italic'"></div>
                                        </div>
                                    </div>
                                </template>

                                <!-- Dynamic fields -->
                                <template x-for="field in qcFields" :key="field.id">
                                    <div>
                                        <label class="flex items-center gap-1.5 text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">
                                            <iconify-icon :icon="field.icon || 'solar:widget-linear'" width="13" class="text-info"></iconify-icon>
                                            <span x-text="field.label || field.name"></span>
                                        </label>
                                        <template x-if="field.type === 'date'">
                                            <input type="date" x-model="qcCustom[field.id]"
                                                   class="form-input w-full text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300">
                                        </template>
                                        <template x-if="field.type === 'datetime-local'">
                                            <input type="datetime-local" x-model="qcCustom[field.id]"
                                                   class="form-input w-full text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300">
                                        </template>
                                        <template x-if="field.type === 'number'">
                                            <input type="number" x-model="qcCustom[field.id]"
                                                   class="form-input w-full text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                   :placeholder="field.label || field.name">
                                        </template>
                                        <template x-if="field.type === 'textarea' || field.type === 'richtext'">
                                            <textarea x-model="qcCustom[field.id]" rows="2"
                                                      class="form-textarea w-full text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                      :placeholder="field.label || field.name"></textarea>
                                        </template>
                                        <template x-if="field.type !== 'date' && field.type !== 'datetime-local' && field.type !== 'number' && field.type !== 'textarea' && field.type !== 'richtext'">
                                            <input type="text" x-model="qcCustom[field.id]"
                                                   class="form-input w-full text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                   :placeholder="field.label || field.name">
                                        </template>
                                    </div>
                                </template>

                                <!-- Classifications (status, tags) -->
                                <template x-for="classif in qcClassifications" :key="classif.id">
                                    <div>
                                        <label class="flex items-center gap-1.5 text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1.5">
                                            <iconify-icon :icon="classif.isStatus ? 'solar:flag-bold-duotone' : 'solar:tag-bold-duotone'" width="13" class="text-secondary"></iconify-icon>
                                            <span x-text="classif.name"></span>
                                        </label>
                                        <div class="flex flex-wrap gap-1.5">
                                            <template x-for="opt in classif.options" :key="opt.id">
                                                <button type="button"
                                                        @click="toggleClassifOption(classif, opt)"
                                                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold border transition-all cursor-pointer"
                                                        :class="isClassifSelected(classif.id, opt.id)
                                                            ? 'text-white shadow-sm'
                                                            : 'bg-gray-50 dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:border-gray-300 dark:hover:border-gray-600'"
                                                        :style="isClassifSelected(classif.id, opt.id)
                                                            ? 'background:' + opt.color + '; border-color:' + opt.color
                                                            : ''">
                                                    <span style="width:6px;height:6px;border-radius:50%;display:inline-block;"
                                                          :style="'background:' + opt.color"></span>
                                                    <span x-text="opt.label"></span>
                                                </button>
                                            </template>
                                        </div>
                                    </div>
                                </template>

                                <!-- Linked record field (read-only) -->
                                <div>
                                    <label class="flex items-center gap-1.5 text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">
                                        <iconify-icon icon="solar:link-round-bold-duotone" width="13" class="text-blue-500"></iconify-icon>
                                        <span><%= entity.nameSingular || entity.name %></span>
                                    </label>
                                    <div class="form-input w-full text-sm bg-gray-50 dark:bg-gray-800/50 border-gray-200 dark:border-gray-700 text-gray-400 dark:text-gray-500 cursor-not-allowed flex items-center gap-2">
                                        <iconify-icon icon="<%= entity.icon || 'solar:widget-bold-duotone' %>" width="14" style="color: <%= entity.color || '#4361ee' %>"></iconify-icon>
                                        <span><%= record.computedTitle || record.title || 'cet enregistrement' %></span>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>

                    <!-- Modal Footer -->
                    <div class="flex items-center justify-between px-6 py-4 border-t dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/20">
                        <a :href="'/account/<%= account_number %>/record/' + (qcTab?.entitySlug || '') + '/add'"
                           target="_blank"
                           class="flex items-center gap-1.5 text-[11px] text-gray-400 hover:text-primary transition-colors">
                            <iconify-icon icon="solar:arrow-right-up-linear" width="13"></iconify-icon>
                            Ouvrir la page complète
                        </a>
                        <div class="flex items-center gap-2">
                            <button type="button" @click="closeQuickCreate()"
                                    class="px-4 py-2 text-xs font-semibold text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-all">
                                Annuler
                            </button>
                            <button type="button" @click="submitQuickCreate()"
                                    :disabled="qcSaving || (!qcAutoTitle && !qcTitle.trim()) || (qcAutoTitle && !computeQcTitle())"
                                    class="flex items-center gap-1.5 px-5 py-2 rounded-lg text-xs font-bold text-white bg-primary hover:bg-primary/90 shadow-md hover:shadow-lg hover:shadow-primary/20 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                    :class="qcSaving ? 'cursor-wait' : ''">
                                <iconify-icon :icon="qcSaving ? 'svg-spinners:ring-resize' : 'tabler:check'" width="14"></iconify-icon>
                                <span x-text="qcSaving ? 'Création...' : 'Créer'"></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
        function relationTabs() {
            const accountNumber = '<%= account_number %>';
            const recordId = '<%= record._id %>';
            const entityId = '<%= entity._id %>';
            const entitySlug = '<%= entity.slug %>';
            const viewId = 'record-edit-' + entityId;
            const initialMeta = <%- JSON.stringify(locals.relationTabsMeta || []) %>;

            return {
                allTabs: [],
                activeTab: '__self__',  // Self tab is active by default
                tabLoading: false,
                tabRecords: [],
                tabCache: {},
                showConfig: false,
                _sortableInstance: null,

                // Quick Create Modal state
                qcOpen: false,
                qcTab: null,
                qcLoading: false,
                qcSaving: false,
                qcTitle: '',
                qcFields: [],
                qcClassifications: [],
                qcCustom: {},
                qcClassifValues: {},  // { classifId: optionId } or { classifId: [optionId, ...] }
                qcEntityRelations: [], // relation definitions from target entity
                qcTitleTokens: [],    // referenceTitleTokens from target entity
                qcAutoTitle: false,   // true when title should be auto-generated

                get visibleTabs() {
                    return this.allTabs.filter(t => t.visible !== false);
                },

                get activeTabMeta() {
                    if (this.activeTab === '__self__') return null;
                    return this.allTabs.find(t => t.key === this.activeTab) || null;
                },

                // Determine if "+" create is allowed on this tab
                canAddOnTab(tab) {
                    if (!tab) return false;
                    const card = tab.cardinality || 'one-to-many';
                    const count = tab._count || 0;

                    if (tab.direction === 'direct') {
                        // Direct one-to-one: only if no record linked
                        if (card === 'one-to-one') return count === 0;
                        // Direct one-to-many/many-to-many: always OK
                        return true;
                    }
                    if (tab.direction === 'inverse') {
                        // Inverse of one-to-many = many-to-one → the other entity stores the foreign key
                        // Each new record of the other entity can point back to us → always OK
                        if (card === 'many-to-one') return true;
                        // Inverse of many-to-many → always OK
                        if (card === 'many-to-many') return true;
                        // Inverse of one-to-one → only if count is 0
                        if (card === 'one-to-one') return count === 0;
                    }
                    return true;
                },

                async init() {
                    // Load saved preferences
                    let savedTabPrefs = null;
                    try {
                        const res = await fetch(`/account/${accountNumber}/api/user/view-preferences/${viewId}`, { credentials: 'include' });
                        const data = await res.json();
                        savedTabPrefs = data?.preferences?.relationTabs || null;
                    } catch (e) { /* ignore */ }

                    if (savedTabPrefs && Array.isArray(savedTabPrefs)) {
                        const metaMap = {};
                        initialMeta.forEach(m => { metaMap[m.key] = { ...m, _count: m.count || 0, visible: true }; });
                        const merged = [];
                        savedTabPrefs.forEach(sp => {
                            if (metaMap[sp.key]) {
                                merged.push({ ...metaMap[sp.key], visible: sp.visible !== false });
                                delete metaMap[sp.key];
                            }
                        });
                        Object.values(metaMap).forEach(m => merged.push(m));
                        this.allTabs = merged;
                    } else {
                        this.allTabs = initialMeta.map(m => ({ ...m, _count: m.count || 0, visible: true }));
                    }

                    // Init SortableJS for config panel
                    this.$nextTick(() => {
                        this.$watch('showConfig', (val) => {
                            if (val) {
                                this.$nextTick(() => this._initSortable());
                            }
                        });
                    });

                    // Expose for relation fields panel quick create
                    window.relationTabsApp = this;
                },

                _initSortable() {
                    const el = document.getElementById('relation-tabs-sortable');
                    if (!el || this._sortableInstance) return;
                    if (typeof Sortable === 'undefined') return;

                    this._sortableInstance = Sortable.create(el, {
                        handle: '.drag-handle',
                        animation: 200,
                        ghostClass: 'opacity-30',
                        onEnd: (evt) => {
                            const newOrder = Array.from(el.children)
                                .map(child => child.getAttribute('data-key'))
                                .filter(Boolean);
                            const tabMap = {};
                            this.allTabs.forEach(t => { tabMap[t.key] = t; });
                            this.allTabs = newOrder.map(key => tabMap[key]).filter(Boolean);
                            this._savePrefs();
                        }
                    });
                },

                async selectTab(key) {
                    if (key === '__self__') {
                        this.activeTab = '__self__';
                        this.tabRecords = [];
                        return;
                    }

                    if (this.activeTab === key) {
                        // Toggle: clicking same tab goes back to self
                        this.activeTab = '__self__';
                        this.tabRecords = [];
                        return;
                    }

                    this.activeTab = key;

                    // Check cache
                    if (this.tabCache[key]) {
                        this.tabRecords = this.tabCache[key];
                        return;
                    }

                    // Fetch from API
                    this.tabLoading = true;
                    this.tabRecords = [];
                    try {
                        const res = await fetch(`/account/${accountNumber}/api/record/${recordId}/relation-records/${key}`, { credentials: 'include' });
                        const data = await res.json();
                        this.tabRecords = data.records || [];
                        this.tabCache[key] = this.tabRecords;

                        // Update count
                        const tab = this.allTabs.find(t => t.key === key);
                        if (tab) tab._count = this.tabRecords.length;
                    } catch (e) {
                        console.error('Error fetching relation records:', e);
                    } finally {
                        this.tabLoading = false;
                    }
                },

                // ═══ Quick Create Modal ═══
                async openQuickCreate(tab) {
                    if (!tab) return;
                    this.qcTab = tab;
                    this.qcTitle = '';
                    this.qcCustom = {};
                    this.qcClassifValues = {};
                    this.qcFields = [];
                    this.qcClassifications = [];
                    this.qcEntityRelations = [];
                    this.qcOpen = true;
                    this.qcLoading = true;

                    // Focus title input after transition
                    this.$nextTick(() => {
                        setTimeout(() => {
                            if (this.$refs.qcTitleInput) this.$refs.qcTitleInput.focus();
                        }, 150);
                    });

                    // Fetch entity fields for the form (with quickForm filter)
                    try {
                        const res = await fetch(`/account/${accountNumber}/api/hierarchy/entity/${tab.entityId}/fields?quickForm=1`, { credentials: 'include' });
                        const data = await res.json();
                        if (data.success && data.entity) {
                            let fields = data.entity.fields || [];

                            // If no fields marked with showOnQuickForm, fallback to first 6
                            if (fields.length === 0) {
                                const allRes = await fetch(`/account/${accountNumber}/api/hierarchy/entity/${tab.entityId}/fields`, { credentials: 'include' });
                                const allData = await allRes.json();
                                if (allData.success && allData.entity?.fields) {
                                    fields = allData.entity.fields.slice(0, 6);
                                }
                            }

                            this.qcFields = fields.map(f => ({
                                id: f.id,
                                name: f.name,
                                label: f.label || f.name?.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
                                type: f.type || 'text',
                                icon: f.icon || 'solar:widget-linear'
                            }));

                            // Classifications
                            this.qcClassifications = data.entity.classifications || [];

                            // Relations info for many-to-many handling
                            this.qcEntityRelations = data.entity.relations || [];

                            // Reference title tokens for auto-generating title
                            const tokens = data.entity.referenceTitleTokens || [{ t: 'field', id: 'title' }];
                            this.qcTitleTokens = tokens;
                            // Auto-title is active when the entity uses tokens that are NOT just 'title'
                            const hasNonTitleField = tokens.some(t => t.t === 'field' && t.id && t.id !== 'title');
                            const hasTitleField = tokens.some(t => t.t === 'field' && t.id === 'title');
                            this.qcAutoTitle = hasNonTitleField && !hasTitleField;
                        }
                    } catch (e) {
                        console.error('Error fetching entity fields:', e);
                    } finally {
                        this.qcLoading = false;
                    }
                },

                closeQuickCreate() {
                    this.qcOpen = false;
                    this.qcTab = null;
                    this.qcTitle = '';
                    this.qcFields = [];
                    this.qcClassifications = [];
                    this.qcCustom = {};
                    this.qcClassifValues = {};
                    this.qcEntityRelations = [];
                    this.qcTitleTokens = [];
                    this.qcAutoTitle = false;
                },

                // Classification option toggle
                toggleClassifOption(classif, opt) {
                    if (classif.allowMultiple) {
                        const arr = this.qcClassifValues[classif.id] || [];
                        const idx = arr.indexOf(opt.id);
                        if (idx >= 0) arr.splice(idx, 1);
                        else arr.push(opt.id);
                        this.qcClassifValues[classif.id] = [...arr];
                    } else {
                        // Single select: toggle on/off
                        this.qcClassifValues[classif.id] = this.qcClassifValues[classif.id] === opt.id ? null : opt.id;
                    }
                },

                isClassifSelected(classifId, optId) {
                    const val = this.qcClassifValues[classifId];
                    if (Array.isArray(val)) return val.includes(optId);
                    return val === optId;
                },

                // Compute title from referenceTitleTokens using current field values
                computeQcTitle() {
                    if (!this.qcTitleTokens || this.qcTitleTokens.length === 0) return '';
                    const parts = this.qcTitleTokens.map(token => {
                        if (token.t === 'text') return token.v || '';
                        if (token.t === 'field') {
                            // Standard fields
                            if (token.id === 'title') return this.qcTitle || '';
                            if (token.id === 'date') {
                                return new Date().toISOString().split('T')[0];
                            }
                            // Custom fields — match by field_id
                            const val = this.qcCustom[token.id];
                            if (val) return val;
                            // Check if it's a date field and format nicely
                            const field = this.qcFields.find(f => f.id === token.id);
                            if (field && (field.type === 'date' || field.type === 'datetime-local') && val) {
                                return val.substring(0, 10);
                            }
                            return '';
                        }
                        return '';
                    });
                    return parts.join('').trim();
                },

                async submitQuickCreate() {
                    // Compute title: auto-generated or manual
                    const finalTitle = this.qcAutoTitle ? this.computeQcTitle() : this.qcTitle.trim();
                    if (!finalTitle || this.qcSaving) return;

                    this.qcSaving = true;
                    const tab = this.qcTab;

                    try {
                        // Build custom fields payload (including relation back to this record)
                        const customFields = { ...this.qcCustom };

                        // Auto-link: set the relation field pointing back to this record
                        // For inverse relations: the target entity has a relation with sourceRelationKey pointing to our entity
                        if (tab.direction === 'inverse' && tab.sourceRelationKey) {
                            customFields[tab.sourceRelationKey] = recordId;
                        }

                        // For direct relations: find the matching relation on the target entity that points back
                        // Also handles many-to-many: we need to update the current record's relation too
                        let directRelationKey = null;
                        if (tab.direction === 'direct') {
                            directRelationKey = tab.key;
                            // Also check if the target entity has a reverse relation to auto-link
                            const reverseRel = this.qcEntityRelations.find(r => r.targetEntity === entityId);
                            if (reverseRel) {
                                customFields[reverseRel.key] = recordId;
                            }
                        }

                        // Build classification values
                        const classificationValues = [];
                        for (const classif of this.qcClassifications) {
                            const val = this.qcClassifValues[classif.id];
                            if (!val) continue;
                            const optIds = Array.isArray(val) ? val : [val];
                            for (const optId of optIds) {
                                const opt = classif.options.find(o => o.id === optId);
                                if (opt) {
                                    classificationValues.push({
                                        classificationId: classif.id,
                                        optionId: optId,
                                        label: opt.label,
                                        color: opt.color
                                    });
                                }
                            }
                        }

                        const payload = {
                            title: finalTitle,
                            entityId: tab.entityId,
                            customFields,
                            classificationValues
                        };

                        const res = await fetch(`/account/${accountNumber}/record/${tab.entitySlug}/save`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify(payload)
                        });

                        const data = await res.json();
                        if (data.success && data._id) {
                            // For direct relations (especially many-to-many):
                            // Update the CURRENT record's relation array to include the new record
                            if (directRelationKey) {
                                try {
                                    await fetch(`/account/${accountNumber}/record/${entitySlug}/${recordId}/update-relation`, {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        credentials: 'include',
                                        body: JSON.stringify({
                                            relationKey: directRelationKey,
                                            targetRecordId: data._id,
                                            action: 'add'
                                        })
                                    });
                                } catch (e) {
                                    console.warn('Could not update source relation:', e);
                                }
                            }

                            // Success! Close modal and refresh the tab
                            this.closeQuickCreate();

                            // Clear cache for this tab so it refetches
                            delete this.tabCache[tab.key];

                            // If this tab is currently active, refresh it
                            if (this.activeTab === tab.key) {
                                await this.selectTab('__self__'); // Reset first
                                await this.selectTab(tab.key);   // Re-fetch
                            } else {
                                // Switch to the tab to see the new record
                                await this.selectTab(tab.key);
                            }

                            // Show success feedback
                            this._showToast('Enregistrement créé avec succès !', 'success');
                        } else {
                            this._showToast('Erreur lors de la création', 'error');
                        }
                    } catch (e) {
                        console.error('Error creating record:', e);
                        this._showToast('Erreur de connexion', 'error');
                    } finally {
                        this.qcSaving = false;
                    }
                },

                _showToast(message, type) {
                    // Simple toast notification
                    const toast = document.createElement('div');
                    toast.className = `fixed bottom-6 right-6 z-[9999] flex items-center gap-2 px-4 py-3 rounded-xl shadow-2xl text-sm font-medium transition-all duration-500 ${
                        type === 'success'
                            ? 'bg-emerald-500 text-white'
                            : 'bg-red-500 text-white'
                    }`;
                    toast.innerHTML = `
                        <iconify-icon icon="${type === 'success' ? 'tabler:check' : 'tabler:x'}" width="16"></iconify-icon>
                        <span>${message}</span>
                    `;
                    toast.style.transform = 'translateY(20px)';
                    toast.style.opacity = '0';
                    document.body.appendChild(toast);
                    requestAnimationFrame(() => {
                        toast.style.transform = 'translateY(0)';
                        toast.style.opacity = '1';
                    });
                    setTimeout(() => {
                        toast.style.transform = 'translateY(20px)';
                        toast.style.opacity = '0';
                        setTimeout(() => toast.remove(), 500);
                    }, 3000);
                },

                toggleTabVisibility(key, visible) {
                    const tab = this.allTabs.find(t => t.key === key);
                    if (tab) {
                        tab.visible = visible;
                        if (!visible && this.activeTab === key) {
                            this.activeTab = '__self__';
                            this.tabRecords = [];
                        }
                    }
                    this._savePrefs();
                },

                resetConfig() {
                    this.allTabs = initialMeta.map(m => ({ ...m, _count: m.count || 0, visible: true }));
                    this._savePrefs();
                    if (this._sortableInstance) {
                        this._sortableInstance.destroy();
                        this._sortableInstance = null;
                    }
                    this.$nextTick(() => this._initSortable());
                },

                async _savePrefs() {
                    const prefs = this.allTabs.map(t => ({ key: t.key, visible: t.visible !== false }));
                    try {
                        await fetch(`/account/${accountNumber}/api/user/view-preferences`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                viewId,
                                preferences: { relationTabs: prefs }
                            })
                        });
                    } catch (e) {
                        console.error('Error saving relation tabs prefs:', e);
                    }
                }
            };
        }
        </script>
        <style>
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        </style>
        <% } %>

        <div class="record-layout-container" x-data="panelLayout()" id="panels-container"
            :style="'grid-template-columns: repeat(12, 1fr)'">
            
            <!-- ═══ Main Form Content (Column 0) ═══ -->
            <div class="record-layout-col relative" 
                :style="'grid-column: span ' + columns[0].width"
                id="panels-main-zone">

                <!-- Resize Handle on right edge -->
                <div class="record-layout-resize-handle"
                    @mousedown.prevent="startResize(0, $event)">
                    <iconify-icon icon="solar:alt-arrow-left-bold" width="10"></iconify-icon>
                    <iconify-icon icon="solar:alt-arrow-right-bold" width="10" style="margin-left: -3px;"></iconify-icon>
                </div>

                <div class="space-y-4">
                <div class="panel-sortable-item" data-panel-id="attributs">
                    <template x-if="designMode">
                        <div class="panel-drag-handle">
                            <iconify-icon icon="tabler:grip-horizontal" width="16"></iconify-icon>
                            <span>Attributs</span>
                        </div>
                    </template>
                <div class="panel">
                    <div class="space-y-8">

                    <% if (locals.entityFormLayout && locals.entityFormLayout.rows) { %>
                        <!-- ========== ENTITY FORM LAYOUT (Row/Column Grid) ========== -->
                        <div>
                            <div class="space-y-4">
                                <% entityFormLayout.rows.forEach(function(row, rowIndex) { %>
                                    <div class="flex flex-wrap -mx-2">
                                        <% row.columns.forEach(function(col, colIndex) { %>
                                            <div class="px-2 mb-3" style="width: <%= (col.width / 12 * 100).toFixed(4) %>%">
                                                <% (col.fields || []).forEach(function(field) { %>
                                                    <% if (field.type === 'standard') { %>
                                                        <% var def = locals.entityFormFieldDefs && locals.entityFormFieldDefs.standard[field.fieldId]; %>
                                                        <% if (def) { %>
                                                            <% if (field.fieldId === 'title') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <input name="<%= def.inputName %>" type="text" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= record.title || '' %>"
                                                                        placeholder="<%= field.placeholder || def.label %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                </div>
                                                            <% } else if (def.inputType === 'textarea') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <textarea name="<%= def.inputName %>" class="form-textarea dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" rows="4"
                                                                        placeholder="<%= field.placeholder || def.label %>"
                                                                        <%= field.required ? 'required' : '' %>><%= record[field.fieldId] || '' %></textarea>
                                                                </div>
                                                            <% } else if (def.inputType === 'file') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                    </label>
                                                                    <% if (record[field.fieldId]) { %>
                                                                        <div class="text-xs text-gray-500 mb-1">Fichier actuel : <span class="text-primary"><%= record[field.fieldId] %></span></div>
                                                                    <% } %>
                                                                    <input name="<%= def.inputName %>" type="file" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" />
                                                                </div>
                                                            <% } else if (def.inputType === 'date') { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <input name="<%= def.inputName %>" type="date" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= record[field.fieldId] ? new Date(record[field.fieldId]).toISOString().split('T')[0] : '' %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                </div>
                                                            <% } else { %>
                                                                <div class="mb-3">
                                                                    <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= def.icon %>" width="14" class="text-warning"></iconify-icon>
                                                                        <%= field.label || def.label %>
                                                                        <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                    </label>
                                                                    <input name="<%= def.inputName %>" type="<%= def.inputType || 'text' %>" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= record[field.fieldId] || '' %>"
                                                                        placeholder="<%= field.placeholder || def.label %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                </div>
                                                            <% } %>
                                                        <% } %>

                                                    <% } else if (field.type === 'custom') { %>
                                                        <% var cf = locals.entityFormFieldDefs && locals.entityFormFieldDefs.custom[field.fieldId]; %>
                                                        <% var cfVal = locals.recordValues && locals.recordValues[field.fieldId]; %>
                                                        <% if (cf && cf.htmlTemplate) { %>
                                                            <div class="mb-3">
                                                                <%- cf.htmlTemplate
                                                                    .replace(/\{\{\s*label\s*\}\}/g, field.label || cf.label || cf.name)
                                                                    .replace(/\{\{\s*name\s*\}\}/g, cf.name || '')
                                                                    .replace(/\{\{\s*placeholder\s*\}\}/g, field.placeholder || cf.label || cf.name)
                                                                    .replace(/\{\{\s*required\s*\}\}/g, field.required ? 'required' : '') %>
                                                            </div>
                                                        <% } else if (cf) { %>
                                                            <div class="mb-3">
                                                                <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                    <iconify-icon icon="<%= (cf.ui && cf.ui.icon) || 'solar:widget-bold-duotone' %>" width="14" class="text-info"></iconify-icon>
                                                                    <%= field.label || cf.label || cf.name %>
                                                                    <% if (field.required) { %><span class="text-danger">*</span><% } %>
                                                                </label>
                                                                <% if (cf.inputType === 'textarea' || cf.inputType === 'richtext') { %>
                                                                    <% var cfRows = (cf.ui && cf.ui.rows) ? parseInt(cf.ui.rows) : 3; %>
                                                                    <% if (cfRows <= 1) { %>
                                                                        <input type="text" name="custom[<%= cf._id %>]" class="form-input"
                                                                            placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                            value="<%= cfVal || '' %>"
                                                                            <%= field.required ? 'required' : '' %> />
                                                                    <% } else { %>
                                                                        <textarea name="custom[<%= cf._id %>]" class="form-textarea" rows="<%= cfRows %>"
                                                                            placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                            <%= field.required ? 'required' : '' %>><%= cfVal || '' %></textarea>
                                                                    <% } %>
                                                                <% } else if (cf.inputType === 'select' && cf.options && cf.options.length) { %>
                                                                    <% if (cf.multiple) { %>
                                                                        <% var selectedArr = Array.isArray(cfVal) ? cfVal : (cfVal ? [cfVal] : []); %>
                                                                        <div class="flex flex-wrap gap-2" x-data='{
                                                                            selected: <%- JSON.stringify(selectedArr) %>,
                                                                            toggle(val) {
                                                                                const idx = this.selected.indexOf(val);
                                                                                if (idx === -1) this.selected.push(val);
                                                                                else this.selected.splice(idx, 1);
                                                                            },
                                                                            isSelected(val) { return this.selected.includes(val); }
                                                                        }'>
                                                                            <% cf.options.forEach(function(opt) { %>
                                                                                <label class="group inline-flex items-center gap-1.5 px-2 py-0 rounded text-xs font-medium cursor-pointer border transition-all duration-200 select-none"
                                                                                       :class="isSelected('<%= opt.value %>') ? 'bg-primary/10 border-primary text-primary' : 'bg-white dark:bg-[#1b2e4b] border-gray-200 dark:border-gray-800 text-gray-500 dark:text-gray-400 hover:border-primary/30 hover:bg-primary/5 hover:text-primary/70'">
                                                                                    <input type="checkbox" name="custom[<%= cf._id %>][]" value="<%= opt.value %>" class="hidden"
                                                                                           :checked="isSelected('<%= opt.value %>')"
                                                                                           @change="toggle('<%= opt.value %>')">
                                                                                    <svg x-show="isSelected('<%= opt.value %>')" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                                                                    <span><%= opt.label || opt.value %></span>
                                                                                </label>
                                                                            <% }); %>
                                                                        </div>
                                                                    <% } else { %>
                                                                        <select name="custom[<%= cf._id %>]" class="form-select" <%= field.required ? 'required' : '' %>>
                                                                            <option value="">-- Choisir --</option>
                                                                            <% cf.options.forEach(function(o) { %>
                                                                                <option value="<%= o.value || o %>" <%= (cfVal == (o.value || o)) ? 'selected' : '' %>><%= o.label || o %></option>
                                                                            <% }); %>
                                                                        </select>
                                                                    <% } %>
                                                                <% } else if (cf.inputType === 'checkbox') { %>
                                                                    <div class="flex items-center gap-2 py-2">
                                                                        <input name="custom[<%= cf._id %>]" type="checkbox" class="form-checkbox"
                                                                            <%= (cfVal === true || cfVal === 'on' || cfVal === 'true') ? 'checked' : '' %> />
                                                                    </div>
                                                                <% } else if (cf.type === 'recurrence') { %>
                                                                    <% var recVal = (cfVal && typeof cfVal === 'object') ? cfVal : {}; %>
                                                                    <script type="application/json" id="rec-config-<%= cf._id %>"><%- JSON.stringify({ options: cf.type_config.options || [], slots: cf.type_config.slots || {}, allowCustomText: cf.type_config.allowCustomText || false }) %></script>
                                                                    <div x-data="recurrenceField({
                                                                        fieldId: '<%= cf._id %>',
                                                                        configElementId: 'rec-config-<%= cf._id %>',
                                                                        initialValue: <%- JSON.stringify(recVal) %>
                                                                    })" class="space-y-3">
                                                                         <template x-for="slotName in slotNames" :key="slotName">
                                                                             <div>
                                                                                 <label class="block text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1.5" x-text="slotName"></label>
                                                                                 <template x-if="getSlotUI(slotName) === 'select'">
                                                                                     <select class="form-select text-sm" @change="setSlotValue(slotName, $event.target.value)">
                                                                                         <option value="">-- Choisir --</option>
                                                                                         <template x-for="opt in getSlotOptions(slotName)" :key="opt.value">
                                                                                             <option :value="opt.value" x-text="opt.label" :selected="currentValue[slotName] === opt.value"></option>
                                                                                         </template>
                                                                                     </select>
                                                                                 </template>
                                                                                 <template x-if="getSlotUI(slotName) === 'checkbox'">
                                                                                     <div class="flex flex-wrap gap-2">
                                                                                         <template x-for="opt in getSlotOptions(slotName)" :key="opt.value">
                                                                                             <label class="group inline-flex items-center gap-1.5 px-2 py-0 rounded text-xs font-medium cursor-pointer border transition-all duration-200 select-none"
                                                                                                    :class="isSlotSelected(slotName, opt.value) ? 'bg-primary/10 border-primary text-primary' : 'bg-white dark:bg-[#1b2e4b] border-gray-200 dark:border-gray-800 text-gray-500 dark:text-gray-400 hover:border-primary/30 hover:bg-primary/5 hover:text-primary/70'">
                                                                                                 <input type="checkbox" class="hidden" :value="opt.value" :checked="isSlotSelected(slotName, opt.value)" @change="toggleSlotValue(slotName, opt.value)">
                                                                                                 <svg x-show="isSlotSelected(slotName, opt.value)" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                                                                                 <span x-text="opt.label"></span>
                                                                                             </label>
                                                                                         </template>
                                                                                     </div>
                                                                                 </template>
                                                                             </div>
                                                                         </template>
                                                                         <template x-if="allowCustomText">
                                                                             <div>
                                                                                 <label class="block text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1.5">Autre</label>
                                                                                 <input type="text" class="form-input text-sm dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" x-model="currentValue.customText" @input="serialize()" placeholder="Texte libre...">
                                                                            </div>
                                                                        </template>
                                                                        <input type="hidden" name="custom[<%= cf._id %>]" :value="serialized">
                                                                    </div>
                                                                <% } else if (cf.inputType === 'datetime-local' || (cf.type === 'date' && cf.type_config && cf.type_config.includeTime)) { %>
                                                                    <% var dtVal = ''; if (cfVal) { try { var _d = new Date(cfVal); if (!isNaN(_d)) dtVal = _d.getFullYear() + '-' + String(_d.getMonth()+1).padStart(2,'0') + '-' + String(_d.getDate()).padStart(2,'0') + 'T' + String(_d.getHours()).padStart(2,'0') + ':' + String(_d.getMinutes()).padStart(2,'0'); } catch(e){} } %>
                                                                    <input name="custom[<%= cf._id %>]" type="datetime-local" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= dtVal %>"
                                                                        placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                <% } else if (cf.inputType === 'date' || (cf.type === 'date' && !(cf.type_config && cf.type_config.includeTime))) { %>
                                                                    <% var dateVal = ''; if (cfVal) { try { var _d2 = new Date(cfVal); if (!isNaN(_d2)) dateVal = _d2.toISOString().split('T')[0]; } catch(e){} } %>
                                                                    <input name="custom[<%= cf._id %>]" type="date" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= dateVal %>"
                                                                        placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                <% } else { %>
                                                                    <input name="custom[<%= cf._id %>]" type="<%= cf.inputType || 'text' %>" class="form-input dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300"
                                                                        value="<%= cfVal || '' %>"
                                                                        placeholder="<%= field.placeholder || cf.label || cf.name %>"
                                                                        <%= field.required ? 'required' : '' %> />
                                                                <% } %>
                                                            </div>
                                                        <% } %>

                                                    <% } else if (field.type === 'relation') { %>
                                                        <% var rel = locals.entityFormFieldDefs && locals.entityFormFieldDefs.relation[field.fieldId]; %>
                                                        <% var relVal = locals.recordValues && locals.recordValues[field.fieldId]; %>
                                                        <% if (rel) { %>
                                                            <% if (rel.inputMode === 'modal-picker') { %>
                                                            <!-- ========== MODAL PICKER MODE ========== -->
                                                            <div class="mb-3">
                                                                <% var mpIcon = (rel.targetEntity && rel.targetEntity.icon) || 'solar:link-round-bold-duotone'; %>
                                                                <% var mpColor = (rel.targetEntity && rel.targetEntity.color) || '#4361ee'; %>
                                                                <% var mpName = (rel.targetEntity && rel.targetEntity.name) || ''; %>
                                                                <% var mpEntityId = (rel.targetEntity && rel.targetEntity._id) || ''; %>
                                                                <div x-data="modalPickerField({
                                                                    fieldId: '<%= rel.key %>',
                                                                    refEntity: '<%= mpEntityId %>',
                                                                    refEntityName: '<%= mpName %>',
                                                                    refEntityIcon: '<%= mpIcon %>',
                                                                    refEntityColor: '<%= mpColor %>',
                                                                    multiple: <%= (rel.cardinality === 'one-to-many' || rel.cardinality === 'many-to-many') ? 'true' : 'false' %>,
                                                                    initialValue: <%- JSON.stringify(relVal || null).replace(/"/g, '&quot;') %>
                                                                })" data-display-fields='<%- JSON.stringify(rel.displayFields || []) %>' class="relative">
                                                                    <label class="flex items-center gap-1.5 mb-1 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= mpIcon %>" width="14"
                                                                            style="color: <%= mpColor %>"></iconify-icon>
                                                                        <%= field.label || rel.label || 'Relation' %>
                                                                    </label>

                                                                    <!-- Trigger Button -->
                                                                    <button type="button" @click="openModal()"
                                                                        class="w-full flex items-center justify-between px-3 py-2 border border-gray-300 dark:border-gray-800 rounded-md hover:border-primary/50 transition-colors text-sm bg-white dark:bg-[#1b2e4b]">
                                                                        <span class="flex items-center gap-2 min-w-0" :class="!multiple && selectedItems.length > 0 ? 'text-gray-800 dark:text-gray-200' : 'text-gray-500 dark:text-gray-400'">
                                                                            <iconify-icon icon="solar:magnifer-bold-duotone" width="16" class="shrink-0" x-show="multiple || selectedItems.length === 0"></iconify-icon>
                                                                            <iconify-icon :icon="refEntityIcon" width="16" :style="'color:' + refEntityColor" class="shrink-0" x-show="!multiple && selectedItems.length > 0" x-cloak></iconify-icon>
                                                                            <span class="truncate" x-text="!multiple && selectedItems.length > 0 ? selectedItems[0].label : (multiple && selectedItems.length > 0 ? selectedItems.length + ' sélectionné(s)' : 'Rechercher <%= mpName %>...')"></span>
                                                                        </span>
                                                                        <span class="flex items-center gap-1 shrink-0">
                                                                            <span role="button" x-show="!multiple && selectedItems.length > 0" x-cloak @click.stop="removeItem(selectedItems[0]?.id)" class="w-5 h-5 rounded-full flex items-center justify-center text-gray-400 hover:text-danger hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors cursor-pointer">
                                                                                <iconify-icon icon="tabler:x" width="12"></iconify-icon>
                                                                            </span>
                                                                            <iconify-icon icon="tabler:external-link" width="14" class="text-gray-400"></iconify-icon>
                                                                        </span>
                                                                    </button>

                                                                    <!-- Selected Items Tags (multi only) -->
                                                                    <div class="flex flex-wrap gap-1 mt-2" x-show="multiple && selectedItems.length > 0">
                                                                        <template x-for="item in selectedItems" :key="item.id">
                                                                            <span class="inline-flex items-center gap-1 px-1.5 h-6 bg-primary/10 text-primary rounded text-xs border border-primary/20">
                                                                                <span x-text="item.label"></span>
                                                                                <button type="button" @click="removeItem(item.id)" class="hover:text-danger flex items-center transition-colors">
                                                                                    <iconify-icon icon="tabler:x" width="11"></iconify-icon>
                                                                                </button>
                                                                            </span>
                                                                        </template>
                                                                    </div>

                                                                    <!-- Hidden inputs -->
                                                                    <template x-if="multiple">
                                                                        <div>
                                                                            <template x-for="item in selectedItems" :key="item.id">
                                                                                <input type="hidden" :name="'custom[' + fieldId + '][]'" :value="item.id">
                                                                            </template>
                                                                        </div>
                                                                    </template>
                                                                    <template x-if="!multiple">
                                                                        <input type="hidden" :name="'custom[' + fieldId + ']'" :value="selectedItems[0]?.id || ''">
                                                                    </template>

                                                                    <!-- Modal Overlay -->
                                                                    <div x-ref="modalOverlay"
                                                                         style="display: none; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"
                                                                         class="fixed inset-0 z-[999] flex items-center justify-center bg-black/30"
                                                                         @click.self="closeModal()">
                                                                            <div class="bg-white dark:bg-[#0e1726] rounded-xl shadow-2xl w-full max-w-3xl mx-4 flex flex-col"
                                                                                 style="max-height: 80vh;" @click.stop>
                                                                                <div class="flex items-center justify-between px-5 py-3 border-b dark:border-gray-800">
                                                                                    <div class="flex items-center gap-2">
                                                                                        <iconify-icon :icon="refEntityIcon" width="18" :style="'color:' + refEntityColor"></iconify-icon>
                                                                                        <h3 class="font-semibold text-sm dark:text-gray-200" x-text="'Sélectionner ' + refEntityName"></h3>
                                                                                        <span class="text-xs text-gray-400 bg-gray-100 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 rounded-full" x-text="modalTotal + ' résultats'"></span>
                                                                                    </div>
                                                                                    <button type="button" @click="closeModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
                                                                                        <iconify-icon icon="tabler:x" width="20"></iconify-icon>
                                                                                    </button>
                                                                                </div>
                                                                                <div class="px-5 py-3 border-b dark:border-gray-800">
                                                                                    <div class="relative">
                                                                                        <iconify-icon icon="solar:magnifer-bold-duotone" width="16" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></iconify-icon>
                                                                                        <input type="text" class="form-input pl-9 text-sm dark:bg-[#1b2e4b] dark:border-gray-800 dark:text-gray-200 dark:placeholder-gray-500" placeholder="Rechercher..."
                                                                                               x-model="modalSearch" @input.debounce.300ms="fetchModalResults(true)" x-ref="modalSearchInput" />
                                                                                    </div>
                                                                                </div>
                                                                                <div class="flex-1 overflow-y-auto">
                                                                                    <template x-if="modalLoading && modalPage === 1">
                                                                                        <div class="flex items-center justify-center py-12">
                                                                                            <iconify-icon icon="svg-spinners:ring-resize" width="28" class="text-primary"></iconify-icon>
                                                                                        </div>
                                                                                    </template>
                                                                                    <template x-if="!(modalLoading && modalPage === 1)">
                                                                                        <div>
                                                                                            <template x-if="modalResults.length === 0 && !modalLoading">
                                                                                                <div class="flex flex-col items-center justify-center py-12 text-gray-400 dark:text-gray-500">
                                                                                                    <iconify-icon icon="solar:box-minimalistic-bold-duotone" width="40" class="mb-2"></iconify-icon>
                                                                                                    <span class="text-sm">Aucun résultat trouvé</span>
                                                                                                </div>
                                                                                            </template>
                                                                                            <div class="divide-y dark:divide-gray-800">
                                                                                                <template x-for="result in modalResults" :key="result.id">
                                                                                                    <div @click="toggleModalSelect(result)"
                                                                                                         class="flex items-center gap-3 px-5 py-2.5 cursor-pointer transition-colors"
                                                                                                         :class="isSelected(result.id) ? 'bg-primary/5' : 'hover:bg-gray-50 dark:hover:bg-white/5'">
                                                                                                        <div class="flex-shrink-0">
                                                                                                            <template x-if="multiple">
                                                                                                                <div class="w-4 h-4 rounded border-2 flex items-center justify-center transition-colors"
                                                                                                                     :class="isSelected(result.id) ? 'bg-primary border-primary' : 'border-gray-300 dark:border-gray-600'">
                                                                                                                    <iconify-icon x-show="isSelected(result.id)" icon="tabler:check" width="11" class="text-white"></iconify-icon>
                                                                                                                </div>
                                                                                                            </template>
                                                                                                            <template x-if="!multiple">
                                                                                                                <div class="w-4 h-4 rounded-full border-2 flex items-center justify-center transition-colors"
                                                                                                                     :class="isSelected(result.id) ? 'border-primary' : 'border-gray-300 dark:border-gray-600'">
                                                                                                                    <div x-show="isSelected(result.id)" class="w-2 h-2 rounded-full bg-primary"></div>
                                                                                                                </div>
                                                                                                            </template>
                                                                                                        </div>
                                                                                                        <div class="flex-1 min-w-0">
                                                                                                            <span class="text-sm font-medium truncate block dark:text-gray-200" x-text="result.label"></span>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </template>
                                                                                            </div>
                                                                                            <template x-if="modalHasMore">
                                                                                                <div class="px-5 py-2 border-t dark:border-gray-800">
                                                                                                    <button type="button" @click="loadMoreModal()" class="w-full text-sm text-primary hover:bg-primary/5 py-1.5 rounded" :disabled="modalLoading">
                                                                                                        <span x-show="!modalLoading">Charger plus...</span>
                                                                                                        <span x-show="modalLoading">Chargement...</span>
                                                                                                    </button>
                                                                                                </div>
                                                                                            </template>
                                                                                        </div>
                                                                                    </template>
                                                                                </div>
                                                                                <div x-show="multiple" class="flex items-center justify-between px-5 py-3 border-t bg-gray-50 dark:bg-[#1b2e4b] dark:border-gray-800 rounded-b-xl">
                                                                                    <span class="text-xs text-gray-500 dark:text-gray-400" x-text="tempSelected.length + ' sélectionné(s)'"></span>
                                                                                    <div class="flex gap-2">
                                                                                        <button type="button" @click="closeModal()" class="btn btn-outline-secondary btn-sm text-xs">Annuler</button>
                                                                                        <button type="button" @click="confirmSelection()" class="btn btn-primary btn-sm text-xs">
                                                                                            <iconify-icon icon="tabler:check" width="14" class="mr-1"></iconify-icon>
                                                                                            Valider
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <% } else { %>
                                                            <!-- ========== AUTOCOMPLETE MODE (default) ========== -->
                                                            <div class="mb-3">
                                                                <div x-data="relationField({
                                                                    fieldId: '<%= rel.key %>',
                                                                    refEntity: '<%= (rel.targetEntity && rel.targetEntity._id) || '' %>',
                                                                    multiple: <%= (rel.cardinality === 'one-to-many' || rel.cardinality === 'many-to-many') ? 'true' : 'false' %>,
                                                                    initialValue: <%- JSON.stringify(relVal || null).replace(/"/g, '&quot;') %>
                                                                })" class="relative">
                                                                    <label class="flex items-center gap-1.5 mb-1 dark:text-gray-300">
                                                                        <iconify-icon icon="<%= (rel.targetEntity && rel.targetEntity.icon) || 'solar:link-round-bold-duotone' %>" width="14"
                                                                            style="color: <%= (rel.targetEntity && rel.targetEntity.color) || '#4361ee' %>"></iconify-icon>
                                                                        <%= field.label || rel.label || 'Relation' %>
                                                                    </label>
                                                                    <div class="relative group" @click.away="showResults = false">
                                                                        <input x-ref="searchInput" type="text" class="form-input pr-10"
                                                                            placeholder="Rechercher <%= (rel.targetEntity && rel.targetEntity.name) || '' %>..."
                                                                            x-model="searchQuery" @input.debounce.300ms="search" @focus="openDropdown" />
                                                                        <div @click="$refs.searchInput.focus(); openDropdown()" class="text-gray-400 cursor-pointer flex items-center" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); z-index: 10;">
                                                                            <iconify-icon icon="tabler:chevron-down" width="16"></iconify-icon>
                                                                        </div>
                                                                        <div x-show="showResults" style="display: none;"
                                                                             class="absolute z-50 w-full mt-1 bg-white dark:bg-[#0e1726] border border-border dark:border-gray-800 rounded-md shadow-xl max-h-60 overflow-y-auto overflow-x-hidden">
                                                                            <template x-if="loading && page === 1">
                                                                                <div class="px-4 py-2 text-sm text-secondary">Loading...</div>
                                                                            </template>
                                                                            <template x-for="result in results" :key="result.id">
                                                                                <div @click="selectItem(result)"
                                                                                     class="px-4 py-2 hover:bg-primary/5 cursor-pointer flex justify-between items-center border-b border-border last:border-0">
                                                                                    <span x-text="result.label" class="truncate"></span>
                                                                                    <iconify-icon icon="tabler:plus" class="text-primary/50" width="16"></iconify-icon>
                                                                                </div>
                                                                            </template>
                                                                            <template x-if="!loading && results.length === 0">
                                                                                <div class="px-4 py-2 text-sm text-secondary">Aucun résultat</div>
                                                                            </template>
                                                                            <template x-if="hasMore">
                                                                                <button type="button" @click.stop="loadMore" class="w-full px-4 py-2 text-sm text-primary hover:bg-primary/5 text-center disabled:opacity-50" :disabled="loading">
                                                                                    <span x-show="!loading">Charger plus...</span>
                                                                                    <span x-show="loading">Chargement...</span>
                                                                                </button>
                                                                            </template>
                                                                        </div>
                                                                    </div>
                                                                    <div class="flex flex-wrap gap-1 mt-2">
                                                                        <template x-for="item in selectedItems" :key="item.id">
                                                                            <span class="inline-flex items-center gap-1 px-1.5 h-6 bg-primary/10 text-primary rounded text-xs border border-primary/20">
                                                                                <span x-text="item.label"></span>
                                                                                <button type="button" @click="removeItem(item.id)" class="hover:text-danger flex items-center transition-colors">
                                                                                    <iconify-icon icon="tabler:x" width="11"></iconify-icon>
                                                                                </button>
                                                                            </span>
                                                                        </template>
                                                                    </div>
                                                                    <template x-if="multiple">
                                                                        <div>
                                                                            <template x-for="item in selectedItems" :key="item.id">
                                                                                <input type="hidden" :name="'custom[' + fieldId + '][]'" :value="item.id">
                                                                            </template>
                                                                        </div>
                                                                    </template>
                                                                    <template x-if="!multiple">
                                                                        <input type="hidden" :name="'custom[' + fieldId + ']'" :value="selectedItems[0]?.id || ''">
                                                                    </template>
                                                                </div>
                                                            </div>
                                                            <% } %>
                                                        <% } %>

                                                    <% } else if (field.type === 'classification') { %>
                                                        <% var cls = locals.entityFormFieldDefs && locals.entityFormFieldDefs.classification[field.fieldId]; %>
                                                        <% if (cls) { %>
                                                            <%
                                                                // Collect all selected option IDs for this classification
                                                                var selectedClassIds = [];
                                                                if (record.classificationValues) {
                                                                    record.classificationValues.forEach(function(c) {
                                                                        if (c.classificationId && c.classificationId.toString() === cls._id) {
                                                                            selectedClassIds.push((c.optionId || '').toString());
                                                                        }
                                                                    });
                                                                }
                                                            %>
                                                            <div class="mb-3">
                                                                <label class="flex items-center gap-1.5 mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300">
                                                                    <iconify-icon icon="solar:tag-bold-duotone" width="14" class="text-success"></iconify-icon>
                                                                    <%= field.label || cls.name %>
                                                                </label>
                                                                <div class="tp-wrapper"
                                                                     x-data="tagPicker({
                                                                         classificationId: '<%= cls._id %>',
                                                                         recordId: '<%= record._id %>',
                                                                         accountNumber: '<%= account_number %>',
                                                                         allowMultiple: <%= cls.allowMultiple ? 'true' : 'false' %>,
                                                                         fieldName: 'classification[<%= cls._id %>]',
                                                                         options: <%= JSON.stringify(cls.options || []) %>,
                                                                         selectedIds: <%= JSON.stringify(selectedClassIds) %>
                                                                     })"
                                                                     @click.away="closeDropdown()">

                                                                    <!-- Trigger: inline tag pills -->
                                                                    <div class="tp-trigger"
                                                                         :class="isOpen ? 'tp-trigger--active' : ''"
                                                                         @click="toggleOpen()">
                                                                        <template x-if="selectedOptions.length === 0">
                                                                            <span class="tp-placeholder">Sélectionner...</span>
                                                                        </template>
                                                                        <template x-for="opt in selectedOptions" :key="opt._id">
                                                                            <span class="tp-tag"
                                                                                  :style="'background:' + opt.bg + '; color:' + opt.text">
                                                                                <span x-text="opt.label"></span>
                                                                                <button type="button" class="tp-tag-remove"
                                                                                        @click.stop="removeTag(opt._id)">
                                                                                    <iconify-icon icon="tabler:x" width="10"></iconify-icon>
                                                                                </button>
                                                                            </span>
                                                                        </template>
                                                                    </div>

                                                                    <!-- Dropdown -->
                                                                    <div class="tp-dropdown" x-show="isOpen" x-cloak
                                                                         x-transition:enter="transition ease-out duration-150"
                                                                         x-transition:enter-start="opacity-0 translate-y-1"
                                                                         x-transition:enter-end="opacity-100 translate-y-0"
                                                                         x-transition:leave="transition ease-in duration-100"
                                                                         x-transition:leave-start="opacity-100"
                                                                         x-transition:leave-end="opacity-0"
                                                                         @click.stop>
                                                                        <!-- Search -->
                                                                        <div class="tp-search-wrap">
                                                                            <input type="text" class="tp-search-input"
                                                                                   placeholder="Rechercher ou créer..."
                                                                                   x-model="searchQuery"
                                                                                   x-ref="searchInput"
                                                                                   @keydown.enter.prevent="canCreate ? createOption() : null" />
                                                                        </div>

                                                                        <div class="tp-divider"></div>

                                                                        <!-- Options list -->
                                                                        <div class="tp-options" style="position: relative;">
                                                                            <template x-for="opt in filteredOptions" :key="opt._id">
                                                                                <div class="tp-option" @click="toggleOption(opt._id)">
                                                                                    <div class="tp-option-icon"
                                                                                         :style="'background:' + opt.bg">
                                                                                        <iconify-icon x-show="isSelected(opt._id)"
                                                                                                      icon="tabler:check" width="12"
                                                                                                      :style="'color:' + opt.text"></iconify-icon>
                                                                                    </div>
                                                                                    <span class="tp-option-label" x-text="opt.label"></span>
                                                                                    <div class="tp-option-actions">
                                                                                        <button type="button" class="tp-option-action-btn"
                                                                                                @click.stop="startEdit(opt, $event)">
                                                                                            <iconify-icon icon="solar:pen-2-linear" width="13"></iconify-icon>
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                            </template>

                                                                            <template x-if="filteredOptions.length === 0 && !canCreate">
                                                                                <div style="padding: 12px; text-align: center; color: #9ca3af; font-size: 12px;">
                                                                                    Aucune option trouvée
                                                                                </div>
                                                                            </template>

                                                                        </div>

                                                                        <!-- Edit popover (fixed position, escapes overflow) -->
                                                                        <template x-if="editingOption">
                                                                            <div class="tp-edit-popover" @click.stop
                                                                                 :style="'top:' + (_editPopoverPos?.top || 0) + 'px; left:' + (_editPopoverPos?.left || 0) + 'px'">
                                                                                <input type="text" class="tp-edit-input"
                                                                                       x-model="editLabel"
                                                                                       @keydown.enter.prevent="saveEdit()"
                                                                                       placeholder="Nom de l'option" />
                                                                                <div class="tp-colors">
                                                                                    <template x-for="(color, idx) in tagColors" :key="idx">
                                                                                        <div class="tp-color-dot"
                                                                                             :class="editColorIdx === idx ? 'tp-color-dot--active' : ''"
                                                                                             :style="'background:' + color.bg"
                                                                                             @click="selectColor(idx)"></div>
                                                                                    </template>
                                                                                </div>
                                                                                <button type="button" class="tp-delete-btn"
                                                                                        @click="deleteOption()">
                                                                                    <iconify-icon icon="solar:trash-bin-trash-bold" width="13"></iconify-icon>
                                                                                    Supprimer
                                                                                </button>
                                                                            </div>
                                                                        </template>

                                                                        <!-- Create new -->
                                                                        <template x-if="canCreate">
                                                                            <div class="tp-create-option" @click="createOption()">
                                                                                <iconify-icon icon="tabler:plus" width="14" style="color: #6b7280;"></iconify-icon>
                                                                                <span class="tp-create-label">Créer</span>
                                                                                <span class="tp-create-tag" x-text="searchQuery"></span>
                                                                            </div>
                                                                        </template>
                                                                    </div>

                                                                    <!-- Hidden inputs for form submission -->
                                                                    <template x-for="id in selectedIds" :key="id">
                                                                        <input type="hidden" name="classification[<%= cls._id %>][]" :value="id" />
                                                                    </template>
                                                                </div>
                                                            </div>
                                                        <% } %>
                                                    <% } %>
                                                <% }); %>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% }); %>
                            </div>
                        </div>

                    <% } else { %>
                        <!-- ========== LEGACY LAYOUT (Tabs + Canvas) ========== -->
                        <!-- Tabbed Attributes Section -->
                        <!-- Tabbed Attributes Section -->
                        <div>
                            <div class="flex justify-between items-end pb-4 border-b border-gray-100">
                                <div class="flex items-center gap-4">
                                    <template x-for="tab in tabs" :key="tab.id">
                                        <div class="relative group/tab flex items-center gap-1.5">
                                            <div @click="setActiveTab(tab.id)"
                                                class="cursor-pointer pb-2.5 px-2 flex items-center gap-2 relative transition-all duration-300 before:transition-all before:duration-500 before:absolute hover:text-primary before:bottom-0 before:w-0 before:left-0 before:right-0 before:m-auto before:h-[2px] before:bg-primary"
                                                :class="activeTab === tab.id ? 'before:w-full text-primary font-semibold' : 'text-gray-500 font-medium'">

                                                <iconify-icon :icon="tab.icon || 'tabler:apps'" width="16"
                                                    :class="activeTab === tab.id ? 'text-primary' : 'text-gray-400'"></iconify-icon>

                                                <template x-if="editingTabId !== tab.id">
                                                    <span class="text-sm tracking-tight" x-text="tab.title"
                                                        @dblclick="startEditingTab(tab)"></span>
                                                </template>
                                                <template x-if="editingTabId === tab.id">
                                                    <div
                                                        class="flex items-center gap-2 bg-white px-2 py-0.5 rounded shadow-sm ring-1 ring-gray-200">
                                                        <%- include('../components/icon-picker', {
                                                            onSelect: '(icon) => { tempTabIcon = icon }' ,
                                                            initialIcon: 'tempTabIcon' }) %>
                                                            <input type="text" x-model="tempTabTitle"
                                                                @keyup.enter="saveTabTitle()" @blur="saveTabTitle()"
                                                                x-init="$nextTick(() => $el.focus())"
                                                                class="!p-0 !h-auto !bg-transparent !border-none !text-sm !font-semibold !text-primary focus:ring-0 min-w-[70px]">
                                                    </div>
                                                </template>
                                            </div>

                                            <!-- Tab Actions (Design Mode) -->
                                            <div x-show="designMode && activeTab === tab.id"
                                                class="flex items-center gap-1 pb-2.5">
                                                <button type="button" @click="startEditingTab(tab)"
                                                    class="text-gray-400 hover:text-primary transition-colors">
                                                    <iconify-icon icon="solar:pen-2-linear" width="14"></iconify-icon>
                                                </button>
                                                <button type="button" x-show="tabs.length > 1"
                                                    @click="removeTab(tab.id)"
                                                    class="text-gray-400 hover:text-red-500 transition-colors">
                                                    <iconify-icon icon="solar:trash-bin-trash-linear"
                                                        width="14"></iconify-icon>
                                                </button>
                                            </div>
                                        </div>
                                    </template>

                                    <!-- Add Tab Button -->
                                    <button x-show="designMode" @click="addTab()" type="button"
                                        class="pb-2.5 text-gray-400 hover:text-primary transition-colors"
                                        title="Ajouter un onglet">
                                        <iconify-icon icon="tabler:plus" width="18"></iconify-icon>
                                    </button>
                                </div>

                                <div class="flex items-center gap-3 pb-2.5">
                                    <button x-show="designMode" @click="openModal = true" type="button"
                                        class="text-[11px] font-bold text-primary hover:bg-primary/5 px-4 py-1.5 rounded-lg transition-all flex items-center gap-2 border border-primary/20">
                                        <iconify-icon icon="tabler:circle-plus" width="16"></iconify-icon>
                                        <span>AJOUTER UN ATTRIBUT</span>
                                    </button>

                                    <button type="button" @click="designMode = !designMode"
                                        class="p-2 rounded-lg transition-all"
                                        :class="designMode ? 'bg-primary text-white shadow-md' : 'bg-gray-100 text-gray-500 hover:bg-gray-200'"
                                        title="Mode Layout">
                                        <iconify-icon icon="tabler:layout-dashboard" width="20"></iconify-icon>
                                    </button>
                                </div>
                            </div>

                            <!-- Standard Fields (Only on first tab for now) -->
                            <div class="flex flex-wrap -mx-2" x-show="activeTab === tabs[0]?.id">
                                <% if (entity.enabledStandardFields &&
                                    entity.enabledStandardFields.includes('description')) { %>
                                    <div class="w-full px-2 mb-4">
                                        <label for="description" class="font-semibold">Description</label>
                                        <textarea name="standard[description]" class="form-textarea dark:bg-[#121e32] dark:border-[#17263c] dark:text-gray-300" rows="4"
                                            placeholder="Entrez la description"><%= record.description %></textarea>
                                    </div>
                                    <% } %>
                            </div>
                        </div>

                        <!-- Custom Fields Section -->
                        <div class="mt-4">

                            <div id="fields-builder-canvas"
                                class="flex flex-wrap -mx-2 min-h-[80px] p-2 rounded-xl transition-all"
                                :class="designMode ? 'bg-gray-50/20 border-2 border-dashed border-gray-200' : ''"
                                x-html="renderAllFields()">
                            </div>
                        </div>
                    <% } %>
                    </div>
                </div>

                </div><!-- end panel-sortable-item attributs -->

                <!-- ═══ RELATIONS Panel (Classification-style) ═══ -->
                <template x-if="getRelationFields().length > 0">
                <div class="panel-sortable-item" data-panel-id="relations-fields">
                    <template x-if="designMode">
                        <div class="panel-drag-handle">
                            <iconify-icon icon="tabler:grip-horizontal" width="16"></iconify-icon>
                            <span>Relations</span>
                        </div>
                    </template>
                    <div class="panel !p-0 group/panel relative z-10" data-id="relations-fields">
                        <div class="">
                            <!-- Header -->
                            <div class="py-3 bg-gray-50/30 flex items-center justify-between cursor-pointer hover:bg-gray-50 transition-colors px-4"
                                @click="relationsFieldsOpen = !relationsFieldsOpen">
                                <div class="flex items-center gap-2 text-primary">
                                    <iconify-icon icon="solar:link-round-bold" width="16"></iconify-icon>
                                    <h6 class="text-[11px] font-extrabold uppercase tracking-wider mb-0 text-gray-800 dark:text-white-light">Relations</h6>
                                </div>
                                <div class="flex items-center gap-1">
                                    <div class="flex items-center justify-center h-4">
                                        <iconify-icon icon="solar:alt-arrow-down-bold"
                                            :class="relationsFieldsOpen ? 'rotate-180' : ''"
                                            class="text-gray-400 transition-transform duration-300 block"
                                            width="14"></iconify-icon>
                                    </div>
                                </div>
                            </div>
                            <div x-show="relationsFieldsOpen" x-collapse>
                                <template x-for="relField in getRelationFields()" :key="relField.item.id">
                                    <div class="px-4 py-3 border-t border-gray-100">
                                        <h6 class="text-[12px] font-bold text-gray-500 tracking-tight mb-2" x-text="relField.field.label"></h6>
                                        <div x-data="relationField({ 
                                            fieldId: relField.field._id, 
                                            refEntity: relField.field.type_config.refEntity, 
                                            multiple: relField.field.type_config.multiple, 
                                            initialValue: valuesMap[relField.field._id] || (relField.field.type_config.multiple ? [] : '') 
                                        })" class="tp-wrapper" @click.away="showResults = false">
                                            
                                            <!-- Trigger: inline tag pills (like Classification) -->
                                            <div class="tp-trigger"
                                                 :class="showResults ? 'tp-trigger--active' : ''"
                                                 @click="$refs.searchInput.focus(); openDropdown()">
                                                <template x-for="item in selectedItems" :key="item.id">
                                                    <span class="tp-tag" style="background: #dbeafe; color: #2563eb;">
                                                        <span x-text="item.label"></span>
                                                        <button type="button" class="tp-tag-remove" @click.stop="removeItem(item.id)">
                                                            <iconify-icon icon="tabler:x" width="10"></iconify-icon>
                                                        </button>
                                                    </span>
                                                </template>
                                                <template x-if="selectedItems.length === 0">
                                                    <span class="tp-placeholder" x-text="'Sélectionner...'"></span>
                                                </template>
                                            </div>

                                            <!-- Dropdown -->
                                            <div class="tp-dropdown" x-show="showResults" x-cloak
                                                 style="max-width: 100%;"
                                                 x-transition:enter="transition ease-out duration-150"
                                                 x-transition:enter-start="opacity-0 translate-y-1"
                                                 x-transition:enter-end="opacity-100 translate-y-0"
                                                 x-transition:leave="transition ease-in duration-100"
                                                 x-transition:leave-start="opacity-100"
                                                 x-transition:leave-end="opacity-0"
                                                 @click.stop>
                                                <!-- Search -->
                                                <div class="tp-search-wrap">
                                                    <input type="text" class="tp-search-input"
                                                           :placeholder="'Rechercher ou créer...'"
                                                           x-model="searchQuery"
                                                           x-ref="searchInput"
                                                           @input.debounce.300ms="search"
                                                           @focus="openDropdown"
                                                           @click="openDropdown" />
                                                </div>

                                                <div class="tp-divider"></div>

                                                <!-- Results list -->
                                                <div class="tp-options">
                                                    <template x-if="loading && page === 1">
                                                        <div style="padding: 8px 12px; text-align: center; color: #9ca3af; font-size: 12px;">Chargement...</div>
                                                    </template>

                                                    <template x-for="result in results" :key="result.id">
                                                        <div class="tp-option" @click="selectItem(result)">
                                                            <div class="tp-option-icon" style="background: #dbeafe;">
                                                                <iconify-icon x-show="selectedItems.some(i => i.id === result.id)" icon="tabler:check" width="12" style="color: #2563eb;"></iconify-icon>
                                                            </div>
                                                            <span class="tp-option-label" x-text="result.label"></span>
                                                        </div>
                                                    </template>

                                                    <template x-if="!loading && results.length === 0">
                                                        <div style="padding: 12px; text-align: center; color: #9ca3af; font-size: 12px;">Aucun résultat</div>
                                                    </template>
                                                </div>

                                                <template x-if="hasMore">
                                                    <button type="button" @click.stop="loadMore" :disabled="loading" 
                                                        style="width: 100%; padding: 6px 10px; font-size: 12px; color: #4361ee; background: #f8f9ff; border: none; border-top: 1px solid #f3f4f6; cursor: pointer; text-align: center;">
                                                        <span x-show="!loading">Charger plus...</span>
                                                        <span x-show="loading" style="display: none;">Chargement...</span>
                                                    </button>
                                                </template>

                                                <!-- Quick Create button -->
                                                <div class="tp-create-option" 
                                                     @click="showResults = false; 
                                                        if (window.relationTabsApp) { 
                                                            const tab = window.relationTabsApp.allTabs.find(t => t.key === fieldId); 
                                                            if (tab) window.relationTabsApp.openQuickCreate(tab); 
                                                        }">
                                                    <iconify-icon icon="tabler:plus" width="14" style="color: #6b7280;"></iconify-icon>
                                                    <span class="tp-create-label">Créer</span>
                                                    <span class="tp-create-tag" x-text="relField.field.label"></span>
                                                </div>
                                            </div>

                                            <!-- Hidden inputs for persistence -->
                                            <template x-if="multiple">
                                                <div>
                                                  <template x-for="item in selectedItems" :key="item.id">
                                                      <input type="hidden" :name="'custom[' + fieldId + '][]'" :value="item.id">
                                                  </template>
                                                </div>
                                            </template>
                                            <template x-if="!multiple">
                                                <input type="hidden" :name="'custom[' + fieldId + ']'" :value="selectedItems[0]?.id || ''">
                                            </template>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </div>
                </div>
                </template>


            </div><!-- end space-y-4 -->
            </div><!-- end record-layout-col main -->

            <% const _showRightSidebar = !(locals.entityFormLayout && locals.entityFormLayout.settings && locals.entityFormLayout.settings.showRightSidebar === false); %>
            <% if (_showRightSidebar) { %>
            <!-- ═══ Sidebar Content (Column 1) ═══ -->
            <div class="record-layout-col relative"
                :style="'grid-column: span ' + columns[1].width"
                id="panels-sidebar-zone">

                <!-- Resize Handle on right edge (creates new column when resized) -->
                <div class="record-layout-resize-handle"
                    @mousedown.prevent="startResize(1, $event)">
                    <iconify-icon icon="solar:alt-arrow-left-bold" width="10"></iconify-icon>
                    <iconify-icon icon="solar:alt-arrow-right-bold" width="10" style="margin-left: -3px;"></iconify-icon>
                </div>

                <div class="space-y-3" id="sidebar-main-sortable">
                <div class="panel-sortable-item" data-panel-id="sidebar-content">
                    <template x-if="designMode">
                        <div class="panel-drag-handle">
                            <iconify-icon icon="tabler:grip-horizontal" width="16"></iconify-icon>
                            <span>Sidebar</span>
                        </div>
                    </template>
                    <%- include('partials/record-sidebar') %>
                </div>
                </div>
            </div>
            <% } %>

            <!-- ═══ Dynamic Extra Columns (created by resizing last column) ═══ -->
            <template x-for="(col, idx) in extraColumns" :key="col.id">
                <div class="record-layout-col relative"
                    :class="{ 'record-layout-col--empty': !col.panels || col.panels.length === 0 }"
                    :style="'grid-column: span ' + col.width"
                    :id="'panels-extra-zone-' + idx"
                    x-init="$nextTick(() => initExtraColSortable(idx))">

                    <!-- Resize Handle -->
                    <div class="record-layout-resize-handle"
                        @mousedown.prevent="startResize(2 + idx, $event)">
                        <iconify-icon icon="solar:alt-arrow-left-bold" width="10"></iconify-icon>
                        <iconify-icon icon="solar:alt-arrow-right-bold" width="10" style="margin-left: -3px;"></iconify-icon>
                    </div>

                    <!-- Sortable drop zone for panels -->
                    <div class="space-y-3 extra-col-sortable" :id="'extra-col-sortable-' + idx"
                        style="min-height: 80px;">
                        <!-- Panels dropped here will appear -->
                    </div>

                    <!-- Empty state placeholder (shown when no panels) -->
                    <template x-if="!col.panels || col.panels.length === 0">
                        <div class="record-layout-empty-placeholder">
                            <iconify-icon icon="solar:widget-add-bold-duotone" width="24" class="text-gray-400"></iconify-icon>
                            <span class="text-xs text-gray-400 mt-1">Colonne vide</span>
                            <span class="text-[10px] text-gray-300 mt-0.5">Glissez un panel ici</span>
                            <button @click.stop="removeExtraColumn(idx)" 
                                class="mt-2 w-7 h-7 rounded-full bg-danger/10 hover:bg-danger/20 flex items-center justify-center transition-all"
                                title="Supprimer cette colonne">
                                <iconify-icon icon="solar:trash-bin-trash-bold" width="14" class="text-danger"></iconify-icon>
                            </button>
                        </div>
                    </template>
                </div>
            </template>
        </div>
    </form>

    <!-- Modal for adding fields -->
    <template x-if="designMode">
        <%- include('../entity/components/entity-modal') %>
    </template>
</div>

