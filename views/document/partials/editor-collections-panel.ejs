<div 
    x-show="activeTab === 'collections'"
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="-translate-x-full opacity-0"
    x-transition:enter-end="translate-x-0 opacity-100"
    x-transition:leave="transition ease-in duration-200 transform"
    x-transition:leave-start="translate-x-0 opacity-100"
    x-transition:leave-end="-translate-x-full opacity-0"
    class="w-80 bg-white dark:bg-gray-800 border-r dark:border-gray-700 flex flex-col shadow-xl z-20 overflow-hidden"
    style="display: none;"
    x-data="collectionsPanel()"
>
    <!-- Header -->
    <div class="p-4 border-b dark:border-gray-700 flex justify-between items-center bg-gray-50/50 dark:bg-gray-900/50">
        <h3 class="font-bold text-sm flex items-center gap-2">
            <iconify-icon icon="solar:folder-with-files-bold-duotone" class="text-purple-500" width="20"></iconify-icon>
            Collections
        </h3>
        <button @click="activeTab = null" class="w-6 h-6 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 flex items-center justify-center">
            <iconify-icon icon="solar:close-circle-bold" width="18"></iconify-icon>
        </button>
    </div>

    <!-- Add Collection Button -->
    <div class="p-3 border-b dark:border-gray-700">
        <button 
            @click="showAddCollection = !showAddCollection"
            class="w-full py-2.5 px-4 bg-primary hover:bg-blue-600 text-white rounded-lg font-medium text-sm shadow-lg transition-all flex items-center justify-center gap-2"
        >
            <iconify-icon icon="solar:add-circle-bold" width="18"></iconify-icon>
            Ajouter une collection
        </button>
    </div>

    <!-- Add Collection Form (Expandable) -->
    <div 
        x-show="showAddCollection" 
        x-transition
        class="p-3 border-b dark:border-gray-700 bg-purple-50 dark:bg-purple-900/20"
    >
        <div class="space-y-3">
            <!-- Entity Selector -->
            <div>
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Entité</label>
                <select 
                    x-model="newCollection.entityId"
                    @change="loadEntityFields()"
                    class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary focus:border-transparent"
                >
                    <option value="">Sélectionner une entité</option>
                    <template x-for="entity in availableEntities" :key="entity._id">
                        <option :value="entity._id" x-text="entity.name"></option>
                    </template>
                </select>
            </div>

            <!-- Alias -->
            <div>
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Alias</label>
                <input 
                    type="text" 
                    x-model="newCollection.alias"
                    placeholder="ex: client, invoice"
                    class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary focus:border-transparent"
                >
            </div>

            <!-- Type -->
            <div>
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Type</label>
                <div class="flex gap-2">
                    <button 
                        @click="newCollection.type = 'single'"
                        :class="newCollection.type === 'single' ? 'bg-primary text-white border-primary' : 'bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300'"
                        class="flex-1 py-2 px-3 text-xs rounded-lg border font-medium transition-all"
                    >
                        Unique
                    </button>
                    <button 
                        @click="newCollection.type = 'query'"
                        :class="newCollection.type === 'query' ? 'bg-primary text-white border-primary' : 'bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300'"
                        class="flex-1 py-2 px-3 text-xs rounded-lg border font-medium transition-all"
                    >
                        Requête
                    </button>
                </div>
            </div>

            <!-- Selection Mode (for single) -->
            <div x-show="newCollection.type === 'single'" x-transition>
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Sélection</label>
                <div class="flex gap-2">
                    <button 
                        @click="newCollection.selectionMode = 'runtime'"
                        :class="newCollection.selectionMode === 'runtime' ? 'bg-primary text-white border-primary' : 'bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300'"
                        class="flex-1 py-2 px-3 text-xs rounded-lg border font-medium transition-all"
                    >
                        À la création
                    </button>
                    <button 
                        @click="newCollection.selectionMode = 'fixed'"
                        :class="newCollection.selectionMode === 'fixed' ? 'bg-primary text-white border-primary' : 'bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300'"
                        class="flex-1 py-2 px-3 text-xs rounded-lg border font-medium transition-all"
                    >
                        Fixé
                    </button>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex gap-2 pt-2">
                <button 
                    @click="cancelAddCollection()"
                    class="flex-1 py-2 px-4 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-medium hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
                >
                    Annuler
                </button>
                <button 
                    @click="addCollection()"
                    :disabled="!newCollection.entityId || !newCollection.alias"
                    class="flex-1 py-2 px-4 bg-primary text-white rounded-lg text-sm font-medium hover:bg-blue-600 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                >
                    Ajouter
                </button>
            </div>
        </div>
    </div>

    <!-- Collections List -->
    <div class="flex-1 overflow-y-auto p-3 custom-scrollbar">
        <template x-if="!doc.collections || doc.collections.length === 0">
            <div class="text-center py-8 text-gray-400">
                <iconify-icon icon="solar:folder-open-bold-duotone" width="48" class="opacity-30"></iconify-icon>
                <p class="text-sm mt-2">Aucune collection</p>
                <p class="text-xs mt-1">Cliquez sur "Ajouter" pour commencer</p>
            </div>
        </template>

        <div class="space-y-2">
            <template x-for="(col, index) in doc.collections || []" :key="col.alias">
                <div class="bg-gray-50 dark:bg-gray-900/50 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
                    <!-- Collection Header -->
                    <div 
                        class="px-3 py-2.5 flex items-center justify-between cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                        @click="toggleCollectionDetails(index)"
                    >
                        <div class="flex items-center gap-2">
                            <div 
                                class="w-8 h-8 rounded-lg flex items-center justify-center"
                                :class="col.type === 'single' ? 'bg-blue-100 dark:bg-blue-900/30' : 'bg-green-100 dark:bg-green-900/30'"
                            >
                                <iconify-icon 
                                    :icon="col.type === 'single' ? 'solar:user-bold-duotone' : 'solar:list-check-bold-duotone'" 
                                    :class="col.type === 'single' ? 'text-blue-600 dark:text-blue-400' : 'text-green-600 dark:text-green-400'" 
                                    width="16"
                                ></iconify-icon>
                            </div>
                            <div>
                                <div class="text-sm font-semibold text-gray-800 dark:text-white" x-text="col.alias"></div>
                                <div class="text-[10px] text-gray-400 uppercase" x-text="col.type === 'single' ? 'Unique' : 'Requête'"></div>
                            </div>
                        </div>
                        <div class="flex items-center gap-1">
                            <button 
                                @click.stop="removeCollection(index)"
                                class="w-6 h-6 rounded-full hover:bg-red-100 dark:hover:bg-red-900/30 flex items-center justify-center text-gray-400 hover:text-red-500 transition-colors"
                            >
                                <iconify-icon icon="solar:trash-bin-minimalistic-bold" width="14"></iconify-icon>
                            </button>
                            <iconify-icon 
                                icon="solar:alt-arrow-down-bold" 
                                width="16" 
                                class="text-gray-400 transition-transform"
                                :class="expandedCollection === index ? 'rotate-180' : ''"
                            ></iconify-icon>
                        </div>
                    </div>

                    <!-- Collection Details (Expanded) -->
                    <div 
                        x-show="expandedCollection === index" 
                        x-transition
                        class="px-3 py-2 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/50 text-xs"
                    >
                        <div class="space-y-2">
                            <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400">
                                <iconify-icon icon="solar:database-bold" width="12"></iconify-icon>
                                <span>Entité: </span>
                                <span class="font-medium text-gray-700 dark:text-gray-300" x-text="getEntityName(col.entityId)"></span>
                            </div>
                            <template x-if="col.type === 'single'">
                                <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400">
                                    <iconify-icon icon="solar:cursor-bold" width="12"></iconify-icon>
                                    <span>Sélection: </span>
                                    <span class="font-medium text-gray-700 dark:text-gray-300" x-text="col.selectionMode === 'runtime' ? 'À la création' : 'Fixée'"></span>
                                </div>
                            </template>
                            <div class="pt-1">
                                <p class="text-[10px] text-gray-400 mb-1">Variables disponibles:</p>
                                <div class="flex flex-wrap gap-1">
                                    <code class="text-[9px] bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 px-1.5 py-0.5 rounded" x-text="'{{' + col.alias + '.title}}'"></code>
                                    <code class="text-[9px] bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 px-1.5 py-0.5 rounded" x-text="'{{' + col.alias + '.cf.*}}'"></code>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </template>
        </div>
    </div>
</div>

<script>
document.addEventListener('alpine:init', function() {
    Alpine.data('collectionsPanel', function() {
        return {
            showAddCollection: false,
            expandedCollection: null,
            availableEntities: [],
            newCollection: {
                entityId: '',
                alias: '',
                type: 'single',
                selectionMode: 'runtime'
            },

            init() {
                this.loadEntities();
            },

            async loadEntities() {
                try {
                    const response = await fetch('/api/entities');
                    if (response.ok) {
                        const data = await response.json();
                        this.availableEntities = data.entities || data || [];
                    }
                } catch (e) {
                    console.error('Failed to load entities:', e);
                }
            },

            loadEntityFields() {
                // Will be used for custom field suggestions
            },

            addCollection() {
                if (!this.newCollection.entityId || !this.newCollection.alias) return;
                
                // Initialize collections array if needed
                if (!this.doc.collections) {
                    this.doc.collections = [];
                }

                // Add new collection
                this.doc.collections.push({
                    alias: this.newCollection.alias,
                    entityId: this.newCollection.entityId,
                    type: this.newCollection.type,
                    selectionMode: this.newCollection.type === 'single' ? this.newCollection.selectionMode : undefined
                });

                // Reset form
                this.cancelAddCollection();
                
                // Trigger save
                this.triggerSave();
            },

            cancelAddCollection() {
                this.showAddCollection = false;
                this.newCollection = {
                    entityId: '',
                    alias: '',
                    type: 'single',
                    selectionMode: 'runtime'
                };
            },

            removeCollection(index) {
                if (confirm('Supprimer cette collection ?')) {
                    this.doc.collections.splice(index, 1);
                    this.triggerSave();
                }
            },

            toggleCollectionDetails(index) {
                this.expandedCollection = this.expandedCollection === index ? null : index;
            },

            getEntityName(entityId) {
                const entity = this.availableEntities.find(e => e._id === entityId);
                return entity ? entity.name : entityId;
            },

            triggerSave() {
                // Trigger autosave
                if (typeof this.scheduleSave === 'function') {
                    this.scheduleSave();
                }
            }
        };
    });
});
</script>
