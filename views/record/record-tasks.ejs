<div class="animate__animated p-6" :class="[$store.app.animation]">
    <!-- TasksHub React Island — Multi-view Tasks Manager -->
    <div 
        data-island="tasks-hub"
        data-account-number="<%= account_number %>"
        data-data-url="/account/<%= account_number %>/api/datagrid/tasks"
        data-title="Tâches"
        data-icon="solar:checklist-minimalistic-bold-duotone"
        data-add-url="/account/<%= account_number %>/record/tache/add"
        data-add-label="Nouvelle tâche"
        data-initial-view="table"
        data-entity-slug="taches"
        style="min-height: 600px;"
    ></div>
    <script src="/dist/tasksHub.js" type="module"></script>

    <!-- ═══ Shared Task Detail Modal ═══ -->
    <%- include('../partials/task-detail-modal') %>
</div>
