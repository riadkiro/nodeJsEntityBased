<%# Table Structure with Headers - Matching original simple-datatables style %>

<table id="recordTableMain" class="whitespace-nowrap w-full">
    <thead>
        <tr class="border-b border-gray-200 dark:border-gray-800">
            <% columns.forEach(column => { %>
                <% if (!column.hidden) { %>
                    <th scope="col" 
                        class="px-4 py-3 text-left text-xs font-semibold uppercase text-gray-600 dark:text-gray-400 cursor-pointer hover:text-primary transition-colors group whitespace-nowrap"
                        hx-get="/account/<%= account_number %>/entity/<%= entityId %>/views/<%= viewId %>/table"
                        hx-trigger="click"
                        hx-target="#dt-wrap-<%= viewId %>"
                        hx-swap="outerHTML"
                        hx-include="[data-dt-params]"
                        hx-vals='{"sort":"<%= column.id %>:<%= sort.field === column.id && sort.direction === 'asc' ? 'desc' : 'asc' %>"}'
                        data-action="click->datatable#handleSort">
                        <div class="flex items-center gap-1">
                            <span><%= column.name %></span>
                            <% if (sort.field === column.id) { %>
                                <% if (sort.direction === 'asc') { %>
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                                    </svg>
                                <% } else { %>
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                <% } %>
                            <% } else { %>
                                <svg class="w-3 h-3 opacity-0 group-hover:opacity-50 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                                </svg>
                            <% } %>
                        </div>
                    </th>
                <% } %>
            <% }); %>
        </tr>
    </thead>
    
    <%- include('./_tbody', { records, columns, account_number, entityId, entity }) %>
</table>
