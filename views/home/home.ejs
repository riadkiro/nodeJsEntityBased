<%- include('../record/partials/widget-picker') %>

<style>
    .home-overview-shell {
        max-width: 1320px;
        margin: 0 auto;
        padding: 8px 6px 32px;
    }
    .home-ov-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }
    .home-ov-title {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }
    .home-ov-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4361ee;
        background: linear-gradient(135deg, rgba(67,97,238,.12), rgba(16,185,129,.08));
        border: 1px solid rgba(67,97,238,.12);
    }
    .home-ov-title h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: #1e293b;
        letter-spacing: -.01em;
    }
    .home-ov-title p {
        margin: 3px 0 0;
        font-size: 12px;
        font-weight: 500;
        color: #94a3b8;
    }
    .home-ov-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }
    .home-ov-btn {
        height: 36px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #475569;
        padding: 0 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all .15s ease;
        white-space: nowrap;
    }
    .home-ov-btn:hover {
        border-color: #4361ee;
        color: #4361ee;
    }
    .home-ov-btn.active {
        border-color: #4361ee;
        color: #fff;
        background: #4361ee;
        box-shadow: 0 4px 12px rgba(67,97,238,.22);
    }
    /* ── Card ── */
    .ov-card {
        position: relative;
        overflow: hidden;
        border: 1px solid #e8edf4;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(15,23,42,.03);
    }
    .ov-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 18px 10px;
    }
    .ov-card-title {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 0;
        color: #1e293b;
        font-size: 14px;
        font-weight: 600;
    }
    .ov-card-title iconify-icon {
        width: 28px;
        height: 28px;
        min-width: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: var(--ov-color, #4361ee);
        background: color-mix(in srgb, var(--ov-color, #4361ee) 13%, white);
    }
    .ov-card-link {
        color: #94a3b8;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }
    .ov-card-link:hover { color: #4361ee; }
    .ov-card-body { padding: 8px 18px 18px; }
    /* ── Task item ── */
    .home-task-list { display: flex; flex-direction: column; gap: 6px; }
    .home-task-item {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 10px;
        align-items: center;
        padding: 10px 12px;
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        background: #fafbff;
        text-decoration: none;
        transition: all .12s ease;
    }
    .home-task-item:hover {
        border-color: #e2e8f0;
        background: #fff;
        box-shadow: 0 4px 12px rgba(15,23,42,.04);
    }
    .home-task-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }
    .home-task-main { min-width: 0; }
    .home-task-title {
        color: #1e293b;
        font-size: 13px;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .home-task-meta {
        margin-top: 2px;
        display: flex;
        align-items: center;
        gap: 6px;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 400;
    }
    .home-task-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 20px;
        padding: 0 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 500;
    }
    .home-task-badge.overdue { background: #fef2f2; color: #dc2626; }
    .home-task-badge.today { background: #f0fdf4; color: #16a34a; }
    /* ── Recent records ── */
    .home-record-list { display: flex; flex-direction: column; gap: 6px; }
    .home-record-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        background: #fafbff;
        text-decoration: none;
        transition: all .12s ease;
    }
    .home-record-item:hover {
        border-color: #e2e8f0;
        background: #fff;
        transform: translateY(-1px);
    }
    .home-mini-icon {
        width: 30px;
        height: 30px;
        min-width: 30px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--item-color, #4361ee);
        background: color-mix(in srgb, var(--item-color, #4361ee) 10%, white);
    }
    .home-record-text { min-width: 0; flex: 1; }
    .home-record-text strong {
        display: block;
        color: #1e293b;
        font-size: 13px;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .home-record-text span {
        display: block;
        margin-top: 1px;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 400;
    }
    .home-record-time {
        font-size: 11px;
        color: #cbd5e1;
        font-weight: 400;
        white-space: nowrap;
        flex-shrink: 0;
    }
    /* ── Stats ── */
    .home-stat-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }
    .home-stat-card {
        display: flex;
        flex-direction: column;
        justify-content: center;
        border-radius: 10px;
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        padding: 12px;
        text-align: center;
    }
    .home-stat-card strong {
        color: #1e293b;
        font-size: 20px;
        font-weight: 600;
    }
    .home-stat-card span {
        margin-top: 2px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: .02em;
    }
    /* ── Quick links ── */
    .home-quick-list { display: flex; flex-direction: column; gap: 6px; }
    .home-quick-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        background: #fafbff;
        text-decoration: none;
        transition: all .12s ease;
    }
    .home-quick-item:hover {
        border-color: #e2e8f0;
        background: #fff;
        transform: translateY(-1px);
    }
    .home-quick-text strong {
        color: #334155;
        font-size: 13px;
        font-weight: 500;
    }
    /* ── Empty ── */
    .home-empty {
        min-height: 100px;
        border: 1px dashed #e2e8f0;
        border-radius: 10px;
        background: #fafbff;
        color: #94a3b8;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-align: center;
        font-size: 12px;
        font-weight: 400;
    }
    .home-loading {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        border: 1px solid #e8edf4;
        border-radius: 12px;
        background: #fff;
        color: #94a3b8;
        font-size: 12px;
    }
    /* ── Layout builder ── */
    .ov-layout-row { display: flex; gap: 16px; margin-bottom: 16px; position: relative; }
    .ov-layout-col { position: relative; display: flex; flex-direction: column; gap: 16px; min-height: 40px; }
    .ov-col-widgets { display: flex; flex-direction: column; gap: 16px; min-height: 40px; flex: 1; }
    .ov-widget-wrap { position: relative; }
    /* Design mode overlays */
    .ov-dm .ov-widget-wrap { border: 2px dashed transparent; border-radius: 14px; transition: border-color .2s; }
    .ov-dm .ov-widget-wrap:hover { border-color: #4361ee40; }
    .ov-dm .ov-layout-col { border: 1px dashed #e2e8f0; border-radius: 12px; padding: 8px; background: rgba(67,97,238,.01); }
    .ov-widget-drag, .ov-row-drag { display: none; }
    .ov-dm .ov-widget-drag { display: flex; position: absolute; top: 6px; left: 6px; z-index: 20; width: 22px; height: 22px; align-items: center; justify-content: center; border-radius: 6px; background: rgba(67,97,238,.08); color: #4361ee; cursor: grab; opacity: 0; transition: opacity .15s; }
    .ov-dm .ov-widget-wrap:hover .ov-widget-drag { opacity: 1; }
    .ov-dm .ov-row-drag { display: flex; position: absolute; top: 50%; left: -28px; transform: translateY(-50%); width: 20px; height: 20px; align-items: center; justify-content: center; border-radius: 6px; background: rgba(67,97,238,.08); color: #4361ee; cursor: grab; opacity: 0; transition: opacity .15s; }
    .ov-dm .ov-layout-row:hover > .ov-row-drag { opacity: 1; }
    .ov-row-remove { display: none; }
    .ov-dm .ov-row-remove { display: flex; position: absolute; top: 50%; right: -28px; transform: translateY(-50%); width: 20px; height: 20px; align-items: center; justify-content: center; border-radius: 50%; background: rgba(239,68,68,.08); color: #ef4444; cursor: pointer; opacity: 0; transition: opacity .15s; border: none; font-size: 11px; }
    .ov-dm .ov-layout-row:hover > .ov-row-remove { opacity: 1; }
    .ov-dm .ov-row-remove:hover { background: rgba(239,68,68,.15); }
    .ov-widget-remove { display: none; }
    .ov-dm .ov-widget-remove { display: flex; position: absolute; top: 6px; right: 6px; z-index: 20; width: 20px; height: 20px; align-items: center; justify-content: center; border-radius: 50%; background: rgba(239,68,68,.08); color: #ef4444; cursor: pointer; opacity: 0; transition: opacity .15s; border: none; font-size: 12px; }
    .ov-dm .ov-widget-wrap:hover .ov-widget-remove { opacity: 1; }
    .ov-resize-handle { display: none; }
    .ov-dm .ov-resize-handle { display: block; position: absolute; top: 0; right: -10px; width: 20px; height: 100%; cursor: col-resize; z-index: 30; }
    .ov-dm .ov-resize-handle::after { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 4px; height: 32px; border-radius: 2px; background: #4361ee40; transition: background .15s; }
    .ov-dm .ov-resize-handle:hover::after { background: #4361ee; }
    .ov-sort-ghost { opacity: .15; border: 2px dashed #4361ee !important; border-radius: 12px; background: rgba(67,97,238,.04) !important; }
    .ov-add-widget-btn { display: none; }
    .ov-dm .ov-add-widget-btn { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 10px; border: 2px dashed #e2e8f0; border-radius: 10px; color: #94a3b8; font-size: 12px; font-weight: 500; cursor: pointer; transition: all .2s; background: transparent; }
    .ov-dm .ov-add-widget-btn:hover { border-color: #4361ee; color: #4361ee; background: rgba(67,97,238,.03); }
    .ov-add-row-btn { display: none; }
    .ov-dm .ov-add-row-btn { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 12px; border: 2px dashed #e2e8f0; border-radius: 12px; color: #94a3b8; font-size: 12px; font-weight: 500; cursor: pointer; transition: all .2s; margin-top: 4px; }
    .ov-dm .ov-add-row-btn:hover { border-color: #4361ee; color: #4361ee; background: rgba(67,97,238,.03); }
    .ov-col-toolbar { display: none; }
    .ov-dm .ov-col-toolbar { display: flex; gap: 4px; position: absolute; top: -8px; right: 8px; z-index: 25; }
    .ov-dm .ov-col-toolbar button { width: 18px; height: 18px; border-radius: 4px; border: 1px solid #e2e8f0; background: #fff; color: #94a3b8; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 10px; transition: all .15s; }
    .ov-dm .ov-col-toolbar button:hover { border-color: #4361ee; color: #4361ee; background: rgba(67,97,238,.05); }
    .ov-dm-banner { display: none; }
    .ov-dm .ov-dm-banner { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: linear-gradient(135deg,rgba(67,97,238,.06),rgba(67,97,238,.02)); border: 1px solid rgba(67,97,238,.15); border-radius: 12px; margin-bottom: 16px; font-size: 12px; color: #4361ee; font-weight: 500; }
    /* ── Custom widgets ── */
    .ov-card-custom { overflow: hidden; }
    .ov-custom-frame { display: block; width: 100%; min-height: 180px; border: 1px solid #eef2f7; border-radius: 12px; background: #f8fafc; }
    .ov-custom-video { display: block; width: 100%; border-radius: 12px; background: #0f172a; }
    .ov-custom-image { display: block; width: 100%; max-height: 460px; object-fit: contain; border-radius: 12px; background: #f8fafc; }
    .ov-custom-html { font-size: 13px; line-height: 1.65; color: #334155; overflow: auto; }
    .ov-custom-note { padding: 13px 14px; border: 1px solid #ede9fe; border-radius: 12px; background: linear-gradient(135deg,#fbfaff,#fff); font-size: 13px; line-height: 1.65; color: #475569; white-space: pre-wrap; }
    .ov-custom-link { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px; border: 1px solid #dbeafe; border-radius: 12px; background: #eff6ff; color: #2563eb; text-decoration: none; font-size: 13px; font-weight: 600; }
    .ov-custom-link span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ov-custom-separator { height: 1px; background: linear-gradient(90deg, transparent, #e2e8f0, transparent); margin: 4px 0; }
    .ov-custom-empty { display: flex; align-items: center; justify-content: center; min-height: 86px; border: 1px dashed #e2e8f0; border-radius: 12px; background: #fafbff; color: #94a3b8; font-size: 12px; font-weight: 500; text-align: center; }
    /* ── Dark ── */
    .dark .home-ov-title h1 { color: #f1f5f9; }
    .dark .ov-card { background: #0e1726; border-color: #1e293b; }
    .dark .ov-card-title, .dark .home-task-title, .dark .home-stat-card strong,
    .dark .home-record-text strong, .dark .home-quick-text strong { color: #f1f5f9; }
    .dark .home-ov-btn { background: #0f172a; border-color: #1e293b; color: #94a3b8; }
    .dark .home-task-item, .dark .home-record-item, .dark .home-quick-item,
    .dark .home-stat-card, .dark .home-empty, .dark .ov-custom-empty { background: #111c2d; border-color: #1e293b; }
    .dark .home-loading { background: #0f172a; border-color: #1e293b; }
    .dark .ov-custom-html, .dark .ov-custom-note { color: #cbd5e1; }
    .dark .ov-custom-note { background: #111c2d; border-color: #1e293b; }
    .dark .ov-custom-frame, .dark .ov-custom-image, .dark .ov-custom-empty { background: #0b1320; border-color: #1e293b; }
    .dark .ov-custom-link { background: #111c2d; border-color: #1e293b; color: #93c5fd; }
    @media (max-width: 1024px) {
        .ov-layout-row { flex-direction: column; }
        .ov-layout-col { width: 100% !important; }
    }
    @media (max-width: 640px) {
        .home-overview-shell { padding: 2px 0 24px; }
        .home-ov-header { align-items: flex-start; flex-direction: column; }
        .home-ov-actions { width: 100%; justify-content: flex-start; }
        .home-stat-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="home-overview-shell" x-data="homeOverviewHub()" :class="layoutMode ? 'ov-dm' : ''">
    <div class="home-ov-header">
        <div class="home-ov-title">
            <div class="home-ov-icon">
                <iconify-icon icon="solar:widget-5-bold-duotone" width="24"></iconify-icon>
            </div>
            <div>
                <h1>Bonjour, <%= typeof user !== 'undefined' && user && user.name ? user.name.split(' ')[0] : 'utilisateur' %></h1>
                <p>Vue d'ensemble de votre espace de travail</p>
            </div>
        </div>
        <div class="home-ov-actions">
            <a class="home-ov-btn" href="/account/<%= account_number %>/tasks">
                <iconify-icon icon="solar:checklist-minimalistic-bold-duotone"></iconify-icon>
                Tâches
            </a>
            <button type="button" class="home-ov-btn" :class="layoutMode ? 'active' : ''" @click="toggleLayoutMode()">
                <iconify-icon icon="solar:settings-minimalistic-bold-duotone"></iconify-icon>
                <span x-text="layoutMode ? 'Terminer' : 'Config'"></span>
            </button>
        </div>
    </div>

    <div class="ov-dm-banner">
        <iconify-icon icon="tabler:layout-dashboard" width="16"></iconify-icon>
        <span>Mode configuration — réorganisez les widgets et ajoutez de nouveaux blocs</span>
        <button type="button" @click="toggleLayoutMode(false)" style="margin-left:auto;padding:4px 12px;border-radius:6px;border:1px solid rgba(67,97,238,.2);background:#fff;color:#4361ee;font-size:11px;font-weight:500;cursor:pointer;">Terminer</button>
    </div>

    <div x-show="loadingData" class="home-loading">
        <iconify-icon icon="solar:refresh-circle-bold-duotone" style="animation:spin 1.2s linear infinite;"></iconify-icon>
        Chargement de l'overview…
    </div>

    <div x-ref="ovRowContainer" x-show="!loadingData">
        <template x-for="row in rows" :key="row.id">
            <div class="ov-layout-row" :data-row-id="row.id">
                <div class="ov-row-drag" title="Déplacer la ligne">⠿</div>
                <button type="button" class="ov-row-remove" @click="removeRow(row.id)" title="Supprimer la ligne">✕</button>
                <template x-for="(col, ci) in row.columns" :key="col.id">
                    <div class="ov-layout-col" :style="'width:' + (col.width/12*100) + '%;position:relative;'">
                        <div class="ov-col-toolbar">
                            <button type="button" @click="splitColumn(row.id, col.id)" title="Diviser" x-show="col.width >= 4">⫽</button>
                            <button type="button" @click="removeColumn(row.id, col.id)" title="Supprimer" x-show="row.columns.length > 1" style="color:#ef4444;">✕</button>
                        </div>
                        <template x-if="ci < row.columns.length - 1">
                            <div class="ov-resize-handle" @mousedown="$event.preventDefault(); _onResizeStart($event, row.id, ci)"></div>
                        </template>
                        <div class="ov-col-widgets" :data-col-id="col.id">
                            <template x-for="wid in col.widgetIds" :key="wid">
                                <div class="ov-widget-wrap" :data-widget-id="wid">
                                    <div class="ov-widget-drag" title="Déplacer">⠿</div>
                                    <button type="button" class="ov-widget-remove" @click="removeWidget(wid)" title="Retirer">✕</button>

                                    <!-- Widget: today-tasks -->
                                    <template x-if="wid === 'today-tasks'">
                                    <div class="ov-card" style="--ov-color:#10b981">
                                        <div class="ov-card-header">
                                            <div class="ov-card-title">
                                                <iconify-icon icon="solar:checklist-minimalistic-bold-duotone"></iconify-icon>
                                                <span>Tâches du jour</span>
                                            </div>
                                            <a class="ov-card-link" href="/account/<%= account_number %>/tasks">Voir tout →</a>
                                        </div>
                                        <div class="ov-card-body">
                                            <template x-if="todayTasks.length === 0">
                                                <div class="home-empty">
                                                    <iconify-icon icon="solar:check-circle-bold-duotone" width="28"></iconify-icon>
                                                    Rien pour aujourd'hui ✓
                                                </div>
                                            </template>
                                            <template x-if="todayTasks.length > 0">
                                                <div class="home-task-list">
                                                    <template x-for="task in todayTasks.slice(0, 5)" :key="task.id">
                                                        <a class="home-task-item" :href="task.link">
                                                            <div class="home-task-dot" :style="'background:' + (task.statusColor || '#94a3b8')"></div>
                                                            <div class="home-task-main">
                                                                <div class="home-task-title" x-text="task.title"></div>
                                                                <div class="home-task-meta" x-text="task.listLabel + ' · ' + task.entityName"></div>
                                                            </div>
                                                            <template x-if="isOverdue(task)">
                                                                <span class="home-task-badge overdue">En retard</span>
                                                            </template>
                                                            <template x-if="!isOverdue(task)">
                                                                <span class="home-task-badge today">Aujourd'hui</span>
                                                            </template>
                                                        </a>
                                                    </template>
                                                    <template x-if="todayTasks.length > 5">
                                                        <a class="home-task-item" href="/account/<%= account_number %>/tasks" style="justify-content:center;color:#4361ee;font-size:12px;">
                                                            Voir les <span x-text="todayTasks.length - 5" style="margin:0 3px;"></span> autres →
                                                        </a>
                                                    </template>
                                                </div>
                                            </template>
                                        </div>
                                    </div>
                                    </template>

                                    <!-- Widget: stats -->
                                    <template x-if="wid === 'stats'">
                                    <div class="ov-card" style="--ov-color:#6366f1">
                                        <div class="ov-card-header">
                                            <div class="ov-card-title">
                                                <iconify-icon icon="solar:chart-square-bold-duotone"></iconify-icon>
                                                <span>Résumé</span>
                                            </div>
                                        </div>
                                        <div class="ov-card-body">
                                            <div class="home-stat-grid">
                                                <div class="home-stat-card">
                                                    <strong x-text="stats.openTasks || 0"></strong>
                                                    <span>En cours</span>
                                                </div>
                                                <div class="home-stat-card">
                                                    <strong x-text="stats.doneTasks || 0"></strong>
                                                    <span>Terminées</span>
                                                </div>
                                                <div class="home-stat-card">
                                                    <strong x-text="stats.overdueCount || 0"></strong>
                                                    <span>En retard</span>
                                                </div>
                                                <div class="home-stat-card">
                                                    <strong x-text="stats.recordsCount || 0"></strong>
                                                    <span>Records</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    </template>

                                    <!-- Widget: recent-records -->
                                    <template x-if="wid === 'recent-records'">
                                    <div class="ov-card" style="--ov-color:#f59e0b">
                                        <div class="ov-card-header">
                                            <div class="ov-card-title">
                                                <iconify-icon icon="solar:history-bold-duotone"></iconify-icon>
                                                <span>Activité récente</span>
                                            </div>
                                        </div>
                                        <div class="ov-card-body">
                                            <template x-if="recentRecords.length === 0">
                                                <div class="home-empty">
                                                    <iconify-icon icon="solar:folder-open-bold-duotone" width="28"></iconify-icon>
                                                    Aucune activité récente
                                                </div>
                                            </template>
                                            <template x-if="recentRecords.length > 0">
                                                <div class="home-record-list">
                                                    <template x-for="rec in recentRecords.slice(0, 5)" :key="rec.id">
                                                        <a class="home-record-item" :href="rec.link">
                                                            <div class="home-mini-icon" :style="'--item-color:' + (rec.color || '#4361ee')">
                                                                <iconify-icon :icon="rec.icon || 'solar:folder-bold-duotone'" width="14"></iconify-icon>
                                                            </div>
                                                            <div class="home-record-text">
                                                                <strong x-text="rec.title"></strong>
                                                                <span x-text="rec.entityName"></span>
                                                            </div>
                                                            <div class="home-record-time" x-text="timeAgo(rec.updatedAt)"></div>
                                                        </a>
                                                    </template>
                                                    <template x-if="recentRecords.length > 5">
                                                        <a class="home-record-item" href="/account/<%= account_number %>/home" style="justify-content:center;color:#4361ee;font-size:12px;">
                                                            Voir plus →
                                                        </a>
                                                    </template>
                                                </div>
                                            </template>
                                        </div>
                                    </div>
                                    </template>

                                    <!-- Widget: quick-links -->
                                    <template x-if="wid === 'quick-links'">
                                    <div class="ov-card" style="--ov-color:#8b5cf6">
                                        <div class="ov-card-header">
                                            <div class="ov-card-title">
                                                <iconify-icon icon="solar:bolt-circle-bold-duotone"></iconify-icon>
                                                <span>Raccourcis</span>
                                            </div>
                                        </div>
                                        <div class="ov-card-body">
                                            <div class="home-quick-list">
                                                <a class="home-quick-item" href="/account/<%= account_number %>/tasks">
                                                    <div class="home-mini-icon" style="--item-color:#6366f1"><iconify-icon icon="solar:clipboard-list-bold-duotone" width="14"></iconify-icon></div>
                                                    <div class="home-quick-text"><strong>Tâches</strong></div>
                                                </a>
                                                <a class="home-quick-item" href="/account/<%= account_number %>/notes">
                                                    <div class="home-mini-icon" style="--item-color:#eab308"><iconify-icon icon="solar:notes-bold-duotone" width="14"></iconify-icon></div>
                                                    <div class="home-quick-text"><strong>Notes</strong></div>
                                                </a>
                                                <a class="home-quick-item" href="/account/<%= account_number %>/documents">
                                                    <div class="home-mini-icon" style="--item-color:#0ea5e9"><iconify-icon icon="solar:document-text-bold-duotone" width="14"></iconify-icon></div>
                                                    <div class="home-quick-text"><strong>Documents</strong></div>
                                                </a>
                                                <a class="home-quick-item" href="/account/<%= account_number %>/chat">
                                                    <div class="home-mini-icon" style="--item-color:#f97316"><iconify-icon icon="solar:chat-round-dots-bold-duotone" width="14"></iconify-icon></div>
                                                    <div class="home-quick-text"><strong>Chat</strong></div>
                                                </a>
                                                <a class="home-quick-item" href="/account/<%= account_number %>/media">
                                                    <div class="home-mini-icon" style="--item-color:#ec4899"><iconify-icon icon="solar:gallery-bold-duotone" width="14"></iconify-icon></div>
                                                    <div class="home-quick-text"><strong>Médias</strong></div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    </template>

                                    <!-- Widget: custom (from picker) -->
                                    <template x-if="isCustomWidget(wid)">
                                    <div class="ov-card ov-card-custom">
                                        <div class="ov-card-header">
                                            <div class="ov-card-title" :style="'--ov-color:' + (getCustomWidget(wid).color || '#4361ee')">
                                                <iconify-icon :icon="getCustomWidget(wid).icon || customWidgetIcon(getCustomWidget(wid).type)"></iconify-icon>
                                                <span x-text="getCustomWidget(wid).label || customWidgetLabel(getCustomWidget(wid).type)"></span>
                                            </div>
                                        </div>
                                        <template x-if="getCustomWidget(wid).type === 'iframe'">
                                            <div>
                                                <template x-if="customWidgetConfig(wid).url">
                                                    <iframe class="ov-custom-frame" :src="customWidgetConfig(wid).url" :style="'height:' + (customWidgetConfig(wid).height || 300) + 'px'" allowfullscreen loading="lazy"></iframe>
                                                </template>
                                                <template x-if="!customWidgetConfig(wid).url">
                                                    <div class="ov-custom-empty">URL iframe manquante</div>
                                                </template>
                                            </div>
                                        </template>
                                        <template x-if="getCustomWidget(wid).type === 'video'">
                                            <div>
                                                <template x-if="customWidgetConfig(wid).url && isEmbeddableVideo(customWidgetConfig(wid).url)">
                                                    <iframe class="ov-custom-frame" :src="videoEmbedUrl(customWidgetConfig(wid).url)" :style="'height:' + (customWidgetConfig(wid).height || 320) + 'px'" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
                                                </template>
                                                <template x-if="customWidgetConfig(wid).url && !isEmbeddableVideo(customWidgetConfig(wid).url)">
                                                    <video class="ov-custom-video" :src="customWidgetConfig(wid).url" :style="'max-height:' + (customWidgetConfig(wid).height || 320) + 'px'" controls></video>
                                                </template>
                                                <template x-if="!customWidgetConfig(wid).url">
                                                    <div class="ov-custom-empty">URL vidéo manquante</div>
                                                </template>
                                            </div>
                                        </template>
                                        <template x-if="getCustomWidget(wid).type === 'image'">
                                            <div>
                                                <template x-if="customWidgetConfig(wid).url">
                                                    <img class="ov-custom-image" :src="customWidgetConfig(wid).url" :alt="customWidgetConfig(wid).alt || 'Image'">
                                                </template>
                                                <template x-if="!customWidgetConfig(wid).url">
                                                    <div class="ov-custom-empty">URL image manquante</div>
                                                </template>
                                            </div>
                                        </template>
                                        <template x-if="getCustomWidget(wid).type === 'html'">
                                            <div class="ov-card-body ov-custom-html" x-html="customWidgetConfig(wid).content || ''"></div>
                                        </template>
                                        <template x-if="getCustomWidget(wid).type === 'note' || getCustomWidget(wid).type === 'notes'">
                                            <div class="ov-card-body"><div class="ov-custom-note" x-text="customWidgetConfig(wid).content || 'Note vide'"></div></div>
                                        </template>
                                        <template x-if="getCustomWidget(wid).type === 'link'">
                                            <div class="ov-card-body"><a class="ov-custom-link" :href="customWidgetConfig(wid).url || '#'" :target="customWidgetConfig(wid).newTab ? '_blank' : '_self'" rel="noopener">
                                                <span x-text="customWidgetConfig(wid).description || customWidgetConfig(wid).url || 'Lien'"></span>
                                                <iconify-icon icon="solar:arrow-right-up-linear" width="14"></iconify-icon>
                                            </a></div>
                                        </template>
                                        <template x-if="getCustomWidget(wid).type === 'separator'">
                                            <div class="ov-custom-separator"></div>
                                        </template>
                                        <template x-if="['timeline','kpi','chart','fields','cards','tasks'].includes(getCustomWidget(wid).type)">
                                            <div class="ov-custom-empty" x-text="customWidgetLabel(getCustomWidget(wid).type) + ' prêt à configurer'"></div>
                                        </template>
                                    </div>
                                    </template>

                                </div>
                            </template>
                        </div>
                        <!-- Add widget button -->
                        <div class="ov-add-widget-btn" @click="openWidgetPicker(col.id)">
                            <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
                            <span>Widget</span>
                        </div>
                    </div>
                </template>
            </div>
        </template>
    </div>
    <!-- Add row button -->
    <div class="ov-add-row-btn" @click="addRow()">
        <iconify-icon icon="tabler:plus" width="14"></iconify-icon>
        <span>Ajouter une ligne</span>
    </div>
</div>

<script>
document.addEventListener('alpine:init', () => {
    const _accountNumber = '<%= account_number %>';

    Alpine.data('homeOverviewHub', () => ({
        layoutMode: false,
        loadingData: true,
        rows: [],
        todayTasks: [],
        recentRecords: [],
        stats: {},
        customWidgets: {},
        _viewId: 'home_overview',
        _sortables: [],
        _sortableTimer: null,
        _observer: null,
        _sortableIniting: false,
        _isDragging: false,
        _resizing: null,
        _homeWidgetListener: null,
        _defaultRows: [
            { id: 'r1', columns: [{ id: 'c1', width: 8, widgetIds: ['today-tasks', 'recent-records'] }, { id: 'c2', width: 4, widgetIds: ['stats', 'quick-links'] }] }
        ],

        async init() {
            this.rows = JSON.parse(JSON.stringify(this._defaultRows));
            this._loadLayout();
            this._fetchData();
            window.addEventListener('mousemove', (e) => this._onResizeMove(e));
            window.addEventListener('mouseup', () => this._onResizeEnd());
            this._homeWidgetListener = (e) => this.insertWidgetFromPicker(e.detail || {});
            window.addEventListener('insert-home-overview-widget', this._homeWidgetListener);
            window.addEventListener('update-home-overview-widget', (e) => this._updateWidgetFromPicker(e.detail || {}));
            // Re-init sortables when data finishes loading and layout mode is active
            this.$watch('loadingData', (loading) => {
                if (!loading && this.layoutMode) {
                    this.$nextTick(() => this._startObserver());
                }
            });
        },

        async _fetchData() {
            try {
                const res = await fetch(`/account/${_accountNumber}/api/home-overview`, { credentials: 'include' });
                const data = await res.json();
                if (data.success) {
                    this.todayTasks = data.todayTasks || [];
                    this.recentRecords = data.recentRecords || [];
                    this.stats = data.stats || {};
                }
            } catch (e) {
                console.error('[HomeHub] fetch error', e);
            } finally {
                this.loadingData = false;
            }
        },

        toggleLayoutMode(force) {
            this.layoutMode = force !== undefined ? force : !this.layoutMode;
            if (this.layoutMode) {
                // Wait for Alpine to render the design-mode DOM, then init
                this.$nextTick(() => {
                    requestAnimationFrame(() => {
                        setTimeout(() => this._startObserver(), 100);
                    });
                });
            } else {
                this._stopObserver();
                this._destroySortables();
            }
        },

        // ── Layout persistence ──
        async _loadLayout() {
            try {
                const res = await fetch(`/account/${_accountNumber}/api/user/view-preferences/${this._viewId}`, { credentials: 'include' });
                const data = await res.json();
                if (data.success && data.preferences && data.preferences.rows) {
                    this.rows = JSON.parse(JSON.stringify(data.preferences.rows));
                    this.customWidgets = this._normalizeCustomWidgets(data.preferences.customWidgets);
                }
            } catch (e) { /* use defaults */ }
        },

        async _saveLayout() {
            try {
                await fetch(`/account/${_accountNumber}/api/user/view-preferences`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
                    body: JSON.stringify({ viewId: this._viewId, preferences: { rows: this.rows, customWidgets: this.customWidgets } })
                });
            } catch (e) { console.error('[HomeLayout] save error', e); }
        },

        _normalizeCustomWidgets(value) {
            if (!value) return {};
            if (Array.isArray(value)) {
                return value.reduce((acc, w) => { if (w && w.id) acc[String(w.id)] = w; return acc; }, {});
            }
            return typeof value === 'object' ? value : {};
        },

        // ── Row/Column management ──
        addRow() {
            this.rows.push({ id: 'r_' + Date.now(), columns: [{ id: 'c_' + Date.now(), width: 12, widgetIds: [] }] });
            this._saveLayout();
        },
        removeRow(rowId) { this.rows = this.rows.filter(r => r.id !== rowId); this._saveLayout(); },
        splitColumn(rowId, colId) {
            const row = this.rows.find(r => r.id === rowId);
            if (!row) return;
            const ci = row.columns.findIndex(c => c.id === colId);
            if (ci === -1) return;
            const col = row.columns[ci];
            if (col.width < 4) return;
            const half = Math.floor(col.width / 2);
            col.width = col.width - half;
            row.columns.splice(ci + 1, 0, { id: 'c_' + Date.now(), width: half, widgetIds: [] });
            this._saveLayout();
        },
        removeColumn(rowId, colId) {
            const row = this.rows.find(r => r.id === rowId);
            if (!row || row.columns.length <= 1) return;
            const ci = row.columns.findIndex(c => c.id === colId);
            if (ci === -1) return;
            const removed = row.columns.splice(ci, 1)[0];
            const neighbor = row.columns[Math.min(ci, row.columns.length - 1)];
            if (neighbor) neighbor.width = Math.min(12, neighbor.width + removed.width);
            this._saveLayout();
        },

        // ── Widget management ──
        _placedWidgets() {
            const ids = [];
            this.rows.forEach(r => (r.columns || []).forEach(c => ids.push(...(c.widgetIds || []))));
            return ids;
        },
        addWidget(colId, widgetId, options = {}) {
            if (!options.allowDuplicate && this._placedWidgets().includes(widgetId)) return;
            this.rows.forEach(r => r.columns.forEach(c => {
                if (c.id === colId) c.widgetIds.push(widgetId);
            }));
            if (options.save !== false) this._saveLayout();
        },
        removeWidget(widgetId) {
            this.rows.forEach(r => r.columns.forEach(c => {
                c.widgetIds = (c.widgetIds || []).filter(w => w !== widgetId);
            }));
            if (String(widgetId || '').startsWith('cw_')) {
                const next = { ...this.customWidgets }; delete next[widgetId]; this.customWidgets = next;
            }
            this._saveLayout();
        },
        isCustomWidget(wid) { return !!(this.customWidgets && this.customWidgets[wid]); },
        getCustomWidget(wid) { return (this.customWidgets && this.customWidgets[wid]) || { type: '', label: 'Widget', icon: 'solar:widget-bold-duotone', color: '#4361ee', config: {} }; },
        customWidgetConfig(wid) { return this.getCustomWidget(wid).config || {}; },
        customWidgetIcon(type) {
            const m = { note:'solar:notes-bold-duotone', notes:'solar:notes-bold-duotone', html:'solar:code-bold-duotone', iframe:'solar:monitor-bold-duotone', video:'solar:video-library-bold-duotone', link:'solar:link-round-bold-duotone', image:'solar:gallery-bold-duotone', separator:'solar:minus-circle-bold-duotone', timeline:'solar:clock-circle-bold-duotone', kpi:'solar:graph-up-bold-duotone', chart:'solar:chart-bold-duotone', fields:'solar:layers-bold-duotone', cards:'solar:card-bold-duotone', tasks:'solar:checklist-bold-duotone' };
            return m[type] || 'solar:widget-bold-duotone';
        },
        customWidgetLabel(type) {
            const m = { note:'Note', notes:'Notes', html:'HTML', iframe:'Embed', video:'Vidéo', link:'Lien', image:'Image', separator:'Séparateur', timeline:'Timeline', kpi:'KPI', chart:'Graphique', fields:'Champs', cards:'Cartes', tasks:'Checklist' };
            return m[type] || 'Widget';
        },
        isEmbeddableVideo(url) {
            const v = String(url || '').toLowerCase();
            return v.includes('youtube.com') || v.includes('youtu.be') || v.includes('vimeo.com');
        },
        videoEmbedUrl(url) {
            const v = String(url || '').trim();
            try {
                const p = new URL(v);
                if (p.hostname.includes('youtu.be')) { const id = p.pathname.split('/').filter(Boolean)[0]; return id ? `https://www.youtube.com/embed/${id}` : v; }
                if (p.hostname.includes('youtube.com')) { const id = p.searchParams.get('v') || p.pathname.split('/').filter(Boolean).pop(); return id ? `https://www.youtube.com/embed/${id}` : v; }
                if (p.hostname.includes('vimeo.com')) { const id = p.pathname.split('/').filter(Boolean).pop(); return id ? `https://player.vimeo.com/video/${id}` : v; }
            } catch (e) {}
            return v;
        },

        // ── Widget picker integration ──
        openWidgetPicker(colId) {
            const picker = window.Alpine && window.Alpine.store ? window.Alpine.store('widgetPicker') : null;
            if (!picker) { window.showMessage && window.showMessage('Widget picker indisponible', 'danger'); return; }
            picker.initPicker({ accountNumber: _accountNumber, gridSchemas: [] });
            picker.initOpen({ type: 'home-overview', colId, accountNumber: _accountNumber });
        },
        insertWidgetFromPicker(detail) {
            const target = detail?.target || {};
            if (target.type && target.type !== 'home-overview') return;
            const colId = target.colId;
            const widget = detail?.widget || null;
            if (!colId || !widget) return;

            const widgetIds = this._homeWidgetIdsFromPickerWidget(widget);
            widgetIds.forEach(wid => this.addWidget(colId, wid, { save: false, allowDuplicate: wid.startsWith('cw_') }));
            this._saveLayout();
            this.$nextTick(() => this._scheduleSortableInit());
        },
        _updateWidgetFromPicker(detail) {
            const widget = detail?.widget || null;
            if (!widget || !widget._id) return;
            const existing = this.customWidgets[widget._id];
            if (!existing) return;
            this.customWidgets = {
                ...this.customWidgets,
                [widget._id]: { ...existing, ...widget, config: JSON.parse(JSON.stringify(widget.config || {})) }
            };
            this._saveLayout();
        },
        _homeWidgetIdsFromPickerWidget(widget) {
            const type = String(widget.type || '');
            const homeMap = {
                'home-today-tasks': 'today-tasks',
                'home-stats': 'stats',
                'home-recent-records': 'recent-records',
                'home-quick-links': 'quick-links'
            };
            if (homeMap[type]) return [homeMap[type]];
            // Custom widget
            const id = 'cw_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
            this.customWidgets = {
                ...this.customWidgets,
                [id]: { id, type, label: widget.label || this.customWidgetLabel(type), icon: widget.icon || this.customWidgetIcon(type), color: widget.color || '#4361ee', config: JSON.parse(JSON.stringify(widget.config || {})) }
            };
            return [id];
        },

        // ── Sortable ──
        _startObserver() {
            this._stopObserver();
            this._scheduleSortableInit();
            const container = this.$refs.ovRowContainer;
            if (!container) return;
            this._observer = new MutationObserver(() => {
                if (!this._sortableIniting && !this._isDragging) this._scheduleSortableInit();
            });
            this._observer.observe(container, { childList: true, subtree: true });
        },
        _stopObserver() {
            if (this._observer) { this._observer.disconnect(); this._observer = null; }
            if (this._sortableTimer) { clearTimeout(this._sortableTimer); this._sortableTimer = null; }
        },
        _scheduleSortableInit() {
            if (this._sortableTimer) clearTimeout(this._sortableTimer);
            this._sortableTimer = setTimeout(() => this._initSortables(), 80);
        },
        _initSortables() {
            this._sortableIniting = true;
            this._destroySortables();
            if (typeof Sortable === 'undefined') { this._sortableIniting = false; return; }
            const self = this;
            const rowContainer = this.$refs.ovRowContainer;
            const colEls = rowContainer ? rowContainer.querySelectorAll('.ov-col-widgets') : [];
            // Retry if Alpine x-for hasn't rendered the columns yet
            if (colEls.length === 0 && this.rows.length > 0) {
                this._sortableIniting = false;
                setTimeout(() => this._initSortables(), 300);
                return;
            }
            if (rowContainer) {
                this._sortables.push(new Sortable(rowContainer, {
                    animation: 150, handle: '.ov-row-drag', ghostClass: 'ov-sort-ghost', draggable: '.ov-layout-row',
                    onStart() { self._isDragging = true; },
                    onEnd(evt) {
                        self._isDragging = false;
                        const rowId = evt.item.dataset.rowId;
                        const oldIdx = evt.oldIndex, newIdx = evt.newIndex;
                        if (oldIdx === newIdx) return;
                        evt.from.removeChild(evt.item);
                        const rows = evt.from.querySelectorAll(':scope > .ov-layout-row');
                        if (oldIdx >= rows.length) evt.from.appendChild(evt.item);
                        else evt.from.insertBefore(evt.item, rows[oldIdx]);
                        const idx = self.rows.findIndex(r => r.id === rowId);
                        if (idx === -1) return;
                        const [moved] = self.rows.splice(idx, 1);
                        self.rows.splice(newIdx, 0, moved);
                        self._saveLayout();
                    }
                }));
            }
            colEls.forEach(colEl => {
                this._sortables.push(new Sortable(colEl, {
                    animation: 150, handle: '.ov-widget-drag', ghostClass: 'ov-sort-ghost', draggable: '.ov-widget-wrap', group: 'ov-widgets', swapThreshold: 0.65, filter: '.ov-add-widget-btn',
                    onStart() { self._isDragging = true; },
                    onEnd(evt) {
                        self._isDragging = false;
                        const widgetId = evt.item.dataset.widgetId;
                        const fromColId = evt.from.dataset.colId;
                        const toColId = evt.to.dataset.colId;
                        if (!widgetId || !fromColId) return;
                        const toWidgets = Array.from(evt.to.querySelectorAll(':scope > .ov-widget-wrap'));
                        let newIdx = toWidgets.indexOf(evt.item);
                        if (newIdx === -1) newIdx = toWidgets.length;
                        if (evt.item.parentNode) evt.item.parentNode.removeChild(evt.item);
                        const fromWidgets = Array.from(evt.from.querySelectorAll(':scope > .ov-widget-wrap'));
                        if (evt.oldIndex >= fromWidgets.length) evt.from.appendChild(evt.item);
                        else evt.from.insertBefore(evt.item, fromWidgets[evt.oldIndex] || null);
                        let fromCol = null, toCol = null;
                        self.rows.forEach(r => r.columns.forEach(c => {
                            if (c.id === fromColId) fromCol = c;
                            if (c.id === toColId) toCol = c;
                        }));
                        if (!fromCol) return;
                        const fi = fromCol.widgetIds.findIndex(w => w === widgetId);
                        if (fi === -1) return;
                        fromCol.widgetIds.splice(fi, 1);
                        if (toCol) toCol.widgetIds.splice(newIdx, 0, widgetId);
                        self._saveLayout();
                    }
                }));
            });
            this._sortableIniting = false;
        },
        _destroySortables() {
            this._sortables.forEach(s => { try { s.destroy(); } catch(e) {} });
            this._sortables = [];
        },

        // ── Resize ──
        _onResizeStart(e, rowId, colIndex) {
            e.preventDefault();
            this._resizing = { rowId, colIndex, startX: e.clientX };
            document.body.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
        },
        _onResizeMove(e) {
            if (!this._resizing) return;
            const row = this.rows.find(r => r.id === this._resizing.rowId);
            if (!row) return;
            const ci = this._resizing.colIndex;
            const col = row.columns[ci], next = row.columns[ci + 1];
            if (!col || !next) return;
            const rowEl = this.$el.querySelector(`[data-row-id="${this._resizing.rowId}"]`);
            if (!rowEl) return;
            const unitW = rowEl.offsetWidth / 12;
            const dx = e.clientX - this._resizing.startX;
            const delta = Math.round(dx / unitW);
            if (delta === 0) return;
            const newW = col.width + delta, newNextW = next.width - delta;
            if (newW >= 2 && newNextW >= 2) {
                col.width = newW;
                next.width = newNextW;
                this._resizing.startX = e.clientX;
            }
        },
        _onResizeEnd() {
            if (!this._resizing) return;
            this._resizing = null;
            document.body.style.cursor = '';
            document.body.style.userSelect = '';
            this._saveLayout();
        },

        // ── Helpers ──
        isOverdue(task) {
            if (!task.dueDate) return false;
            const d = new Date(task.dueDate);
            const now = new Date(); now.setHours(0,0,0,0);
            return d < now;
        },
        timeAgo(dateStr) {
            if (!dateStr) return '';
            const diff = Date.now() - new Date(dateStr).getTime();
            const mins = Math.floor(diff / 60000);
            if (mins < 1) return "À l'instant";
            if (mins < 60) return mins + ' min';
            const hrs = Math.floor(mins / 60);
            if (hrs < 24) return hrs + 'h';
            const days = Math.floor(hrs / 24);
            if (days < 7) return days + 'j';
            return new Date(dateStr).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
        }
    }));
});
</script>

