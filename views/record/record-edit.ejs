                },

                renderField(field, itemId) {
                    let template = field.htmlTemplate || '';
                    
                    // Auto-generate input HTML when no htmlTemplate exists
                    if (!template && field.category === 'computed') {
                        // Computed field: read-only display
                        const cfv = window.__computedFieldValues__ || {};
                        const cv = cfv[field._id] || null;
                        const icon = field.ui?.icon || 'solar:calculator-bold-duotone';
                        const color = field.ui?.couleur || field.color || '#f59e0b';
                        const fFunc = field.formula?.fromFunction || '';
                        const labelHtml = `<label class="flex items-center mb-1 text-sm font-semibold text-gray-700 dark:text-gray-300" style="display:flex;align-items:center;gap:4px">
                            <iconify-icon icon="${icon}" width="14" style="color:${color};flex-shrink:0"></iconify-icon>
                            ${field.label || field.name}
                            <span class="text-[9px] font-medium text-gray-400 bg-gray-100 dark:bg-gray-700 dark:text-gray-500 px-1.5 py-0.5 rounded-full ml-1">calculÃ©</span>
                        </label>`;
                        
                        let valueHtml = '<span class="text-gray-300 dark:text-gray-600 text-xs italic">â€”</span>';
                        if (cv) {
                            if (fFunc === 'rating') {
                                const starVal = Number(cv.value) || 0;
                                const starMax = Number(cv.max) || 5;
                                let stars = '';
