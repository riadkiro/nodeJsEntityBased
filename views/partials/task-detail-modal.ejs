	            this.descriptionEditorInstance.setHtml(this.task.description || '', {
	                key: String(this.task._id || '')
	            });
	        },

	        onDescriptionInput(payload) {
	            if (this._descriptionEditorSyncing || !this.task) return;
	            const html = typeof payload === 'string'
	                ? this.sanitizeDescriptionHtml(payload)
	                : (this.descriptionEditorInstance?.getHtml() || this.sanitizeDescriptionHtml(this.descriptionEditor()?.innerHTML || ''));
	            this.task.description = html;
	            this.descriptionStatus = 'Modifications en cours...';
	            if (this._descriptionSaveTimer) clearTimeout(this._descriptionSaveTimer);
	            this._descriptionSaveTimer = setTimeout(() => this.flushDescriptionSave(), 850);
	        },

	        async flushDescriptionSave() {
	            if (!this.task?._id) return;
	            if (this._descriptionSaveTimer) clearTimeout(this._descriptionSaveTimer);
	            this._descriptionSaveTimer = null;
	            const clean = this.descriptionEditorInstance?.getHtml()
	                || this.sanitizeDescriptionHtml(this.descriptionEditor()?.innerHTML || this.task.description || '');
	            this.task.description = clean;
	            if (clean === this._descriptionSavedHtml) {
	                this.descriptionStatus = '';
	                return;
	            }
	            this.descriptionStatus = 'Enregistrement...';
	            const saved = await this.updateField('description', clean, { silent: true });
	            if (saved !== false) {
	                this._descriptionSavedHtml = clean;
	                this.descriptionStatus = 'Enregistré';
	                setTimeout(() => {
	                    if (this.descriptionStatus === 'Enregistré') this.descriptionStatus = '';
	                }, 1100);
	            }
	        },

	        focusDescriptionEditor() {
	            this.descriptionEditorInstance?.focus();
	            return this.descriptionEditor();
