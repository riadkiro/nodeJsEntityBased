<!-- Preview Mode: Clean WYSIWYG rendering of the form -->
<div class="flex-1 overflow-auto bg-gray-50 dark:bg-gray-900">
  <div class="max-w-3xl mx-auto py-8 px-4">

    <!-- Preview Header Card -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
      
      <!-- Entity Header -->
      <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700 bg-gradient-to-r from-primary/5 to-transparent">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-primary/10"
               :style="entityMeta.color ? 'background-color:' + entityMeta.color + '15' : ''">
            <iconify-icon :icon="entityMeta.icon || 'solar:box-bold-duotone'" width="22"
                          :style="entityMeta.color ? 'color:' + entityMeta.color : ''" class="text-primary"></iconify-icon>
          </div>
          <div>
            <h2 class="text-lg font-bold text-gray-900 dark:text-white" x-text="'Nouveau ' + entityMeta.name"></h2>
            <p class="text-xs text-gray-400">Aperçu du formulaire tel qu'il apparaîtra aux utilisateurs</p>
          </div>
        </div>
      </div>

      <!-- Form Content -->
      <div class="p-6 space-y-5">

        <template x-for="(row, rowIndex) in formLayout.rows" :key="'preview-' + row.id">
          <div class="grid gap-4"
               :style="'grid-template-columns: repeat(' + row.columns.reduce((s, c) => s + c.width, 0) + ', minmax(0, 1fr))'">
            
            <template x-for="(col, colIndex) in row.columns" :key="'preview-col-' + row.id + '-' + colIndex">
              <div :style="'grid-column: span ' + col.width" class="space-y-4">
                
                <template x-for="(field, fieldIndex) in col.fields" :key="'preview-f-' + field.id">
                  <div x-html="renderPreviewField(field)"></div>
                </template>

              </div>
            </template>

          </div>
        </template>

        <!-- Empty state -->
        <template x-if="formLayout.rows.length === 0">
          <div class="text-center py-12 text-gray-400">
            <iconify-icon icon="solar:widget-5-bold-duotone" width="48" class="mb-3 opacity-50"></iconify-icon>
            <p class="text-sm">Aucun champ dans le formulaire</p>
            <p class="text-xs mt-1">Passez en mode Éditer pour ajouter des champs</p>
          </div>
        </template>

      </div>

      <!-- Preview Action Bar -->
      <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50 flex items-center justify-end gap-3">
        <button type="button" class="btn btn-outline-danger btn-sm" disabled>
          <iconify-icon icon="solar:close-circle-bold" width="14" class="mr-1"></iconify-icon>
          Annuler
        </button>
        <button type="button" class="btn btn-primary btn-sm" disabled>
          <iconify-icon icon="solar:diskette-bold" width="14" class="mr-1"></iconify-icon>
          Créer
        </button>
      </div>
    </div>

    <!-- Preview Notice -->
    <div class="mt-4 text-center">
      <span class="text-[10px] text-gray-400 uppercase tracking-wider font-bold bg-white dark:bg-gray-800 px-3 py-1 rounded-full border border-gray-200 dark:border-gray-700">
        <iconify-icon icon="solar:eye-bold-duotone" width="12" class="mr-1"></iconify-icon>
        Mode aperçu — Les champs ne sont pas interactifs
      </span>
    </div>
  </div>
</div>
