    .dark .tl-card { background:#0e1726;border-color:#253b5c;box-shadow:none; }
    .dark .tl-card:hover { border-color:#355276;box-shadow:none; }
    .dark .tl-card-name,.dark .tl-preview-title { color:#e0e6ed; }
    .dark .tl-preview-item { border-color:#253b5c; }
    .dark .tl-preview-item:hover { background:#111f35; }
    /* Unified compact table surface, shared visually with Tasks Hub */
