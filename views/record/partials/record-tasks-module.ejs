    .dark .tl-status-opt { color: #e0e6ed; }
    .dark .tl-status-opt:hover { background: #253b5c; }
    .dark .tl-inline-edit { background: #1b2e4b; border-color: #4361ee; color: #e0e6ed; }
    .dark .tl-ctx { background: #1b2e4b; border-color: #253b5c; }
    .dark .tl-ctx-item { color: #e0e6ed; }
    .dark .tl-ctx-item:hover { background: #253b5c; }
    .dark .tl-ctx-sep { background: #253b5c; }
    .dark .tl-card-preview { border-color: #253b5c; }
    .dark .tl-preview-item { color: #94a3b8; }
