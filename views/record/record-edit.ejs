                                                        <% (entity.relations || []).forEach(function(r) { var tName = (r.targetEntity && r.targetEntity.name) || r.label || ''; %>
                                                        <option value="rel:<%= r.key || '' %>">🔗 Relation — <%= tName %></option>
                                                        <% }); %>
                                                        <% (locals.gridSchemas || []).filter(function(gs) { return gs && gs.schema; }).forEach(function(gs) { %>
