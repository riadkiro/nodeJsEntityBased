                                        <select class="lp-input" style="width: auto; height: 34px; font-size: 13px;"
                                            :value="getEditLines()[editModal.lineIdx].values[col.key]?.unit || (col.config?.units?.[0] || 'day')"
                                            @change="if(!getEditLines()[editModal.lineIdx].values[col.key]) getEditLines()[editModal.lineIdx].values[col.key] = {}; getEditLines()[editModal.lineIdx].values[col.key].unit = $event.target.value">
                                            <template x-for="u in (col.config?.units || ['day','week','month'])" :key="u">
