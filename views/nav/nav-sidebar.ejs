                <div class="flex items-center gap-2">
                  <iconify-icon icon="solar:add-square-linear" class="ml-2" width="18" height="18"></iconify-icon>
                  <span>Créer</span>
                </div>
              </h2>
              <ul class="space-y-1 text-sm text-gray-800 pt-2 dark:text-gray-200">
                <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                  @click="createItem('folder')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:folder-2-bold-duotone" class="ml-2" width="18" height="18"></iconify-icon>
                    <span>Dossier</span>
                  </div>
                </li>
                <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
                  @click="createItem('environment')">
                  <div class="flex items-center gap-2">
                    <iconify-icon icon="solar:layers-minimalistic-line-duotone" class="ml-2" width="18"
                      height="18"></iconify-icon>
                    <span>Environnement</span>
                  </div>
                </li>

                <li class="hover:bg-primary/10 hover:text-primary px-1 py-2 rounded cursor-pointer transition-colors"
