                        <button class="lp-modal-close" @click="closeEditModal()">
                            <iconify-icon icon="tabler:x" width="16"></iconify-icon>
                        </button>
                    </div>

                    <!-- Form fields -->
                    <div style="padding: 16px 20px; display: flex; flex-direction: column; gap: 14px; max-height: 60vh;"
                         :style="editRelOpen ? 'overflow: visible' : 'overflow-y: auto'">
